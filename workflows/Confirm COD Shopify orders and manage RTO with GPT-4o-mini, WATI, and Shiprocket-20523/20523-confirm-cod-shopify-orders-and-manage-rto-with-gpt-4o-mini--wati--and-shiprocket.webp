"ndr_reason","type":"string","display":true,"removed":false,"required":false,"displayName":"ndr_reason","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ndr_sent_at","type":"string","display":true,"removed":false,"required":false,"displayName":"ndr_sent_at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ndr_reminders","type":"string","display":true,"removed":false,"required":false,"displayName":"ndr_reminders","defaultMatch":false,"canBeUsedToMatch":true},{"id":"last_event_at","type":"string","display":true,"removed":false,"required":false,"displayName":"last_event_at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"notes","type":"string","display":true,"removed":false,"required":false,"displayName":"notes","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"autoMapInputData","matchingColumns":["order_id"]},"options":{},"operation":"update","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Set Store Config').first().json.orders_sheet }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Set Store Config').first().json.sheet_id }}"}},"typeVersion":4.5},{"id":"93c8e55d-a235-4058-901c-5750ba50e844","name":"Attach Shiprocket Token","type":"n8n-nodes-base.code","position":[2896,288],"parameters":{"jsCode":"const token = $input.first().json.token;\nreturn $('Route by Action Type').all(4).map((i, idx) => ({ json: { ...i.json, token }, pairedItem: { item: idx } }));"},"typeVersion":2},{"id":"8cc7028f-5276-4185-8983-f0ecc331bbbb","name":"Create Shipment or NDR Action in Shiprocket","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":2,"position":[3120,288],"parameters":{"url":"=https://apiv2.shiprocket.in/v1/external{{ $json.path }}","method":"POST","options":{"timeout":30000},"jsonBody":"={{ JSON.stringify($json.body) }}","sendBody":true,"sendHeaders":true,"specifyBody":"json","headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{ $json.token }}"}]}},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":3000},{"id":"d8675968-9264-4728-973c-ee3d75743662","name":"Record Shiprocket Result","type":"n8n-nodes-base.code","position":[3376,288],"parameters":{"mode":"runOnceForEachItem","jsCode":"const esc = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst phone10 = p => String(p ?? '').replace(/\\D/g, '').slice(-10);\nconst hoursSince = v => { const d = new Date(v); return isNaN(d) ? 0 : (Date.now() - d.getTime()) / 3600e3; };\nconst inr = v => '₹' + Number(v || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 });\nconst mergeTags = (cur, add = []) => { const t = String(cur || '').split(',').map(x => x.trim()).filter(x => x && !/^(COD-|SR-|NDR$|RTO$|Delivered$)/.test(x)); add.forEach(a => { if (!t.includes(a)) t.push(a); }); return t.join(', '); };\nconst shopBase = s => `https://${String(s.shopify_shop).replace(/^https?:\\/\\//, '').replace(/\\/$/, '')}/admin/api/${s.shopify_api_version}`;\nconst watiBase = s => String(s.wati_api_endpoint).replace(/\\/$/, '');\n// ---- action builders (each becomes one item routed by \"Route by Action Type\") ----\nconst actTags = (s, r, add) => { const tags = mergeTags(r.shopify_tags, add); return { tags, act: { type: 'shopify', method: 'PUT', url: `${shopBase(s)}/orders/${r.order_id}.json`, body: { order: { id: Number(r.order_id), tags } } } }; };\nconst actCancel = (s, r, reason) => ({ type: 'shopify', method: 'POST', url: `${shopBase(s)}/orders/${r.order_id}/cancel.json`, body: { reason } });\nconst actTpl = (s, phone, tpl, params) => ({ type: 'wati', url: `${watiBase(s)}/api/v1/sendTemplateMessage?whatsappNumber=${s.country_code}${phone10(phone)}`,\n  body: { template_name: tpl, broadcast_name: `${s.wati_broadcast_name}-${Date.now()}`, parameters: params.map((v, i) => ({ name: String(i + 1), value: String(v ?? '').replace(/[\\n\\t]+/g, ' ').slice(0, 500) || '-' })) } });\nconst actText = (s, phone, text) => ({ type: 'wati', url: `${watiBase(s)}/api/v1/sendSessionMessage/${s.country_code}${phone10(phone)}?messageText=${encodeURIComponent(text)}`, body: {} });\nconst actUpdate = update => ({ type: 'update', update });\nconst actTg = text => ({ type: 'telegram', text });\nconst actNdr = (r, action, comments) => r.awb ? ({ type: 'shiprocket', purpose: 'ndr', path: `/ndr/${r.awb}/action`, body: { action, comments }, order: r }) : null;\nconst itemsShort = r => { try { return JSON.parse(r.items_json || '[]').map(i => `${i.name} x${i.units}`).join(', ').slice(0, 120); } catch (e) { return ''; } };\nconst s = $('Set Store Config').first().json;\nconst a = $('Attach Shiprocket Token').item.json, r = a.order, res = $json, now = new Date().toISOString();\nconst ok = a.purpose === 'create' ? !!res.shipment_id : !(res.status_code >= 400 || res.error || res.errors);\nconst err = ok ? '' : String(res.message || JSON.stringify(res.errors || res.error || res)).slice(0, 300);\nconst u = { order_id: r.order_id, status: r.status, shiprocket_order_id: r.shiprocket_order_id || '', shipment_id: r.shipment_id || '', awb: r.awb || '',\n  courier: r.courier || '', shipment_status: r.shipment_status || '', last_event_at: now, notes: r.notes || '' };\nif (a.purpose === 'create') Object.assign(u, ok ? { status: 'Shipped', shiprocket_order_id: String(res.order_id || ''), shipment_id: String(res.shipment_id || ''),\n  awb: String(res.awb_code || ''), courier: String(res.courier_name || ''), shipment_status: String(res.status || 'NEW') } : { status: 'Push Failed', notes: `${u.notes} | push error: ${err}`.slice(-400) });\nelse u.notes = `${u.notes} | NDR ${a.body.action} ${ok ? 'sent' : 'FAILED: ' + err}`.slice(-400);\nreturn { json: { update: u, failed: !ok, telegram_text: `❌ <b>Shiprocket ${a.purpose === 'create' ? 'order push' : 'NDR ' + esc(a.body.action)} failed</b> ${esc(r.order_name)}\\n${esc(r.customer_name)} · ${esc(r.city)} ${esc(r.pincode)} · ${inr(r.order_value)}\\nError: ${esc(err)}${a.purpose === 'create' ? '\\nFix the row and set the status back to <i>Ready to Ship</i>.' : ''}` } };"},"typeVersion":2},{"id":"17dec675-e2b9-4945-b315-c32115aea51e","name":"Save Shiprocket Result to Sheet","type":"n8n-nodes-base.googleSheets","position":[3664,192],"parameters":{"columns":{"value":{"awb":"={{ $json.update.awb }}","notes":"={{ $json.update.notes }}","status":"={{ $json.update.status }}","courier":"={{ $json.update.courier }}","order_id":"={{ $json.update.order_id }}","shipment_id":"={{ $json.update.shipment_id }}","last_event_at":"={{ $json.update.last_event_at }}","shipment_status":"={{ $json.update.shipment_status }}","shiprocket_order_id":"={{ $json.update.shiprocket_order_id }}"},"schema":[{"id":"order_id","type":"string","display":true,"removed":false,"required":false,"displayName":"order_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"removed":false,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"shiprocket_order_id","type":"string","display":true,"removed":false,"required":false,"displayName":"shiprocket_order_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"shipment_id","type":"string","display":true,"removed":false,"required":false,"displayName":"shipment_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"awb","type":"string","display":true,"removed":false,"required":false,"displayName":"awb","defaultMatch":false,"canBeUsedToMatch":true},{"id":"courier","type":"string","display":true,"removed":false,"required":false,"displayName":"courier","defaultMatch":false,"canBeUsedToMatch":true},{"id":"shipment_status","type":"string","display":true,"removed":false,"required":false,"displayName":"shipment_status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"last_event_at","type":"string","display":true,"removed":false,"required":false,"displayName":"last_event_at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"notes","type":"string","display":true,"removed":false,"required":false,"displayName":"notes","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["order_id"]},"options":{},"operation":"update","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Set Store Config').first().json.orders_sheet }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Set Store Config').first().json.sheet_id }}"}},"typeVersion":4.5},{"id":"baa4b3ba-ba42-4915-a724-1aad6aa4e6b3","name":"Shiprocket Failed?","type":"n8n-nodes-base.if","position":[3616,496],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"75f49669-028a-4068-b9ee-47ad99e7954c","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.failed }}","rightValue":""}]}},"typeVersion":2.2},{"id":"f771085f-1660-4a6e-9b55-1a53ffbbdee5","name":"Alert Ops on Shiprocket Error","type":"n8n-nodes-base.telegram","onError":"continueRegularOutput","position":[3872,496],"webhookId":"1802bf66-a411-4db6-91c1-f8d13c4c38fe","parameters":{"text":"={{ $json.telegram_text }}","chatId":"={{ $('Set Store Config').first().json.ops_telegram_chat_id }}","additionalFields":{"parse_mode":"HTML","appendAttribution":false}},"typeVersion":1.2}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"72addf67-6389-4b38-813d-358dc5b80f12","nodeGroups":[],"connections":{"Needs AI Score?":{"main":[[{"node":"AI Assess RTO Risk","type":"main","index":0}],[{"node":"Split Into Actions","type":"main","index":0}]]},"Set Store Config":{"main":[[{"node":"Get COD Orders Sheet","type":"main","index":0}]]},"New Shopify Order":{"main":[[{"node":"Set Store Config","type":"main","index":0}]]},"AI Assess RTO Risk":{"main":[[{"node":"Apply AI Risk Score","type":"main","index":0}]]},"Prepare Row Update":{"main":[[{"node":"Update Order Row in Sheet","type":"main","index":0}]]},"Shiprocket Failed?":{"main":[[{"node":"Alert Ops on S