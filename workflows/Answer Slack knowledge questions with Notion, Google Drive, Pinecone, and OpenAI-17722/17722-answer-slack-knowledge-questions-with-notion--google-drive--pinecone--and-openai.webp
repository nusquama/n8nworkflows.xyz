{"id":"megcge2UEMFN4g3N","meta":{"instanceId":"28ca37d3368f4c0632c04a2232b273aed63f3b9214206087d3d1b91be5ec5c1f"},"name":"RAG-Powered Internal Knowledge Chatbot","tags":[],"nodes":[{"id":"1a425f3d-5ecd-4c1d-9f41-0eb4a0c1d96e","name":"Nightly Sync (2am)","type":"n8n-nodes-base.scheduleTrigger","position":[-1152,176],"parameters":{"rule":{"interval":[{"triggerAtHour":2}]}},"typeVersion":1.2},{"id":"067cc735-459a-451f-974c-05720093d6ea","name":"Search Notion Pages","type":"n8n-nodes-base.notion","maxTries":2,"position":[-912,80],"parameters":{"options":{"sort":{"sortValue":{}}},"operation":"search","returnAll":true},"retryOnFail":true,"typeVersion":2.2},{"id":"c6b4a6cd-6294-4f4e-974d-f10d7040acb5","name":"Search Drive Files","type":"n8n-nodes-base.googleDrive","maxTries":2,"position":[-912,272],"parameters":{"filter":{"whatToSearch":"files"},"options":{},"resource":"fileFolder","returnAll":true,"searchMethod":"query"},"retryOnFail":true,"typeVersion":3},{"id":"69b9fca5-59d8-45a6-9116-5f5fd939f52f","name":"Combine Doc Sources","type":"n8n-nodes-base.merge","position":[-672,176],"parameters":{"mode":"combine","options":{},"combineBy":"combineAll"},"typeVersion":3.2},{"id":"e41fbff9-337a-43e9-b0a8-7aa8eb5f9746","name":"Normalize Doc List","type":"n8n-nodes-base.code","position":[-464,176],"parameters":{"jsCode":"const notionDocs = $('Search Notion Pages').all().map(i => ({ id: i.json.id, title: i.json.name || 'Untitled', url: i.json.url, source: 'notion' }));\nconst driveDocs = $('Search Drive Files').all().map(i => ({ id: i.json.id, title: i.json.name, url: `https://drive.google.com/file/d/${i.json.id}/view`, source: 'drive' }));\nreturn [...notionDocs, ...driveDocs].map(d => ({ json: d }));"},"typeVersion":2},{"id":"33779fe8-38e3-4cf6-bbc0-841ca8f036bb","name":"Process Each Doc","type":"n8n-nodes-base.splitInBatches","position":[-240,176],"parameters":{"options":{}},"typeVersion":3},{"id":"5d52e56b-978c-4592-9392-4a1847efb929","name":"Sync Done","type":"n8n-nodes-base.noOp","position":[160,240],"parameters":{},"typeVersion":1},{"id":"7b703104-bc02-43d2-bb0c-f8596d0dbf9a","name":"Is Notion Doc?","type":"n8n-nodes-base.if","position":[160,448],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"cond-is-notion","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.source }}","rightValue":"notion"}]}},"typeVersion":2.2},{"id":"28810aa7-113b-4065-a8dd-b99c7a5ea5e6","name":"Get Notion Page Blocks","type":"n8n-nodes-base.notion","position":[400,320],"parameters":{"blockId":{"__rl":true,"mode":"id","value":"={{ $json.id }}"},"resource":"block","operation":"getAll","returnAll":true},"typeVersion":2.2},{"id":"5af28a37-b742-4320-a80d-d78ab488ae5b","name":"Flatten Notion Text","type":"n8n-nodes-base.code","position":[640,320],"parameters":{"jsCode":"const doc = $('Process Each Doc').item.json;\nconst text = $input.all().map(b => b.json.text || '').filter(Boolean).join('\\n');\nreturn [{ json: { id: doc.id, title: doc.title, url: doc.url, source: doc.source, content: text || doc.title } }];"},"typeVersion":2},{"id":"3666948c-dad5-4146-965a-5f97cab9b0f5","name":"Download Drive File","type":"n8n-nodes-base.googleDrive","position":[400,592],"parameters":{"fileId":{"__rl":true,"mode":"id","value":"={{ $json.id }}"},"options":{},"operation":"download"},"typeVersion":3,"continueOnFail":true},{"id":"913c7433-997f-44e8-89b2-4e0399a4b510","name":"Extract Drive Text","type":"n8n-nodes-base.extractFromFile","position":[640,592],"parameters":{"options":{},"operation":"text"},"typeVersion":1.1},{"id":"24b3b58b-1e55-4305-ba1c-70f652f14f4a","name":"Build Drive Doc","type":"n8n-nodes-base.code","position":[880,592],"parameters":{"jsCode":"const doc = $('Process Each Doc').item.json;\nreturn [{ json: { id: doc.id, title: doc.title, url: doc.url, source: doc.source, content: $json.data || doc.title } }];"},"typeVersion":2},{"id":"01e99c23-d306-460f-a0bf-e583acae07ac","name":"Pinecone: Insert Docs","type":"@n8n/n8n-nodes-langchain.vectorStorePinecone","position":[1120,448],"parameters":{"mode":"insert","options":{},"pineconeIndex":{"__rl":true,"mode":"list","value":"REPLACE_WITH_PINECONE_INDEX"}},"typeVersion":1.3},{"id":"19eee8a9-59a6-4f5a-899c-76e91fdbba1f","name":"Insert Embeddings","type":"@n8n/n8n-nodes-langchain.embeddingsOpenAi","position":[1088,624],"parameters":{"options":{}},"typeVersion":1.2},{"id":"aea326b9-f0d5-4d4d-87af-1ee703068085","name":"Doc Loader","type":"@n8n/n8n-nodes-langchain.documentDefaultDataLoader","position":[1248,624],"parameters":{"options":{"metadata":{"metadataValues":[{"name":"title","value":"={{ $json.title }}"},{"name":"url","value":"={{ $json.url }}"},{"name":"source","value":"={{ $json.source }}"}]}},"jsonData":"={{ $json.content }}","jsonMode":"expressionData"},"typeVersion":1.1},{"id":"1e5866dc-e737-4d5a-8c73-79f2cbd8ec68","name":"Slack Q&A Trigger","type":"n8n-nodes-base.slackTrigger","position":[-1136,752],"webhookId":"82bf6198-1a5f-4180-a787-bdc0ff43b010","parameters":{"options":{},"trigger":["app_mention"],"channelId":{"__rl":true,"mode":"list","value":"REPLACE_WITH_CHANNEL_ID","cachedResultName":"ask-docs"}},"typeVersion":1},{"id":"dab5683c-0d0c-4820-8c44-290e6e3f0e5f","name":"Strip Mention","type":"n8n-nodes-base.code","position":[-896,752],"parameters":{"jsCode":"const text = ($json.event?.text || '').replace(/<@[^>]+>/g, '').trim();\nreturn [{ json: { question: text, channel: $json.event.channel, threadTs: $json.event.thread_ts || $json.event.ts } }];"},"typeVersion":2},{"id":"b35b5728-975b-4bd9-b514-75ae52bdd8ea","name":"Answer Question (AI Agent)","type":"@n8n/n8n-nodes-langchain.agent","position":[-656,752],"parameters":{"text":"={{ $json.question }}","options":{"systemMessage":"You are the internal knowledge assistant. Use the Knowledge Base tool to find the answer, then reply concisely and include the source URL from the retrieved document metadata at the end as 'Source: <url>'. If nothing relevant is found, say so honestly."},"promptType":"define"},"typeVersion":1.7},{"id":"2ab289ec-3dea-4d77-8c6f-8c5afd366d6a","name":"OpenAI Chat Model (Q&A)","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[-688,928],"parameters":{"model":{"__rl":true,"mode":"list","value":"gpt-5-mini"},"options":{"temperature":0.2},"builtInTools":{}},"typeVersion":1.3},{"id":"fceb2ebc-1a3c-414f-a6c0-8bd658ad9525","name":"Knowledge Base (RAG Tool)","type":"@n8n/n8n-nodes-langchain.vectorStorePinecone","position":[-496,928],"parameters":{"mode":"retrieve-as-tool","options":{},"pineconeIndex":{"__rl":true,"mode":"list","value":"REPLACE_WITH_PINECONE_INDEX"},"toolDescription":"Search the internal company knowledge base (Notion docs and Drive files) for an answer to the user's question."},"typeVersion":1.3},{"id":"c2ea97b0-fd6d-4000-aa83-1eb0b0bec0d8","name":"Retrieval Embeddings","type":"@n8n/n8n-nodes-langchain.embeddingsOpenAi","position":[-496,1088],"parameters":{"options":{}},"typeVersion":1.2},{"id":"8bc2a0a6-6d18-4fa5-919e-66cb5235bfb5","name":"Reply in Thread","type":"n8n-nodes-base.slack","maxTries":2,"position":[-384,752],"webhookId":"a03a772d-8384-416b-a7a9-136f6c3f9dbe","parameters":{"text":"={{ $json.output }}","select":"channel","channelId":{"__rl":true,"mode":"id","value":"={{ $('Strip Mention').item.json.channel }}"},"otherOptions":{"thread_ts":{"replyValues":{"thread_ts":"={{ $('Strip Mention').item.json.threadTs }}"}}}},"retryOnFail":true,"typeVersion":2.3},{"id":"bd5c675c-a7ce-4b1d-9332-3b3334a8aafd","name":"Error Trigger","type":"n8n-nodes-base.errorTrigger","position":[-1136,1120],"parameters":{},"typeVersion":1},{"id":"da1ad35d-f3ee-44f0-b23d-fc8f2de1ae4a","name":"Notify Ops","type":"n8n-nodes-base.slack","position":[-896,1120],"webhookId":"5af5ac0b-04f3-4240-b662-43a6738f7484","parameters":{"text":"=🚨 RAG Knowledge Chatbot failed: {{ $json.execution.error.message }}","select":"channel","channelId":{"__rl":true,"mode":"list","value":"REPLACE_WITH_CHANNEL_ID","cachedResultName":"ops-alerts"},"otherOptions":{}},"typeVersion":2.3},{"id":"00ed634b-e8bd-439f-a48d-1bdb158cec0e","name":"Overview","type":"n8n-nodes-base.stickyNote","position":[-1936,192],"parameters":{"color":7,"width":520,"height":1952,"content":"## 📚 RAG-Powered Internal Knowledge Chatbot\n\nKeeps a Pinecone vector index in sync with your Notion workspace and Google Drive every night, then lets teammates ask questions in Slack and get answers sourced straight from that knowledge base.\n\n**Perfect for:** IT, ops, and knowledge management teams who want a bot that answers questions directly from internal Notion pages and Drive files.\n\n---\n\n## How it works\n\n**Nightly ingestion**\n1. **Nightly Sync (2am)**: Kicks off the sync automatically every night at 2am.\n2. **Search Notion Pages**: Retrieves every Notion page, sorted by most recently edited.\n3. **Search Drive Files**: Retrieves every file in the connected Google Drive.\n4. **Combine Doc Sources**: Merges the Notion and Drive results into a single list.\n5. **Normalize Doc List**: Reshapes both sources into a common id, title, url, and source format.\n6. **Process Each Doc**: Loops through the combined document list one item at a time.\n7. **Is Notion Doc?**: Routes each item to the right extraction path based on its source.\n8. **Get Notion Page Blocks**: Fetches all content blocks for Notion pages. *(Notion path)*\n9. **Flatten Notion Text**: Joins the retrieved blocks into a single plain text document.\n10. **Download Drive File**: Downloads the raw file for Drive items. *(Drive path)*\n11. **Extract Drive Text**: Extracts plain text from the downloaded file.\n12. **Build Drive Doc**: Packages the extracted text into the same shape as the Notion documents.\n13. **Pinecone: Insert Docs**: Embeds and writes each document into the Pinecone index, using **Insert Embeddings** for the vectors and **Doc Loader** to attach title, url, and source metadata, then loops back to the next document.\n14. **Sync Done**: Marks the ingestion loop as complete once every document has been processed.\n\n**Slack Q&A**\n15. **Slack Q&A Trigger**: Fires whenever someone @mentions the bot in the ask-docs channel.\n16. **Strip Mention**: Removes the mention and pulls out the question text, channel, and thread.\n17. **Answer Question (AI Agent)**: Answers the question using the **OpenAI Chat Model (Q&A)** for reasoning and the **Knowledge Base (RAG Tool)** to search the Pinecone index, citing a source URL.\n18. **Retrieval Embeddings**: Generates the embeddings the Knowledge Base tool uses to search Pinecone.\n19. **Reply in Thread**: Posts the AI Agent's answer back into the original Slack thread.\n\n**Error handling**\n20. **Error Trigger**: Catches any failure across the entire workflow. *(runs independently)*\n21. **Notify Ops**: Posts an alert with the failure details to the ops-alerts Slack channel.\n\n---\n\n## Setup (~15 minutes)\n\n1. **Notion**: Connect your account in *Search Notion Pages* and *Get Notion Page Blocks*.\n2. **Google Drive**: Connect your account in *Search Drive Files* and *Download Drive File*.\n3. **Pinecone**: Connect your account and set your index in *Pinecone: Insert Docs* and *Knowledge Base (RAG Tool)*.\n4. **OpenAI**: Add your API key in *Insert Embeddings*, *Retrieval Embeddings*, and *OpenAI Chat Model (Q&A)*.\n5. **Slack**: Connect your account, set the ask-docs channel in *Slack Q&A Trigger*, and set the ops-alerts channel in *Notify Ops*.\n> The nightly sync recomputes embeddings for every document on every run; for large document sets, consider filtering to recently edited items only to control embedding costs."},"typeVersion":1},{"id":"ffb2f33b-f768-4007-b804-ee9f3eba5bad","name":"Section 1 - Nightly Sync Trigger","type":"n8n-nodes-base.stickyNote","position":[-1280,-96],"parameters":{"color":5,"width":1156,"height":576,"content":"## 1️⃣ Nightly Sync Trigger\n\n**Nightly Sync (2am)** wakes the workflow up once a day and fans out to **Search Notion Pages** and **Search Drive Files**, which pull every page and file from each source. **Combine Doc Sources** and **Normalize Doc List** merge the two lists into one common shape, and **Process Each Doc** loops through them one at a time until **Sync Done** marks the batch complete."},"typeVersion":1},{"id":"6ef18c40-2844-41b4-8312-5604af74894a","name":"Section 2 - Document Extraction & Embedding","type":"n8n-nodes-base.stickyNote","position":[48,48],"parameters":{"color":6,"width":1460,"height":772,"content":"## 2️⃣ Document Extraction & Embedding\n\n**Is Notion Doc?** splits each item onto the right extraction path. Notion pages go through **Get Notion Page Blocks** and **Flatten Notion Text**, while Drive files go through **Download Drive File**, **Extract Drive Text**, and **Build Drive Doc**. Both paths land in **Pinecone: Insert Docs**, which uses **Insert Embeddings** to vectorize the content and **Doc Loader** to attach title, url, and source metadata before writing it to the index."},"typeVersion":1},{"id":"c1ab4040-4563-4adf-87be-c2ef9aa04387","name":"Section 3 - Slack Q&A Agent","type":"n8n-nodes-base.stickyNote","position":[-1248,560],"parameters":{"color":3,"width":1232,"height":748,"content":"## 3️⃣ Slack Q&A Agent\n\n**Slack Q&A Trigger** fires whenever a teammate @mentions the bot, and **Strip Mention** cleans the question out of the raw Slack event. **Answer Question (AI Agent)** reasons over the question using the **OpenAI Chat Model (Q&A)**, searches the index through the **Knowledge Base (RAG Tool)** and its **Retrieval Embeddings**, and **Reply in Thread** posts the sourced answer back to Slack."},"typeVersion":1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":false,"executionOrder":"v1"},"versionId":"1d9998d3-ad89-4b59-8ab1-2b0e0ef25634","nodeGroups":[],"connections":{"Doc Loader":{"ai_document":[[{"node":"Pinecone: Insert Docs","type":"ai_document","index":0}]]},"Error Trigger":{"main":[[{"node":"Notify Ops","type":"main","index":0}]]},"Strip Mention":{"main":[[{"node":"Answer Question (AI Agent)","type":"main","index":0}]]},"Is Notion Doc?":{"main":[[{"node":"Get Notion Page Blocks","type":"main","index":0}],[{"node":"Download Drive File","type":"main","index":0}]]},"Build Drive Doc":{"main":[[{"node":"Pinecone: Insert Docs","type":"main","index":0}]]},"Process Each Doc":{"main":[[{"node":"Sync Done","type":"main","index":0}],[{"node":"Is Notion Doc?","type":"main","index":0}]]},"Insert Embeddings":{"ai_embedding":[[{"node":"Pinecone: Insert Docs","type":"ai_embedding","index":0}]]},"Slack Q&A Trigger":{"main":[[{"node":"Strip Mention","type":"main","index":0}]]},"Extract Drive Text":{"main":[[{"node":"Build Drive Doc","type":"main","index":0}]]},"Nightly Sync (2am)":{"main":[[{"node":"Search Notion Pages","type":"main","index":0},{"node":"Search Drive Files","type":"main","index":0}]]},"Normalize Doc List":{"main":[[{"node":"Process Each Doc","type":"main","index":0}]]},"Search Drive Files":{"main":[[{"node":"Combine Doc Sources","type":"main","index":1}]]},"Combine Doc Sources":{"main":[[{"node":"Normalize Doc List","type":"main","index":0}]]},"Download Drive File":{"main":[[{"node":"Extract Drive Text","type":"main","index":0}]]},"Flatten Notion Text":{"main":[[{"node":"Pinecone: Insert Docs","type":"main","index":0}]]},"Search Notion Pages":{"main":[[{"node":"Combine Doc Sources","type":"main","index":0}]]},"Retrieval Embeddings":{"ai_embedding":[[{"node":"Knowledge Base (RAG Tool)","type":"ai_embedding","index":0}]]},"Pinecone: Insert Docs":{"main":[[{"node":"Process Each Doc","type":"main","index":0}]]},"Get Notion Page Blocks":{"main":[[{"node":"Flatten Notion Text","type":"main","index":0}]]},"OpenAI Chat Model (Q&A)":{"ai_languageModel":[[{"node":"Answer Question (AI Agent)","type":"ai_languageModel","index":0}]]},"Knowledge Base (RAG Tool)":{"ai_tool":[[{"node":"Answer Question (AI Agent)","type":"ai_tool","index":0}]]},"Answer Question (AI Agent)":{"main":[[{"node":"Reply in Thread","type":"main","index":0}]]}}}