{"id":"RybJjTveBYmj9sS6","meta":{"instanceId":"7425b213c6897e7599be87bb3f0c21b8c62c5ffa438b5ba987bcc1a099c085d4","templateCredsSetupCompleted":true},"name":"CashLens -Bank SMS Expense Tracker & Telegram Finance Assistant","tags":[],"nodes":[{"id":"19e59425-a1ca-43d2-8c5e-59df8892b120","name":"Receive Bank SMS","type":"n8n-nodes-base.webhook","position":[-160,96],"webhookId":"8ad59d47-adb7-4393-bcaa-4b0f66049a0b","parameters":{"path":"cashlens-sms","options":{},"httpMethod":"POST","responseMode":"responseNode","authentication":"headerAuth"},"credentials":{"httpHeaderAuth":{"id":"7kpOI86HRcc6FU5u","name":"Header Auth account"}},"typeVersion":2.1},{"id":"8db8d61f-0b5f-417d-80b1-5579e876f55d","name":"Parse & Normalize Transaction","type":"n8n-nodes-base.code","position":[160,96],"parameters":{"jsCode":"\n// CASHLENS - SMS TRANSACTION EXTRACTOR\n// Version 1: Basic Indian Bank SMS Parser\n\nconst items = $input.all();\n\nreturn items.map((item, index) => {\n\n  // STEP 1: Read the message received by Webhook\n\n  const data = item.json.body ?? item.json;\n\n  const message = String(data.message ?? \"\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n  \n// STEP 1B: Check SMS sender against our allowlist\n\nconst sender = String(data.sender ?? \"\")\n  .trim()\n  .toUpperCase();\n\n// Temporary demo sender.\n// Replace/add actual bank sender IDs before going live.\n\n\nconst allowedSenders = [\n  \"DEMO-BANK\",\n  \"AX-KOTAKB-S\",\n  \"AD-KOTAKB-S\"\n];\n\n\nconst isAllowedSender = allowedSenders.includes(sender);\n\n\n  // STEP 2: Extract transaction amount\n\n  const amountMatch = message.match(\n    /(?:INR|Rs\\.?|₹)\\s*([\\d,]+(?:\\.\\d{1,2})?)/i\n  );\n\n  const amount = amountMatch\n    ? Number(amountMatch[1].replace(/,/g, \"\"))\n    : null;\n\n\n  // STEP 3: Identify DEBIT or CREDIT\n\n\nconst isDebit =\n  /\\b(debited|spent|withdrawn)\\b/i.test(message) ||\n  /^\\s*sent\\s*(?:Rs\\.?|INR|₹)\\s*[\\d,]+(?:\\.\\d{1,2})?/i.test(message);\n\n  const isCredit =/\\b(credited|deposited|received)\\b/i.test(message);\n\n  let transactionType = null;\n\n  if (isDebit && !isCredit) {\n    transactionType = \"DEBIT\";\n  } else if (isCredit && !isDebit) {\n    transactionType = \"CREDIT\";\n  }\n\n\n  // STEP 4: Extract the transaction date\n  // Supported example: 03-Oct-2026\n\n  const months = {\n    jan: 1, feb: 2, mar: 3, apr: 4,\n    may: 5, jun: 6, jul: 7, aug: 8,\n    sep: 9, oct: 10, nov: 11, dec: 12\n  };\n\n  const dateMatch = message.match(\n    /\\b(\\d{1,2})-([A-Za-z]{3})-(\\d{4})\\b/\n  );\n\n  let transactionDate = null;\n\n  if (dateMatch) {\n    const day = Number(dateMatch[1]);\n    const month = months[dateMatch[2].toLowerCase()];\n    const year = Number(dateMatch[3]);\n\n    if (month) {\n      const date = new Date(Date.UTC(year, month - 1, day));\n\n      if (\n        date.getUTCFullYear() === year &&\n        date.getUTCMonth() === month - 1 &&\n        date.getUTCDate() === day\n      ) {\n        transactionDate = date.toISOString().slice(0, 10);\n      }\n    }\n  }\n  \n// STEP 4A: Support Kotak Bank DD-MM-YY date format\n// Example: 02-10-26 becomes 2026-10-02\n\nif (!transactionDate) {\n\n  const kotakDateMatch = message.match(\n    /\\bon\\s+(\\d{1,2})-(\\d{1,2})-(\\d{2}|\\d{4})\\b/i\n  );\n\n  if (kotakDateMatch) {\n\n    const day = Number(kotakDateMatch[1]);\n    const month = Number(kotakDateMatch[2]);\n\n    let year = Number(kotakDateMatch[3]);\n\n    // Convert a two-digit year into a four-digit year.\n    // Intended for our contemporary bank alerts.\n    if (year < 100) {\n      year += 2000;\n    }\n\n    const date = new Date(\n      Date.UTC(year, month - 1, day)\n    );\n\n    // Validate the date before accepting it.\n    if (\n      date.getUTCFullYear() === year &&\n      date.getUTCMonth() === month - 1 &&\n      date.getUTCDate() === day\n    ) {\n      transactionDate = date.toISOString().slice(0, 10);\n    }\n  }\n}\n\n  \n// STEP 4B: Use Android SMS timestamp as fallback\n\nlet transactionDateSource = transactionDate\n  ? \"SMS_TEXT\"\n  : null;\n\nif (!transactionDate) {\n\n  const sentAt = Number(data.sent_at);\n  const nowSeconds = Math.floor(Date.now() / 1000);\n\n  // Accept valid Unix timestamps (seconds).\n  // Reject missing, old or far-future timestamps.\n\n  if (\n    data.sent_at !== null &&\n    data.sent_at !== undefined &&\n    data.sent_at !== \"\" &&\n    Number.isFinite(sentAt) &&\n    sentAt >= 1577836800 &&\n    sentAt <= nowSeconds + 86400\n  ) {\n\n    const smsDate = new Date(sentAt * 1000);\n\n    // Convert the timestamp to Indian local date.\n    const parts = new Intl.DateTimeFormat(\"en-GB\", {\n      timeZone: \"Asia/Kolkata\",\n      year: \"numeric\",\n      month: \"2-digit\",\n      day: \"2-digit\"\n    }).formatToParts(smsDate);\n\n    const getPart = type =>\n      parts.find(p => p.type === type)?.value;\n\n    transactionDate =\n      `${getPart(\"year\")}-${getPart(\"month\")}-${getPart(\"day\")}`;\n\n    transactionDateSource = \"SMS_TIMESTAMP\";\n  }\n}\n\n  // STEP 5: Identify payment method\n\n  const methodMatch = message.match(\n    /\\b(UPI|IMPS|NEFT|RTGS|ATM)\\b/i\n  );\n\n  const paymentMethod = methodMatch\n    ? methodMatch[1].toUpperCase()\n    : null;\n\n\n  \n// STEP 6: Extract merchant / counterparty\n\n\nconst beforeReference = message\n  .split(\n    /\\b(?:UPI\\s*Ref(?:erence)?|Ref(?:erence)?|Txn\\s*ID)\\b\\s*:?\\s*/i\n  )[0]\n  .replace(/[.\\s]+$/, \"\");\n\n\n// Find the counterparty based on transaction type\n\nconst merchantMatch = transactionType === \"CREDIT\"\n  ? beforeReference.match(/\\bfrom\\s+(.+)$/i)\n  : beforeReference.match(/\\bto\\s+(.+)$/i);\n\n// Remove any transaction date attached to the name\n\nconst merchant = merchantMatch\n  ? merchantMatch[1]\n      .replace(\n        /\\s+on\\s+\\d{1,2}[-/](?:\\d{1,2}|[A-Za-z]{3})[-/]\\d{2,4}\\b.*$/i,\n        \"\"\n      )\n      .replace(/[.,;\\s]+$/, \"\")\n      .trim()\n  : null;\n\n\n  // STEP 7: Extract transaction reference ID\n\n \nconst refMatch = message.match(\n  /\\b(?:UPI\\s*Ref(?:erence)?|Ref(?:erence)?|Txn\\s*ID)\\b\\s*:?\\s*([A-Za-z0-9-]{6,})\\b/i\n);\n\n\n  const referenceId = refMatch\n    ? refMatch[1]\n    : null;\n\n\n  // STEP 8: Extract masked account number\n\n \nconst accountMatch = message.match(\n  /\\b(?:A\\/c|Acct|Account|AC)\\s*(?:[Xx*#-]+\\s*)?(\\d{4})\\b/i\n);\n\n\n  const accountLast4 = accountMatch\n    ? accountMatch[1]\n    : null;\n\n\n  // STEP 9: Basic validation\n\n  const missingFields = [];\n\n  if (amount === null || !Number.isFinite(amount) || amount <= 0) {\n    missingFields.push(\"amount\");\n  }\n\n  if (!transactionType) {\n    missingFields.push(\"transaction_type\");\n  }\n\n  if (!transactionDate) {\n    missingFields.push(\"transaction_date\");\n  }\n\n  if (!data.event_id) {\n    missingFields.push(\"source_event_id\");\n  }\n\n  const isOTP = /\\b(OTP|one.time.password|verification code)\\b/i\n    .test(message);\n\n  \n// Reject OTPs and messages from unrecognized senders.\n\nconst rejectionReason = isOTP\n  ? \"OTP_DETECTED\"\n  : !isAllowedSender\n    ? \"SENDER_NOT_ALLOWLISTED\"\n    : null;\n\nconst parseStatus = rejectionReason\n  ? \"REJECTED\"\n  : missingFields.length === 0\n    ? \"PARSED\"\n    : \"NEEDS_REVIEW\";\n\n\n\n  // STEP 10: Return structured JSON\n\n  return {\n    json: {\n      source_event_id: data.event_id ?? null,\n      source: data.source ?? \"android_sms\",\n      sender: data.sender ?? null,\n      cleaned_message: message,\n\n      amount: amount,\n      currency: \"INR\",\n      transaction_type: transactionType,\n      transaction_date: transactionDate,\n      transaction_date_source: transactionDateSource,\n      merchant: merchant,\n      payment_method: paymentMethod,\n      account_last4: accountLast4,\n      reference_id: referenceId,\n\n      category: \"UNCATEGORIZED\",\n      received_at: new Date().toISOString(),\n\n      parse_status: parseStatus,\n      sender_allowlisted: isAllowedSender,\n      rejection_reason: rejectionReason,\n      is_valid_transaction: parseStatus === \"PARSED\",\n      needs_manual_review: parseStatus === \"NEEDS_REVIEW\",\n      missing_fields: missingFields\n    },\n    pairedItem: { item: index }\n  };\n\n});\n"},"typeVersion":2},{"id":"db19fd18-7a73-4e32-8b22-e0743df2c32f","name":"Is Transaction Valid?","type":"n8n-nodes-base.if","position":[384,96],"parameters":{"options":{},"conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"fcd37ade-5ba2-4cb6-af1e-a8b82307b79f","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.is_valid_transaction }}","rightValue":""}]}},"typeVersion":2.3},{"id":"d8214df1-dd55-4e95-b9bd-b2ff95197c6c","name":"Save to Transaction Ledger","type":"n8n-nodes-base.googleSheets","position":[608,0],"parameters":{"columns":{"value":{},"schema":[{"id":"source_event_id","type":"string","display":true,"removed":false,"required":false,"displayName":"source_event_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"transaction_date","type":"string","display":true,"removed":false,"required":false,"displayName":"transaction_date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"received_at","type":"string","display":true,"removed":false,"required":false,"displayName":"received_at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"amount","type":"string","display":true,"removed":false,"required":false,"displayName":"amount","defaultMatch":false,"canBeUsedToMatch":true},{"id":"currency","type":"string","display":true,"removed":false,"required":false,"displayName":"currency","defaultMatch":false,"canBeUsedToMatch":true},{"id":"transaction_type","type":"string","display":true,"removed":false,"required":false,"displayName":"transaction_type","defaultMatch":false,"canBeUsedToMatch":true},{"id":"merchant","type":"string","display":true,"removed":false,"required":false,"displayName":"merchant","defaultMatch":false,"canBeUsedToMatch":true},{"id":"category","type":"string","display":true,"removed":false,"required":false,"displayName":"category","defaultMatch":false,"canBeUsedToMatch":true},{"id":"payment_method","type":"string","display":true,"removed":false,"required":false,"displayName":"payment_method","defaultMatch":false,"canBeUsedToMatch":true},{"id":"account_last4","type":"string","display":true,"removed":false,"required":false,"displayName":"account_last4","defaultMatch":false,"canBeUsedToMatch":true},{"id":"reference_id","type":"string","display":true,"removed":false,"required":false,"displayName":"reference_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"source","type":"string","display":true,"removed":false,"required":false,"displayName":"source","defaultMatch":false,"canBeUsedToMatch":true},{"id":"sender","type":"string","display":true,"removed":false,"required":false,"displayName":"sender","defaultMatch":false,"canBeUsedToMatch":true},{"id":"parse_status","type":"string","display":true,"removed":false,"required":false,"displayName":"parse_status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"cleaned_message","type":"string","display":true,"removed":false,"required":false,"displayName":"cleaned_message","defaultMatch":false,"canBeUsedToMatch":true},{"id":"is_valid_transaction","type":"string","display":true,"removed":false,"required":false,"displayName":"is_valid_transaction","defaultMatch":false,"canBeUsedToMatch":true},{"id":"missing_fields","type":"string","display":true,"removed":false,"required":false,"displayName":"missing_fields","defaultMatch":false,"canBeUsedToMatch":true},{"id":"transaction_date_source","type":"string","display":true,"removed":false,"required":false,"displayName":"transaction_date_source","defaultMatch":false,"canBeUsedToMatch":true},{"id":"sender_allowlisted","type":"string","display":true,"removed":false,"required":false,"displayName":"sender_allowlisted","defaultMatch":false,"canBeUsedToMatch":true},{"id":"rejection_reason","type":"string","display":true,"removed":false,"required":false,"displayName":"rejection_reason","defaultMatch":false,"canBeUsedToMatch":true},{"id":"needs_manual_review","type":"string","display":true,"removed":false,"required":false,"displayName":"needs_manual_review","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"autoMapInputData","matchingColumns":["source_event_id"],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{},"operation":"appendOrUpdate","sheetName":{"__rl":true,"mode":"list","value":"gid=0","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1F6x02uqmFqE4wtn12-nvOk0ZFkXO6CJbkGItIEzJ_yY/edit#gid=0","cachedResultName":"Expenses"},"documentId":{"__rl":true,"mode":"list","value":"1F6x02uqmFqE4wtn12-nvOk0ZFkXO6CJbkGItIEzJ_yY","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1F6x02uqmFqE4wtn12-nvOk0ZFkXO6CJbkGItIEzJ_yY/edit?usp=drivesdk","cachedResultName":"My Expenses"}},"credentials":{"googleSheetsOAuth2Api":{"id":"UuN5J6JJJzfjxPoc","name":"Google Sheets account"}},"typeVersion":4.7},{"id":"75c93388-3244-45b5-80d8-1a6fc70afc43","name":"Confirm Transaction Saved","type":"n8n-nodes-base.respondToWebhook","position":[1072,0],"parameters":{"options":{"responseCode":200},"respondWith":"json","responseBody":"{\n  \"success\": true,\n  \"status\": \"SAVED\",\n  \"message\": \"CashLens transaction recorded successfully\"\n}"},"typeVersion":1.5},{"id":"c1082c43-3a8e-4588-91de-e5d62b7cf2db","name":"Needs Manual Review?","type":"n8n-nodes-base.if","position":[608,224],"parameters":{"options":{},"conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"6035b001-d1c4-4ebf-b2a4-c07a4028baa2","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.needs_manual_review }}","rightValue":"NEEDS_REVIEW"}]}},"typeVersion":2.3},{"id":"e163b8e1-2460-43c9-8dee-4045a98cdfb2","name":"Save to Review Queue","type":"n8n-nodes-base.googleSheets","position":[896,208],"parameters":{"columns":{"value":{},"schema":[{"id":"source_event_id","type":"string","display":true,"removed":false,"required":false,"displayName":"source_event_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"received_at","type":"string","display":true,"required":false,"displayName":"received_at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"sender","type":"string","display":true,"required":false,"displayName":"sender","defaultMatch":false,"canBeUsedToMatch":true},{"id":"amount","type":"string","display":true,"required":false,"displayName":"amount","defaultMatch":false,"canBeUsedToMatch":true},{"id":"transaction_type","type":"string","display":true,"required":false,"displayName":"transaction_type","defaultMatch":false,"canBeUsedToMatch":true},{"id":"transaction_date","type":"string","display":true,"required":false,"displayName":"transaction_date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"merchant","type":"string","display":true,"required":false,"displayName":"merchant","defaultMatch":false,"canBeUsedToMatch":true},{"id":"payment_method","type":"string","display":true,"required":false,"displayName":"payment_method","defaultMatch":false,"canBeUsedToMatch":true},{"id":"reference_id","type":"string","display":true,"required":false,"displayName":"reference_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"missing_fields","type":"string","display":true,"required":false,"displayName":"missing_fields","defaultMatch":false,"canBeUsedToMatch":true},{"id":"parse_status","type":"string","display":true,"required":false,"displayName":"parse_status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"review_status","type":"string","display":true,"required":false,"displayName":"review_status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"autoMapInputData","matchingColumns":["source_event_id"],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{},"operation":"appendOrUpdate","sheetName":{"__rl":true,"mode":"list","value":182681919,"cachedResultUrl":"https://docs.google.com/spreadsheets/d/1F6x02uqmFqE4wtn12-nvOk0ZFkXO6CJbkGItIEzJ_yY/edit#gid=182681919","cachedResultName":"Review_Queue"},"documentId":{"__rl":true,"mode":"list","value":"1F6x02uqmFqE4wtn12-nvOk0ZFkXO6CJbkGItIEzJ_yY","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1F6x02uqmFqE4wtn12-nvOk0ZFkXO6CJbkGItIEzJ_yY/edit?usp=drivesdk","cachedResultName":"CashLens | Personal Transaction Ledger"}},"credentials":{"googleSheetsOAuth2Api":{"id":"UuN5J6JJJzfjxPoc","name":"Google Sheets account"}},"typeVersion":4.7},{"id":"66da45f6-bfbd-486c-8a6e-71e1ceaad8a5","name":"Confirm Review Queue","type":"n8n-nodes-base.respondToWebhook","position":[1136,208],"parameters":{"options":{"responseCode":200},"respondWith":"json","responseBody":"{\n  \"accepted\": true,\n  \"status\": \"NEEDS_REVIEW\",\n  \"ledger_saved\": false,\n  \"review_saved\": true,\n  \"message\": \"Transaction recorded in CashLens Review Queue\"\n}"},"typeVersion":1.5},{"id":"705378fe-6fa1-43af-a064-b8f120cd38af","name":"Reject Invalid Transaction","type":"n8n-nodes-base.respondToWebhook","position":[848,496],"parameters":{"options":{"responseCode":422},"respondWith":"json","responseBody":"{\n  \"accepted\": false,\n  \"status\": \"REJECTED\",\n  \"retry\": false,\n  \"message\": \"Transaction rejected by CashLens validation\"\n}"},"typeVersion":1.5},{"id":"26a5f46b-211a-42d9-8605-522e46bdb54a","name":"Telegram Message","type":"n8n-nodes-base.telegramTrigger","position":[272,1024],"webhookId":"41a92bc0-3ccd-44c1-9000-6035d4db06da","parameters":{"updates":["message"],"additionalFields":{}},"credentials":{"telegramApi":{"id":"bjWKPKeA3XN4NmBU","name":"Fin Assistant"}},"typeVersion":1.5},{"id":"49187923-8745-4999-8350-bfe75c238edb","name":"CashLens Financial Assistant","type":"@n8n/n8n-nodes-langchain.agent","position":[576,1024],"parameters":{"text":"={{ $json.message.text }}","options":{"maxIterations":10,"systemMessage":"=You are CashLens, a friendly personal financial assistant chatting with the user on Telegram.\nToday is {{ $now.setZone(\"Asia/Kolkata\").toFormat(\"cccc, dd LLL yyyy\") }} (timezone Asia/Kolkata). Currency is INR - show amounts as ₹ with Indian digit grouping (e.g. ₹1,25,000).\n\nTools:\n- get_transactions: reads every row of the user's transaction ledger (Expenses tab). DEBIT = money spent, CREDIT = money received.\n- get_review_queue: reads bank SMS that could not be parsed and are not yet in the ledger.\n- calculator: use it for sums, averages and percentages so numbers are exact.\n\nHow to answer:\n- For any question about the user's own money (totals, spend by merchant/category/payment method, comparisons between periods, biggest expenses, trends, unusual or duplicate charges, savings tips) call get_transactions first, filter rows by transaction_date for the period asked, then compute. Never invent transactions.\n- If the category column is UNCATEGORIZED, group by merchant instead and mention it briefly.\n- For general finance questions (budgeting, saving, concepts) answer from your own knowledge; no tool needed.\n- State the period and number of transactions you used. If no data matches, say so.\n- Reply in plain text suitable for Telegram: short paragraphs and simple \"-\" bullet lists, no tables, no markdown headings, no asterisks. Keep replies under 3000 characters.\n- You can only read the data; you cannot change the sheet."},"promptType":"define"},"typeVersion":3.1},{"id":"f498a4e5-e735-42d0-aa57-bf942f418e23","name":"Claude Model","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","position":[432,1216],"parameters":{"model":{"__rl":true,"mode":"list","value":"claude-sonnet-5","cachedResultName":"Claude Sonnet 5"},"options":{"maxTokensToSample":2048}},"credentials":{"anthropicApi":{"id":null,"name":"Gateway credits","__aiGatewayManaged":true}},"typeVersion":1.6},{"id":"e02980fe-5401-4467-95f4-b5fd386c5349","name":"Conversation Memory","type":"@n8n/n8n-nodes-langchain.memoryBufferWindow","position":[592,1216],"parameters":{"sessionKey":"=cashlens-{{ $(\"Telegram Message\").item.json.message.chat.id }}","sessionIdType":"customKey","contextWindowLength":10},"typeVersion":1.4},{"id":"b74c62b8-3409-4635-9d79-2adc1386c290","name":"get_transactions","type":"n8n-nodes-base.googleSheetsTool","position":[752,1248],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"list","value":"gid=0","cachedResultName":"Expenses"},"documentId":{"__rl":true,"mode":"list","value":"1F6x02uqmFqE4wtn12-nvOk0ZFkXO6CJbkGItIEzJ_yY","cachedResultName":"CashLens | Personal Transaction Ledger"},"descriptionType":"manual","toolDescription":"Reads ALL rows of the CashLens Transaction Ledger (the Expenses tab). Each row is one bank transaction with transaction_date (YYYY-MM-DD), amount (INR), transaction_type (DEBIT = money spent, CREDIT = money received), merchant, category, payment_method, account_last4, reference_id. Call this before answering any question about the user spending, income, totals, trends or merchants."},"credentials":{"googleSheetsOAuth2Api":{"id":"UuN5J6JJJzfjxPoc","name":"Google Sheets account"}},"typeVersion":4.7},{"id":"9b18f8b5-5fa1-45b9-921d-ee21e560398a","name":"get_review_queue","type":"n8n-nodes-base.googleSheetsTool","position":[1024,1248],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"list","value":"182681919","cachedResultName":"Review_Queue"},"documentId":{"__rl":true,"mode":"list","value":"1F6x02uqmFqE4wtn12-nvOk0ZFkXO6CJbkGItIEzJ_yY","cachedResultName":"CashLens | Personal Transaction Ledger"},"descriptionType":"manual","toolDescription":"Reads the Review_Queue tab: bank SMS that could not be fully parsed (missing amount, type or date) and are NOT included in the ledger. Use when the user asks about pending, unreviewed or missing transactions."},"credentials":{"googleSheetsOAuth2Api":{"id":"UuN5J6JJJzfjxPoc","name":"Google Sheets account"}},"typeVersion":4.7},{"id":"566cdd89-53ac-476c-8f18-b457d31738f8","name":"calculator","type":"@n8n/n8n-nodes-langchain.toolCalculator","position":[1312,1248],"parameters":{},"typeVersion":1},{"id":"d1312b22-0766-43d2-a96a-884e4af5a1c5","name":"Send Telegram Reply","type":"n8n-nodes-base.telegram","position":[1312,1024],"webhookId":"f4ddd188-258b-45fe-b9a0-f599abad8390","parameters":{"text":"={{ $json.output }}","chatId":"={{ $(\"Telegram Message\").item.json.message.chat.id }}","additionalFields":{"appendAttribution":false,"reply_to_message_id":"={{ $(\"Telegram Message\").item.json.message.message_id }}"}},"credentials":{"telegramApi":{"id":"bjWKPKeA3XN4NmBU","name":"Fin Assistant"}},"typeVersion":1.2},{"id":"0245ccc8-b0d3-426d-88f6-d0b0e2de90a4","name":"Sticky Note 0245ccc8","type":"n8n-nodes-base.stickyNote","position":[-1312,400],"parameters":{"width":560,"height":900,"content":"## CashLens: Bank SMS expense tracker and Telegram finance assistant\n\nTurns your bank SMS alerts into a clean transaction ledger in Google Sheets. You can then ask a Telegram bot questions about your spending in plain language.\n\n**Who it's for:** anyone in India who wants automatic expense tracking from bank SMS without connecting a bank account or a paid app.\n\n### How it works\n1. An SMS forwarder app on your Android phone POSTs each bank SMS to the webhook.\n2. The parser pulls out amount, debit/credit, date, merchant, payment method, account last 4 and reference ID. It also rejects OTPs and unknown senders.\n3. Complete transactions go to the **Expenses** tab. Incomplete ones go to **Review_Queue**. Rejected ones get a 422 response.\n4. On Telegram, an AI agent reads the sheet, calculates totals and trends, and replies in the same chat.\n\n### Setup steps\n1. Make a Google Sheet with two tabs, **Expenses** and **Review_Queue**, using the column names from the parser output. Then select the sheet in all four Google Sheets nodes.\n2. Create a Header Auth credential for the webhook. Have your SMS forwarder send the same header with `message`, `sender`, `event_id` and `sent_at` in the body.\n3. In **Parse & Normalize Transaction**, add your bank's sender IDs to `allowedSenders`.\n4. Create a bot with @BotFather and connect it in the Telegram trigger and the reply node.\n5. Connect an Anthropic credential to the chat model, then publish.\n\n### Customization\n- Add more SMS formats to the parser for other banks.\n- Replace UNCATEGORIZED with your own category rules.\n- Edit the agent's system message to change its tone or rules."},"typeVersion":1},{"id":"5976d770-39d1-4088-87a2-fe7aa37580e4","name":"Sticky Note 5976d770","type":"n8n-nodes-base.stickyNote","position":[-272,-208],"parameters":{"color":"#2A297A","width":1632,"height":864,"content":"## 1. Record bank transactions\nReceives each forwarded SMS through a secured webhook and parses it into structured fields. Then it routes it:\n- **Valid**: upserted into the ledger (de-duplicated on `source_event_id`)\n- **Incomplete**: saved to the review queue\n- **OTP or unknown sender**: rejected\n\nEvery path returns a JSON response to the SMS forwarder."},"typeVersion":1},{"id":"21122d2d-4c9a-47c5-a4ea-638564f40b94","name":"Sticky Note 21122d2d","type":"n8n-nodes-base.stickyNote","position":[-16,896],"parameters":{"color":6,"width":1488,"height":672,"content":"## 2. Personal finance assistant\nAnswers Telegram questions such as \"How much did I spend on Swiggy last month?\" It reads the ledger and review queue (read-only), uses the calculator for exact totals, and remembers the last 10 messages per chat.\n\nReplies come back as plain text in the same chat."},"typeVersion":1}],"active":true,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"43f33f9c-db57-4b34-ad57-0af47bb92390","nodeGroups":[{"id":"b9261337-3072-4d79-84ef-0c981beead49","name":"Record bank transactions","nodeIds":["5976d770-39d1-4088-87a2-fe7aa37580e4","8db8d61f-0b5f-417d-80b1-5579e876f55d","db19fd18-7a73-4e32-8b22-e0743df2c32f","d8214df1-dd55-4e95-b9bd-b2ff95197c6c","75c93388-3244-45b5-80d8-1a6fc70afc43","c1082c43-3a8e-4588-91de-e5d62b7cf2db","e163b8e1-2460-43c9-8dee-4045a98cdfb2","66da45f6-bfbd-486c-8a6e-71e1ceaad8a5","705378fe-6fa1-43af-a064-b8f120cd38af"],"description":"Each incoming bank SMS is parsed, then saved to the ledger, sent to the review queue, or rejected"},{"id":"31d3d604-9132-474d-b16e-ad468bc9cf4c","name":"Personal Finance Assistant","nodeIds":["21122d2d-4c9a-47c5-a4ea-638564f40b94","49187923-8745-4999-8350-bfe75c238edb","f498a4e5-e735-42d0-aa57-bf942f418e23","e02980fe-5401-4467-95f4-b5fd386c5349","b74c62b8-3409-4635-9d79-2adc1386c290","9b18f8b5-5fa1-45b9-921d-ee21e560398a","566cdd89-53ac-476c-8f18-b457d31738f8","d1312b22-0766-43d2-a96a-884e4af5a1c5"],"description":"Your Telegram questions are answered from the ledger sheet (totals, trends, insights) and replied to in the same chat"}],"connections":{"calculator":{"ai_tool":[[{"node":"CashLens Financial Assistant","type":"ai_tool","index":0}]]},"Claude Model":{"ai_languageModel":[[{"node":"CashLens Financial Assistant","type":"ai_languageModel","index":0}]]},"Receive Bank SMS":{"main":[[{"node":"Parse & Normalize Transaction","type":"main","index":0}]]},"Telegram Message":{"main":[[{"node":"CashLens Financial Assistant","type":"main","index":0}]]},"get_review_queue":{"ai_tool":[[{"node":"CashLens Financial Assistant","type":"ai_tool","index":0}]]},"get_transactions":{"ai_tool":[[{"node":"CashLens Financial Assistant","type":"ai_tool","index":0}]]},"Conversation Memory":{"ai_memory":[[{"node":"CashLens Financial Assistant","type":"ai_memory","index":0}]]},"Needs Manual Review?":{"main":[[{"node":"Save to Review Queue","type":"main","index":0}],[{"node":"Reject Invalid Transaction","type":"main","index":0}]]},"Save to Review Queue":{"main":[[{"node":"Confirm Review Queue","type":"main","index":0}]]},"Is Transaction Valid?":{"main":[[{"node":"Save to Transaction Ledger","type":"main","index":0}],[{"node":"Needs Manual Review?","type":"main","index":0}]]},"Save to Transaction Ledger":{"main":[[{"node":"Confirm Transaction Saved","type":"main","index":0}]]},"CashLens Financial Assistant":{"main":[[{"node":"Send Telegram Reply","type":"main","index":0}]]},"Parse & Normalize Transaction":{"main":[[{"node":"Is Transaction Valid?","type":"main","index":0}]]}}}