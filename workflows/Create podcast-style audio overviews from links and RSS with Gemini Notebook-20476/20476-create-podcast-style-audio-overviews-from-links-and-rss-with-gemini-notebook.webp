","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":3,"position":[2000,660],"parameters":{"url":"={{ 'https://api.useapi.net/v1/gemini-notebook/jobs/' + encodeURIComponent($json.state.jobid) }}","method":"GET","options":{"timeout":60000},"authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"credentials":{"httpHeaderAuth":{"id":"credential-id","name":"useapi.net API token"}},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"name":"Job status","type":"n8n-nodes-base.code","position":[2220,660],"parameters":{"jsCode":"\nconst apiErr = j => {\n  if (!j || !j.error || j.jobid) return null;  // a job record carries its own error object, read by the caller\n  const e = j.error;\n  const msg = typeof e === 'string' ? e : String(e.message || '');\n  let body = typeof e === 'string' ? j : null;\n  const m = msg.match(/^(\\d{3}) - ([\\s\\S]*)$/);\n  if (m) { try { body = JSON.parse(m[2]); if (typeof body === 'string') body = JSON.parse(body); } catch (x) { body = null; } }\n  const code = Number((body && body.code) || (m && m[1]) || (typeof e === 'object' && e.httpCode) || 0) || 0;\n  let text = (body && typeof body.error === 'string' && body.error) || (typeof e === 'object' && e.description) || msg || 'no answer';\n  const retryAt = (body && body.retryAt) || ((msg.match(/retryAt\\\\?\"\\s*:\\s*\\\\?\"([^\"\\\\]+)/) || [])[1]) || null;\n  return { code, text: String(text).slice(0, 300), retryAt };\n};\n// temporary: retried. Everything else is a dead end that needs the user.\nconst temporary = err => !err.code || err.code >= 500 && err.code !== 596 || /re-checking|retry shortly|busy/i.test(err.text);\nconst when = iso => { const d = new Date(iso); if (isNaN(d)) return String(iso);\n  const h = Math.max(0, Math.round((d - Date.now()) / 360000) / 10);\n  return `${d.toISOString().slice(0, 16).replace('T', ' ')} UTC (in about ${h} h)`; };\nconst SETUP = 'https://useapi.net/docs/start-here/setup-gemini-notebook?utm_source=n8n&utm_medium=referral&utm_campaign=notebooklm-podcast-app';\nconst quotaHelp = retryAt => `This Google account is out of NotebookLM usage for now${retryAt ? `. It resets at ${when(retryAt)}` : ''}. To keep going, connect more Google accounts at useapi.net and leave the Google account field empty, so the next run can use another account.`;\nconst explain = (err, what) => {\n  if (err.code === 401) return `${what}: the useapi.net API token was refused. Open the \"useapi.net API token\" credential in n8n and check it: Name Authorization, Value Bearer YOUR_TOKEN_HERE by your token.`;\n  if (err.code === 429 && (err.retryAt || /window|usage/i.test(err.text))) return quotaHelp(err.retryAt);\n  if (err.code === 596) return `${what}: Google signed the account out (${err.text}). Reconnect the Google account with the Gemini Notebook setup at ${SETUP}, then try again.`;\n  if (err.code === 404 && /account/i.test(err.text)) return `${what}: ${err.text}. Check the Google account email: it must be connected to useapi.net with the Gemini Notebook setup (${SETUP}). Or leave it empty to use any connected account.`;\n  if (err.code === 429 && /busy|maxJobs/i.test(err.text)) return `${what}: the Google account is already running its maximum number of NotebookLM jobs (${err.text}). Wait until they finish and try again, raise maxJobs for the account at useapi.net, or connect more Google accounts.`;\n  if (temporary(err)) return `${what}: a temporary problem at Google or on the network (${err.text}). It was retried a few times. Try again in a few minutes.`;\n  return `${what}: ${err.text}`;\n};\nconst stop = (s, message) => [{ json: { route: 'stop', state: s, message } }];\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst mmss = sec => sec ? `${Math.floor(sec / 60)}:${String(Math.round(sec % 60)).padStart(2, '0')}` : '';\n\n// Poll every 20 s, at most 30 minutes.\nconst s = $('Wait 20s').last().json.state;\ns.polls = (s.polls || 0) + 1;\nconst j = $json;\nconst err = apiErr(j);\nif (err) { s.readErrors = (s.readErrors || 0) + 1;\n  if (temporary(err) && s.readErrors <= 6) return [{ json: { route: 'wait', state: s } }];\n  return stop(s, explain(err, 'The podcast job could not be read')); }\ns.readErrors = 0;\nif (j.status === 'completed') {\n  const files = (j.result && j.result.files) || [];\n  const f = files.find(x => x.format === 'm4a') || files[0];\n  if (!f) return stop(s, 'The Audio Overview finished without an audio file. Open the notebook in NotebookLM to check it.');\n  s.episode = { title: j.result.title || s.title, duration: j.result.duration || 0, url: f.url, artifact: j.artifact, mimeType: f.mimeType || 'audio/mp4' };\n  return [{ json: { route: 'done', state: s } }];\n}\nif (j.status === 'failed') { const e = j.error || {};\n  const msg = e.code === 'quota' ? quotaHelp(e.retryAt)\n    : e.code === 'account' ? `Google signed the account out while the podcast was being made. Reconnect it with the Gemini Notebook setup at ${SETUP}, then try again.`\n    : e.code === 'generation_failed' ? `Google could not generate the Audio Overview: ${e.message || 'no reason given'}. Try again, or try other sources or a different format.`\n    : `The podcast failed: ${e.message || e.code || 'no reason given'}`;\n  return stop(s, msg); }\nif (s.polls >= 90) return stop(s, `The podcast is not finished after 30 minutes. Google may still finish it: it will appear in the notebook \"${s.title}\" in NotebookLM.`);\nreturn [{ json: { route: 'wait', state: s } }];\n"},"typeVersion":2},{"name":"Job next","type":"n8n-nodes-base.switch","position":[2440,660],"parameters":{"mode":"expression","output":"={{ {\"wait\": 0, \"stop\": 1, \"done\": 2}[$json.route] ?? 2 }}","numberOutputs":3},"typeVersion":3.2},{"name":"From the form?","type":"n8n-nodes-base.if","position":[2660,660],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"c1c3f88c-9ae2-5779-aab3-8701b7172c29","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.state.source === 'form' }}","rightValue":true}]}},"typeVersion":2.2},{"name":"Result page","type":"n8n-nodes-base.code","position":[2880,560],"parameters":{"jsCode":"\nconst apiErr = j => {\n  if (!j || !j.error || j.jobid) return null;  // a job record carries its own error object, read by the caller\n  const e = j.error;\n  const msg = typeof e === 'string' ? e : String(e.message || '');\n  let body = typeof e === 'string' ? j : null;\n  const m = msg.match(/^(\\d{3}) - ([\\s\\S]*)$/);\n  if (m) { try { body = JSON.parse(m[2]); if (typeof body === 'string') body = JSON.parse(body); } catch (x) { body = null; } }\n  const code = Number((body && body.code) || (m && m[1]) || (typeof e === 'object' && e.httpCode) || 0) || 0;\n  let text = (body && typeof body.error === 'string' && body.error) || (typeof e === 'object' && e.description) || msg || 'no answer';\n  const retryAt = (body && body.retryAt) || ((msg.match(/retryAt\\\\?\"\\s*:\\s*\\\\?\"([^\"\\\\]+)/) || [])[1]) || null;\n  return { code, text: String(text).slice(0, 300), retryAt };\n};\n// temporary: retried. Everything else is a dead end that needs the user.\nconst temporary = err => !err.code || err.code >= 500 && err.code !== 596 || /re-checking|retry shortly|busy/i.test(err.text);\nconst when = iso => { const d = new Date(iso); if (isNaN(d)) return String(iso);\n  const h = Math.max(0, Math.round((d - Date.now()) / 360000) / 10);\n  return `${d.toISOString().slice(0, 16).replace('T', ' ')} UTC (in about ${h} h)`; };\nconst SETUP = 'https://useapi.net/docs/start-here/setup-gemini-notebook?utm_source=n8n&utm_medium=referral&utm_campaign=notebooklm-podcast-app';\nconst quotaHelp = retryAt => `This Google account is out of NotebookLM usage for now${retryAt ? `. It resets at ${when(retryAt)}` : ''}. To keep going, connect more Google accounts at useapi.net and leave the Google account field empty, so the next run can use another account.`;\nconst explain = (err, what) => {\n  if (err.code === 401) return `${what}: the useapi.net API token was refused. Open the \"useapi.net API token\" credential in n8n and check it: Name Authorization, Value Bearer YOUR_TOKEN_HERE by your token.`;\n  if (err.code === 429 && (err.retryAt || /window|usage/i.test(err.text))) return quotaHelp(err.retryAt);\n  if (err.code === 596) return `${what}: Google signed the account out (${err.text}). Reconnect the Google account with the Gemini Notebook setup at ${SETUP}, then try again.`;\n  if (err.code === 404 && /account/i.test(err.text)) return `${what}: ${err.text}. Check the Google account email: it must be connected to useapi.net with the Gemini Notebook setup (${SETUP}). Or leave it empty to use any connected account.`;\n  if (err.code === 429 && /busy|maxJobs/i.test(err.text)) return `${what}: the Google account is already running its maximum number of NotebookLM jobs (${err.text}). Wait until they finish and try again, raise maxJobs for the account at useapi.net, or connect more Google accounts.`;\n  if (temporary(err)) return `${what}: a temporary problem at Google or on the network (${err.text}). It was retried a few times. Try again in a few minutes.`;\n  return `${what}: ${err.text}`;\n};\nconst stop = (s, message) => [{ json: { route: 'stop', state: s, message } }];\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst mmss = sec => sec ? `${Math.floor(sec / 60)}:${String(Math.round(sec % 60)).padStart(2, '0')}` : '';\n\n// The player and the download link call this workflow's own \"Podcast audio\" webhook, which fetches the file\n// with your credential, so the API token never reaches the browser.\nconst s = $json.state, e = s.episode;\nconst origin = String($execution.resumeFormUrl || $execution.resumeUrl).match(/^https?:\\/\\/[^/]+/)[0];  // the Code sandbox has no URL class\nconst name = (e.title || 'podcast').replace(/[^A-Za-z0-9 ._-]+/g, '').trim().slice(0, 80) || 'podcast';\nconst play = `${origin}/webhook/notebooklm-podcast-audio?a=${encodeURIComponent(e.artifact)}&n=${encodeURIComponent(name)}`;\nconst another = `${origin}/form/notebooklm-podcast`;\nconst fmt = { deep_dive: 'Deep dive', brief: 'Brief', critique: 'Critique', debate: 'Debate' }[s.format] || s.format;\nconst skipped = s.skipped.length ? `<p><b>Skipped sources</b></p><ul>${s.skipped.map(x => `<li>${esc(x.url)}: ${esc(x.reason)}</li>`).join('')}</ul>` : '';\nconst html = `<h3>${esc(e.title)}</h3><p>${mmss(e.duration) ? `${mmss(e.duration)} min · ` : ''}${fmt} · made from ${s.ready.length} source${s.ready.length > 1 ? 's' : ''}</p>\n<video controls preload=\"metadata\"><source src=\"${play}\" type=\"audio/mp4\"></video>\n<p><a href=\"${play}&dl=1\" target=\"_blank\" rel=\"noopener\">Download the .m4a</a> · <a href=\"${another}\" target=\"_blank\" rel=\"noopener\">Make another podcast</a></p>\n${skipped}\n<p>The episode also stays in the notebook \"${esc(s.title)}\" of your Google account, where you can listen, share it or chat with the sources.</p>\n<p><small>Come back to this page any time: <a href=\"${$execution.resumeFormUrl}\">${$execution.resumeFormUrl}</a></small></p>`;\nreturn [{ json: { state: s, fields: [{ fieldType: 'html', html }] } }];\n"},"typeVersion":2},{"name":"Your podcast","type":"n8n-nodes-base.form","position":[3100,560],"webhookId":"ccc9fa77-ea22-517a-86ba-7d45cb8cb000","parameters":{"options":{"customCss":":root{--font-family:system-ui,-apple-system,'Segoe UI',sans-serif;--container-width:720px}.form-group table{width:100%;border-collapse:collapse}.form-group td,.form-group th{text-align:left;vertical-align:top;padding:6px 8px;border-bottom:1px solid #e3e6ea;font-size:14px}.form-group th{font-size:13px;color:#5f6368;font-weight:600}.form-group td:first-child{white-space:nowrap}.form-group video{width:100%;height:54px;display:block;margin:8px 0}.form-group h3{margin:6px 0 2px;font-size:18px}.form-group a{word-break:break-all}","formTitle":"Your podcast is ready","buttonLabel":"Finish","formDescription":"Press play, or download the audio file."},"operation":"page","defineForm":"json","jsonOutput":"={{ JSON.stringify($json.fields) }}"},"typeVersion":2.5},{"name":"Finish","type":"n8n-nodes-base.form","position":[3320,560],"webhookId":"c178f43c-4411-545a-9e38-84ce05fc4032","parameters":{"options":{},"operation":"completion","respondWith":"text","completionTitle":"Done","completionMessage":"Open the form again to make another podcast."},"typeVersion":2.5},{"name":"Download podcast","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":3,"position":[2880,780],"parameters":{"url":"={{ $json.state.episode.url }}","method":"GET","options":{"timeout":300000,"response":{"response":{"responseFormat":"file"}}},"authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"credentials":{"httpHeaderAuth":{"id":"credential-id","name":"useapi.net API token"}},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"name":"Episode","type":"n8n-nodes-base.code","position":[3100,780],"parameters":{"jsCode":"\nconst apiErr = j => {\n  if (!j || !j.error || j.jobid) return null;  // a job record carries its own error object, read by the caller\n  const e = j.error;\n  const msg = typeof e === 'string' ? e : String(e.message || '');\n  let body = typeof e === 'string' ? j : null;\n  const m = msg.match(/^(\\d{3}) - ([\\s\\S]*)$/);\n  if (m) { try { body = JSON.parse(m[2]); if (typeof body === 'string') body = JSON.parse(body); } catch (x) { body = null; } }\n  const code = Number((body && body.code) || (m && m[1]) || (typeof e === 'object' && e.httpCode) || 0) || 0;\n  let text = (body && typeof body.error === 'string' && body.error) || (typeof e === 'object' && e.description) || msg || 'no answer';\n  const retryAt = (body && body.retryAt) || ((msg.match(/retryAt\\\\?\"\\s*:\\s*\\\\?\"([^\"\\\\]+)/) || [])[1]) || null;\n  return { code, text: String(text).slice(0, 300), retryAt };\n};\n// temporary: retried. Everything else is a dead end that needs the user.\nconst temporary = err => !err.code || err.code >= 500 && err.code !== 596 || /re-checking|retry shortly|busy/i.test(err.text);\nconst when = iso => { const d = new Date(iso); if (isNaN(d)) return String(iso);\n  const h = Math.max(0, Math.round((d - Date.now()) / 360000) / 10);\n  return `${d.toISOString().slice(0, 16).replace('T', ' ')} UTC (in about ${h} h)`; };\nconst SETUP = 'https://useapi.net/docs/start-here/setup-gemini-notebook?utm_source=n8n&utm_medium=referral&utm_campaign=notebooklm-podcast-app';\nconst quotaHelp = retryAt => `This Google account is out of NotebookLM usage for now${retryAt ? `. It resets at ${when(retryAt)}` : ''}. To keep going, connect more Google accounts at useapi.net and leave the Google account field empty, so the next run can use another account.`;\nconst explain = (err, what) => {\n  if (err.code === 401) return `${what}: the useapi.net API token was refused. Open the \"useapi.net API token\" credential in n8n and check it: Name Authorization, Value Bearer YOUR_TOKEN_HERE by your token.`;\n  if (err.code === 429 && (err.retryAt || /window|usage/i.test(err.text))) return quotaHelp(err.retryAt);\n  if (err.code === 596) return `${what}: Google signed the account out (${err.text}). Reconnect the Google account with the Gemini Notebook setup at ${SETUP}, then try again.`;\n  if (err.code === 404 && /account/i.test(err.text)) return `${what}: ${err.text}. Check the Google account email: it must be connected to useapi.net with the Gemini Notebook setup (${SETUP}). Or leave it empty to use any connected account.`;\n  if (err.code === 429 && /busy|maxJobs/i.test(err.text)) return `${what}: the Google account is already running its maximum number of NotebookLM jobs (${err.text}). Wait until they finish and try again, raise maxJobs for the account at useapi.net, or connect more Google accounts.`;\n  if (temporary(err)) return `${what}: a temporary problem at Google or on the network (${err.text}). It was retried a few times. Try again in a few minutes.`;\n  return `${what}: ${err.text}`;\n};\nconst stop = (s, message) => [{ json: { route: 'stop', state: s, message } }];\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst mmss = sec => sec ? `${Math.floor(sec / 60)}:${String(Math.round(sec % 60)).padStart(2, '0')}` : '';\n\n// The finished episode: the .m4a as binary \"data\", and what it is about as JSON. Add your next node here.\nconst s = $('From the form?').first().json.state;\nconst it = $input.first();\nif (!it.binary || !it.binary.data) throw new Error(`The audio file could not be downloaded: ${(apiErr(it.json) || { text: 'empty answer' }).text}. It is still in the notebook \"${s.title}\".`);\nconst name = (s.episode.title || s.title).replace(/[^A-Za-z0-9 ._-]+/g, '').trim().slice(0, 80) || 'podcast';\nit.binary.data.fileName = `${name}.m4a`; it.binary.data.mimeType = 'audio/mp4';\nreturn [{ json: { title: s.episode.title, duration: s.episode.duration, show: s.title, posts: s.posts || [], sources: s.ready, skipped: s.skipped, notebook: s.notebook, fileName: `${name}.m4a` }, binary: it.binary }];\n"},"typeVersion":2},{"name":"Show a page?","type":"n8n-nodes-base.if","position":[2440,1100],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"13a9f6a4-c634-5d64-b30d-8d6e8fc90a6e","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ ($json.state || {}).source === 'form' }}","rightValue":true}]}},"typeVersion":2.2},{"name":"Stopped","type":"n8n-nodes-base.form","position":[2660,1020],"webhookId":"4e0614a4-9fa8-5b7d-8945-d9b5d70b8739","parameters":{"options":{"customCss":":root{--font-family:system-ui,-apple-system,'Segoe UI',sans-serif;--container-width:720px}.form-group table{width:100%;border-collapse:collapse}.form-group td,.form-group th{text-align:left;vertical-align:top;padding:6px 8px;border-bottom:1px solid #e3e6ea;font-size:14px}.form-group th{font-size:13px;color:#5f6368;font-weight:600}.form-group td:first-child{white-space:nowrap}.form-group video{width:100%;height:54px;display:block;margin:8px 0}.form-group h3{margin:6px 0 2px;font-size:18px}.form-group a{word-break:break-all}","formTitle":"Stopped","buttonLabel":"Close","formDescription":"The podcast could not be made."},"operation":"page","defineForm":"json","jsonOutput":"={{ JSON.stringify([{ fieldType: 'html', html: '<p><b>' + String($json.message || 'Something went wrong.').replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</b></p><p>Fix this, then open the form again.</p>' }]) }}"},"typeVersion":2.5},{"name":"Stop with error","type":"n8n-nodes-base.stopAndError","position":[2660,1180],"parameters":{"errorMessage":"={{ $json.message || 'The podcast could not be made.' }}"},"typeVersion":1},{"name":"Podcast audio","type":"n8n-nodes-base.webhook","position":[0,1360],"webhookId":"94b3e11d-3bf4-5975-8254-3367990b1892","parameters":{"path":"notebooklm-podcast-audio","options":{},"responseMode":"responseNode"},"typeVersion":2},{"name":"Audio request","type":"n8n-nodes-base.code","position":[220,1360],"parameters":{"jsCode":"\n// Only an artifact id is accepted, never a URL, so this webhook cannot be used to send your token elsewhere.\nconst q = $json.query || {};\nconst a = String(q.a || '');\nif (!/^user:\\d+-\\S+-artifact:[0-9a-f-]{36}:[0-9a-f-]{36}$/i.test(a)) throw new Error('Unknown podcast');\nconst name = String(q.n || 'podcast').replace(/[^A-Za-z0-9 ._-]+/g, '').slice(0, 80) || 'podcast';\nreturn [{ json: { url: 'https://api.useapi.net/v1/gemini-notebook/artifacts/download?artifact=' + encodeURIComponent(a) + '&format=m4a', download: q.dl === '1', name } }];\n"},"typeVersion":2},{"name":"Fetch audio","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":3,"position":[440,1360],"parameters":{"url":"={{ $json.url }}","method":"GET","options":{"timeout":300000,"response":{"response":{"responseFormat":"file"}}},"authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"credentials":{"httpHeaderAuth":{"id":"credential-id","name":"useapi.net API token"}},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"name":"Send audio","type":"n8n-nodes-base.respondToWebhook","position":[660,1360],"parameters":{"options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"audio/mp4"},{"name":"Cache-Control","value":"private, max-age=3600"},{"name":"Content-Disposition","value":"={{ ($('Audio request').first().json.download ? 'attachment' : 'inline') + '; filename=\"' + $('Audio request').first().json.name + '.m4a\"' }}"}]}},"respondWith":"binary"},"typeVersion":1.1},{"name":"Overview","type":"n8n-nodes-base.stickyNote","position":[-780,-180],"parameters":{"color":7,"width":660,"height":760,"content":"## NotebookLM Podcast App: turn links or an RSS feed into an Audio Overview\n\n**Who it's for:** newsletter writers, educators, podcasters and content teams who want audio versions of articles, reports and YouTube videos, on demand or every week.\n\nIt uses **NotebookLM** (now **Gemini Notebook**) on your own Google account through the [useapi.net Gemini Notebook API](https://useapi.net/docs/api-gemini-notebook-v1?utm_source=n8n&utm_medium=referral&utm_campaign=notebooklm-podcast-app). Google's own NotebookLM API is Enterprise-only (Google Cloud licenses).\n\n**How it works**\n1. **Form:** paste up to 50 links, pick format, length, language and an optional focus. A page shows which sources Google could read, then the podcast plays in the browser with a download link.\n2. **Schedule:** every Monday the newest posts of an RSS feed become one episode, as an `.m4a` file for the next node.\n3. Both share one pipeline: create a notebook, add the links, wait until Google has read them (sources that fail, like YouTube videos without captions, are skipped and listed), generate the Audio Overview, poll until done.\n4. Temporary errors are retried. Usage limits, a signed-out account or a bad token stop with a message that says what to fix.\n\n**Set up**\n1. Get a [useapi.net](https://useapi.net/docs/start-here/setup-useapi?utm_source=n8n&utm_medium=referral&utm_campaign=notebooklm-podcast-app) API token and connect your Google account with the [Gemini Notebook setup](https://useapi.net/docs/start-here/setup-gemini-notebook?utm_source=n8n&utm_medium=referral&utm_campaign=notebooklm-podcast-app).\n2. Create a **Header Auth** credential: Name `Authorization`, Value `Bearer <your API token>`. Select it on every HTTP Request node.\n3. Publish (activate) the workflow and open the **Make a podcast** form URL.\n4. For the weekly episode, set your feed in **Feed settings** and enable **Every Monday at 7:00** (it ships disabled).\n\n**Requirements:** a useapi.net subscription and a Google account with NotebookLM. A free Google account works; each podcast uses part of its NotebookLM usage.\n\n**Customize:** defaults live in **Form settings** and **Feed settings**. Add Google Drive, S3, Telegram or a podcast host after **Episode**."},"typeVersion":1},{"name":"Note: form","type":"n8n-nodes-base.stickyNote","position":[-60,-180],"parameters":{"color":5,"width":820,"height":640,"content":"### 1. Two ways in\n**Make a podcast** is the form. **Every Monday at 7:00** reads an RSS feed; it ships disabled, enable it for a weekly episode. Both produce the same settings: title, links, format, length, language, focus and Google account."},"typeVersion":1},{"name":"Note: sources","type":"n8n-nodes-base.stickyNote","position":[860,-320],"parameters":{"color":5,"width":2620,"height":640,"content":"### 2. Notebook and sources\nA new notebook per episode, then all links in one call (one by one if Google refuses the batch, so a bad link is skipped, not fatal). Google reads them; the notebook is checked every 10 s for up to 10 minutes. Failed sources, like YouTube videos without captions, are skipped and listed. On the form, the **Sources** page shows what was read before the podcast is made."},"typeVersion":1},{"name":"Note: audio","type":"n8n-nodes-base.stickyNote","position":[860,340],"parameters":{"color":5,"width":1900,"height":480,"content":"### 3. Audio Overview\nStarts the job once (it is never resubmitted blind), retries while the account is busy or Google has a temporary problem, then polls every 20 s for up to 30 minutes."},"typeVersion":1},{"name":"Note: result","type":"n8n-nodes-base.stickyNote","position":[2800,340],"parameters":{"color":5,"width":960,"height":640,"content":"### 4. Result\nForm: **Your podcast** plays the episode in the browser, with a download link and the skipped sources. Schedule: **Episode** holds the `.m4a` as binary."},"typeVersion":1},{"name":"Note: next node","type":"n8n-nodes-base.stickyNote","position":[3320,700],"parameters":{"color":4,"width":420,"height":260,"content":"### Add your next node here\nConnect Google Drive, S3, Telegram, Slack or your podcast host to **Episode**. It holds the `.m4a` as binary `data`, plus the title, duration and sources as JSON."},"typeVersion":1},{"name":"Note: stops","type":"n8n-nodes-base.stickyNote","position":[2380,860],"parameters":{"color":3,"width":640,"height":440,"content":"### 5. Stops\nOn the form, a page says what went wrong and what to fix: a refused token, no NotebookLM usage left (with the reset time), a signed-out Google account, or links Google could not read. On the schedule, the run fails with the same message, so an n8n error workflow can alert you."},"typeVersion":1},{"name":"Note: audio webhook","type":"n8n-nodes-base.stickyNote","position":[-60,1180],"parameters":{"color":5,"width":820,"height":340,"content":"### 6. Podcast audio (player and download)\nThe player and the download link on **Your podcast** call this webhook. It fetches the file with your credential, so the token never reaches the browser, and it accepts only an artifact id."},"typeVersion":1}],"pinData":{},"settings":{"executionOrder":"v1"},"connections":{"Sources":{"main":[[{"node":"Generate request","type":"main","index":0}]]},"Job next":{"main":[[{"node":"Wait 20s","type":"main","index":0}],[{"node":"Show a page?","type":"main","index":0}],[{"node":"From the form?","type":"main","index":0}]]},"Wait 10s":{"main":[[{"node":"Read notebook","type":"main","index":0}]]},"Wait 20s":{"main":[[{"node":"Check job","type":"main","index":0}]]},"Check job":{"main":[[{"node":"Job status","type":"main","index":0}]]},"Read feed":{"main":[[{"node":"Newest posts","type":"main","index":0}]]},"Any links?":{"main":[[{"node":"Create notebook","type":"main","index":0}],[{"node":"Show a page?","type":"main","index":0}]]},"Job status":{"main":[[{"node":"Job next","type":"main","index":0}]]},"Add sources":{"main":[[{"node":"Sources added","type":"main","index":0}]]},"Fetch audio":{"main":[[{"node":"Send audio","type":"main","index":0}]]},"Links added":{"main":[[{"node":"Sources route","type":"main","index":0}]]},"Result page":{"main":[[{"node":"Your podcast","type":"main","index":0}]]},"Newest posts":{"main":[[{"node":"Any links?","type":"main","index":0}]]},"Notebook ok?":{"main":[[{"node":"Add sources","type":"main","index":0}],[{"node":"Show a page?","type":"main","index":0}]]},"Retry in 15s":{"main":[[{"node":"Generate request","type":"main","index":0}]]},"Show a page?":{"main":[[{"node":"Stopped","type":"main","index":0}],[{"node":"Stop with error","type":"main","index":0}]]},"Sources next":{"main":[[{"node":"Wait 10s","type":"main","index":0}],[{"node":"Show a page?","type":"main","index":0}],[{"node":"Sources","type":"main","index":0}],[{"node":"Generate request","type":"main","index":0}]]},"Your podcast":{"main":[[{"node":"Finish","type":"main","index":0}]]},"Add each link":{"main":[[{"node":"Links added","type":"main","index":0}]]},"Audio request":{"main":[[{"node":"Fetch audio","type":"main","index":0}]]},"Feed settings":{"main":[[{"node":"Read feed","type":"main","index":0}]]},"Form settings":{"main":[[{"node":"Any links?","type":"main","index":0}]]},"One link each":{"main":[[{"node":"Add each link","type":"main","index":0}]]},"Podcast audio":{"main":[[{"node":"Audio request","type":"main","index":0}]]},"Read notebook":{"main":[[{"node":"Source status","type":"main","index":0}]]},"Source status":{"main":[[{"node":"Sources next","type":"main","index":0}]]},"Sources added":{"main":[[{"node":"Sources route","type":"main","index":0}]]},"Sources route":{"main":[[{"node":"Show a page?","type":"main","index":0}],[{"node":"One link each","type":"main","index":0}],[{"node":"Wait 10s","type":"main","index":0}]]},"From the form?":{"main":[[{"node":"Result page","type":"main","index":0}],[{"node":"Download podcast","type":"main","index":0}]]},"Generate check":{"main":[[{"node":"Generate route","type":"main","index":0}]]},"Generate route":{"main":[[{"node":"Retry in 15s","type":"main","index":0}],[{"node":"Show a page?","type":"main","index":0}],[{"node":"Wait 20s","type":"main","index":0}]]},"Make a podcast":{"main":[[{"node":"Form settings","type":"main","index":0}]]},"Create notebook":{"main":[[{"node":"Notebook created","type":"main","index":0}]]},"Download podcast":{"main":[[{"node":"Episode","type":"main","index":0}]]},"Generate request":{"main":[[{"node":"Generate Audio Overview","type":"main","index":0}]]},"Notebook created":{"main":[[{"node":"Notebook ok?","type":"main","index":0}]]},"Every Monday at 7:00":{"main":[[{"node":"Feed settings","type":"main","index":0}]]},"Generate Audio Overview":{"main":[[{"node":"Generate check","type":"main","index":0}]]}}}