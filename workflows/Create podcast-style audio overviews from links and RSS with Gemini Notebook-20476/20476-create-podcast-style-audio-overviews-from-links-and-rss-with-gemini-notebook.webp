ookLM usage for now${retryAt ? `. It resets at ${when(retryAt)}` : ''}. To keep going, connect more Google accounts at useapi.net and leave the Google account field empty, so the next run can use another account.`;\nconst explain = (err, what) => {\n  if (err.code === 401) return `${what}: the useapi.net API token was refused. Open the \"useapi.net API token\" credential in n8n and check it: Name Authorization, Value Bearer YOUR_TOKEN_HERE by your token.`;\n  if (err.code === 429 && (err.retryAt || /window|usage/i.test(err.text))) return quotaHelp(err.retryAt);\n  if (err.code === 596) return `${what}: Google signed the account out (${err.text}). Reconnect the Google account with the Gemini Notebook setup at ${SETUP}, then try again.`;\n  if (err.code === 404 && /account/i.test(err.text)) return `${what}: ${err.text}. Check the Google account email: it must be connected to useapi.net with the Gemini Notebook setup (${SETUP}). Or leave it empty to use any connected account.`;\n  if (err.code === 429 && /busy|maxJobs/i.test(err.text)) return `${what}: the Google account is already running its maximum number of NotebookLM jobs (${err.text}). Wait until they finish and try again, raise maxJobs for the account at useapi.net, or connect more Google accounts.`;\n  if (temporary(err)) return `${what}: a temporary problem at Google or on the network (${err.text}). It was retried a few times. Try again in a few minutes.`;\n  return `${what}: ${err.text}`;\n};\nconst stop = (s, message) => [{ json: { route: 'stop', state: s, message } }];\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst mmss = sec => sec ? `${Math.floor(sec / 60)}:${String(Math.round(sec % 60)).padStart(2, '0')}` : '';\n\n// Google reads every link before it can talk about it. Check every 10 s until each source is ready or failed,\n// at most 10 minutes; anything still processing then is skipped.\nconst s = $('Wait 10s').last().json.state;\ns.polls = (s.polls || 0) + 1;\nconst err = apiErr($json);\nif (err) { s.readErrors = (s.readErrors || 0) + 1;\n  if (temporary(err) && s.readErrors <= 5) return [{ json: { route: 'wait', state: s } }];\n  return stop(s, explain(err, 'The notebook could not be read')); }\ns.readErrors = 0;\nconst list = $json.sources || [];\nconst busy = list.filter(x => x.status !== 'ready' && x.status !== 'error');\nif ((busy.length || !list.length) && s.polls < 60) return [{ json: { route: 'wait', state: s } }];\nconst why = x => x.status !== 'error' ? 'still processing after 10 minutes'\n  : x.kind === 'youtube' ? 'Google could not read this video. A video without captions fails this way, and Google gives no reason'\n  : 'Google could not read this page. It may not exist, need a login, or block automated readers';\ns.ready = list.filter(x => x.status === 'ready').map(x => ({ title: x.title, url: x.url || '', kind: x.kind, words: x.words || 0 }));\ns.skipped = (s.refused || []).concat(list.filter(x => x.status !== 'ready').map(x => ({ title: x.title, url: x.url || x.title, kind: x.kind, reason: why(x) })));\nif (!s.ready.length) return stop(s, `Google could not read any of your links, so there is nothing to talk about. ${s.skipped.map(x => `${x.url}: ${x.reason}.`).join(' ') || 'No sources were added.'} Try other links.`);\nif (s.source !== 'form') return [{ json: { route: 'generate', state: s } }];\nconst row = (ok, x, note) => `<tr><td>${ok ? '&#10003; Ready' : '&#10007; Skipped'}</td><td>${x.url ? `<a href=\"${esc(x.url)}\" target=\"_blank\" rel=\"noopener\">${esc(x.title || x.url)}</a>` : esc(x.title)}${note ? `<br>${esc(note)}` : ''}</td></tr>`;\nconst rows = s.ready.map(x => row(true, x, x.words ? `${x.kind === 'youtube' ? 'YouTube transcript' : 'Web page'}, ${x.words.toLocaleString('en-US')} words` : ''))\n  .concat(s.skipped.map(x => row(false, x, x.reason))).join('');\nconst extra = (s.ignored.length ? `<p>Not links, ignored: ${esc(s.ignored.join(', '))}</p>` : '') + (s.overLimit ? `<p>${s.overLimit} links over the limit of 50 were left out.</p>` : '');\nconst resume = `<p><small>The podcast takes a few minutes. You can close this tab and come back with this link. If the page does not load yet, the step is still running, so try again in a minute: <a href=\"${$execution.resumeFormUrl}\">${$execution.resumeFormUrl}</a></small></p>`;\nconst fmt = { deep_dive: 'Deep dive', brief: 'Brief', critique: 'Critique', debate: 'Debate' }[s.format] || s.format;\nconst fields = [{ fieldType: 'html', html: `<h3>${esc(s.title)}</h3><p>Google read <b>${s.ready.length} of ${s.ready.length + s.skipped.length}</b> sources. The podcast is made from the ready ones.</p><table><tr><th>Status</th><th>Source</th></tr>${rows}</table>${extra}<p>${fmt}, ${esc(s.length)} length, language <code>${esc(s.language)}</code>${s.instructions ? `, focus: ${esc(s.instructions.slice(0, 200).replace(/[.\\s]+$/, ''))}` : ''}.</p>${resume}` }];\nreturn [{ json: { route: 'page', state: s, fields } }];\n"},"typeVersion":2},{"name":"Sources next","type":"n8n-nodes-base.switch","position":[3100,-60],"parameters":{"mode":"expression","output":"={{ {\"wait\": 0, \"stop\": 1, \"page\": 2, \"generate\": 3}[$json.route] ?? 3 }}","numberOutputs":4},"typeVersion":3.2},{"name":"Sources","type":"n8n-nodes-base.form","position":[3320,-140],"webhookId":"d023f46d-d239-54fc-bdfc-834a4e403759","parameters":{"options":{"customCss":":root{--font-family:system-ui,-apple-system,'Segoe UI',sans-serif;--container-width:720px}.form-group table{width:100%;border-collapse:collapse}.form-group td,.form-group th{text-align:left;vertical-align:top;padding:6px 8px;border-bottom:1px solid #e3e6ea;font-size:14px}.form-group th{font-size:13px;color:#5f6368;font-weight:600}.form-group td:first-child{white-space:nowrap}.form-group video{width:100%;height:54px;display:block;margin:8px 0}.form-group h3{margin:6px 0 2px;font-size:18px}.form-group a{word-break:break-all}@property --wsec{sy