{"name":"NotebookLM Podcast App: turn links or an RSS feed into an Audio Overview with the Gemini Notebook API","nodes":[{"name":"Make a podcast","type":"n8n-nodes-base.formTrigger","position":[0,0],"webhookId":"d82cc744-336f-50ee-9edf-12c5e5315995","parameters":{"options":{"path":"notebooklm-podcast","customCss":":root{--font-family:system-ui,-apple-system,'Segoe UI',sans-serif;--container-width:720px}.form-group table{width:100%;border-collapse:collapse}.form-group td,.form-group th{text-align:left;vertical-align:top;padding:6px 8px;border-bottom:1px solid #e3e6ea;font-size:14px}.form-group th{font-size:13px;color:#5f6368;font-weight:600}.form-group td:first-child{white-space:nowrap}.form-group video{width:100%;height:54px;display:block;margin:8px 0}.form-group h3{margin:6px 0 2px;font-size:18px}.form-group a{word-break:break-all}@property --wsec{syntax:'\\3C integer\\3E';inherits:false;initial-value:0}@property --wmin{syntax:'\\3C integer\\3E';inherits:false;initial-value:0}@keyframes wsec{from{--wsec:0}to{--wsec:60}}@keyframes wmin{from{--wmin:0}to{--wmin:60}}@keyframes wglide{from{background-position:-45% 100%}to{background-position:145% 100%}}#submit-btn:disabled{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;font-size:0;height:auto;min-height:var(--submit-btn-height);padding:14px 18px;line-height:1.5;color:#3c4043;background-color:#fafbfc;background-image:linear-gradient(90deg,transparent,#ff6d5a,transparent);background-repeat:no-repeat;background-size:40% 3px;animation:wglide 2.4s ease-in-out infinite;border:1px solid #e3e6ea}#submit-btn:disabled span{order:1}#submit-btn:disabled span svg{fill:#ff6d5a}#submit-btn:disabled::after{order:2;font-size:15px;font-weight:600;counter-reset:wmin var(--wmin) wsec var(--wsec);animation:wsec 60s steps(60,end) infinite,wmin 3600s steps(60,end) infinite;content:\"Working \\B7  \" counter(wmin) \":\" counter(wsec,decimal-leading-zero)}#submit-btn:disabled::before{order:3;flex-basis:100%;white-space:pre-line;font-size:14px;font-weight:400;margin-top:6px;content:\"Creating a notebook and reading your links. Web pages take seconds, YouTube videos up to a few minutes.\\A Keep this tab open: the next page appears here by itself.\"}","buttonLabel":"Read my links","appendAttribution":false},"formTitle":"Make a NotebookLM podcast","formFields":{"values":[{"fieldLabel":"Episode title","placeholder":"Weekly AI news roundup","requiredField":true},{"fieldType":"textarea","fieldLabel":"Links","placeholder":"One per line, up to 50: web pages and YouTube videos\nhttps://en.wikipedia.org/wiki/Apollo_11\nhttps://www.youtube.com/watch?v=...","requiredField":true},{"fieldType":"dropdown","fieldLabel":"Format","defaultValue":"Deep dive: a lively conversation between two hosts","fieldOptions":{"values":[{"option":"Deep dive: a lively conversation between two hosts"},{"option":"Brief: a bite-sized overview of the core ideas"},{"option":"Critique: an expert review of the sources with constructive feedback"},{"option":"Debate: the hosts argue different perspectives"}]},"requiredField":true},{"fieldType":"dropdown","fieldLabel":"Length","defaultValue":"Default","fieldOptions":{"values":[{"option":"Short"},{"option":"Default"},{"option":"Long"}]},"requiredField":true},{"fieldType":"dropdown","fieldLabel":"Language","defaultValue":"English (en)","fieldOptions":{"values":[{"option":"English (en)"},{"option":"Spanish (es)"},{"option":"Portuguese, Brazil (pt_BR)"},{"option":"Portuguese, Portugal (pt_PT)"},{"option":"French (fr)"},{"option":"German (de)"},{"option":"Italian (it)"},{"option":"Dutch (nl_NL)"},{"option":"Polish (pl)"},{"option":"Russian (ru)"},{"option":"Ukrainian (uk)"},{"option":"Turkish (tr)"},{"option":"Hindi (hi)"},{"option":"Indonesian (id)"},{"option":"Vietnamese (vi)"},{"option":"Thai (th)"},{"option":"Japanese (ja)"},{"option":"Korean (ko)"},{"option":"Chinese, Simplified (zh_Hans)"},{"option":"Chinese, Traditional (zh_Hant)"}]},"requiredField":true},{"fieldType":"textarea","fieldLabel":"Focus (optional)","placeholder":"What should the hosts focus on? e.g. explain it for beginners, or only the business impact"},{"fieldType":"email","fieldLabel":"Google account (optional)","placeholder":"Leave empty to use any Google account connected at useapi.net"}]},"formDescription":"Paste web pages and YouTube videos, and NotebookLM turns them into an Audio Overview: a podcast-style conversation about your sources. The next page shows what Google could read before the podcast is made. Runs on your own Google account through the Gemini Notebook API at useapi.net."},"typeVersion":2.2},{"name":"Form settings","type":"n8n-nodes-base.code","position":[220,0],"parameters":{"jsCode":"\n// Turn the form answers into the settings the pipeline reads (the RSS branch builds the same shape).\nconst f = $json;\nconst words = String(f['Links'] || '').split(/[\\s,]+/).map(t => t.trim()).filter(Boolean);\nconst links = [...new Set(words.filter(t => /^https?:\\/\\/[^\\s/]+\\.[^\\s]+/i.test(t)))];\nconst formats = { 'Deep dive': 'deep_dive', 'Brief': 'brief', 'Critique': 'critique', 'Debate': 'debate' };\nconst state = {\n  source: 'form',\n  title: String(f['Episode title'] || '').trim().slice(0, 200) || 'NotebookLM podcast',\n  urls: links.slice(0, 50),                         // the API takes up to 50 links per call\n  ignored: words.filter(t => !/^https?:\\/\\//i.test(t)).slice(0, 20),\n  overLimit: Math.max(0, links.length - 50),\n  format: formats[String(f['Format'] || '').split(':')[0]] || 'deep_dive',\n  length: String(f['Length'] || 'Default').toLowerCase(),\n  language: (String(f['Language'] || '').match(/\\(([A-Za-z_]+)\\)\\s*$/) || [])[1] || 'en',\n  instructions: String(f['Focus (optional)'] || '').trim().slice(0, 10000),\n  email: String(f['Google account (optional)'] || '').trim(),\n};\nconst message = 'No links found. Paste full web addresses that start with https://, one per line.';\nreturn [{ json: { state, message } }];\n"},"typeVersion":2},{"name":"Every Monday at 7:00","type":"n8n-nodes-base.scheduleTrigger","disabled":true,"position":[0,360],"parameters":{"rule":{"interval":[{"field":"weeks","triggerAtDay":[1],"triggerAtHour":7}]}},"typeVersion":1.2},{"name":"Feed settings","type":"n8n-nodes-base.set","position":[220,360],"parameters":{"options":{},"assignments":{"assignments":[{"id":"78cebca0-959f-50d8-a04d-c43fe0a1d1a9","name":"feedUrl","type":"string","value":"https://blog.google/innovation-and-ai/technology/ai/rss/"},{"id":"18697101-3d8d-5a2f-ae41-995f11242073","name":"showName","type":"string","value":"Weekly AI digest"},{"id":"599ffca1-f58f-5014-9cd3-dd3670208adf","name":"lookbackDays","type":"number","value":7},{"id":"f79637ce-e592-558b-93ae-d0615c05f19c","name":"maxPosts","type":"number","value":5},{"id":"bac03777-ee87-536c-857a-f7dbbeed350f","name":"format","type":"string","value":"deep_dive"},{"id":"5c8d9db5-9642-5375-a8ed-6ba6de953eeb","name":"length","type":"string","value":"default"},{"id":"67f5137d-4377-5275-b6a2-ad2d479c8e5c","name":"language","type":"string","value":"en"},{"id":"f1e10925-0184-5af2-86da-7409576e42f6","name":"focus","type":"string","value":""},{"id":"391aae52-33d8-5151-b462-eb9124335fdb","name":"email","type":"string","value":""}]}},"typeVersion":3.4},{"name":"Read feed","type":"n8n-nodes-base.rssFeedRead","position":[440,360],"parameters":{"url":"={{ $json.feedUrl }}","options":{}},"typeVersion":1.2},{"name":"Newest posts","type":"n8n-nodes-base.code","position":[660,360],"parameters":{"jsCode":"\n// Keep the posts published within lookbackDays, newest first, at most maxPosts. Posts without a date are skipped.\n// No new posts: return nothing, so no episode is made this time.\nconst s = $('Feed settings').first().json;\nconst since = Date.now() - s.lookbackDays * 24 * 3600 * 1000;\nconst date = p => Date.parse(p.isoDate || p.pubDate || '');\nconst posts = $input.all().map(i => i.json)\n  .filter(p => p.link && /^https?:\\/\\//.test(p.link) && date(p) >= since)\n  .sort((a, b) => date(b) - date(a))\n  .slice(0, s.maxPosts);\nif (posts.length === 0) return [];\nconst state = {\n  source: 'rss',\n  title: `${s.showName}, ${new Date().toISOString().slice(0, 10)}`,\n  urls: posts.map(p => p.link), posts: posts.map(p => p.title || p.link),\n  ignored: [], overLimit: 0,\n  format: s.format, length: s.length, language: s.language, instructions: String(s.focus || '').slice(0, 10000), email: String(s.email || '').trim(),\n};\nreturn [{ json: { state }, pairedItem: { item: 0 } }];\n"},"typeVersion":2},{"name":"Any links?","type":"n8n-nodes-base.if","position":[900,160],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"49956d33-785b-5aca-9c12-80ef0cc9eb53","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.state.urls.length > 0 }}","rightValue":true}]}},"typeVersion":2.2},{"name":"Create notebook","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":3,"position":[1120,100],"parameters":{"url":"https://api.useapi.net/v1/gemini-notebook/notebooks","method":"POST","options":{"timeout":120000},"jsonBody":"={{ JSON.stringify(Object.assign({ title: $json.state.title }, $json.state.email ? { email: $json.state.email } : {})) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"credentials":{"httpHeaderAuth":{"id":"credential-id","name":"useapi.net API token"}},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"name":"Notebook created","type":"n8n-nodes-base.code","position":[1340,100],"parameters":{"jsCode":"\nconst apiErr = j => {\n  if (!j || !j.error || j.jobid) return null;  // a job record carries its own error object, read by the caller\n  const e = j.error;\n  const msg = typeof e === 'string' ? e : String(e.message || '');\n  let body = typeof e === 'string' ? j : null;\n  const m = msg.match(/^(\\d{3}) - ([\\s\\S]*)$/);\n  if (m) { try { body = JSON.parse(m[2]); if (typeof body === 'string') body = JSON.parse(body); } catch (x) { body = null; } }\n  const code = Number((body && body.code) || (m && m[1]) || (typeof e === 'object' && e.httpCode) || 0) || 0;\n  let text = (body && typeof body.error === 'string' && body.error) || (typeof e === 'object' && e.description) || msg || 'no answer';\n  const retryAt = (body && body.retryAt) || ((msg.match(/retryAt\\\\?\"\\s*:\\s*\\\\?\"([^\"\\\\]+)/) || [])[1]) || null;\n  return { code, text: String(text).slice(0, 300), retryAt };\n};\n// temporary: retried. Everything else is a dead end that needs the user.\nconst temporary = err => !err.code || err.code >= 500 && err.code !== 596 || /re-checking|retry shortly|busy/i.test(err.text);\nconst when = iso => { const d = new Date(iso); if (isNaN(d)) return String(iso);\n  const h = Math.max(0, Math.round((d - Date.now()) / 360000) / 10);\n  return `${d.toISOString().slice(0, 16).replace('T', ' ')} UTC (in about ${h} h)`; };\nconst SETUP = 'https://useapi.net/docs/start-here/setup-gemini-notebook?utm_source=n8n&utm_medium=referral&utm_campaign=notebooklm-podcast-app';\nconst quotaHelp = retryAt => `This Google account is out of NotebookLM usage for now${retryAt ? `. It resets at ${when(retryAt)}` : ''}. To keep going, connect more Google accounts at useapi.net and leave the Google account field empty, so the next run can use another account.`;\nconst explain = (err, what) => {\n  if (err.code === 401) return `${what}: the useapi.net API token was refused. Open the \"useapi.net API token\" credential in n8n and check it: Name Authorization, Value Bearer YOUR_TOKEN_HERE by your token.`;\n  if (err.code === 429 && (err.retryAt || /window|usage/i.test(err.text))) return quotaHelp(err.retryAt);\n  if (err.code === 596) return `${what}: Google signed the account out (${err.text}). Reconnect the Google account with the Gemini Notebook setup at ${SETUP}, then try again.`;\n  if (err.code === 404 && /account/i.test(err.text)) return `${what}: ${err.text}. Check the Google account email: it must be connected to useapi.net with the Gemini Notebook setup (${SETUP}). Or leave it empty to use any connected account.`;\n  if (err.code === 429 && /busy|maxJobs/i.test(err.text)) return `${what}: the Google account is already running its maximum number of NotebookLM jobs (${err.text}). Wait until they finish and try again, raise maxJobs for the account at useapi.net, or connect more Google accounts.`;\n  if (temporary(err)) return `${what}: a temporary problem at Google or on the network (${err.text}). It was retried a few times. Try again in a few minutes.`;\n  return `${what}: ${err.text}`;\n};\nconst stop = (s, message) => [{ json: { route: 'stop', state: s, message } }];\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst mmss = sec => sec ? `${Math.floor(sec / 60)}:${String(Math.round(sec % 60)).padStart(2, '0')}` : '';\n\nconst s = $('Any links?').first().json.state;\nconst err = apiErr($json);\nif (err || !$json.notebook) return stop(s, explain(err || { code: 0, text: 'no notebook id in the answer' }, 'The notebook could not be created'));\ns.notebook = $json.notebook; s.account = $json.email;\nreturn [{ json: { route: 'ok', state: s } }];\n"},"typeVersion":2},{"name":"Notebook ok?","type":"n8n-nodes-base.if","position":[1560,100],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"381de3ea-0df1-5880-a59e-4ac5655233b9","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.route === 'ok' }}","rightValue":true}]}},"typeVersion":2.2},{"name":"Add sources","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":3,"position":[1780,20],"parameters":{"url":"https://api.useapi.net/v1/gemini-notebook/sources","method":"POST","options":{"timeout":120000},"jsonBody":"={{ JSON.stringify({ notebook: $json.state.notebook, urls: $json.state.urls }) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"credentials":{"httpHeaderAuth":{"id":"credential-id","name":"useapi.net API token"}},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"name":"Sources added","type":"n8n-nodes-base.code","position":[2000,20],"parameters":{"jsCode":"\nconst apiErr = j => {\n  if (!j || !j.error || j.jobid) return null;  // a job record carries its own error object, read by the caller\n  const e = j.error;\n  const msg = typeof e === 'string' ? e : String(e.message || '');\n  let body = typeof e === 'string' ? j : null;\n  const m = msg.match(/^(\\d{3}) - ([\\s\\S]*)$/);\n  if (m) { try { body = JSON.parse(m[2]); if (typeof body === 'string') body = JSON.parse(body); } catch (x) { body = null; } }\n  const code = Number((body && body.code) || (m && m[1]) || (typeof e === 'object' && e.httpCode) || 0) || 0;\n  let text = (body && typeof body.error === 'string' && body.error) || (typeof e === 'object' && e.description) || msg || 'no answer';\n  const retryAt = (body && body.retryAt) || ((msg.match(/retryAt\\\\?\"\\s*:\\s*\\\\?\"([^\"\\\\]+)/) || [])[1]) || null;\n  return { code, text: String(text).slice(0, 300), retryAt };\n};\n// temporary: retried. Everything else is a dead end that needs the user.\nconst temporary = err => !err.code || err.code >= 500 && err.code !== 596 || /re-checking|retry shortly|busy/i.test(err.text);\nconst when = iso => { const d = new Date(iso); if (isNaN(d)) return String(iso);\n  const h = Math.max(0, Math.round((d - Date.now()) / 360000) / 10);\n  return `${d.toISOString().slice(0, 16).replace('T', ' ')} UTC (in about ${h} h)`; };\nconst SETUP = 'https://useapi.net/docs/start-here/setup-gemini-notebook?utm_source=n8n&utm_medium=referral&utm_campaign=notebooklm-podcast-app';\nconst quotaHelp = retryAt => `This Google account is out of NotebookLM usage for now${retryAt ? `. It resets at ${when(retryAt)}` : ''}. To keep going, connect more Google accounts at useapi.net and leave the Google account field empty, so the next run can use another account.`;\nconst explain = (err, what) => {\n  if (err.code === 401) return `${what}: the useapi.net API token was refused. Open the \"useapi.net API token\" credential in n8n and check it: Name Authorization, Value Bearer YOUR_TOKEN_HERE by your token.`;\n  if (err.code === 429 && (err.retryAt || /window|usage/i.test(err.text))) return quotaHelp(err.retryAt);\n  if (err.code === 596) return `${what}: Google signed the account out (${err.text}). Reconnect the Google account with the Gemini Notebook setup at ${SETUP}, then try again.`;\n  if (err.code === 404 && /account/i.test(err.text)) return `${what}: ${err.text}. Check the Google account email: it must be connected to useapi.net with the Gemini Notebook setup (${SETUP}). Or leave it empty to use any connected account.`;\n  if (err.code === 429 && /busy|maxJobs/i.test(err.text)) return `${what}: the Google account is already running its maximum number of NotebookLM jobs (${err.text}). Wait until they finish and try again, raise maxJobs for the account at useapi.net, or connect more Google accounts.`;\n  if (temporary(err)) return `${what}: a temporary problem at Google or on the network (${err.text}). It was retried a few times. Try again in a few minutes.`;\n  return `${what}: ${err.text}`;\n};\nconst stop = (s, message) => [{ json: { route: 'stop', state: s, message } }];\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst mmss = sec => sec ? `${Math.floor(sec / 60)}:${String(Math.round(sec % 60)).padStart(2, '0')}` : '';\n\nconst s = $('Notebook created').first().json.state;\nconst err = apiErr($json);\ns.refused = s.refused || [];\n// Google refuses the whole call when one link cannot be reached: then add the links one by one and skip the bad ones.\nif (err && err.code === 409 && s.urls.length > 1) return [{ json: { route: 'each', state: s } }];\nif (err && err.code === 409) return stop(s, `Google refused to add ${s.urls[0]}: the page could not be reached. Check that it exists and opens without a login, then try again.`);\nif (err) return stop(s, explain(err, 'Your links could not be added'));\ns.polls = 0; s.readErrors = 0;\nreturn [{ json: { route: 'ok', state: s } }];\n"},"typeVersion":2},{"name":"Sources route","type":"n8n-nodes-base.switch","position":[2220,20],"parameters":{"mode":"expression","output":"={{ {\"stop\": 0, \"each\": 1, \"ok\": 2}[$json.route] ?? 2 }}","numberOutputs":3},"typeVersion":3.2},{"name":"One link each","type":"n8n-nodes-base.code","position":[2440,180],"parameters":{"jsCode":"\nconst s = $json.state;\nreturn s.urls.map(url => ({ json: { state: s, url } }));\n"},"typeVersion":2},{"name":"Add each link","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[2660,180],"parameters":{"url":"https://api.useapi.net/v1/gemini-notebook/sources","method":"POST","options":{"timeout":120000},"jsonBody":"={{ JSON.stringify({ notebook: $json.state.notebook, urls: [$json.url] }) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"credentials":{"httpHeaderAuth":{"id":"credential-id","name":"useapi.net API token"}},"typeVersion":4.2},{"name":"Links added","type":"n8n-nodes-base.code","position":[2880,180],"parameters":{"jsCode":"\nconst apiErr = j => {\n  if (!j || !j.error || j.jobid) return null;  // a job record carries its own error object, read by the caller\n  const e = j.error;\n  const msg = typeof e === 'string' ? e : String(e.message || '');\n  let body = typeof e === 'string' ? j : null;\n  const m = msg.match(/^(\\d{3}) - ([\\s\\S]*)$/);\n  if (m) { try { body = JSON.parse(m[2]); if (typeof body === 'string') body = JSON.parse(body); } catch (x) { body = null; } }\n  const code = Number((body && body.code) || (m && m[1]) || (typeof e === 'object' && e.httpCode) || 0) || 0;\n  let text = (body && typeof body.error === 'string' && body.error) || (typeof e === 'object' && e.description) || msg || 'no answer';\n  const retryAt = (body && body.retryAt) || ((msg.match(/retryAt\\\\?\"\\s*:\\s*\\\\?\"([^\"\\\\]+)/) || [])[1]) || null;\n  return { code, text: String(text).slice(0, 300), retryAt };\n};\n// temporary: retried. Everything else is a dead end that needs the user.\nconst temporary = err => !err.code || err.code >= 500 && err.code !== 596 || /re-checking|retry shortly|busy/i.test(err.text);\nconst when = iso => { const d = new Date(iso); if (isNaN(d)) return String(iso);\n  const h = Math.max(0, Math.round((d - Date.now()) / 360000) / 10);\n  return `${d.toISOString().slice(0, 16).replace('T', ' ')} UTC (in about ${h} h)`; };\nconst SETUP = 'https://useapi.net/docs/start-here/setup-gemini-notebook?utm_source=n8n&utm_medium=referral&utm_campaign=notebooklm-podcast-app';\nconst quotaHelp = retryAt => `This Google account is out of NotebookLM usage for now${retryAt ? `. It resets at ${when(retryAt)}` : ''}. To keep going, connect more Google accounts at useapi.net and leave the Google account field empty, so the next run can use another account.`;\nconst explain = (err, what) => {\n  if (err.code === 401) return `${what}: the useapi.net API token was refused. Open the \"useapi.net API token\" credential in n8n and check it: Name Authorization, Value Bearer YOUR_TOKEN_HERE by your token.`;\n  if (err.code === 429 && (err.retryAt || /window|usage/i.test(err.text))) return quotaHelp(err.retryAt);\n  if (err.code === 596) return `${what}: Google signed the account out (${err.text}). Reconnect the Google account with the Gemini Notebook setup at ${SETUP}, then try again.`;\n  if (err.code === 404 && /account/i.test(err.text)) return `${what}: ${err.text}. Check the Google account email: it must be connected to useapi.net with the Gemini Notebook setup (${SETUP}). Or leave it empty to use any connected account.`;\n  if (err.code === 429 && /busy|maxJobs/i.test(err.text)) return `${what}: the Google account is already running its maximum number of NotebookLM jobs (${err.text}). Wait until they finish and try again, raise maxJobs for the account at useapi.net, or connect more Google accounts.`;\n  if (temporary(err)) return `${what}: a temporary problem at Google or on the network (${err.text}). It was retried a few times. Try again in a few minutes.`;\n  return `${what}: ${err.text}`;\n};\nconst stop = (s, message) => [{ json: { route: 'stop', state: s, message } }];\nconst esc = t => String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst mmss = sec => sec ? `${Math.floor(sec / 60)}:${String(Math.round(sec % 60)).padStart(2, '0')}` : '';\n\nconst reqs = $('One link each').all();\nconst s = reqs[0].json.state;\ns.refused = [];\n$input.all().forEach((it, k) => { const e = apiErr(it.json);\n  if (e) s.refused.push({ title: reqs[k].json.url, url: reqs[k].json.url, kind: 'web',\n    reason: e.code === 409 ? 'Google refused to add this link: the page could not be reached' : e.text }); });\nif (s.refused.length === reqs.length) return stop(s, `Google refused every link, so there is nothing to talk about. ${s.refused.map(x => `${x.url}: ${x.reason}.`).join(' ')} Check that the pages exist and open without a login.`);\ns.polls = 0; s.readErrors = 0;\nreturn [{ json: { route: 'ok', state: s } }];\n"},"typeVersion":2},{"name":"Wait 10s","type":"n8n-nodes-base.wait","position":[2440,-60],"webhookId":"83d7c530-060c-5e5a-95d0-30d03882fe13","parameters":{"amount":10},"typeVersion":1.1},{"name":"Read notebook","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":3,"position":[2660,-60],"parameters":{"url":"={{ 'https://api.usea