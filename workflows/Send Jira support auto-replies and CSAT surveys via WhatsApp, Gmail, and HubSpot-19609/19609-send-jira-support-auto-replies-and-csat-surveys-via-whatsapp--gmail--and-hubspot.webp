 CSAT Form Path":{"main":[[{"node":"Parse CSAT Webhook Data","type":"main","index":0}]]},"Normalize CSAT Form Data":{"main":[[{"node":"Retrieve Jira CSAT Issue","type":"main","index":0}]]},"Retrieve Jira CSAT Issue":{"main":[[{"node":"Fetch CSAT Issue from Jira","type":"main","index":0}]]},"Verify CSAT Custom Field":{"main":[[{"node":"Update Jira CSAT Score","type":"main","index":0}],[{"node":"Check HubSpot CSAT Eligibility","type":"main","index":0}]]},"Associate Note in HubSpot":{"main":[[{"node":"Prepare Auto Reply Mark","type":"main","index":0}]]},"Prepare HubSpot Note Data":{"main":[[{"node":"Create CSAT Note on HubSpot","type":"main","index":0}]]},"Email Auto Reply via Gmail":{"main":[[{"node":"Check HubSpot Note Eligibility","type":"main","index":0}]]},"Fetch CSAT Issue from Jira":{"main":[[{"node":"Extract CSAT Details from Jira","type":"main","index":0}]]},"Post CSAT Note Association":{"main":[[{"node":"Capture CSAT Form Response","type":"main","index":0}]]},"Trigger Workflow Execution":{"main":[[{"node":"Load Auto Reply Config","type":"main","index":0}]]},"Build Note Data for HubSpot":{"main":[[{"node":"Create Note in HubSpot","type":"main","index":0}]]},"Create CSAT Note on HubSpot":{"main":[[{"node":"Prepare HubSpot Association Data","type":"main","index":0}]]},"CSAT Form Submission Trigger":{"main":[[{"node":"Normalize CSAT Form Data","type":"main","index":0}]]},"Normalize Auto Reply Payload":{"main":[[{"node":"Evaluate Auto Reply Conditions","type":"main","index":0}]]},"Send Auto Reply via WhatsApp":{"main":[[{"node":"Check HubSpot Note Eligibility","type":"main","index":0}]]},"Check HubSpot CSAT Eligibility":{"main":[[{"node":"Prepare HubSpot Note Data","type":"main","index":0}],[{"node":"Capture CSAT Form Response","type":"main","index":0}]]},"Check HubSpot Note Eligibility":{"main":[[{"node":"Build Note Data for HubSpot","type":"main","index":0}],[{"node":"Prepare Auto Reply Mark","type":"main","index":0}]]},"Evaluate Auto Reply Conditions":{"main":[