sion: ($json.wahaSession || $json.config.wahaSession || 'session_01hz690b2rb8uqwqr00jyq1dmj'), chatId: ($json.whatsappChatId || ''), text: ($json.messageText || '') }) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"retryOnFail":true,"typeVersion":4.2,"continueOnFail":true,"waitBetweenTries":1500},{"id":"a4ca2381-3894-470f-88d2-793ed0a4e9c9","name":"Email CSAT via Gmail","type":"n8n-nodes-base.gmail","onError":"continueRegularOutput","position":[2688,1216],"webhookId":"11162b7f-6085-420c-b658-d63da4601fbe","parameters":{"sendTo":"={{ $json.email }}","message":"={{ $json.messageText }}","options":{"appendAttribution":false},"subject":"={{ $json.emailSubject }}","emailType":"text"},"typeVersion":2.1,"continueOnFail":true},{"id":"66c8548e-ccc4-4040-8f92-629a558f2dd8","name":"Determine CSAT Channel","type":"n8n-nodes-base.if","position":[2304,1056],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"d4f954da-8d10-4517-b49d-00becb5949d8","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.channel }}","rightValue":"whatsapp"}]}},"typeVersion":2},{"id":"9c4c9252-8711-40ef-b895-77c36e498f3b","name":"Evaluate CSAT Sending Criteria","type":"n8n-nodes-base.if","position":[1696,1136],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"1ad102a9-77e7-4d43-9f96-eb7967a7d31b","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.canSend }}"}]}},"typeVersion":2},{"id":"b2928759-9351-4481-87fc-5dad2228ea0d","name":"Parse CSAT Webhook Data","type":"n8n-nodes-base.code","position":[1280,1040],"parameters":{"jsCode":"const CLOSE_LOOP = {\n  \"jiraBaseUrl\": \"https://intuzdev5.atlassian.net\",\n  \"jiraProjectKey\": \"KAN\",\n  \"doneStatusName\": \"Done\",\n  \"n8nPublicBaseUrl\": \"https://n8n.intuz.net\",\n  \"webhookSecret\": \"dhm2p9q4x8vrajw0z3c5b8d2h4j6f1an\",\n  \"wahaBaseUrl\": \"https://waha.intuz.net\",\n  \"wahaSession\": \"session_01hz690b2rb8uqwqr00jyq1dmj\",\n  \"labels\": {\n    \"autoReplySent\": \"auto-reply-sent\",\n    \"csatSent\": \"csat-sent\",\n    \"aiTriage\": \"ai-triage\"\n  },\n  \"jira\": {\n    \"customFields\": {\n      \"channel\": \"customfield_10111\",\n      \"customerEmail\": \"customfield_10178\",\n      \"customerPhone\": \"customfield_10179\",\n      \"hubspotContactId\": \"customfield_10180\",\n      \"csatScore\": \"customfield_10181\",\n      \"wahaSession\": \"customfield_10214\"\n    }\n  }\n};\nconst formPathCfg = $('Configure CSAT Form Path').first().json;\nconst cfg = { ...CLOSE_LOOP, csatFormPath: formPathCfg.csatFormPath };\nconst raw = $('CSAT Webhook Listener').first().json || $input.first().json || {};\nconst body = raw.body || raw;\nconst issue = body.issue || raw.issue || {};\nconst fields = issue.fields || {};\nconst key = issue.key || raw.jiraKey || '';\nconst labels = Array.isArray(fields.labels) ? fields.labels.map(String) : [];\nconst statusName = fields.status?.name || fields.status || '';\nconst changelog = body.changelog || raw.changelog || {};\nconst items = Array.isArray(changelog.items) ? changelog.items : [];\n\nconst transitionedToDone = items.some(it => it.field === 'status' && String(it.toString || it.to || '').toLowerCase() === String(cfg.doneStatusName || 'Done').toLowerCase());\nconst isDone = String(statusName).toLowerCase() === String(cfg.doneStatusName || 'Done').toLowerCase();\nconst csatLabel = cfg.labels?.csatSent || 'csat-sent';\nconst alreadySent = labels.includes(csatLabel);\n\nlet skipReason = '';\nif (!key) skipReason = 'missing_jira_key';\nelse if (!isDone && !transitionedToDone) skipReason = 'not_done';\nelse if (alreadySent) skipReason = 'csat_already_sent';\n\nreturn [{\n  json: {\n    event: 'ticket_done_webhook',\n    config: cfg,\n    jiraKey: key,\n    skipReason,\n    isDone,\n    transitionedToDone,\n    alreadySent,\n    canProceed: !skipReason\n  }\n}];"},"typeVersion":2},{"id":"bf69838b-2779-4991-b927-5c2d43672b9b","name":"Verify Webhook Token","type":"n8n-nodes-base.if","position":[768,1040],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"2975b4f9-78fb-425c-8db4-27f5a48a0bc2","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.query?.token || $json.headers?.['x-webhook-token'] || '' }}","rightValue":"dhm2p9q4x8vrajw0z3c5b8d2h4j6f1an"}]}},"typeVersion":2},{"id":"c74afcf5-e3db-4a36-a4ca-3f87af6a11a9","name":"CSAT Webhook Listener","type":"n8n-nodes-base.webhook","position":[528,1040],"webhookId":"d76362d0-8610-4bf7-b4af-d863f93d2e38","parameters":{"path":"jira-csat","options":{},"httpMethod":"POST"},"typeVersion":2},{"id":"f40eccdf-73cb-4886-b1db-7f2af65418c9","name":"Label Jira Auto Reply Sent","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":2,"position":[4112,464],"parameters":{"url":"={{ $json._jiraIssueUrl }}","method":"PUT","options":{},"jsonBody":"={{ JSON.stringify($json._jiraLabelBody) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpBasicAuth"},"retryOnFail":true,"typeVersion":4.2,"continueOnFail":true,"waitBetweenTries":1500},{"id":"0427e0ad-c4c1-495b-8639-9147e71e1710","name":"Comment Jira Auto Reply","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":2,"position":[3728,464],"parameters":{"url":"={{ $json._jiraCommentUrl }}","method":"POST","options":{},"jsonBody":"={{ JSON.stringify($json._jiraCommentBody) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpBasicAuth"},"retryOnFail":true,"typeVersion":4.2,"continueOnFail":true,"waitBetweenTries":1500},{"id":"22de0661-f1c6-419d-9078-5eecef066758","name":"Prepare Auto Reply Mark","type":"n8n-nodes-base.code","position":[3360,464],"parameters":{"jsCode":"let d = {};\ntry { d = $('Check HubSpot Note Eligibility').first().json || {}; } catch (e) { d = $input.first().json || {}; }\nconst cfg = d.config || {};\nconst base = cfg.jiraBaseUrl || 'https://intuzdev5.atlassian.net';\nconst key = d.jiraKey;\nconst label = cfg.labels?.autoReplySent || 'auto-reply-sent';\nconst comment = `Customer auto-reply sent via ${d.channel} at ${new Date().toISOString()}.`;\nreturn [{\n  json: {\n    ...d,\n    _jiraCommentBody: {\n      body: {\n        type: 'doc',\n        version: 1,\n        content: [{ type: 'paragraph', content: [{ type: 'text', text: comment }] }]\n      }\n    },\n    _jiraLabelBody: {\n      update: {\n        labels: [{ add: label }]\n      }\n    },\n    _jiraCommentUrl: `${String(base).replace(/\\/$/, '')}/rest/api/3/issue/${key}/comment`,\n    _jiraIssueUrl: `${String(base).replace(/\\/$/, '')}/rest/api/3/issue/${key}`\n  }\n}];\n"},"typeVersion":2},{"id":"6f0bf859-b59a-4950-b8fe-317135730c79","name":"Associate Note in HubSpot","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":2,"position":[4256,144],"parameters":{"url":"https://api.hubapi.com/crm/v4/associations/notes/contacts/batch/create","method":"POST","options":{},"jsonBody":"={{ JSON.stringify($json._hsAssocBody) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"retryOnFail":true,"typeVersion":4.2,"continueOnFail":true,"waitBetweenTries":1500},{"id":"d4ee9769-8a1c-4a6b-b0a9-ea2044c774d6","name":"Prepare HubSpot Association","type":"n8n-nodes-base.code","position":[3888,144],"parameters":{"jsCode":"const note = $input.first().json;\nconst prev = $('Check HubSpot Note Eligibility').first().json;\nconst noteId = note.id;\nif (!noteId || !prev.hubspotContactId) {\n  return [{ json: { ...prev, hubspotNoteSkipped: true } }];\n}\nreturn [{\n  json: {\n    ...prev,\n    hubspotNoteId: noteId,\n    _hsAssocBody: {\n      inputs: [{\n        from: { id: String(noteId) },\n        to: { id: String(prev.hubspotContactId) },\n        type: 'note_to_contact'\n      }]\n    }\n  }\n}];\n"},"typeVersion":2},{"id":"d086e652-60f1-4031-a59f-5c73de645e90","name":"Create Note in HubSpot","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":2,"position":[3504,144],"parameters":{"url":"https://api.hubapi.com/crm/v3/objects/notes","method":"POST","options":{},"jsonBody":"={{ JSON.stringify($json._hsNoteBody) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"retryOnFail":true,"typeVersion":4.2,"continueOnFail":true,"waitBetweenTries":1500},{"id":"9492b1a2-004b-4557-ae17-7e4c00e1cd64","name":"Build Note Data for HubSpot","type":"n8n-nodes-base.code","position":[3136,144],"parameters":{"jsCode":"const d = $input.first().json;\nconst contactId = d.hubspotContactId;\nif (!contactId) {\n  return [{ json: { ...d, _hsSkipNote: true } }];\n}\n\nlet body = '';\nif (d.event === 'ticket_created') {\n  body = `Support ticket created: ${d.jiraKey}\\nChannel: ${d.channel}\\nURL: ${d.jiraUrl}\\nCategory: ${d.category || 'N/A'}\\nPriority: ${d.priority || 'N/A'}\\nSummary: ${d.summary || ''}\\nCustomer auto-reply sent.`;\n} else if (d.event === 'csat_submitted') {\n  body = `CSAT received for ${d.jiraKey}: ${d.csatScore}/5\\nComment: ${d.csatComment || '(none)'}`;\n} else {\n  body = `Support update for ${d.jiraKey}`;\n}\n\nreturn [{\n  json: {\n    ...d,\n    _hsSkipNote: false,\n    _hsNoteBody: {\n      properties: {\n        hs_note_body: body.slice(0, 65000),\n        hs_timestamp: new Date().toISOString()\n      }\n    }\n  }\n}];\n"},"typeVersion":2},{"id":"2ae7cdbb-3fc1-4228-b865-fa97749db79c","name":"Check HubSpot Note Eligibility","type":"n8n-nodes-base.if","position":[2768,224],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"c06866ed-d46e-4fc7-aa9b-d61d9535c002","operator":{"type":"string","operation":"notEmpty"},"leftValue":"={{ $json.hubspotContactId }}","rightValue":""}]}},"typeVersion":2},{"id":"86889faa-05f6-404a-920d-2703d2006b00","name":"Send Auto Reply via WhatsApp","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":2,"position":[2400,112],"parameters":{"url":"={{ $json._wahaSendUrl || ($json.wahaBaseUrl || $json.config.wahaBaseUrl || 'https://waha.intuz.net') + '/api/sendText' }}","method":"POST","options":{},"jsonBody":"={{ JSON.stringify($json._wahaSendBody || { session: ($json.wahaSession || $json.config.wahaSession || 'session_01hz690b2rb8uqwqr00jyq1dmj'), chatId: ($json.whatsappChatId || ''), text: ($json.messageText || '') }) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"retryOnFail":true,"typeVersion":4.2,"continueOnFail":true,"waitBetweenTries":1500},{"id":"836101f3-be82-4eeb-b81b-1d5414180300","name":"Email Auto Reply via Gmail","type":"n8n-nodes-base.gmail","onError":"continueRegularOutput","position":[2400,304],"webhookId":"9551e934-5ac3-45a6-91bb-ed8b16376280","parameters":{"sendTo":"={{ $json.email }}","message":"={{ $json.messageText }}","options":{"appendAttribution":false},"subject":"={{ $json.emailSubject }}","emailType":"text"},"typeVersion":2.1,"continueOnFail":true},{"id":"3dff3fca-8803-4d69-8875-82499bc884b4","name":"Check WhatsApp Channel","type":"n8n-nodes-base.if","position":[2016,144],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"0766b999-1c6a-4160-ae87-8c84295004ba","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.channel }}","rightValue":"whatsapp"}]}},"typeVersion":2},{"id":"c8db037f-533d-4f70-93e6-faaeec576911","name":"Evaluate Auto Reply Conditions","type":"n8n-nodes-base.if","position":[1648,224],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"ff1c5dc2-0d27-4ead-92fa-daae82f6e4f7","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.canSend }}"}]}},"typeVersion":2},{"id":"20d92058-676d-4c46-bb9b-b86b9b1abb71","name":"Normalize Auto Reply Payload","type":"n8n-nodes-base.code","position":[1280,224],"parameters":{"jsCode":"const cfg = $('Load Auto Reply Config').first().json.config;\nfunction resolveWahaChatId(d) {\n  const cid = String(d.whatsappChatId || d.sourceMeta?.whatsappChatId || '').trim();\n  if (cid.includes('@')) return cid;\n  const phone = String(d.phone || d._rawPhone || '').trim();\n  if (phone.includes('@')) return phone;\n  const digits = phone.replace(/\\D/g, '');\n  return digits ? `${digits}@c.us` : '';\n}\nfunction resolveWahaSession(d, cfg) {\n  return String(\n    d.wahaSession ||\n    d.sourceMeta?.session ||\n    (cfg && cfg.wahaSession) ||\n    'session_01hz690b2rb8uqwqr00jyq1dmj'\n  ).trim();\n}\nfunction resolveWahaBaseUrl(d, cfg) {\n  return String(\n    d.wahaBaseUrl ||\n    d.sourceMeta?.wahaBaseUrl ||\n    (cfg && cfg.wahaBaseUrl) ||\n    'https://waha.intuz.net'\n  ).replace(/\\/$/, '');\n}\nfunction buildWahaOutbound(d, cfg) {\n  const wahaBaseUrl = resolveWahaBaseUrl(d, cfg);\n  const wahaSession = resolveWahaSession(d, cfg);\n  const whatsappChatId = resolveWahaChatId(d);\n  const text = String(d.messageText || '').slice(0, 3900);\n  return {\n    wahaBaseUrl,\n    wahaSession,\n    whatsappChatId,\n    _wahaSendUrl: `${wahaBaseUrl}/api/sendText`,\n    _wahaSendBody: { session: wahaSession, chatId: whatsappChatId, text }\n  };\n}\n\nlet raw = $input.first().json || {};\n// Preserve Unified handoff if an upstream node only returned config\nif (!raw.jiraKey && !raw.key) {\n  try {\n    const fromTrigger = $('Trigger Workflow Execution').first().json || {};\n    raw = { ...fromTrigger, ...raw, config: raw.config || fromTrigger.config || CLOSE_LOOP };\n  } catch (e) {}\n}\n\nconst channel = String(raw.channel || '').toLowerCase();\nconst email = String(raw.email || '').trim().toLowerCase();\nconst phone = String(raw.phone || raw._rawPhone || '').trim();\nconst whatsappChatId = String(raw.whatsappChatId || raw.sourceMeta?.whatsappChatId || '').trim();\nconst suggested = raw.suggested_reply || raw.ai?.suggested_reply || '';\nconst name = raw.customerName || '';\nconst subject = raw.subject || 'Support request';\nconst jiraKey = raw.jiraKey || raw.key || '';\nconst jiraUrl = raw.jiraUrl || `${cfg.jiraBaseUrl.replace(/\\/$/, '')}/browse/${jiraKey}`;\nconst hubspotContactId = raw.hubspotContactId || raw.crm?.hubspotContactId || null;\n\nlet canSend = false;\nlet skipReason = '';\nif (!jiraKey) {\n  skipReason = 'missing_jira_key';\n} else if (channel === 'whatsapp') {\n  const wahaChat = resolveWahaChatId({ ...raw, whatsappChatId, phone });\n  canSend = !!wahaChat;\n  if (!canSend) skipReason = 'missing_whatsapp_chat_id';\n} else if (channel === 'gmail' || channel === 'form') {\n  canSend = !!email;\n  if (!canSend) skipReason = 'missing_email';\n} else {\n  skipReason = 'unknown_channel';\n}\n\nconst greeting = name ? `Hi ${name},` : 'Hello,';\nconst messageText = `${greeting}\\n\\nThank you for contacting support. We have received your request and created ticket ${jiraKey}.\\nOur team will follow up with you shortly.\\n\\nBest regards,\\nSupport Team`.slice(0, 3900);\nconst wahaOutbound = channel === 'whatsapp'\n  ? buildWahaOutbound({ ...raw, whatsappChatId, phone, messageText }, cfg)\n  : {};\n\nreturn [{\n  json: {\n    event: 'ticket_created',\n    config: cfg,\n    channel,\n    email,\n    phone,\n    whatsappChatId: wahaOutbound.whatsappChatId || whatsappChatId,\n    customerName: name,\n    subject,\n    jiraKey,\n    jiraUrl,\n    suggested_reply: suggested,\n    summary: raw.summary || raw.ai?.summary || '',\n    category: raw.category || raw.ai?.category || '',\n    priority: raw.priority || raw.ai?.priority || '',\n    hubspotContactId,\n    messageText,\n    emailSubject: `[Support-Auto] Re: ${subject} — Ticket ${jiraKey}`,\n    canSend,\n    skipReason,\n    ...wahaOutbound\n  }\n}];\n"},"typeVersion":2},{"id":"70aa6690-d0e7-4dad-a536-b97877fafc9f","name":"Load Auto Reply Config","type":"n8n-nodes-base.code","position":[912,224],"parameters":{"jsCode":"const CLOSE_LOOP = {\n  \"jiraBaseUrl\": \"https://intuzdev5.atlassian.net\",\n  \"jiraProjectKey\": \"KAN\",\n  \"doneStatusName\": \"Done\",\n  \"n8nPublicBaseUrl\": \"https://n8n.intuz.net\",\n  \"csatFormPath\": \"c8fa2fc7-30cb-4b06-9478-5070d1c488bc\",\n  \"webhookSecret\": \"dhm2p9q4x8vrajw0z3c5b8d2h4j6f1an\",\n  \"wahaBaseUrl\": \"https://waha.intuz.net\",\n  \"wahaSession\": \"session_01hz690b2rb8uqwqr00jyq1dmj\",\n  \"labels\": {\n    \"autoReplySent\": \"auto-reply-sent\",\n    \"csatSent\": \"csat-sent\",\n    \"aiTriage\": \"ai-triage\"\n  },\n  \"jira\": {\n    \"customFields\": {\n      \"channel\": \"customfield_10111\",\n      \"customerEmail\": \"customfield_10178\",\n      \"customerPhone\": \"customfield_10179\",\n      \"hubspotContactId\": \"customfield_10180\",\n      \"csatScore\": \"customfield_10181\",\n      \"wahaSession\": \"customfield_10214\"\n    }\n  }\n};\n\nconst incoming = $input.first().json || {};\nreturn [{\n  json: {\n    ...incoming,\n    config: CLOSE_LOOP\n  }\n}];\n"},"typeVersion":2},{"id":"bfa1ebf6-d554-4699-afbe-b76a81c0a7e0","name":"Trigger Workflow Execution","type":"n8n-nodes-base.executeWorkflowTrigger","position":[528,224],"parameters":{"inputSource":"passthrough"},"typeVersion":1.1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"6a2109db-98f6-4b10-a763-945b3755a895","nodeGroups":[],"connections"