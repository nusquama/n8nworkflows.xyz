{"id":"B5A7uDKucibnTXcT","meta":{"instanceId":"23e2b2976f011a37e23f408bd566f659fa2ad35eb94939fee5f868e9436f4f25","templateCredsSetupCompleted":true},"name":"Capture website leads into Google Sheets without duplicates","tags":[],"nodes":[{"id":"3a6f6102-8a9d-424c-a210-93a0603981a3","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[5920,704],"parameters":{"width":480,"height":896,"content":"## Capture website leads into Google Sheets without duplicates\n\n### How it works\n\nThis workflow receives website lead submissions through a webhook, normalizes the incoming field names, and validates the required lead data. Valid leads are acknowledged immediately, then checked against Google Sheets to determine whether they already exist. New leads are appended to the sheet and announced in Slack, while returning leads update the existing sheet row to avoid duplicates.\n\n### Setup steps\n\n- Configure the webhook URL in the website form or lead capture tool that will send submissions to n8n.\n- Review the field-normalization code so it maps the sender’s form fields to the expected lead fields such as name, email, phone, and source.\n- Connect Google Sheets credentials and select the spreadsheet, sheet, lookup column, append target, and update target used for lead storage.\n- Enable the Google Sheets lookup node’s settings required for duplicate detection, such as matching on email and always outputting data when no match is found.\n- Connect Slack credentials and choose the channel where new-lead alerts should be posted.\n- Test with one valid new lead, one duplicate lead, and one invalid submission to confirm each branch behaves correctly.\n\n### Customization\n\nAdjust the validation rules, duplicate-matching key, Google Sheets columns, and Slack alert message to match the fields and sales process used by the website."},"typeVersion":1},{"id":"1013935f-0246-42f4-b9a4-8234904f36e5","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[6480,912],"parameters":{"color":7,"width":640,"height":368,"content":"## Receive and validate lead\n\nCaptures the incoming website form submission, normalizes differently named form fields into a consistent lead structure, and checks whether the submission contains the required valid data."},"typeVersion":1},{"id":"45f752bc-5948-4df8-af49-2335dfada049","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[7216,688],"parameters":{"color":7,"height":720,"content":"## Send webhook response\n\nReturns an immediate webhook response: valid submissions are acknowledged and continue into the lead-processing path, while invalid submissions are rejected and stop here."},"typeVersion":1},{"id":"e6e9ec42-b2ed-4110-908b-5a0d6156a61d","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[7584,832],"parameters":{"color":7,"width":624,"height":320,"content":"## Check for duplicates\n\nLooks up the submitted lead in Google Sheets, then classifies the result as a new lead or a returning/existing lead before branching the workflow."},"typeVersion":1},{"id":"a6fb09ac-f85e-42a4-8053-7b6db836f243","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[8256,704],"parameters":{"color":7,"width":432,"height":304,"content":"## Append and alert\n\nHandles the upper new-lead branch by appending the lead to Google Sheets and posting a Slack notification for the newly captured lead."},"typeVersion":1},{"id":"3bfb409d-b9f3-4c7f-875b-53941f2586d5","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[8256,1008],"parameters":{"color":7,"height":432,"content":"## Update returning lead\n\nHandles the lower returning-lead branch by updating the existing Google Sheets row instead of creating a duplicate record."},"typeVersion":1},{"id":"3ddea962-8a7d-4c9a-826d-333f6bd4a40c","name":"When New Lead Received","type":"n8n-nodes-base.webhook","position":[6528,1104],"webhookId":"b1a7c0e2-0f11-4c22-9a10-0000000000aa","parameters":{"path":"new-lead","options":{},"httpMethod":"POST","responseMode":"responseNode"},"typeVersion":2},{"id":"f531b8c3-0c97-47cd-b6ba-275d825f3fad","name":"Normalize Lead Data","type":"n8n-nodes-base.code","position":[6752,1104],"parameters":{"jsCode":"// Form builders all name their fields differently. Rather than forcing the sender to\n// match our schema, we accept the common variants and map them onto one shape.\nconst raw = $input.first().json.body || $input.first().json;\n\nconst pick = (...keys) => {\n  for (const k of keys) {\n    const v = raw[k];\n    if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim();\n  }\n  return '';\n};\n\nconst email = pick('email', 'Email', 'email_address', 'emailAddress', 'e-mail').toLowerCase();\nconst name = pick('name', 'Name', 'full_name', 'fullName', 'first_name');\nconst company = pick('company', 'Company', 'organization', 'organisation');\nconst phone = pick('phone', 'Phone', 'tel', 'mobile');\nconst message = pick('message', 'Message', 'notes', 'comments', 'enquiry');\nconst source = pick('source', 'Source', 'utm_source', 'referrer') || 'website';\n\n// A lead you cannot reply to is not a lead. Reject it at the door rather than\n// storing it and discovering the problem weeks later.\nconst valid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\nconst domain = valid ? email.split('@')[1] : '';\n\nconst FREE_MAIL = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'live.com',\n  'icloud.com', 'aol.com', 'proton.me', 'protonmail.com', 'qq.com', '163.com', '126.com'];\nconst isBusinessEmail = valid && !FREE_MAIL.includes(domain);\n\nreturn [{\n  json: {\n    valid,\n    email,\n    name,\n    // If they did not name their company but used a work address, the domain is a\n    // better guess than an empty cell.\n    company: company || (isBusinessEmail ? domain : ''),\n    phone,\n    message: message.slice(0, 1000),\n    source,\n    domain,\n    isBusinessEmail,\n    receivedAt: new Date().toISOString()\n  }\n}];"},"typeVersion":2},{"id":"2894f5de-b41b-4d0c-b14f-25e0cddc6894","name":"Check Lead Validity","type":"n8n-nodes-base.if","position":[6976,1104],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"cond-valid-email","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.valid }}","rightValue":""}]}},"typeVersion":2},{"id":"c62f5f57-7c20-4051-be93-0b4a3a0961e4","name":"Acknowledge Valid Lead","type":"n8n-nodes-base.respondToWebhook","position":[7264,992],"parameters":{"options":{},"respondWith":"json","responseBody":"={{ JSON.stringify({ status: 'received', email: $json.email }) }}"},"typeVersion":1},{"id":"8d4c16ac-4c6e-4e4d-a81d-66df1abdc746","name":"Reject Invalid Lead","type":"n8n-nodes-base.respondToWebhook","position":[7264,1248],"parameters":{"options":{"responseCode":400},"respondWith":"json","responseBody":"={{ JSON.stringify({ status: 'rejected', reason: 'a valid email address is required' }) }}"},"typeVersion":1},{"id":"1c219495-6b3f-49a5-b155-7186508bf822","name":"Search Lead in Sheets","type":"n8n-nodes-base.googleSheets","position":[7632,992],"parameters":{"options":{},"filtersUI":{"values":[{"lookupValue":"={{ $json.email }}","lookupColumn":"email"}]},"sheetName":{"__rl":true,"mode":"name","value":"Leads"},"documentId":{"__rl":true,"mode":"list","value":"","cachedResultName":""}},"typeVersion":4.5,"alwaysOutputData":true},{"id":"3d93272b-d0e6-4e52-8d2c-32e4b2af2004","name":"Classify Lead as New or Returning","type":"n8n-nodes-base.code","position":[7856,992],"parameters":{"jsCode":"// Find Existing Lead runs with \"Always Output Data\" on, so a miss arrives here as a\n// single empty item rather than as nothing at all. Checking for the email key is what\n// distinguishes \"no match\" from \"matched a row\".\nconst lead = $('Normalize Lead Data').first().json;\n\nconst rows = $input.all()\n  .map(i => i.json || {})\n  .filter(r => r.email && String(r.email).toLowerCase() === lead.email);\n\nconst existing = rows[0] || null;\nconst timesSeen = existing ? (Number(existing.times_seen) || 1) + 1 : 1;\n\nreturn [{\n  json: {\n    ...lead,\n    isNew: !existing,\n    timesSeen,\n    firstSeen: existing && existing.first_seen ? existing.first_seen : lead.receivedAt,\n    lastSeen: lead.receivedAt,\n    // A returning lead keeps whatever status you set by hand in the sheet. Overwriting\n    // it on every resubmission would silently undo your team's own triage.\n    status: existing && existing.status ? existing.status : 'new'\n  }\n}];"},"typeVersion":2},{"id":"fb5d828f-4ace-4933-93fd-54411182c08c","name":"Check If Lead is New","type":"n8n-nodes-base.if","position":[8064,992],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"cond-is-new","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.isNew }}","rightValue":""}]}},"typeVersion":2},{"id":"f8befd65-f187-43f7-9217-4a123cc9d5de","name":"Add New Lead to Sheets","type":"n8n-nodes-base.googleSheets","position":[8304,864],"parameters":{"columns":{"value":{"name":"={{ $json.name }}","email":"={{ $json.email }}","phone":"={{ $json.phone }}","source":"={{ $json.source }}","status":"={{ $json.status }}","company":"={{ $json.company }}","message":"={{ $json.message }}","last_seen":"={{ $json.lastSeen }}","first_seen":"={{ $json.firstSeen }}","times_seen":"={{ $json.timesSeen }}"},"schema":[{"id":"email","type":"string","display":true,"required":false,"displayName":"email","defaultMatch":false,"canBeUsedToMatch":true},{"id":"name","type":"string","display":true,"required":false,"displayName":"name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"company","type":"string","display":true,"required":false,"displayName":"company","defaultMatch":false,"canBeUsedToMatch":true},{"id":"phone","type":"string","display":true,"required":false,"displayName":"phone","defaultMatch":false,"canBeUsedToMatch":true},{"id":"source","type":"string","display":true,"required":false,"displayName":"source","defaultMatch":false,"canBeUsedToMatch":true},{"id":"message","type":"string","display":true,"required":false,"displayName":"message","defaultMatch":false,"canBeUsedToMatch":true},{"id":"first_seen","type":"string","display":true,"required":false,"displayName":"first_seen","defaultMatch":false,"canBeUsedToMatch":true},{"id":"last_seen","type":"string","display":true,"required":false,"displayName":"last_seen","defaultMatch":false,"canBeUsedToMatch":true},{"id":"times_seen","type":"string","display":true,"required":false,"displayName":"times_seen","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{"cellFormat":"RAW"},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Leads"},"documentId":{"__rl":true,"mode":"list","value":"","cachedResultName":""}},"typeVersion":4.5},{"id":"7ae52d70-b636-410a-8394-afca589a3611","name":"Update Lead in Sheets","type":"n8n-nodes-base.googleSheets","position":[8304,1264],"parameters":{"columns":{"value":{"email":"={{ $json.email }}","last_seen":"={{ $json.lastSeen }}","times_seen":"={{ $json.timesSeen }}"},"schema":[{"id":"email","type":"string","display":true,"required":false,"displayName":"email","defaultMatch":false,"canBeUsedToMatch":true},{"id":"name","type":"string","display":true,"removed":false,"required":false,"displayName":"name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"company","type":"string","display":true,"removed":false,"required":false,"displayName":"company","defaultMatch":false,"canBeUsedToMatch":true},{"id":"phone","type":"string","display":true,"removed":false,"required":false,"displayName":"phone","defaultMatch":false,"canBeUsedToMatch":true},{"id":"source","type":"string","display":true,"removed":false,"required":false,"displayName":"source","defaultMatch":false,"canBeUsedToMatch":true},{"id":"message","type":"string","display":true,"removed":false,"required":false,"displayName":"message","defaultMatch":false,"canBeUsedToMatch":true},{"id":"first_seen","type":"string","display":true,"removed":false,"required":false,"displayName":"first_seen","defaultMatch":false,"canBeUsedToMatch":true},{"id":"last_seen","type":"string","display":true,"required":false,"displayName":"last_seen","defaultMatch":false,"canBeUsedToMatch":true},{"id":"times_seen","type":"string","display":true,"required":false,"displayName":"times_seen","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"removed":false,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["email"],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{"cellFormat":"RAW"},"operation":"appendOrUpdate","sheetName":{"__rl":true,"mode":"name","value":"Leads"},"documentId":{"__rl":true,"mode":"list","value":"","cachedResultName":""}},"typeVersion":4.5},{"id":"e52289a1-d4da-479c-8454-b0765f73cdce","name":"Notify New Lead in Slack","type":"n8n-nodes-base.slack","position":[8528,864],"webhookId":"a91d06ad-3bc5-406f-b931-f251d0d4b793","parameters":{"text":"=:seedling: *New lead captured*\n\n*Name:* {{ $('Classify Lead as New or Returning').item.json.name || '(not provided)' }}\n*Email:* {{ $('Classify Lead as New or Returning').item.json.email }}\n*Company:* {{ $('Classify Lead as New or Returning').item.json.company || '(unknown)' }}\n*Source:* {{ $('Classify Lead as New or Returning').item.json.source }}\n{{ $('Classify Lead as New or Returning').item.json.message ? '\\n> ' + $('Classify Lead as New or Returning').item.json.message : '' }}","select":"channel","channelId":{"__rl":true,"mode":"list","value":"","cachedResultName":""},"otherOptions":{"includeLinkToWorkflow":false}},"typeVersion":2.2}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":false,"executionOrder":"v1"},"versionId":"fa3cbff9-08f9-4c99-b9bd-fcbc4d9dc32a","nodeGroups":[],"connections":{"Check Lead Validity":{"main":[[{"node":"Acknowledge Valid Lead","type":"main","index":0}],[{"node":"Reject Invalid Lead","type":"main","index":0}]]},"Normalize Lead Data":{"main":[[{"node":"Check Lead Validity","type":"main","index":0}]]},"Check If Lead is New":{"main":[[{"node":"Add New Lead to Sheets","type":"main","index":0}],[{"node":"Update Lead in Sheets","type":"main","index":0}]]},"Search Lead in Sheets":{"main":[[{"node":"Classify Lead as New or Returning","type":"main","index":0}]]},"Acknowledge Valid Lead":{"main":[[{"node":"Search Lead in Sheets","type":"main","index":0}]]},"Add New Lead to Sheets":{"main":[[{"node":"Notify New Lead in Slack","type":"main","index":0}]]},"When New Lead Received":{"main":[[{"node":"Normalize Lead Data","type":"main","index":0}]]},"Classify Lead as New or Returning":{"main":[[{"node":"Check If Lead is New","type":"main","index":0}]]}}}