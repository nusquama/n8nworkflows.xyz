on":[3120,-768],"webhookId":"adbd1f38-2eef-4e38-94cb-eab73479e70f","parameters":{"sendTo":"={{ $json.contact_email }}","message":"={{ 'Hi ' + $json.contact_name + ',<br><br>' + $json.client_notice + '<br><br>Forecast: ' + $json.forecast_snow_cm + ' cm of snow in the next 12 hours, minimum ' + $json.forecast_temp_c + ' C.<br><br>We will confirm once the work is finished. Reply to this email if anything on site changes.<br><br>Winter operations team' }}","options":{},"subject":"={{ 'Winter service tonight: ' + $json.site_name }}"},"credentials":{"gmailOAuth2":{"id":"credential-id","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"alert-owner-on-dispatch","name":"Alert Owner On Dispatch","type":"n8n-nodes-base.telegram","position":[3360,-768],"webhookId":"4a9e2767-c676-4d69-98a8-e07aab7c022d","parameters":{"text":"={{ 'Dispatch ' + $json.dispatch_id + ' | ' + $json.site_name + ' | priority ' + $json.priority + ' | ' + $json.trigger_reason + ' | crew ' + $json.crew_name + ' briefed | client ' + $json.contact_name + ' notified' }}","chatId":"123456789","additionalFields":{}},"credentials":{"telegramApi":{"id":"credential-id","name":"CF Openai Bot"}},"typeVersion":1.2},{"id":"normalize-crew-confirmation","name":"Normalize Crew Confirmation","type":"n8n-nodes-base.set","position":[1488,-1200],"parameters":{"options":{},"assignments":{"assignments":[{"id":"a0","name":"dispatch_id","type":"string","value":"={{ String($json.body.dispatch_id || '').trim() }}"},{"id":"a1","name":"outcome","type":"string","value":"={{ String($json.body.status || 'done').toLowerCase().trim() }}"},{"id":"a2","name":"hours_to_clear","type":"number","value":"={{ Number($json.body.hours_to_clear || 0) }}"},{"id":"a3","name":"salt_used","type":"string","value":"={{ String($json.body.salt_used || '').trim() }}"},{"id":"a4","name":"notes","type":"string","value":"={{ String($json.body.notes || '').trim() }}"},{"id":"a5","name":"received_at","type":"string","value":"={{ $now.toISO() }}"}]}},"typeVersion":3.4},{"id":"read-dispatch-log-for-confir","name":"Read Dispatch Log For Confirm","type":"n8n-nodes-base.googleSheets","position":[1728,-1200],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"DispatchLog"},"documentId":{"__rl":true,"mode":"id","value":"1uy_a0M6kTCbzQI3k8p0tYwAyagaDBSTCeXLpM7UQk1w"}},"credentials":{"googleSheetsOAuth2Api":{"id":"credential-id","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"match-dispatch-row","name":"Match Dispatch Row","type":"n8n-nodes-base.code","position":[1968,-1200],"parameters":{"jsCode":"\nconst rows = $('Read Dispatch Log For Confirm').all().map(i => i.json);\nconst c = $('Normalize Crew Confirmation').first().json;\nconst key = String(c.dispatch_id || '').trim();\nconst hit = rows.filter(r => String(r.dispatch_id || '').trim() === key)[0] || null;\nconst problems = [];\nif (!key) problems.push('dispatch_id is required');\nelse if (!hit) problems.push('dispatch id ' + key + ' is not in the dispatch log');\nif (!String(c.outcome || '').trim()) problems.push('status is required');\nreturn [{ json: Object.assign({}, c, {\n  found: !!hit,\n  site_id: hit ? String(hit.site_id || '') : '',\n  site_name: hit ? String(hit.site_name || '') : '',\n  address: hit ? String(hit.address || '') : '',\n  priority: hit ? Number(hit.priority || 3) : 0,\n  trigger_reason: hit ? String(hit.trigger_reason || '') : '',\n  crew_name: hit ? String(hit.crew_name || '') : '',\n  contact_name: hit ? String(hit.contact_name || '') : '',\n  contact_email: hit ? String(hit.contact_email || '') : '',\n  ready: problems.length === 0,\n  problem: problems.join(' and ')\n}) }];\n"},"typeVersion":2},{"id":"confirmation-ready","name":"Confirmation Ready?","type":"n8n-nodes-base.if","position":[2208,-1200],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"c1","operator":{"type":"boolean","operation":"true"},"leftValue":"={{ $json.ready }}","rightValue":""}]}},"typeVersion":2.3},{"id":"update-dispatch-log","name":"Update Dispatch Log","type":"n8n-nodes-base.googleSheets","position":[2448,-1200],"parameters":{"columns":{"value":{"notes":"={{ $json.notes }}","status":"={{ $json.outcome }}","salt_used":"={{ $json.salt_used }}","dispatch_id":"={{ $json.dispatch_id }}","completed_at":"={{ $now.toISO() }}","hours_to_clear":"={{ $json.hours_to_clear }}"},"schema":[{"id":"dispatch_id","type":"string","display":true,"removed":false,"required":false,"displayName":"dispatch_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"removed":false,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"completed_at","type":"string","display":true,"removed":false,"required":false,"displayName":"completed_at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"hours_to_clear","type":"string","display":true,"removed":false,"required":false,"displayName":"hours_to_clear","defaultMatch":false,"canBeUsedToMatch":true},{"id":"salt_used","type":"string","display":true,"removed":false,"required":false,"displayName":"salt_used","defaultMatch":false,"canBeUsedToMatch":true},{"id":"notes","type":"string","display":true,"removed":false,"required":false,"displayName":"notes","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["dispatch_id"]},"options":{},"operation":"update","sheetName":{"__rl":true,"mode":"name","value":"DispatchLog"},"documentId":{"__rl":true,"mode":"id","value":"1uy_a0M6kTCbzQI3k8p0tYwAyagaDBSTCeXLpM7UQk1w"}},"credentials":{"googleSheetsOAuth2Api":{"id":"credential-id","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"email-client-completion-noti","name":"Email Client Completion Notice","type":"n8n-nodes-base.gmail","position":[2688,-1200],"webhookId":"3d93b1ec-4345-483d-a509-59e301e0d121","parameters":{"sendTo":"={{ $json.contact_email }}","message":"={{ 'Hi ' + $json.contact_name + ',<br><br>The crew closed ' + $json.site_name + ' as ' + $json.outcome + ' after ' + $json.hours_to_clear + ' hours on site.<br><br>Salt used: ' + ($json.salt_used || 'as needed') + '<br>Crew note: ' + ($json.notes || 'no extra note') + '<br><br>Dispatch id ' + $json.dispatch_id + '. Send us a note if anything still needs attention.' }}","options":{},"subject":"={{ 'Winter service update: ' + $json.site_name + ' is clear' }}"},"credentials":{"gmailOAuth2":{"id":"credential-id","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"alert-owner-on-completion","name":"Alert Owner On Completion","type":"n8n-nodes-base.telegram","position":[2928,-1200],"webhookId":"a18c9c3f-a756-439b-8dce-5bd6384fe0e1","parameters":{"text":"={{ 'Dispatch closed: ' + $json.site_name + ' marked ' + $json.outcome + ' by ' + $json.crew_name + ' after ' + $json.hours_to_clear + ' h. Salt used: ' + ($json.salt_used || 'not reported') + '. Client ' + $json.contact_name + ' notified.' }}","chatId":"123456789","additionalFields":{}},"credentials":{"telegramApi":{"id":"credential-id","name":"CF Openai Bot"}},"typeVersion":1.2},{"id":"build-confirmation-error","name":"Build Confirmation Error","type":"n8n-nodes-base.set","position":[3216,-1168],"parameters":{"options":{},"assignments":{"assignments":[{"id":"a0","name":"error_id","type":"string","value":"={{ 'ER-' + Date.now() }}"},{"id":"a1","name":"source","type":"string","value":"crew confirmation"},{"id":"a2","name":"dispatch_id","type":"string","value":"={{ $json.dispatch_id || 'missing' }}"},{"id":"a3","name":"reason","type":"string","value":"={{ $json.problem }}"},{"id":"a4","name":"tg_text","type":"string","value":"={{ 'Crew confirmation rejected: ' + ($json.dispatch_id || 'no dispatch id') + ' | ' + $json.problem }}"},{"id":"a5","name":"email_subject","type":"string","value":"={{ 'Crew confirmation rejected: ' + ($json.dispatch_id || 'no dispatch id') }}"},{"id":"a6","name":"email_body","type":"string","value":"={{ 'A crew confirmation could not be applied.<br><br>Dispatch id: ' + ($json.dispatch_id || 'missing') + '<br>Outcome: ' + ($json.outcome || 'missing') + '<br>Problem: ' + $json.problem + '<br><br>The dispatch log was left unchanged. Send the confirmation again with the right dispatch id.' }}"}]}},"typeVersion":3.4},{"id":"alert-confirmation-error","name":"Alert Confirmation Error","type":"n8n-nodes-base.telegram","position":[3456,-1168],"webhookId":"ad2d56d9-0fde-478a-8052-e8befdb50224","parameters":{"text":"={{ $json.tg_text }}","chatId":"123456789","additionalFields":{}},"credentials":{"telegramApi":{"id":"credential-id","name":"CF Openai Bot"}},"typeVersion":1.2},{"id":"email-confirmation-error","name":"Email Confirmation Error","type":"n8n-nodes-base.gmail","position":[3696,-1168],"webhookId":"f4182bcb-62b6-4b9d-be02-085bbe060290","parameters":{"sendTo":"user@example.com","message":"={{ $json.email_body }}","options":{},"subject":"={{ $json.email_subject }}"},"credentials":{"gmailOAuth2":{"id":"credential-id","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"read-dispatch-log-for-sweep","name":"Read Dispatch Log For Sweep","type":"n8n-nodes-base.googleSheets","position":[832,-1616],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"DispatchLog"},"documentId":{"__rl":true,"mode":"id","value":"1uy_a0M6kTCbzQI3k8p0tYwAyagaDBSTCeXLpM7UQk1w"}},"credentials":{"googleSheetsOAuth2Api":{"id":"credential-id","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"find-unconfirmed-dispatches","name":"Find Unconfirmed Dispatches","type":"n8n-nodes-base.code","position":[1072,-1616],"parameters":{"jsCode":"\nconst rows = $input.all().map(i => i.json);\nconst stale = [];\nrows.forEach(r => {\n  if (String(r.status || '').toLowerCase().trim() !== 'dispatched') return;\n  const raw = String(r.dispatched_at || '');\n  const t = Date.parse(raw);\n  if (isNaN(t)) return;\n  const age = Math.round((Date.now() - t) / 3600000 * 10) / 10;\n  if (age < 6) return;\n  stale.push({\n    dispatch_id: String(r.dispatch_id || ''),\n    site_name: String(r.site_name || ''),\n    priority: Number(r.priority || 3),\n    crew_name: String(r.crew_name || ''),\n    crew_email: String(r.crew_email || ''),\n    contact_email: String(r.contact_email || ''),\n    dispatched_at: raw,\n    age_hours: age\n  });\n});\nstale.sort((a, b) => b.age_hours - a.age_hours);\nconst lines = stale.map(s => s.dispatch_id + ' | ' + s.site_name + ' | priority ' + s.priority + ' | crew ' + s.crew_name + ' | waiting ' + s.age_hours + ' h | client ' + s.contact_email);\nconst list = lines.join(' ;; ');\nreturn [{ json: {\n  run_at: $now.toISO(),\n  open_count: stale.length,\n  oldest_hours: stale.length ? stale[0].age_hours : 0,\n  report_list: list || 'none',\n  report_subject: 'Unconfirmed winter dispatches: ' + stale.length + ' still open',\n  report_body: stale.length\n    ? ('These dispatches are still marked as dispatched more than six hours after they went out. Chase the crew lead or close them on the confirmation webhook.<br><br>' + list.split(' ;; ').join('<br><br>'))\n    : 'Every winter dispatch has a crew confirmation. Nothing to chase.',\n  telegram_text: stale.length\n    ? ('Dispatch follow up: ' + stale.length + ' winter dispatch(es) with no crew confirmation. Oldest is ' + stale[0].age_hours + ' h old. ' + list)\n    : 'All winter dispatches are confirmed.'\n} }];\n"},"typeVersion":2},{"id":"unconfirmed-dispatches","name":"Unconfirmed Dispatches?","type":"n8n-nodes-base.if","position":[1312,-1616],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"c1","operator":{"type":"number","operation":"gte"},"leftValue":"={{ $json.open_count }}","rightValue":"1"}]}},"typeVersion":2.3},{"id":"email-unconfirmed-dispatch-r","name":"Email Unconfirmed Dispatch Report","type":"n8n-nodes-base.gmail","position":[1552,-16