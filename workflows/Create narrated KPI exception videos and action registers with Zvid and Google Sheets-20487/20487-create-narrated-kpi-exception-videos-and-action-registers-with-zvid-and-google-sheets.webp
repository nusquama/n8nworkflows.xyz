{"id":"ZvidKpiReportVideo","meta":{"lateSeriesReview":1,"templateCredsSetupCompleted":false},"name":"Create KPI exception videos and action registers with Zvid","tags":[],"nodes":[{"id":"zvid-kr-0003","name":"Set reporting period and exception thresholds","type":"n8n-nodes-base.set","position":[340,500],"parameters":{"mode":"raw","options":{},"jsonOutput":"{\n  \"apiUrl\": \"https://api.zvid.io\",\n  \"editorUrl\": \"https://editor.zvid.io\",\n  \"metricsUrl\": \"\",\n  \"narrate\": false,\n  \"slackWebhookUrl\": \"\",\n  \"brandName\": \"Acme\",\n  \"reportKicker\": \"WEEKLY KPI REPORT\",\n  \"reportTitle\": \"The week in numbers.\",\n  \"summaryLine\": \"Full breakdown in the dashboard.\",\n  \"brandAccent\": \"#38E1FF\",\n  \"brandBackground\": \"#0B1220\",\n  \"textColor\": \"#FFFFFF\",\n  \"mutedColor\": \"#9DB0CC\",\n  \"goodColor\": \"#34D399\",\n  \"badColor\": \"#FF6B78\",\n  \"font\": \"Space Grotesk\",\n  \"titleVideoUrl\": \"https://videos.pexels.com/video-files/34170258/14485841_1920_1080_25fps.mp4\",\n  \"llmModel\": \"openai/gpt-4.1-mini\",\n  \"voiceId\": \"nPczCjzI2devNBz1zQrb\",\n  \"voiceLabel\": \"Brian (deep narrator)\",\n  \"elevenModel\": \"eleven_multilingual_v2\",\n  \"voiceStability\": 0.4,\n  \"voiceSimilarity\": 0.75,\n  \"captionAnimation\": \"karaoke\",\n  \"captionWordsPerCue\": 4,\n  \"captionSize\": 40,\n  \"captionStrokeWidth\": 6,\n  \"sceneTransition\": \"smoothleft\",\n  \"transitionSeconds\": 0.45,\n  \"tailSeconds\": 0.6,\n  \"musicUrl\": \"\",\n  \"musicVolume\": 0.12,\n  \"musicVolumeSolo\": 0.26,\n  \"maxMusicBytes\": 5242880,\n  \"resolution\": \"full-hd\",\n  \"frameRate\": 30,\n  \"dryRun\": false,\n  \"pollSeconds\": 10,\n  \"timeoutMinutes\": 20,\n  \"timezone\": \"UTC\",\n  \"reportRevision\": 1,\n  \"maxDataAgeHours\": 36,\n  \"alertPercent\": 10,\n  \"onlyExceptions\": false,\n  \"sendSlack\": false,\n  \"maxCreditsPerVideo\": 65,\n  \"metricsSource\": \"live\"\n}"},"typeVersion":3.4},{"id":"zvid-kr-0002","name":"Test the kpi report video workflow","type":"n8n-nodes-base.manualTrigger","position":[60,660],"parameters":{},"typeVersion":1},{"id":"zvid-kr-0001","name":"Start the scheduled kpi report video","type":"n8n-nodes-base.scheduleTrigger","position":[60,260],"parameters":{"rule":{"interval":[{"field":"weeks","triggerAtDay":[1],"triggerAtHour":9,"weeksInterval":1,"triggerAtMinute":0}]}},"typeVersion":1.2},{"id":"zvid-kr-0029","name":"▶ Watch video","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":3,"position":[12300,500],"parameters":{"url":"={{ $json.videoUrl }}","options":{"timeout":30000},"responseFormat":"file","dataPropertyName":"data"},"retryOnFail":true,"typeVersion":2,"alwaysOutputData":true,"waitBetweenTries":5000},{"id":"zvid-kr-0005","name":"Fetch the reporting source snapshot","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":3,"position":[1380,700],"parameters":{"url":"={{ $json.metricsUrl }}","options":{"timeout":20000,"response":{"response":{"neverError":true,"fullResponse":true}}}},"retryOnFail":true,"typeVersion":4.2,"alwaysOutputData":true,"waitBetweenTries":2000},{"id":"late-metrics-mode","name":"Use explicitly selected sample metrics?","type":"n8n-nodes-base.if","position":[820,500],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"metrics-mode-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.metricsSource === 'sample' }}","rightValue":""}]}},"typeVersion":2.2},{"id":"late-sample-metrics","name":"Create labeled sample metrics for testing","type":"n8n-nodes-base.code","position":[1100,260],"parameters":{"jsCode":"function helpers() {\n\tconst text = (v) => String(v ?? '').trim();\n\tconst number = (v, label) => {\n\t\tif (\n\t\t\tv === null ||\n\t\t\tv === undefined ||\n\t\t\tv === '' ||\n\t\t\ttypeof v === 'boolean' ||\n\t\t\t!Number.isFinite(Number(v))\n\t\t)\n\t\t\tthrow Error(label + ' must be a finite number');\n\t\treturn Number(v);\n\t};\n\tconst iso = (v, label = 'Date') => {\n\t\tconst s = text(v);\n\t\tif (\n\t\t\t!/^\\d{4}-\\d{2}-\\d{2}$/.test(s) ||\n\t\t\t!Number.isFinite(Date.parse(s + 'T12:00:00Z')) ||\n\t\t\tnew Date(s + 'T12:00:00Z').toISOString().slice(0, 10) !== s\n\t\t)\n\t\t\tthrow Error(label + ' must be a real YYYY-MM-DD date');\n\t\treturn s;\n\t};\n\tconst day = (now, timezone = 'UTC') =>\n\t\tnew Intl.DateTimeFormat('en-CA', {\n\t\t\ttimeZone: timezone,\n\t\t\tyear: 'numeric',\n\t\t\tmonth: '2-digit',\n\t\t\tday: '2-digit',\n\t\t}).format(now);\n\tconst shift = (s, n) =>\n\t\tnew Date(Date.parse(s + 'T12:00:00Z') + n * 86400000).toISOString().slice(0, 10);\n\tconst truth = (v) => v === true || /^(true|yes|1)$/i.test(text(v));\n\tconst https = (v, label) => {\n\t\tconst s = text(v);\n\t\tif (!/^https:\\/\\/[^\\s/]+(?:\\/\\S*)?$/i.test(s)) throw Error(label + ' must be an HTTPS URL');\n\t\treturn s;\n\t};\n\tconst unique = (rows, key) => {\n\t\tconst seen = new Set();\n\t\tfor (const r of rows) {\n\t\t\tconst s = text(r[key]);\n\t\t\tif (!s || seen.has(s)) throw Error('Every row needs a unique ' + key);\n\t\t\tseen.add(s);\n\t\t}\n\t};\n\tconst noWork = (reason, extra = {}) => ({\n\t\tready: false,\n\t\tstatus: 'nothing_to_render',\n\t\tcreditsSpent: 0,\n\t\treason,\n\t\t...extra,\n\t});\n\treturn { text, number, iso, day, shift, truth, https, unique, noWork };\n}\nfunction sampleKpiResponse(cfg, now) {\n\tif (cfg.metricsSource !== 'sample') throw Error('Sample metrics require metricsSource=sample.');\n\tconst h = helpers(),\n\t\tend = h.shift(h.day(now, cfg.timezone), -1);\n\treturn {\n\t\tstatusCode: 200,\n\t\tbody: {\n\t\t\tsampleData: true,\n\t\t\tcompany: 'SAMPLE DATA - Example team',\n\t\t\tgeneratedAt: now.toISOString(),\n\t\t\tperiodStart: h.shift(end, -6),\n\t\t\tperiodEnd: end,\n\t\t\tmetrics: [\n\t\t\t\t{\n\t\t\t\t\tid: 'revenue',\n\t\t\t\t\tlabel: 'Example revenue',\n\t\t\t\t\tvalue: 120000,\n\t\t\t\t\tprevious: 150000,\n\t\t\t\t\tunit: 'USD',\n\t\t\t\t\tlowerIsBetter: false,\n\t\t\t\t\ttarget: 160000,\n\t\t\t\t\towner: 'Example sales team',\n\t\t\t\t\taction: 'Example: review the sales pipeline',\n\t\t\t\t\thistory: [140000, 150000, 120000],\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\tid: 'conversion',\n\t\t\t\t\tlabel: 'Example conversion rate',\n\t\t\t\t\tvalue: 4.2,\n\t\t\t\t\tprevious: 3.6,\n\t\t\t\t\tunit: '%',\n\t\t\t\t\tlowerIsBetter: false,\n\t\t\t\t\ttarget: 4,\n\t\t\t\t\towner: 'Example growth team',\n\t\t\t\t\taction: 'Example: review campaign performance',\n\t\t\t\t\thistory: [3.4, 3.6, 4.2],\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\tid: 'response',\n\t\t\t\t\tlabel: 'Example response time',\n\t\t\t\t\tvalue: 3.4,\n\t\t\t\t\tprevious: 2.1,\n\t\t\t\t\tunit: 'hours',\n\t\t\t\t\tlowerIsBetter: true,\n\t\t\t\t\ttarget: 2.5,\n\t\t\t\t\towner: 'Example support team',\n\t\t\t\t\taction: 'Example: review queue coverage',\n\t\t\t\t\thistory: [2.5, 2.1, 3.4],\n\t\t\t\t},\n\t\t\t],\n\t\t},\n\t};\n}\nreturn [{json:sampleKpiResponse($json,new Date())}];"},"typeVersion":2},{"id":"late-require-metrics","name":"Require a live reporting URL before fetching","type":"n8n-nodes-base.code","position":[1100,700],"parameters":{"jsCode":"function helpers() {\n\tconst text = (v) => String(v ?? '').trim();\n\tconst number = (v, label) => {\n\t\tif (\n\t\t\tv === null ||\n\t\t\tv === undefined ||\n\t\t\tv === '' ||\n\t\t\ttypeof v === 'boolean' ||\n\t\t\t!Number.isFinite(Number(v))\n\t\t)\n\t\t\tthrow Error(label + ' must be a finite number');\n\t\treturn Number(v);\n\t};\n\tconst iso = (v, label = 'Date') => {\n\t\tconst s = text(v);\n\t\tif (\n\t\t\t!/^\\d{4}-\\d{2}-\\d{2}$/.test(s) ||\n\t\t\t!Number.isFinite(Date.parse(s + 'T12:00:00Z')) ||\n\t\t\tnew Date(s + 'T12:00:00Z').toISOString().slice(0, 10) !== s\n\t\t)\n\t\t\tthrow Error(label + ' must be a real YYYY-MM-DD date');\n\t\treturn s;\n\t};\n\tconst day = (now, timezone = 'UTC') =>\n\t\tnew Intl.DateTimeFormat('en-CA', {\n\t\t\ttimeZone: timezone,\n\t\t\tyear: 'numeric',\n\t\t\tmonth: '2-digit',\n\t\t\tday: '2-digit',\n\t\t}).format(now);\n\tconst shift = (s, n) =>\n\t\tnew Date(Date.parse(s + 'T12:00:00Z') + n * 86400000).toISOString().slice(0, 10);\n\tconst truth = (v) => v === true || /^(true|yes|1)$/i.test(text(v));\n\tconst https = (v, label) => {\n\t\tconst s = text(v);\n\t\tif (!/^https:\\/\\/[^\\s/]+(?:\\/\\S*)?$/i.test(s)) throw Error(label + ' must be an HTTPS URL');\n\t\treturn s;\n\t};\n\tconst unique = (rows, key) => {\n\t\tconst seen = new Set();\n\t\tfor (const r of rows) {\n\t\t\tconst s = text(r[key]);\n\t\t\tif (!s || seen.has(s)) throw Error('Every row needs a unique ' + key);\n\t\t\tseen.add(s);\n\t\t}\n\t};\n\tconst noWork = (reason, extra = {}) => ({\n\t\tready: false,\n\t\tstatus: 'nothing_to_render',\n\t\tcreditsSpent: 0,\n\t\treason,\n\t\t...extra,\n\t});\n\treturn { text, number, iso, day, shift, truth, https, unique, noWork };\n}\nif(($json.metricsSource||'live')!=='live')throw Error('metricsSource must be live or sample.');if(!$json.metricsUrl)throw Error('KPI setup required: set metricsUrl or explicitly choose metricsSource=sample for a labeled test.');helpers().https($json.metricsUrl,'metricsUrl');return $input.all();"},"typeVersion":2},{"id":"late-metrics-input","name":"Choose the configured metrics input","type":"n8n-nodes-base.code","position":[1660,500],"parameters":{"jsCode":"return $input.all();"},"typeVersion":2},{"id":"late-ledger","name":"Read KPI Reports recovery log","type":"n8n-nodes-base.googleSheets","position":[1940,500],"parameters":{"options":{},"resource":"sheet","operation":"read","sheetName":{"__rl":true,"mode":"name","value":"KPI Reports"},"documentId":{"__rl":true,"mode":"id","value":""}},"typeVersion":4.7,"alwaysOutputData":true},{"id":"late-plan","name":"Calculate KPI changes target misses and owners","type":"n8n-nodes-base.code","position":[2220,500],"parameters":{"jsCode":"function helpers() {\n\tconst text = (v) => String(v ?? '').trim();\n\tconst number = (v, label) => {\n\t\tif (\n\t\t\tv === null ||\n\t\t\tv === undefined ||\n\t\t\tv === '' ||\n\t\t\ttypeof v === 'boolean' ||\n\t\t\t!Number.isFinite(Number(v))\n\t\t)\n\t\t\tthrow Error(label + ' must be a finite number');\n\t\treturn Number(v);\n\t};\n\tconst iso = (v, label = 'Date') => {\n\t\tconst s = text(v);\n\t\tif (\n\t\t\t!/^\\d{4}-\\d{2}-\\d{2}$/.test(s) ||\n\t\t\t!Number.isFinite(Date.parse(s + 'T12:00:00Z')) ||\n\t\t\tnew Date(s + 'T12:00:00Z').toISOString().slice(0, 10) !== s\n\t\t)\n\t\t\tthrow Error(label + ' must be a real YYYY-MM-DD date');\n\t\treturn s;\n\t};\n\tconst day = (now, timezone = 'UTC') =>\n\t\tnew Intl.DateTimeFormat('en-CA', {\n\t\t\ttimeZone: timezone,\n\t\t\tyear: 'numeric',\n\t\t\tmonth: '2-digit',\n\t\t\tday: '2-digit',\n\t\t}).format(now);\n\tconst shift = (s, n) =>\n\t\tnew Date(Date.parse(s + 'T12:00:00Z') + n * 86400000).toISOString().slice(0, 10);\n\tconst truth = (v) => v === true || /^(true|yes|1)$/i.test(text(v));\n\tconst https = (v, label) => {\n\t\tconst s = text(v);\n\t\tif (!/^https:\\/\\/[^\\s/]+(?:\\/\\S*)?$/i.test(s)) throw Error(label + ' must be an HTTPS URL');\n\t\treturn s;\n\t};\n\tconst unique = (rows, key) => {\n\t\tconst seen = new Set();\n\t\tfor (const r of rows) {\n\t\t\tconst s = text(r[key]);\n\t\t\tif (!s || seen.has(s)) throw Error('Every row needs a unique ' + key);\n\t\t\tseen.add(s);\n\t\t}\n\t};\n\tconst noWork = (reason, extra = {}) => ({\n\t\tready: false,\n\t\tstatus: 'nothing_to_render',\n\t\tcreditsSpent: 0,\n\t\treason,\n\t\t...extra,\n\t});\n\treturn { text, number, iso, day, shift, truth, https, unique, noWork };\n}\nfunction recoverPlan(cfg, key, rows) {\n\tconst matches = rows.filter((r) => String(r.RenderKey || '') === key);\n\tif (matches.length > 1) throw Error('Duplicate RenderKey in log: ' + key);\n\tconst row = matches[0];\n\tif (!row) return null;\n\t// An explicit capacity rejection accepted no paid job. It can be retried on\n\t// a later run; uncertain submissions and failed accepted jobs remain locked.\n\tif (row.Status === 'rate_limited' && !row.JobId && !row.VideoUrl) return null;\n\tif (row.Status === 'completed' || row.VideoUrl)\n\t\treturn {\n\t\t\tready: false,\n\t\t\tstatus: 'already_completed',\n\t\t\trenderKey: key,\n\t\t\tvideoUrl: row.VideoUrl || null,\n\t\t\tcreditsSpent: 0,\n\t\t};\n\tif (row.Status === 'rendering' && row.JobId && cfg.dryRun !== true) {\n\t\tlet plan;\n\t\ttry {\n\t\t\tplan = JSON.parse(row.PlanJson);\n\t\t} catch {\n\t\t\tthrow Error('Saved PlanJson is invalid for ' + key);\n\t\t}\n\t\tif (plan.renderKey !== key || plan.snapshotVersion !== 1)\n\t\t\tthrow Error('Saved snapshot does not match ' + key);\n\t\treturn { ...plan, ready: true, jobId: String(row.JobId), resumed: true };\n\t}\n\treturn {\n\t\tready: false,\n\t\tstatus: 'needs_review',\n\t\trenderKey: key,\n\t\treason:\n\t\t\tcfg.dryRun === true\n\t\t\t\t? 'Preview skips existing jobs.'\n\t\t\t\t: 'Inspect the saved ' + row.Status + ' job before resetting this key.',\n\t\tjobId: row.JobId || null,\n\t\tcreditsSpent: 0,\n\t};\n}\nfunction resumeOutstanding(cfg, logs, prefix) {\n\tif (cfg.dryRun === true) return null;\n\tconst saved = logs\n\t\t.filter(\n\t\t\t(r) => String(r.RenderKey || '').startsWith(prefix) && r.Status === 'rendering' && r.JobId,\n\t\t)\n\t\t.sort((a, b) => String(a.RenderKey).localeCompare(String(b.RenderKey)));\n\tif (!saved.length) return null;\n\t// Recover paid work even when its source changed or a date rolled over.\n\t// Delivery approval is intentionally re-reviewed after such a recovery.\n\tconst plan = recoverPlan(cfg, saved[0].RenderKey, logs);\n\treturn { ...plan, emailApproved: false, deferredSavedJobs: saved.length - 1 };\n}\nfunction planKpi(cfg, response, logs, now) {\n\tconst sampleMode = cfg.metricsSource === 'sample';\n\tconst scopedLogs = logs.filter(\n\t\t(r) => sampleMode === String(r.RenderKey || '').startsWith('kpi-sample-'),\n\t);\n\tconst outstanding = resumeOutstanding(cfg, scopedLogs, 'kpi-');\n\tif (outstanding) return outstanding;\n\tconst h = helpers();\n\tif (!['live', 'sample'].includes(cfg.metricsSource || 'live'))\n\t\tthrow Error('metricsSource must be live or sample.');\n\tif (!sampleMode && !h.text(cfg.metricsUrl))\n\t\tthrow Error(\n\t\t\t'KPI setup required: set metricsUrl for live data, or explicitly choose metricsSource=sample for a labeled test.',\n\t\t);\n\tif (Number(response.statusCode) !== 200)\n\t\tthrow Error('Metrics source unavailable; no report or demo data will be rendered.');\n\tlet b = response.body;\n\tif (typeof b === 'string') b = JSON.parse(b);\n\tif (sampleMode !== (b?.sampleData === true))\n\t\tthrow Error('Metrics source mode does not match its sample-data marker.');\n\tif (!b || !Array.isArray(b.metrics) || !b.metrics.length)\n\t\tthrow Error('Metrics source must contain metrics[]');\n\tconst start = h.iso(b.periodStart, 'periodStart'),\n\t\tend = h.iso(b.periodEnd, 'periodEnd');\n\tif (start > end || end >= h.day(now, cfg.timezone))\n\t\tthrow Error('Use a completed reporting period before today.');\n\tconst age = (now.getTime() - Date.parse(b.generatedAt)) / 3600000;\n\tif (!Number.isFinite(age) || age < -0.1 || age > Number(cfg.maxDataAgeHours || 36))\n\t\tthrow Error('Metrics snapshot is stale or generatedAt is invalid.');\n\tconst key =\n\t\t(sampleMode ? 'kpi-sample-' : 'kpi-') +\n\t\tstart +\n\t\t'-' +\n\t\tend +\n\t\t'-' +\n\t\th.text(cfg.reportRevision || 1);\n\tconst saved = recoverPlan(cfg, key, logs);\n\tif (saved) return saved;\n\th.unique(b.metrics, 'id');\n\tconst metrics = b.metrics\n\t\t.map((m) => {\n\t\t\tconst value = h.number(m.value, m.id + ' value'),\n\t\t\t\tprevious = h.number(m.previous, m.id + ' previous');\n\t\t\tif (typeof m.lowerIsBetter !== 'boolean')\n\t\t\t\tthrow Error(m.id + ' lowerIsBetter must be true or false');\n\t\t\tconst delta =\n\t\t\t\tprevious === 0 ? null : Math.round(((value - previous) / Math.abs(previous)) * 10000) / 100;\n\t\t\tconst target = m.target == null ? null : h.number(m.target, m.id + ' target');\n\t\t\tconst targetMiss = target !== null && (m.lowerIsBetter ? value > target : value < target);\n\t\t\tconst worsening = m.lowerIsBetter ? value > previous : value < previous;\n\t\t\tconst threshold =\n\t\t\t\tm.alertPercent == null\n\t\t\t\t\t? Number(cfg.alertPercent || 10)\n\t\t\t\t\t: h.number(m.alertPercent, 'alertPercent');\n\t\t\tif (threshold <= 0) throw Error('alertPercent must be positive');\n\t\t\tconst attention =\n\t\t\t\ttargetMiss ||\n\t\t\t\t(worsening && (delta === null ? value !== previous : Math.abs(delta) >= threshold));\n\t\t\tconst history = m.history == null ? null : m.history;\n\t\t\tif (\n\t\t\t\thistory &&\n\t\t\t\t(!Array.isArray(history) ||\n\t\t\t\t\thistory.length < 2 ||\n\t\t\t\t\thistory.some((n) => typeof n !== 'number' || !Number.isFinite(n)) ||\n\t\t\t\t\thistory.at(-1) !== value)\n\t\t\t)\n\t\t\t\tthrow Error(m.id + ' history must end at the actual value');\n\t\t\tif (!h.text(m.label) || h.text(m.label).length > 50)\n\t\t\t\tthrow Error('Metric label must contain 1–50 characters');\n\t\t\tconst baseline =\n\t\t\t\tdelta === null\n\t\t\t\t\t? 'No percentage comparison: previous value was zero.'\n\t\t\t\t\t: (delta > 0 ? '+' : '') + delta + '% versus previous period.';\n\t\t\treturn {\n\t\t\t\tid: h.text(m.id),\n\t\t\t\tlabel: h.text(m.label),\n\t\t\t\tvalue,\n\t\t\t\tprevious,\n\t\t\t\tunit: h.text(m.unit),\n\t\t\t\tdelta,\n\t\t\t\tlowerIsBetter: m.lowerIsBetter,\n\t\t\t\ttarget,\n\t\t\t\ttargetMiss,\n\t\t\t\tattention,\n\t\t\t\thistory,\n\t\t\t\towner: h.text(m.owner) || 'Unassigned',\n\t\t\t\taction: h.text(m.action) || 'Review the source dashboard; assign an owner.',\n\t\t\t\tbaseline,\n\t\t\t};\n\t\t})\n\t\t.sort(\n\t\t\t(a, b) =>\n\t\t\t\tNumber(b.attention) - Number(a.attention) ||\n\t\t\t\tNumber(b.targetMiss) - Number(a.targetMiss) ||\n\t\t\t\tMath.abs(b.delta || 0) - Math.abs(a.delta || 0) ||\n\t\t\t\ta.id.localeCompare(b.id),\n\t\t);\n\tconst exceptions = metrics.filter((m) => m.attention);\n\tif (cfg.onlyExceptions === true && !exceptions.length)\n\t\treturn h.noWork('No target misses or material adverse changes.', { metrics });\n\tconst selected = (cfg.onlyExceptions ? exceptions : metrics).slice(0, 5);\n\tconst handoff = metrics.map((m) => ({\n\t\tDataMode: sampleMode ? 'SAMPLE DATA - TEST ONLY' : 'Live source',\n\t\tMetric: m.label,\n\t\tCurrent: m.value,\n\t\tPrevious: m.previous,\n\t\tChangePercent: m.delta === null ? 'N/A' : m.delta,\n\t\tTarget: m.target ?? '',\n\t\tStatus: m.attention ? 'review' : 'on_track',\n\t\tOwner: m.owner,\n\t\tAction: m.attention ? m.action : 'Monitor',\n\t\tBaseline: m.baseline,\n\t}));\n\treturn {\n\t\tready: true,\n\t\trenderKey: key,\n\t\tcompany: sampleMode ? 'SAMPLE DATA - Example team' : h.text(b.company) || cfg.brandName,\n\t\tperiod: start + ' to ' + end,\n\t\tmetrics: selected,\n\t\tusingDemoData: sampleMode,\n\t\tattention: exceptions.length > 0,\n\t\texceptionCount: exceptions.length,\n\t\ttotalMetricCount: metrics.length,\n\t\tdeferredFromVideo: metrics.length - selected.length,\n\t\tcaption:\n\t\t\t(sampleMode ? 'SAMPLE DATA - TEST ONLY. ' : '') +\n\t\t\texceptions.length +\n\t\t\t' metrics need review for ' +\n\t\t\tstart +\n\t\t\t' to ' +\n\t\t\tend +\n\t\t\t'. Review the owner action register.',\n\t\thandoff,\n\t};\n}\nreturn [{json:planKpi($('Set reporting period and exception thresholds').first().json,$('Choose the configured metrics input').first().json,$input.all().map(i=>i.json),new Date())}];"},"typeVersion":2},{"id":"late-ready","name":"Eligible source content or saved render exists?","type":"n8n-nodes-base.if","position":[2500,500],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"ready-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.ready === true }}","rightValue":""}]}},"typeVersion":2.2},{"id":"late-no-work","name":"Explain skipped content or recovery needs","type":"n8n-nodes-base.code","position":[2500,850],"parameters":{"jsCode":"return $input.all();"},"typeVersion":2},{"id":"late-resume","name":"Resume the accepted render job?","type":"n8n-nodes-base.if","position":[2980,500],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"resume-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ Boolean($json.jobId) }}","rightValue":""}]}},"typeVersion":2.2},{"id":"late-resume-context","name":"Restore the saved result and handoff context","type":"n8n-nodes-base.code","position":[3260,220],"parameters":{"jsCode":"return $input.all();"},"typeVersion":2},{"id":"zvid-kr-0015","name":"Build the exception-focused KPI briefing","type":"n8n-nodes-base.code","position":[6940,500],"parameters":{"jsCode":"// === buildProject — identical to the frame-reviewed standalone builder ===\n// Turns one week of KPI data (up to five metrics) into a 1920x1080 report\n// video: branded title card, one scene per metric, then a summary grid. Works\n// BOTH with a narrated voiceover (word-timed cuts + karaoke captions) and\n// without one (music only, fixed scene lengths) — `narration` is null on the\n// narrate:false path.\n//\n// THE ONE RULE THIS FILE EXISTS TO ENFORCE: a chart is drawn only from numbers\n// the caller actually sent. A metric with a real `history` array (optional, per\n// the documented contract) gets a sparkline of THOSE values. A metric without\n// one gets NO chart at all — the card becomes a centred number + delta pill.\n// There is no synthetic, decorative or \"illustrative\" trend line anywhere.\nfunction buildProject(config, source, narration) {\n  const cfg = config || {};\n  const clean = (v) => String(v == null ? '' : v).replace(/\\s+/g, ' ').trim();\n  const esc = (s) => String(s).replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n  const round = (n) => Math.round(n * 100) / 100;\n  const clamp = (n, lo, hi) => Math.min(hi, Math.max(lo, n));\n\n  // ---- palette ------------------------------------------------------------\n  const safeHex = (v, fallback) => (/^#[0-9a-fA-F]{6}$/.test(clean(v)) ? clean(v) : fallback);\n  const accent = safeHex(cfg.brandAccent, '#38E1FF');\n  const bg = safeHex(cfg.brandBackground, '#0B1220');\n  const ink = safeHex(cfg.textColor, '#FFFFFF');\n  const muted = safeHex(cfg.mutedColor, '#9DB0CC');\n  const good = safeHex(cfg.goodColor, '#34D399');\n  const bad = safeHex(cfg.badColor, '#FF6B78');\n  const font = clean(cfg.font) || 'Space Grotesk';\n  const hexToRgb = (h) => { const n = parseInt(h.slice(1), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; };\n  const rgba = (h, a) => { const [r, g, b] = hexToRgb(h); return 'rgba(' + r + ',' + g + ',' + b + ',' + a + ')'; };\n  // A slightly lifted card-interior tone derived from the background.\n  const lift = (h, amt) => { const [r, g, b] = hexToRgb(h); const f = (x) => Math.min(255, Math.round(x + amt)); return 'rgb(' + f(r) + ',' + f(g) + ',' + f(b) + ')'; };\n\n  // ---- data ---------------------------------------------------------------\n  const company = clean(source.company) || clean(cfg.brandName) || 'Your company';\n  const period = clean(source.period) || 'This week';\n  const rawMetrics = (Array.isArray(source.metrics) ? source.metrics : []).slice(0, 5);\n  if (!rawMetrics.length) throw new Error('No metrics to render — Prepare metrics produced an empty list.');\n\n  const fmtValue = (m) => {\n    if (typeof m.value === 'string') return clean(m.value);\n    const n = Number(m.value);\n    if (!Number.isFinite(n)) return clean(String(m.value));\n    const s = Math.abs(n) >= 1000 ? n.toLocaleString('en-US') : String(n);\n    const unit = clean(m.unit);\n    if (unit === '$') return '$' + s;\n    if (unit === '%') return s + '%';\n    return unit ? s + ' ' + unit : s;\n  };\n  const fmtDelta = (d) => {\n    const a = Math.round(Math.abs(d) * 10) / 10;\n    return String(a) + '%';\n  };\n\n  const items = rawMetrics.map((m, i) => {\n    const label = clean(m.label) || 'Metric ' + (i + 1);\n    const valueText = fmtValue(m);\n    const deltaNum = m.delta == null || m.delta === '' ? null : Number(m.delta);\n    const hasDelta = deltaNum != null && Number.isFinite(deltaNum);\n    const lowerIsBetter = Boolean(m.lowerIsBetter);\n    const dir = !hasDelta || deltaNum === 0 ? 0 : deltaNum > 0 ? 1 : -1;\n    // churn DOWN is green: goodness respects lowerIsBetter, arrows respect the sign.\n    const improving = dir === 0 ? null : lowerIsBetter ? dir < 0 : dir > 0;\n    const chipColor = dir === 0 || !hasDelta ? muted : improving ? good : bad;\n    const arrow = dir > 0 ? '▲' : dir < 0 ? '▼' : '';\n    const chipText = !hasDelta ? '' : dir === 0 ? 'flat vs last week' : arrow + ' ' + fmtDelta(deltaNum) + ' vs last week';\n    // `history` is OPTIONAL real past values (`series` is accepted as an alias).\n    // Only a genuine array of at least two finite numbers becomes a chart;\n    // anything else means no chart exists, so none is drawn.\n    const raw = Array.isArray(m.history) ? m.history : Array.isArray(m.series) ? m.series : null;\n    const nums = raw ? raw.map(Number).filter((x) => Number.isFinite(x)) : [];\n    const history = raw && nums.length >= 2 && nums.length === raw.length ? nums.slice(-24) : null;\n    return { label, valueText, deltaNum, hasDelta, lowerIsBetter, dir, improving, chipColor, chipText, history };\n  });\n\n  // ---- trend panel --------------------------------------------------------\n  // NOTHING here is invented. Exactly two states:\n  //   * `history` supplied (>= 2 real numbers) -> a sparkline of THOSE numbers,\n  //     labelled with how many periods it covers. Gridlines, area fill and the\n  //     end-point dot are earned here because the shape is real data.\n  //   * no `history` -> NO panel and no divider rule at all, whether or not a\n  //     delta exists. The card switches to the centred number + delta layout\n  //     below. Nothing on screen stands in for history that was not supplied.\n  const PX0 = 1190; const PX1 = 1700; const PYT = 400; const PYB = 720;\n\n  const historySvg = (it) => {\n    const s = it.history;\n    const n = s.length;\n    const lo = Math.min.apply(null, s);\n    const hi = Math.max.apply(null, s);\n    const span = hi - lo;\n    const pts = s.map((v, i) => {\n      const t = i / (n - 1);\n      const norm = span === 0 ? 0.5 : clamp(0.08 + ((v - lo) / span) * 0.84, 0.08, 0.92);\n      return [round(PX0 + t * (PX1 - PX0)), round(PYB - norm * (PYB - PYT))];\n    });\n    const line = pts.map((p) => p[0] + ',' + p[1]).join(' ');\n    const area = line + ' ' + PX1 + ',' + PYB + ' ' + PX0 + ',' + PYB;\n    const last = pts[n - 1];\n    const grid = [PYT, Math.round((PYT + PYB) / 2), PYB]\n      .map((y) => \"<line x1='\" + PX0 + \"' y1='\" + y + \"' x2='\" + PX1 + \"' y2='\" + y + \"' stroke='rgba(255,255,255,0.08)' stroke-width='1.5'/>\")\n      .join('');\n    return grid +\n      \"<polygon points='\" + area + \"' fill='\" + rgba(it.chipColor, 0.12) + \"'/>\" +\n      \"<polyline points='\" + line + \"' fill='none' stroke='\" + it.chipColor + \"' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'/>\" +\n      \"<circle cx='\" + last[0] + \"' cy='\" + last[1] + \"' r='14' fill='\" + rgba(it.chipColor, 0.25) + \"'/>\" +\n      \"<circle cx='\" + last[0] + \"' cy='\" + last[1] + \"' r='7' fill='\" + it.chipColor + \"'/>\";\n  };\n\n  const hasPanel = (it) => Boolean(it.history);\n  const panelSvg = (it) => \"<svg width='1920' height='1080' viewBox='0 0 1920 1080' xmlns='http://www.w3.org/2000/svg'>\" + historySvg(it) + '</svg>';\n  const panelLabel = (it) => 'TREND &middot; LAST ' + it.history.length + ' PERIODS';\n\n  // ---- narration timing ---------------------------------------------------\n  const narrated = Boolean(narration && narration.parsed && narration.timings && narration.voUrl);\n  const tailSeconds = Number(cfg.tailSeconds ?? 0.6);\n  const transition = clean(cfg.sceneTransition) || null;\n  const tDur = transition ? Number(cfg.transitionSeconds ?? 0.45) : 0;\n\n  let spans = null;            // visible [start,end] per scene: title, metrics..., summary\n  let words = [];\n  let cutsAlignedToSpeech = false;\n  let audioDuration = 0;\n\n  if (narrated) {\n    words = (Array.isArray(narration.timings.words) ? narration.timings.words : [])\n      .map((w) => ({ text: String(w.text == null ? '' : w.text).trim(), start: Number(w.start), end: Number(w.end) }))\n      .filter((w) => w.text && Number.isFinite(w.start) && Number.isFinite(w.end));\n    const narrationEnd = words.length ? words[words.length - 1].end : Number(narration.timings.duration) || 30;\n    audioDuration = Math.max(Number(narration.timings.duration) || 0, narrationEnd);\n\n    const countWords = (s) =>\n      String(s || '').replace(/[^\\p{L}\\p{N}'\\u2019]+/gu, ' ').trim().split(/\\s+/).filter(Boolean).length;\n    const segments = [narration.parsed.opening].concat(narration.parsed.perMetric, [narration.parsed.closing]);\n    const segWords = segments.map(countWords);\n    const totalScripted = segWords.reduce((a, b) => a + b, 0);\n\n    // The alignment covers the exact text that was spoken, so walking the word\n    // stream by per-segment word count puts every cut on a sentence boundary.\n    // If the tokenisation drifts, fall back to a proportional split so the\n    // render can never desync.\n    const drift = totalScripted ? Math.abs(words.length - totalScripted) / totalScripted : 1;\n    cutsAlignedToSpeech = words.length > 0 && drift <= 0.2;\n\n    spans = [];\n    if (cutsAlignedToSpeech) {\n      let cursor = 0;\n      for (let i = 0; i < segWords.length; i += 1) {\n        const start = cursor === 0 ? 0 : words[cursor - 1].end;\n        cursor = Math.min(cursor + segWords[i], words.length);\n        const last = words[cursor - 1];\n        spans.push({ start, end: i === segWords.length - 1 ? audioDuration : last ? last.end : audioDuration });\n      }\n    } else {\n      const weightTotal = totalScripted || segWords.length;\n      let t = 0;\n      for (let i = 0; i < segWords.length; i += 1) {\n        const start = t;\n        t = i === segWords.length - 1 ? audioDuration : t + ((segWords[i] || 1) / weightTotal) * audioDuration;\n        spans.push({ start, end: t });\n      }\n    }\n    spans[spans.length - 1].end += tailSeconds;\n  } else {\n    // Music-only pacing: the on-screen numbers carry the video.\n    let t = 0;\n    spans = [];\n    const fixed = [4.2].concat(items.map(() => 3.6), [5.4]);\n    for (const d of fixed) { spans.push({ start: t, end: t + d }); t += d; }\n  }\n\n  const sceneCount = items.length + 2;\n  const minScene = Math.max(1.4, tDur * 3);\n  const visibleFor = (i) => Math.max(minScene, round(spans[i].end - spans[i].start));\n\n  // ---- shared scene chrome ------------------------------------------------\n  const frameStroke = rgba(accent, 0.28);\n  const metaLine = esc(company.toUpperCase()) + ' &middot; ' + esc(period.toUpperCase());\n\n  const scenes = [];\n  const transitionFor = (i) => (i === sceneCount - 2 ? 'smoothup' : transition);\n\n  // ---- scene 1: title card ------------------------------------------------\n  {\n    const i = 0;\n    const visible = visibleFor(i);\n    const dur = round(visible + (sceneCount > 1 ? tDur : 0));\n    const kicker = clean(cfg.reportKicker) || 'WEEKLY KPI REPORT';\n    const title = clean(cfg.reportTitle) || 'The week in numbers.';\n    const titleSize = title.length <= 26 ? 112 : title.length <= 40 ? 88 : 68;\n    const heroVideo = clean(cfg.titleVideoUrl);\n    const visuals = [];\n    if (heroVideo) {\n      visuals.push({ type: 'VIDEO', src: heroVideo, width: 1920, height: 1080, position: 'center-center', resize: 'cover', volume: 0, zoom: { depth: 1.06 }, track: 0, enterBegin: 0, exitEnd: dur });\n    }\n    visuals.push({\n      type: 'SVG', width: 1920, height: 1080, track: 1, enterBegin: 0, exitEnd: dur,\n      svg: \"<svg width='1920' height='1080' viewBox='0 0 1920 1080' xmlns='http://www.w3.org/2000/svg'><defs><linearGradient id='krIntro' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='\" + bg + \"' stop-opacity='0.97'/><stop offset='0.55' stop-color='\" + bg + \"' stop-opacity='0.78'/><stop offset='1' stop-color='\" + bg + \"' stop-opacity='0.4'/></linearGradient></defs><rect width='1920' height='1080' fill='url(#krIntro)'/><rect x='110' y='150' width='1700' height='780' rx='34' fill='none' stroke='\" + rgba(accent, 0.18) + \"' stroke-width='1.5'/><path d='M130 700 H370' stroke='\" + accent + \"' stroke-width='6' stroke-linecap='round'/></svg>\",\n    });\n    visuals.push({\n      type: 'TEXT', x: 130, y: 250, width: 1250, anchor: 'top-left', track: 2, enterBegin: 0.25, enterEnd: 0.75, enterAnimation: 'smoothup', exitEnd: dur,\n      style: { fontFamily: font, color: ink },\n      html: \"<div style='color:\" + accent + \"; font-size:27px; font-weight:700; letter-spacing:7px;'>\" + esc(kicker) + \"</div><div style='margin-top:26px; color:\" + ink + \"; font-size:\" + titleSize + \"px; line-height:1.02; font-weight:700; letter-spacing:-3px;'>\" + esc(title) + '</div>',\n    });\n    visuals.push({\n      type: 'TEXT', x: 130, y: 770, anchor: 'top-left', track: 3, enterBegin: 0.6, enterEnd: 1.1, enterAnimation: 'fade', exitEnd: dur,\n      style: { fontFamily: font, color: ink },\n      html: \"<div style='color:\" + ink + \"; font-size:31px; font-weight:700; letter-spacing:2px;'>\" + esc(company) + \"<span style='color:\" + rgba(muted, 0.85) + \"; font-weight:500;'>&nbsp;&nbsp;&middot;&nbsp;&nbsp;\" + esc(period) + '</span></div>',\n    });\n    scenes.push({\n      id: 'title', duration: dur, backgroundColor: bg,\n      ...(transitionFor(0) ? { transition: transitionFor(0), transitionDuration: tDur } : {}),\n      visuals,\n    });\n  }\n\n  // ---- one scene per metric ----------------------------------------------\n  items.forEach((it, idx) => {\n    const i = idx + 1;\n    const visible = visibleFor(i);\n    const isLast = i === sceneCount - 1; // never true here (summary follows)\n    const dur = round(visible + (isLast ? 0 : tDur));\n    const vLen = it.valueText.length;\n    const valueSize = vLen <= 6 ? 184 : vLen <= 8 ? 158 : vLen <= 10 ? 134 : vLen <= 13 ? 110 : 88;\n    const panel = hasPanel(it);\n    const align = panel ? 'left' : 'center';\n    const chipHtml = it.hasDelta\n      ? \"<div style='margin-top:32px; text-align:\" + align + \";'><span style='display:inline-block; background:\" + rgba(it.chipColor, 0.13) + '; border:1.5px solid ' + rgba(it.chipColor, 0.5) + '; color:' + it.chipColor + \"; border-radius:999px; padding:12px 30px; font-size:29px; font-weight:700;'>\" + esc(it.chipText) + '</span></div>'\n      : '';\n    const hintHtml = it.lowerIsBetter && it.hasDelta\n      ? \"<div style='margin-top:22px; text-align:\" + align + '; color:' + rgba(muted, 0.8) + \"; font-size:24px; font-weight:500;'>Lower is better for this one.</div>\"\n      : '';\n    // No history -> no chart. The card becomes ONE centred column (accent rule,\n    // label, number, delta pill) optically centred in the card frame (150..930)\n    // rather than a left column staring at the empty half where a chart would\n    // have gone. Heights below are the type metrics of the block above.\n    const ruleHtml = panel ? '' : \"<div style='width:120px; height:5px; border-radius:3px; background:\" + accent + \"; margin:0 auto 34px;'></div>\";\n    const blockH = 38 + 22 + Math.round(valueSize * 1.02) + (it.hasDelta ? 96 : 0) + (hintHtml ? 52 : 0) + (panel ? 0 : 39);\n    const blockY = panel ? 330 : clamp(Math.round(540 - blockH / 2), 250, 470);\n    const visuals = [\n      {\n        type: 'SVG', width: 1920, height: 1080, track: 0, enterBegin: 0, exitEnd: dur,\n        svg: \"<svg width='1920' height='1080' viewBox='0 0 1920 1080' xmlns='http://www.w3.org/2000/svg'><defs><radialGradient id='krCard\" + idx + \"' cx='0.3' cy='0.35' r='0.95'><stop offset='0' stop-color='\" + lift(bg, 14) + \"'/><stop offset='1' stop-color='\" + bg + \"'/></radialGradient></defs><rect width='1920' height='1080' fill='url(#krCard\" + idx + \")'/><rect x='120' y='150' width='1680' height='780' rx='40' fill='rgba(255,255,255,0.028)' stroke='\" + frameStroke + \"' stroke-width='1.5'/>\" +\n          (panel ? \"<line x1='1120' y1='250' x2='1120' y2='830' stroke='rgba(255,255,255,0.08)' stroke-width='1.5'/>\" : '') + '</svg>',\n      },\n      {\n        type: 'TEXT', x: 210, y: 208, anchor: 'top-left', track: 2, enterBegin: 0, exitEnd: dur,\n        style: { fontFamily: font, color: ink },\n        html: \"<div style='color:\" + rgba(muted, 0.75) + \"; font-size:22px; font-weight:700; letter-spacing:4px;'>\" + metaLine + '</div>',\n      },\n      {\n        type: 'TEXT', x: 1710, y: 208, anchor: 'top-right', track: 3, enterBegin: 0, exitEnd: dur,\n        style: { fontFamily: font, color: ink },\n        html: \"<div style='color:\" + rgba(muted, 0.6) + \"; font-size:22px; font-weight:700; letter-spacing:4px; text-align:right;'>0\" + (idx + 1) + ' / 0' + items.length + '</div>',\n      },\n      {\n        type: 'TEXT',\n        x: panel ? 210 : 960, y: blockY, width: panel ? 860 : 1500,\n        anchor: panel ? 'top-left' : 'top-center',\n        track: 4, enterBegin: 0.25, enterEnd: 0.7, enterAnimation: 'smoothup', exitEnd: dur,\n        style: { fontFamily: font, color: ink },\n        html: ruleHtml + \"<div style='text-align:\" + align + '; color:' + rgba(muted, 0.95) + \"; font-size:30px; font-weight:700; letter-spacing:5px;'>\" + esc(it.label.toUpperCase()) + \"</div><div style='text-align:\" + align + '; margin-top:22px; color:' + ink + '; font-size:' + valueSize + \"px; line-height:0.95; font-weight:700; letter-spacing:-5px;'>\" + esc(it.valueText) + '</div>' + chipHtml + hintHtml,\n      },\n    ];\n    if (panel) {\n      visuals.push({\n        type: 'SVG', width: 1920, height: 1080, track: 1, enterBegin: 0.45, enterEnd: 0.95, enterAnimation: 'fade', exitEnd: dur,\n        svg: panelSvg(it),\n      });\n      visuals.push({\n        type: 'TEXT', x: PX0, y: 334, anchor: 'top-left', track: 5, enterBegin: 0.45, enterEnd: 0.95, enterAnimation: 'fade', exitEnd: dur,\n        style: { fontFamily: font, color: ink },\n        html: \"<div style='color:\" + rgba(muted, 0.65) + \"; font-size:22px; font-weight:700; letter-spacing:4px;'>\" + panelLabel(it) + '</div>',\n      });\n    }\n    scenes.push({\n      id: 'metric-' + (idx + 1), duration: dur, backgroundColor: bg,\n      ...(transitionFor(i) ? { transition: transitionFor(i), transitionDuration: tDur } : {}),\n      visuals,\n    });\n  });\n\n  // ---- summary grid -------------------------------------------------------\n  let narratedClosingUsed = false;\n  {\n    const i = sceneCount - 1;\n    const visible = visibleFor(i);\n    const dur = round(visible); // last scene: no transition pad\n    const n = items.length;\n    const cardW = 520; const cardH = 240;\n    let slots;\n    // Every row is centred on 960: 3-up spans 120..1800, 2-up spans 410..1510.\n    if (n === 5) slots = [[120, 310], [700, 310], [1280, 310], [410, 590], [990, 590]];\n    else if (n === 4) slots = [[410, 310], [990, 310], [410, 590], [990, 590]];\n    else if (n === 3) slots = [[120, 400], [700, 400], [1280, 400]];\n    else if (n === 2) slots = [[410, 400], [990, 400]];\n    else slots = [[700, 400]];\n    const gridBottom = slots.reduce((m, s) => Math.max(m, s[1] + cardH), 0);\n\n    const cardsSvg = slots.map((s) =>\n      \"<rect x='\" + s[0] + \"' y='\" + s[1] + \"' width='\" + cardW + \"' height='\" + cardH + \"' rx='26' fill='rgba(255,255,255,0.03)' stroke='\" + frameStroke + \"' stroke-width='1.5'/><rect x='\" + s[0] + \"' y='\" + s[1] + \"' width='\" + cardW + \"' height='5' rx='2.5' fill='\" + accent + \"'/>\").join('');\n\n    const visuals = [\n      {\n        type: 'SVG', width: 1920, height: 1080, track: 0, enterBegin: 0, exitEnd: dur,\n        svg: \"<svg width='1920' height='1080' viewBox='0 0 1920 1080' xmlns='http://www.w3.org/2000/svg'><defs><radialGradient id='krSum' cx='0.5' cy='0.25' r='1'><stop offset='0' stop-color='\" + lift(bg, 12) + \"'/><stop offset='1' stop-color='\" + bg + \"'/></radialGradient></defs><rect width='1920' height='1080' fill='url(#krSum)'/>\" + cardsSvg + '</svg>',\n      },\n      {\n        type: 'TEXT', x: 960, y: 170, anchor: 'top-center', track: 1, enterBegin: 0.2, enterEnd: 0.6, enterAnimation: 'smoothdown', exitEnd: dur,\n        style: { fontFamily: font, color: ink },\n        html: \"<div style='text-align:center; color:\" + rgba(muted, 0.9) + \"; font-size:26px; font-weight:700; letter-spacing:6px;'>THE WEEK AT A GLANCE &middot; \" + esc(period.toUpperCase()) + '</div>',\n      },\n    ];\n\n    items.forEach((it, idx) => {\n      const s = slots[idx];\n      const vLen = it.valueText.length;\n      const vSize = vLen <= 7 ? 64 : vLen <= 10 ? 54 : vLen <= 13 ? 46 : 38;\n      const chip = it.hasDelta\n        ? \"<div style='margin-top:16px; color:\" + it.chipColor + \"; font-size:24px; font-weight:700;'>\" + (it.dir === 0 ? 'flat' : (it.dir > 0 ? '▲ ' : '▼ ') + fmtDelta(it.deltaNum)) + '</div>'\n        : '';\n      visuals.push({\n        type: 'TEXT', x: s[0] + 40, y: s[1] + 44, width: cardW - 80, anchor: 'top-left', track: 2 + idx,\n        enterBegin: round(0.35 + idx * 0.12), enterEnd: round(0.75 + idx * 0.12), enterAnimation: 'smoothup', exitEnd: dur,\n        style: { fontFamily: font, color: ink },\n        html: \"<div style='color:\" + rgba(muted, 0.85) + \"; font-size:20px; font-weight:700; letter-spacing:2px;'>\" + esc(it.label.toUpperCase()) + \"</div><div style='margin-top:14px; color:\" + ink + '; font-size:' + vSize + \"px; line-height:1; font-weight:700; letter-spacing:-2px;'>\" + esc(it.valueText) + '</div>' + chip,\n      });\n    });\n\n    // The analyst's actual take closes the video: on a narrated run this is the\n    // LLM's own `closing` sentence (the one the voice-over just spoke), so the\n    // last frame agrees with the audio instead of a fixed boilerplate line.\n    // Without narration there is no closing to use — Config.summaryLine carries it.\n    const narratedClosing = narrated && narration.parsed ? clean(narration.parsed.closing) : '';\n    narratedClosingUsed = Boolean(narratedClosing);\n    const summaryLine = narratedClosing || clean(cfg.summaryLine) || 'Full breakdown in the dashboard.';\n    const sSize = summaryLine.length <= 70 ? 30 : summaryLine.length <= 110 ? 26 : 23;\n    visuals.push({\n      type: 'TEXT', x: 960, y: Math.max(gridBottom + 40, 690), width: 1400, anchor: 'top-center', track: 7, enterBegin: 0.9, enterEnd: 1.3, enterAnimation: 'fade', exitEnd: dur,\n      style: { fontFamily: font, color: ink },\n      html: \"<div style='text-align:center; color:\" + rgba(muted, 0.95) + '; font-size:' + sSize + \"px; line-height:1.4; font-weight:500;'>\" + esc(summaryLine) + \"</div><div style='margin-top:20px; text-align:center; color:\" + rgba(muted, 0.55) + \"; font-size:22px; font-weight:700; letter-spacing:4px;'>\" + metaLine + '</div>',\n    });\n\n    scenes.push({ id: 'summary', duration: dur, backgroundColor: bg, visuals });\n  }\n\n  const totalDuration = round(scenes.reduce((sum, s) => sum + s.duration, 0) - tDur * Math.max(0, scenes.length - 1));\n\n  // ---- captions (narrated runs only) --------------------------------------\n  let subtitle;\n  let captionCount = 0;\n  if (narrated && words.length) {\n    const perCue = Math.max(1, Number(cfg.captionWordsPerCue ?? 4));\n    const captions = [];\n    for (let w = 0; w < words.length; w += perCue) {\n      const chunk = words.slice(w, w + perCue);\n      captions.push({\n        start: chunk[0].start,\n        end: chunk[chunk.length - 1].end,\n        text: chunk.map((x) => x.text).join(' '),\n        words: chunk.map((x) => ({ start: x.start, end: x.end, text: x.text })),\n      });\n    }\n    captionCount = captions.length;\n    subtitle = {\n      captions,\n      animation: clean(cfg.captionAnimation) || 'karaoke',\n      activeWord: { color: accent },\n      font: { family: font, size: Number(cfg.captionSize ?? 40), color: '#FFFFFF', bold: true },\n      stroke: { color: '#000000', width: Math.max(0, Number(cfg.captionStrokeWidth ?? 6)) },\n      position: 'bottom',\n      margin: { x: 260, y: 48 },\n      maxWordsPerLine: perCue,\n    };\n  }\n\n  // ---- audio --------------------------------------------------------------\n  // NOTE: no `track` on audios — the render API rejects audios[].track.\n  const audios = [];\n  if (narrated) audios.push({ src: narration.voUrl, volume: 1 });\n  const music = source.music && source.music.src ? source.music : null;\n  if (music) audios.push({ src: music.src, volume: Number(narrated ? cfg.musicVolume ?? 0.12 : cfg.musicVolumeSolo ?? 0.26) });\n\n  // The render API only allows letters, digits, spaces, _ and - in `name`.\n  const safeName = ('kpi-report-' + company + '-' + period).toLowerCase().normalize('NFKD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);\n\n  const payload = {\n    name: safeName || 'kpi-report',\n    resolution: clean(cfg.resolution) || 'full-hd',\n    frameRate: Number(cfg.frameRate ?? 30),\n    backgroundColor: bg,\n    outputFormat: 'mp4',\n    scenes,\n    ...(audios.length ? { audios } : {}),\n    ...(subtitle ? { subtitle } : {}),\n  };\n\n  return {\n    payload,\n    meta: {\n      company,\n      period,\n      metricCount: items.length,\n      usingDemoData: Boolean(source.usingDemoData),\n      narrated,\n      narrationSeconds: narrated ? round(audioDuration) : 0,\n      totalDuration,\n      sceneCount: scenes.length,\n      sceneDurations: scenes.map((s) => s.duration),\n      captionCount,\n      cutsAlignedToSpeech,\n      musicUrl: music ? music.src : null,\n      summaryLineSource: narratedClosingUsed ? 'narration closing' : 'Config.summaryLine',\n      metrics: items.map((it) => ({\n        label: it.label,\n        value: it.valueText,\n        chip: it.chipText || null,\n        improving: it.improving,\n        trendPanel: it.history ? 'sparkline of ' + it.history.length + ' real history points' : 'none (no history supplied)',\n      })),\n    },\n  };\n}\n// === late-series glue ===\nconst plan=$json;\nconst config={...$('Set reporting period and exception thresholds').first().json,summaryLine:plan.caption,titleVideoUrl:'',...(plan.usingDemoData?{reportKicker:'SAMPLE DATA - TEST ONLY',reportTitle:'Example KPI briefing'}:{})};\nconst built=buildProject(config,{...plan,music:plan.musicOk?{src:config.musicUrl}:null},plan.narrationData||null);\nreturn [{json:{...plan,...built}}];"},"typeVersion":2},{"id":"late-narrate","name":"Create optional narration from checked metrics?","type":"n8n-nodes-base.if","position":[5060,500],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"narrate-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $('Set reporting period and exception thresholds').first().json.narrate === true }}","rightValue":""}]}},"typeVersion":2.2},{"id":"late-narration","name":"Write factual KPI narration from the checked values","type":"n8n-nodes-base.code","position":[5340,500],"parameters":{"jsCode":"const d=$json;const opening=d.company+' report for '+d.period+'.';const perMetric=d.metrics.map(m=>m.label+' is '+m.value+' '+m.unit+'. '+m.baseline+(m.targetMiss?' Target not met.':'')+(m.attention?' Review required.':''));const closing=d.caption;const narration=[opening,...perMetric,closing].join(' ');return [{json:{opening,perMetric,closing,narration,wordCount:narration.split(/\\s+/).length}}];"},"typeVersion":2},{"id":"zvid-kr-0012","name":"Generate voiceover","type":"n8n-nodes-base.httpRequest","maxTries":3,"position":[5620,500],"parameters":{"url":"=https://api.elevenlabs.io/v1/text-to-speech/{{ $('Set reporting period and exception thresholds').first().json.voiceId }}/with-timestamps","method":"POST","options":{"timeout":120000},"jsonBody":"={{ JSON.stringify({ text: $('Write factual KPI narration from the checked values').first().json.narration, model_id: $('Set reporting period and exception thresholds').first().json.elevenModel, voice_settings: { stability: $('Set reporting period and exception thresholds').first().json.voiceStability, similarity_boost: $('Set reporting period and exception thresholds').first().json.voiceSimilarity } }) }}","sendBody":true,"sendQuery":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","queryParameters":{"parameters":[{"name":"output_format","value":"mp3_44100_128"}]}},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"id":"zvid-kr-0013","name":"Voice + timings","type":"n8n-nodes-base.code","position":[5900,500],"parameters":{"jsCode":"// Turns one ElevenLabs \"with-timestamps\" response into (a) an mp3 binary ready\n// for upload and (b) word timings.\n//\n// The alignment comes from the synthesiser itself, so the timings ARE the audio\n// — there is no separate transcription step to disagree with, and nothing that\n// can drift. That is the whole reason this endpoint is used instead of plain\n// text-to-speech.\nconst res = $input.first().json;\n\nif (!res || !res.audio_base64) {\n  throw new Error(\n    'ElevenLabs returned no audio. Check the xi-api-key credential, the voiceId, and your character quota. Response: ' +\n      JSON.stringify(res).slice(0, 300)\n  );\n}\n\nconst a = res.alignment || res.normalized_alignment;\nif (!a || !Array.isArray(a.characters)) {\n  throw new Error('ElevenLabs returned audio but no alignment — make sure the URL ends in /with-timestamps.');\n}\n\nconst chars = a.characters;\nconst starts = a.character_start_times_seconds || [];\nconst ends = a.character_end_times_seconds || [];\n\n// Alignment is per CHARACTER; group runs of non-whitespace into words.\nconst words = [];\nlet cur = null;\nfor (let i = 0; i < chars.length; i += 1) {\n  const ch = chars[i];\n  if (/\\s/.test(ch)) {\n    if (cur) { words.push(cur); cur = null; }\n    continue;\n  }\n  if (!cur) cur = { text: ch, start: Number(starts[i]), end: Number(ends[i]) };\n  else { cur.text += ch; cur.end = Number(ends[i]); }\n}\nif (cur) words.push(cur);\n\nif (!words.length) throw new Error('Alignment contained no words.');\n\nconst duration = Number(ends[ends.length - 1]) || words[words.length - 1].end;\n\nreturn [{\n  json: { words, duration, wordCount: words.length },\n  // n8n binary payloads carry base64 in `data`; naming it matters because Zvid\n  // derives the media kind from the MIME type on upload.\n  binary: {\n    data: {\n      data: res.audio_base64,\n      mimeType: 'audio/mpeg',\n      fileName: 'voiceover.mp3',\n      fileExtension: 'mp3',\n    },\n  },\n}];"},"typeVersion":2},{"id":"zvid-kr-0014","name":"Upload voiceover","type":"n8n-nodes-base.httpRequest","notes":"File upload exception: the published Zvid node does not expose multipart uploads. The upload step uses HTTP Request → `POST /api/uploads`, authenticated with the same **Zvid API** credential. All supported Zvid operations use the Zvid node.","maxTries":3,"position":[6180,500],"parameters":{"url":"={{ $('Set reporting period and exception thresholds').first().json.apiUrl }}/api/uploads","method":"POST","options":{},"sendBody":true,"contentType":"multipart-form-data","authentication":"predefinedCredentialType","bodyParameters":{"parameters":[{"name":"file","parameterType":"formBinaryData","inputDataFieldName":"data"}]},"nodeCredentialType":"zvidApi"},"notesInFlow":true,"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"id":"late-narration-context","name":"Restore the checked KPI plan with its narration","type":"n8n-nodes-base.code","position":[6460,500],"parameters":{"jsCode":"const plan=$('Prepare the selected source for design').first().json;const upload=$('Upload voiceover').first().json.upload;if(!upload?.url)throw Error('Voiceover upload returned no URL');return [{json:{...plan,narrationData:{parsed:$('Write factual KPI narration from the checked values').first().json,timings:$('Voice + timings').first().json,voUrl:upload.url}}}];"},"typeVersion":2},{"id":"late-music","name":"A background music URL is configured?","type":"n8n-nodes-base.if","position":[3740,500],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"music-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ Boolean($('Set reporting period and exception thresholds').first().json.musicUrl) }}","rightValue":""}]}},"typeVersion":2.2},{"id":"late-music-probe","name":"Check the optional music file size and availability","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[4020,500],"parameters":{"url":"={{ $('Set reporting period and exception thresholds').first().json.musicUrl }}","method":"HEAD","options":{"timeout":8000,"response":{"response":{"neverError":true,"fullResponse":true}}}},"typeVersion":4.2,"alwaysOutputData":true},{"id":"late-music-restore","name":"Keep the source plan and usable music only","type":"n8n-nodes-base.code","position":[4300,500],"parameters":{"jsCode":"const plan=$('Calculate KPI changes target misses and owners').first().json,cfg=$('Set reporting period and exception thresholds').first().json,probe=$json;const bytes=Number(probe.headers?.['content-length']||0);const musicOk=Number(probe.statusCode)===200&&Number.isFinite(bytes)&&bytes>=0&&bytes<=Number(cfg.maxMusicBytes||5242880);return [{json:{...plan,musicOk,musicProbe:probe}}];"},"typeVersion":2},{"id":"late-design-context","name":"Prepare the selected source for design","type":"n8n-nodes-base.code","position":[4580,500],"parameters":{"jsCode":"return $input.all();"},"typeVersion":2},{"id":"late-validate","name":"Validate the video and request its credit quote","type":"@zvid/n8n-nodes-zvid.zvid","position":[7220,500],"parameters":{"source":"json","resource":"render","operation":"validate","projectJson":"={{ JSON.stringify($json.payload) }}"},"typeVersion":1},{"id":"late-quote","name":"Enforce the per-video credit ceiling","type":"n8n-nodes-base.code","position":[7500,500],"parameters":{"jsCode":"function checkQuote(cfg, build, response) {\n  const body = response.body || response;\n  if (body.valid !== true) throw new Error('Zvid validation failed: '+JSON.stringify(body.errors || body.details || body).slice(0,1200));\n  const credits = Number(body.creditsRequired), ceiling = Number(cfg.maxCreditsPerVideo);\n  if (!Number.isFinite(credits) || credits < 0) throw new Error('Zvid did not return a valid credit quote.');\n  if (!Number.isFinite(ceiling) || ceiling <= 0) throw new Error('Set maxCreditsPerVideo to a positive number.');\n  if (credits > ceiling) throw new Error('Video needs '+credits+' credits; maxCreditsPerVideo is '+ceiling+'. No paid render submitted for this item.');\n  return {...build,creditsRequired:credits,warnings:body.warnings || []};\n}\nconst d=checkQuote($('Set reporting period and exception thresholds').first().json,$('Build the exception-focused KPI briefing').first().json,$json);const {payload,forecast,weather,narrationData,musicProbe,...snapshot}=d;d.checkpoint={...snapshot,snapshotVersion:1};if(JSON.stringify(d.checkpoint).length>45000)throw Error('Recovery snapshot exceeds the sheet cell limit. No render submitted.');return [{json:d}];"},"typeVersion":2},{"id":"late-preview","name":"Return a validation-only preview?","type":"n8n-nodes-base.if","position":[7780,500],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"preview-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $('Set reporting period and exception thresholds').first().json.dryRun === true }}","rightValue":""}]}},"typeVersion":2.2},{"id":"late-preview-report","name":"Return the source plan design quote and handoff","type":"n8n-nodes-base.code","position":[7780,850],"parameters":{"jsCode":"return [{json:{...$json,status:'preview',dryRun:true,videoUrl:null,note:'No log writes, editor draft, render or delivery.'}}];"},"typeVersion":2},{"id":"late-claim","name":"Reserve this render key before spending credits","type":"n8n-nodes-base.googleSheets","position":[8260,500],"parameters":{"columns":{"value":{"JobId":"","Status":"submitting","PlanJson":"={{ JSON.stringify($('Enforce the per-video credit ceiling').first().json.checkpoint) }}","VideoUrl":"","RenderKey":"={{ $('Enforce the per-video credit ceiling').first().json.renderKey }}","CompletedAt":"","CreditsQuoted":"={{ $('Enforce the per-video credit ceiling').first().json.creditsRequired }}"},"schema":[{"id":"RenderKey","type":"string","display":true,"removed":false,"required":false,"displayName":"RenderKey","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Status","type":"string","display":true,"removed":false,"required":false,"displayName":"Status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"JobId","type":"string","display":true,"removed":false,"required":false,"displayName":"JobId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"VideoUrl","type":"string","display":true,"removed":false,"required":false,"displayName":"VideoUrl","defaultMatch":false,"canBeUsedToMatch":true},{"id":"CreditsQuoted","type":"string","display":true,"removed":false,"required":false,"displayName":"CreditsQuoted","defaultMatch":false,"canBeUsedToMatch":true},{"id":"PlanJson","type":"string","display":true,"removed":false,"required":false,"displayName":"PlanJson","defaultMatch":false,"canBeUsedToMatch":true},{"id":"CompletedAt","type":"string","display":true,"removed":false,"required":false,"displayName":"CompletedAt","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["RenderKey"]},"options":{"cellFormat":"RAW"},"resource":"sheet","operation":"appendOrUpdate","sheetName":{"__rl":true,"mode":"name","value":"KPI Reports"},"documentId":{"__rl":true,"mode":"id","value":""}},"typeVersion":4.7},{"id":"late-attempt","name":"Prepare a bounded render submission attempt","type":"n8n-nodes-base.code","position":[8540,500],"parameters":{"jsCode":"const prior=$json;const checkpoint=$('Enforce the per-video credit ceiling').first().json.checkpoint;return [{json:{...checkpoint,checkpoint,submitStartedAt:prior.submitStartedAt||Date.now(),submitAttempts:Number(prior.submitAttempts||0)+1}}];"},"typeVersion":2},{"id":"late-submit","name":"Submit this approved video to Zvid","type":"@zvid/n8n-nodes-zvid.zvid","onError":"continueErrorOutput","position":[8820,500],"parameters":{"source":"json","resource":"render","operation":"create","renderType":"video","projectJson":"={{ JSON.stringify($('Enforce the per-video credit ceiling').first().json.payload) }}","waitForCompletion":false},"retryOnFail":false,"typeVersion":1},{"id":"late-rejection","name":"Distinguish a capacity rejection from an uncertain submission","type":"n8n-nodes-base.code","position":[8820,850],"parameters":{"jsCode":"function classifySubmissionError(context, error, now, cfg) {\n\tconst status = Number(\n\t\terror.httpCode ||\n\t\t\terror.statusCode ||\n\t\t\terror.status ||\n\t\t\terror.response?.status ||\n\t\t\terror.cause?.statusCode ||\n\t\t\terror.cause?.response?.status,\n\t);\n\tconst rejected =\n\t\tstatus === 429 ||\n\t\t(!status &&\n\t\t\terror.name === 'NodeApiError' &&\n\t\t\terror.message === 'The service is receiving too many requests from you');\n\tlet body =\n\t\terror.response?.data ||\n\t\terror.context?.data ||\n\t\terror.cause?.response?.data ||\n\t\terror.cause?.error ||\n\t\t{};\n\tif (typeof body === 'string') {\n\t\ttry {\n\t\t\tbody = JSON.parse(body);\n\t\t} catch {\n\t\t\tbody = {};\n\t\t}\n\t}\n\tconst headers = error.response?.headers || error.cause?.response?.headers || {};\n\tconst raw = headers['retry-after'] ?? body.retryAfter;\n\tconst retrySeconds = Math.max(30, Number(raw) || Math.ceil((Date.parse(raw) - now) / 1000) || 30);\n\tconst deadline = context.submitStartedAt + Number(cfg.timeoutMinutes || 20) * 60000;\n\tconst retry = rejected && context.submitAttempts < 3 && now + retrySeconds * 1000 < deadline;\n\tconst reason = rejected\n\t\t? 'Zvid render capacity is full (HTTP 429); no job was accepted. ' +\n\t\t\t(retry\n\t\t\t\t? 'Retrying after ' + retrySeconds + ' seconds.'\n\t\t\t\t: 'Retry this workflow later; the rejected key is safe to reuse.')\n\t\t: 'Render submission outcome is uncertain. Inspect https://app.zvid.io before retrying: ' +\n\t\t\tString(error.description || error.message || error);\n\treturn {\n\t\t...context,\n\t\tstatus: rejected ? 'rate_limited' : 'needs_review',\n\t\treason,\n\t\tretry,\n\t\tretrySeconds,\n\t\tvideoUrl: null,\n\t\tcheckpoint: {\n\t\t\t...context.checkpoint,\n\t\t\tsubmission: {\n\t\t\t\tstatus: rejected ? 'rate_limited' : 'needs_review',\n\t\t\t\treason,\n\t\t\t\tattemptedAt: new Date(now).toISOString(),\n\t\t\t},\n\t\t},\n\t};\n}\nconst item=$input.first();return [{json:classifySubmissionError($('Prepare a bounded render submission attempt').first().json,item.error||item.json.error||{},Date.now(),$('Set reporting period and exception thresholds').first().json)}];"},"typeVersion":2},{"id":"late-save-rejection","name":"Record the rejected or uncertain submission","type":"n8n-nodes-base.googleSheets","position":[9100,850],"parameters":{"columns":{"value":{"JobId":"","Status":"={{ $('Distinguish a capacity rejection from an uncertain submission').first().json.status }}","PlanJson":"={{ JSON.stringify($('Distinguish a capacity rejection from an uncertain submission').first().json.checkpoint) }}","VideoUrl":"","RenderKey":"={{ $('Distinguish a capacity rejection from an uncertain submission').first().json.renderKey }}"},"schema":[{"id":"RenderKey","type":"string","display":true,"removed":false,"required":false,"displayName":"RenderKey","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Status","type":"string","display":true,"removed":false,"required":false,"displayName":"Status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"JobId","type":"string","display":true,"removed":false,"required":false,"displayName":"JobId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"VideoUrl","type":"string","display":true,"removed":false,"required":false,"displayName":"VideoUrl","defaultMatch":false,"canBeUsedToMatch":true},{"id":"PlanJson","type":"string","display":true,"removed":false,"required":false,"displayName":"PlanJson","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["RenderKey"]},"options":{"cellFormat":"RAW"},"resource":"sheet","operation":"update","sheetName":{"__rl":true,"mode":"name","value":"KPI Reports"},"documentId":{"__rl":true,"mode":"id","value":""}},"typeVersion":4.7},{"id":"late-rejection-context","name":"Restore the submission rejection and retry timing","type":"n8n-nodes-base.code","position":[9380,850],"parameters":{"jsCode":"return [{json:$('Distinguish a capacity rejection from an uncertain submission').first().json}];"},"typeVersion":2},{"id":"late-retry-capacity","name":"Retry this explicit capacity rejection?","type":"n8n-nodes-base.if","position":[9660,850],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"retry-capacity-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.retry === true }}","rightValue":""}]}},"typeVersion":2.2},{"id":"late-capacity-wait","name":"Wait before retrying available render capacity","type":"n8n-nodes-base.wait","position":[8540,1200],"parameters":{"unit":"seconds","amount":"={{ $json.retrySeconds }}","resume":"timeInterval"},"typeVersion":1.1},{"id":"late-submission-stop","name":"Report why the render submission stopped","type":"n8n-nodes-base.code","position":[9940,850],"parameters":{"jsCode":"throw Error($json.reason);"},"typeVersion":2},{"id":"late-accepted","name":"Capture the accepted render job ID","type":"n8n-nodes-base.code","position":[9100,500],"parameters":{"jsCode":"function trackJob(context, response, now) {\n  const jobId=String(response.jobId || response.id || context.jobId || '').trim();\n  if (!jobId) throw new Error('No render job ID returned. The sheet stays submitting; inspect https://app.zvid.io before resetting it.');\n  return {...context,jobId,pollStartedAt:now};\n}\nreturn [{json:trackJob($('Enforce the per-video credit ceiling').first().json.checkpoint,$json,Date.now())}];"},"typeVersion":2},{"id":"late-save-job","name":"Persist the accepted job for recovery","type":"n8n-nodes-base.googleSheets","position":[9380,500],"parameters":{"columns":{"value":{"JobId":"={{ $('Capture the accepted render job ID').first().json.jobId }}","Status":"rendering","RenderKey":"={{ $('Capture the accepted render job ID').first().json.renderKey }}"},"schema":[{"id":"RenderKey","type":"string","display":true,"removed":false,"required":false,"displayName":"RenderKey","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Status","type":"string","display":true,"removed":false,"required":false,"displayName":"Status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"JobId","type":"string","display":true,"removed":false,"required":false,"displayName":"JobId","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["RenderKey"]},"options":{"cellFormat":"RAW"},"resource":"sheet","operation":"update","sheetName":{"__rl":true,"mode":"name","value":"KPI Reports"},"documentId":{"__rl":true,"mode":"id","value":""}},"typeVersion":4.7},{"id":"late-restore-new","name":"Restore the accepted render context","type":"n8n-nodes-base.code","position":[9660,500],"parameters":{"jsCode":"return [{json:$('Capture the accepted render job ID').first().json}];"},"typeVersion":2},{"id":"late-track","name":"Track the saved job and its source context","type":"n8n-nodes-base.code","position":[10420,220],"parameters":{"jsCode":"function trackJob(context, response, now) {\n  const jobId=String(response.jobId || response.id || context.jobId || '').trim();\n  if (!jobId) throw new Error('No render job ID returned. The sheet stays submitting; inspect https://app.zvid.io before resetting it.');\n  return {...context,jobId,pollStartedAt:now};\n}\nreturn [{json:trackJob($json,{},Date.now())}];"},"typeVersion":2},{"id":"late-status","name":"Wait for this accepted Zvid render","type":"@zvid/n8n-nodes-zvid.zvid","onError":"continueRegularOutput","position":[10700,500],"parameters":{"jobId":"={{ $json.jobId }}","resource":"render","operation":"get","waitOptions":{"maxWaitTime":"={{ (Number($('Set reporting period and exception thresholds').first().json.timeoutMinutes) || 20)*60 }}","pollInterval":"={{ Number($('Set reporting period and exception thresholds').first().json.pollSeconds) || 10 }}"},"waitForCompletion":true},"retryOnFail":false,"typeVersion":1},{"id":"late-classify","name":"Classify completion failure or uncertain status","type":"n8n-nodes-base.code","position":[10980,500],"parameters":{"jsCode":"function classifyJob(context, response, now, timeoutMinutes) {\n  const result=response.result;\n  const url=typeof result==='string'?result:result?.url || result?.videoUrl || '';\n  const state=String(response.state || response.status || '').toLowerCase();\n  if (state==='completed') {\n    if (!/^https:\\/\\/\\S+$/i.test(url)) return {...context,status:'needs_review',reason:'Completed job has no HTTPS media URL. Inspect Zvid; do not resubmit.',videoUrl:null};\n    return {...context,status:'completed',videoUrl:url,renderedAt:new Date(now).toISOString()};\n  }\n  if (['failed','cancelled','canceled'].includes(state)) return {...context,status:'failed',reason:String(response.failedReason || response.error || state),videoUrl:null};\n  if (now-context.pollStartedAt >= Number(timeoutMinutes || 20)*60000) return {...context,status:'timed_out',reason:'Polling deadline reached. Keep the job ID and check Zvid before resuming.',videoUrl:null};\n  if (!['waiting','queued','active','processing','rendering','pending'].includes(state)) return {...context,status:'needs_review',reason:'Unrecognized render state: '+state,videoUrl:null};\n  return {...context,status:'rendering',videoUrl:null};\n}\nconst context=$('Track the saved job and its source context').first().json;let response=$json;if(response.error){const error=typeof response.error==='string'?response.error:JSON.stringify(response.error);response={state:/did not finish within|timed? ?out/i.test(error)?'timed_out':/failed/i.test(error)?'failed':'needs_review',failedReason:error};}const result=classifyJob(context,response,Date.now(),$('Set reporting period and exception thresholds').first().json.timeoutMinutes);if(response.state==='timed_out')result.status='timed_out';const {payload,outcomeCheckpoint,...snapshot}=result;result.outcomeCheckpoint={...snapshot,renderOutcome:{status:result.status,reason:result.reason||null}};return [{json:result}];"},"typeVersion":2},{"id":"late-finish","name":"Record the render outcome and completed URL","type":"n8n-nodes-base.googleSheets","position":[11260,500],"parameters":{"columns":{"value":{"JobId":"={{ $('Classify completion failure or uncertain status').first().json.jobId }}","Status":"={{ $('Classify completion failure or uncertain status').first().json.status }}","PlanJson":"={{ JSON.stringify($('Classify completion failure or uncertain status').first().json.outcomeCheckpoint) }}","VideoUrl":"={{ $('Classify completion failure or uncertain status').first().json.videoUrl || '' }}","RenderKey":"={{ $('Classify completion failure or uncertain status').first().json.renderKey }}","CompletedAt":"={{ $('Classify completion failure or uncertain status').first().json.renderedAt || '' }}"},"schema":[{"id":"RenderKey","type":"string","display":true,"removed":false,"required":false,"displayName":"RenderKey","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Status","type":"string","display":true,"removed":false,"required":false,"displayName":"Status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"JobId","type":"string","display":true,"removed":false,"required":false,"displayName":"JobId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"VideoUrl","type":"string","display":true,"removed":false,"required":false,"displayName":"VideoUrl","defaultMatch":false,"canBeUsedToMatch":true},{"id":"CompletedAt","type":"string","display":true,"removed":false,"required":false,"displayName":"CompletedAt","defaultMatch":false,"canBeUsedToMatch":true},{"id":"PlanJson","type":"string","display":true,"removed":false,"required":false,"displayName":"PlanJson","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["RenderKey"]},"options":{"cellFormat":"RAW"},"resource":"sheet","operation":"update","sheetName":{"__rl":true,"mode":"name","value":"KPI Reports"},"documentId":{"__rl":true,"mode":"id","value":""}},"typeVersion":4.7},{"id":"late-report","name":"Prepare the completed result and review pack","type":"n8n-nodes-base.code","position":[11740,500],"parameters":{"jsCode":"function completedResult(result) {\n\tif (result.status !== 'completed' || !/^https:\\/\\/\\S+$/i.test(String(result.videoUrl || '')))\n\t\tthrow Error(\n\t\t\t'Video is not ready (' +\n\t\t\t\tresult.status +\n\t\t\t\t'): ' +\n\t\t\t\t(result.reason || 'Inspect the saved job in Zvid.') +\n\t\t\t\t' Job: ' +\n\t\t\t\t(result.jobId || 'unknown') +\n\t\t\t\t'. The tracking row was saved; no replacement render was submitted.',\n\t\t);\n\treturn { ...result, nextStep: 'Review the video and source handoff before sharing.' };\n}\nreturn [{json:completedResult($('Classify completion failure or uncertain status').first().json)}];"},"typeVersion":2},{"id":"late-handoff","name":"Download the source-specific review pack","type":"n8n-nodes-base.code","position":[12020,850],"parameters":{"jsCode":"function csvFile(rows, fileName) {\n\tconst columns = Object.keys(rows[0] || {}),\n\t\tcell = (v) => {\n\t\t\tlet s = String(v ?? '');\n\t\t\tif (/^[=+@\\-\\t\\r]/.test(s)) s = \"'\" + s;\n\t\t\treturn '\"' + s.replace(/\"/g, '\"\"') + '\"';\n\t\t};\n\tconst csv = [\n\t\tcolumns.map(cell).join(','),\n\t\t...rows.map((r) => columns.map((k) => cell(r[k])).join(',')),\n\t].join('\\r\\n');\n\treturn { data: Buffer.from(csv, 'utf8').toString('base64'), mimeType: 'text/csv', fileName };\n}\nconst d=$json;return [{json:{renderKey:d.renderKey,status:d.status,videoUrl:d.videoUrl||null,rowCount:(d.handoff||[]).length},binary:{data:csvFile(d.handoff||[],'kpi-report-video-review.csv')}}];"},"typeVersion":2},{"id":"zvid-watch-ready","name":"Completed video is ready to watch?","type":"n8n-nodes-base.if","position":[12020,500],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"watch-ready-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.status === 'completed' && !$json.dryRun && /^https:\\/\\//i.test(String($json.videoUrl || '')) }}","rightValue":""}]}},"typeVersion":2.2},{"id":"late-deliver","name":"Optional delivery is enabled and approved?","type":"n8n-nodes-base.if","position":[12780,500],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"deliver-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.status === 'completed' && $json.usingDemoData !== true && $('Set reporting period and exception thresholds').first().json.sendSlack === true && Boolean($('Set reporting period and exception thresholds').first().json.slackWebhookUrl) }}","rightValue":""}]}},"typeVersion":2.2},{"id":"late-delivery-pending","name":"Record delivery as pending before sending","type":"n8n-nodes-base.googleSheets","position":[13060,500],"parameters":{"columns":{"value":{"RenderKey":"={{ $('Prepare the completed result and review pack').first().json.renderKey }}","DeliveryStatus":"sending"},"schema":[{"id":"RenderKey","type":"string","display":true,"removed":false,"required":false,"displayName":"RenderKey","defaultMatch":false,"canBeUsedToMatch":true},{"id":"DeliveryStatus","type":"string","display":true,"displayName":"DeliveryStatus","canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["RenderKey"]},"options":{"cellFormat":"RAW"},"resource":"sheet","operation":"update","sheetName":{"__rl":true,"mode":"name","value":"KPI Reports"},"documentId":{"__rl":true,"mode":"id","value":""}},"typeVersion":4.7},{"id":"late-send","name":"Post the checked KPI briefing to Slack","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[13340,500],"parameters":{"url":"={{ $('Set reporting period and exception thresholds').first().json.slackWebhookUrl }}","method":"POST","options":{"timeout":20000,"response":{"response":{"neverError":true,"fullResponse":true,"responseFormat":"text"}}},"jsonBody":"={{ JSON.stringify({text:$('Prepare the completed result and review pack').first().json.caption + '\\n' + $('Prepare the completed result and review pack').first().json.videoUrl}) }}","sendBody":true,"specifyBody":"json"},"retryOnFail":false,"typeVersion":4.2},{"id":"late-delivery-result","name":"Keep the delivery acknowledgement or error","type":"n8n-nodes-base.code","position":[13620,500],"parameters":{"jsCode":"const result=$('Prepare the completed result and review pack').first().json;const response=$json;const acknowledged=Number(response.statusCode) === 200 && String(response.body).trim() === \"ok\";return [{json:{...result,deliveryStatus:acknowledged?'accepted':'needs_review',deliveryError:acknowledged?'':String(response.error?.message || response.error || 'No delivery acknowledgement; inspect before retrying.')}}];"},"typeVersion":2},{"id":"late-delivery-save","name":"Record the delivery acknowledgement","type":"n8n-nodes-base.googleSheets","position":[13900,500],"parameters":{"columns":{"value":{"RenderKey":"={{ $('Keep the delivery acknowledgement or error').first().json.renderKey }}","DeliveryStatus":"={{ $('Keep the delivery acknowledgement or error').first().json.deliveryStatus }}"},"schema":[{"id":"RenderKey","type":"string","display":true,"removed":false,"required":false,"displayName":"RenderKey","defaultMatch":false,"canBeUsedToMatch":true},{"id":"DeliveryStatus","type":"string","display":true,"displayName":"DeliveryStatus","canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["RenderKey"]},"options":{"cellFormat":"RAW"},"resource":"sheet","operation":"update","sheetName":{"__rl":true,"mode":"name","value":"KPI Reports"},"documentId":{"__rl":true,"mode":"id","value":""}},"typeVersion":4.7},{"id":"publication-overview-kpi-report-video","name":"Workflow overview and setup","type":"n8n-nodes-base.stickyNote","position":[-800,0],"parameters":{"color":1,"width":720,"height":1160,"content":"## Turn verified KPI snapshots into an exception briefing and action register\n\n### How it works\nCheck the reporting snapshot is fresh and its period is complete. Calculate changes from actual current and previous values, identify target misses and adverse movements, prioritize the five most important metrics in the video, and return a full owner action register. A separate recovery log skips completed keys and resumes accepted jobs. Review the video and CSV before sharing. Optional Slack delivery is off by default.\n\n### Setup\n1. Install **`@zvid/n8n-nodes-zvid`** from **Settings → Community nodes** before credentials. A workspace owner/admin may need to install it.\n2. Create a **Zvid API** credential with [your key](https://app.zvid.io/api-keys) and Base URL `https://api.zvid.io`; select it on all Zvid nodes.\n3. Connect Google Sheets and select the **KPI Reports** log tab. Create RenderKey, Status, JobId, CreditsQuoted, PlanJson, VideoUrl and CompletedAt headers; optional delivery also needs DeliveryStatus.\n4. Configure metricsUrl returning generatedAt, periodStart, periodEnd, company and metrics[] with id, label, value, previous and lowerIsBetter; optional target, owner and action. Use this template’s description for current setup; see the [background guide](https://github.com/Zvid-io/zvid-n8n/blob/master/workflows/kpi-report-video.md).\n5. **dryRun=false spends credits.** true returns JSON and a quote only. Optional narration can charge in previews; see section 5 for voice credentials and the HTTP upload exception. Set maxCreditsPerVideo, then test manually before enabling the schedule.\n6. Avoid overlapping executions. Inspect submitting, failed or uncertain jobs before resetting any log row.\n\n### Customization\nAdjust branding and the domain rules in **Set reporting period and exception thresholds**. Watch downloads time out after 30 seconds; the saved URL remains available."},"typeVersion":1},{"id":"publication-section-kpi-report-video-configure","name":"1. Choose source rules and schedule","type":"n8n-nodes-base.stickyNote","position":[0,0],"parameters":{"color":7,"width":660,"height":1160,"content":"## 1. Choose source rules and schedule\n\nComplete the overview setup and source contract. Run one execution at a time. Use the manual trigger before enabling the schedule."},"typeVersion":1},{"id":"publication-section-kpi-report-video-source","name":"2. Choose live or labeled sample metrics","type":"n8n-nodes-base.stickyNote","position":[760,0],"parameters":{"color":7,"width":2060,"height":1160,"content":"## 2. Choose live or labeled sample metrics\n\nLive mode requires metricsUrl and a fresh completed-period snapshot. Explicit sample mode bypasses HTTP, labels its video and CSV, and blocks Slack delivery. Derive changes from current and previous values; rank target misses and adverse movements."},"typeVersion":1},{"id":"publication-section-kpi-report-video-routing","name":"3. Recover accepted work before a new render","type":"n8n-nodes-base.stickyNote","position":[2920,0],"parameters":{"color":7,"width":660,"height":1160,"content":"## 3. Recover accepted work before a new render\n\nSaved jobs follow the upper route using their original review context. New work continues through optional media and the domain design."},"typeVersion":1},{"id":"publication-section-kpi-report-video-music","name":"4. Check optional background music","type":"n8n-nodes-base.stickyNote","position":[3680,0],"parameters":{"color":7,"width":1220,"height":1160,"content":"## 4. Check optional background music\n\nA failed or oversized music file is skipped. Empty musicUrl continues without an external request. This check preserves the selected source plan."},"typeVersion":1},{"id":"publication-section-kpi-report-video-narration","name":"5. Optionally narrate the checked KPI facts","type":"n8n-nodes-base.stickyNote","position":[5000,0],"parameters":{"color":7,"width":1780,"height":1160,"content":"## 5. Optionally narrate the checked KPI facts\n\nnarrate is off by default. ElevenLabs voice generation can charge even in previews. Configure its Header Auth credential. Multipart upload uses HTTP because the published Zvid node lacks uploads."},"typeVersion":1},{"id":"publication-section-kpi-report-video-quote","name":"6. Build and validate the design and credit ceiling","type":"n8n-nodes-base.stickyNote","position":[6880,0],"parameters":{"color":7,"width":1220,"height":1160,"content":"## 6. Build and validate the design and credit ceiling\n\ndryRun=true returns the source plan, design JSON and quote. It performs no log writes, editor draft creation, render, or delivery. Optional voice synthesis may charge before validation."},"typeVersion":1},{"id":"publication-section-kpi-report-video-reserve","name":"7. Reserve the key and preserve the accepted job","type":"n8n-nodes-base.stickyNote","position":[8200,0],"parameters":{"color":7,"width":2060,"height":1490,"content":"## 7. Reserve the key and preserve the accepted job\n\nSave the key and accepted job ID. Retry explicit capacity rejections up to three attempts, respecting the server delay and a 30-second minimum. Uncertain submissions require inspection. Sheets is not an atomic lock."},"typeVersion":1},{"id":"publication-section-kpi-report-video-finish","name":"8. Wait for the accepted render and record its result","type":"n8n-nodes-base.stickyNote","position":[10360,0],"parameters":{"color":7,"width":1220,"height":1160,"content":"## 8. Wait for the accepted render and record its result\n\nPoll the saved job within the deadline. Keep failed, timed-out and uncertain job IDs for inspection. Completed keys are skipped on later runs."},"typeVersion":1},{"id":"zvid-watch-instructions","name":"9. Review the video and source-specific handoff","type":"n8n-nodes-base.stickyNote","position":[11680,0],"parameters":{"color":7,"width":940,"height":1160,"content":"## 9. Review the video and source-specific handoff\n\nCompleted renders reach Watch video → Binary → data → View. A failed render stops with its actual reason after saving the tracking row. Download the review CSV and check source facts before sharing. Optional delivery is off by default."},"typeVersion":1},{"id":"publication-section-kpi-report-video-delivery","name":"10. Deliver only when explicitly enabled","type":"n8n-nodes-base.stickyNote","position":[12720,0],"parameters":{"color":7,"width":1500,"height":1160,"content":"## 10. Deliver only when explicitly enabled\n\nOptional delivery is off by default. Enable sendSlack only after configuring its webhook. Record sending before delivery and retain the acknowledgement. Inspect uncertain sends manually; completed runs never resend automatically."},"typeVersion":1}],"active":false,"pinData":{},"settings":{"executionOrder":"v1"},"versionId":"c4e8a2d6-3f19-4b57-8e42-9a6c1d5f7b28","connections":{"Voice + timings":{"main":[[{"node":"Upload voiceover","type":"main","index":0}]]},"Upload voiceover":{"main":[[{"node":"Restore the checked KPI plan with its narration","type":"main","index":0}]]},"Generate voiceover":{"main":[[{"node":"Voice + timings","type":"main","index":0}]]},"Read KPI Reports recovery log":{"main":[[{"node":"Calculate KPI changes target misses and owners","type":"main","index":0}]]},"Resume the accepted render job?":{"main":[[{"node":"Restore the saved result and handoff context","type":"main","index":0}],[{"node":"A background music URL is configured?","type":"main","index":0}]]},"Return a validation-only preview?":{"main":[[{"node":"Return the source plan design quote and handoff","type":"main","index":0}],[{"node":"Reserve this render key before spending credits","type":"main","index":0}]]},"Capture the accepted render job ID":{"main":[[{"node":"Persist the accepted job for recovery","type":"main","index":0}]]},"Completed video is ready to watch?":{"main":[[{"node":"▶ Watch video","type":"main","index":0}],[]]},"Submit this approved video to Zvid":{"main":[[{"node":"Capture the accepted render job ID","type":"main","index":0}],[{"node":"Distinguish a capacity rejection from an uncertain submission","type":"main","index":0}]]},"Test the kpi report video workflow":{"main":[[{"node":"Set reporting period and exception thresholds","type":"main","index":0}]]},"Wait for this accepted Zvid render":{"main":[[{"node":"Classify completion failure or uncertain status","type":"main","index":0}]]},"Choose the configured metrics input":{"main":[[{"node":"Read KPI Reports recovery log","type":"main","index":0}]]},"Fetch the reporting source snapshot":{"main":[[{"node":"Choose the configured metrics input","type":"main","index":0}]]},"Restore the accepted render context":{"main":[[{"node":"Track the saved job and its source context","type":"main","index":0}]]},"Enforce the per-video credit ceiling":{"main":[[{"node":"Return a validation-only preview?","type":"main","index":0}]]},"Start the scheduled kpi report video":{"main":[[{"node":"Set reporting period and exception thresholds","type":"main","index":0}]]},"A background music URL is configured?":{"main":[[{"node":"Check the optional music file size and availability","type":"main","index":0}],[{"node":"Prepare the selected source for design","type":"main","index":0}]]},"Persist the accepted job for recovery":{"main":[[{"node":"Restore the accepted render context","type":"main","index":0}]]},"Post the checked KPI briefing to Slack":{"main":[[{"node":"Keep the delivery acknowledgement or error","type":"main","index":0}]]},"Prepare the selected source for design":{"main":[[{"node":"Create optional narration from checked metrics?","type":"main","index":0}]]},"Retry this explicit capacity rejection?":{"main":[[{"node":"Wait before retrying available render capacity","type":"main","index":0}],[{"node":"Report why the render submission stopped","type":"main","index":0}]]},"Use explicitly selected sample metrics?":{"main":[[{"node":"Create labeled sample metrics for testing","type":"main","index":0}],[{"node":"Require a live reporting URL before fetching","type":"main","index":0}]]},"Build the exception-focused KPI briefing":{"main":[[{"node":"Validate the video and request its credit quote","type":"main","index":0}]]},"Create labeled sample metrics for testing":{"main":[[{"node":"Choose the configured metrics input","type":"main","index":0}]]},"Record delivery as pending before sending":{"main":[[{"node":"Post the checked KPI briefing to Slack","type":"main","index":0}]]},"Keep the delivery acknowledgement or error":{"main":[[{"node":"Record the delivery acknowledgement","type":"main","index":0}]]},"Keep the source plan and usable music only":{"main":[[{"node":"Prepare the selected source for design","type":"main","index":0}]]},"Optional delivery is enabled and approved?":{"main":[[{"node":"Record delivery as pending before sending","type":"main","index":0}],[]]},"Track the saved job and its source context":{"main":[[{"node":"Wait for this accepted Zvid render","type":"main","index":0}]]},"Prepare a bounded render submission attempt":{"main":[[{"node":"Submit this approved video to Zvid","type":"main","index":0}]]},"Record the rejected or uncertain submission":{"main":[[{"node":"Restore the submission rejection and retry timing","type":"main","index":0}]]},"Record the render outcome and completed URL":{"main":[[{"node":"Prepare the completed result and review pack","type":"main","index":0}]]},"Prepare the completed result and review pack":{"main":[[{"node":"Completed video is ready to watch?","type":"main","index":0},{"node":"Download the source-specific review pack","type":"main","index":0},{"node":"Optional delivery is enabled and approved?","type":"main","index":0}]]},"Require a live reporting URL before fetching":{"main":[[{"node":"Fetch the reporting source snapshot","type":"main","index":0}]]},"Restore the saved result and handoff context":{"main":[[{"node":"Track the saved job and its source context","type":"main","index":0}]]},"Set reporting period and exception thresholds":{"main":[[{"node":"Use explicitly selected sample metrics?","type":"main","index":0}]]},"Calculate KPI changes target misses and owners":{"main":[[{"node":"Eligible source content or saved render exists?","type":"main","index":0}]]},"Wait before retrying available render capacity":{"main":[[{"node":"Prepare a bounded render submission attempt","type":"main","index":0}]]},"Classify completion failure or uncertain status":{"main":[[{"node":"Record the render outcome and completed URL","type":"main","index":0}]]},"Create optional narration from checked metrics?":{"main":[[{"node":"Write factual KPI narration from the checked values","type":"main","index":0}],[{"node":"Build the exception-focused KPI briefing","type":"main","index":0}]]},"Eligible source content or saved render exists?":{"main":[[{"node":"Resume the accepted render job?","type":"main","index":0}],[{"node":"Explain skipped content or recovery needs","type":"main","index":0}]]},"Reserve this render key before spending credits":{"main":[[{"node":"Prepare a bounded render submission attempt","type":"main","index":0}]]},"Restore the checked KPI plan with its narration":{"main":[[{"node":"Build the exception-focused KPI briefing","type":"main","index":0}]]},"Validate the video and request its credit quote":{"main":[[{"node":"Enforce the per-video credit ceiling","type":"main","index":0}]]},"Restore the submission rejection and retry timing":{"main":[[{"node":"Retry this explicit capacity rejection?","type":"main","index":0}]]},"Check the optional music file size and availability":{"main":[[{"node":"Keep the source plan and usable music only","type":"main","index":0}]]},"Write factual KPI narration from the checked values":{"main":[[{"node":"Generate voiceover","type":"main","index":0}]]},"Distinguish a capacity rejection from an uncertain submission":{"main":[[{"node":"Record the rejected or uncertain submission","type":"main","index":0}]]}}}