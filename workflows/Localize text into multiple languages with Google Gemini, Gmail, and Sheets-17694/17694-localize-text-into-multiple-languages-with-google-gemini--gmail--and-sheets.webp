{"id":"cMAHoI46ShS8dpR0","meta":{"instanceId":"0fd24758e45cbed1f63c03b9ca7326acab4b855985945af441ee95f8874d3e22","builderVariant":"mcp","aiBuilderAssisted":true},"name":"Localize text into many languages at once with Gemini","tags":[],"nodes":[{"id":"ed9d86a8-09c3-4db7-b087-c24436079c17","name":"Localization Form","type":"n8n-nodes-base.formTrigger","position":[-32,-96],"webhookId":"8a6ec517-dd6d-40cd-8740-e8a0e01aca5e","parameters":{"options":{"buttonLabel":"Translate","respondWithOptions":{"values":{"formSubmittedText":"Thanks! Your translations are being generated and will arrive by email shortly."}}},"formTitle":"Localize my text","formFields":{"values":[{"fieldType":"email","fieldLabel":"Your email","requiredField":true},{"fieldType":"dropdown","fieldLabel":"Content type","fieldOptions":{"values":[{"option":"Marketing copy"},{"option":"Product UI text"},{"option":"Email"},{"option":"Support reply"},{"option":"General"}]},"requiredField":true},{"fieldLabel":"Languages","placeholder":"e.g. Japanese, Spanish, German","requiredField":true},{"fieldType":"textarea","fieldLabel":"Text","placeholder":"Paste the text to translate...","requiredField":true}]},"formDescription":"Paste text and pick languages to get faithful, tone-matched translations by email."},"typeVersion":2.6},{"id":"c6680aee-2385-4dac-b554-5075ff79d43e","name":"One Item Per Language","type":"n8n-nodes-base.code","position":[176,-96],"parameters":{"jsCode":"const f = $input.first().json;\nconst langs = String(f.Languages || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);\nreturn langs.map(function (l) { return { json: { email: f['Your email'], contentType: f['Content type'], language: l, text: f.Text } }; });"},"typeVersion":2},{"id":"f563901a-9079-4e7d-a1ea-06320833ddd0","name":"Build Email Body","type":"n8n-nodes-base.code","position":[1440,-112],"parameters":{"jsCode":"const rows = $('Shape Translation').all().map(function (i) { return i.json; });\nconst email = (rows[0] && rows[0].email) || $('Localization Form').first().json['Your email'];\nconst blocks = rows.map(function (r) { return r.language + ':\\n' + r.translation; }).join('\\n\\n');\nreturn [{ json: { email: email, count: rows.length, body: 'Here are your translations.\\n\\n' + blocks } }];"},"typeVersion":2},{"id":"e9f44353-c131-48b7-b4bf-cff3c18b90b4","name":"Email All Translations","type":"n8n-nodes-base.gmail","position":[1664,-112],"webhookId":"19ee6aea-5eaa-422a-b9f5-b1ed3e830876","parameters":{"sendTo":"={{ $json.email }}","message":"={{ $json.body }}","options":{},"subject":"={{ \"Your translations (\" + $json.count + \" languages)\" }}","emailType":"text"},"credentials":{"gmailOAuth2":{"id":"UGspxvKkMZCF4l4Y","name":"Gmail account"}},"typeVersion":2.2},{"id":"81804540-d360-4e5e-bcff-9732fb685309","name":"Translate with Gemini","type":"@n8n/n8n-nodes-langchain.chainLlm","position":[688,48],"parameters":{"text":"=You are a professional localizer, not a literal translator. Translate the {{ $json.contentType }} below into {{ $json.language }}. Match the tone and intent, adapt idioms and units naturally for that locale, keep any placeholders like {name} or %s unchanged, and do not translate brand names. Output only the translation.\n\nText:\n{{ $json.text }}","batching":{},"promptType":"define"},"typeVersion":1.9},{"id":"f4dff53f-a9f3-44f7-a37f-d95a77b3c370","name":"Google Gemini Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatGoogleGemini","position":[688,272],"parameters":{"options":{"temperature":0.3},"modelName":"models/gemini-3.1-flash-lite"},"credentials":{"googlePalmApi":{"id":"SqSj0UBxvATZV3OU","name":"Google Gemini(PaLM) Api account"}},"typeVersion":1.1},{"id":"6ff3cb03-5973-4fe4-a375-f400343c61f1","name":"Shape Translation","type":"n8n-nodes-base.code","position":[992,48],"parameters":{"mode":"runOnceForEachItem","jsCode":"const src = $('Loop Languages').item.json;\nreturn { email: src.email, contentType: src.contentType, language: src.language, original: src.text, translation: String($json.text || '').trim() };"},"typeVersion":2},{"id":"991df7b5-a054-4aa8-93eb-8b5affb87d19","name":"Save Translation","type":"n8n-nodes-base.googleSheets","position":[1168,48],"parameters":{"operation":"append","sheetName":{"__rl":true,"mode":"list","value":"","cachedResultName":"Translations"},"documentId":{"__rl":true,"mode":"list","value":"","cachedResultName":"Select your spreadsheet"}},"credentials":{"googleSheetsOAuth2Api":{"id":"VBagC67WblkLgsDb","name":"Google Sheets account"}},"typeVersion":4.7},{"id":"d9290439-b95e-4b32-856a-d99af7110ef6","name":"Loop Languages","type":"n8n-nodes-base.splitInBatches","position":[480,-96],"parameters":{"options":{},"batchSize":3},"typeVersion":3},{"id":"a9072047-878f-437f-a58f-68a49499cead","name":"Overview Sticky","type":"n8n-nodes-base.stickyNote","position":[-736,-288],"parameters":{"width":600,"height":652,"content":"## Localize text into many languages at once with Gemini\n\n### How it works\nMachine translation is often too literal for marketing or UI text. This template localizes properly and does it for every language in one submission. Paste your text in the built-in form and list the target languages, and a Code node fans the request out into one item per language. A Loop Over Items node then processes them in small batches so you stay under the rate limit, and for each language a Basic LLM Chain with Google Gemini translates the text as a localizer would - matching tone, adapting idioms and units, keeping placeholders like {name} intact and leaving brand names alone. Every translation is saved to a Google Sheet, and when the loop finishes all of them are combined into a single email so you get one tidy message instead of one per language.\n\n### Setup\n1. Connect Google Gemini (PaLM) API, Google Sheets and Gmail.\n2. Point the Save Translation node at your spreadsheet (tab: Translations).\n3. Open the form URL, paste text and list languages separated by commas.\n\n### Customization tips\nTranslate an uploaded file, or push each language to its own sheet or CMS locale."},"typeVersion":1},{"id":"99b91ff5-731d-4ee4-91fb-31fd4b76bff2","name":"S1","type":"n8n-nodes-base.stickyNote","position":[-112,-288],"parameters":{"color":7,"width":512,"height":684,"content":"## 1. Submit & fan out\nThe form takes text and a list of languages; a Code node creates one item per language."},"typeVersion":1},{"id":"e0b528cc-9724-4eaf-8d4d-45531aac906b","name":"S2","type":"n8n-nodes-base.stickyNote","position":[416,-288],"parameters":{"color":7,"width":924,"height":688,"content":"## 2. Loop & translate (Basic LLM Chain)\nProcess the languages in batches to respect the rate limit. Gemini localizes each one and it is saved to Sheets."},"typeVersion":1},{"id":"e5667407-8dcf-4552-ae97-6511d480cd82","name":"S3","type":"n8n-nodes-base.stickyNote","position":[1360,-288],"parameters":{"color":7,"width":500,"height":684,"content":"## 3. Combine & email\nWhen the loop is done, all translations are combined into one email."},"typeVersion":1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":true,"executionOrder":"v1"},"versionId":"acb5e132-7146-4308-b27d-e7b3e20a6c2c","nodeGroups":[],"connections":{"Loop Languages":{"main":[[{"node":"Build Email Body","type":"main","index":0}],[{"node":"Translate with Gemini","type":"main","index":0}]]},"Build Email Body":{"main":[[{"node":"Email All Translations","type":"main","index":0}]]},"Save Translation":{"main":[[{"node":"Loop Languages","type":"main","index":0}]]},"Localization Form":{"main":[[{"node":"One Item Per Language","type":"main","index":0}]]},"Shape Translation":{"main":[[{"node":"Save Translation","type":"main","index":0}]]},"One Item Per Language":{"main":[[{"node":"Loop Languages","type":"main","index":0}]]},"Translate with Gemini":{"main":[[{"node":"Shape Translation","type":"main","index":0}]]},"Google Gemini Chat Model":{"ai_languageModel":[[{"node":"Translate with Gemini","type":"ai_languageModel","index":0}]]}}}