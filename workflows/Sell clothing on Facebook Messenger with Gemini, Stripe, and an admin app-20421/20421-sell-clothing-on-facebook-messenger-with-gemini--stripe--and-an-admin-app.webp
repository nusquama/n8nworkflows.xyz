},"combinator":"and","conditions":[{"id":"51ff6784-c8ad-4c25-89c3-ae5814dd9980","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.action }}","rightValue":"vector"}]},"renameOutput":true},{"outputKey":"test chat","conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"8e788fa5-71ea-466e-bcc7-412a243bdc38","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.action }}","rightValue":"preview"}]},"renameOutput":true},{"outputKey":"delivery details","conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"d1b0c3a2-4f5e-4a6b-8c7d-9e0f1a2b3c4d","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.action }}","rightValue":"delivery"}]},"renameOutput":true}]},"options":{},"looseTypeValidation":true},"typeVersion":3.4},{"id":"1a3210d3-9df3-467a-ac9b-88ca7323c69f","name":"list_products","type":"n8n-nodes-base.dataTableTool","position":[-3680,18140],"parameters":{"filters":{"conditions":[{"keyName":"Status","keyValue":"active"}]},"matchType":"allConditions","operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Sales Products","cachedResultName":"Sales Products"},"descriptionType":"manual","toolDescription":"Lists every active product in the shop with Name, Price (USD), Stock_Status (pieces in stock), Sizes, Colors and Description. Call it when the customer is browsing ('what do you have?', 'show me t-shirts', 'any jackets?') or when you need the exact product name before calling get_product_details. Takes no input."},"typeVersion":1.1},{"id":"c0cec27a-9797-4ea0-a01f-c3a6fa50adff","name":"Get Checkout Settings","type":"n8n-nodes-base.dataTable","position":[-4048,4652],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"configKey","keyValue":"clothing_sales_agent"}]},"matchType":"allConditions","operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"Sales Agent Config","cachedResultName":"Sales Agent Config"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"d25a6f71-cd07-49d5-bc91-bbc8d533c2b5","name":"Get Order","type":"n8n-nodes-base.dataTable","position":[-3808,4652],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"OrderID","keyValue":"={{ $('When Called By This Workflow').first().json.orderId }}"}]},"matchType":"allConditions","operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"Sales Orders","cachedResultName":"Sales Orders"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"278dc8f4-8c68-45fe-9749-c61a14186ade","name":"Get Cart Items","type":"n8n-nodes-base.dataTable","position":[-3568,4652],"parameters":{"filters":{"conditions":[{"keyName":"orderId","keyValue":"={{ $('When Called By This Workflow').first().json.orderId }}"}]},"matchType":"allConditions","operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Sales Cart Items","cachedResultName":"Sales Cart Items"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"87c11040-b59b-4038-b499-f953ce6d9913","name":"Read Inventory","type":"n8n-nodes-base.dataTable","position":[-3328,4652],"parameters":{"operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Sales Products","cachedResultName":"Sales Products"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"b8ae4320-e8dd-4940-a43c-3707ee69d3fa","name":"Get Previous Payment Links","type":"n8n-nodes-base.dataTable","position":[-3088,4652],"parameters":{"filters":{"conditions":[{"keyName":"orderId","keyValue":"={{ $('When Called By This Workflow').first().json.orderId }}"},{"keyName":"status","keyValue":"open"}]},"matchType":"allConditions","operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Sales Checkout Sessions","cachedResultName":"Sales Checkout Sessions"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"f8db7b1c-4f7e-42f7-a5a2-6691ab516d64","name":"Build Checkout","type":"n8n-nodes-base.code","position":[-2848,4652],"parameters":{"jsCode":"// Re-price the cart from the live Sales Products table (never trust prices from the chat),\n// validate size/colour, stock and delivery details, and build the Stripe Checkout Session request.\nconst input = $('When Called By This Workflow').first().json;\nconst order = $('Get Order').first().json;\nconst cart = $('Get Cart Items').all().map((i) => i.json).filter((r) => r.productName);\nconst inventory = $('Read Inventory').all().map((i) => i.json).filter((r) => r.Name && r.Status !== 'archived');\nconst settings = $('Get Checkout Settings').first().json;\nconst norm = (s) => String(s || '').trim().toLowerCase();\nconst rawList = (s) => String(s || '').split(/[,/|]/).map((x) => x.trim()).filter(Boolean);\nconst listOf = (s) => rawList(s).map((x) => norm(x));\n// Use the spelling from the product (e.g. \"Black\"), not the customer's (\"black\").\nconst canonical = (list, value) => rawList(list).find((x) => norm(x) === norm(value)) || value;\nconst problems = [];\n\nif (!order.OrderID) problems.push('order not found');\nelse if (String(order.customer_id) !== String(input.customerId)) problems.push('this order belongs to a different customer');\nelse if (!['Draft', 'Awaiting_Payment'].includes(String(order.Status || '').trim()))\n  problems.push(`this order is already ${order.Status}; start a new cart`);\n\n// Delivery details come from the order row, saved step by step with save_delivery_details.\nconst fullName = String(order.Full_Name || '').trim();\nconst street = String(order.Address || '').trim();\nconst city = String(order.City || '').trim();\nconst address = [street, city].filter(Boolean).join(', ');\nconst phone = String(order.Phone || '').replace(/[^\\d+]/g, '');\nconst missingDetails = [];\nif (fullName.length < 2) missingDetails.push('full name');\nif (phone.replace(/\\D/g, '').length < 7) missingDetails.push('phone number');\nif (city.length < 2) missingDetails.push('city');\nif (street.length < 5) missingDetails.push('street / area address');\nif (missingDetails.length) problems.push('delivery details are missing: ' + missingDetails.join(', ') + ' (collect them with save_delivery_details)');\nelse if (!(order.Address_Confirmed === true || String(order.Address_Confirmed).toLowerCase() === 'true')) problems.push('the customer has not confirmed the final order review and delivery details yet (show the review, get a clear yes, then call save_delivery_details with customer_confirmed true)');\n\n// One cart line per product + size + colour; merge lines that differ only in letter case.\nconst wanted = {};\nfor (const row of cart) {\n  const size = String(row.size || 'one size').trim();\n  const color = String(row.color || 'default').trim();\n  const key = [norm(row.productName), norm(size), norm(color)].join('|');\n  if (!wanted[key]) wanted[key] = { name: norm(row.productName), size, color, qty: 0 };\n  wanted[key].qty += Math.floor(Number(row.quantity) || 0);\n}\n\nconst lines = [];\nconst perProduct = {};\nfor (const w of Object.values(wanted)) {\n  if (w.qty <= 0) continue;\n  const item = inventory.find((p) => norm(p.Name) === w.name);\n  if (!item) { problems.push(`\"${w.name}\" is no longer available`); continue; }\n  const price = Number(String(item.Price).replace(/[^\\d.]/g, ''));\n  if (!(price > 0)) { problems.push(`price for \"${item.Name}\" is not set yet`); continue; }\n  const sizes = listOf(item.Sizes);\n  const colors = listOf(item.Colors);\n  if (sizes.length && !sizes.includes(norm(w.size))) {\n    problems.push(`size \"${w.size}\" is not available for \"${item.Name}\" (available: ${item.Sizes})`);\n    continue;\n  }\n  if (colors.length && !colors.includes(norm(w.color))) {\n    problems.push(`colour \"${w.color}\" is not available for \"${item.Name}\" (available: ${item.Colors})`);\n    continue;\n  }\n  const size = sizes.length ? canonical(item.Sizes, w.size) : '';\n  const color = colors.length ? canonical(item.Colors, w.color) : '';\n  const variant = [size && `Size ${size}`, color].filter(Boolean).join(', ');\n  const image = String(item.Product_Image || '').trim();\n  perProduct[norm(item.Name)] = (perProduct[norm(item.Name)] || 0) + w.qty;\n  lines.push({\n    productName: String(item.Name),\n    itemId: String(item.Item_ID || ''),\n    displayName: variant ? `${item.Name} (${variant})` : String(item.Name),\n    size,\n    color,\n    quantity: w.qty,\n    unitPrice: price,\n    unitAmountCents: Math.round(price * 100),\n    image: /^https:\\/\\//.test(image) ? image : '',\n    description: String(item.Description || '').trim().slice(0, 300),\n  });\n}\n\n// Stock_Status is the total stock of a product across all sizes/colours.\nfor (const [key, qty] of Object.entries(perProduct)) {\n  const item = inventory.find((p) => norm(p.Name) === key);\n  const stock = Math.floor(Number(item.Stock_Status) || 0);\n  if (stock <= 0) problems.push(`\"${item.Name}\" is sold out`);\n  else if (qty > stock) problems.push(`only ${stock} of \"${item.Name}\" left (cart has ${qty})`);\n}\nif (!lines.length && !problems.length) problems.push('the cart is empty');\n\nconst totalCents = lines.reduce((sum, l) => sum + l.unitAmountCents * l.quantity, 0);\nif (lines.length && totalCents < 50) problems.push('order total is below the $0.50 minimum card payment');\n\n// Form-encode the Stripe request by hand (URLSearchParams is not available in the Code node sandbox).\nconst formParts = [];\nconst body = {\n  append: (key, value) => formParts.push(encodeURIComponent(key) + '=' + encodeURIComponent(String(value))),\n  toString: () => formParts.join('&'),\n};\nbody.append('mode', 'payment');\n// After paying, Stripe sends the customer to this workflow's payment-return page (webhook \"payment-success\"),\n// which re-checks the payment and links back to Messenger. Base URL comes from this n8n instance.\nconst instanceUrl = String($execution.resumeUrl || '').split('/webhook-waiting/')[0];\nconst pageId = String((input.event && input.event.pageId) || '');\nif (/^https:\\/\\//.test(instanceUrl)) {\n  body.append('success_url', `${instanceUrl}/webhook/payment-success?session_id={CHECKOUT_SESSION_ID}&page=${encodeURIComponent(pageId)}`);\n  body.append('cancel_url', `${instanceUrl}/webhook/payment-success?cancelled=1&page=${encodeURIComponent(pageId)}`);\n} else {\n  body.append('success_url', settings.paymentSuccessUrl || 'https://stripe.com');\n}\nbody.append('client_reference_id', String(input.orderId));\nbody.append('expires_at', String(Math.floor(Date.now() / 1000) + 23 * 3600));\nbody.append('metadata[order_id]', String(input.orderId));\nbody.append('metadata[customer_id]', String(input.customerId));\nbody.append('metadata[page_id]', pageId);\nbody.append('payment_intent_data[metadata][order_id]', String(input.orderId));\nlines.forEach((l, i) => {\n  const p = `line_items[${i}][price_data]`;\n  body.append(`line_items[${i}][quantity]`, String(l.quantity));\n  body.append(`${p}[currency]`, 'usd');\n  body.append(`${p}[unit_amount]`, String(l.unitAmountCents));\n  body.append(`${p}[product_data][name]`, l.displayName);\n  // The payment webhook reads these to reduce the right product's stock.\n  body.append(`${p}[product_data][metadata][product_name]`, l.productName);\n  body.append(`${p}[product_data][metadata][item_id]`, l.itemId);\n  body.append(`${p}[product_data][metadata][size]`, l.size);\n  body.append(`${p}[product_data][metadata][color]`, l.color);\n  // Stripe shows the product photo and description on the payment page.\n  if (l.image) body.append(`${p}[product_data][images][0]`, l.image);\n  if (l.description) body.append(`${p}[product_data][description]`, l.description);\n});\n\nreturn [{\n  json: {\n    ok: problems.length === 0,\n    problems,\n    orderId: String(input.orderId),\n    customerId: String(input.customerId),\n    fullName,\n    address,\n    phone,\n    lines,\n    itemsSummary: lines.map((l) => `${l.quantity} x ${l.displayName} @ $${l.unitPrice.toFixed(2)}`).join(', '),\n    totalCents,\n    total: (totalCents / 100).toFixed(2),\n    stripeFormBody: body.toString(),\n    oldSessionIds: $('Get Previous Payment Links').all().map((i) => i.json.sessionId).filter(Boolean),\n  },\n  pairedItem: { item: 0 },\n}];\n"},"typeVersion":2},{"id":"2601d088-a009-43bd-ac42-eaf44838a21e","name":"Checkout Valid?","type":"n8n-nodes-base.if","position":[-2608,4652],"parameters":{"options":{},"conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"8e989ccb-5099-47f8-8bad-c7314d8b0a5c","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.ok }}","rightValue":""}]},"looseTypeValidation":true},"typeVersion":2.3},{"id":"01707cfe-542a-4ef6-900c-5f7dd0a77db4","name":"Return Checkout Problem","type":"n8n-nodes-base.set","position":[-2368,4972],"parameters":{"options":{},"assignments":{"assignments":[{"id":"b691b776-9bc0-4041-b123-87fa2d6b5937","name":"success","type":"boolean","value":"={{ false }}"},{"id":"06a27e53-b92e-403c-826c-553719e2a0b3","name":"reason","type":"string","value":"={{ $json.problems.join('; ') }}"},{"id":"efc7507d-3c1a-456a-b01c-2b3a04a1a24c","name":"instruction","type":"string","value":"Explain the problem to the customer in simple words and help them fix it (change quantity, pick another item, or give the missing delivery details, which you save with save_delivery_details). Do not send a payment link."}]}},"typeVersion":3.4},{"id":"38dba0de-6cc0-4d7a-b4ae-3f8af011cf1f","name":"List Old Payment Links","type":"n8n-nodes-base.splitOut","position":[-2368,4332],"parameters":{"options":{"destinationFieldName":"sessionId"},"fieldToSplitOut":"oldSessionIds"},"typeVersion":1},{"id":"4a0ad01c-3881-4dc6-adf6-13d6dd5b066d","name":"Expire Old Payment Link","type":"n8n-nodes-base.httpRequest","onError":"cont