 s(r.customerName), question: s(r.question), customerMessage: s(r.customerMessage), status: s(r.status) || 'open', adminAnswer: s(r.adminAnswer), answeredAt: s(r.answeredAt), deliveredAt: s(r.deliveredAt), createdAt: s(r.createdAt) }));\nreturn [{ json: { result: { ok: true, orders, items, customers, products, escalations } } }];"},"typeVersion":2},{"id":"3a292546-d714-413f-aa1f-378251120e96","name":"Save order","type":"n8n-nodes-base.dataTable","position":[-3808,14732],"parameters":{"columns":{"value":{"City":"={{ $json.ctx.order.City }}","Notes":"={{ $json.ctx.order.Notes }}","Phone":"={{ $json.ctx.order.Phone }}","Total":"={{ $json.ctx.order.Total }}","Source":"={{ $json.ctx.order.Source }}","Status":"={{ $json.ctx.order.Status }}","Address":"={{ $json.ctx.order.Address }}","OrderID":"={{ $json.ctx.order.OrderID }}","Paid_At":"={{ $json.ctx.order.Paid_At }}","Landmark":"={{ $json.ctx.order.Landmark }}","Tracking":"={{ $json.ctx.order.Tracking }}","Full_Name":"={{ $json.ctx.order.Full_Name }}","Created_At":"={{ $json.ctx.order.Created_At }}","customer_id":"={{ $json.ctx.order.customer_id }}","Payment_Method":"={{ $json.ctx.order.Payment_Method }}"},"schema":[{"id":"OrderID","type":"string","display":true,"required":false,"displayName":"OrderID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"customer_id","type":"string","display":true,"required":false,"displayName":"customer_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Full_Name","type":"string","display":true,"required":false,"displayName":"Full_Name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Address","type":"string","display":true,"required":false,"displayName":"Address","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Phone","type":"string","display":true,"required":false,"displayName":"Phone","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Status","type":"string","display":true,"required":false,"displayName":"Status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Paym