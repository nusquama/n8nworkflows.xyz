search') {\n  const q = clean(b.query, 500);\n  if (!q) return out({ ok: false, error: 'Type something to search for.' });\n  return [{ json: Object.assign({ route: 'product_search', ctx: { vec: { op: 'search', query: q, limit: 6 } } }, base) }];\n}\nif (p.action === 'product_archive') {\n  const itemId = clean(b.Item_ID, 40);\n  if (!itemId || !/^[A-Za-z0-9_-]+$/.test(itemId)) return out({ ok: false, error: 'Missing product.' });\n  return [{ json: Object.assign({ route: 'product_archive', ctx: { itemId, archived: b.archived === true } }, base) }];\n}\nif (p.action === 'stripe_connect' || p.action === 'stripe_disconnect') {\n  const disconnect = p.action === 'stripe_disconnect';\n  const key = clean(b.secretKey, 300) || String(settings.stripeSecretKey || '');\n  const url = clean(b.webhook_url, 300);\n  if (url.indexOf('https://') !== 0) return out({ ok: false, error: 'Invalid webhook address.' });\n  if (!disconnect && !/^(sk|rk)_(test|live)_[A-Za-z0-9]{10,}$/.test(key)) return out({ ok: false, error: 'Paste a Stripe secret or restricted key. It starts with sk_ or rk_.' });\n  return [{ json: Object.assign({ route: 'save', result: null, writes: [], ctx: { stripe: { key, url, disconnect } } }, base) }];\n}\nreturn [{ json: d }];"},"typeVersion":2},{"id":"adb1fd2a-9052-4c34-b354-c794b847472e","name":"Shape vector input","type":"n8n-nodes-base.code","position":[-3088,13388],"parameters":{"jsCode":"const d = $('Extend actions').first().json;\nconst route = d.route;\nconst strip = (r) => ({ Item_ID: r.Item_ID, Name: r.Name || '', Price: r.Price == null ? 0 : r.Price, Stock_Status: r.Stock_Status == null ? 0 : r.Stock_Status, Product_Image: r.Product_Image || '', Description: r.Description || '', Sizes: r.Sizes || '', Colors: r.Colors || '' });\nif (route === 'vector_status' || route === 'product_search') return [{ json: Object.assign({ action: 'vector' }, d.ctx.vec) }];\nif (route === 'vector_sync_all') {\n  const rows = $('Get products to sync').all().map(i => i.json).filter(r => r.Item_ID && r.Status !== 'archived');\n  return [{ json: { action: 'vector', op: 'sync_all', products: rows.map(strip) } }];\n}\nif (route === 'product_delete') return [{ json: { action: 'vector', op: 'delete', itemId: d.ctx.itemId } }];\nconst product = route === 'product_archive' ? $('Prepare archive').first().json.ctx.product : d.ctx.product;\nif (product.Status === 'archived') return [{ json: { action: 'vector', op: 'delete', itemId: product.Item_ID } }];\nreturn [{ json: { action: 'vector', op: 'upsert', product: strip(product) } }];"},"typeVersion":2},{"id":"152a9a8f-76de-4344-a308-41f64b62cf89","name":"Run vector op","type":"n8n-nodes-base.executeWorkflow","onError":"continueRegularOutput","position":[-2848,13388],"parameters":{"options":{},"workflowId":{"__rl":true,"mode":"id","value":"={{ $workflow.id }}"}},"typeVersion":1.4},{"id":"5bec745d-33d9-4da1-85e2-a20fc23a2419","name":"Compose vector result","type":"n8n-nodes-base.code","position":[-2608,13388],"parameters":{"jsCode":"const d = $('Extend actions').first().json;\nconst route = d.route;\nconst r = $input.first().json || {};\nconst errText = (e) => String(e && e.message ? e.message : (e || 'unknown error'));\nconst ok = r.ok === true;\nconst err = ok ? '' : errText(r.error || 'The vector service did not respond.');\nconst res = (x) => [{ json: { result: x } }];\nif (route === 'vector_status') return res(ok ? { ok: true, ready: true, vectors: r.vectors, ids: r.ids } : { ok: false, error: err });\nif (route === 'vector_sync_all') return res(ok ? { ok: true, upserted: r.upserted, removed: r.removed } : { ok: false, error: err });\nif (route === 'product_search') return res(ok ? { ok: true, results: r.results } : { ok: false, error: err });\nif (route === 'product_delete') return res(ok ? { ok: true } : { ok: true, warning: 'Product deleted, but the search index could not be updated: ' + err });\nconst product = route === 'product_archive' ? $('Prepare archive').first().json.ctx.product : d.ctx.product;\nconst out = { ok: true, product };\nif (!ok) out.warning = 'Saved, but the search index could not be updated: ' + err;\nreturn res(out);"},"typeVersion":2},{"id":"93f29ac8-552d-444b-927a-28b2138de1c3","name":"Get products to sync","type":"n8n-nodes-base.dataTable","position":[-4048,14060],"parameters":{"operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Sales Products","cachedResultName":"Sales Products"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"6d88cd9a-a87d-46e2-af33-b37328255f47","name":"Find product to archive","type":"n8n-nodes-base.dataTable","position":[-4048,12156],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"Item_ID","keyValue":"={{ $json.ctx.itemId }}"}]},"matchType":"allConditions","operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"Sales Products","cachedResultName":"Sales Products"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"18901c17-78c1-4db6-958f-ec9f54bd5657","name":"Prepare archive","type":"n8n-nodes-base.code","position":[-3808,12156],"parameters":{"jsCode":"const c = $('Extend actions').first().json.ctx;\nconst r = $input.first().json || {};\nif (!r.Item_ID) return [{ json: { found: false } }];\nconst product = { Item_ID: r.Item_ID, Name: r.Name || '', Price: r.Price == null ? 0 : r.Price, Stock_Status: r.Stock_Status == null ? 0 : r.Stock_Status, Product_Image: r.Product_Image || '', Description: r.Description || '', Sizes: r.Sizes || '', Colors: r.Colors || '', Status: c.archived ? 'archived' : 'active' };\nreturn [{ json: { found: true, ctx: { product } } }];"},"typeVersion":2},{"id":"c2c4f652-6ea9-4ca7-a3d0-16732fe5463d","name":"Archive target found?","type":"n8n-nodes-base.if","position":[-3568,12156],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ String($json.found === true) }}","rightValue":"true"}]}},"typeVersion":2.3},{"id":"bedf1da1-8fad-4a0c-aea8-1903e8a0bff1","name":"Archive target missing","type":"n8n-nodes-base.code","position":[-3328,12236],"parameters":{"jsCode":"return [{ json: { result: { ok: false, error: 'That product no longer exists.' } } }];"},"typeVersion":2},{"id":"7d393221-0177-4bde-8c76-e107c1b52016","name":"Connect Stripe","type":"n8n-nodes-base.code","position":[-4048,10940],"parameters":{"jsCode":"const d = $input.first().json;\nconst c = d.ctx && d.ctx.stripe;\nif (!c) return [{ json: d }];\nconst base = { body: d.body, adminUsername: d.adminUsername, route: 'save' };\nconst fail = (m) => [{ json: Object.assign({ result: { ok: false, error: m }, writes: [] }, base) }];\nconst api = async (method, path, form) => {\n  const opts = { method, url: 'https://api.stripe.com' + path, headers: { Authorization: 'Bearer ' + c.key }, returnFullResponse: true, json: true };\n  if (form) { opts.headers['Content-Type'] = 'application/x-www-form-urlencoded'; opts.body = form; }\n  try {\n    const r = await this.helpers.httpRequest(opts);\n    return { status: r.statusCode, body: r.body || {} };\n  } catch (e) {\n    const resp = e.response || {};\n    let status = Number(resp.status || e.status || e.httpCode || e.statusCode || 0);\n    if (!status) { const m = /status code (\\d+)/.exec(String(e.message || '')); status = m ? Number(m[1]) : 0; }\n    const raw = resp.data || e.error || {};\n    return { status, body: typeof raw === 'object' ? raw : {} };\n  }\n};\nconst errMsg = (r) => {\n  const e = r.body && r.body.error;\n  const m = e && e.message ? e.message : ('HTTP ' + r.status);\n  if (r.status === 401) return 'Stripe rejected this key. Check that you copied the whole key.';\n  if (r.status === 403) return 'This key is missing a permission. ' + m;\n  if (!r.status) return 'Could not reach Stripe. Try again.';\n  return m;\n};\nconst cleared = ['stripeSecretKey', 'stripeWebhookSecret', 'stripeWebhookId', 'stripeAccountName', 'stripeMode', 'stripeLastEvent'].map(k => ({ settingKey: k, settingValue: '' }));\nif (!c.key) {\n  if (c.disconnect) return [{ json: Object.assign({ result: { ok: true }, writes: cleared }, base) }];\n  return fail('Paste your Stripe key first.');\n}\nconst list = await api('GET', '/v1/webhook_endpoints?limit=100');\nif (list.status !== 200) {\n  if (c.disconnect) return [{ json: Object.assign({ result: { ok: true, warning: 'Disconnected here, but Stripe could not be reached to remove the webhook: ' + errMsg(list) }, writes: cleared }, base) }];\n  return fail(errMsg(list));\n}\nconst mine = (list.body.data || []).filter(e => e.url === c.url);\nfor (const e of mine) { await api('DELETE', '/v1/webhook_endpoints/' + e.id); }\nif (c.disconnect) return [{ json: Object.assign({ result: { ok: true }, writes: cleared }, base) }];\nconst enc = encodeURIComponent;\nconst events = ['checkout.session.completed', 'checkout.session.async_payment_succeeded', 'checkout.session.async_payment_failed'];\nconst form = ['url=' + enc(c.url), 'description=' + enc('Sales Agent')].concat(events.map(ev => 'enabled_events[]=' + enc(ev))).join('&');\nconst created = await api('POST', '/v1/webhook_endpoints', form);\nif (created.status !== 200 || !created.body.secret) return fail('Could not create the Stripe webhook. ' + errMsg(created));\nlet name = '';\nconst acct = await api('GET', '/v1/account');\nif (acct.status === 200) {\n  const a = acct.body;\n  name = (a.settings && a.settings.dashboard && a.settings.dashboard.display_name) || (a.business_profile && a.business_profile.name) || a.email || '';\n}\nconst mode = c.key.indexOf('_live_') > -1 ? 'live' : 'test';\nconst writes = [\n  { settingKey: 'stripeSecretKey', settingValue: c.key },\n  { settingKey: 'stripeWebhookSecret', settingValue: created.body.secret },\n  { settingKey: 'stripeWebhookId', settingValue: created.body.id },\n  { settingKey: 'stripeAccountName', settingValue: name || 'Stripe account' },\n  { settingKey: 'stripeMode', settingValue: mode },\n  { settingKey: 'stripeLastEvent', settingValue: '' }\n];\nreturn [{ json: Object.assign({ result: { ok: true, name: name || 'Stripe account', mode }, writes }, base) }];"},"typeVersion":2},{"id":"bf228136-1c9b-44b5-a19b-28dc9248667e","name":"Stripe Webhook","type":"n8n-nodes-base.webhook","position":[-4048,11260],"webhookId":"bb4c0b4f-7b31-43c9-9fbb-b041dbd75e94","parameters":{"path":"shop-stripe-webhook","options":{"rawBody":true},"httpMethod":"POST","responseMode":"responseNode"},"typeVersion":2.1},{"id":"64f98521-19ec-4577-b905-793ddfeb1a37","name":"Read Stripe body","type":"n8n-nodes-base.code","position":[-3808,11260],"parameters":{"jsCode":"const h = $input.first().json.headers || {};\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nreturn [{ json: { raw: buf.toString('utf8'), sig: String(h['stripe-signature'] || '') } }];"},"typeVersion":2},{"id":"1428a105-a9f7-4e4c-8b5a-11f45de0d1a0","name":"Load Stripe secret","type":"n8n-nodes-base.dataTable","position":[-3568,11260],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"settingKey","keyValue":"stripeWebhookSecret"}]},"matchType":"allConditions","operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"Shop Settings","cachedResultName":"Shop Settings"}},"typeVersion":1.1},{"id":"8a2f797d-648a-43aa-9e37-c93d35bb7c3a","name":"Verify Stripe signature","type":"n8n-nodes-base.code","position":[-3328,11260],"parameters":{"jsCode":"const nodeCrypto = require('crypto');\nconst body = $('Read Stripe body').first().json;\nconst secret = String(($input.first().json || {}).settingValue || '');\nconst bad = (why) => [{ json: { valid: false, why } }];\nif (!secret || !body.sig) return bad('missing secret or signature');\nconst parts = {};\nbody.sig.split(',').forEach(s => { const i = s.indexOf('='); if (i > 0) { const k = s.slice(0, i).trim(); (parts[k] = parts[k] || []).push(s.slice(i + 1).trim()); } });\nconst t = parts.t && parts.t[0];\nconst v1 = parts.v1 || [];\nif (!t || !v1.length) return bad('malformed signature');\nif (Math.abs(Date.now() / 1000 - Number(t)) > 300) return bad('timestamp too old');\nconst expected = nodeCrypto.createHmac('sha256', secret).update(t + '.' + body.raw).digest('hex');\nconst match = v1.some(v => v.length === expected.length && nodeCrypto.timingSafeEqual(Buffer.from(v), Buffer.from(expected)));\nif (!match) return bad('signature mismatch');\nlet type = 'event';\ntry { type = String(JSON.parse(body.raw).type || 'event'); } catch (e) { type = 'event'; }\nreturn [{ json: { valid: true, eventNote: type + ' at ' + new Date().toISOString() } }];"},"typeVersion":2},{"id":"e27a2e90-4241-4932-9c45-61fa0b908a5e","name":"Signature valid?","type":"n8n-nodes-base.if","position":[-3088,11260],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ String($json.valid === true) }}","rightValue":"true"}]}},"typeVersion":2.3},{"id":"306c6eea-23ad-46ed-8d7f-b52169d46240","name":"Save Stripe event","type":"n8n-nodes-base.dataTable","position":[-2848,11100],"parameters":{"columns":{"value":{"settingKey":"stripeLastEvent","settingValue":"={{ $json.eventNote }}"},"schema":[{"id":"settingKey","type":"string","display":true,"required":false,"displayName":"settingKey","defaultMatch":false,"canBeUsedToMatch":true},{"id":"settingValue","type":"string","display":true,"required":false,"displayName":"settingValue","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow"},"filters":{"conditions":[{"keyName":"settingKey","keyValue":"stripeLastEvent"}]},"options":{},"matchType":"allConditions","operation":"upsert","dataTableId":{"__rl":true,"mode":"name","value":"Shop Settings","cachedResultName":"Shop Settings"}},"typeVersion":1.1},{"id":"d278483b-410c-4091-af73-757108787a92","name":"Respond: Stripe accepted","type":"n8n-nodes-base.respondToWebhook","position":[-2608,11100],"parameters":{"options":{"responseCode":200},"respondWith":"json","responseBody":"{\"received\":true}"},"typeVersion":1.5},{"id":"fbd6a688-afe0-4411-9060-0db89308797c","name":"Respond: Stripe rejected","type":"n8n-nodes-base.respondToWebhook","position":[-2848,11420],"parameters":{"options":{"responseCode":400},"respondWith":"json","responseBody":"{\"received\":false}"},"typeVersion":1.5},{"id":"3b3adcbf-9c46-46ac-b459-a0a6de5b2f78","name":"Extend orders","type":"n8n-nodes-base.code","position":[-2128,9196],"parameters":{"jsCode":"const d = $input.first().json;\nconst p = $('Parse API').first().json;\nconst b = p.body || {};\nconst clean = (v, max) => String(v == null ? '' : v).trim().slice(0, max);\nconst unknown = d.route === 'respond' && d.result && d.result.error === 'Unknown action.';\nif (!unknown) return [{ json: d }];\nconst base = { body: d.body, adminUsername: d.adminUsername };\nconst out = (result) => [{ json: Object.assign({ route: 'respond', result }, base) }];\nconst go = (route, ctx) => [{ json: Object.assign({ route, ctx: ctx || {} }, base) }];\nconst rndHex = (n) => require('crypto').randomBytes(n).toString('hex');\nconst num = (v) => Number(String(v == null ? '' : v).replace(',', '.'));\nconst STATUSES = ['Draft', 'Awaiting_Payment', 'Paid', 'Shipped', 'Delivered', 'Cancelled', 'Refunded', 'Abandoned'];\nif (p.action === 'orders_overview') return go('orders_overview');\nif (p.action === 'order_save') {\n  const o = b.order || {};\n  const status = clean(o.Status, 30) || 'Draft';\n  if (STATUSES.indexOf(status) < 0) return out({ ok: false, error: 'Unknown order status.' });\n  const given = clean(o.OrderID, 60);\n  if (given && !/^[A-Za-z0-9_-]+$/.test(given)) return out({ ok: false, error: 'Invalid order id.' });\n  const orderId = given || ('M' + Date.now().toString(36) + rndHex(2));\n  let items = null;\n  if (Array.isArray(b.items)) {\n    if (b.items.length > 50) return out({ ok: false, error: 'An order can have at most 50 lines.' });\n    items = [];\n    for (let i = 0; i < b.items.length; i++) {\n      const it = b.items[i] || {};\n      const name = clean(it.Product_Name, 200);\n      const qty = Math.floor(num(it.Quantity));\n      const price = num(it.Unit_Price);\n      const itemId = clean(it.Item_ID, 40);\n      if (!name) return out({ ok: false, error: 'Line ' + (i + 1) + ': choose a product.' });\n      if (!(qty >= 1) || qty > 1000) return out({ ok: false, error: 'Line ' + (i + 1) + ': quantity must be a whole number, 1 or more.' });\n      if (!isFinite(price) || price < 0) return out({ ok: false, error: 'Line ' + (i + 1) + ': price must be 0 or higher.' });\n      if (itemId && !/^[A-Za-z0-9_-]+$/.test(itemId)) return out({ ok: false, error: 'Line ' + (i + 1) + ': invalid product id.' });\n      items.push({ LineID: orderId + '-' + (i + 1), OrderID: orderId, Item_ID: itemId, Product_Name: name, Size: clean(it.Size, 40), Color: clean(it.Color, 40), Quantity: qty, Unit_Price: price, Image: clean(it.Image, 500) });\n    }\n  }\n  let total = (o.Total === '' || o.Total == null) ? NaN : num(o.Total);\n  if (!isFinite(total)) total = items ? items.reduce((s, x) => s + x.Quantity * x.Unit_Price, 0) : 0;\n  if (total < 0) return out({ ok: false, error: 'Total must be 0 or higher.' });\n  total = Math.round(total * 100) / 100;\n  const now = new Date().toISOString();\n  const paidLike = ['Paid', 'Shipped', 'Delivered'].indexOf(status) >= 0;\n  const order = { OrderID: orderId, customer_id: clean(o.customer_id, 60), Full_Name: clean(o.Full_Name, 120), Address: clean(o.Address, 400), City: clean(o.City, 80), Landmark: clean(o.Landmark, 200), Phone: clean(o.Phone, 40), Status: status, Payment_Method: clean(o.Payment_Method, 60), Total: total, Created_At: clean(o.Created_At, 40) || now, Paid_At: clean(o.Paid_At, 40) || (paidLike ? now : ''), Tracking: clean(o.Tracking, 200), Notes: clean(o.Notes, 2000), Source: clean(o.Source, 30) || 'manual' };\n  return go('order_save', { order, items, itemsProvided: items !== null });\n}\nif (p.action === 'order_delete') {\n  const id = clean(b.OrderID, 60);\n  if (!id || !/^[A-Za-z0-9_-]+$/.test(id)) return out({ ok: false, error: 'Missing order.' });\n  return go('order_delete', { orderId: id });\n}\nif (p.action === 'customer_save') {\n  const c = b.customer || {};\n  const name = clean(c.Name, 120);\n  if (!name) return out({ ok: false, error: 'Give the customer a name.' });\n  const given = clean(c.customer_id, 60);\n  if (given && !/^[A-Za-z0-9_.:-]+$/.test(given)) return out({ ok: false, error: 'Invalid customer id.' });\n  const customer = { customer_id: given || ('m' + Date.now().toString(36) + rndHex(2)), Name: name, Platform: clean(c.Platform, 30) || 'manual', Phone: clean(c.Phone, 40), Address: clean(c.Address, 400), Email: clean(c.Email, 120), Interests: clean(c.Interests, 300), Birthday: clean(c.Birthday, 30), Notes: clean(c.Notes, 2000) };\n  return go('customer_save', { customer });\n}\nif (p.action === 'customer_delete') {\n  const id = clean(b.customer_id, 60);\n  if (!id || !/^[A-Za-z0-9_.:-]+$/.test(id)) return out({ ok: false, error: 'Missing customer.' });\n  return go('customer_delete', { customerId: id });\n}\nreturn [{ json: d }];"},"typeVersion":2},{"id":"80626e3c-9211-48a0-96d9-0dc844b4003a","name":"Route orders","type":"n8n-nodes-base.switch","position":[-4048,14924],"parameters":{"rules":{"values":[{"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.route }}","rightValue":"orders_overview"}]}},{"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.route }}","rightValue":"order_save"}]}},{"conditions":{"options":{"version":1,"leftValue":"","caseSe