n: { result: { ok: true } } }];"},"typeVersion":2},{"id":"63ea86a8-03ce-4d43-88b4-36276ca27d68","name":"Shape preview input","type":"n8n-nodes-base.code","position":[-4048,17820],"parameters":{"jsCode":"return [{ json: Object.assign({ action: 'preview' }, $json.ctx) }];"},"typeVersion":2},{"id":"2d93fdd4-152a-4fb1-ad64-c7b9671d510e","name":"Run preview assistant","type":"n8n-nodes-base.executeWorkflow","onError":"continueRegularOutput","position":[-3808,17820],"parameters":{"options":{},"workflowId":{"__rl":true,"mode":"id","value":"={{ $workflow.id }}"}},"typeVersion":1.4},{"id":"1625c792-6fa5-44d2-9f6c-2faec6df25f6","name":"Compose preview","type":"n8n-nodes-base.code","position":[-3568,17820],"parameters":{"jsCode":"const r = $input.first().json || {};\nif (r.ok === true) return [{ json: { result: { ok: true, reply: r.reply } } }];\nreturn [{ json: { result: { ok: false, error: String((r.error && r.error.message) || r.error || 'The assistant could not answer right now.') } } }];"},"typeVersion":2},{"id":"601058f5-3120-42d8-b3ae-bc5012569c27","name":"Get all escalations","type":"n8n-nodes-base.dataTable","position":[-2848,14572],"parameters":{"operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Sales Escalations","cachedResultName":"Sales Escalations"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"ffc971f0-cb8a-48fa-8622-39650c755133","name":"More Module Webhook","type":"n8n-nodes-base.webhook","position":[-4048,8284],"webhookId":"87602f50-592b-4d5e-b4e6-62eb3555aa27","parameters":{"path":"shop-app-more","options":{},"responseMode":"responseNode"},"typeVersion":2.1},{"id":"05a664d3-a048-40f8-9b5b-9e3862e6d85e","name":"Render more module","type":"n8n-nodes-base.code","position":[-3808,8284],"parameters":{"jsCode":"const js = `(function () {\n  var FG = window.FG;\n  if (!FG || window.FG_MOD2) { return; }\n  var call = FG.call, ic = FG.ic, esc = FG.esc, $id = FG.$id, toast = FG.toast, busy = FG.busy, fail = FG.fail, money = FG.money, skeleton = FG.skeleton;\n  var NL = String.fromCharCode(10);\n  var css = '.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:16px}' +\n    '.stat{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px 14px;cursor:pointer;text-align:left;font-family:inherit;color:var(--text)}' +\n    '.stat.static{cursor:default}.stat small{display:block;color:var(--muted);font-size:12px;font-weight:600}.stat b{display:block;font-size:21px;margin-top:3px;letter-spacing:-.02em}' +\n    '.stat.warn{border-color:var(--warn)}.stat.warn b{color:var(--warn)}' +\n    '.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}' +\n    '.fc{border:1px solid var(--line);background:var(--panel);color:var(--muted);padding:6px 12px;border-radius:99px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit}.fc.on{background:var(--soft);color:var(--accent);border-color:transparent}' +\n    '.otable{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:var(--shadow);margin-bottom:12px}' +\n    '.orow{display:grid;gap:12px;align-items:start;padding:13px 16px;border-top:1px solid var(--line);cursor:pointer;font-size:13px;grid-template-columns:1.2fr 3fr 1fr}.orow:first-child{border-top:0}.orow:hover{background:var(--bg)}' +\n    '.orow.rec{grid-template-columns:1fr 1.5fr .8fr 1fr;cursor:default}.orow.rec:hover{background:none}.orow.lst{grid-template-columns:1fr auto;align-items:center;cursor:pointer}' +\n    '.sub{color:var(--muted);font-size:12px}.sheet.wide{max-width:760px}' +\n    '.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}' +\n    '.quote{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px 14px;font-size:14px;line-height:1.5;white-space:pre-wrap}' +\n    '.sect{margin-top:18px}.sect h3{font-size:12px;margin:0 0 8px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}' +\n    '.act{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}' +\n    '.chat{background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);display:flex;flex-direction:column;height:min(620px,70vh)}' +\n    '.msgs{flex:1;overflow:auto;padding:18px;display:flex;flex-direction:column;gap:10px}' +\n    '.msg{max-width:78%;padding:10px 14px;border-radius:16px;font-size:14px;line-height:1.5;white-space:pre-wrap}.msg.u{align-self:flex-end;background:linear-gradient(135deg,var(--accent),#7c3aed);color:#fff;border-bottom-right-radius:5px}.msg.a{align-self:flex-start;background:var(--bg);border:1px solid var(--line);border-bottom-left-radius:5px}.msg.t{color:var(--muted);font-style:italic}' +\n    '.cbar{display:flex;gap:8px;padding:12px;border-top:1px solid var(--line)}' +\n    '.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;line-height:1.5}' +\n    '@media(max-width:860px){.orow{grid-template-columns:1fr}.orow.rec{grid-template-columns:1fr 1fr}.two{grid-template-columns:1fr}.msg{max-width:92%}}';\n  var st = document.createElement('style');\n  st.textContent = css;\n  document.head.appendChild(st);\n\n  var REV = ['Paid', 'Shipped', 'Delivered'];\n  var OLABEL = { Draft: 'Draft', Awaiting_Payment: 'Awaiting payment', Paid: 'Paid', Shipped: 'Shipped', Delivered: 'Delivered', Cancelled: 'Cancelled', Refunded: 'Refunded', Abandoned: 'Abandoned' };\n  var OTONE = { Paid: 'ok', Shipped: 'ok', Delivered: 'ok', Awaiting_Payment: 'todo', Cancelled: 'bad', Refunded: 'bad' };\n  var cur = null;\n  function lc(s) { return String(s == null ? '' : s).trim().toLowerCase(); }\n  function sum(a, f) { return a.reduce(function (s, x) { return s + f(x); }, 0); }\n  function fmtDate(x) { if (!x) { return ''; } var d = new Date(x); return isNaN(d.getTime()) ? String(x) : d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); }\n  function fmtDT(x) { if (!x) { return ''; } var d = new Date(x); return isNaN(d.getTime()) ? String(x) : d.toLocaleString(); }\n  function orderNo(id) { return '#' + String(id || '').slice(-6).toUpperCase(); }\n  function ochip(s) { var t = OTONE[s]; return '<span class=\"chip' + (t ? ' ' + t : '') + '\" style=\"margin-left:0\">' + esc(OLABEL[s] || s) + '</span>'; }\n  function closeModal() { if (cur) { cur.remove(); cur = null; } }\n  function openModal() { closeModal(); var m = document.createElement('div'); m.className = 'modal'; m.innerHTML = '<div class=\"sheet wide\"></div>'; document.body.appendChild(m); cur = m; return m.firstChild; }\n  function msg(kind, t) { var b = $id('imsg'); if (b) { b.innerHTML = '<div class=\"alert ' + kind + '\">' + ic(kind === 'good' ? 'check' : 'alert', 16) + '<div>' + esc(t) + '</div></div>'; } else { toast(t, 5000); } }\n\n  /* ---------- Dashboard ---------- */\n  function dashboard(el) {\n    var who = FG.user && FG.user.username ? ', ' + esc(FG.user.username) : '';\n    var HEAD = '<div class=\"head\"><h1>Welcome back' + who + '</h1><p>Here is how your shop is doing.</p></div>';\n    el.innerHTML = HEAD + skeleton();\n    Promise.all([call('orders_overview'), call('get_settings'), call('errors_list')]).then(function (rs) {\n      var D = rs[0], S = rs[1], E = rs[2] || {};\n      if (!D.ok) { return fail(D); }\n      if (!S.ok) { return fail(S); }\n      var now = new Date();\n      var today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();\n      var week = Date.now() - 7 * 86400000;\n      function tm(o) { var x = Date.parse(o.Paid_At || o.Created_At); return isNaN(x) ? 0 : x; }\n      function created(o) { var x = Date.parse(o.Created_At); return isNaN(x) ? 0 : x; }\n      var paid = D.orders.filter(function (o) { return REV.indexOf(o.Status) >= 0; });\n      var toShip = D.orders.filter(function (o) { return o.Status === 'Paid'; }).length;\n      var awaiting = D.orders.filter(function (o) { return o.Status === 'Awaiting_Payment'; }).length;\n      var open = (D.escalations || []).filter(function (e) { return e.status === 'open' || e.status === 'answering'; }).length;\n      var low = D.products.filter(function (p) { return p.Status !== 'archived' && p.Stock_Status <= 3; }).sort(function (a, b) { return a.Stock_Status - b.Stock_Status; });\n      var recent = D.orders.slice().sort(function (a, b) { return created(b) - created(a); }).slice(0, 5);\n      var custById = {};\n      D.customers.forEach(function (c) { custById[c.customer_id] = c; });\n      var paidIds = {};\n      paid.forEach(function (o) { paidIds[o.OrderID] = true; });\n      var sold = {};\n      D.items.forEach(function (i) { if (paidIds[i.OrderID]) { var k = i.Item_ID || lc(i.Product_Name); sold[k] = sold[k] || { name: i.Product_Name, id: i.Item_ID, qty: 0, rev: 0 }; sold[k].qty += i.Quantity; sold[k].rev += i.Quantity * i.Unit_Price; } });\n      var top = Object.keys(sold).map(function (k) { return sold[k]; }).sort(function (a, b) { return b.qty - a.qty; }).slice(0, 5);\n      var f = S.fields;\n      var steps = [['Meta app details', f.metaAppId.saved && f.metaAppSecret.saved && f.metaVerifyToken.saved], ['Facebook Page connected', f.metaPageName.saved || f.metaPageAccessToken.saved], ['Stripe connected', f.stripeSecretKey.saved && f.stripeWebhookSecret.saved], ['First product added', D.products.length > 0]];\n      var doneN = steps.filter(function (s) { return s[1]; }).length;\n      var banner = (E.ok && E.newCount) ? '<div class=\"alert bad\" style=\"margin:0 0 16px\">' + ic('alert', 16) + '<div style=\"flex:1\"><b>' + E.newCount + ' problem' + (E.newCount > 1 ? 's' : '') + ' need attention.</b> Something failed in the background. Please contact your developer.</div><button class=\"btn sm\" data-go=\"errors\">View problems</button></div>' : '';\n      var att = [['ship', 'Orders to ship', toShip, toShip > 0], ['wait', 'Awaiting payment', awaiting, false], ['ask', 'Customer questions', open, open > 0], ['low', 'Low stock products', low.length, low.length > 0]];\n      el.innerHTML = HEAD + banner +\n        '<div class=\"stats\">' + att.map(function (a) { return '<button class=\"stat' + (a[3] ? ' warn' : '') + '\" data-go=\"' + a[0] + '\"><small>' + a[1] + '</small><b>' + a[2] + '</b></button>'; }).join('') + '</div>' +\n        '<div class=\"stats\"><div class=\"stat static\"><small>Orders today</small><b>' + D.orders.filter(function (o) { return created(o) >= today; }).length + '</b></div><div class=\"stat static\"><small>Revenue today</small><b>' + money(sum(paid.filter(function (o) { return tm(o) >= today; }), function (o) { return o.Total; })) + '</b></div><div class=\"stat static\"><small>Revenue, last 7 days</small><b>' + money(sum(paid.filter(function (o) { return tm(o) >= week; }), function (o) { return o.Total; })) + '</b></div><div class=\"stat static\"><small>Revenue, all time</small><b>' + money(sum(paid, function (o) { return o.Total; })) + '</b></div></div>' +\n        '<div class=\"card\"><div class=\"rowb\"><h2>Recent orders</h2><button class=\"btn ghost sm\" id=\"dall\">View all</button></div>' + (recent.length ? '<div style=\"margin-top:8px\">' + recent.map(function (o) { var c = custById[o.customer_id]; return '<div class=\"orow rec\"><div><b>' + esc(orderNo(o.OrderID)) + '</b><div class=\"sub\">' + esc(fmtDate(o.Created_At)) + '</div></div><div>' + esc((c && c.Name) || o.Full_Name || 'Customer') + '</div><div><b>' + money(o.Total) + '</b></div><div>' + ochip(o.Status) + '</div></div>'; }).join('') + '</div>' : '<p class=\"desc\">No orders yet. They appear here as soon as customers order in Messenger.</p>') + '</div>' +\n        '<div class=\"two\"><div class=\"card\"><h2>Best sellers</h2>' + (top.length ? top.map(function (t) { return '<div class=\"orow lst\" data-pid=\"' + esc(t.id) + '\"><div><b>' + esc(t.name) + '</b><div class=\"sub\">' + t.qty + ' sold</div></div><div><b>' + money(t.rev) + '</b></div></div>'; }).join('') : '<p class=\"desc\">Best sellers show up after the first paid orders.</p>') + '</div>' +\n        '<div class=\"card\"><h2>Low stock</h2>' + (low.length ? low.slice(0, 5).map(function (p) { return '<div class=\"orow lst\" data-pid=\"' + esc(p.Item_ID) + '\"><div><b>' + esc(p.Name) + '</b></div><div><span class=\"chip ' + (p.Stock_Status <= 0 ? 'bad' : 'todo') + '\">' + (p.Stock_Status <= 0 ? 'Sold out' : p.Stock_Status + ' left') + '</span></div></div>'; }).join('') : '<p class=\"desc\">Every product has enough stock.</p>') + '</div></div>' +\n        '<div class=\"card\"><div class=\"rowb\"><div><h2>Setup</h2><p class=\"desc\">' + doneN + ' of ' + steps.length + ' steps done.</p></div>' + (doneN < steps.length ? '<button class=\"btn sm\" id=\"dset\">Go to settings</button>' : '') + '</div>' + steps.map(function (s) { return '<div class=\"item\"><span class=\"dot ' + (s[1] ? 'ok' : '') + '\">' + (s[1] ? ic('check', 13) : '') + '</span>' + s[0] + '<span class=\"chip ' + (s[1] ? 'ok' : 'todo') + '\">' + (s[1] ? 'Done' : 'To do') + '</span></div>'; }).join('') + '</div>' ;\n      el.addEventListener('click', function (e) {\n        var b = e.target.closest('[data-go]');\n        if (b) { var g = b.getAttribute('data-go'); if (g === 'ask') { FG.goto('inbox'); } else if (g === 'low') { FG.goto('products'); } else if (g === 'errors') { FG.goto('errors'); } else { FG.goto('orders'); } return; }\n        var r = e.target.closest('[data-pid]');\n        if (r && r.getAttribute('data-pid')) { FG.goto('products', { focus: r.getAttribute('data-pid') }); }\n      });\n      $id('dall').addEventListener('click', function () { FG.goto('orders'); });\n      var ds = $id('dset'); if (ds) { ds.addEventListener('click', function () { FG.goto('settings'); }); }\n    });\n  }\n\n  /* ---------- Inbox ---------- */\n  var IF = 'open';\n  var ELAB = { open: 'Needs an answer', answering: 'Being answered', answered_pending_delivery: 'Answer saved', delivered: 'Answered', dismissed: 'Closed' };\n  var ETONE = { open: 'todo', answering: 'todo', answered_pending_delivery: 'todo', delivered: 'ok', dismissed: '' };\n  function echip(s) { var t = ETONE[s]; return '<span class=\"chip' + (t ? ' ' + t : '') + '\" style=\"margin-left:0\">' + esc(ELAB[s] || s) + '</span>'; }\n  function inbox(el) {\n    var HEAD = '<div class=\"head\"><h1>Inbox</h1><p>Questions your assistant could not answer on its own. Answer them here and the customer gets your reply.</p></div>';\n    el.innerHTML = HEAD + skeleton();\n    call('orders_overview').then(function (D) {\n      if (!D.ok) { return fail(D); }\n      var list = (D.escalations || []).slice().sort(function (a, b) { return Date.parse(b.createdAt) - Date.parse(a.createdAt); });\n      var cnt = { open: 0, wait: 0, done: 0 };\n      list.forEach(function (e) { if (e.status === 'open' || e.status === 'answering') { cnt.open++; } else if (e.status === 'answered_pending_delivery') { cnt.wait++; } else { cnt.done++; } });\n      el.innerHTML = HEAD + '<div class=\"chips\" id=\"ifc\"></div><div id=\"ilist\"></div>';\n      function match(e) {\n        if (IF === 'all') { return true; }\n        if (IF === 'open') { return e.status === 'open' || e.status === 'answering'; }\n        if (IF === 'wait') { return e.status === 'answered_pending_delivery'; }\n        return e.status === 'delivered' || e.status === 'dismissed';\n      }\n      function draw() {\n        var chips = [['open', 'Needs an answer', cnt.open], ['wait', 'Answer saved', cnt.wait], ['done', 'Answered or closed', cnt.done], ['all', 'All', list.length]];\n        $id('ifc').innerHTML = chips.map(function (c) { return '<button class=\"fc' + (IF === c[0] ? ' on' : '') + '\" data-f=\"' + c[0] + '\">' + c[1] + ' (' + c[2] + ')</button>'; }).join('');\n        var rows = list.filter(match);\n        if (!rows.length) { $id('ilist').innerHTML = '<div class=\"card empty\"><div class=\"big\">' + ic('inbox', 26) + '</div><h2>' + (IF === 'open' ? 'Nothing waiting for you' : 'Nothing here') + '</h2><p>' + (IF === 'open' ? 'When the assistant is not sure about something, such as discounts or refunds, the question appears here.' : 'Try another tab.') + '</p></div>'; return; }\n        $id('ilist').innerHTML = '<div class=\"otable\">' + rows.map(function (e) { return '<div class=\"orow\" data-id=\"' + esc(e.escalationId) + '\"><div><b>' + esc(e.customerName || 'Customer') + '</b><div class=\"sub\">' + esc(fmtDT(e.createdAt)) + '</div></div><div><div>' + esc(e.question) + '</div><div class=\"sub\">Customer wrote: ' + esc(e.customerMessage) + '</div></div><div>' + echip(e.status) + '</div></div>'; }).join('') + '</div>';\n      }\n      draw();\n      $id('ifc').addEventListener('click', function (e) { var b = e.target.closest('button[data-f]'); if (b) { IF = b.getAttribute('data-f'); draw(); } });\n      $id('ilist').addEventListener('click', function (e) { var r = e.target.closest('.orow[data-id]'); if (!r) { return; } var x = list.filter(function (q) { return q.escalationId === r.getAttribute('data-id'); })[0]; if (x) { openEsc(x, function () { inbox(el); }); } });\n    });\n  }\n  function openEsc(e, done) {\n    var sheet = openModal();\n    var canAnswer = e.status === 'open' || e.status === 'answering' || e.status === 'answered_pending_delivery';\n    sheet.innerHTML = '<div class=\"rowb\"><div><h2>' + esc(e.customerName || 'Customer') + '</h2><div class=\"sub\">' + esc(fmtDT(e.createdAt)) + ' - ' + esc(e.escalationId) + '</div></div><div style=\"display:flex;gap:8px;align-items:center\">' + echip(e.status) + '<button type=\"button\" class=\"btn ghost sm\" id=\"iclose\">Close</button></div></div><div id=\"imsg\"></div>' +\n      '<div class=\"sect\"><h3>The customer wrote</h3><div class=\"quote\">' + esc(e.customerMessage || '-') + '</div></div>' +\n      '<div class=\"sect\"><h3>What the assistant needs from you</h3><div class=\"quote\">' + esc(e.question) + '</div></div>' +\n      (canAnswer ? '<div class=\"sect\"><h3>Your answer</h3><textarea id=\"ians\" rows=\"4\" placeholder=\"Write the answer in plain words. The customer receives it as written.\">' + esc(e.adminAnswer) + '</textarea><p class=\"desc\" style=\"margin-top:8px\">Send now works when the customer wrote to your Page in the last 24 hours. Otherwise it is saved and the assistant gives it the next time they write.</p><div class=\"act\"><button type=\"button\" class=\"btn\" id=\"isend\">Send now on Messenger</button><button type=\"button\" class=\"btn ghost\" id=\"iqueue\">Save for next message</button><button type=\"button\" class=\"btn ghost\" id=\"idismiss\">Close without answering</button></div></div>' : (e.adminAnswer ? '<div class=\"sect\"><h3>Your answer</h3><div class=\"quote\">' + esc(e.adminAnswer) + '</div><div class=\"sub\" style=\"margin-top:6px\">' + (e.deliveredAt ? 'Delivered ' + esc(fmtDT(e.deliveredAt)) : (e.answeredAt ? 'Answered ' + esc(fmtDT(e.answeredAt)) : '')) + '</div></div>' : ''));\n    $id('iclose').addEventListener('click', closeModal);\n    function act(mode, btn) {\n      var ans = $id('ians') ? $id('ians').value.trim() : '';\n      if (mode !== 'dismiss' && ans.length < 2) { return msg('bad', 'Write an answer first.'); }\n      if (mode === 'dismiss' && !window.confirm('Close this question without answering?')) { return; }\n      busy(btn, true, 'Working...');\n      call('inbox_reply', { escalationId: e.escalationId, mode: mode, answer: ans }).then(function (res) {\n        busy(btn, false);\n        if (!res.ok) { if (res.error === 'unauthorized') { closeModal(); return fail(res); } return msg('bad', res.error); }\n        toast(res.note, 6000); closeModal(); done();\n      });\n    }\n    var s1 = $id('isend'); if (s1) { s1.addEventListener('click', function () { act('send', s1); }); }\n    var s2 = $id('iqueue'); if (s2) { s2.addEventListener('click', function () { act('queue', s2); }); }\n    var s3 = $id('idismiss'); if (s3) { s3.addEventListener('click', function () { act('dismiss', s3); }); }\n  }\n\n  /* ---------- Test chat ---------- */\n  var HIST = [];\n  function testChat(el) {\n    el.innerHTML = '<div class=\"head row2\"><div><h1>Test chat</h1><p>Chat with your assistant before customers do. It uses your live products and the instructions from Assistant settings. Carts and orders are not created here.</p></div><button class=\"btn ghost\" id=\"tclear\">Clear chat</button></div><div class=\"chat\"><div class=\"msgs\" id=\"tmsgs\"></div><form class=\"cbar\" id=\"tform\"><input id=\"tin\" placeholder=\"Type a customer message, for example: do you have anything black?\" autocomplete=\"off\"><button class=\"btn\" id=\"tsend\">Send</button></form></div>';\n    function paint() {\n      $id('tmsgs').innerHTML = HIST.length ? HIST.map(function (m) { return '<div class=\"msg ' + (m.role === 'user' ? 'u' : (m.role === 'typing' ? 'a t' : 'a')) + '\">' + esc(m.text) + '</div>'; }).join('') : '<div class=\"msg a t\">Say hello as a customer would. Try asking for a product, a size, a price or something your assistant should escalate.</div>';\n      var box = $id('tmsgs'); box.scrollTop = box.scrollHeight;\n    }\n    paint();\n    $id('tclear').addEventListener('click', function () { HIST = []; paint(); });\n    $id('tform').addEventListener('submit', function (ev) {\n      ev.preventDefault();\n      var t = $id('tin').value.trim();\n      if (!t) { return; }\n      var history = HIST.filter(function (m) { return m.role === 'user' || m.role === 'assistant'; }).map(function (m) { return { role: m.role, text: m.text }; });\n      HIST.push({ role: 'user', text: t });\n      HIST.push({ role: 'typing', text: 'The assistant is typing...' });\n      $id('tin').value = '';\n      var b = $id('tsend'); b.disabled = true;\n      paint();\n      call('preview_chat', { message: t, history: history }).then(function (res) {\n        HIST = HIST.filter(function (m) { return m.role !== 'typing'; });\n        if (!$id('tmsgs')) { return; }\n        b.disabled = false;\n        if (res.ok) { HIST.push({ role: 'assistant', text: res.reply }); }\n        else if (res.error === 'unauthorized') { return fail(res); }\n        else { HIST.push({ role: 'assistant', text: 'Could not get an answer: ' + res.error }); }\n        paint();\n        $id('tin').focus();\n      });\n    });\n    $id('tin').focus();\n  }\n\n  /* ---------- Assistant settings ---------- */\n  function assistant(el) {\n    var HEAD = '<div class=\"head\"><h1>Assistant</h1><p>The name of your store and the instructions your Messenger assistant follows. Changes apply to live conversations right away.</p></div>';\n    el.innerHTML = HEAD + skeleton();\n    call('config_get').then(function (r) {\n      if (!r.ok) { return fail(r); }\n      el.innerHTML = HEAD + '<div class=\"card\"><label for=\"astore\" style=\"margin-top:0\">Store name</label><input id=\"astore\" value=\"' + esc(r.storeName) + '\" placeholder=\"For example: Urban Threads\" autocomplete=\"off\"><p class=\"desc\" style=\"margin-top:6px\">Shown wherever the instructions use [STORE_NAME].</p><label for=\"aprompt\">Instructions</label><textarea id=\"aprompt\" rows=\"22\" class=\"mono\">' + esc(r.systemPrompt) + '</textarea><p class=\"desc\" style=\"margin-top:6px\">Tone, rules and what the assistant may or may not do. Keep the line breaks and headings, they help it follow the rules. Use Test chat to try a change.</p><div id=\"imsg\"></div><div class=\"act\"><button class=\"btn\" id=\"asave\">Save changes</button><button class=\"btn ghost\" id=\"atest\">Open Test chat</button></div></div>';\n      $id('atest').addEventListener('click', function () { FG.goto('test'); });\n      $id('asave').addEventListener('click', function () {\n        var p = $id('aprompt').value;\n        if (p.trim().length < 20) { return msg('bad', 'The instructions are too short.'); }\n        if (!window.confirm('Save these instructions? They apply to live customer conversations immediately.')) { return; }\n        var b = $id('asave'); busy(b, true, 'Saving...');\n        call('config_save', { storeName: $id('astore').value, systemPrompt: p }).then(function (res) {\n          busy(b, false);\n          if (!res.ok) { if (res.error === 'unauthorized') { return fail(res); } return msg('bad', res.error); }\n          toast('Saved. Try it in Test chat.', 4000);\n        });\n      });\n    });\n  }\n\n  /* ---------- Problems ---------- */\n  function area(node) {\n    var n = String(node || '');\n    if (/Facebook|Messenger|Typing|Reply|Pay Now|Send .* (Customer|Button)|Fallback/i.test(n)) { return 'Sending messages on Messenger'; }\n    if (/Stripe|Payment|Checkout/i.test(n)) { return 'Stripe payments'; }\n    if (/Agent|Gemini|Assistant|Preview/i.test(n)) { return 'The AI assistant'; }\n    if (/Drive|photo/i.test(n)) { return 'Product photos (Google Drive)'; }\n    if (/Vector|Embed|SQL|search/i.test(n)) { return 'Product search'; }\n    return 'The shop workflow';\n  }\n  function problems(el) {\n    var HEAD = '<div class=\"head\"><h1>Problems</h1><p>When something goes wrong in the background it is recorded here. If a problem keeps coming back, contact your developer and send them the report below.</p></div>';\n    el.innerHTML = HEAD + skeleton();\n    call('errors_list').then(function (r) {\n      if (!r.ok) { return fail(r); }\n      var list = r.errors || [];\n      if (!list.length) { el.innerHTML = HEAD + '<div class=\"card empty\"><div class=\"big\">' + ic('shield', 26) + '</div><h2>No problems recorded</h2><p>Everything has been running without errors. If something goes wrong it will show up here.</p></div>'; return; }\n      var groups = {}, order = [];\n      list.forEach(function (e) {\n        var k = e.failedNode + '|' + String(e.message).slice(0, 120);\n        if (!groups[k]) { groups[k] = { e: e, n: 0, fresh: 0, last: e.occurredAt }; order.push(k); }\n        var g = groups[k]; g.n++;\n        if (e.status === 'new') { g.fresh++; }\n        if (e.occurredAt > g.last) { g.last = e.occurredAt; }\n      });\n      var report = ['Shop problem report', 'Site: ' + location.origin, 'Created: ' + new Date().toISOString(), ''].concat(order.map(function (k) { var g = groups[k]; return '- ' + fmtDT(g.last) + ' | ' + area(g.e.failedNode) + ' | step: ' + g.e.failedNode + ' | ' + g.n + ' time(s) | ' + g.e.message + (g.e.executionId ? ' | execution ' + g.e.executionId : ''); })).join(NL);\n      el.innerHTML = HEAD +\n        '<div class=\"alert ' + (r.newCount ? 'bad' : 'info') + '\" style=\"margin:0 0 16px\">' + ic('alert', 16) + '<div>' + (r.newCount ? '<b>' + r.newCount + ' new problem' + (r.newCount > 1 ? 's' : '') + '.</b> Please contact your developer and send them the report below so they can fix it.' : 'No new problems. Earlier ones are listed below.') + '</div></div>' +\n        '<div class=\"act\" style=\"margin:0 0 14px\"><button class=\"btn\" id=\"eprep\">Show report for my developer</button><button class=\"btn ghost\" id=\"eseen\">Mark all as seen</button><button class=\"btn ghost\" id=\"eclr\">Clear seen history</button></div><div id=\"erep\"></div>' +\n        order.map(function (k) {\n          var g = groups[k];\n          var link = g.e.executionUrl && g.e.executionUrl.indexOf('https://') === 0 ? ' - <a href=\"' + esc(g.e.executionUrl) + '\" target=\"_blank\" rel=\"noopener\">Open execution in n8n</a>' : '';\n          return '<div class=\"card\" style=\"margin-bottom:12px\"><div class=\"rowb\"><div><b>' + esc(area(g.e.failedNode)) + '</b> <span class=\"sub\">- step \"' + esc(g.e.failedNode) + '\"</span></div><div>' + (g.fresh ? '<span class=\"chip bad\" style=\"margin-left:0\">New</span>' : '<span class=\"chip\" style=\"margin-left:0\">Seen</span>') + '</div></div><div class=\"quote\" style=\"margin-top:10px\">' + esc(g.e.message) + '</div>' + (g.e.hint ? '<p class=\"desc\" style=\"margin-top:8px\">' + esc(g.e.hint) + '</p>' : '') + '<div class=\"sub\" style=\"margin-top:6px\">' + g.n + ' time' + (g.n > 1 ? 's' : '') + ' - last ' + esc(fmtDT(g.last)) + link + '</div></div>';\n        }).join('');\n      $id('eprep').addEventListener('click', function () {\n        $id('erep').innerHTML = '<div class=\"card\"><label for=\"erepta\" style=\"margin-top:0\">Send this to your developer</label><textarea id=\"erepta\" rows=\"8\" class=\"mono\" readonly>' + esc(report) + '</textarea><div class=\"act\"><button class=\"btn sm\" id=\"ecopy\">Copy</button></div></div>';\n        $id('ecopy').addEventListener('click', function () { var ta = $id('erepta'); ta.select(); var ok = false; try { ok = document.execCommand('copy'); } catch (x) { ok = false; } toast(ok ? 'Copied. Paste it in a message to your developer.' : 'Selected. Press Ctrl+C to copy.', 4000); });\n      });\n      $id('eseen').addEventListener('click', function () {\n        var b = $id('eseen'); busy(b, true, 'Working...');\n        call('errors_dismiss').then(function (res) { if (!res.ok) { busy(b, false); return fail(res); } var pl = document.querySelector('.nav[data-v=\"errors\"] .pill'); if (pl) { pl.remove(); } toast('Marked as seen.'); problems(el); });\n      });\n      $id('eclr').addEventListener('click', function () {\n        if (!window.confirm('Delete the problems you have already marked as seen? New ones are kept.')) { return; }\n        var b = $id('eclr'); busy(b, true, 'Working...');\n        call('errors_clear').then(function (res) { if (!res.ok) { busy(b, false); return fail(res); } toast('Seen history cleared.'); problems(el); });\n      });\n    });\n  }\n\n  window.FG_MOD2 = { dashboard: dashboard, inbox: inbox, test: testChat, assistant: assistant, errors: problems };\n})();`;\nreturn [{ json: { js } }];"},"typeVersion":2},{"id":"ece3f794-eee8-406d-a0b9-318f3787fa61","name":"Respond: more module","type":"n8n-nodes-base.respondToWebhook","position":[-3568,8284],"parameters":{"options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Content-Type","value":"application/javascript; charset=utf-8"},{"name":"Cache-Control","value":"no-store"}]}},"respondWith":"text","responseBody":"={{ $json.js }}"},"typeVersion":1.5},{"id":"811b2d0a-f7ec-4062-8e42-4e627b977fb5","name":"Find existing product","type":"n8n-nodes-base.dataTable","position":[-4048,12396],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"Item_ID","keyValue":"={{ $json.ctx.product.Item_ID }}"}]},"matchType":"allConditions","operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"Sales Products","cachedResultName":"Sales Products"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"8c94c577-f662-4969-b5b6-e13bb2215835","name":"Photo replaced?","type":"n8n-nodes-base.if","position":[-3808,12396],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ String(String($json.Product_Image || '').indexOf('https://lh3.googleusercontent.com/d/') === 0 && String($json.Product_Image) !== String($('Extend more').first().json.ctx.product.Product_Image)) }}","rightValue":"true"}]}},"typeVersion":2.3},{"id":"019b38fb-1a3c-4f13-b962-198e8f7262d2","name":"Delete replaced photo","type":"n8n-nodes-base.googleDrive","onError":"continueRegularOutput","position":[-3568,12396],"parameters":{"fileId":{"__rl":true,"mode":"id","value":"={{ String($json.Product_Image).split('/d/')[1] }}"},"options":{"deletePermanently":true},"operation":"deleteFile"},"credentials":{"googleDriveOAuth2Api":{"id":"credential-id","name":"Google Drive account"}},"typeVersion":3},{"id":"4ddda997-f918-408c-9bb5-65d5c2cb2b72","name":"Product to save","type":"n8n-nodes-base.code","position":[-3328,12396],"parameters":{"jsCode":"return [{ json: $('Extend more').first().json }];"},"typeVersion":2},{"id":"d33dc171-0c78-45c1-8141-06abcd028b35","name":"Overview","type":"n8n-nodes-base.stickyNote","position":[-4128,-1100],"parameters":{"width":1200,"height":1040,"content":"### How it works\nAn AI sales agent for a clothing shop on Facebook Messenger, plus its own admin website, all in this one workflow.\n1. Customers message your Page. The workflow answers Meta's webhook, ignores duplicates and groups quick messages.\n2. A Gemini agent with chat memory answers from your products (exact lookup and search by meaning), manages the cart and saves delivery details step by step.\n3. After the customer confirms, it re-prices the cart and sends a Stripe Pay Now button.\n4. Stripe confirms the payment: the order is marked Paid, stock goes down and the customer is told.\n5. Questions the agent cannot answer wait in the admin Inbox. Failures appear on the Problems page.\n\n### Setup (do it in this order)\n1. In n8n: create three credentials: Google Gemini, Postgres (Supabase) and Google Drive.\n2. In n8n: select them on the nodes that show a warning, then Publish.\n3. In your browser: open /webhook/shop-admin, press \"Create database and first login\" and choose your own login.\n4. In the admin website, open Setup guide, then Settings: connect the Meta app and Facebook Page, then Stripe (test mode first).\n5. In the admin website: add Products, press Re-sync all, set the Store information on the Assistant page and try Test chat.\n6. In Messenger: send a test order from a tester account.\n\n### Customization\nEdit the store name, tone and shop information on the Assistant page.\n\n### Walkthrough video (2 min)\nhttps://drive.google.com/file/d/1HchY8S2IfqyadX-hvK1-ZiTB1pnUUkCl/view?usp=sharing"},"typeVersion":1},{"id":"7b1f0c52-3d6e-4a58-9c0e-5a2d8e41f001","name":"Setup Webhook","type":"n8n-nodes-base.webhook","position":[-4048,18812],"parameters":{"path":"shop-setup","options":{},"httpMethod":"POST","responseMode":"lastNode"},"typeVersion":2.1},{"id":"7b1f0c52-3d6e-4a58-9c0e-5a2d8e41f002","name":"Setup: create product search table","type":"n8n-nodes-base.postgres","onError":"continueRegularOutput","position":[-448,18652],"parameters":{"query":"create extension if not exists vector with schema extensions;\ncreate table if not exists public.sales_product_vectors (\n  item_id text primary key,\n  content text not null,\n  embedding vector(768) not null,\n  metadata jsonb not null default '{}'::jsonb,\n  updated_at timestamptz not null default now()\n);\nalter table public.sales_product_vectors enable row level security;\ncreate index if not exists sales_product_vectors_embedding_idx on public.sales_product_vectors using hnsw (embedding vector_cosine_ops);","options":{},"operation":"executeQuery"},"credentials":{"postgres":{"id":"credential-id","name":"Postgres account"}},"executeOnce":true,"typeVersion":2.7,"alwaysOutputData":true},{"id":"c3f10a00-5a1e-4b7d-9d20-000000000001","name":"Load verify token","type":"n8n-nodes-base.dataTable","position":[-3808,476],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"settingKey","keyValue":"metaVerifyToken"}]},"matchType":"allConditions","operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"Shop Settings","cachedResultName":"Shop Settings"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"c3f10a00-5a1e-4b7d-9d20-000000000002","name":"Load connections (messages)","type":"n8n-nodes-base.dataTable","position":[-3808,1580],"parameters":{"operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Shop Settings","cachedResultName":"Shop Settings"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"c3f10a00-5a1e-4b7d-9d20-000000000003","name":"Restore message input","type":"n8n-nodes-base.code","position":[-3568,1580],"parameters":{"jsCode":"return $('When Called By This Workflow').all();"},"typeVersion":2},{"id":"c3f10a00-5a1e-4b7d-9d20-000000000006","name":"Stripe Payment Event","type":"n8n-nodes-base.code","position":[-2848,11260],"parameters":{"jsCode":"let ev = {};\ntry { ev = JSON.parse($('Read Stripe body').first().json.raw); } catch (e) { return []; }\nif (['checkout.session.completed', 'checkout.session.async_payment_succeeded'].indexOf(ev.type) < 0) return [];\nreturn [{ json: ev }];"},"typeVersion":2},{"id":"c3f10a00-5a1e-4b7d-9d20-000000000007","name":"Load connections (stripe event)","type":"n8n-nodes-base.dataTable","position":[-4048,5804],"parameters":{"operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Shop Settings","cachedResultName":"Shop Settings"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"c3f10a00-5a1e-4b7d-9d20-000000000008","name":"Restore Stripe event","type":"n8n-nodes-base.code","position":[-3808,5804],"parameters":{"jsCode":"return $('Stripe Payment Event').all();"},"typeVersion":2},{"id":"c3f10a00-5a1e-4b7d-9d20-000000000009","name":"Load connections (return page)","type":"n8n-nodes-base.dataTable","position":[-3808,5564],"parameters":{"operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Shop Settings","cachedResultName":"Shop Settings"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"c3f10a00-5a1e-4b7d-9d20-000000000010","name":"Restore return page","type":"n8n-nodes-base.code","position":[-3568,5564],"parameters":{"jsCode":"return $('Payment Return Page').all();"},"typeVersion":2},{"id":"e7a10b00-6c2f-4d1e-8b30-000000000001","name":"Create table: Shop Errors","type":"n8n-nodes-base.dataTable","position":[-688,18652],"parameters":{"columns":{"column":[{"name":"occurredAt"},{"name":"workflowName"},{"name":"failedNode"},{"name":"message"},{"name":"hint"},{"name":"executionId"},{"name":"executionUrl"},{"name":"status"}]},"options":{"createIfNotExists":true},"resource":"table","operation":"create","tableName":"Shop Errors"},"executeOnce":true,"typeVersion":1.1},{"id":"e7a10b00-6c2f-4d1e-8b30-000000000002","name":"Save error log","type":"n8n-nodes-base.dataTable","onError":"continueRegularOutput","position":[-3568,7468],"parameters":{"columns":{"value":{"hint":"={{ $json.details.hint }}","status":"new","message":"={{ $json.details.message }}","failedNode":"={{ $json.details.failedNode }}","occurredAt":"={{ $now.toISO() }}","executionId":"={{ String($json.details.executionId || \"\") }}","executionUrl":"={{ $json.details.executionUrl }}","workflowName":"={{ $json.details.workflowName }}"},"schema":[{"id":"occurredAt","type":"string","display":true,"required":false,"displayName":"occurredAt","defaultMatch":false,"canBeUsedToMatch":true},{"id":"workflowName","type":"string","display":true,"required":false,"displayName":"workflowName","defaultMatch":false,"canBeUsedToMatch":true},{"id":"failedNode","type":"string","display":true,"required":false,"displayName":"failedNode","defaultMatch":false,"canBeUsedToMatch":true},{"id":"message","type":"string","display":true,"required":false,"displayName":"message","defaultMatch":false,"canBeUsedToMatch":true},{"id":"hint","type":"string","display":true,"required":false,"displayName":"hint","defaultMatch":false,"canBeUsedToMatch":true},{"id":"executionId","type":"string","display":true,"required":false,"displayName":"executionId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"executionUrl","type":"string","display":true,"required":false,"displayName":"executionUrl","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{},"dataTableId":{"__rl":true,"mode":"name","value":"Shop Errors","cachedResultName":"Shop Errors"}},"typeVersion":1.1},{"id":"e7a10b00-6c2f-4d1e-8b30-000000000003","name":"Get error log","type":"n8n-nodes-base.dataTable","position":[-3808,16508],"parameters":{"operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Shop Errors","cachedResultName":"Shop Errors"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"e7a10b00-6c2f-4d1e-8b30-000000000004","name":"Compose errors","type":"n8n-nodes-base.code","position":[-3568,16508],"parameters":{"jsCode":"const rows = $input.all().map((i) => i.json).filter((r) => r.failedNode || r.message);\nconst s = (v) => (v == null ? '' : String(v));\nconst errors = rows.map((r) => ({ occurredAt: s(r.occurredAt) || s(r.createdAt), workflowName: s(r.workflowName), failedNode: s(r.failedNode), message: s(r.message), hint: s(r.hint), executionId: s(r.executionId), executionUrl: s(r.executionUrl), status: s(r.status) || 'new' }));\nerrors.sort((a, b) => (a.occurredAt < b.occurredAt ? 1 : -1));\nreturn [{ json: { result: { ok: true, errors: errors.slice(0, 200), newCount: errors.filter((e) => e.status === 'new').length } } }];"},"typeVersion":2},{"id":"e7a10b00-6c2f-4d1e-8b30-000000000005","name":"Mark errors seen","type":"n8n-nodes-base.dataTable","position":[-3808,16668],"parameters":{"columns":{"value":{"status":"seen"},"schema":[{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"filters":{"conditions":[{"keyName":"status","keyValue":"new"}]},"options":{},"matchType":"allConditions","operation":"update","dataTableId":{"__rl":true,"mode":"name","value":"Shop Errors","cachedResultName":"Shop Errors"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"e7a10b00-6c2f-4d1e-8b30-000000000006","name":"Compose errors seen","type":"n8n-nodes-base.code","position":[-3568,16668],"parameters":{"jsCode":"return [{ json: { result: { ok: true } } }];"},"typeVersion":2},{"id":"e7a10b00-6c2f-4d1e-8b30-000000000007","name":"Clear seen errors","type":"n8n-nodes-base.dataTable","position":[-3808,16828],"parameters":{"filters":{"conditions":[{"keyName":"status","keyValue":"seen"}]},"options":{},"matchType":"allConditions","operation":"deleteRows","dataTableId":{"__rl":true,"mode":"name","value":"Shop Errors","cachedResultName":"Shop Errors"}},"executeOnce":true,"typeVersion":1.1,"alwaysOutputData":true},{"id":"e7a10b00-6c2f-4d1e-8b30-000000000008","name":"Compose errors cleared","type":"n8n-nodes-base.code","position":[-3568,16828],"parameters":{"jsCode":"return [{ json: { result: { ok: true } } }];"},"typeVersion":2},{"id":"d3115e00-7a1e-4c0d-9d30-000000000001","name":"Delivery: Get Order","type":"n8n-nodes-base.dataTable","position":[-4048,3836],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"OrderID","keyValue":"={{ $('When Called By This Workflow').first().json.targetOrderId || $('When Called By This Workflow').first().json.orderId }}"}]},"matchType":"allConditions","operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"Sales Orders","cachedResultName":"Sales Orders"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"d3115e00-7a1e-4c0d-9d30-000000000002","name":"Delivery: Get Customer Orders","type":"n8n-nodes-base.dataTable","position":[-3808,3836],"parameters":{"filters":{"conditions":[{"keyName":"customer_id","keyValue":"={{ $('When Called By This Workflow').first().json.customerId }}"}]},"matchType":"allConditions","operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Sales Orders","cachedResultName":"Sales Orders"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"d3115e00-7a1e-4c0d-9d30-000000000003","name":"Delivery: Merge Details","type":"n8n-nodes-base.code","position":[-3568,3836],"parameters":{"jsCode":"// Saves delivery details on the order a little at a time, keeps only valid values,\n// and tells the AI what is still missing. Only the customer's own order can be changed.\nconst input = $('When Called By This Workflow').first().json;\nconst order = $('Delivery: Get Order').first().json;\nconst all = $('Delivery: Get Customer Orders').all().map((i) => i.json).filter((r) => r.OrderID);\nconst clean = (v, max) => String(v == null ? '' : v).replace(/\\s+/g, ' ').trim().slice(0, max);\nconst yes = (v) => v === true || String(v).toLowerCase() === 'true';\nconst digits = (v) => String(v || '').replace(/\\D/g, '');\nconst out = (result, extra) => [{ json: Object.assign({ shouldSave: false, paidChange: false, orderId: '', result }, extra || {}) }];\n\nconst orderId = String(input.targetOrderId || input.orderId || '').trim();\nconst status = String(order.Status || '').trim() || 'Draft';\nif (!order.OrderID || String(order.OrderID) !== orderId || String(order.customer_id) !== String(input.customerId)) {\n  return out({ success: false, problems: ['order not found'], instruction: 'Tell the customer you could not find that order. Call get_my_orders to find the right OrderID.' });\n}\nif (!['Draft', 'Awaiting_Payment', 'Paid'].includes(status)) {\n  const parcel = ['Shipped', 'Delivered'].includes(status);\n  return out({ success: false, orderId, orderStatus: status, problems: ['this order is ' + status + ', so its delivery details cannot be changed here'], instruction: parcel ? 'The parcel is already on its way, so escalate this address change to the team.' : 'Explain that this order is ' + status + ' and offer to start a new order.' });\n}\n\nconst FIELDS = { Full_Name: ['full_name', 'full name', 120], Phone: ['phone', 'phone number', 20], City: ['city', 'city', 80], Address: ['address', 'street / area address', 300], Landmark: ['landmark', 'landmark', 150] };\nconst incoming = { Full_Name: clean(input.fullName, 120), Phone: String(input.phone || '').replace(/[^\\d+]/g, '').slice(0, 20), City: clean(input.city, 80), Address: clean(input.address, 300), Landmark: clean(input.landmark, 150) };\nconst current = { Full_Name: clean(order.Full_Name, 120), Phone: String(order.Phone || '').replace(/[^\\d+]/g, '').slice(0, 20), City: clean(order.City, 80), Address: clean(order.Address, 300), Landmark: clean(order.Landmark, 150) };\nconst problems = [];\nconst bad = {};\nif (incoming.Full_Name && incoming.Full_Name.length < 2) { bad.Full_Name = true; problems.push('the name is too short'); }\nif (incoming.Phone && (digits(incoming.Phone).length < 7 || digits(incoming.Phone).length > 15)) { bad.Phone = true; problems.push('the phone number does not look valid'); }\nif (incoming.City && incoming.City.length < 2) { bad.City = true; problems.push('the city is too short'); }\nif (incoming.Address && incoming.Address.length < 5) { bad.Address = true; problems.push('the street / area address is too short'); }\n\nconst merged = {};\nlet changed = false;\nfor (const k of Object.keys(FIELDS)) {\n  if (incoming[k] && !bad[k]) { merged[k] = incoming[k]; if (incoming[k] !== current[k]) changed = true; }\n  else merged[k] = current[k];\n}\nconst missing = ['Full_Name', 'Phone', 'City', 'Address'].filter((k) => (k === 'Phone' ? digits(merged.Phone).length < 7 : merged[k].length < (k === 'Address' ? 5 : 2)));\n\nlet previous = null;\nif (missing.length) {\n  const prev = all\n    .filter((r) => String(r.OrderID) !== orderId && clean(r.Address, 300) && digits(r.Phone).length >= 7)\n    .sort((a, b) => String(b.Created_At || '').localeCompare(String(a.Created_At || '')))[0];\n  if (prev) previous = { full_name: clean(prev.Full_Name, 120), phone: clean(prev.Phone, 20), city: clean(prev.City, 80), address: clean(prev.Address, 300), landmark: clean(prev.Landmark, 150) };\n}\n\nconst wasConfirmed = yes(order.Address_Confirmed);\nlet confirmed = wasConfirmed;\nif (status === 'Paid') confirmed = true;\nelse if (yes(input.confirmed)) {\n  if (missing.length || problems.length) { confirmed = false; problems.push('cannot confirm yet, still missing: ' + (missing.map((k) => FIELDS[k][1]).join(', ') || 'valid details')); }\n  else confirmed = true;\n} else if (changed) confirmed = false;\n\nconst paidChange = status === 'Paid' && changed;\nconst notes = paidChange ? (String(order.Notes || '') ? String(order.Notes) + ' | ' : '') + 'Customer changed the delivery details on ' + $now.toFormat('yyyy-MM-dd HH:mm') : String(order.Notes || '');\n\nlet instruction;\nif (problems.length) instruction = 'Some details could not be saved: ' + problems.join('; ') + '. Ask the customer to correct them in simple words.';\nelse if (missing.length) instruction = 'Ask the customer for: ' + missing.map((k) => FIELDS[k][1]).join(', ') + '.' + (previous ? ' They ordered before: offer previous_details and save them if the customer agrees.' : '') + (merged.Full_Name && !incoming.Full_Name && !current.Phone && !current.Address ? ' The name on the order is \"' + merged.Full_Name + '\": ask which name to put on the parcel.' : '');\nelse if (status === 'Paid') instruction = changed ? 'The delivery details of this paid order were updated and the team was told. Tell the customer the new details.' : 'Show the saved delivery details to the customer.';\nelse if (!confirmed) instruction = 'All delivery details are saved. Show the final order review (items, total, delivery details) and ask the customer to confirm. After a clear yes, call this tool again with customer_confirmed true.';\nelse instruction = 'The delivery details are confirmed. You can now call checkout_and_send_payment_link.';\n\nreturn out({\n  success: problems.length === 0,\n  orderId,\n  orderStatus: status,\n  saved: { full_name: merged.Full_Name, phone: merged.Phone, city: merged.City, address: merged.Address, landmark: merged.Landmark, confirmed },\n  missing: missing.map((k) => FIELDS[k][1]),\n  previous_details: previous,\n  problems,\n  instruction,\n}, { shouldSave: changed || confirmed !== wasConfirmed, paidChange, orderId, update: Object.assign({}, merged, { Address_Confirmed: confirmed, Notes: notes }) });"},"typeVersion":2},{"id":"d3115e00-7a1e-4c0d-9d30-000000000005","name":"Delivery: Save needed?","type":"n8n-nodes-base.if","position":[-3328,3836],"parameters":{"options":{},"conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"d3115e00-7a1e-4c0d-9d30-+1234567890","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.shouldSave }}","rightValue":""}]},"looseTypeValidation":true},"typeVersion":2.3},{"id":"d3115e00-7a1e-4c0d-9d30-000000000006","name":"Delivery: Save Order","type":"n8n-nodes-base.dataTable","position":[-3088,3836],"parameters":{"columns":{"value":{"City":"={{ $json.update.City }}","Notes":"={{ $json.update.Notes }}","Phone":"={{ $json.update.Phone }}","Address":"={{ $json.update.Address }}","Landmark":"={{ $json.update.Landmark }}","Full_Name":"={{ $json.update.Full_Name }}","Address_Confirmed":"={{ $json.update.Address_Confirmed }}"},"schema":[{"id":"Full_Name","type":"string","display":true,"required":false,"displayName":"Full_Name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Phone","type":"string","display":true,"required":false,"displayName":"Phone","defaultMatch":false,"canBeUsedToMatch":true},{"id":"City","type":"string","display":true,"required":false,"displayName":"City","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Address","type":"string","display":true,"required":false,"displayName":"Address","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Landmark","type":"string","display":true,"required":false,"displayName":"Landmark","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Address_Confirmed","type":"boolean","display":true,"required":false,"displayName":"Address_Confirmed","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Notes","type":"string","display":true,"required":false,"displayName":"Notes","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"filters":{"conditions":[{"keyName":"OrderID","keyValue":"={{ $json.orderId }}"}]},"options":{},"matchType":"allConditions","operation":"update","dataTableId":{"__rl":true,"mode":"name","value":"Sales Orders","cachedResultName":"Sales Orders"}},"typeVersion":1.1},{"id":"d3115e00-7a1e-4c0d-9d30-000000000011","name":"Delivery: Reply","type":"n8n-nodes-base.code","position":[-2848,3836],"parameters":{"jsCode":"return [{ json: $('Delivery: Merge Details').first().json.result }];"},"typeVersion":2},{"id":"d3115e00-7a1e-4c0d-9d30-000000000013","name":"save_delivery_details","type":"@n8n/n8n-nodes-langchain.toolWorkflow","position":[1440,3004],"parameters":{"workflowId":{"__rl":true,"mode":"id","value":"={{ $workflow.id }}"},"description":"Saves and reads the delivery details of an order. Call it with NO fields first to see what is saved, what is still missing and the customer's previous details. Pass ONLY the fields the customer just gave or changed: full_name, phone, city, address (street / area), landmark. Pass customer_confirmed=true ONLY after the customer said yes to the final order review (items, total and delivery details). Use order_id only to change the address of an already PAID order (OrderID from get_my_orders); leave it empty for the current cart. Works until the order is Shipped. Returns the saved details, what is missing and an instruction you must follow.","workflowInputs":{"value":{"city":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('city', `City or town for delivery. Leave empty if not given or changed`, 'string', '') }}","phone":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('phone', `Customer's contact phone number. Leave empty if not given or changed`, 'string', '') }}","action":"delivery","address":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('address', `Street / area / house details for delivery (without the city). Leave empty if not given or changed`, 'string', '') }}","orderId":"={{ $('Current Order').first().json.OrderID }}","fullName":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('full_name', `Full name for the parcel. Leave empty if the customer did not give or change it`, 'string', '') }}","landmark":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('landmark', `Nearby landmark or delivery note, optional. Leave empty if none`, 'string', '') }}","confirmed":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('customer_confirmed', `true ONLY if the customer just said yes to the final order review. Otherwise false`, 'boolean', false) }}","customerId":"={{ $('Message Context').first().json.customerId }}","targetOrderId":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('order_id', `OrderID of an already PAID order whose delivery details must change. Leave empty for the current cart`, 'string', '') }}"},"schema":[{"id":"action","type":"string","display":true,"required":false,"displayName":"action","defaultMatch":false,"canBeUsedToMatch":true},{"id":"orderId","type":"string","display":true,"required":false,"displayName":"orderId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"customerId","type":"string","display":true,"required":false,"displayName":"customerId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"targetOrderId","type":"string","display":true,"required":false,"displayName":"targetOrderId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"fullName","type":"string","display":true,"required":false,"displayName":"fullName","defaultMatch":false,"canBeUsedToMatch":true},{"id":"phone","type":"string","display":true,"required":false,"displayName":"phone","defaultMatch":false,"canBeUsedToMatch":true},{"id":"city","type":"string","display":true,"required":false,"displayName":"city","defaultMatch":false,"canBeUsedToMatch":true},{"id":"address","type":"string","display":true,"required":false,"displayName":"address","defaultMatch":false,"canBeUsedToMatch":true},{"id":"landmark","type":"string","display":true,"required":false,"displayName":"landmark","defaultMatch":false,"canBeUsedToMatch":true},{"id":"confirmed","type":"boolean","display":true,"required":false,"displayName":"confirmed","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false}},"typeVersion":2.2},{"id":"e7e1e600-7a1e-4c0d-9d40-000000000001","name":"Build error details","type":"n8n-nodes-base.set","position":[-3808,7468],"parameters":{"options":{},"assignments":{"assignments":[{"id":"4ed8d311-cc92-41be-bad5-52705d4d1880","name":"details","type":"object","value":"={{ (() => {\n  const e = $('When This Workflow Fails').first().json;\n  const exec = e.execution || {};\n  const trig = e.trigger || {};\n  const err = exec.error || trig.error || {};\n  const message = String(err.message || err.description || 'Unknown error');\n  let hint = 'Open the execution to see which node failed.';\n  if (/credential|unauthori[sz]ed|401|403|oauth|token/i.test(message)) hint = 'Looks like a login/credential problem: reconnect the credential in n8n > Credentials.';\n  else if (/429|rate limit|quota|too many/i.test(message)) hint = 'Rate limit or quota reached (Gemini / Meta / Stripe). It usually recovers by itself; check if it keeps happening.';\n  else if (/timeout|timed out|ETIMEDOUT|ECONNRESET|socket/i.test(message)) hint = 'Network timeout talking to an external service. Usually temporary.';\n  else if (/outside of allowed window|2018278|24.?hour/i.test(message)) hint = 'Messenger 24-hour window: we can only message a customer within 24h of their last message.';\n  else if (/stripe/i.test(message)) hint = 'Stripe error: check the Stripe dashboard (API key, account status, amount).';\n  return {\n    workflowName: (e.workflow && e.workflow.name) || 'Unknown workflow',\n    executionId: exec.id || '',\n    executionUrl: exec.url || '',\n    failedNode: exec.lastNodeExecuted || (trig.error && trig.error.node && trig.error.node.name) || 'unknown',\n    message: message.slice(0, 600),\n    hint,\n    at: $now.toFormat('yyyy-MM-dd HH:mm:ss ZZZZ'),\n  };\n})() }}"}]}},"typeVersion":3.4},{"id":"e7e1e600-7a1e-4c0d-9d40-000000000002","name":"Log: assistant could not answer","type":"n8n-nodes-base.dataTable","onError":"continueRegularOutput","position":[2912,2268],"parameters":{"columns":{"value":{"hint":"Check the Gemini key and quota in n8n Credentials, then open the run to see why the assistant failed.","status":"new","message":"={{ 'The customer got a \"please send again\" reply because the assistant could not answer. Their message: ' + String($('Combine Messages').first().json.combinedText || '(attachment)').slice(0, 300) }}","failedNode":"Send Fallback Reply","occurredAt":"={{ $now.toISO() }}","executionId":"={{ String($execution.id) }}","executionUrl":"={{ (String($execution.resumeUrl || '').split('/webhook-waiting/')[0] || '') + '/workflow/' + $workflow.id + '/executions/' + $execution.id }}","workflowName":"={{ $workflow.name }}"},"schema":[{"id":"occurredAt","type":"string","display":true,"required":false,"displayName":"occurredAt","defaultMatch":false,"canBeUsedToMatch":true},{"id":"workflowName","type":"string","display":true,"required":false,"displayName":"workflowName","defaultMatch":false,"canBeUsedToMatch":true},{"id":"failedNode","type":"string","display":true,"required":false,"displayName":"failedNode","defaultMatch":false,"canBeUsedToMatch":true},{"id":"message","type":"string","display":true,"required":false,"displayName":"message","defaultMatch":false,"canBeUsedToMatch":true},{"id":"hint","type":"string","display":true,"required":false,"displayName":"hint","defaultMatch":false,"canBeUsedToMatch":true},{"id":"executionId","type":"string","display":true,"required":false,"displayName":"executionId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"executionUrl","type":"string","display":true,"required":false,"displayName":"executionUrl","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{},"dataTableId":{"__rl":true,"mode":"name","value":"Shop Errors","cachedResultName":"Shop Errors"}},"typeVersion":1.1},{"id":"e7e1e600-7a1e-4c0d-9d40-000000000003","name":"Log: reply not delivered","type":"n8n-nodes-base.dataTable","onError":"continueRegularOutput","position":[2912,1788],"parameters":{"columns":{"value":{"hint":"Messenger only allows replies within 24 hours of the last customer message. Also check the Facebook connection in Settings.","status":"new","message":"={{ 'Messenger did not accept the reply to the customer: ' + String(($json.error && ($json.error.message || $json.error.description)) || 'unknown error') }}","failedNode":"Send Text Reply to Customer","occurredAt":"={{ $now.toISO() }}","executionId":"={{ String($execution.id) }}","executionUrl":"={{ (String($execution.resumeUrl || '').split('/webhook-waiting/')[0] || '') + '/workflow/' + $workflow.id + '/executions/' + $execution.id }}","workflowName":"={{ $workflow.name }}"},"schema":[{"id":"occurredAt","type":"string","display":true,"required":false,"displayName":"occurredAt","defaultMatch":false,"canBeUsedToMatch":true},{"id":"workflowName","type":"string","display":true,"required":false,"displayName":"workflowName","defaultMatch":false,"canBeUsedToMatch":true},{"id":"failedNode","type":"string","display":true,"required":false,"displayName":"failedNode","defaultMatch":false,"canBeUsedToMatch":true},{"id":"message","type":"string","display":true,"required":false,"displayName":"message","defaultMatch":false,"canBeUsedToMatch":true},{"id":"hint","type":"string","display":true,"required":false,"displayName":"hint","defaultMatch":false,"canBeUsedToMatch":true},{"id":"executionId","type":"string","display":true,"required":false,"displayName":"executionId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"executionUrl","type":"string","display":true,"required":false,"displayName":"executionUrl","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{},"dataTableId":{"__rl":true,"mode":"name","value":"Shop Errors","cachedResultName":"Shop Errors"}},"typeVersion":1.1},{"id":"e7e1e600-7a1e-4c0d-9d40-000000000005","name":"Payment message failed?","type":"n8n-nodes-base.if","position":[-208,5644],"parameters":{"options":{},"conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"e7e1e600-7a1e-4c0d-9d40-+1234567890","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ !!$('Send Payment Confirmation').first().json.error }}","rightValue":""}]},"looseTypeValidation":true},"typeVersion":2.3},{"id":"e7e1e600-7a1e-4c0d-9d40-000000000006","name":"Log: payment message not sent","type":"n8n-nodes-base.dataTable","onError":"continueRegularOutput","position":[32,5644],"parameters":{"columns":{"value":{"hint":"Contact the customer yourself to confirm their payment.","status":"new","message":"={{ 'Order ' + $('Paid Session').first().json.session.metadata.order_id + ' was paid, but the Messenger confirmation could not be sent to the customer.' }}","failedNode":"Send payment message to customer","occurredAt":"={{ $now.toISO() }}","executionId":"={{ String($execution.id) }}","executionUrl":"={{ (String($execution.resumeUrl || '').split('/webhook-waiting/')[0] || '') + '/workflow/' + $workflow.id + '/executions/' + $execution.id }}","workflowName":"={{ $workflow.name }}"},"schema":[{"id":"occurredAt","type":"string","display":true,"required":false,"displayName":"occurredAt","defaultMatch":false,"canBeUsedToMatch":true},{"id":"workflowName","type":"string","display":true,"required":false,"displayName":"workflowName","defaultMatch":false,"canBeUsedToMatch":true},{"id":"failedNode","type":"string","display":true,"required":false,"displayName":"failedNode","defaultMatch":false,"canBeUsedToMatch":true},{"id":"message","type":"string","display":true,"required":false,"displayName":"message","defaultMatch":false,"canBeUsedToMatch":true},{"id":"hint","type":"string","display":true,"required":false,"displayName":"hint","defaultMatch":false,"canBeUsedToMatch":true},{"id":"executionId","type":"string","display":true,"required":false,"displayName":"executionId","defaultMatch":false,"canBeUsedToMatch":true},{"id":"executionUrl","type":"string","display":true,"required":false,"displayName":"executionUrl","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{},"dataTableId":{"__rl":true,"mode":"name","value":"Shop Errors","cachedResultName":"Shop Errors"}},"typeVersion":1.1},{"id":"e7e1e600-7a1e-4c0d-9d40-000000000008","name":"Answer sent?","type":"n8n-nodes-base.if","position":[-2128,15868],"parameters":{"options":{},"conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"e7e1e600-7a1e-4c0d-9d40-+1234567890","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $('Finish send').isExecuted && $('Finish send').first().json.sent === true }}","rightValue":""}]},"looseTypeValidation":true},"typeVersion":2.3},{"id":"a9d3c100-5b1e-4c7a-9e50-000000000001","name":"Guide Module Webhook","type":"n8n-nodes-base.webhook","position":[-4048,8444],"webhookId":"a9d3c100-5b1e-4c7a-9e50-0000000000a1","parameters":{"path":"shop-app-guide","options":{},"httpMethod":"GET","responseMode":"responseNode"},"typeVersion":2.1},{"id":"a9d3c100-5b1e-4c7a-9e50-000000000002","name":"Render guide module","type":"n8n-nodes-base.code","position":[-3808,8444],"parameters":{"jsCode":"const js = `(function () {\n  var FG = window.FG;\n  if (!FG || window.FG_MOD3) { return; }\n  var call = FG.call, ic = FG.ic, esc = FG.esc, $id = FG.$id, toast = FG.toast, fail = FG.fail, skeleton = FG.skeleton;\n  var css = '.act{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}';\n  var st = document.createElement('style');\n  st.textContent = css;\n  document.head.appendChild(st);\n\n  /* ---------- Setup guide ---------- */\n  function guide(el) {\n    var HEAD = '<div class=\"head\"><h1>Setup guide</h1><p>Everything you need to connect before customers can buy. Work through the steps in order. Steps marked Done are already working.</p></div>';\n    el.innerHTML = HEAD + skeleton();\n    Promise.all([call('get_settings'), call('vector_status'), call('products_list')]).then(function (rs) {\n      var S = rs[0], V = rs[1] || {}, P = rs[2] || {};\n      if (!S.ok) { return fail(S); }\n      if (V.error === 'unauthorized') { return fail(V); }\n      var f = S.fields;\n      var CHAT = new URL('chat', location.href).href;\n      var FBCB = new URL('shop-fb-callback', location.href).href;\n      var STRIPE = new URL('shop-stripe-webhook', location.href).href;\n      var metaOk = !!(f.metaAppId.saved && f.metaAppSecret.saved && f.metaVerifyToken.saved);\n      var fbOk = !!(f.metaPageName.saved || f.metaPageAccessToken.saved);\n      var stripeOk = !!(f.stripeSecretKey.saved && f.stripeWebhookSecret.saved);\n      var products = (P.ok && P.products) ? P.products.filter(function (p) { return p.Status !== 'archived'; }) : [];\n      var dbOk = V.ok === true;\n      var ids = {};\n      if (dbOk) { (V.ids || []).forEach(function (id) { ids[id] = true; }); }\n      var indexed = products.filter(function (p) { return ids[p.Item_ID]; }).length;\n      var searchOk = dbOk && products.length > 0 && indexed === products.length;\n      function a(url, text) { return '<a href=\"' + url + '\" target=\"_blank\" rel=\"noopener\">' + text + '</a>'; }\n      function copyBox(id, val) { return '<div class=\"copy\" style=\"margin-top:8px\"><input id=\"' + id + '\" readonly value=\"' + esc(val) + '\"><button type=\"button\" class=\"btn ghost\" data-copy=\"' + id + '\">' + ic('copy', 16) + 'Copy</button></div>'; }\n      function ol(items) { return '<ol style=\"margin:10px 0 0;padding-left:20px;line-height:1.7\">' + items.map(function (x) { return '<li>' + x + '</li>'; }).join('') + '</ol>'; }\n      function para(t) { return '<p class=\"desc\" style=\"margin:10px 0 0\">' + t + '</p>'; }\n      function step(n, title, status, body) {\n        var chip = status === 'ok' ? '<span class=\"chip ok\" style=\"margin-left:0\">Done</span>' : (status === 'todo' ? '<span class=\"chip todo\" style=\"margin-left:0\">To do</span>' : '<span class=\"chip\" style=\"margin-left:0\">Info</span>');\n        return '<div class=\"card\" style=\"margin-bottom:14px\"><div class=\"rowb\"><h2 style=\"margin:0\">' + n + '. ' + title + '</h2>' + chip + '</div>' + body + '</div>';\n      }\n      var out = '';\n\n      out += step(1, 'What you need', 'info',\n        para('This shop runs on one n8n workflow plus a few online services. There is no other server to install or host.') +\n        '<table style=\"width:100%;border-collapse:collapse;font-size:13px;margin-top:10px\"><thead><tr><th style=\"text-align:left;padding:6px 8px\">Service</th><th style=\"text-align:left;padding:6px 8px\">What it is used for</th><th style=\"text-align:left;padding:6px 8px\">Cost</th></tr></thead><tbody>' +\n        '<tr><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\"><b>n8n</b></td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Runs this workflow, the admin website and the data tables. It must be reachable on the internet over https (n8n Cloud already is).</td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Your n8n plan</td></tr>' +\n        '<tr><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\"><b>Supabase</b></td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Postgres database with pgvector. Stores the chat memory and the product search index.</td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Free plan is enough</td></tr>' +\n        '<tr><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\"><b>Google Gemini</b></td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">The AI that chats, reads customer photos and creates the search index.</td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Free key is very limited. Enable billing for real customers.</td></tr>' +\n        '<tr><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\"><b>Google Drive</b></td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Stores product photos you upload in the Products page. Optional: you can paste image links instead.</td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Free</td></tr>' +\n        '<tr><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\"><b>Meta (Facebook)</b></td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">A Facebook Page and a Meta developer app so customers can message you on Messenger.</td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Free</td></tr>' +\n        '<tr><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\"><b>Stripe</b></td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Card payments through the Pay Now button.</td><td style=\"padding:8px;border-top:1px solid var(--line);vertical-align:top\">Stripe fees per payment</td></tr>' +\n        '</tbody></table>' +\n        para('Your product data, orders, customers and settings are stored in n8n Data Tables inside this workflow. Only the chat memory and the search index live in Supabase.'));\n\n      out += step(2, 'Add your credentials in n8n', 'info',\n        ol(['In n8n open <b>Credentials</b> and create these three: <b>Google Gemini (PaLM) API</b>, <b>Postgres</b> and <b>Google Drive OAuth2 API</b>. Steps 3, 4 and 5 below show how to get the details.',\n            'Open this workflow in n8n. Select the credential on every node that shows a warning (the Gemini, Postgres and Google Drive nodes).',\n            'Press <b>Publish</b>. Webhooks only work on the published workflow, and publish again after every change.']) +\n        para('Facebook and Stripe do not need an n8n credential. You connect them on the Settings page.'));\n\n      out += step(3, 'Supabase database (chat memory and search)', dbOk ? 'ok' : 'todo',\n        ol(['Go to ' + a('https://supabase.com', 'supabase.com') + ' and create a project. The free plan is enough. Pick a region close to you and save the database password.',\n            'In the project press <b>Connect</b> and copy the <b>Session pooler</b> details: host, port (5432), user (it looks like postgres.xxxx) and database (postgres).',\n            'In n8n create the <b>Postgres</b> credential with those values and your password. Set SSL to <b>Require</b>.',\n            'Create nothing by hand. The setup button creates the pgvector extension and the table <code>sales_product_vectors</code> if they do not exist, and n8n creates the chat memory table by itself. Running setup again is safe.']) +\n        '<div class=\"alert ' + (dbOk ? 'good' : 'bad') + '\" style=\"margin-top:12px\">' + ic(dbOk ? 'check' : 'alert', 16) + '<div>' + (dbOk ? 'Connected to Supabase. The search index holds ' + indexed + ' of ' + products.length + ' active products.' : 'Not connected yet. Check the Postgres credential and that this workflow is published, then reload this page.') + '</div></div>');\n\n      out += step(4, 'Google Gemini (the AI)', 'info',\n        ol(['Open ' + a('https://aistudio.google.com/apikey', 'aistudio.google.com/apikey') + ' and press <b>Create API key</b>.',\n            'In n8n create the <b>Google Gemini (PaLM) API</b> credential and paste the key.',\n            'Use Test chat in this website to check that the assistant answers.']) +\n        para('A free key allows only about 20 AI requests per day, which is enough for a quick test only. Enable billing on the Google project before real customers write to you.'));\n\n      out += step(5, 'Google Drive (product photos)', 'info',\n        ol(['Open ' + a('https://console.cloud.google.com', 'console.cloud.google.com') + ' and create a project.',\n            'Go to <b>APIs and services</b>, then <b>Library</b>, and enable <b>Google Drive API</b>.',\n            'Open <b>OAuth consent screen</b>. Choose External, fill in the app name and your email, and add your own Google account as a test user.',\n            'Open <b>Credentials</b>, then <b>Create credentials</b>, then <b>OAuth client ID</b>, type <b>Web application</b>. Paste the redirect URL that n8n shows in the Google Drive credential form under Authorized redirect URIs.',\n            'Copy the client ID and secret into the n8n <b>Google Drive OAuth2 API</b> credential and press <b>Sign in with Google</b>.']) +\n        para('The first photo you upload creates a folder called Sales Agent product photos and shares it by link so customers can see the pictures in Messenger. If you do not want Drive, paste a public https image link in the product form instead.'));\n\n      out += step(6, 'Meta app and Facebook Page', fbOk ? 'ok' : (metaOk ? 'todo' : 'todo'),\n        ol(['Create a Facebook Page for your shop if you do not have one.',\n            'Open ' + a('https://developers.facebook.com/apps', 'developers.facebook.com/apps') + ', press <b>Create app</b>, choose the <b>Business</b> type and name it.',\n            'Add the products <b>Messenger</b> and <b>Facebook Login</b>.',\n            'In Facebook Login settings add this under <b>Valid OAuth Redirect URIs</b> and save:' + copyBox('g_fbcb', FBCB),\n            'In <b>App settings, Basic</b> copy the <b>App ID</b> and <b>App secret</b>. Open the <b>Settings</b> page here, paste them, press <b>Generate a random token</b> for the verify token and <b>Save settings</b>.',\n            'On the Settings page press <b>Continue with Facebook</b>, log in and choose your Page. The webhook and the Page subscription are created for you.']) +\n        para('For reference, the Messenger webhook address used is:' ) + copyBox('g_chat', CHAT) +\n        para('It receives the fields messages, messaging_postbacks and message_echoes. You do not need to enter it by hand.') +\n        '<div class=\"alert info\" style=\"margin-top:12px\">' + ic('alert', 16) + '<div><b>Development mode:</b> while the Meta app is in Development mode only people with a role on the app (admin, developer, tester) can chat with the bot. To serve the public, complete <b>App Review</b> for <code>pages_messaging</code>, add a privacy policy link, and switch the app to <b>Live</b>.</div></div>' +\n        '<div class=\"act\"><button type=\"button\" class=\"btn\" data-go=\"settings\">Open Settings</button></div>' +\n        '<div class=\"alert ' + (fbOk ? 'good' : 'info') + '\" style=\"margin-top:12px\">' + ic(fbOk ? 'check' : 'alert', 16) + '<div>' + (fbOk ? 'Facebook Page connected: ' + esc(f.metaPageName.value || 'saved') : (metaOk ? 'Meta app details saved. Press Continue with Facebook on the Settings page.' : 'Meta app details are not saved yet.')) + '</div></div>');\n\n      out += step(7, 'Stripe payments', stripeOk ? 'ok' : 'todo',\n        ol(['Create an account at ' + a('https://dashboard.stripe.com/register', 'stripe.com') + '. You can stay in <b>test mode</b> while you try everything.',\n            'In the Stripe Dashboard open <b>Developers</b>, then <b>API keys</b>, then <b>Create restricted key</b>. Name it Sales Agent and set <b>Webhook Endpoints</b> and <b>Checkout Sessions</b> to <b>Write</b>.',\n            'Copy the key (it starts with rk_test_ or rk_live_), open the <b>Settings</b> page here, paste it and press <b>Connect Stripe</b>.',\n            'The payment webhook is created in Stripe for you and its signing secret is stored. This is the address it uses:' + copyBox('g_stripe', STRIPE),\n            'Try a purchase with the test card <code>4242 4242 4242 4242</code>, any future date and any 3 digit code.',\n            'To accept real money, activate your Stripe account, create a live-mode key and press Reconnect Stripe.']) +\n        '<div class=\"act\"><button type=\"button\" class=\"btn\" data-go=\"settings\">Open Settings</button></div>' +\n        '<div class=\"alert ' + (stripeOk ? 'good' : 'info') + '\" style=\"margin-top:12px\">' + ic(stripeOk ? 'check' : 'alert', 16) + '<div>' + (stripeOk ? 'Stripe is connected.' : 'Stripe is not connected yet.') + '</div></div>');\n\n      out += step(8, 'Database tables and first login', 'ok',\n        para('You are signed in, so the setup already ran. It created the Data Tables for products, orders, customers, settings and errors, and your first login. You can run the setup again at any time. It never deletes existing data.') +\n        para('Use the <b>Account</b> page to change your username and password. Do not keep the default admin / admin login.'));\n\n      out += step(9, 'Add products and test', searchOk ? 'ok' : 'todo',\n        ol(['Open <b>Products</b> and press <b>Add product</b>. Fill in name, price, stock, sizes, colours and a photo.',\n            'Press <b>Re-sync all</b> on the Products page so customers can find products by describing them.',\n            'Open <b>Test chat</b> and ask for a product. Check the answer, the price and the photo.',\n            'Message your Facebook Page from an account that has a role on the app. Try a full order: product, size, delivery details, Pay Now and the test card.',\n            'Look at <b>Orders</b>, <b>Inbox</b> and <b>Problems</b> in this website to see what happened.']) +\n        '<div class=\"alert ' + (searchOk ? 'good' : 'info') + '\" style=\"margin-top:12px\">' + ic(searchOk ? 'check' : 'alert', 16) + '<div>' + (products.length ? (searchOk ? 'All ' + products.length + ' active products are searchable.' : indexed + ' of ' + products.length + ' active products are in the search index. Press Re-sync all on the Products page.') : 'No products yet.') + '</div></div>' +\n        '<div class=\"act\"><button type=\"button\" class=\"btn\" data-go=\"products\">Open Products</button><button type=\"button\" class=\"btn ghost\" data-go=\"test\">Open Test chat</button></div>');\n\n      out += step(10, 'If something does not work', 'info',\n        ol(['<b>Facebook says the verify token does not match:</b> the token saved on the Settings page must be the same one Meta used. Press Continue with Facebook again, and make sure the workflow is published.',\n            '<b>The bot does not answer:</b> check that the workflow is published, that your Facebook account has a role on the Meta app while it is in Development mode, and that the Gemini key still has quota.',\n            '<b>A payment does not turn the order to Paid:</b> press Reconnect Stripe on the Settings page so the webhook and its signing secret are created again.',\n            '<b>Products are not found by description:</b> press Re-sync all on the Products page and check step 3.',\n            '<b>Photos do not show in Messenger:</b> the image link must be a public https link. Check that the Drive folder is shared by link.',\n            '<b>Anything else:</b> open the <b>Problems</b> page, press Show report for my developer and send it to your developer.']));\n\n      el.innerHTML = HEAD + out;\n      el.addEventListener('click', function (e) {\n        var c = e.target.closest('[data-copy]');\n        if (c) {\n          var inp = $id(c.getAttribute('data-copy'));\n          if (inp) { inp.select(); var ok = false; try { ok = document.execCommand('copy'); } catch (x) { ok = false; } toast(ok ? 'Copied.' : 'Selected. Press Ctrl+C to copy.', 2500); }\n          return;\n        }\n        var g = e.target.closest('[data-go]');\n        if (g) { FG.goto(g.getAttribute('data-go')); }\n      });\n    });\n  }\n\n  window.FG_MOD3 = { guide: guide };\n})();`;\nreturn [{ json: { js } }];"},"typeVersion":2},{"id":"a9d3c100-5b1e-4c7a-9e50-000000000003","name":"Respond: guide module","type":"n8n-nodes-base.respondToWebhook","position":[-3568,8444],"parameters":{"options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Content-Type","value":"application/javascript; charset=utf-8"},{"name":"Cache-Control","value":"no-store"}]}},"respondWith":"text","responseBody":"={{ $json.js }}"},"typeVersion":1.5},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000001","name":"Note: Messenger intake","type":"n8n-nodes-base.stickyNote","position":[-4128,300],"parameters":{"color":5,"width":2048,"height":688,"content":"## 1. Messenger intake\nMeta calls this webhook. It answers the verify handshake, replies 200 OK at once and keeps only real customer messages."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000002","name":"Note: One customer message","type":"n8n-nodes-base.stickyNote","position":[-4128,1132],"parameters":{"color":5,"width":7568,"height":2384,"content":"## 2. One customer message\nSaves the message, finds the customer and cart, then the Gemini agent answers using products, cart, orders and chat memory."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000003","name":"Note: Delivery details","type":"n8n-nodes-base.stickyNote","position":[-4128,3660],"parameters":{"color":5,"width":1568,"height":368,"content":"## 3. Delivery details\nThe agent saves name, phone, city and address on the order step by step. Checkout only runs after the customer confirms them."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000004","name":"Note: Checkout","type":"n8n-nodes-base.stickyNote","position":[-4128,4156],"parameters":{"color":5,"width":3008,"height":1008,"content":"## 4. Checkout\nRe-prices the cart from Sales Products, checks size, colour and stock, creates the Stripe payment page and sends the Pay Now button."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000005","name":"Note: Payment confirmed","type":"n8n-nodes-base.stickyNote","position":[-4128,5308],"parameters":{"color":5,"width":4448,"height":1008,"content":"## 5. Payment confirmed\nThe Stripe webhook or the return page marks the order Paid, saves the order lines, reduces stock and confirms to the customer."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000006","name":"Note: Nightly cleanup","type":"n8n-nodes-base.stickyNote","position":[-4128,6460],"parameters":{"color":2,"width":1280,"height":688,"content":"## 6. Nightly cleanup\nEvery night at 3: removes old message IDs and stale cart lines, and marks old unpaid carts as Abandoned."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000007","name":"Note: Error log","type":"n8n-nodes-base.stickyNote","position":[-4128,7292],"parameters":{"color":2,"width":1280,"height":368,"content":"## 7. Error log\nAny failure is saved to the admin Problems page. This workflow is its own error workflow."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000008","name":"Note: Admin website pages","type":"n8n-nodes-base.stickyNote","position":[-4128,7788],"parameters":{"color":4,"width":1280,"height":848,"content":"## 8. Admin website pages\nServe the admin website and its page scripts from this workflow, so the whole app lives in one canvas."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000009","name":"Note: Admin API: routing, login and settings","type":"n8n-nodes-base.stickyNote","position":[-4128,8780],"parameters":{"color":4,"width":3728,"height":848,"content":"## 9. Admin API: routing, login and settings\nEvery action from the admin website arrives here. The login token is checked first, then the action is routed."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000010","name":"Note: Facebook connect","type":"n8n-nodes-base.stickyNote","position":[-4128,9772],"parameters":{"color":6,"width":2768,"height":688,"content":"## 10. Facebook connect\nLog in with Facebook, choose your Page, save its token and subscribe the Page and webhook to messages."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000011","name":"Note: Stripe connect and webhook","type":"n8n-nodes-base.stickyNote","position":[-4128,10604],"parameters":{"color":6,"width":1808,"height":1008,"content":"## 11. Stripe connect and webhook\nConnect a Stripe key, create the webhook in Stripe and verify the signature of every payment event."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000012","name":"Note: Products","type":"n8n-nodes-base.stickyNote","position":[-4128,11740],"parameters":{"color":4,"width":1328,"height":848,"content":"## 12. Products\nList, save, archive and delete products. Saving a product also updates the search index."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000013","name":"Note: Product photos","type":"n8n-nodes-base.stickyNote","position":[-4128,12732],"parameters":{"color":4,"width":2768,"height":848,"content":"## 13. Product photos\nUpload photos to a public Google Drive folder so Messenger can show them. Replaced photos are deleted."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000014","name":"Note: Product search index","type":"n8n-nodes-base.stickyNote","position":[-4128,13724],"parameters":{"color":4,"width":2048,"height":528,"content":"## 14. Product search index\nCreates Gemini embeddings and stores them in Supabase pgvector, so customers can find products by describing them."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000015","name":"Note: Orders and customers","type":"n8n-nodes-base.stickyNote","position":[-4128,14396],"parameters":{"color":4,"width":2048,"height":1168,"content":"## 15. Orders and customers\nList, edit, export and delete orders, order lines and customers, and change an order status."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000016","name":"Note: Inbox, assistant and problems","type":"n8n-nodes-base.stickyNote","position":[-4128,15692],"parameters":{"color":4,"width":2768,"height":1648,"content":"## 16. Inbox and assistant\nAnswer escalated questions, edit the store name and instructions, and list or clear errors."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000017","name":"Note: Test chat","type":"n8n-nodes-base.stickyNote","position":[-4128,17484],"parameters":{"color":4,"width":1280,"height":848,"content":"## 17. Test chat\nTry the assistant with your live products from the admin site. No carts or orders are created."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000018","name":"Note: Setup (run once)","type":"n8n-nodes-base.stickyNote","position":[-4128,18476],"parameters":{"color":6,"width":5648,"height":528,"content":"## 18. Setup (run once)\nCreates the 14 Data Tables, the product search table, the first admin login and the default assistant instructions."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000019","name":"Note: Start here","type":"n8n-nodes-base.stickyNote","position":[-2888,-1100],"parameters":{"color":2,"width":640,"height":416,"content":"## START HERE: do it in this order\n**In n8n**\n1. Create credentials: Gemini, Postgres, Google Drive\n2. Select them on the nodes that show a warning\n3. Publish this workflow\n**In your browser** (your-n8n-url/webhook/shop-admin)\n4. Create database and first login\n5. Settings: Meta app, then Continue with Facebook\n6. Settings: Connect Stripe (test mode)\n7. Products: add products, Re-sync all\n**In Messenger**\n8. Send a test order\nDo not skip the order."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000020","name":"Note: Walkthrough video","type":"n8n-nodes-base.stickyNote","position":[-2208,-1100],"parameters":{"color":4,"width":640,"height":416,"content":"## Watch the 2-minute video\nSee the whole flow before you start: a customer orders in Messenger, pays with Stripe, and the owner sees it in the admin website.\nhttps://drive.google.com/file/d/1HchY8S2IfqyadX-hvK1-ZiTB1pnUUkCl/view?usp=sharing"},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000021","name":"Note: Requirements","type":"n8n-nodes-base.stickyNote","position":[-1528,-1100],"parameters":{"color":7,"width":640,"height":416,"content":"## Requirements\n- n8n reachable over https (n8n Cloud, or self-hosted with a public URL)\n- Supabase project (Postgres with pgvector), the free plan is enough\n- Google Gemini API key (enable billing for real customers)\n- Google Drive (OAuth2) for product photos, optional\n- Meta developer app (Business) and a Facebook Page you manage\n- Stripe account (test mode is fine to start)\n- n8n Data Tables enabled"},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000022","name":"Note: Safe setup rules","type":"n8n-nodes-base.stickyNote","position":[-848,-1100],"parameters":{"color":2,"width":640,"height":416,"content":"## Safe setup rules\n- Keys live in n8n credentials or the admin Settings page, never inside a node.\n- Change the first login (admin / admin) at once.\n- Use a Stripe restricted key, in test mode first.\n- Keep the Meta app in Development mode until one full test order works.\n- Do not rename the webhook paths.\n- Publish again after every change."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000023","name":"Note: Webhook URLs","type":"n8n-nodes-base.stickyNote","position":[-168,-1100],"parameters":{"color":7,"width":640,"height":416,"content":"## Webhook URLs (production)\nAdd your n8n address in front of each path:\n- /webhook/shop-admin : admin website\n- /webhook/chat : Meta Messenger webhook\n- /webhook/shop-fb-callback : Facebook login redirect\n- /webhook/shop-stripe-webhook : Stripe events\n- /webhook/payment-success : page after payment\n- /webhook/shop-setup : setup button\nDo not rename these paths."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000024","name":"Note: Step 1 accounts","type":"n8n-nodes-base.stickyNote","position":[-2888,-644],"parameters":{"color":6,"width":640,"height":320,"content":"## Step 1: Prepare your accounts\nCreate these first (all have a free plan):\n1. Supabase project: note host, port, user and password\n2. Google AI Studio API key\n3. Google Cloud project with Drive API and an OAuth client\n4. Facebook Page and a Meta developer app\n5. Stripe account\nThe admin website has a Setup guide page that repeats all steps with live status."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000025","name":"Note: Step 2 credentials","type":"n8n-nodes-base.stickyNote","position":[-2208,-644],"parameters":{"color":6,"width":640,"height":320,"content":"## Step 2: Add credentials (in n8n)\nOpen Credentials and create Google Gemini (PaLM) API, Postgres (Supabase Session pooler, SSL on) and Google Drive OAuth2. Then open this workflow and select them on every node that shows a warning.\nMeta and Stripe need no n8n credential: you enter them in the admin website."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000026","name":"Note: Step 3 publish","type":"n8n-nodes-base.stickyNote","position":[-1528,-644],"parameters":{"color":6,"width":640,"height":320,"content":"## Step 3: Publish (in n8n)\nPress Publish. Webhooks only work when the workflow is published, and you must publish again after every change.\nIn the workflow settings choose this workflow as its own Error workflow, so failures reach the Problems page."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000027","name":"Note: Step 4 database","type":"n8n-nodes-base.stickyNote","position":[-848,-644],"parameters":{"color":6,"width":640,"height":320,"content":"## Step 4: Create the database (in your browser)\nOpen your-n8n-url/webhook/shop-admin and press Create database and first login (or Execute the Run once trigger). Sign in with admin / admin and choose your own username and password straight away."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000028","name":"Note: Step 5 Facebook","type":"n8n-nodes-base.stickyNote","position":[-168,-644],"parameters":{"color":6,"width":640,"height":320,"content":"## Step 5: Connect Facebook (admin website)\nOpen Setup guide, then Settings. Paste the Meta App ID and App secret, generate the verify token and Save. Add the OAuth redirect URL shown there to your Meta app. Press Continue with Facebook and choose your Page."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000029","name":"Note: Step 6 Stripe","type":"n8n-nodes-base.stickyNote","position":[-2888,-284],"parameters":{"color":6,"width":640,"height":368,"content":"## Step 6: Connect Stripe (admin website)\nIn Stripe create a restricted key (Webhook Endpoints and Checkout Sessions: Write). Paste it in Settings and press Connect Stripe. The webhook is created for you. Stay in test mode until a full test order works."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000030","name":"Note: Step 7 products","type":"n8n-nodes-base.stickyNote","position":[-2208,-284],"parameters":{"color":6,"width":640,"height":368,"content":"## Step 7: Add products and test (admin website)\nProducts, Add product (photo, price, stock, sizes, colours), then press Re-sync all. On the Assistant page set the store name and the Store information. Try Test chat."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000031","name":"Note: Step 8 go live","type":"n8n-nodes-base.stickyNote","position":[-1528,-284],"parameters":{"color":6,"width":640,"height":368,"content":"## Step 8: Test, then go live (Messenger)\nMessage your Page from a tester account and pay with test card 4242 4242 4242 4242. Then use a live Stripe key, request Advanced Access for pages_messaging, switch the Meta app to Live and enable billing on your Gemini key."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000032","name":"Note: Data stored","type":"n8n-nodes-base.stickyNote","position":[-848,-284],"parameters":{"color":7,"width":640,"height":368,"content":"## Data stored (n8n Data Tables)\nProducts, customers, customer state, orders, order items, cart items, checkout sessions, processed messages, escalations, agent config, shop settings, admin login, admin sessions and errors. 14 tables, all created by the setup button.\nPostgres holds only chat memory and the product search index."},"typeVersion":1},{"id":"f1a7c000-3b6e-4d2a-9c10-000000000033","name":"Note: Troubleshooting","type":"n8n-nodes-base.stickyNote","position":[-168,-284],"parameters":{"color":2,"width":640,"height":368,"content":"## Troubleshooting\n- Bot silent: workflow not published, Page not connected, or Meta app in Development mode.\n- Verify token error: the token in Settings must match the Meta app.\n- Products not found by description: press Re-sync all and check the Postgres credential.\n- Order not Paid: press Reconnect Stripe in Settings.\n- Photos missing: use a public https link or reconnect Google Drive.\n- Other errors: open the Problems page."},"typeVersion":1}],"pinData":{},"settings":{"binaryMode":"separate","callerPolicy":"workflowsFromSameOwner","executionOrder":"v1","saveManualExecutions":false,"saveDataSuccessExecution":"none"},"connections":{"Route":{"main":[[{"node":"Respond: JSON result","type":"main","index":0}],[{"node":"New session token","type":"main","index":0}],[{"node":"Delete session","type":"main","index":0}],[{"node":"Prepare new login","type":"main","index":0}],[{"node":"Connect Stripe","type":"main","index":0}],[{"node":"Subscribe Page to app","type":"main","index":0}],[{"node":"Check Stripe key","type":"main","index":0}],[{"node":"Get products","type":"main","index":0}],[{"node":"Look up photo folder","type":"main","index":0}],[{"node":"Find existing product","type":"main","index":0}],[{"node":"Find product photo","type":"main","index":0}],[{"node":"Shape vector input","type":"main","index":0}],[{"node":"Get products to sync","type":"main","index":0}],[{"node":"Shape vector input","type":"main","index":0}],[{"node":"Find product to archive","type":"main","index":0}],[{"node":"Route orders","type":"main","ind