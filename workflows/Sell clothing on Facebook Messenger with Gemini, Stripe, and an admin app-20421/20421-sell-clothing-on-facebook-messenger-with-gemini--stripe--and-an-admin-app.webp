nt-size:12px;font-weight:600}' +\n    '.stat b{display:block;font-size:21px;margin-top:3px;letter-spacing:-.02em}' +\n    '.stat.on{border-color:var(--accent);box-shadow:0 0 0 3px var(--soft)}' +\n    '.tb{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center}.tb input{flex:1 1 260px;width:auto}.tb select{width:auto}' +\n    '.adv{display:none;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0 12px;align-items:end;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:4px 14px 14px;margin-bottom:12px}.adv.open{display:grid}.adv input,.adv select{width:100%;padding:9px 10px;font-size:13px}' +\n    'select{padding:10px 12px;border-radius:11px;border:1px solid var(--line);background:var(--panel);color:var(--text);font-size:14px;font-family:inherit;max-width:100%}' +\n    '.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}' +\n    '.fc{border:1px solid var(--line);background:var(--panel);color:var(--muted);padding:6px 12px;border-radius:99px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit}' +\n    '.fc.on{background:var(--soft);color:var(--accent);border-color:transparent}' +\n    '.otable{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:var(--shadow);margin-bottom:12px}' +\n    '.orow{display:grid;grid-template-columns:1.1fr 1.2fr 2fr .8fr 1fr;gap:12px;align-items:center;padding:12px 16px;border-top:1px solid var(--line);cursor:pointer;font-size:13px}' +\n    '.orow.oc{grid-template-columns:96px minmax(130px,1fr) minmax(210px,1.9fr) 110px 120px;align-items:start;padding:14px 16px}' +\n    '.orow.cust{grid-template-columns:1.6fr 1.2fr .6fr .9fr 1fr}' +\n    '.orow.h{cursor:default;color:var(--muted);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;background:var(--bg);border-top:0;align-items:center;padding:10px 16px}' +\n    '.orow:not(.h):hover{background:var(--bg)}' +\n    '.ono{font-size:14px;letter-spacing:.01em}' +\n    '.li{margin:0 0 3px;line-height:1.35}.li .q{color:var(--muted);font-weight:600}' +\n    '.thumbs{display:flex;gap:10px;align-items:flex-start;min-width:0}' +\n    '.thumbs img,.thumbs .ph{width:40px;height:40px;border-radius:9px;object-fit:cover;background:var(--bg);display:grid;place-items:center;color:var(--muted);flex:none}' +\n    '.sub{color:var(--muted);font-size:12px}' +\n    '.sheet.wide{max-width:900px}' +\n    '.lines{width:100%;border-collapse:collapse;font-size:13px}' +\n    '.lines th{text-align:left;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.05em;padding:6px 8px}' +\n    '.lines td{padding:8px;border-top:1px solid var(--line);vertical-align:middle}' +\n    '.lines input,.lines select{padding:7px 8px;font-size:13px;border-radius:8px;min-width:0}' +\n    '.badge{font-size:10px;font-weight:700;padding:2px 7px;border-radius:99px;background:var(--oksoft);color:var(--ok);margin-left:6px;vertical-align:middle}' +\n    '.badge.warn{background:var(--bg);color:var(--muted);border:1px solid var(--line)}.badge.bad{background:var(--badsoft);color:var(--bad)}' +\n    '.kv{display:grid;grid-template-columns:120px 1fr;gap:6px 12px;font-size:14px}.kv dt{color:var(--muted)}.kv dd{margin:0}' +\n    '.sect{margin-top:20px}.sect h3{font-size:12px;margin:0 0 8px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}' +\n    '.act{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}' +\n    '.frm{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}.frm .full{grid-column:1/-1}' +\n    '.linkb{background:none;border:0;padding:0;color:var(--accent);font:inherit;font-weight:600;cursor:pointer;text-align:left}' +\n    '@media(max-width:1000px){.orow.oc{grid-template-columns:1fr 1fr}.orow.oc>div:nth-child(3){grid-column:1/-1;order:5}.orow.oc.h{display:none}}' +\n    '@media(max-width:860px){.orow{grid-template-columns:1fr 1fr}.orow.h{display:none}.frm{grid-template-columns:1fr}.lines{display:block;overflow-x:auto}}';\n  var st = document.createElement('style');\n  st.textContent = css;\n  document.head.appendChild(st);\n\n  var STATUSES = ['Draft', 'Awaiting_Payment', 'Paid', 'Shipped', 'Delivered', 'Cancelled', 'Refunded', 'Abandoned'];\n  var LABEL = { Draft: 'Draft', Awaiting_Payment: 'Awaiting payment', Paid: 'Paid', Shipped: 'Shipped', Delivered: 'Delivered', Cancelled: 'Cancelled', Refunded: 'Refunded', Abandoned: 'Abandoned' };\n  var TONE = { Paid: 'ok', Shipped: 'ok', Delivered: 'ok', Awaiting_Payment: 'todo', Cancelled: 'bad', Refunded: 'bad' };\n  var SRC = { 'sheet-import': 'Imported earlier', manual: 'Added by admin', bot: 'From Messenger bot' };\n  var REV = ['Paid', 'Shipped', 'Delivered'];\n  var PAYS = ['stripe (card)', 'cash', 'cash on delivery', 'bank transfer'];\n  var D = null, custById = {}, prodById = {}, prodByName = {}, itemsByOrder = {}, ordersByCust = {};\n  var onChange = function () {};\n  var cur = null;\n\n  function lc(s) { return String(s == null ? '' : s).trim().toLowerCase(); }\n  function label(s) { return LABEL[s] || s || 'Unknown'; }\n  function chip(s) { var t = TONE[s]; return '<span class=\"chip' + (t ? ' ' + t : '') + '\" style=\"margin-left:0\">' + esc(label(s)) + '</span>'; }\n  function fmtDate(x) { if (!x) { return ''; } var d = new Date(x); return isNaN(d.getTime()) ? String(x) : d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); }\n  function fmtDT(x) { if (!x) { return ''; } var d = new Date(x); return isNaN(d.getTime()) ? String(x) : d.toLocaleString(); }\n  function orderNo(id) { return '#' + String(id || '').slice(-6).toUpperCase(); }\n  function platform(p) { p = String(p || ''); return p ? p.charAt(0).toUpperCase() + p.slice(1) : 'Manual'; }\n  function ts(o) { var t = Date.parse(o.Created_At); return isNaN(t) ? 0 : t; }\n  function byName(a, b) { return lc(a.Name) < lc(b.Name) ? -1 : 1; }\n  function lineNo(l) { return parseInt(String(l.LineID).split('-').pop(), 10) || 0; }\n  function copy(x) { return JSON.parse(JSON.stringify(x)); }\n  function isRev(o) { return REV.indexOf(o.Status) >= 0; }\n  function sum(arr, f) { return arr.reduce(function (s, x) { return s + f(x); }, 0); }\n  function num(v) { var x = Number(String(v == null ? '' : v).replace(',', '.')); return isFinite(x) ? x : 0; }\n  function fld(id, lab, val, ph, cls) { return '<div class=\"' + (cls || '') + '\"><label for=\"' + id + '\">' + lab + '</label><input id=\"' + id + '\" value=\"' + esc(val) + '\" placeholder=\"' + esc(ph || '') + '\" autocomplete=\"off\"></div>'; }\n  function area(id, lab, val, ph) { return '<label for=\"' + id + '\">' + lab + '</label><textarea id=\"' + id + '\" rows=\"2\" placeholder=\"' + esc(ph || '') + '\">' + esc(val) + '</textarea>'; }\n  function ph(n) { return '<span class=\"ph\">' + ic(n || 'box', 16) + '</span>'; }\n\n  function index() {\n    custById = {}; prodById = {}; prodByName = {}; itemsByOrder = {}; ordersByCust = {};\n    D.customers.forEach(function (c) { custById[c.customer_id] = c; });\n    D.products.forEach(function (p) { prodById[p.Item_ID] = p; prodByName[lc(p.Name)] = p; });\n    D.items.forEach(function (i) { (itemsByOrder[i.OrderID] = itemsByOrder[i.OrderID] || []).push(i); });\n    D.orders.forEach(function (o) { (ordersByCust[o.customer_id] = ordersByCust[o.customer_id] || []).push(o); });\n    Object.keys(itemsByOrder).forEach(function (k) { itemsByOrder[k].sort(function (a, b) { return lineNo(a) - lineNo(b); }); });\n  }\n  function load(cb) { call('orders_overview').then(function (r) { if (!r.ok) { return fail(r); } D = r; index(); cb(); }); }\n  function resolve(l) {\n    if (l.Item_ID && prodById[l.Item_ID]) { return { p: prodById[l.Item_ID], how: 'id' }; }\n    if (l.Item_ID) { return { p: null, how: 'gone' }; }\n    var p = prodByName[lc(l.Product_Name)];\n    return p ? { p: p, how: 'name' } : { p: null, how: 'none' };\n  }\n  function custName(o) { var c = custById[o.customer_id]; return (c && c.Name) || o.Full_Name || 'Unknown customer'; }\n  function unlinked(o) { return (itemsByOrder[o.OrderID] || []).filter(function (l) { return resolve(l).how !== 'id'; }).length; }\n\n  function closeModal() { if (cur) { cur.remove(); cur = null; } }\n  function openModal(wide) {\n    closeModal();\n    var m = document.createElement('div');\n    m.className = 'modal';\n    m.innerHTML = '<div class=\"sheet' + (wide ? ' wide' : '') + '\"></div>';\n    document.body.appendChild(m);\n    cur = m;\n    return m.firstChild;\n  }\n  function msg(kind, t) { var b = $id('omsg'); if (b) { b.innerHTML = '<div class=\"alert ' + kind + '\">' + ic(kind === 'good' ? 'check' : 'alert', 16) + '<div>' + esc(t) + '</div></div>'; } else { toast(t, 5000); } }\n\n  /* ---------- Orders page ---------- */\n  var OF = null;\n  function freshFilters() { return { q: '', status: 'all', from: '', to: '', pay: 'all', product: 'all', customer: '', min: '', max: '', sort: 'new', shown: 25 }; }\n  function advCount() { var n = 0; ['from', 'to', 'min', 'max'].forEach(function (k) { if (OF[k]) { n++; } }); if (OF.pay !== 'all') { n++; } if (OF.product !== 'all') { n++; } if (OF.customer) { n++; } return n; }\n  function filtered() {\n    var q = lc(OF.q);\n    var from = OF.from ? Date.parse(OF.from + 'T00:00:00') : null;\n    var to = OF.to ? Date.parse(OF.to + 'T23:59:59') : null;\n    var min = OF.min === '' ? null : num(OF.min);\n    var max = OF.max === '' ? null : num(OF.max);\n    var list = D.orders.filter(function (o) {\n      if (OF.status !== 'all' && o.Status !== OF.status) { return false; }\n      if (OF.pay !== 'all' && (o.Payment_Method || 'none') !== OF.pay) { return false; }\n      if (OF.customer && o.customer_id !== OF.customer) { return false; }\n      var t = ts(o);\n      if (from !== null && t < from) { return false; }\n      if (to !== null && t > to) { return false; }\n      if (min !== null && o.Total < min) { return false; }\n      if (max !== null && o.Total > max) { return false; }\n      var lines = itemsByOrder[o.OrderID] || [];\n      if (OF.product !== 'all') {\n        var hit = lines.some(function (l) { var r = resolve(l); return l.Item_ID === OF.product || (r.p && r.p.Item_ID === OF.product); });\n        if (!hit) { return false; }\n      }\n      if (q) {\n        var hay = [o.OrderID, orderNo(o.OrderID), custName(o), o.Full_Name, o.Phone, o.Address, o.City, o.Landmark, o.Tracking, o.Notes].concat(lines.map(function (l) { return l.Product_Name; })).join(' ').toLowerCase();\n        if (hay.indexOf(q.replace('#', '')) < 0) { return false; }\n      }\n      return true;\n    });\n    list.sort(function (a, b) {\n      if (OF.sort === 'old') { return ts(a) - ts(b); }\n      if (OF.sort === 'hi') { return b.Total - a.Total; }\n      if (OF.sort === 'lo') { return a.Total - b.Total; }\n      return ts(b) - ts(a);\n    });\n    return list;\n  }\n  function orderRow(o) {\n    var lines = itemsByOrder[o.OrderID] || [];\n    var first = lines[0];\n    var r0 = first ? resolve(first) : null;\n    var img = first ? (first.Image || (r0.p && r0.p.Product_Image) || '') : '';\n    var li = lines.slice(0, 3).map(function (l) { var v = [l.Size, l.Color].filter(Boolean).join(' / '); return '<div class=\"li\"><span class=\"q\">' + l.Quantity + ' x</span> <b>' + esc(l.Product_Name) + '</b>' + (v ? ' <span class=\"sub\">' + esc(v) + '</span>' : '') + '</div>'; }).join('');\n    if (lines.length > 3) { li += '<div class=\"sub\">+' + (lines.length - 3) + ' more</div>'; }\n    if (!lines.length) { li = '<div class=\"sub\">No items in this order</div>'; }\n    return '<div class=\"orow oc\" data-id=\"' + esc(o.OrderID) + '\"><div><b class=\"ono\">' + esc(orderNo(o.OrderID)) + '</b><div class=\"sub\">' + esc(fmtDate(o.Created_At)) + '</div></div><div><b>' + esc(custName(o)) + '</b><div class=\"sub\">' + esc(o.Phone || 'No phone') + '</div></div><div class=\"thumbs\">' + (img ? '<img src=\"' + esc(img) + '\" alt=\"\">' : ph()) + '<div style=\"min-width:0\">' + li + '</div></div><div><b>' + money(o.Total) + '</b><div class=\"sub\">' + esc(o.Payment_Method || 'No payment yet') + '</div></div><div>' + chip(o.Status) + (o.Tracking ? '<div class=\"sub\" style=\"margin-top:4px\">Tracking ' + esc(o.Tracking) + '</div>' : '') + (o.Status === 'Paid' && String(o.Notes || '').indexOf('changed the delivery details') >= 0 ? '<div class=\"sub\" style=\"margin-top:4px;color:var(--bad);font-weight:700\">Address changed</div>' : '') + '</div></div>';\n  }\n  function viewOrders(el) {\n    var pp = FG.params || {};\n    FG.params = {};\n    OF = freshFilters();\n    if (pp.product) { OF.product = pp.product; }\n    if (pp.customer) { OF.customer = pp.customer; }\n    var HEAD = '<div class=\"head row2\"><div><h1>Orders</h1><p>Every order with its customer and products. Click an order to see details, change its status or edit it.</p></div><button class=\"btn\" id=\"onew\">' + ic('plus', 16) + 'New order</button></div>';\n    el.innerHTML = HEAD + skeleton();\n    load(function () {\n      var pays = {};\n      D.orders.forEach(function (o) { pays[o.Payment_Method || 'none'] = true; });\n      var payOpts = '<option value=\"all\">Any</option>' + Object.keys(pays).sort().map(function (p) { return '<option value=\"' + esc(p) + '\">' + esc(p === 'none' ? 'No payment yet' : p) + '</option>'; }).join('');\n      var prodOpts = '<option value=\"all\">Any</option>' + D.products.slice().sort(byName).map(function (p) { return '<option value=\"' + esc(p.Item_ID) + '\">' + esc(p.Name) + '</option>'; }).join('');\n      el.innerHTML = HEAD + '<div class=\"stats\" id=\"ostats\"></div>' +\n        '<div class=\"tb\"><input id=\"oq\" placeholder=\"Search by order number, customer, phone or product\"><select id=\"osort\"><option value=\"new\">Newest first</option><option value=\"old\">Oldest first</option><option value=\"hi\">Highest total</option><option value=\"lo\">Lowest total</option></select><button class=\"btn ghost sm\" id=\"oadv\">More filters</button><button class=\"btn ghost sm\" id=\"ocsv\">' + ic('copy', 14) + 'Export CSV</button></div>' +\n        '<div class=\"adv\" id=\"oadvp\"><div><label for=\"ofrom\">From date</label><input type=\"date\" id=\"ofrom\"></div><div><label for=\"oto\">To date</label><input type=\"date\" id=\"oto\"></div><div><label for=\"opay\">Payment</label><select id=\"opay\">' + payOpts + '</select></div><div><label for=\"oprod\">Product</label><select id=\"oprod\">' + prodOpts + '</select></div><div><label for=\"omin\">Min total ($)</label><input id=\"omin\"></div><div><label for=\"omax\">Max total ($)</label><input id=\"omax\"></div><div><button class=\"btn ghost sm\" id=\"oclr\" style=\"width:100%\">Clear filters</button></div></div>' +\n        '<div class=\"chips\" id=\"ochips\"></div><div class=\"desc\" id=\"ocount\"></div><div id=\"olist\"></div>';\n      $id('oprod').value = OF.product;\n      if (advCount()) { $id('oadvp').classList.add('open'); }\n      function draw() {\n        var all = D.orders;\n        var counts = {};\n        all.forEach(function (o) { counts[o.Status] = (counts[o.Status] || 0) + 1; });\n        var rev = sum(all.filter(isRev), function (o) { return o.Total; });\n        var cards = [['all', 'All orders', all.length], ['Paid', 'To ship', counts.Paid || 0], ['Awaiting_Payment', 'Awaiting payment', counts.Awaiting_Payment || 0], ['Shipped', 'Shipped', counts.Shipped || 0], ['Delivered', 'Delivered', counts.Delivered || 0]];\n        $id('ostats').innerHTML = cards.map(function (c) { return '<button class=\"stat' + (OF.status === c[0] ? ' on' : '') + '\" data-s=\"' + c[0] + '\"><small>' + c[1] + '</small><b>' + c[2] + '</b></button>'; }).join('') + '<div class=\"stat\" style=\"cursor:default\"><small>Revenue (paid)</small><b>' + money(rev) + '</b></div>';\n        var seen = {};\n        var keys = ['all'].concat(STATUSES.filter(function (s) { return counts[s]; })).concat(Object.keys(counts).filter(function (s) { return STATUSES.indexOf(s) < 0; }));\n        $id('ochips').innerHTML = keys.filter(function (k) { if (seen[k]) { return false; } seen[k] = 1; return true; }).map(function (k) { return '<button class=\"fc' + (OF.status === k ? ' on' : '') + '\" data-s=\"' + esc(k) + '\">' + (k === 'all' ? 'All' : esc(label(k))) + ' (' + (k === 'all' ? all.length : counts[k]) + ')</button>'; }).join('');\n        var n = advCount();\n        $id('oadv').textContent = n ? 'More filters (' + n + ')' : 'More filters';\n        var list = filtered();\n        var page = list.slice(0, OF.shown);\n        $id('ocount').textContent = 'Showing ' + list.length + ' of ' + all.length + ' orders';\n        if (!list.length) {\n          $id('olist').innerHTML = '<div class=\"card empty\"><div class=\"big\">' + ic('bag', 26) + '</div><h2>' + (all.length ? 'No orders match' : 'No orders yet') + '</h2><p>' + (all.length ? 'Try clearing some filters.' : 'Orders from your Messenger bot appear here automatically. You can also add one by hand.') + '</p></div>';\n          return;\n        }\n        $id('olist').innerHTML = '<div class=\"otable\"><div class=\"orow oc h\"><div>Order</div><div>Customer</div><div>Items</div><div>Total</div><div>Status</div></div>' + page.map(orderRow).join('') + '</div>' + (list.length > page.length ? '<button class=\"btn ghost sm\" id=\"omore\">Show more (' + (list.length - page.length) + ' left)</button>' : '');\n        var mo = $id('omore');\n        if (mo) { mo.addEventListener('click', function () { OF.shown += 25; draw(); }); }\n      }\n      onChange = draw;\n      function setF(k, v) { OF[k] = v; OF.shown = 25; draw(); }\n      $id('oq').addEventListener('input', function () { setF('q', this.value); });\n      $id('ofrom').addEventListener('change', function () { setF('from', this.value); });\n      $id('oto').addEventListener('change', function () { setF('to', this.value); });\n      $id('opay').addEventListener('change', function () { setF('pay', this.value); });\n      $id('oprod').addEventListener('change', function () { setF('product', this.value); });\n      $id('omin').addEventListener('input', function () { setF('min', this.value.trim()); });\n      $id('omax').addEventListener('input', function () { setF('max', this.value.trim()); });\n      $id('osort').addEventListener('change', function () { setF('sort', this.value); });\n      $id('oadv').addEventListener('click', function () { $id('oadvp').classList.toggle('open'); });\n      $id('oclr').addEventListener('click', function () { var s = OF.status, q = OF.q, so = OF.sort; OF = freshFilters(); OF.status = s; OF.q = q; OF.sort = so; ['ofrom', 'oto', 'omin', 'omax'].forEach(function (i) { $id(i).value = ''; }); $id('opay').value = 'all'; $id('oprod').value = 'all'; draw(); });\n      function onStat(e) { var b = e.target.closest('button[data-s]'); if (!b) { return; } setF('status', b.getAttribute('data-s')); }\n      $id('ostats').addEventListener('click', onStat);\n      $id('ochips').addEventListener('click', onStat);\n      $id('olist').addEventListener('click', function (e) { var r = e.target.closest('.orow[data-id]'); if (r) { openOrder(r.getAttribute('data-id')); } });\n      $id('onew').addEventListener('click', function () { openOrder(null); });\n      $id('ocsv').addEventListener('click', function () { exportCsv(filtered()); });\n      draw();\n      if (OF.customer && custById[OF.customer]) { toast('Showing orders of ' + custById[OF.customer].Name, 3000); }\n      if (pp.open) { openOrder(pp.open); }\n    });\n  }\n  function exportCsv(list) {\n    var q = function (s) { return String.fromCharCode(34) + String(s == null ? '' : s).split(String.fromCharCode(34)).join(String.fromCharCode(34, 34)) + String.fromCharCode(34); };\n    var rows = [['OrderID', 'Created', 'Customer', 'Phone', 'Address', 'City', 'Landmark', 'Status', 'Payment', 'Total', 'Tracking', 'Items']];\n    list.forEach(function (o) { rows.push([o.OrderID, o.Created_At, custName(o), o.Phone, o.Address, o.City, o.Landmark, o.Status, o.Payment_Method, o.Total, o.Tracking, (itemsByOrder[o.OrderID] || []).map(function (l) { return l.Quantity + 'x ' + l.Product_Name + (l.Size ? ' ' + l.Size : '') + (l.Color ? ' ' + l.Color : ''); }).join('; ')]); });\n    var text = rows.map(function (r) { return r.map(q).join(','); }).join(NL);\n    var a = document.createElement('a');\n    a.href = URL.createObjectURL(new Blob([text], { type: 'text/csv' }));\n    a.download = 'orders.csv';\n    document.body.appendChild(a);\n    a.click();\n    a.remove();\n    toast('Exported ' + list.length + ' orders.');\n  }\n\n  /* ---------- Order details / editor ---------- */\n  function openOrder(id, preset) {\n    var base = id ? D.orders.filter(function (x) { return x.OrderID === id; })[0] : null;\n    if (id && !base) { toast('That order no longer exists.'); return; }\n    var o = base ? copy(base) : { OrderID: '', customer_id: (preset && preset.customer_id) || '', Full_Name: '', Address: '', City: '', Landmark: '', Phone: '', Status: 'Draft', Payment_Method: '', Total: 0, Created_At: '', Paid_At: '', Tracking: '', Notes: '', Source: 'manual' };\n    var L = (id ? (itemsByOrder[id] || []) : []).map(copy);\n    if (!id && o.customer_id && custById[o.customer_id]) { var c0 = custById[o.customer_id]; o.Full_Name = c0.Name; o.Phone = c0.Phone; o.Address = c0.Address; }\n    var editing = !id;\n    var totalDirty = false;\n    var sheet = openModal(true);\n\n    function paint() { sheet.innerHTML = editing ? editHtml() : readHtml(); if (editing) { bindEdit(); } else { bindRead(); } }\n    function afterSave(res) {\n      toast('Order saved.');\n      load(function () {\n        onChange();\n        var fresh = D.orders.filter(function (x) { return x.OrderID === res.order.OrderID; })[0];\n        if (!fresh) { closeModal(); return; }\n        o = copy(fresh); L = (itemsByOrder[o.OrderID] || []).map(copy); editing = false; paint();\n      });\n    }\n    function save(upd, items, btn) {\n      if (btn) { busy(btn, true, 'Saving...'); }\n      call('order_save', { order: upd, items: items }).then(function (res) {\n        if (btn) { busy(btn, false); }\n        if (!res.ok) { if (res.error === 'unauthorized') { closeModal(); return fail(res); } return msg('bad', res.error); }\n        afterSave(res);\n      });\n    }\n\n    function readHtml() {\n      var c = custById[o.customer_id];\n      var calc = sum(L, function (l) { return l.Quantity * l.Unit_Price; });\n      var acts = [];\n      if (o.Status === 'Draft' || o.Status === 'Awaiting_Payment') { acts.push(['Paid', 'Mark as paid', 'btn']); }\n      if (o.Status === 'Paid') { acts.push(['Shipped', 'Mark as shipped', 'btn']); }\n      if (o.Status === 'Shipped') { acts.push(['Delivered', 'Mark as delivered', 'btn']); }\n      if (isRev(o)) { acts.push(['Refunded', 'Mark refunded', 'btn ghost']); }\n      if (['Cancelled', 'Refunded', 'Abandoned', 'Delivered'].indexOf(o.Status) < 0) { acts.push(['Cancelled', 'Cancel order', 'btn ghost']); }\n      if (['Cancelled', 'Refunded', 'Abandoned'].indexOf(o.Status) >= 0) { acts.push(['Draft', 'Reopen as draft', 'btn ghost']); }\n      var nameLinks = L.filter(function (l) { return resolve(l).how === 'name'; }).length;\n      var rows = L.map(function (l) {\n        var r = resolve(l);\n        var img = l.Image || (r.p && r.p.Product_Image) || '';\n        var badge = r.how === 'id' ? '<span class=\"badge\">Linked to product</span>' : (r.how === 'name' ? '<span class=\"badge warn\">Same name found</span>' : (r.how === 'gone' ? '<span class=\"badge bad\">Product deleted</span>' : '<span class=\"badge warn\">No product link</span>'));\n        var info = r.p ? '<div class=\"sub\">Now ' + money(r.p.Price) + ', ' + r.p.Stock_Status + ' in stock' + (r.p.Status === 'archived' ? ', archived' : '') + '</div><button type=\"button\" class=\"linkb\" data-open=\"' + esc(r.p.Item_ID) + '\">Open product</button>' : '';\n        var variant = [l.Size ? 'Size ' + l.Size : '', l.Color].filter(Boolean).join(', ');\n        return '<tr><td><div class=\"thumbs\">' + (img ? '<img src=\"' + esc(img) + '\" alt=\"\">' : ph()) + '<div><b>' + esc(l.Product_Name) + '</b>' + badge + info + '</div></div></td><td>' + esc(variant || '-') + '</td><td>' + l.Quantity + '</td><td>' + money(l.Unit_Price) + '</td><td>' + money(l.Quantity * l.Unit_Price) + '</td></tr>';\n      }).join('');\n      var os = c ? (ordersByCust[c.customer_id] || []) : [];\n      return '<div class=\"rowb\"><div><h2>Order ' + esc(orderNo(o.OrderID)) + '</h2><div class=\"sub\">Placed ' + esc(fmtDT(o.Created_At) || 'unknown date') + (o.Paid_At ? ' - paid ' + esc(fmtDT(o.Paid_At)) : '') + '</div><div class=\"sub\">' + esc(SRC[o.Source] || o.Source || '') + ' - ID ' + esc(o.OrderID) + '</div></div><div style=\"display:flex;gap:8px;align-items:center\">' + chip(o.Status) + '<button type=\"button\" class=\"btn ghost sm\" id=\"oedit\">Edit</button><button type=\"button\" class=\"btn ghost sm\" id=\"oclose\">Close</button></div></div><div id=\"omsg\"></div>' +\n        '<div class=\"act\">' + acts.map(function (a) { return '<button type=\"button\" class=\"' + a[2] + ' sm\" data-st=\"' + a[0] + '\">' + a[1] + '</button>'; }).join('') + '</div>' +\n        '<div class=\"sect\"><h3>Customer</h3><dl class=\"kv\"><dt>Customer</dt><dd>' + (c ? '<button type=\"button\" class=\"linkb\" id=\"ocust\">' + esc(c.Name) + '</button> <span class=\"sub\">' + esc(platform(c.Platform)) + ' - ' + os.length + ' orders, ' + money(sum(os.filter(isRev), function (x) { return x.Total; })) + ' paid</span>' : esc(o.Full_Name || '-') + ' <span class=\"sub\">(no customer record)</span>') + '</dd><dt>Deliver to</dt><dd>' + esc(o.Full_Name || '-') + '</dd><dt>Phone</dt><dd>' + esc(o.Phone || '-') + '</dd><dt>Address</dt><dd>' + esc(o.Address || '-') + '</dd><dt>City</dt><dd>' + esc(o.City || '-') + '</dd><dt>Landmark</dt><dd>' + esc(o.Landmark || '-') + '</dd></dl></div>' +\n        '<div class=\"sect\"><h3>Items</h3>' + (L.length ? '<table class=\"lines\"><thead><tr><th>Product</th><th>Variant</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead><tbody>' + rows + '</tbody></table>' : '<div class=\"sub\">This order has no item lines.</div>') + '<div class=\"rowb\" style=\"margin-top:10px\"><div class=\"sub\">' + (nameLinks ? '<button type=\"button\" class=\"linkb\" id=\"orelink\">Link ' + nameLinks + ' item' + (nameLinks > 1 ? 's' : '') + ' to the product with the same name</button>' : '') + (Math.abs(calc - o.Total) > 0.005 && L.length ? ' Items add up to ' + money(calc) + '.' : '') + '</div><div><b>Total ' + money(o.Total) + '</b></div></div></div>' +\n        '<div class=\"sect\"><h3>Payment and delivery</h3><dl class=\"kv\"><dt>Payment</dt><dd>' + esc(o.Payment_Method || 'Not paid yet') + '</dd><dt>Tracking</dt><dd>' + esc(o.Tracking || '-') + '</dd><dt>Notes</dt><dd>' + esc(o.Notes || '-') + '</dd></dl></div>' +\n        '<div class=\"act\" style=\"margin-top:22px\"><button type=\"button\" class=\"btn danger sm\" id=\"odel\">Delete order</button></div>';\n    }\n    function bindRead() {\n      $id('oclose').addEventListener('click', closeModal);\n      $id('oedit').addEventListener('click', function () { editing = true; totalDirty = Math.abs(o.Total - sum(L, function (l) { return l.Quantity * l.Unit_Price; })) > 0.005; paint(); });\n      Array.prototype.forEach.call(sheet.querySelectorAll('button[data-st]'), function (b) {\n        b.addEventListener('click', function () { setStatus(b.getAttribute('data-st')); });\n      });\n      Array.prototype.forEach.call(sheet.querySelectorAll('button[data-open]'), function (b) {\n        b.addEventListener('click', function () { var pid = b.getAttribute('data-open'); closeModal(); FG.goto('products', { focus: pid }); });\n      });\n      var oc = $id('ocust'); if (oc) { oc.addEventListener('click', function () { openCustomer(o.customer_id); }); }\n      var rl = $id('orelink');\n      if (rl) { rl.addEventListener('click', function () {\n        var items = L.map(function (l) { var r = resolve(l); var x = copy(l); if (r.how === 'name') { x.Item_ID = r.p.Item_ID; x.Product_Name = r.p.Name; if (!x.Image) { x.Image = r.p.Product_Image || ''; } } return x; });\n        save(o, items, rl);\n      }); }\n      $id('odel').addEventListener('click', function () {\n        if (!window.confirm('Delete order ' + orderNo(o.OrderID) + ' and its items? This cannot be undone. Cancel it instead if you only want to stop it.')) { return; }\n        var b = $id('odel'); busy(b, true, 'Deleting...');\n        call('order_delete', { OrderID: o.OrderID }).then(function (res) {\n          busy(b, false);\n          if (!res.ok) { return msg('bad', res.error); }\n          toast('Order deleted.'); closeModal(); load(function () { onChange(); });\n        });\n      });\n    }\n    function setStatus(ns) {\n      var upd = Object.assign({}, o, { Status: ns });\n      if (ns === 'Shipped' && !o.Tracking) { var t = window.prompt('Tracking number (optional):', ''); if (t === null) { return; } upd.Tracking = t; }\n      if (ns === 'Cancelled' || ns === 'Refunded') { if (!window.confirm('Mark this order as ' + label(ns).toLowerCase() + '? Product stock is not changed automatically.')) { return; } }\n      if (ns === 'Paid' && !upd.Paid_At) { upd.Paid_At = new Date().toISOString(); }\n      save(upd, null, null);\n    }\n\n    function lineRow(l, i) {\n      var popts = '<option value=\"\">Custom item</option>' + D.products.slice().sort(byName).map(function (p) { return '<option value=\"' + esc(p.Item_ID) + '\"' + (p.Item_ID === l.Item_ID ? ' selected' : '') + '>' + esc(p.Name) + (p.Status === 'archived' ? ' (archived)' : '') + '</option>'; }).join('');\n      if (l.Item_ID && !prodById[l.Item_ID]) { popts += '<option value=\"' + esc(l.Item_ID) + '\" selected>(deleted product)</option>'; }\n      var p = prodById[l.Item_ID];\n      var list = function (s) { return String(s || '').split(',').map(function (x) { return x.trim(); }).filter(Boolean); };\n      var sizes = p ? list(p.Sizes) : [];\n      var colors = p ? list(p.Colors) : [];\n      return '<tr data-i=\"' + i + '\"><td><select data-f=\"Item_ID\" style=\"width:100%\">' + popts + '</select><input data-f=\"Product_Name\" value=\"' + esc(l.Product_Name) + '\" placeholder=\"Item name\" style=\"margin-top:6px\"></td><td><input data-f=\"Size\" list=\"dls' + i + '\" value=\"' + esc(l.Size) + '\" style=\"width:84px\"><datalist id=\"dls' + i + '\">' + sizes.map(function (s) { return '<option value=\"' + esc(s) + '\">'; }).join('') + '</datalist></td><td><input data-f=\"Color\" list=\"dlc' + i + '\" value=\"' + esc(l.Color) + '\" style=\"width:96px\"><datalist id=\"dlc' + i + '\">' + colors.map(function (s) { return '<option value=\"' + esc(s) + '\">'; }).join('') + '</datalist></td><td><input data-f=\"Quantity\" value=\"' + esc(l.Quantity) + '\" style=\"width:60px\"></td><td><input data-f=\"Unit_Price\" value=\"' + esc(l.Unit_Price) + '\" style=\"width:80px\"></td><td><button type=\"button\" class=\"btn danger sm\" data-rm=\"' + i + '\">x</button></td></tr>';\n    }\n    function editHtml() {\n      var copts = '<option value=\"\">Not linked to a customer</option>' + D.customers.slice().sort(byName).map(function (c) { return '<option value=\"' + esc(c.customer_id) + '\"' + (c.customer_id === o.customer_id ? ' selected' : '') + '>' + esc(c.Name) + (c.Phone ? ' - ' + esc(c.Phone) : '') + '</option>'; }).join('');\n      var sts = STATUSES.indexOf(o.Status) < 0 ? STATUSES.concat([o.Status]) : STATUSES;\n      var sopts = sts.map(function (s) { return '<option value=\"' + esc(s) + '\"' + (s === o.Status ? ' selected' : '') + '>' + esc(label(s)) + '</option>'; }).join('');\n      var pdl = '<datalist id=\"epaylist\">' + PAYS.map(function (p) { return '<option value=\"' + esc(p) + '\">'; }).join('') + '</datalist>';\n      return '<div class=\"rowb\"><h2>' + (o.OrderID ? 'Edit order ' + esc(orderNo(o.OrderID)) : 'New order') + '</h2><button type=\"button\" class=\"btn ghost sm\" id=\"ecancel\">Cancel</button></div><div id=\"omsg\"></div>' +\n        '<div class=\"frm\"><div class=\"full\"><label for=\"ecust\">Customer</label><select id=\"ecust\" style=\"width:100%\">' + copts + '</select></div>' + fld('efname', 'Delivery name', o.Full_Name, 'Name for the delivery') + fld('ephone', 'Phone', o.Phone, '') + fld('ecity', 'City', o.City, '') + fld('elandmark', 'Landmark or delivery note', o.Landmark, '') +\n        '<div class=\"full\">' + area('eaddr', 'Delivery address', o.Address, '') + '</div>' +\n        '<div><label for=\"estatus\">Status</label><select id=\"estatus\" style=\"width:100%\">' + sopts + '</select></div><div><label for=\"epay\">Payment method</label><input id=\"epay\" list=\"epaylist\" value=\"' + esc(o.Payment_Method) + '\" placeholder=\"stripe (card), cash...\" autocomplete=\"off\">' + pdl + '</div>' +\n        fld('etrack', 'Tracking number', o.Tracking, '') + '<div></div><div class=\"full\">' + area('enotes', 'Internal notes (never shown to the customer)', o.Notes, '') + '</div></div>' +\n        '<div class=\"sect\"><div class=\"rowb\"><h3 style=\"margin:0\">Items</h3><button type=\"button\" class=\"btn ghost sm\" id=\"eadd\">' + ic('plus', 14) + 'Add item</button></div><table class=\"lines\" style=\"margin-top:8px\"><thead><tr><th>Product</th><th>Size</th><th>Colour</th><th>Qty</th><th>Price</th><th></th></tr></thead><tbody id=\"elines\"></tbody></table></div>' +\n        '<div class=\"frm\" style=\"margin-top:10px\"><div><label for=\"etotal\">Order total (USD)</label><input id=\"etotal\" value=\"' + esc(o.Total) + '\" autocomplete=\"off\"></div><div style=\"align-self:end;padding-bottom:10px\"><span class=\"sub\" id=\"ecalc\"></span></div></div>' +\n        '<div style=\"display:flex;gap:10px;justify-content:flex-end;margin-top:18px\"><button type=\"button\" class=\"btn ghost\" id=\"ecancel2\">Cancel</button><button type=\"button\" class=\"btn\" id=\"esave\">Save order</button></div>';\n    }\n    function bindEdit() {\n      function calc() { return sum(L, function (l) { return num(l.Quantity) * num(l.Unit_Price); }); }\n      function recalc() { $id('ecalc').textContent = 'Items add up to ' + money(calc()) + '.'; if (!totalDirty) { $id('etotal').value = calc().toFixed(2); } }\n      function renderLines() { $id('elines').innerHTML = L.map(lineRow).join('') || '<tr><td colspan=\"6\" class=\"sub\">No items yet. Press Add item.</td></tr>'; recalc(); }\n      renderLines();\n      function cancel() { if (o.OrderID) { editing = false; paint(); } else { closeModal(); } }\n      $id('ecancel').addEventListener('click', cancel);\n      $id('ecancel2').addEventListener('click', cancel);\n      $id('etotal').addEventListener('input', function () { totalDirty = true; });\n      $id('eadd').addEventListener('click', function () { L.push({ Item_ID: '', Product_Name: '', Size: '', Color: '', Quantity: 1, Unit_Price: 0, Image: '' }); renderLines(); });\n      $id('elines').addEventListener('input', function (e) { var t = e.target; var f = t.getAttribute('data-f'); var tr = t.closest('tr'); if (!f || !tr) { return; } L[Number(tr.getAttribute('data-i'))][f] = t.value; recalc(); });\n      $id('elines').addEventListener('change', function (e) {\n        var t = e.target;\n        if (t.getAttribute('data-f') !== 'Item_ID') { return; }\n        var i = Number(t.closest('tr').getAttribute('data-i'));\n        var p = prodById[t.value];\n        L[i].Item_ID = t.value;\n        if (p) { L[i].Product_Name = p.Name; L[i].Unit_Price = p.Price; L[i].Image = p.Product_Image || ''; L[i].Size = ''; L[i].Color = ''; }\n        renderLines();\n      });\n      $id('elines').addEventListener('click', function (e) { var b = e.target.closest('button[data-rm]'); if (!b) { return; } L.splice(Number(b.getAttribute('data-rm')), 1); renderLines(); });\n      $id('ecust').addEventListener('change', function () {\n        var c = custById[$id('ecust').value];\n        if (!c) { return; }\n        if (!$id('efname').value.trim()) { $id('efname').value = c.Name; }\n        if (!$id('ephone').value.trim()) { $id('ephone').value = c.Phone; }\n        if (!$id('eaddr').value.trim()) { $id('eaddr').value = c.Address; }\n      });\n      $id('esave').addEventListener('click', function () {\n        var cid = $id('ecust').value;\n        var name = $id('efname').value.trim() || ((custById[cid] || {}).Name || '');\n        if (!name) { return msg('bad', 'Choose a customer or type the delivery name.'); }\n        if (!o.OrderID && !L.length) { return msg('bad', 'Add at least one item.'); }\n        var items = L.map(function (l) { return { Item_ID: l.Item_ID || '', Product_Name: String(l.Product_Name || '').trim(), Size: String(l.Size || '').trim(), Color: String(l.Color || '').trim(), Quantity: num(l.Quantity), Unit_Price: num(l.Unit_Price), Image: l.Image || '' }; });\n        var upd = Object.assign({}, o, { customer_id: cid, Full_Name: name, Phone: $id('ephone').value.trim(), Address: $id('eaddr').value.trim(), City: $id('ecity').value.trim(), Landmark: $id('elandmark').value.trim(), Status: $id('estatus').value, Payment_Method: $id('epay').value.trim(), Tracking: $id('etrack').value.trim(), Notes: $id('enotes').value.trim(), Total: $id('etotal').value.trim().replace(',', '.') });\n        save(upd, items, $id('esave'));\n      });\n    }\n    paint();\n  }\n\n  /* ---------- Customers ---------- */\n  var CF = null;\n  function custStats(c) {\n    var os = (ordersByCust[c.customer_id] || []).slice().sort(function (a, b) { return ts(b) - ts(a); });\n    var paid = os.filter(isRev);\n    return { orders: os, count: os.length, paidCount: paid.length, spent: sum(paid, function (o) { return o.Total; }), last: os.length ? ts(os[0]) : 0 };\n  }\n  function viewCustomers(el) {\n    CF = { q: '', f: 'all', sort: 'recent' };\n    var HEAD = '<div class=\"head row2\"><div><h1>Customers</h1><p>Everyone who has messaged your shop, with their orders and contact details.</p></div><button class=\"btn\" id=\"cnew\">' + ic('plus', 16) + 'New customer</button></div>';\n    el.innerHTML = HEAD + skeleton();\n    load(function () {\n      el.innerHTML = HEAD + '<div class=\"stats\" id=\"cstats\"></div><div class=\"tb\"><input id=\"cq\" placeholder=\"Search by name, phone, email or address\"><select id=\"csort\"><option value=\"recent\">Latest order</option><option value=\"orders\">Most orders</option><option value=\"spent\">Top spenders</option><option value=\"name\">Name A-Z</option></select></div><div class=\"chips\" id=\"cchips\"></div><div class=\"desc\" id=\"ccount\"></div><div id=\"clist\"></div>';\n      function draw() {\n        var all = D.customers.map(function (c) { return { c: c, s: custStats(c) }; });\n        var repeat = all.filter(function (x) { return x.s.paidCount >= 2; }).length;\n        var withOrders = all.filter(function (x) { return x.s.count > 0; }).length;\n        $id('cstats').innerHTML = [['Customers', all.length], ['With orders', withOrders], ['Repeat buyers', repeat], ['Lifetime revenue', money(sum(all, function (x) { return x.s.spent; }))]].map(function (c) { return '<div class=\"stat\" style=\"cursor:default\"><small>' + c[0] + '</small><b>' + c[1] + '</b></div>'; }).join('');\n        var chips = [['all', 'All', all.length], ['orders', 'With orders', withOrders], ['none', 'No orders', all.length - withOrders], ['repeat', 'Repeat buyers', repeat]];\n        $id('cchips').innerHTML = chips.map(function (c) { return '<button class=\"fc' + (CF.f === c[0] ? ' on' : '') + '\" data-f=\"' + c[0] + '\">' + c[1] + ' (' + c[2] + ')</button>'; }).join('');\n        var q = lc(CF.q);\n        var list = all.filter(function (x) {\n          if (CF.f === 'orders' && !x.s.count) { return false; }\n          if (CF.f === 'none' && x.s.count) { return false; }\n          if (CF.f === 'repeat' && x.s.paidCount < 2) { return false; }\n          if (q && [x.c.Name, x.c.Phone, x.c.Email, x.c.Address, x.c.customer_id].join(' ').toLowerCase().indexOf(q) < 0) { return false; }\n          return true;\n        });\n        list.sort(function (a, b) {\n          if (CF.sort === 'orders') { return b.s.count - a.s.count; }\n          if (CF.sort === 'spent') { return b.s.spent - a.s.spent; }\n          if (CF.sort === 'name') { return byName(a.c, b.c); }\n          return b.s.last - a.s.last;\n        });\n        $id('ccount').textContent = 'Showing ' + list.length + ' of ' + all.length + ' customers';\n        if (!list.length) { $id('clist').innerHTML = '<div class=\"card empty\"><div class=\"big\">' + ic('user', 26) + '</div><h2>' + (all.length ? 'No customers match' : 'No customers yet') + '</h2><p>' + (all.length ? 'Try a different filter.' : 'Customers who message your Page are added automatically. You can also add one by hand.') + '</p></div>'; return; }\n        $id('clist').innerHTML = '<div class=\"otable\"><div class=\"orow cust h\"><div>Customer</div><div>Contact</div><div>Orders</div><div>Spent</div><div>Last order</div></div>' + list.map(function (x) {\n          return '<div class=\"orow cust\" data-id=\"' + esc(x.c.customer_id) + '\"><div><b>' + esc(x.c.Name) + '</b><div class=\"sub\">' + esc(platform(x.c.Platform)) + '</div></div><div>' + esc(x.c.Phone || x.c.Email || 'No contact info') + '<div class=\"sub\">' + esc(x.c.Address || '') + '</div></div><div><b>' + x.s.count + '</b></div><div><b>' + money(x.s.spent) + '</b></div><div>' + (x.s.last ? esc(fmtDate(new Date(x.s.last).toISOString())) : '-') + '</div></div>';\n        }).join('') + '</div>';\n      }\n      onChange = draw;\n      $id('cq').addEventListener('input', function () { CF.q = this.value; draw(); });\n      $id('csort').addEventListener('change', function () { CF.sort = this.value; draw(); });\n      $id('cchips').addEventListener('click', function (e) { var b = e.target.closest('button[data-f]'); if (b) { CF.f = b.getAttribute('data-f'); draw(); } });\n      $id('clist').addEventListener('click', function (e) { var r = e.target.closest('.orow[data-id]'); if (r) { openCustomer(r.getAttribute('data-id')); } });\n      $id('cnew').addEventListener('click', function () { openCustomer(null); });\n      draw();\n    });\n  }\n  function openCustomer(id) {\n    var base = id ? custById[id] : null;\n    if (id && !base) { toast('That customer no longer exists.'); return; }\n    var c = base ? copy(base) : { customer_id: '', Name: '', Platform: 'manual', Phone: '', Address: '', Email: '', Interests: '', Birthday: '', Notes: '' };\n    var s = base ? custStats(base) : { orders: [], count: 0, paidCount: 0, spent: 0, last: 0 };\n    var sheet = openModal(true);\n    var olist = s.orders.map(function (o) { return '<div class=\"orow\" style=\"grid-template-columns:1fr 2fr .8fr 1fr;padding:10px 0\" data-oid=\"' + esc(o.OrderID) + '\"><div><b>' + esc(orderNo(o.OrderID)) + '</b><div class=\"sub\">' + esc(fmtDate(o.Created_At)) + '</div></div><div class=\"sub\">' + esc((itemsByOrder[o.OrderID] || []).map(function (l) { return l.Quantity + 'x ' + l.Product_Name; }).join(', ') || 'No items') + '</div><div><b>' + money(o.Total) + '</b></div><div>' + chip(o.Status) + '</div></div>'; }).join('');\n    sheet.innerHTML = '<div class=\"rowb\"><div><h2>' + (id ? esc(c.Name) : 'New customer') + '</h2>' + (id ? '<div class=\"sub\">' + esc(platform(c.Platform)) + ' - ID ' + esc(c.customer_id) + '</div>' : '') + '</div><button type=\"button\" class=\"btn ghost sm\" id=\"cclose\">Close</button></div><div id=\"omsg\"></div>' +\n      (id ? '<div class=\"stats\" style=\"margin-top:14px\"><div class=\"stat\" style=\"cursor:default\"><small>Orders</small><b>' + s.count + '</b></div><div class=\"stat\" style=\"cursor:default\"><small>Paid orders</small><b>' + s.paidCount + '</b></div><div class=\"stat\" style=\"cursor:default\"><small>Total spent</small><b>' + money(s.spent) + '</b></div><div class=\"stat\" style=\"cursor:default\"><small>Last order</small><b style=\"font-size:15px\">' + (s.last ? esc(fmtDate(new Date(s.last).toISOString())) : '-') + '</b></div></div>' : '') +\n      '<div class=\"frm\">' + fld('cname', 'Name', c.Name, '') + fld('cphone', 'Phone', c.Phone, '') + fld('cemail', 'Email', c.Email, '') + fld('cbirth', 'Birthday', c.Birthday, '') + '<div class=\"full\">' + area('caddr', 'Address', c.Address, '') + '</div>' + fld('cint', 'Interests', c.Interests, 'Things they like (from the chat)', 'full') + '<div class=\"full\">' + area('cnotes', 'Internal notes', c.Notes, '') + '</div></div>' +\n      (id ? '<div class=\"sect\"><h3>Order history</h3>' + (olist || '<div class=\"sub\">No orders yet.</div>') + '</div>' : '') +\n      '<div class=\"act\" style=\"margin-top:20px;justify-content:space-between\"><div>' + (id ? '<button type=\"button\" class=\"btn danger sm\" id=\"cdel\">Delete customer</button>' : '') + '</div><div style=\"display:flex;gap:8px\">' + (id ? '<button type=\"button\" class=\"btn ghost\" id=\"cneword\">New order</button>' : '') + '<button type=\"button\" class=\"btn\" id=\"csave\">Save customer</button></div></div>';\n    $id('cclose').addEventListener('click', closeModal);\n    Array.prototype.forEach.call(sheet.querySelectorAll('[data-oid]'), function (r) { r.addEventListener('click', function () { openOrder(r.getAttribute('data-oid')); }); });\n    var no = $id('cneword'); if (no) { no.addEventListener('click', function () { openOrder(null, { customer_id: id }); }); }\n    $id('csave').addEventListener('click', function () {\n      var name = $id('cname').value.trim();\n      if (!name) { return msg('bad', 'Give the customer a name.'); }\n      var upd = Object.assign({}, c, { Name: name, Phone: $id('cphone').value.trim(), Email: $id('cemail').value.trim(), Birthday: $id('cbirth').value.trim(), Address: $id('caddr').value.trim(), Interests: $id('cint').value.trim(), Notes: $id('cnotes').value.trim() });\n      var b = $id('csave'); busy(b, true, 'Saving...');\n      call('customer_save', { customer: upd }).then(function (res) {\n        busy(b, false);\n        if (!res.ok) { if (res.error === 'unauthorized') { closeModal(); return fail(res); } return msg('bad', res.error); }\n        toast('Customer saved.');\n        load(function () { onChange(); if (id) { openCustomer(res.customer.customer_id); } else { closeModal(); } });\n      });\n    });\n    var cd = $id('cdel');\n    if (cd) { cd.addEventListener('click', function () {\n      if (!window.confirm('Delete ' + c.Name + '? This only works for customers without orders.')) { return; }\n      busy(cd, true, 'Deleting...');\n      call('customer_delete', { customer_id: id }).then(function (res) {\n        busy(cd, false);\n        if (!res.ok) { if (res.error === 'unauthorized') { closeModal(); return fail(res); } return msg('bad', res.error); }\n        toast('Customer deleted.'); closeModal(); load(function () { onChange(); });\n      });\n    }); }\n  }\n\n  window.FG_MOD = { orders: viewOrders, customers: viewCustomers };\n})();`;\nreturn [{ json: { js } }];"},"typeVersion":2},{"id":"6edaad1f-02da-4314-8354-96a0c68f5282","name":"Respond: orders module","type":"n8n-nodes-base.respondToWebhook","position":[-3568,8124],"parameters":{"options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Content-Type","value":"application/javascript; charset=utf-8"},{"name":"Cache-Control","value":"no-store"}]}},"respondWith":"text","responseBody":"={{ $json.js }}"},"typeVersion":1.5},{"id":"f98aae8f-2512-41e3-b5cf-d199a48f8558","name":"Extend more","type":"n8n-nodes-base.code","position":[-1888,9196],"parameters":{"jsCode":"const d = $input.first().json;\nconst p = $('Parse API').first().json;\nconst b = p.body || {};\nconst clean = (v, max) => String(v == null ? '' : v).trim().slice(0, max);\nconst unknown = d.route === 'respond' && d.result && d.result.error === 'Unknown action.';\nif (!unknown) return [{ json: d }];\nconst settings = {};\nfor (const it of $('Load settings').all()) { if (it.json.settingKey) settings[it.json.settingKey] = it.json.settingValue; }\nconst base = { body: d.body, adminUsername: d.adminUsername };\nconst out = (result) => [{ json: Object.assign({ route: 'respond', result }, base) }];\nconst go = (route, ctx) => [{ json: Object.assign({ route, ctx: ctx || {} }, base) }];\nif (p.action === 'inbox_reply') {\n  const id = clean(b.escalationId, 60);\n  if (!id || !/^[A-Za-z0-9_-]+$/.test(id)) return out({ ok: false, error: 'Missing question.' });\n  const mode = ['send', 'queue', 'dismiss'].indexOf(b.mode) >= 0 ? b.mode : 'send';\n  const answer = clean(b.answer, 2000);\n  if (mode !== 'dismiss' && answer.length < 2) return out({ ok: false, error: 'Write an answer first.' });\n  return go('inbox_reply', { escalationId: id, mode, answer, token: String(settings.metaPageAccessToken || '') });\n}\nif (p.action === 'errors_list') return go('errors_list');\nif (p.action === 'errors_dismiss') return go('errors_dismiss');\nif (p.action === 'errors_clear') return go('errors_clear');\nif (p.action === 'config_get') return go('config_get');\nif (p.action === 'config_save') {\n  const store = clean(b.storeName, 80);\n  const prompt = clean(b.systemPrompt, 12000);\n  if (prompt.length < 20) return out({ ok: false, error: 'The assistant instructions are too short.' });\n  return go('config_save', { storeName: store, systemPrompt: prompt });\n}\nif (p.action === 'preview_chat') {\n  const message = clean(b.message, 1000);\n  if (!message) return out({ ok: false, error: 'Type a message first.' });\n  const history = (Array.isArray(b.history) ? b.history : []).slice(-10).map((h) => ({ role: h && h.role === 'assistant' ? 'assistant' : 'user', text: clean(h && h.text, 800) }));\n  return go('preview_chat', { message, history });\n}\nreturn [{ json: d }];"},"typeVersion":2},{"id":"165d1ab6-034f-4f02-8dbb-497e006326b3","name":"Route more","type":"n8n-nodes-base.switch","position":[-4048,16396],"parameters":{"rules":{"values":[{"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.route }}","rightValue":"inbox_reply"}]}},{"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.route }}","rightValue":"config_get"}]}},{"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.route }}","rightValue":"config_save"}]}},{"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.route }}","rightValue":"preview_chat"}]}},{"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.route }}","rightValue":"errors_list"}]}},{"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.route }}","rightValue":"errors_dismiss"}]}},{"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.route }}","rightValue":"errors_clear"}]}}]},"options":{}},"typeVersion":3.2},{"id":"b5218af4-60d6-4167-9a3a-81a01bd53511","name":"Find escalation","type":"n8n-nodes-base.dataTable","position":[-3808,15948],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"escalationId","keyValue":"={{ $json.ctx.escalationId }}"}]},"matchType":"allConditions","operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"Sales Escalations","cachedResultName":"Sales Escalations"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"639434bd-dc18-47ed-ba45-9794ae6be347","name":"Plan reply","type":"n8n-nodes-base.code","position":[-3568,15948],"parameters":{"jsCode":"const ctx = $('Extend more').first().json.ctx;\nconst row = $input.first().json || {};\nconst fail = (m) => [{ json: { err: m } }];\nif (!row.escalationId) return fail('That question no longer exists.');\nif (row.status === 'delivered') return fail('This question was already answered and delivered.');\nconst now = new Date().toISOString();\nif (ctx.mode === 'dismiss') return [{ json: { err: '', send: false, note: 'Closed without an answer.', update: { status: 'dismissed', adminAnswer: row.adminAnswer || '', answeredAt: now, deliveredAt: '' } } }];\nif (ctx.mode === 'queue') return [{ json: { err: '', send: false, note: 'Saved. The assistant will give this answer the next time the customer writes.', update: { status: 'answered_pending_delivery', adminAnswer: ctx.answer, answeredAt: now, deliveredAt: '' } } }];\nif (!ctx.token) return fail('Connect your Facebook Page in Settings to send replies from here, or choose Save for next message.');\nreturn [{ json: { err: '', send: true, customerId: String(row.customerId), token: ctx.token, answer: ctx.answer, update: { status: 'answered_pending_delivery', adminAnswer: ctx.answer, answeredAt: now, deliveredAt: '' } } }];"},"typeVersion":2},{"id":"cdd6a370-d01b-4ee3-90e8-4e13174be5bc","name":"Plan ok?","type":"n8n-nodes-base.if","position":[-3328,15948],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ String(!$json.err) }}","rightValue":"true"}]}},"typeVersion":2.3},{"id":"d0a5d199-7f56-4b8a-9df0-7da08103ec9b","name":"Reply error","type":"n8n-nodes-base.code","position":[-3088,16028],"parameters":{"jsCode":"return [{ json: { result: { ok: false, error: $json.err } } }];"},"typeVersion":2},{"id":"d3b20d2a-ca11-460c-b319-dde6519d8002","name":"Send now?","type":"n8n-nodes-base.if","position":[-3088,15868],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ String($json.send === true) }}","rightValue":"true"}]}},"typeVersion":2.3},{"id":"faea5179-dbdc-4c18-84b3-a4d59a75507e","name":"Send Messenger reply","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[-2848,15868],"parameters":{"url":"https://graph.facebook.com/v25.0/me/messages","method":"POST","options":{"response":{"response":{"neverError":true}}},"jsonBody":"={{ JSON.stringify({ recipient: { id: $json.customerId }, messaging_type: 'RESPONSE', message: { text: $json.answer } }) }}","sendBody":true,"sendQuery":true,"specifyBody":"json","queryParameters":{"parameters":[{"name":"access_token","value":"={{ $json.token }}"}]}},"typeVersion":4.3},{"id":"0fde7314-569b-4dea-bd98-3f91b0702246","name":"Finish send","type":"n8n-nodes-base.code","position":[-2608,15868],"parameters":{"jsCode":"const plan = $('Plan reply').first().json;\nconst r = $input.first().json || {};\nconst ok = !!r.message_id && !r.error;\nconst now = new Date().toISOString();\nconst update = Object.assign({}, plan.update);\nlet note = 'Sent to the customer on Messenger.';\nif (ok) { update.status = 'delivered'; update.deliveredAt = now; }\nelse {\n  const m = r.error && r.error.message ? String(r.error.message) : '';\n  note = 'Messenger would not take the message now (' + (m || 'the 24-hour reply window has probably closed') + '). Saved: the assistant will give this answer the next time the customer writes.';\n}\nreturn [{ json: { update, note, sent: ok } }];"},"typeVersion":2},{"id":"3a329d02-2e9e-49e5-b96a-2f19178a0530","name":"Save escalation","type":"n8n-nodes-base.dataTable","position":[-2368,15868],"parameters":{"columns":{"value":{"status":"={{ $json.update.status }}","answeredAt":"={{ $json.update.answeredAt || null }}","adminAnswer":"={{ $json.update.adminAnswer }}","deliveredAt":"={{ $json.update.deliveredAt || null }}"},"schema":[{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"adminAnswer","type":"string","display":true,"required":false,"displayName":"adminAnswer","defaultMatch":false,"canBeUsedToMatch":true},{"id":"answeredAt","type":"dateTime","display":true,"required":false,"displayName":"answeredAt","defaultMatch":false,"canBeUsedToMatch":true},{"id":"deliveredAt","type":"dateTime","display":true,"required":false,"displayName":"deliveredAt","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"filters":{"conditions":[{"keyName":"escalationId","keyValue":"={{ $('Extend more').first().json.ctx.escalationId }}"}]},"options":{},"matchType":"allConditions","operation":"update","dataTableId":{"__rl":true,"mode":"name","value":"Sales Escalations","cachedResultName":"Sales Escalations"}},"typeVersion":1.1},{"id":"5153a3df-a7d4-4f42-985e-941f7d6a6d68","name":"Compose reply result","type":"n8n-nodes-base.code","position":[-1648,15868],"parameters":{"jsCode":"const plan = $('Plan reply').first().json;\nlet note = plan.note || '';\nlet status = plan.update.status;\nif ($('Finish send').isExecuted) { const f = $('Finish send').first().json; note = f.note; status = f.update.status; }\nreturn [{ json: { result: { ok: true, status, note } } }];"},"typeVersion":2},{"id":"c149f49c-6491-4674-8d7d-9cb36a93ac3a","name":"Get assistant config","type":"n8n-nodes-base.dataTable","position":[-3808,16188],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"configKey","keyValue":"clothing_sales