response":{"neverError":true}}},"sendQuery":true,"queryParameters":{"parameters":[{"name":"object","value":"page"},{"name":"callback_url","value":"={{ $('Decide').first().json.ctx.botUrl }}"},{"name":"verify_token","value":"={{ $('Decide').first().json.ctx.verifyToken }}"},{"name":"fields","value":"messages,messaging_postbacks,message_echoes"},{"name":"access_token","value":"={{ $('Decide').first().json.ctx.appId }}|{{ $('Decide').first().json.ctx.appSecret }}"}]}},"typeVersion":4.4},{"id":"9ab9700c-0621-4d7b-882e-775f3a5aee7d","name":"Compose Page result","type":"n8n-nodes-base.code","position":[-3568,9948],"parameters":{"jsCode":"const d = $('Decide').first().json;\nconst a = $('Subscribe Page to app').first().json || {};\nconst r = $input.first().json || {};\nconst subscribed = a.success === true;\nconst registered = r.success === true;\nlet warning = '';\nif (!subscribed) { warning = 'Page saved, but subscribing it to your app failed: ' + ((a.error && a.error.message) || 'unknown error'); }\nelse if (!registered) { warning = 'Page saved and subscribed, but Meta could not verify the bot webhook: ' + ((r.error && r.error.message) || 'unknown error') + ' Make sure the bot uses this same verify token.'; }\nconst writes = [\n  { settingKey: 'metaPageId', settingValue: d.ctx.pageId },\n  { settingKey: 'metaPageName', settingValue: d.ctx.pageName },\n  { settingKey: 'metaPageAccessToken', settingValue: d.ctx.pageToken },\n  { settingKey: 'fbPendingPages', settingValue: '' }\n];\nreturn [{ json: { route: 'save', result: { ok: true, pageName: d.ctx.pageName, subscribed, registered, warning }, writes } }];"},"typeVersion":2},{"id":"3159e14a-77a2-425e-8a58-9e48061425bd","name":"Check Stripe key","type":"n8n-nodes-base.httpRequest","position":[-4048,10780],"parameters":{"url":"https://api.stripe.com/v1/account","options":{"response":{"response":{"neverError":true}}},"sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{ $json.ctx.key }}"}]}},"typeVersion":4.4},{"id":"5174efe6-6e36-4ebd-a966-e8c2c31b86f2","name":"Compose Stripe result","type":"n8n-nodes-base.code","position":[-3808,10780],"parameters":{"jsCode":"const r = $input.first().json || {};\nif (r.error) { return [{ json: { result: { ok: false, error: r.error.message || 'Stripe rejected this key.' } } }]; }\nconst key = $('Decide').first().json.ctx.key || '';\nconst live = key.indexOf('sk_live') === 0 || key.indexOf('rk_live') === 0;\nconst name = (r.business_profile && r.business_profile.name) || (r.settings && r.settings.dashboard && r.settings.dashboard.display_name) || r.email || r.id || 'your Stripe account';\nreturn [{ json: { result: { ok: true, name, mode: live ? 'live' : 'test', country: r.country || '' } } }];"},"typeVersion":2},{"id":"00a1d484-466f-47f4-8f56-e55d7e8ac038","name":"FB Callback Webhook","type":"n8n-nodes-base.webhook","position":[-4048,10188],"webhookId":"8cbac885-33e5-4b43-b795-06a3dff621c3","parameters":{"path":"shop-fb-callback","options":{},"responseMode":"responseNode"},"typeVersion":2.1},{"id":"46bbca77-ffe0-4be3-bf28-9f4a5958ffff","name":"Load settings (callback)","type":"n8n-nodes-base.dataTable","position":[-3808,10188],"parameters":{"operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Shop Settings","cachedResultName":"Shop Settings"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"8e9c2f04-099d-4c65-a8c5-adab042cbca2","name":"Check state","type":"n8n-nodes-base.code","position":[-3568,10188],"parameters":{"jsCode":"const q = $('FB Callback Webhook').first().json.query || {};\nconst s = {};\nfor (const it of $('Load settings (callback)').all()) {\n  if (it.json.settingKey) s[it.json.settingKey] = it.json.settingValue;\n}\nconst ok = !!(q.code && q.state && s.fbState && q.state === s.fbState && Number(s.fbStateExpires) > Date.now());\nreturn [{ json: { ok, error: q.error_description || q.error || '', ctx: ok ? { code: q.code, appId: s.metaAppId, appSecret: s.metaAppSecret, redirect: s.fbRedirectUri } : null } }];"},"typeVersion":2},{"id":"b5d22e67-ac99-46b6-81f1-eb1d90c2c44f","name":"State valid?","type":"n8n-nodes-base.if","position":[-3328,10188],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ String($json.ok) }}","rightValue":"true"}]}},"typeVersion":2.3},{"id":"3b09158f-c772-49e1-b636-671b0b13aa38","name":"Exchange code for token","type":"n8n-nodes-base.httpRequest","position":[-3088,10108],"parameters":{"url":"https://graph.facebook.com/v25.0/oauth/access_token","method":"POST","options":{"response":{"response":{"neverError":true}}},"sendBody":true,"contentType":"form-urlencoded","bodyParameters":{"parameters":[{"name":"client_id","value":"={{ $json.ctx.appId }}"},{"name":"client_secret","value":"={{ $json.ctx.appSecret }}"},{"name":"redirect_uri","value":"={{ $json.ctx.redirect }}"},{"name":"code","value":"={{ $json.ctx.code }}"}]}},"typeVersion":4.4},{"id":"e1a00ac2-d7d7-4f0c-a3b8-2fba234ce45f","name":"Get long-lived token","type":"n8n-nodes-base.httpRequest","position":[-2848,10108],"parameters":{"url":"https://graph.facebook.com/v25.0/oauth/access_token","method":"POST","options":{"response":{"response":{"neverError":true}}},"sendBody":true,"contentType":"form-urlencoded","bodyParameters":{"parameters":[{"name":"grant_type","value":"fb_exchange_token"},{"name":"client_id","value":"={{ $('Check state').first().json.ctx.appId }}"},{"name":"client_secret","value":"={{ $('Check state').first().json.ctx.appSecret }}"},{"name":"fb_exchange_token","value":"={{ $json.access_token }}"}]}},"typeVersion":4.4},{"id":"6a853af3-cc5a-4de6-9ad5-c9252c7a6ec1","name":"List Pages","type":"n8n-nodes-base.httpRequest","position":[-2608,10108],"parameters":{"url":"https://graph.facebook.com/v25.0/me/accounts","options":{"response":{"response":{"neverError":true}}},"sendQuery":true,"queryParameters":{"parameters":[{"name":"fields","value":"id,name,access_token"},{"name":"limit","value":"100"},{"name":"access_token","value":"={{ $json.access_token }}"}]}},"typeVersion":4.4},{"id":"ec2df02e-1d31-4bea-b30b-6946d3487bb1","name":"Build pending pages","type":"n8n-nodes-base.code","position":[-2368,10108],"parameters":{"jsCode":"const esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst PAGE = (title, msg, ok) => '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Sales Agent</title><style>body{font-family:system-ui,sans-serif;background:#0a0e1a;color:#e7e9f2;display:grid;place-items:center;min-height:100vh;margin:0}.c{background:#111729;border:1px solid #1f2740;border-radius:16px;padding:32px;max-width:420px;text-align:center}h1{font-size:20px;margin:0 0 8px;color:' + (ok ? '#4ade80' : '#f87171') + '}p{color:#98a2b8;line-height:1.5;margin:0}</style></head><body><div class=\"c\"><h1>' + title + '</h1><p>' + msg + '</p></div></body></html>';\nconst ex = $('Exchange code for token').first().json || {};\nconst ll = $('Get long-lived token').first().json || {};\nconst r = $input.first().json || {};\nconst err = (ex.error && ex.error.message) || (ll.error && ll.error.message) || (r.error && r.error.message) || '';\nconst clear = [{ settingKey: 'fbState', settingValue: '' }];\nif (err || !Array.isArray(r.data)) { return [{ json: { writes: clear, html: PAGE('Could not connect', esc(err || 'Facebook did not return any Pages for this account.'), false) } }]; }\nconst pages = r.data.map(x => ({ id: x.id, name: x.name, access_token: x.access_token })).filter(x => x.access_token);\nif (!pages.length) { return [{ json: { writes: clear, html: PAGE('No Pages found', 'This Facebook account does not manage any Pages, or you did not grant access to one.', false) } }]; }\nreturn [{ json: { writes: [{ settingKey: 'fbPendingPages', settingValue: JSON.stringify(pages) }].concat(clear), html: PAGE('Facebook connected', 'You can close this tab and return to Sales Agent to choose your Page.', true) } }];"},"typeVersion":2},{"id":"fdc63356-19a1-4dd8-8825-50b9c8a24936","name":"Expand callback writes","type":"n8n-nodes-base.code","position":[-2128,10108],"parameters":{"jsCode":"const d = $input.first().json;\nconst w = (d.writes || []).slice();\nw.push({ settingKey: '_lastCallback', settingValue: String(Date.now()) });\nreturn w.map(x => ({ json: { settingKey: x.settingKey, settingValue: x.settingValue, html: d.html } }));"},"typeVersion":2},{"id":"3390dacb-10fb-4b44-af98-6bec0bda01db","name":"Save callback setting","type":"n8n-nodes-base.dataTable","position":[-1888,10108],"parameters":{"columns":{"value":{"settingKey":"={{ $json.settingKey }}","settingValue":"={{ $json.settingValue }}"},"schema":[{"id":"settingKey","type":"string","display":true,"required":false,"displayName":"settingKey","defaultMatch":false,"canBeUsedToMatch":true},{"id":"settingValue","type":"string","display":true,"required":false,"displayName":"settingValue","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow"},"filters":{"conditions":[{"keyName":"settingKey","keyValue":"={{ $json.settingKey }}"}]},"options":{},"matchType":"allConditions","operation":"upsert","dataTableId":{"__rl":true,"mode":"name","value":"Shop Settings","cachedResultName":"Shop Settings"}},"typeVersion":1.1},{"id":"51b80a37-5b76-4dfd-bc22-b040b7c5c3b5","name":"Respond: callback page","type":"n8n-nodes-base.respondToWebhook","position":[-1648,10108],"parameters":{"options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/html; charset=utf-8"}]}},"respondWith":"text","responseBody":"={{ $('Expand callback writes').first().json.html }}"},"executeOnce":true,"typeVersion":1.5},{"id":"199ca516-0963-4ee4-bf49-06dc065c0bec","name":"Build error page","type":"n8n-nodes-base.code","position":[-3088,10268],"parameters":{"jsCode":"const esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst c = $('Check state').first().json;\nconst msg = c.error ? 'Facebook said: ' + c.error : 'This sign-in link is invalid or has expired. Go back to Sales Agent and press Continue with Facebook again.';\nconst html = '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Sales Agent</title><style>body{font-family:system-ui,sans-serif;background:#0a0e1a;color:#e7e9f2;display:grid;place-items:center;min-height:100vh;margin:0}.c{background:#111729;border:1px solid #1f2740;border-radius:16px;padding:32px;max-width:420px;text-align:center}h1{font-size:20px;margin:0 0 8px;color:#f87171}p{color:#98a2b8;line-height:1.5;margin:0}</style></head><body><div class=\"c\"><h1>Could not connect</h1><p>' + esc(msg) + '</p></div></body></html>';\nreturn [{ json: { html } }];"},"typeVersion":2},{"id":"483fe39e-3d87-48b7-8ccf-9043a0c174d4","name":"Respond: callback error","type":"n8n-nodes-base.respondToWebhook","position":[-2848,10268],"parameters":{"options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/html; charset=utf-8"}]}},"respondWith":"text","responseBody":"={{ $json.html }}"},"typeVersion":1.5},{"id":"452bde9d-a43f-4980-916c-360f8fdc9df3","name":"Get products","type":"n8n-nodes-base.dataTable","position":[-4048,11916],"parameters":{"operation":"get","returnAll":true,"dataTableId":{"__rl":true,"mode":"name","value":"Sales Products","cachedResultName":"Sales Products"}},"typeVersion":1.1,"alwaysOutputData":true},{"id":"46f89af5-8c75-4af2-a5fa-ee37779a8c4f","name":"Compose products","type":"n8n-nodes-base.code","position":[-3808,11916],"parameters":{"jsCode":"const rows = $input.all().map(i => i.json).filter(r => r.Item_ID);\nconst products = rows.map(r => ({ Item_ID: r.Item_ID, Name: r.Name || '', Price: r.Price == null ? 0 : r.Price, Stock_Status: r.Stock_Status == null ? 0 : r.Stock_Status, Product_Image: r.Product_Image || '', Description: r.Description || '', Sizes: r.Sizes || '', Colors: r.Colors || '', Status: r.Status === 'archived' ? 'archived' : 'active' }));\nproducts.sort((a, b) => String(a.Name).toLowerCase() < String(b.Name).toLowerCase() ? -1 : 1);\nreturn [{ json: { result: { ok: true, products } } }];"},"typeVersion":2},{"id":"8739973b-f5b8-4701-94d0-208e5fd2d997","name":"Compose image result","type":"n8n-nodes-base.code","position":[-1648,12908],"parameters":{"jsCode":"const up = $('Upload photo to Drive').first().json;\nconst sh = $input.first().json;\nconst text = (e) => String(e && e.message ? e.message : (e || 'unknown error'));\nif (!up.id) return [{ json: { result: { ok: false, error: 'Google Drive upload failed: ' + text(up.error) } } }];\nif (sh.error || !sh.id) return [{ json: { result: { ok: false, error: 'The photo was uploaded but could not be made public: ' + text(sh.error) } } }];\nreturn [{ json: { result: { ok: true, imageId: up.id, url: 'https://lh3.googleusercontent.com/d/' + up.id } } }];"},"typeVersion":2},{"id":"1142483e-5808-4608-b8cf-266cd94173aa","name":"Save product","type":"n8n-nodes-base.dataTable","position":[-3088,12076],"parameters":{"columns":{"value":{"Name":"={{ $json.ctx.product.Name }}","Price":"={{ $json.ctx.product.Price }}","Sizes":"={{ $json.ctx.product.Sizes }}","Colors":"={{ $json.ctx.product.Colors }}","Status":"={{ $json.ctx.product.Status }}","Item_ID":"={{ $json.ctx.product.Item_ID }}","Description":"={{ $json.ctx.product.Description }}","Stock_Status":"={{ $json.ctx.product.Stock_Status }}","Product_Image":"={{ $json.ctx.product.Product_Image }}"},"schema":[{"id":"Item_ID","type":"string","display":true,"required":false,"displayName":"Item_ID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Name","type":"string","display":true,"required":false,"displayName":"Name