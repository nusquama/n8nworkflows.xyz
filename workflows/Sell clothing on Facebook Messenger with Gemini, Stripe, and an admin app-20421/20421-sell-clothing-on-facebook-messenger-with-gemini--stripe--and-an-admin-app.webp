 Info":{"main":[[{"node":"Save New Customer Record","type":"main","index":0}]]},"Get all products for orders":{"main":[[{"node":"Get all escalations","type":"main","index":0}]]},"Load connections (messages)":{"main":[[{"node":"Restore message input","type":"main","index":0}]]},"Save Answer To Agent Memory":{"main":[[{"node":"Compose reply result","type":"main","index":0}]]},"Send Text Reply to Customer":{"main":[[{"node":"Mark Admin Answers Delivered","type":"main","index":0}],[{"node":"Log: reply not delivered","type":"main","index":0}]]},"Setup: no instructions yet?":{"main":[[{"node":"Setup: add default instructions","type":"main","index":0}],[{"node":"Setup: done","type":"main","index":0}]]},"Create table: Sales Products":{"main":[[{"node":"Create table: Shop Admin Login","type":"main","index":0}]]},"Customer Conversation Memory":{"ai_memory":[[{"node":"Sales Agent (SalesPro)","type":"ai_memory","index":0}]]},"Save Payment To Agent Memory":{"main":[[{"node":"Payment message failed?","type":"main","index":0}]]},"When Called By This Workflow":{"main":[[{"node":"Load connections (messages)","type":"main","index":0}]]},"Create table: Sales Customers":{"main":[[{"node":"Create table: Sales Escalations","type":"main","index":0}]]},"Delivery: Get Customer Orders":{"main":[[{"node":"Delivery: Merge Details","type":"main","index":0}]]},"Create Stripe Checkout Session":{"main":[[{"node":"Save Payment Link","type":"main","index":0}],[{"node":"Return Payment Error","type":"main","index":0}]]},"Create table: Sales Cart Items":{"main":[[{"node":"Create table: Sales Checkout Sessions","type":"main","index":0}]]},"Create table: Shop Admin Login":{"main":[[{"node":"Create table: Shop Admin Sessions","type":"main","index":0}]]},"Load connections (return page)":{"main":[[{"node":"Restore return page","type":"main","index":0}]]},"Preview: Load assistant config":{"main":[[{"node":"Preview: Build prompt","type":"main","index":0}]]},"Setup: look for an admin login":{"main":[[{"node":"Setup: no admin login yet?","type":"main","index":0}]]},"checkout_and_send_payment_link":{"ai_tool":[[{"node":"Sales Agent (SalesPro)","type":"ai_tool","index":0}]]},"Create table: Sales Escalations":{"main":[[{"node":"Create table: Sales Order Items","type":"main","index":0}]]},"Create table: Sales Order Items":{"main":[[{"node":"Create table: Sales Orders","type":"main","index":0}]]},"Customer Memory (Admin Answers)":{"ai_memory":[[{"node":"Save Answer To Agent Memory","type":"ai_memory","index":0}]]},"Load connections (stripe event)":{"main":[[{"node":"Restore Stripe event","type":"main","index":0}]]},"Setup: add default instructions":{"main":[[{"node":"Setup: done","type":"main","index":0}]]},"Create table: Sales Agent Config":{"main":[[{"node":"Create table: Sales Cart Items","type":"main","index":0}]]},"Setup: add the first admin login":{"main":[[{"node":"Setup: look for assistant instructions","type":"main","index":0}]]},"Create table: Shop Admin Sessions":{"main":[[{"node":"Create table: Shop Settings","type":"main","index":0}]]},"Create table: Sales Customer State":{"main":[[{"node":"Create table: Sales Customers","type":"main","index":0}]]},"Setup: create product search table":{"main":[[{"node":"Setup: look for an admin login","type":"main","index":0}]]},"Create table: Sales Checkout Sessions":{"main":[[{"node":"Create table: Sales Customer State","type":"main","index":0}]]},"Create table: Sales Processed Messages":{"main":[[{"node":"Create table: Sales Products","type":"main","index":0}]]},"Setup: look for assistant instructions":{"main":[[{"node":"Setup: no instructions yet?","type":"main","index":0}]]},"Run once: create tables and first login":{"main":[[{"node":"Create table: Sales Agent Config","type":"main","index":0}]]}},"description":"An AI sales agent for a clothing shop on Facebook Messenger with its own admin website, built in one workflow.\n\nCustomers: a Gemini agent answers from your products (exact lookup and search by meaning), manages the cart, sends a Stripe Pay Now button, escalates what it cannot answer, confirms payment, links every order line to its product and reduces stock.\n\nOwner: an admin website served by the same workflow with login, products and Google Drive photos, orders, customers, an inbox for escalated questions, a Problems page for errors, test chat, assistant instructions, and one-click Facebook and Stripe connection.\n\nData Tables (create these, column names are case-sensitive):\n- Sales Agent Config: configKey, active (boolean), systemPrompt, storeName, paymentSuccessUrl\n- Sales Cart Items: orderId, customerId, productName, size, color, quantity (number), unitPrice (number)\n- Sales Checkout Sessions: orderId, customerId, sessionId, checkoutUrl, amountCents (number), status\n- Sales Customer State: customerId, customerName, lastCustomerMessageAt (date), humanPausedUntil (date)\n- Sales Customers: customer_id, Name, Platform, Phone, Address, Email, Interests, Birthday, Notes\n- Sales Escalations: escalationId, customerId, customerName, question, customerMessage, status, adminAnswer, answeredAt (date), deliveredAt (date)\n- Sales Order Items: LineID, OrderID, Item_ID, Product_Name, Size, Color, Quantity (number), Unit_Price (number), Image\n- Sales Orders: OrderID, customer_id, Full_Name, Address, City, Landmark, Address_Confirmed (boolean), Phone, Status, Payment_Method, Total (number), Created_At, Paid_At, Tracking, Notes, Source\n- Sales Processed Messages: messageId, customerId, text, attachments, handled (boolean)\n- Sales Products: Item_ID, Name, Price (number), Stock_Status (number), Product_Image, Description, Sizes, Colors, Status\n- Shop Admin Login: username, passwordHash, salt, mustChange (boolean)\n- Shop Admin Sessions: token, expiresAt (number)\n- Shop Settings: settingKey, settingValue\n- Shop Errors: occurredAt, workflowName, failedNode, message, hint, executionId, executionUrl, status\n\nSetup: add your Gemini, Postgres and Google Drive credentials, then click Execute on \"Run once: create tables and first login\". It creates all tables above, the first admin login (admin / admin, you must change it at first sign-in) and default assistant instructions."}