{"id":"ZPq58z0327IQs4cW","meta":{"instanceId":"23dc49e0c0cc293f8dcb550bafb4a3e4b864b8d9b16760ed7e85b7d435519609"},"name":"Client Onboarding Automation System","tags":[],"nodes":[{"id":"90fe4f90-6510-41f8-a433-ec9f640be56b","name":"Client Onboarding Form","type":"n8n-nodes-base.formTrigger","position":[48,896],"webhookId":"a32f0d87-f1a4-47f1-bc83-0bfa1802cd16","parameters":{"options":{},"formTitle":"Client Onboarding","formFields":{"values":[{"fieldLabel":"Company Name","requiredField":true},{"fieldLabel":"Contact Name","requiredField":true},{"fieldType":"email","fieldLabel":"Email","requiredField":true},{"fieldLabel":"Phone"},{"fieldLabel":"Website"},{"fieldType":"dropdown","fieldLabel":"Service Required","fieldOptions":{"values":[{"option":"WhatsApp Automation"},{"option":"AI Voice Agent"},{"option":"CRM Automation"},{"option":"Lead Generation & Outreach"},{"option":"n8n Workflow Development"},{"option":"Other"}]},"requiredField":true},{"fieldLabel":"CRM"},{"fieldType":"textarea","fieldLabel":"Requirements"},{"fieldType":"date","fieldLabel":"Expected Launch Date"}]},"formDescription":"Tell us about your business and project so we can start your onboarding."},"typeVersion":2.2},{"id":"b3e5fbe3-6f77-4464-8a68-76e7a36872a8","name":"Clean Client Data","type":"n8n-nodes-base.set","notes":"Single place to change the agency name used in emails (agency_name).","position":[272,896],"parameters":{"options":{},"assignments":{"assignments":[{"id":"c2ef86e3-bf7d-4bd5-82fb-12b6665bcf25","name":"agency_name","type":"string","value":"Your Agency Name"},{"id":"0cb88431-1721-4eeb-b105-c8dde96f95b4","name":"company_name","type":"string","value":"={{ String($json['Company Name'] || '').trim() }}"},{"id":"90338412-0530-43a9-98e2-68ac6580db56","name":"contact_name","type":"string","value":"={{ String($json['Contact Name'] || '').trim() }}"},{"id":"2617f1b5-79dd-47a4-ae1e-d7da49a29315","name":"email","type":"string","value":"={{ String($json['Email'] || '').trim().toLowerCase() }}"},{"id":"fdcfb7ac-c2ae-44e8-92c4-02816f351f4e","name":"phone","type":"string","value":"={{ String($json['Phone'] || '').replace(/[^\\d+]/g, '') }}"},{"id":"d3a2a88c-4a4c-413b-ba5a-75c59af2e135","name":"website","type":"string","value":"={{ (() => { const w = String($json['Website'] || '').trim(); return w && !/^https?:\\/\\//i.test(w) ? 'https://' + w : w; })() }}"},{"id":"5f904201-db8d-4d34-94e3-4d2c47f5b10c","name":"service_required","type":"string","value":"={{ String($json['Service Required'] || '').trim() }}"},{"id":"9a6beea1-6b84-454a-a63e-ce756af601f0","name":"crm","type":"string","value":"={{ String($json['CRM'] || '').trim() }}"},{"id":"24efaa06-5e9b-4c09-9193-75999ec72643","name":"requirements","type":"string","value":"={{ String($json['Requirements'] || '').trim() }}"},{"id":"ed77bc2e-4f03-401f-b0a0-16629fe1e7f2","name":"expected_launch_date","type":"string","value":"={{ String($json['Expected Launch Date'] || '').trim() }}"},{"id":"04c8cc7b-dff3-4278-b0b3-6384c8c2c340","name":"submitted_at","type":"string","value":"={{ $now.toISO() }}"}]}},"typeVersion":3.4},{"id":"f5abab09-fee3-4bef-ac83-ad27cc6fb558","name":"AI - Analyze Client Requirements","type":"@n8n/n8n-nodes-langchain.agent","notes":"Anthropic agent. Output JSON string in $json.output.","onError":"continueRegularOutput","maxTries":3,"position":[496,896],"parameters":{"text":"={{ JSON.stringify({ today: $now.toISODate(), company_name: $('Clean Client Data').first().json.company_name, contact_name: $('Clean Client Data').first().json.contact_name, website: $('Clean Client Data').first().json.website, service_required: $('Clean Client Data').first().json.service_required, crm: $('Clean Client Data').first().json.crm, requirements: $('Clean Client Data').first().json.requirements, expected_launch_date: $('Clean Client Data').first().json.expected_launch_date }) }}","options":{"systemMessage":"You are an onboarding analyst for an AI automation agency. Analyze the new client's onboarding form and return ONLY a raw JSON object (no markdown, no code fences, no extra text) with exactly these keys: service (string: the primary service the client needs, normalized from the form and requirements); priority (one of: high, medium, low - high if the expected launch date is within 3 weeks of today or the client signals urgency, low if the launch is more than 3 months away or flexible, otherwise medium); crm (string: the CRM or system the client names, or 'Not specified'); requirements (string: a clear 1-3 sentence restatement using only what the client wrote); missing_information (array of short strings: specific details still needed to start, such as tools, channels, volumes or access; empty array if nothing material is missing); onboarding_summary (string: 2-3 sentence internal summary for the delivery team). Never invent facts that are not in the form."},"promptType":"define"},"retryOnFail":true,"typeVersion":1.7,"waitBetweenTries":2000},{"id":"4b7c2ca3-3acf-4c4b-8b65-3351c113cff5","name":"Check Required Information","type":"n8n-nodes-base.if","notes":"TRUE = continue onboarding. FALSE = client gets a request for the missing details (Send Onboarding Reminder).","position":[848,896],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"eb23893e-6117-4ea9-8dc9-3a75916f741e","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $('Clean Client Data').first().json.company_name }}","rightValue":""},{"id":"25b0c30f-7b98-4009-a580-3c8d24b09730","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $('Clean Client Data').first().json.contact_name }}","rightValue":""},{"id":"121b73a1-656b-446e-bed4-4bb98cef51cc","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $('Clean Client Data').first().json.email }}","rightValue":""},{"id":"0d5a5623-da32-4f5c-b9a6-15be11cdf3fb","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $('Clean Client Data').first().json.phone }}","rightValue":""},{"id":"b38b9e29-0c43-458c-84b1-0f8baf10a3a0","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $('Clean Client Data').first().json.requirements }}","rightValue":""}]}},"typeVersion":2},{"id":"fefa8ac2-9844-4b7d-86c0-fb71b2847fc7","name":"Create Client Record","type":"n8n-nodes-base.supabase","position":[1072,768],"parameters":{"tableId":"clients","fieldsUi":{"fieldValues":[{"fieldId":"company_name","fieldValue":"={{ $('Clean Client Data').first().json.company_name }}"},{"fieldId":"contact_name","fieldValue":"={{ $('Clean Client Data').first().json.contact_name }}"},{"fieldId":"email","fieldValue":"={{ $('Clean Client Data').first().json.email }}"},{"fieldId":"phone","fieldValue":"={{ $('Clean Client Data').first().json.phone }}"},{"fieldId":"website","fieldValue":"={{ $('Clean Client Data').first().json.website }}"},{"fieldId":"service_required","fieldValue":"={{ (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().service || $('Clean Client Data').first().json.service_required }}"},{"fieldId":"crm","fieldValue":"={{ (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().crm || $('Clean Client Data').first().json.crm }}"},{"fieldId":"requirements","fieldValue":"={{ $('Clean Client Data').first().json.requirements }}"},{"fieldId":"expected_launch_date","fieldValue":"={{ $('Clean Client Data').first().json.expected_launch_date }}"},{"fieldId":"priority","fieldValue":"={{ (['high', 'medium', 'low'].includes((() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().priority) ? (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().priority : 'medium') }}"},{"fieldId":"onboarding_summary","fieldValue":"={{ (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().onboarding_summary || '' }}"},{"fieldId":"missing_information","fieldValue":"={{ (Array.isArray((() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().missing_information) ? (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().missing_information : []).join('; ') }}"},{"fieldId":"status","fieldValue":"onboarding"},{"fieldId":"created_at","fieldValue":"={{ $now.toISO() }}"}]}},"credentials":{"supabaseApi":{"id":"QWPCwdKnHj13YIP8","name":"Supabase account"}},"typeVersion":1},{"id":"55df5781-c8d8-4fb8-b261-94a7b4415daf","name":"Create Onboarding Checklist","type":"n8n-nodes-base.supabase","notes":"One row per client with 6 task checkboxes. The team ticks them in Supabase (or your admin UI) as work is done.","position":[1296,768],"parameters":{"tableId":"onboarding_checklists","fieldsUi":{"fieldValues":[{"fieldId":"client_id","fieldValue":"={{ $('Create Client Record').first().json.id }}"},{"fieldId":"collect_business_requirements","fieldValue":"false"},{"fieldId":"collect_account_access","fieldValue":"false"},{"fieldId":"collect_crm_details","fieldValue":"false"},{"fieldId":"confirm_project_scope","fieldValue":"false"},{"fieldId":"schedule_kickoff_call","fieldValue":"false"},{"fieldId":"confirm_launch_date","fieldValue":"false"}]}},"credentials":{"supabaseApi":{"id":"QWPCwdKnHj13YIP8","name":"Supabase account"}},"typeVersion":1},{"id":"a69995d2-440c-42bf-933c-cc84c6fde350","name":"Create Client Folder","type":"n8n-nodes-base.googleDrive","notes":"Creates Clients / <Company Name>. Replace YOUR_CLIENTS_FOLDER_ID with the ID of your 'Clients' folder. A Drive failure does not block onboarding.","onError":"continueRegularOutput","maxTries":3,"position":[1520,768],"parameters":{"name":"={{ $('Clean Client Data').first().json.company_name }}","driveId":{"__rl":true,"mode":"list","value":"My Drive","cachedResultUrl":"https://drive.google.com/drive/my-drive","cachedResultName":"My Drive"},"options":{},"folderId":{"__rl":true,"mode":"list","value":"1E1Atjp0vveSBq5RJ_IZRHKgTQWI0yOcu","cachedResultUrl":"https://drive.google.com/drive/folders/1E1Atjp0vveSBq5RJ_IZRHKgTQWI0yOcu","cachedResultName":"Clients"},"resource":"folder"},"credentials":{"googleDriveOAuth2Api":{"id":"6lWhhz5fLhwYDW34","name":"Google Drive account"}},"retryOnFail":true,"typeVersion":3,"waitBetweenTries":2000},{"id":"4a7e8a6d-a8e7-4e90-be79-7bfe80e3af9c","name":"Generate Welcome Message","type":"@n8n/n8n-nodes-langchain.agent","notes":"Anthropic agent. Output JSON string in $json.output.","onError":"continueRegularOutput","maxTries":3,"position":[1744,768],"parameters":{"text":"={{ JSON.stringify({ agency_name: $('Clean Client Data').first().json.agency_name, contact_name: $('Clean Client Data').first().json.contact_name, company_name: $('Clean Client Data').first().json.company_name, service: ((() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().service || $('Clean Client Data').first().json.service_required), requirements: $('Clean Client Data').first().json.requirements, ai_summary: (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().onboarding_summary, expected_launch_date: $('Clean Client Data').first().json.expected_launch_date }) }}","options":{"systemMessage":"You write onboarding emails for an AI automation agency. Write a warm, professional welcome note of 80-120 words, personalized with the contact's first name, their company, the service they requested and one specific detail from their requirements. Do not invent prices, dates, commitments, features or team members. Do not include a greeting line, a signature, or a list of next steps (those are added separately). Plain text paragraphs only. Return ONLY a raw JSON object (no markdown, no code fences): {\"subject\": \"<email subject line>\", \"message\": \"<the welcome note>\"}"},"promptType":"define"},"retryOnFail":true,"typeVersion":1.7,"waitBetweenTries":2000},{"id":"a91a7982-9241-4a6b-8575-eecd1d500f24","name":"Send Welcome Email","type":"n8n-nodes-base.gmail","maxTries":3,"position":[2096,768],"webhookId":"d6d5bae1-32c4-4aa2-b590-c714b1cca729","parameters":{"sendTo":"={{ $('Clean Client Data').first().json.email }}","message":"={{ (() => {\nconst C = $('Clean Client Data').first().json;\nconst A = (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })();\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst TASKS = [['collect_business_requirements', 'Collect business requirements'], ['collect_account_access', 'Collect required account/API access'], ['collect_crm_details', 'Collect CRM details'], ['confirm_project_scope', 'Confirm project scope'], ['schedule_kickoff_call', 'Schedule kickoff call'], ['confirm_launch_date', 'Confirm launch date']];\nconst W = (() => { try { return JSON.parse(String($('Generate Welcome Message').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })();\nconst service = A.service || C.service_required;\nconst intro = String(W.message || ('Thank you for choosing ' + C.agency_name + '. We have received your details and are excited to get started on your ' + service + ' project.')).split(/\\n+/).filter(Boolean).map(p => '<p>' + esc(p) + '</p>').join('');\nconst steps = TASKS.map(t => '<li>' + esc(t[1]) + '</li>').join('');\nconst needed = (Array.isArray(A.missing_information) ? A.missing_information : []).concat(['Admin or API access to ' + (C.crm || 'your CRM and the tools we will connect')]).map(x => '<li>' + esc(x) + '</li>').join('');\nreturn '<div style=\"font-family:Arial,sans-serif;font-size:15px;line-height:1.6;color:#222;max-width:620px\">'\n  + '<p>Hi ' + esc(C.contact_name) + ',</p>' + intro\n  + '<h3 style=\"margin:22px 0 6px\">Your project</h3>'\n  + '<p><b>Company:</b> ' + esc(C.company_name) + '<br><b>Service:</b> ' + esc(service) + '<br><b>CRM:</b> ' + esc(A.crm || C.crm || 'To be confirmed') + '<br><b>Target launch date:</b> ' + esc(C.expected_launch_date || 'To be confirmed on our kickoff call') + '</p>'\n  + '<h3 style=\"margin:22px 0 6px\">Next steps</h3><ol>' + steps + '</ol>'\n  + '<h3 style=\"margin:22px 0 6px\">What we need from you</h3><ul>' + needed + '</ul>'\n  + '<p>Simply reply to this email with the details or access and we will take it from there.</p>'\n  + '<p>Best regards,<br>The ' + esc(C.agency_name) + ' Team</p></div>';\n})() }}","options":{"appendAttribution":false},"subject":"={{ (() => { const W = (() => { try { return JSON.parse(String($('Generate Welcome Message').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })(); return W.subject || ('Welcome to ' + $('Clean Client Data').first().json.agency_name + ', ' + $('Clean Client Data').first().json.contact_name + '!'); })() }}"},"credentials":{"gmailOAuth2":{"id":"WUxmgAZUpOZXZBla","name":"Gmail account"}},"retryOnFail":true,"typeVersion":2.1,"waitBetweenTries":3000},{"id":"a18bfd4d-9b16-43ca-928c-42a38c4883ee","name":"Notify Internal Team","type":"n8n-nodes-base.slack","notes":"Change the channel name and invite the Slack app to it.","position":[2320,768],"webhookId":"4efe0635-bccb-4983-b2d4-ddf666ee783f","parameters":{"text":"={{ (() => {\nconst C = $('Clean Client Data').first().json;\nconst A = (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })();\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst TASKS = [['collect_business_requirements', 'Collect business requirements'], ['collect_account_access', 'Collect required account/API access'], ['collect_crm_details', 'Collect CRM details'], ['confirm_project_scope', 'Confirm project scope'], ['schedule_kickoff_call', 'Schedule kickoff call'], ['confirm_launch_date', 'Confirm launch date']];\nconst folder = $('Create Client Folder').first().json;\nconst link = folder.id ? 'https://drive.google.com/drive/folders/' + folder.id : 'Folder creation failed - please create it manually';\nconst missing = Array.isArray(A.missing_information) && A.missing_information.length ? A.missing_information.join('; ') : 'None flagged';\nconst priority = ['high', 'medium', 'low'].includes(A.priority) ? A.priority : 'medium';\nreturn [\n  '🎉 *New Client Onboarding Started*', '',\n  '*Client:* ' + C.contact_name,\n  '*Company:* ' + C.company_name,\n  '*Service:* ' + (A.service || C.service_required),\n  '*Priority:* ' + priority,\n  '*CRM:* ' + (A.crm || C.crm || 'Not specified'),\n  '*Requirements:* ' + String(C.requirements).slice(0, 600),\n  '*Onboarding status:* onboarding_started',\n  '*Client folder:* ' + link,\n  '*AI summary:* ' + (A.onboarding_summary || 'n/a'),\n  '*Missing info flagged:* ' + missing\n].join('\\n');\n})() }}","select":"channel","channelId":{"__rl":true,"mode":"name","value":"client-onboarding"},"otherOptions":{},"authentication":"oAuth2"},"credentials":{"slackOAuth2Api":{"id":"BcoDhFNdJAeESGlN","name":"Slack account"}},"typeVersion":2.3},{"id":"c59d32d0-0ac9-4ac0-9863-7867ed602268","name":"Update Client Status","type":"n8n-nodes-base.supabase","position":[2544,768],"parameters":{"filters":{"conditions":[{"keyName":"id","keyValue":"={{ $('Create Client Record').first().json.id }}","condition":"eq"}]},"tableId":"clients","fieldsUi":{"fieldValues":[{"fieldId":"status","fieldValue":"onboarding_started"},{"fieldId":"onboarding_started_at","fieldValue":"={{ $now.toISO() }}"},{"fieldId":"drive_folder_url","fieldValue":"={{ $('Create Client Folder').first().json.id ? 'https://drive.google.com/drive/folders/' + $('Create Client Folder').first().json.id : '' }}"}]},"matchType":"allFilters","operation":"update"},"credentials":{"supabaseApi":{"id":"QWPCwdKnHj13YIP8","name":"Supabase account"}},"typeVersion":1},{"id":"2cf1b31c-116d-4500-b00a-0300b1156bb5","name":"Wait for Client Completion","type":"n8n-nodes-base.wait","notes":"Pauses for 2 days. Change amount/unit as needed. Execution data must be saved for Wait to resume.","position":[2768,768],"webhookId":"f67c069f-5ef2-49a6-9146-169135fe3858","parameters":{"unit":"days","amount":1},"typeVersion":1.1},{"id":"050d0660-d344-4eff-b173-883ef5f04124","name":"Check Onboarding Status","type":"n8n-nodes-base.supabase","position":[2992,768],"parameters":{"limit":1,"filters":{"conditions":[{"keyName":"client_id","keyValue":"={{ $('Create Client Record').first().json.id }}","condition":"eq"}]},"tableId":"onboarding_checklists","matchType":"allFilters","operation":"getAll"},"credentials":{"supabaseApi":{"id":"QWPCwdKnHj13YIP8","name":"Supabase account"}},"typeVersion":1,"alwaysOutputData":true},{"id":"efad1d4c-f704-4d1a-9809-40d5ba024fc2","name":"Is Onboarding Complete?","type":"n8n-nodes-base.if","notes":"TRUE only when all 6 checklist tasks are true.","position":[3216,768],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"1f0b5353-aaa2-487e-8155-6913715e7bad","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ ['collect_business_requirements', 'collect_account_access', 'collect_crm_details', 'confirm_project_scope', 'schedule_kickoff_call', 'confirm_launch_date'].every(k => $json[k] === true) }}","rightValue":""}]}},"typeVersion":2},{"id":"fba9ec62-d70c-4153-8f9c-6781ede3e724","name":"Send Onboarding Reminder","type":"n8n-nodes-base.gmail","notes":"Used twice: (1) missing-information request when the form is incomplete, (2) pending-task reminder after the wait.","maxTries":3,"position":[3456,944],"webhookId":"680460fe-6b41-45ac-93ff-0d1945444cee","parameters":{"sendTo":"={{ $('Clean Client Data').first().json.email }}","message":"={{ (() => {\nconst C = $('Clean Client Data').first().json;\nconst A = (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })();\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst TASKS = [['collect_business_requirements', 'Collect business requirements'], ['collect_account_access', 'Collect required account/API access'], ['collect_crm_details', 'Collect CRM details'], ['confirm_project_scope', 'Confirm project scope'], ['schedule_kickoff_call', 'Schedule kickoff call'], ['confirm_launch_date', 'Confirm launch date']];\nconst isFollowUp = $('Check Onboarding Status').isExecuted;\nconst service = A.service || C.service_required;\nlet items;\nif (isFollowUp) {\n  const row = $('Check Onboarding Status').first().json;\n  items = TASKS.filter(t => row[t[0]] !== true).map(t => t[1]);\n} else {\n  const labels = { company_name: 'Company name', contact_name: 'Contact name', email: 'Email address', phone: 'Phone number', requirements: 'Project requirements' };\n  items = Object.keys(labels).filter(k => !C[k]).map(k => labels[k]).concat(Array.isArray(A.missing_information) ? A.missing_information : []);\n}\nconst intro = isFollowUp\n  ? 'Just a friendly reminder that we are waiting on a few items to complete the onboarding for ' + esc(C.company_name) + '. Here is what is still pending:'\n  : 'Thank you for submitting your onboarding form. To get your ' + esc(service) + ' project started, we need a few more details:';\nreturn '<div style=\"font-family:Arial,sans-serif;font-size:15px;line-height:1.6;color:#222;max-width:620px\">'\n  + '<p>Hi ' + esc(C.contact_name) + ',</p><p>' + intro + '</p>'\n  + '<ul>' + items.map(x => '<li>' + esc(x) + '</li>').join('') + '</ul>'\n  + '<p>Just reply to this email with the details, or let us know if you would like to book a quick call to go through them together.</p>'\n  + '<p>Best regards,<br>The ' + esc(C.agency_name) + ' Team</p></div>';\n})() }}","options":{"appendAttribution":false},"subject":"={{ $('Check Onboarding Status').isExecuted ? 'Reminder: a few items pending for your ' + $('Clean Client Data').first().json.company_name + ' onboarding' : 'Action needed: more details required to start your onboarding' }}"},"credentials":{"gmailOAuth2":{"id":"WUxmgAZUpOZXZBla","name":"Gmail account"}},"retryOnFail":true,"typeVersion":2.1,"waitBetweenTries":3000},{"id":"afc7cf1c-c80c-47d3-9f75-de0f515d9355","name":"Complete Onboarding","type":"n8n-nodes-base.supabase","position":[3456,656],"parameters":{"filters":{"conditions":[{"keyName":"id","keyValue":"={{ $('Create Client Record').first().json.id }}","condition":"eq"}]},"tableId":"clients","fieldsUi":{"fieldValues":[{"fieldId":"status","fieldValue":"completed"},{"fieldId":"completed_at","fieldValue":"={{ $now.toISO() }}"}]},"matchType":"allFilters","operation":"update"},"credentials":{"supabaseApi":{"id":"QWPCwdKnHj13YIP8","name":"Supabase account"}},"typeVersion":1},{"id":"6f06ff8b-a41e-461e-abbd-fff1c548170b","name":"Notify Team - Onboarding Complete","type":"n8n-nodes-base.slack","position":[3664,720],"webhookId":"dd905415-829a-437d-8bbc-6838afa4c369","parameters":{"text":"=✅ *Client Onboarding Completed*\n\n*Company:* {{ $('Clean Client Data').first().json.company_name }}\n*Contact:* {{ $('Clean Client Data').first().json.contact_name }}\n*Service:* {{ (() => { try { return JSON.parse(String($('AI - Analyze Client Requirements').first().json.output || '').replace(/```json|```/g, '').trim()); } catch (e) { return {}; } })().service || $('Clean Client Data').first().json.service_required }}\n*Status:* completed\n\nAll onboarding tasks are done - ready to start the build.","select":"channel","channelId":{"__rl":true,"mode":"name","value":"client-onboarding"},"otherOptions":{},"authentication":"oAuth2"},"credentials":{"slackOAuth2Api":{"id":"BcoDhFNdJAeESGlN","name":"Slack account"}},"typeVersion":2.3},{"id":"871818a3-df52-45e0-ab57-f03b70e80fc0","name":"Anthropic Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","position":[560,1120],"parameters":{"model":{"__rl":true,"mode":"id","value":"claude-haiku-4-5-20251001"},"options":{"temperature":0.3}},"credentials":{"anthropicApi":{"id":null,"name":"","__aiGatewayManaged":true}},"typeVersion":1.3},{"id":"e21d88de-5574-4cad-9eda-3a6b05a7f7b2","name":"Anthropic Chat Model1","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","position":[1808,1008],"parameters":{"model":{"__rl":true,"mode":"id","value":"claude-haiku-4-5-20251001"},"options":{"temperature":0.3}},"credentials":{"anthropicApi":{"id":null,"name":"","__aiGatewayManaged":true}},"typeVersion":1.3},{"id":"fa7e7997-e0c8-4f59-a520-a23ac1f6d519","name":"Sticky - sticky-sec1","type":"n8n-nodes-base.stickyNote","position":[0,784],"parameters":{"color":7,"width":950,"height":498,"content":"**1. Intake & Analyze**\nCollects the client's details via form, cleans the data, and uses AI to extract service type, priority, CRM, and anything still missing. Incomplete forms are routed straight to a reminder email instead of continuing."},"typeVersion":1},{"id":"91e9be1b-480e-4d5e-bb00-4aa55e84473f","name":"Sticky - sticky-sec2","type":"n8n-nodes-base.stickyNote","position":[1024,672],"parameters":{"color":7,"width":1622,"height":530,"content":"**2. Create Records & Welcome**\nCreates the client and checklist records in Supabase, makes their Drive folder, AI drafts a personalized welcome email, sends it, notifies the team on Slack, and marks the client as onboarding-started."},"typeVersion":1},{"id":"58a8a2d6-99af-4968-a2f5-7bd71ce5fa37","name":"Sticky - sticky-sec3","type":"n8n-nodes-base.stickyNote","position":[2720,656],"parameters":{"color":7,"width":646,"height":322,"content":"**3. Wait & Check Progress**\nPauses (default 1 days), then checks the Supabase checklist to see if all 6 onboarding tasks are marked done."},"typeVersion":1},{"id":"9e53e34f-ba23-4f34-bcb4-125e2524f253","name":"Sticky - sticky-sec4","type":"n8n-nodes-base.stickyNote","position":[3392,544],"parameters":{"color":7,"width":464,"height":594,"content":"**4. Complete or Remind**\nIf every task is done, marks the client complete and notifies the team. If not, sends the client a reminder listing exactly what's still pending."},"typeVersion":1},{"id":"b83de0b0-c4d0-49e8-b01f-b3a4fa8d1fa2","name":"Sticky - sticky-main","type":"n8n-nodes-base.stickyNote","position":[-704,672],"parameters":{"color":"#F5D04D","width":668,"height":656,"content":"## **Client Onboarding Automation System**\n\n**Who it's for:** Agencies or service businesses that want new clients onboarded consistently — without someone manually creating folders, sending welcome emails, and chasing missing details.\n\n**What it does:** Takes a new client through an intake form, uses AI to analyze their requirements, sets up their records and folder, sends a personalized welcome email, and follows up automatically until every onboarding task is complete.\n\n**How it works**\n1. Client fills out the onboarding form\n2. AI analyzes their requirements and flags anything missing\n3. Incomplete submissions get an email requesting the missing details\n4. Complete ones get a client record, a 6-item checklist, and a Drive folder\n5. AI drafts and sends a personalized welcome email; the team is notified on Slack\n6. After a wait period, the workflow checks whether all checklist tasks are done\n7. If yes, the client is marked complete and the team is notified\n8. If not, the client gets a reminder listing exactly what's still pending\n\n**How to set up**\n☐ Connect Supabase and create `clients` and `onboarding_checklists` tables\n☐ Connect Google Drive and select your own \"Clients\" parent folder\n☐ Connect Gmail\n☐ Connect Slack and set your own channel (default: `client-onboarding`)\n☐ Connect Anthropic (used for requirement analysis and the welcome email)\n☐ Set your own agency name in \"Clean Client Data\" (one field, used everywhere)\n\n**CUSTOMIZATION**\n- Add/remove onboarding checklist tasks\n- Change the wait duration before the completion check\n- Edit the AI prompts for tone or add your own required fields"},"typeVersion":1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"ef183893-5388-414b-9d14-228bc1cd83c6","nodeGroups":[],"connections":{"Clean Client Data":{"main":[[{"node":"AI - Analyze Client Requirements","type":"main","index":0}]]},"Send Welcome Email":{"main":[[{"node":"Notify Internal Team","type":"main","index":0}]]},"Complete Onboarding":{"main":[[{"node":"Notify Team - Onboarding Complete","type":"main","index":0}]]},"Anthropic Chat Model":{"ai_languageModel":[[{"node":"AI - Analyze Client Requirements","type":"ai_languageModel","index":0}]]},"Create Client Folder":{"main":[[{"node":"Generate Welcome Message","type":"main","index":0}]]},"Create Client Record":{"main":[[{"node":"Create Onboarding Checklist","type":"main","index":0}]]},"Notify Internal Team":{"main":[[{"node":"Update Client Status","type":"main","index":0}]]},"Update Client Status":{"main":[[{"node":"Wait for Client Completion","type":"main","index":0}]]},"Anthropic Chat Model1":{"ai_languageModel":[[{"node":"Generate Welcome Message","type":"ai_languageModel","index":0}]]},"Client Onboarding Form":{"main":[[{"node":"Clean Client Data","type":"main","index":0}]]},"Check Onboarding Status":{"main":[[{"node":"Is Onboarding Complete?","type":"main","index":0}]]},"Is Onboarding Complete?":{"main":[[{"node":"Complete Onboarding","type":"main","index":0}],[{"node":"Send Onboarding Reminder","type":"main","index":0}]]},"Generate Welcome Message":{"main":[[{"node":"Send Welcome Email","type":"main","index":0}]]},"Check Required Information":{"main":[[{"node":"Create Client Record","type":"main","index":0}],[{"node":"Send Onboarding Reminder","type":"main","index":0}]]},"Wait for Client Completion":{"main":[[{"node":"Check Onboarding Status","type":"main","index":0}]]},"Create Onboarding Checklist":{"main":[[{"node":"Create Client Folder","type":"main","index":0}]]},"AI - Analyze Client Requirements":{"main":[[{"node":"Check Required Information","type":"main","index":0}]]}}}