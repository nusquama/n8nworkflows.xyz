"Compute Month Stats","type":"n8n-nodes-base.code","position":[464,800],"parameters":{"jsCode":"const plans = (($input.all() || []).map(r => r.json || {})).filter(p => p && p.plan_id);\nconst now = new Date();\nconst msDay = 86400000;\nconst active = plans.filter(p => {\n  const s = String(p.status || '').trim().toUpperCase();\n  return s !== 'COMPLETE' && s !== 'CANCELLED';\n});\nconst withDays = active.map(p => {\n  const due = new Date(String(p.next_due_date || ''));\n  const days = (!isNaN(due.getTime())) ? Math.floor((due.getTime() - now.getTime()) / msDay) : null;\n  return Object.assign({}, p, { days_until: days });\n});\nconst overdue = withDays.filter(p => p.days_until !== null && p.days_until < 0);\nconst dueSoon = withDays.filter(p => p.days_until !== null && p.days_until >= 0 && p.days_until <= 3);\nconst totalBalance = withDays.reduce((s, p) => s + (parseFloat(p.balance_due) || 0), 0);\nconst overdueValue = overdue.reduce((s, p) => s + (parseFloat(p.balance_due) || 0), 0);\nconst topList = overdue.slice().sort((a, b) => (parseFloat(b.balance_due) || 0) - (parseFloat(a.balance_due) || 0)).slice(0, 8)\n  .map(p => ({ customer: p.customer_name, item: p.item, balance: p.balance_due, due: p.next_due_date }));\nconst stats = {\n  as_of: new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Pontianak', year: 'numeric', month: '2-digit', day: '2-digit' }).format(now),\n  active_count: active.length,\n  total_balance: Math.round(totalBalance * 100) / 100,\n  overdue_count: overdue.length,\n  overdue_value: Math.round(overdueValue * 100) / 100,\n  due_soon_count: dueSoon.length,\n  top_overdue: topList\n};\nreturn [{ json: { stats_json: JSON.stringify(stats) } }];"},"typeVersion":2},{"id":"aa0261bc-9e14-4428-b6fc-60246a878baa","name":"AI Write Review","type":"@n8n/n8n-nodes-langchain.agent","position":[688,800],"parameters":{"text":"={{ \"Monthly layaway review data: \" + $json.stats_json }}","options":{"systemMessage":"You are the assistant to the owner of a small retail store. Write a short plain text email body (no markdown, no code fences, no subject line, under 180 words) about the monthly layaway plan review. Use the JSON stats: as_of, active_count, total_balance, overdue_count, overdue_value, due_soon_count, top_overdue. Say how many plans are active and the total balance still owed. Name the overdue customers from top_overdue with their item and balance, and tell the owner to call each of them this week. If there are no overdue plans, say the book is clean and only remind about any payments due soon. Keep it practical and human. Do not use placeholder names or square brackets."},"promptType":"define"},"typeVersion":3.1},{"id":"d2788d46-24b6-49a9-b195-0a069d9b524b","name":"Email Monthly Review","type":"n8n-nodes-base.gmail","position":[1024,800],"webhookId":"8d770767-ba6c-45be-a6cb-c49325f54987","parameters":{"sendTo":"={{ $json.office_email || \"user@example.com\" }}","message":"={{ $json.output }}","options":{},"subject":"Monthly layaway plan review","emailType":"text"},"credentials":{"gmailOAuth2":{"id":"tzaBsDIL2rKaZdlq","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"10fcf359-84bb-44f0-833c-1bbc94f14203","name":"Monthly Review Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[688,928],"parameters":{"model":{"__rl":true,"mode":"list","value":"gpt-6-luna","cachedResultName":"gpt-6-luna"},"options":{},"builtInTools":{}},"credentials":{"openAiApi":{"id":"JpMsLwC6dr7iGBJZ","name":"jonathan"}},"typeVersion":1.3},{"id":"fbe9e4f2-2373-49a6-b20d-bbcfa993888e","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-880,-560],"parameters":{"width":480,"height":832,"content":"## track layaway plans and payment reminders for retail\n\n### How it works\n\n1. A staff member creates a layaway plan through a webhook (or the store POS posts to the URL). The workflow checks that the customer and item are filled in, then logs the plan to the Plans tab and emails the customer their payment schedule.\n\n2. Every morning the workflow reads all active plans, finds payments due within the next 3 days and payments that are overdue, sends a reminder email to the customer, and escalates overdue plans to the store email address.\n\n3. On the first of each month an AI assistant reads the plans, calculates how much money is still owed and how many plans are overdue, and emails the store a plain language review.\n\n### Setup steps\n\n- Create a Google Sheet with a Plans tab and an Alerts tab using the columns listed in the workflow nodes.\n- Add Google Sheets, Gmail and OpenAI credentials to the nodes.\n- Point your POS or a form at the webhook URL and set the store email address.\n\n### Customization\n\n- Change the reminder window (default 3 days), the installment interval, or the email wording in the pack nodes.\n- Add a payment link to the reminder emails."},"typeVersion":1},{"id":"e06f0759-c44a-451a-95ab-341b0ce411e5","name":"1. New layaway plans","type":"n8n-nodes-base.stickyNote","position":[-16,-592],"parameters":{"color":7,"width":1212,"height":476,"content":"## 1. New layaway plans\n\nA webhook creates the plan, validates it, logs it to the Plans tab and emails the customer the schedule. Rejected plans alert the store."},"typeVersion":1},{"id":"15dd39df-1480-49cd-b3a4-826b4357e9c4","name":"2. Daily payment sweeps","type":"n8n-nodes-base.stickyNote","position":[-48,80],"parameters":{"color":7,"width":2300,"height":548,"content":"## 2. Daily payment sweeps\n\nEvery morning the workflow finds payments due soon or overdue, emails the customer and escalates overdue plans to the store."},"typeVersion":1},{"id":"86135b54-bbd8-4fe1-a463-e72e3bf1dafb","name":"3. Monthly plan review","type":"n8n-nodes-base.stickyNote","position":[-128,656],"parameters":{"color":7,"width":1356,"height":442,"content":"## 3. Monthly plan review\n\nOn the first of the month, an AI assistant writes a plain language review of active balances and overdue plans for the store."},"typeVersion":1}],