{"name":"Verify a subcontractor's licence when they submit your onboarding form","nodes":[{"id":"c3000000-0000-4000-8000-000000000001","name":"Subcontractor submits the form","type":"n8n-nodes-base.formTrigger","position":[-760,0],"webhookId":"c3000000-0000-4000-8000-0000000000ff","parameters":{"formTitle":"Subcontractor onboarding","formFields":{"values":[{"fieldLabel":"Company","requiredField":true},{"fieldLabel":"Contact name","requiredField":true},{"fieldType":"email","fieldLabel":"Email","requiredField":true},{"fieldLabel":"State","placeholder":"2-letter code, e.g. CA","requiredField":true},{"fieldLabel":"License number","requiredField":true}]},"responseMode":"lastNode","formDescription":"Your licence is verified against the state board before this is reviewed."},"typeVersion":2.2},{"id":"c3000000-0000-4000-8000-000000000002","name":"Validate the submission","type":"n8n-nodes-base.code","position":[-520,0],"parameters":{"jsCode":"// One submission in. Normalise it before anything else touches it.\n//\n// The gate fails CLOSED: everything below that isn't a clean, checkable submission ends as\n// `manual-review`, never as a pass.\nconst f = $input.first().json;\n\nconst pick = (...names) => {\n  for (const n of names) {\n    for (const k of Object.keys(f)) {\n      if (k.toLowerCase().replace(/[^a-z]/g, '') === n) return String(f[k] ?? '').trim();\n    }\n  }\n  return '';\n};\n\nconst company = pick('company', 'companyname', 'businessname');\nconst contact = pick('contactname', 'name', 'contact');\nconst email   = pick('email', 'emailaddress');\nconst claimed = pick('licensenumber', 'licencenumber', 'license', 'licence');\nlet state     = pick('state').toUpperCase().replace(/[^A-Z]/g, '');\n\n// Accept a full state name as well as a code - people type \"California\" into a text box.\n// All 50, not just the covered ones: truncating an unknown name to its first two letters turned\n// \"North Dakota\" into \"NO\", which is a confusing thing to put in front of a person.\nconst NAMES = { ALABAMA:'AL', ALASKA:'AK', ARIZONA:'AZ', ARKANSAS:'AR', CALIFORNIA:'CA',\n  COLORADO:'CO', CONNECTICUT:'CT', DELAWARE:'DE', FLORIDA:'FL', GEORGIA:'GA', HAWAII:'HI',\n  IDAHO:'ID', ILLINOIS:'IL', INDIANA:'IN', IOWA:'IA', KANSAS:'KS', KENTUCKY:'KY', LOUISIANA:'LA',\n  MAINE:'ME', MARYLAND:'MD', MASSACHUSETTS:'MA', MICHIGAN:'MI', MINNESOTA:'MN', MISSISSIPPI:'MS',\n  MISSOURI:'MO', MONTANA:'MT', NEBRASKA:'NE', NEVADA:'NV', NEWHAMPSHIRE:'NH', NEWJERSEY:'NJ',\n  NEWMEXICO:'NM', NEWYORK:'NY', NORTHCAROLINA:'NC', NORTHDAKOTA:'ND', OHIO:'OH', OKLAHOMA:'OK',\n  OREGON:'OR', PENNSYLVANIA:'PA', RHODEISLAND:'RI', SOUTHCAROLINA:'SC', SOUTHDAKOTA:'SD',\n  TENNESSEE:'TN', TEXAS:'TX', UTAH:'UT', VERMONT:'VT', VIRGINIA:'VA', WASHINGTON:'WA',\n  WESTVIRGINIA:'WV', WISCONSIN:'WI', WYOMING:'WY', DISTRICTOFCOLUMBIA:'DC' };\nconst raw = state;\nif (state.length > 2) state = NAMES[state] || '';\n\nconst missing = [];\nif (!state) missing.push(raw ? `state (could not read \"${raw}\")` : 'state');\nif (!company) missing.push('company');\nif (!claimed) missing.push('license_number');\n\nreturn [{ json: { company, contact, email, claimed_license: claimed, state,\n                  submitted_at: new Date().toISOString(),\n                  valid: missing.length === 0,\n                  missing: missing.join(', ') } }];"},"typeVersion":2},{"id":"c3000000-0000-4000-8000-000000000003","name":"Route by state","type":"n8n-nodes-base.code","position":[-280,0],"parameters":{"jsCode":"// state -> { actor, field }\n// `field` matters: these actors do NOT share one input name.\nconst ACTORS = {\n  AL: { actor: 'scrapebench~alabama-contractor-license-lookup',        field: 'query' },\n  AR: { actor: 'scrapebench~arkansas-contractor-license-lookup',       field: 'query' },\n  CA: { actor: 'scrapebench~california-contractor-license-lookup',     field: 'query' },\n  CT: { actor: 'scrapebench~multistate-contractor-license-lookup',     field: 'query', extra: { states: ['CT'] } },\n  FL: { actor: 'scrapebench~florida-contractor-license-lookup',        field: 'query' },\n  MA: { actor: 'scrapebench~massachusetts-construction-license-lookup', field: 'query' },\n  MI: { actor: 'scrapebench~michigan-contractor-license-lookup',       field: 'query' },\n  MN: { actor: 'scrapebench~minnesota-contractor-license-lookup',      field: 'query' },\n  NC: { actor: 'scrapebench~north-carolina-contractor-license-lookup', field: 'query' },\n  NM: { actor: 'scrapebench~new-mexico-contractor-license-lookup',     field: 'businessName' },\n  NV: { actor: 'scrapebench~nevada-contractor-license-lookup',         field: 'query' },\n  OR: { actor: 'scrapebench~oregon-contractor-license-lookup',         field: 'query' },\n  SC: { actor: 'scrapebench~south-carolina-contractor-license-lookup', field: 'lastName' },\n  TN: { actor: 'scrapebench~tennessee-contractor-license-lookup',      field: 'query' },\n  TX: { actor: 'scrapebench~texas-contractor-license-lookup',          field: 'query' },\n  VA: { actor: 'scrapebench~virginia-contractor-license-lookup',       field: 'nameFilter' },\n  WA: { actor: 'scrapebench~washington-contractor-license-lookup',     field: 'query' },\n};\n\nreturn $input.all().map((item) => {\n  const s = item.json;\n\n  if (!s.valid) {\n    return { json: { ...s, covered: false,\n                     verdict: 'manual-review',\n                     reason: `Incomplete submission - missing: ${s.missing}` } };\n  }\n\n  const cfg = ACTORS[s.state];\n  if (!cfg) {\n    // Not covered. We did not check, so we do not pass - a human does.\n    return { json: { ...s, covered: false,\n                     verdict: 'manual-review',\n                     reason: `${s.state} is not one of the covered states - check this one by hand` } };\n  }\n\n  // Onboarding always has a claimed number, so every lookup here is exact.\n  const input = { [cfg.field]: s.claimed_license, maxResults: 5, includeDetails: true,\n                  ...(cfg.extra || {}) };\n  return { json: { ...s, covered: true, actorId: cfg.actor, actorInput: JSON.stringify(input) } };\n});"},"typeVersion":2},{"id":"c3000000-0000-4000-8000-000000000004","name":"Can we check it?","type":"n8n-nodes-base.if","position":[-40,0],"parameters":{"options":{},"conditions":{"options":{"version":2,"caseSensitive":true},"combinator":"and","conditions":[{"id":"c1","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.covered }}","rightValue":""}]}},"typeVersion":2},{"id":"c3000000-0000-4000-8000-000000000005","name":"Look up the licence","type":"@apify/n8n-nodes-apify.apify","onError":"continueRegularOutput","position":[200,-120],"parameters":{"actorId":{"__rl":true,"mode":"id","value":"={{ $json.actorId }}"},"resource":"Actors","operation":"Run actor and get dataset","customBody":"={{ $json.actorInput }}"},"typeVersion":1,"alwaysOutputData":true},{"id":"c3000000-0000-4000-8000-000000000006","name":"Send it to a human","type":"n8n-nodes-base.set","position":[200,160],"parameters":{"options":{},"assignments":{"assignments":[{"id":"m1","name":"summary","type":"string","value":"=Needs a human: {{ $json.reason }}"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"c3000000-0000-4000-8000-000000000007","name":"Decide the verdict","type":"n8n-nodes-base.code","position":[440,-120],"parameters":{"jsCode":"// Compare what they CLAIMED against what the state board actually holds.\n//\n// Four verdicts. Only one of them is a pass, and everything unexpected lands in manual-review.\nconst norm = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');\n\nconst sub = $('Validate the submission').first().json;\nconst returned = $input.all().map((i) => i.json);\nconst failure = returned.find((r) => r.error);\nconst rows = returned.filter((r) => !r.error && (r.license_number || r.status));\n\nconst base = {\n  company: sub.company, contact: sub.contact, email: sub.email,\n  state: sub.state, claimed_license: sub.claimed_license, checked_at: new Date().toISOString(),\n};\n\nlet out;\nif (failure) {\n  // The lookup broke. We know nothing, so we do NOT pass. This is the fail-closed rule.\n  out = { ...base, verdict: 'manual-review',\n          reason: 'The licence check could not be completed, so nothing was verified',\n          detail: String(failure.error) };\n} else if (!rows.length) {\n  out = { ...base, verdict: 'fail',\n          reason: `No record at the ${sub.state} board under licence ${sub.claimed_license}` };\n} else {\n  const hit = rows[0];\n  const st = String(hit.status || '').toLowerCase();\n  // Order matters: \"This license is inactive\" contains the substring \"active\".\n  const bad = /(inactive|expired|suspend|revoked|cancel|void|delinquent|lapsed)/.test(st);\n  const active = !bad && /(active|current|valid|good standing)/.test(st);\n\n  const found = hit.business_name || hit.company_name || hit.person_name || '';\n  const a = norm(sub.company), b = norm(found);\n  const nameMatches = !!(a && b && (a === b || b.includes(a) || a.includes(b)));\n\n  const evidence = {\n    found_name: found || null, found_status: hit.status ?? null,\n    found_expiry: hit.expiration_date ?? null, source_url: hit.source_url ?? null,\n  };\n\n  if (!active) {\n    out = { ...base, ...evidence, verdict: 'fail',\n            reason: `Licence ${sub.claimed_license} is not active: ${hit.status}` };\n  } else if (!nameMatches) {\n    // A live licence under a different name is the borrowed-number pattern. Never an auto-pass.\n    out = { ...base, ...evidence, verdict: 'review',\n            reason: `Licence is active but held by \"${found}\", not \"${sub.company}\"` };\n  } else {\n    out = { ...base, ...evidence, verdict: 'pass',\n            reason: `Active licence confirmed for ${found}` };\n  }\n}\n\nconst SUMMARY = { pass: 'Verified', review: 'Needs a human', fail: 'Rejected',\n                  'manual-review': 'Needs a human' };\nout.summary = `${SUMMARY[out.verdict]}: ${out.reason}`;\nreturn [{ json: out }];"},"typeVersion":2},{"id":"c3000000-0000-4000-8000-000000000008","name":"Write the audit row","type":"n8n-nodes-base.code","position":[680,0],"parameters":{"jsCode":"// The audit row. This is half the point of the template: a record of WHEN a licence was checked\n// and WHAT the board said at that moment, not just the decision.\n//\n// Swap this node for Google Sheets -> Append row, Airtable, or an INSERT. It ships as a Set node\n// so the template runs on import without a credential.\nreturn $input.all().map((i) => ({ json: {\n  checked_at: i.json.checked_at,\n  company: i.json.company,\n  contact: i.json.contact,\n  email: i.json.email,\n  state: i.json.state,\n  claimed_license: i.json.claimed_license,\n  found_name: i.json.found_name ?? null,\n  found_status: i.json.found_status ?? null,\n  found_expiry: i.json.found_expiry ?? null,\n  verdict: i.json.verdict,\n  reason: i.json.reason,\n  summary: i.json.summary,\n  source_url: i.json.source_url ?? null,\n} }));"},"typeVersion":2},{"id":"c3000000-0000-4000-8000-000000000009","name":"Post the verdict to Slack","type":"n8n-nodes-base.slack","notes":"Disabled so the template runs on import without a Slack credential.","disabled":true,"position":[920,0],"parameters":{"text":"={{ $json.summary }}","select":"channel","channelId":{"__rl":true,"mode":"name","value":"#onboarding"},"otherOptions":{}},"typeVersion":2.3},{"id":"c3000000-0000-4000-8000-000000000101","name":"Sticky: overview","type":"n8n-nodes-base.stickyNote","position":[-1660,-660],"parameters":{"color":1,"width":680,"height":2220,"content":"## Verify a subcontractor's licence the moment they submit your onboarding form\n\n![Workflow overview](https://scrapebench.dev/img/n8n/subcontractor-onboarding-gate/canvas.png)\n\n> **Self-hosted only.** This template uses the `@apify/n8n-nodes-apify` community node, which cannot be installed on n8n Cloud.\n\n### Who's it for\nGeneral contractors onboarding subs, property managers approving vendors, marketplaces admitting trade accounts, franchise ops teams.\n\nThe problem it fixes is not that nobody checks licences - it is that the check is done by hand by whoever happens to process the form. It is inconsistent, it gets skipped under load, and it leaves no record of *when* it was checked or what the board said at the time. When it matters, months later, there is nothing to point at.\n\n### What it does\nA subcontractor submits the built-in n8n form. Before anyone opens the submission, the claimed licence number is checked against that state's licensing board and the submission comes back with one of four verdicts:\n\n- `pass` - an active licence exists and it is held by the company that claimed it\n- `review` - the licence is active but registered to a **different** name. Borrowed licence numbers are a real pattern, so this never auto-passes\n- `fail` - the licence is expired, revoked, suspended, or there is no record of it at all\n- `manual-review` - the form was incomplete, the state is not covered, or the lookup itself failed\n\n**The gate fails closed.** Any error, timeout or ambiguity becomes `manual-review`, never a pass. A compliance tool that guesses in your favour when it breaks is a liability, not a control.\n\nEvery submission also produces an audit row - what was claimed, what the board held, the verdict, and the timestamp.\n\nCovers AL, AR, CA, CT, FL, MA, MI, MN, NC, NM, NV, OR, SC, TN, TX, VA and WA. Submissions from other states are labelled `manual-review` and passed to a person - never rejected, and never quietly approved.\n\n### How to set up\n1. Install the `@apify/n8n-nodes-apify` community node.\n2. Add your Apify API key as an Apify credential on the **Look up the licence** node.\n3. Activate the workflow to get the production form URL, and use that as your intake form. Swap the trigger for a Webhook node if you already collect submissions in Typeform, Jotform or your own site.\n4. Replace **Write the audit row** with Google Sheets -> Append row, Airtable, or a database insert. It ships as a Code node so the template runs on import without a credential.\n5. Add a Slack credential to **Post the verdict to Slack**, pick a channel, and enable the node.\n\n### Requirements\n- An Apify account and API token (about $0.004 per check)\n- Self-hosted n8n (community node)\n- Optional: Slack, and a sheet or table for the audit trail\n\n### How to customize\n- **Different intake form:** swap the Form Trigger for a Webhook node. The validator accepts several field spellings and a full state name as well as a 2-letter code.\n- **Stricter matching:** `review` currently covers any name that doesn't match. Tighten or loosen the comparison in **Decide the verdict**.\n- **Add a state:** one row in the `ACTORS` map in **Route by state**.\n- **Route the verdicts:** add a Switch after **Decide the verdict** to send `pass` straight to your CRM and hold the rest.\n"},"typeVersion":1},{"id":"c3000000-0000-4000-8000-000000000102","name":"Sticky: intake","type":"n8n-nodes-base.stickyNote","position":[-820,-680],"parameters":{"color":7,"width":340,"height":460,"content":"## 1. The intake form\nn8n's own Form Trigger, so the template is self-contained - no third-party form account needed.\n\nActivate the workflow to get the public form URL.\n\nAlready collecting submissions elsewhere? Swap this for a **Webhook** node. The next node accepts\nseveral field spellings, so most existing payloads work unchanged.\n"},"typeVersion":1},{"id":"c3000000-0000-4000-8000-000000000103","name":"Sticky: validate","type":"n8n-nodes-base.stickyNote","position":[-460,-620],"parameters":{"color":7,"width":340,"height":400,"content":"## 2. Normalise it\nPeople type \"California\" into a box that wants \"CA\", and forms disagree about whether the field is\n`license_number` or `licenseNumber`.\n\nThis node accepts both, and marks anything missing a required field as `manual-review` rather than\nguessing at it.\n"},"typeVersion":1},{"id":"c3000000-0000-4000-8000-000000000104","name":"Sticky: uncovered","type":"n8n-nodes-base.stickyNote","position":[120,370],"parameters":{"color":7,"width":360,"height":280,"content":"## 3. Anything we cannot check goes to a person\nNot one of the 17 covered states, or an incomplete submission.\n\nNever auto-rejected and never auto-approved. \"We didn't check\" is its own answer.\n"},"typeVersion":1},{"id":"c3000000-0000-4000-8000-000000000105","name":"Sticky: verdict","type":"n8n-nodes-base.stickyNote","position":[400,-680],"parameters":{"color":7,"width":400,"height":480,"content":"## 4. Claimed vs found\nThe submission claims a licence number. This compares it against what the board actually holds.\n\n`review` is the verdict that earns its keep: an **active** licence registered to a different\ncompany is what a borrowed licence number looks like. Passing it because the licence is valid is\nexactly the mistake this template exists to prevent.\n\nIf the lookup itself fails, the verdict is `manual-review` - never a pass. **The gate fails\nclosed.**\n"},"typeVersion":1},{"id":"c3000000-0000-4000-8000-000000000106","name":"Sticky: audit","type":"n8n-nodes-base.stickyNote","position":[660,220],"parameters":{"color":7,"width":340,"height":340,"content":"## 5. The audit trail\nClaimed vs found vs verdict, with a timestamp and the board's own URL.\n\nSwap for Google Sheets, Airtable or a database insert. Months later this is the thing you point\nat, not the decision on its own.\n"},"typeVersion":1}],"pinData":{},"settings":{"executionOrder":"v1"},"connections":{"Route by state":{"main":[[{"node":"Can we check it?","type":"main","index":0}]]},"Can we check it?":{"main":[[{"node":"Look up the licence","type":"main","index":0}],[{"node":"Send it to a human","type":"main","index":0}]]},"Decide the verdict":{"main":[[{"node":"Write the audit row","type":"main","index":0}]]},"Send it to a human":{"main":[[{"node":"Write the audit row","type":"main","index":0}]]},"Look up the licence":{"main":[[{"node":"Decide the verdict","type":"main","index":0}]]},"Write the audit row":{"main":[[{"node":"Post the verdict to Slack","type":"main","index":0}]]},"Validate the submission":{"main":[[{"node":"Route by state","type":"main","index":0}]]},"Subcontractor submits the form":{"main":[[{"node":"Validate the submission","type":"main","index":0}]]}}}