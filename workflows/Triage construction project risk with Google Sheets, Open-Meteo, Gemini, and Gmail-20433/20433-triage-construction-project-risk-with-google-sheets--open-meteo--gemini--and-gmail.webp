{"id":"Q64AA803ddH3myJ7","meta":{"instanceId":"93f396852104089b8670e7494b0f3668b420464668ae4a8c1d6b4b5799f8e3ef","templateCredsSetupCompleted":true},"name":"Construction - Should We Stop This Project? (Decision Engine)","tags":[],"nodes":[{"id":"78c59623-eabf-4470-92f3-607b4d4d4261","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[2128,496],"parameters":{"width":480,"height":896,"content":"## Construction - Should We Stop This Project? (Decision Engine)\n\n### How it works\n\nThis workflow runs every weekday at 7 AM to evaluate active construction projects and decide whether they should continue, receive intervention, or be stopped. It gathers project, weather, budget, procurement, labor, site report, and dispute data, computes risk scores, then sends the summarized risk context to a Gemini-powered decision chain. The resulting decision is formatted with guardrails, logged to Google Sheets, and emailed to the project manager only when intervention or stopping is recommended.\n\n### Setup steps\n\n- Configure Google Sheets credentials and ensure the project, budget, procurement, labor, site reports, disputes, and decision log sheets have the expected columns.\n- Review the Open-Meteo HTTP request parameters, especially location and forecast fields, so weather data matches the construction sites being evaluated.\n- Configure Google Gemini credentials for the chat model used by the Decision Chain and verify the structured output parser schema matches the expected decision format.\n- Configure Gmail credentials and update the recipient, subject, and message template for project manager alerts.\n- Confirm the weekday 7 AM schedule uses the intended timezone.\n\n### Customization\n\nAdjust the risk scoring code, the Limit node settings, the LLM prompt/parser schema, and the filter criteria to match the organization’s thresholds for continue, intervene, or stop decisions."},"typeVersion":1},{"id":"599f46aa-51e7-457e-bceb-3e786b1d59df","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[2688,496],"parameters":{"color":7,"width":416,"height":320,"content":"## Schedule project intake\n\nStarts the workflow on a weekday morning schedule and reads the base list of construction projects from Google Sheets."},"typeVersion":1},{"id":"64615e26-a637-4e34-a693-47aa8f944256","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[3136,528],"parameters":{"color":7,"width":864,"height":304,"content":"## Gather operating inputs\n\nCollects nearby weather data and key operational inputs from budget, procurement, and labor sheets for the projects being assessed."},"typeVersion":1},{"id":"56c32862-c28a-4915-b7b6-a7e14e1a90a7","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[4032,528],"parameters":{"color":7,"width":864,"height":304,"content":"## Compile risk context\n\nAdds site report and dispute information, computes project risk scores, and limits the items passed onward for decisioning."},"typeVersion":1},{"id":"532f3844-3e7b-49ab-aea6-aa673743fded","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[4928,496],"parameters":{"color":7,"width":576,"height":544,"content":"## Generate final decision\n\nUses the Gemini-backed LLM chain with structured parsing to make the project decision, then formats the result with computed metrics and guardrails."},"typeVersion":1},{"id":"fafad9a1-41a8-4481-bf08-68885b9b5a03","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[5536,496],"parameters":{"color":7,"width":640,"height":320,"content":"## Log and alert\n\nWrites every formatted decision to the decision log, filters for projects requiring intervention or stoppage, and emails the project manager for those cases."},"typeVersion":1},{"id":"4ebe86e6-f15a-4116-b85b-d36ac23734ae","name":"When Weekday at 7AM","type":"n8n-nodes-base.scheduleTrigger","position":[2736,656],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 7 * * 1-5"}]}},"typeVersion":1.2},{"id":"93998618-aabc-4932-8ca5-920515d3d9c5","name":"Read Projects from Sheets","type":"n8n-nodes-base.googleSheets","position":[2960,656],"parameters":{"options":{},"filtersUI":{"values":[{"lookupValue":"Active","lookupColumn":"status"}]},"sheetName":{"__rl":true,"mode":"name","value":"Projects"},"documentId":{"__rl":true,"mode":"id","value":"1YDO5pfSMqem58WqDcFu5212rmKZQIlSVXHuL9P9gEt4"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"mYRmmCMyWcLawmcE","name":"Google Service Account account"}},"typeVersion":4.5,"alwaysOutputData":true},{"id":"3c76f9bc-785d-414b-99b3-3ec4ce1af130","name":"Fetch Weather Forecast","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[3184,656],"parameters":{"url":"=https://api.open-meteo.com/v1/forecast?latitude={{ $json.latitude }}&longitude={{ $json.longitude }}&daily=precipitation_sum,wind_speed_10m_max,temperature_2m_min&forecast_days=7&timezone=auto","options":{"timeout":15000}},"typeVersion":4.2},{"id":"0e6817c6-ea54-4a2c-b7f2-37a6c784148f","name":"Read Budget from Sheets","type":"n8n-nodes-base.googleSheets","position":[3408,656],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Budget_Accounting"},"documentId":{"__rl":true,"mode":"id","value":"1YDO5pfSMqem58WqDcFu5212rmKZQIlSVXHuL9P9gEt4"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"mYRmmCMyWcLawmcE","name":"Google Service Account account"}},"executeOnce":true,"typeVersion":4.5,"alwaysOutputData":true},{"id":"e5b3ef98-0066-4fd7-bebf-9f8e8c80fac6","name":"Read Procurement Details","type":"n8n-nodes-base.googleSheets","position":[3632,656],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Procurement"},"documentId":{"__rl":true,"mode":"id","value":"1YDO5pfSMqem58WqDcFu5212rmKZQIlSVXHuL9P9gEt4"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"mYRmmCMyWcLawmcE","name":"Google Service Account account"}},"executeOnce":true,"typeVersion":4.5,"alwaysOutputData":true},{"id":"b7aa4032-bace-4952-a79f-7bfca572d1fc","name":"Read Labor Data Sheets","type":"n8n-nodes-base.googleSheets","position":[3856,656],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Labor"},"documentId":{"__rl":true,"mode":"id","value":"1YDO5pfSMqem58WqDcFu5212rmKZQIlSVXHuL9P9gEt4"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"mYRmmCMyWcLawmcE","name":"Google Service Account account"}},"executeOnce":true,"typeVersion":4.5,"alwaysOutputData":true},{"id":"c9b16633-e5d1-4002-bfdc-69b0267ea234","name":"Read Site Reports Sheets","type":"n8n-nodes-base.googleSheets","position":[4080,656],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Site_Reports"},"documentId":{"__rl":true,"mode":"id","value":"1YDO5pfSMqem58WqDcFu5212rmKZQIlSVXHuL9P9gEt4"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"mYRmmCMyWcLawmcE","name":"Google Service Account account"}},"executeOnce":true,"typeVersion":4.5,"alwaysOutputData":true},{"id":"99f2aa7f-b79d-4031-ada9-ed1191b38864","name":"Read Disputes from Sheets","type":"n8n-nodes-base.googleSheets","position":[4304,656],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Disputes"},"documentId":{"__rl":true,"mode":"id","value":"1YDO5pfSMqem58WqDcFu5212rmKZQIlSVXHuL9P9gEt4"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"mYRmmCMyWcLawmcE","name":"Google Service Account account"}},"executeOnce":true,"typeVersion":4.5,"alwaysOutputData":true},{"id":"61a575ed-f498-475e-b080-2228ee8f3923","name":"Calculate Risk Scores","type":"n8n-nodes-base.code","position":[4528,656],"parameters":{"jsCode":"// ============ COMPUTE RISK SCORES (Run once for all items) ============\n// Deterministic engine: all numbers are computed HERE. The LLM only explains + sanity-checks.\nconst today = new Date(); today.setHours(0, 0, 0, 0);\nconst DAY = 86400000;\nconst num = (v, d = 0) => { const n = parseFloat(String(v ?? '').replace(/[^0-9.\\-]/g, '')); return Number.isFinite(n) ? n : d; };\nconst parseD = (v) => {\n  const s = String(v ?? '').trim(); if (!s) return null;\n  const m = s.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n  if (m) return new Date(+m[1], +m[2] - 1, +m[3]);\n  const d = new Date(s); return isNaN(d) ? null : new Date(d.getFullYear(), d.getMonth(), d.getDate());\n};\nconst diff = (a, b) => Math.round((a - b) / DAY);\nconst clamp = (x, lo = 0, hi = 100) => Math.max(lo, Math.min(hi, x));\nconst yes = (v) => String(v ?? '').trim().toLowerCase() === 'yes';\nconst same = (r, id) => String(r.project_id ?? '').trim() === id;\nconst rows = (n) => $(n).all().map(i => i.json).filter(r => r && String(r.project_id ?? '').trim() !== '');\nconst money = (n) => '$' + Math.round(n).toLocaleString('en-US');\nconst prob = (s) => Math.round(100 / (1 + Math.exp(-(s - 50) / 10)));   // logistic heuristic: score 50 => 50%\n\nconst projects = rows('Read Projects');\nconst weather  = $('Fetch Weather Forecast').all();\nconst budgets = rows('Read Budget'), pos = rows('Read Procurement'), labor = rows('Read Labor'),\n      site = rows('Read Site Reports'), disputes = rows('Read Disputes');\n\n// Weights of the \"completion-date risk\" composite (sum = 1.00)\nconst WD = { schedule: 0.40, procurement: 0.25, labor: 0.15, disputes: 0.10, weather: 0.05, reporting: 0.05 };\nconst FIX = 0.8;            // assume resolving a lever removes 80% of that pillar's risk\nconst out = [];\n\nprojects.forEach((p, idx) => {\n  const id = String(p.project_id).trim();\n  const flags = [];\n  const start = parseD(p.start_date), end = parseD(p.end_date);\n  const plannedDuration = Math.max(1, diff(end, start));\n  const remainingPlanned = diff(end, today);\n\n  // ---------- 1. SCHEDULE (site-verified progress beats PM-reported when fresh <=7d) ----------\n  const reps = site.filter(r => same(r, id)).sort((a, b) => parseD(b.report_date) - parseD(a.report_date));\n  const latest = reps[0] || null;\n  const siteAge = latest ? diff(today, parseD(latest.report_date)) : null;\n  const sitePct = latest && siteAge <= 7 ? num(latest.site_verified_pct) : null;\n  const pmPct = num(p.actual_pct_pm), plannedPct = num(p.planned_pct);\n  const actualPct = sitePct !== null ? sitePct : pmPct;\n  const sv = actualPct - plannedPct;                                  // schedule variance (pts)\n  const spi = plannedPct > 0 ? actualPct / plannedPct : 1;            // schedule performance index\n  const forecastDelay = actualPct >= 100 ? 0 : clamp(Math.round(plannedDuration / Math.max(spi, 0.1) - plannedDuration), 0, 365);\n  const forecastFinish = new Date(end.getTime() + forecastDelay * DAY).toISOString().slice(0, 10);\n  const scheduleScore = clamp(0.5 * clamp(-sv * 4) + 0.5 * clamp(forecastDelay / 90 * 100));\n  const ldExposure = forecastDelay * num(p.ld_per_day);\n\n  // ---------- 2. PROCUREMENT (overdue, undelivered POs; critical-path weighs x3) ----------\n  const overduePOs = pos.filter(r => same(r, id) && !/deliver|cancel|receiv/i.test(r.status ?? ''))\n    .map(r => { const due = parseD(r.promised_delivery_date); const late = due ? Math.max(0, diff(today, due)) : 0;\n                const critical = yes(r.critical_path); return { ...r, late, critical, pts: Math.min(late, 30) * (critical ? 3 : 1) }; })\n    .filter(r => r.late > 0).sort((a, b) => b.pts - a.pts);\n  const procScore = clamp(overduePOs.reduce((s, r) => s + r.pts, 0) * 1.5);\n  const worstPO = overduePOs[0] || null;\n\n  // ---------- 3. LABOR (next-7-day crew shortfall) ----------\n  const crews = labor.filter(r => same(r, id)).map(r => { const req = num(r.required_headcount_next7d), av = num(r.available_headcount_next7d);\n                return { ...r, req, short: Math.max(0, req - av) }; });\n  const reqTotal = crews.reduce((s, r) => s + r.req, 0), shortTotal = crews.reduce((s, r) => s + r.short, 0);\n  const shortfallPct = reqTotal ? shortTotal / reqTotal * 100 : 0;\n  const laborScore = clamp(shortfallPct * 2);\n  const worstCrew = [...crews].sort((a, b) => b.short - a.short)[0];\n\n  // ---------- 4. DISPUTES (open/escalated; High 40, Medium 20, Low 8; Escalated x1.25) ----------\n  const openDisp = disputes.filter(r => same(r, id) && /open|escalat/i.test(r.status ?? ''))\n    .map(r => { const base = /high/i.test(r.severity) ? 40 : /med/i.test(r.severity) ? 20 : 8;\n                const esc = /escalat/i.test(r.status) ? 1.25 : 1; const od = parseD(r.opened_date);\n                return { ...r, pts: base * esc, days: od ? diff(today, od) : null }; }).sort((a, b) => b.pts - a.pts);\n  const disputeScore = clamp(openDisp.reduce((s, r) => s + r.pts, 0));\n  const worstDisp = openDisp[0] || null;\n\n  // ---------- 5. WEATHER (next 7d lost days: rain>=10mm OR wind>=40km/h OR tmin<=0C) ----------\n  const d = weather[idx]?.json?.daily;\n  let lostDays = 0;\n  if (d && Array.isArray(d.time)) {\n    d.time.forEach((_, i) => { if (num(d.precipitation_sum?.[i]) >= 10 || num(d.wind_speed_10m_max?.[i]) >= 40 || num(d.temperature_2m_min?.[i], 99) <= 0) lostDays++; });\n  } else flags.push('No weather data returned');\n  const weatherScore = clamp(lostDays * 20) * (yes(p.weather_sensitive) ? 1 : 0.3);\n\n  // ---------- 6. REPORTING INTEGRITY (PM-reported vs site-verified gap) ----------\n  let reportingScore, gap = null;\n  if (sitePct === null) { reportingScore = 40; flags.push(latest ? `Latest site report is ${siteAge} days old; PM-reported progress used` : 'No site report on file; PM-reported progress used'); }\n  else { gap = Math.abs(pmPct - sitePct); reportingScore = clamp(gap * 5); if (gap >= 10) flags.push(`PM-reported progress (${pmPct}%) differs from site-verified (${sitePct}%) by ${gap} pts`); }\n\n  // ---------- 7. BUDGET (EVM: CPI, EAC, committed exposure) ----------\n  const b = budgets.find(r => same(r, id));\n  let budgetScore = 0, overrunPct = 0, cpi = null, eac = null, exposure = 0, budTotal = 0, b2 = {};\n  if (!b || num(b.budget_total) <= 0) flags.push('No budget row or budget_total missing');\n  else {\n    budTotal = num(b.budget_total); const spent = num(b.spent_to_date), commit = num(b.committed_open), pco = num(b.pending_change_orders);\n    cpi = spent > 0 ? (budTotal * actualPct / 100) / spent : 1;\n    eac = cpi > 0 ? budTotal / cpi : budTotal * 2;\n    exposure = spent + commit + pco;\n    const forecastCost = Math.max(eac, exposure);\n    overrunPct = Math.round((forecastCost - budTotal) / budTotal * 1000) / 10;\n    budgetScore = clamp(overrunPct * 5);\n    b2 = { budget_total: money(budTotal), spent: money(spent), committed_open: money(commit), pending_change_orders: money(pco),\n           cpi: Math.round(cpi * 100) / 100, forecast_final_cost: money(forecastCost), invoices_unpaid: money(num(b.invoices_unpaid)),\n           invoices_overdue_30d: money(num(b.invoices_overdue_30d)) };\n  }\n\n  // ---------- COMPOSITES ----------\n  const S = { schedule: scheduleScore, procurement: procScore, labor: laborScore, disputes: disputeScore, weather: weatherScore, reporting: reportingScore };\n  const dateScore = Object.keys(WD).reduce((s, k) => s + WD[k] * S[k], 0);\n  const riskScore = Math.round((0.75 * dateScore + 0.25 * budgetScore) * 10) / 10;   // 75% delivery risk + 25% cost risk\n  const missProb = prob(dateScore);\n\n  // ---------- LEVER: which actionable fix cuts miss-date probability the most? ----------\n  const levers = [];\n  if (worstPO) levers.push({ pillar: 'procurement', owner: `Procurement lead -> ${worstPO.supplier}`,\n      issue: `${worstPO.supplier}: PO ${worstPO.po_number} (${worstPO.item}, ${money(num(worstPO.po_value))}) is ${worstPO.late} days overdue${worstPO.critical ? ' and on the critical path' : ''}` });\n  if (worstCrew && worstCrew.short > 0) levers.push({ pillar: 'labor', owner: `PM -> ${worstCrew.subcontractor}`,\n      issue: `${worstCrew.subcontractor} (${worstCrew.trade}) is short ${worstCrew.short} of ${worstCrew.req} workers for the next 7 days` });\n  if (worstDisp) levers.push({ pillar: 'disputes', owner: `PM / Commercial manager -> ${worstDisp.counterparty}`,\n      issue: `${worstDisp.counterparty}: ${worstDisp.subject} (${worstDisp.severity}, ${worstDisp.status}, open ${worstDisp.days ?? '?'} days)` });\n  levers.forEach(l => { const p2 = prob(dateScore - WD[l.pillar] * S[l.pillar] * FIX); l.prob_after_fix_pct = p2; l.gain = missProb - p2; });\n  levers.sort((a, b) => b.gain - a.gain);\n  const lever = levers[0] || null;\n\n  // ---------- RULE DECISION ----------\n  const hard = [];\n  if (overduePOs.some(r => r.critical && r.late >= 7)) hard.push('Critical-path PO >= 7 days overdue');\n  if (shortfallPct >= 40) hard.push(`Crew shortfall ${Math.round(shortfallPct)}% (>= 40%)`);\n  if (overrunPct >= 10) hard.push(`Forecast cost overrun ${overrunPct}% (>= 10%)`);\n  if (forecastDelay >= 30) hard.push(`Forecast delay ${forecastDelay} days (>= 30)`);\n  if (openDisp.some(r => /high/i.test(r.severity) && /escalat/i.test(r.status))) hard.push('High-severity escalated dispute');\n  let ruleDecision = 'CONTINUE';\n  if (riskScore >= 35 || hard.length) ruleDecision = 'INTERVENE';\n  if (riskScore >= 65 && (overrunPct >= 15 || forecastDelay >= 45)) ruleDecision = 'STOP_REVIEW';\n  const deadlineHours = ruleDecision === 'CONTINUE' ? 0 : missProb >= 70 ? 24 : missProb >= 40 ? 48 : 72;\n\n  const contrib = { schedule: 0.75 * WD.schedule * S.schedule, procurement: 0.75 * WD.procurement * S.procurement, labor: 0.75 * WD.labor * S.labor,\n    disputes: 0.75 * WD.disputes * S.disputes, weather: 0.75 * WD.weather * S.weather, reporting: 0.75 * WD.reporting * S.reporting, budget: 0.25 * budgetScore };\n  const topDriver = Object.entries(contrib).sort((a, b) => b[1] - a[1])[0][0];\n\n  const ctx = {\n    project_id: id, project_name: p.project_name, today: today.toISOString().slice(0, 10),\n    rule_decision: ruleDecision, hard_triggers: hard,\n    risk_score_0_100: riskScore, miss_completion_date_probability_pct: missProb, top_driver: topDriver,\n    pillar_scores_0_100: Object.fromEntries(Object.entries({ ...S, budget: budgetScore }).map(([k, v]) => [k, Math.round(v)])),\n    schedule: { planned_pct: plannedPct, pm_reported_pct: pmPct, site_verified_pct: sitePct, used_pct: actualPct, variance_pts: sv, spi: Math.round(spi * 100) / 100,\n                planned_end: end.toISOString().slice(0, 10), forecast_finish: forecastFinish, forecast_delay_days: forecastDelay, days_to_planned_end: remainingPlanned,\n                ld_per_day: money(num(p.ld_per_day)), ld_exposure_at_forecast: money(ldExposure) },\n    budget: b2, forecast_overrun_pct: overrunPct,\n    procurement_overdue: overduePOs.slice(0, 3).map(r => ({ po: r.po_number, supplier: r.supplier, item: r.item, days_late: r.late, critical: r.critical, value: money(num(r.po_value)) })),\n    labor: { shortfall_pct: Math.round(shortfallPct), worst: worstCrew ? { sub: worstCrew.subcontractor, trade: worstCrew.trade, short: worstCrew.short, required: worstCrew.req } : null },\n    open_disputes: openDisp.slice(0, 3).map(r => ({ counterparty: r.counterparty, subject: r.subject, severity: r.severity, status: r.status, days_open: r.days, latest_email: r.latest_email_snippet })),\n    weather_next7d: { lost_days: lostDays, weather_sensitive: yes(p.weather_sensitive) },\n    latest_site_report: latest ? { date: latest.report_date, notes: latest.site_notes } : null,\n    lever_candidates: levers.slice(0, 2).map(l => ({ pillar: l.pillar, owner: l.owner, issue: l.issue, prob_after_fix_pct: l.prob_after_fix_pct })),\n    recommended_deadline_hours: deadlineHours, data_quality_flags: flags\n  };\n\n  out.push({ json: {\n    project_id: id, project_name: p.project_name, pm_name: p.pm_name, pm_email: p.pm_email,\n    rule_decision: ruleDecision, risk_score: riskScore, miss_date_prob_pct: missProb,\n    prob_after_fix_pct: lever ? lever.prob_after_fix_pct : missProb,\n    forecast_delay_days: forecastDelay, forecast_overrun_pct: overrunPct, ld_exposure: Math.round(ldExposure),\n    top_driver: topDriver, lever_owner: lever ? lever.owner : 'PM', lever_issue: lever ? lever.issue : '',\n    deadline_hours: deadlineHours, context_json: JSON.stringify(ctx, null, 1)\n  } });\n});\n\nreturn out;\n"},"typeVersion":2},{"id":"55921f02-344f-4fca-a109-f3c47ba937be","name":"Execute Decision Making Chain","type":"@n8n/n8n-nodes-langchain.chainLlm","position":[5008,656],"parameters":{"text":"=PROJECT METRICS (pre-computed, authoritative):\n{{ $json.context_json }}\n\nReturn the decision JSON for project_id {{ $json.project_id }}.","batching":{},"messages":{"messageValues":[{"message":"You are a construction project-controls analyst advising a commercial construction project manager. You receive PRE-COMPUTED metrics for ONE project as JSON. The numbers are authoritative: quote them, never recalculate or invent figures.\n\nRULES\n1. decision: must equal rule_decision. You may move it by AT MOST ONE level (CONTINUE < INTERVENE < STOP_REVIEW) only if site_notes or dispute emails contain clear qualitative evidence the metrics miss. If you move it, set llm_override=true and state the evidence in why[]. Otherwise llm_override=false.\n2. headline (one sentence, plain text). If decision is INTERVENE or STOP_REVIEW use this shape: '<project_name> is now <miss_completion_date_probability_pct>% likely to miss its completion date unless <first lever_candidate issue resolved by its owner> within <recommended_deadline_hours>h (drops to ~<prob_after_fix_pct of that lever>% if resolved).' If CONTINUE: '<project_name> is on track: <miss_completion_date_probability_pct>% chance of missing the completion date, no escalation needed.'\n3. why: exactly 3 short strings, each citing at least one number from the metrics (schedule, cost, and the top_driver or a hard_trigger).\n4. critical_action: use the first lever_candidate (owner + a concrete verb-led action) and deadline_hours = recommended_deadline_hours. For CONTINUE use owner 'PM', action 'No escalation. Keep monitoring.', deadline_hours 0. If there is no lever_candidate, pick the best action from hard_triggers.\n5. risk_if_ignored: one sentence using forecast_delay_days, ld_exposure_at_forecast and/or forecast_overrun_pct.\n6. confidence: HIGH if data_quality_flags is empty, MEDIUM if 1 flag, LOW if 2 or more.\n7. data_quality_flags: copy the provided flags; do not add new ones.\nPlain text only, no markdown. Return JSON matching the schema."}]},"promptType":"define","hasOutputParser":true},"typeVersion":1.7},{"id":"aba1664d-96eb-4b97-8063-b0e3a9de927b","name":"Google Gemini Chat","type":"@n8n/n8n-nodes-langchain.lmChatGoogleGemini","position":[5008,896],"parameters":{"options":{"temperature":0.2},"modelName":"models/gemini-3.1-flash-lite"},"credentials":{"googlePalmApi":{"id":"fZFSVoP3W8XvTreT","name":"STRICTLY USE GEMINI-3.1-FLASH-LITE"}},"typeVersion":1},{"id":"8d89b658-55ed-4a02-8397-4b85d462ec80","name":"Parse Structured Output","type":"@n8n/n8n-nodes-langchain.outputParserStructured","position":[5184,896],"parameters":{"schemaType":"manual","inputSchema":"{\n  \"type\": \"object\",\n  \"properties\": {\n    \"project_id\": {\n      \"type\": \"string\"\n    },\n    \"decision\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"CONTINUE\",\n        \"INTERVENE\",\n        \"STOP_REVIEW\"\n      ]\n    },\n    \"llm_override\": {\n      \"type\": \"boolean\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"HIGH\",\n        \"MEDIUM\",\n        \"LOW\"\n      ]\n    },\n    \"headline\": {\n      \"type\": \"string\"\n    },\n    \"why\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 3,\n      \"maxItems\": 3\n    },\n    \"critical_action\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"owner\": {\n          \"type\": \"string\"\n        },\n        \"action\": {\n          \"type\": \"string\"\n        },\n        \"deadline_hours\": {\n          \"type\": \"number\"\n        }\n      },\n      \"required\": [\n        \"owner\",\n        \"action\",\n        \"deadline_hours\"\n      ]\n    },\n    \"risk_if_ignored\": {\n      \"type\": \"string\"\n    },\n    \"data_quality_flags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"project_id\",\n    \"decision\",\n    \"llm_override\",\n    \"confidence\",\n    \"headline\",\n    \"why\",\n    \"critical_action\",\n    \"risk_if_ignored\",\n    \"data_quality_flags\"\n  ]\n}"},"typeVersion":1.2},{"id":"deb83ddd-101d-4930-856f-2e4cf2988aa3","name":"Format Final Decision","type":"n8n-nodes-base.code","position":[5360,656],"parameters":{"jsCode":"// FORMAT DECISION: merge LLM output with computed metrics + enforce guardrails\nconst computed = $('Calculate Risk Scores').all();\nconst LV = { CONTINUE: 0, INTERVENE: 1, STOP_REVIEW: 2 };\nconst NAMES = ['CONTINUE', 'INTERVENE', 'STOP_REVIEW'];\nconst runDate = new Date().toISOString().slice(0, 10);\n\nreturn $input.all().map((item, i) => {\n  const c = computed[i].json;\n  const o = item.json.output || {};\n  const flags = [];\n  let decision = NAMES[LV[o.decision]] ? o.decision : c.rule_decision;\n  let override = o.llm_override === true;\n\n  // Guardrail 1: LLM may only deviate if it declared an override, and by one level max\n  const delta = LV[decision] - LV[c.rule_decision];\n  if (!override && delta !== 0) { decision = c.rule_decision; flags.push('LLM decision ignored (no override declared)'); }\n  if (Math.abs(LV[decision] - LV[c.rule_decision]) > 1) { decision = c.rule_decision; override = false; flags.push('LLM override exceeded one level; rule decision kept'); }\n  if (decision === c.rule_decision) override = false;\n\n  const ca = o.critical_action || {};\n  const dq = [...(Array.isArray(o.data_quality_flags) ? o.data_quality_flags : []), ...flags];\n  return { json: {\n    run_date: runDate,\n    project_id: c.project_id, project_name: c.project_name, pm_name: c.pm_name, pm_email: c.pm_email,\n    decision, rule_decision: c.rule_decision, llm_override: override, confidence: o.confidence || 'LOW',\n    risk_score: c.risk_score, miss_date_prob_pct: c.miss_date_prob_pct, prob_after_fix_pct: c.prob_after_fix_pct,\n    forecast_delay_days: c.forecast_delay_days, forecast_overrun_pct: c.forecast_overrun_pct, ld_exposure: c.ld_exposure,\n    top_driver: c.top_driver,\n    headline: o.headline || `${c.project_name}: ${c.miss_date_prob_pct}% likely to miss completion date (${decision})`,\n    why: (o.why || []).map((w, k) => `${k + 1}) ${w}`).join('\\n'),\n    critical_action: ca.action || c.lever_issue,\n    action_owner: ca.owner || c.lever_owner,\n    deadline_hours: ca.deadline_hours ?? c.deadline_hours,\n    risk_if_ignored: o.risk_if_ignored || '',\n    data_quality_flags: dq.join('; ')\n  } };\n});\n"},"typeVersion":2},{"id":"c8bf1453-f07d-4c77-a263-8da9968fe596","name":"Log Decision to Sheets","type":"n8n-nodes-base.googleSheets","position":[5584,656],"parameters":{"columns":{"value":{},"schema":[{"id":"run_date","type":"string","display":true,"removed":false,"required":false,"displayName":"run_date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"project_id","type":"string","display":true,"removed":false,"required":false,"displayName":"project_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"project_name","type":"string","display":true,"removed":false,"required":false,"displayName":"project_name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"pm_name","type":"string","display":true,"removed":false,"required":false,"displayName":"pm_name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"pm_email","type":"string","display":true,"removed":false,"required":false,"displayName":"pm_email","defaultMatch":false,"canBeUsedToMatch":true},{"id":"decision","type":"string","display":true,"removed":false,"required":false,"displayName":"decision","defaultMatch":false,"canBeUsedToMatch":true},{"id":"rule_decision","type":"string","display":true,"removed":false,"required":false,"displayName":"rule_decision","defaultMatch":false,"canBeUsedToMatch":true},{"id":"llm_override","type":"string","display":true,"removed":false,"required":false,"displayName":"llm_override","defaultMatch":false,"canBeUsedToMatch":true},{"id":"confidence","type":"string","display":true,"removed":false,"required":false,"displayName":"confidence","defaultMatch":false,"canBeUsedToMatch":true},{"id":"risk_score","type":"string","display":true,"removed":false,"required":false,"displayName":"risk_score","defaultMatch":false,"canBeUsedToMatch":true},{"id":"miss_date_prob_pct","type":"string","display":true,"removed":false,"required":false,"displayName":"miss_date_prob_pct","defaultMatch":false,"canBeUsedToMatch":true},{"id":"prob_after_fix_pct","type":"string","display":true,"removed":false,"required":false,"displayName":"prob_after_fix_pct","defaultMatch":false,"canBeUsedToMatch":true},{"id":"forecast_delay_days","type":"string","display":true,"removed":false,"required":false,"displayName":"forecast_delay_days","defaultMatch":false,"canBeUsedToMatch":true},{"id":"forecast_overrun_pct","type":"string","display":true,"removed":false,"required":false,"displayName":"forecast_overrun_pct","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ld_exposure","type":"string","display":true,"removed":false,"required":false,"displayName":"ld_exposure","defaultMatch":false,"canBeUsedToMatch":true},{"id":"top_driver","type":"string","display":true,"removed":false,"required":false,"displayName":"top_driver","defaultMatch":false,"canBeUsedToMatch":true},{"id":"headline","type":"string","display":true,"removed":false,"required":false,"displayName":"headline","defaultMatch":false,"canBeUsedToMatch":true},{"id":"why","type":"string","display":true,"removed":false,"required":false,"displayName":"why","defaultMatch":false,"canBeUsedToMatch":true},{"id":"critical_action","type":"string","display":true,"removed":false,"required":false,"displayName":"critical_action","defaultMatch":false,"canBeUsedToMatch":true},{"id":"action_owner","type":"string","display":true,"removed":false,"required":false,"displayName":"action_owner","defaultMatch":false,"canBeUsedToMatch":true},{"id":"deadline_hours","type":"string","display":true,"removed":false,"required":false,"displayName":"deadline_hours","defaultMatch":false,"canBeUsedToMatch":true},{"id":"risk_if_ignored","type":"string","display":true,"removed":false,"required":false,"displayName":"risk_if_ignored","defaultMatch":false,"canBeUsedToMatch":true},{"id":"data_quality_flags","type":"string","display":true,"removed":false,"required":false,"displayName":"data_quality_flags","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"autoMapInputData","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Decision_Log"},"documentId":{"__rl":true,"mode":"id","value":"1YDO5pfSMqem58WqDcFu5212rmKZQIlSVXHuL9P9gEt4"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"mYRmmCMyWcLawmcE","name":"Google Service Account account"}},"typeVersion":4.5},{"id":"dd7cd3a6-e91e-47a5-8ebf-5088b6fc69d6","name":"Filter Intervention Decisions","type":"n8n-nodes-base.filter","position":[5808,656],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"f1","operator":{"type":"string","operation":"notEquals"},"leftValue":"={{ $json.decision }}","rightValue":"CONTINUE"}]}},"typeVersion":2.2},{"id":"25dee66e-0ee6-4bfa-89f1-c7e266245f42","name":"Notify PM via Email","type":"n8n-nodes-base.gmail","position":[6032,656],"webhookId":"1626845f-dc95-4a5a-b6a3-84b4a35dcc86","parameters":{"sendTo":"=vaar@blankarray.com","message":"=<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#222\"><h2 style=\"margin:0 0 8px\">{{ $json.decision }}: {{ $json.project_name }}</h2><p style=\"font-size:16px\"><b>{{ $json.headline }}</b></p><p><b>Do this:</b> {{ $json.critical_action }}<br><b>Owner:</b> {{ $json.action_owner }}<br><b>Deadline:</b> {{ $json.deadline_hours }}h</p><p><b>Why</b><br>{{ $json.why.replace(/\\n/g, '<br>') }}</p><p><b>If ignored:</b> {{ $json.risk_if_ignored }}</p><p style=\"color:#666;font-size:12px\">Risk score {{ $json.risk_score }}/100 | Miss-date probability {{ $json.miss_date_prob_pct }}% (about {{ $json.prob_after_fix_pct }}% if fixed) | Forecast delay {{ $json.forecast_delay_days }} days | Forecast overrun {{ $json.forecast_overrun_pct }}% | Confidence {{ $json.confidence }}{{ $json.data_quality_flags ? ' | Data flags: ' + $json.data_quality_flags : '' }}</p></div>","options":{"appendAttribution":false},"subject":"=[{{ $json.decision }}] {{ $json.project_name }}: {{ $json.miss_date_prob_pct }}% risk of missing completion date"},"credentials":{"gmailOAuth2":{"id":"wreuF4NMkPPxXkKm","name":"Abhiram.bvb"}},"typeVersion":2.1},{"id":"c20ef7fc-a501-4021-bc31-400456c1a3df","name":"Limit to 10 Entries","type":"n8n-nodes-base.limit","position":[4752,656],"parameters":{},"typeVersion":1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"549434ef-ac49-48a9-8dce-48bcc53292cf","nodeGroups":[],"connections":{"Google Gemini Chat":{"ai_languageModel":[[{"node":"Execute Decision Making Chain","type":"ai_languageModel","index":0}]]},"Limit to 10 Entries":{"main":[[{"node":"Execute Decision Making Chain","type":"main","index":0}]]},"When Weekday at 7AM":{"main":[[{"node":"Read Projects from Sheets","type":"main","index":0}]]},"Calculate Risk Scores":{"main":[[{"node":"Limit to 10 Entries","type":"main","index":0}]]},"Format Final Decision":{"main":[[{"node":"Log Decision to Sheets","type":"main","index":0}]]},"Fetch Weather Forecast":{"main":[[{"node":"Read Budget from Sheets","type":"main","index":0}]]},"Log Decision to Sheets":{"main":[[{"node":"Filter Intervention Decisions","type":"main","index":0}]]},"Read Labor Data Sheets":{"main":[[{"node":"Read Site Reports Sheets","type":"main","index":0}]]},"Parse Structured Output":{"ai_outputParser":[[{"node":"Execute Decision Making Chain","type":"ai_outputParser","index":0}]]},"Read Budget from Sheets":{"main":[[{"node":"Read Procurement Details","type":"main","index":0}]]},"Read Procurement Details":{"main":[[{"node":"Read Labor Data Sheets","type":"main","index":0}]]},"Read Site Reports Sheets":{"main":[[{"node":"Read Disputes from Sheets","type":"main","index":0}]]},"Read Disputes from Sheets":{"main":[[{"node":"Calculate Risk Scores","type":"main","index":0}]]},"Read Projects from Sheets":{"main":[[{"node":"Fetch Weather Forecast","type":"main","index":0}]]},"Execute Decision Making Chain":{"main":[[{"node":"Format Final Decision","type":"main","index":0}]]},"Filter Intervention Decisions":{"main":[[{"node":"Notify PM via Email","type":"main","index":0}]]}}}