{"name":"Validate DigiParser customer purchase orders and export staging CSV files","tags":[],"nodes":[{"id":"manual","name":"Run demo","type":"n8n-nodes-base.manualTrigger","position":[0,0],"parameters":{},"typeVersion":1},{"id":"fixtures","name":"Load synthetic DigiParser events","type":"n8n-nodes-base.code","position":[220,0],"parameters":{"jsCode":"return [\n  {\n    \"event\": \"document.exported\",\n    \"data\": {\n      \"id\": \"demo_doc_001\",\n      \"extracted_data\": {\n        \"Customer Name\": \"Demo Buyer Ltd\",\n        \"PO Number\": \"DEMO-PO-001\",\n        \"PO Date\": \"2026-10-05\",\n        \"Currency\": \"USD\",\n        \"Order Total\": 105.25,\n        \"Line Items\": [\n          {\n            \"SKU\": \"DEMO-A\",\n            \"Description\": \"Demo component\",\n            \"Quantity\": 3,\n            \"Unit Price\": 25.1,\n            \"Amount\": 75.3\n          },\n          {\n            \"SKU\": \"DEMO-B\",\n            \"Description\": \"Demo accessory\",\n            \"Quantity\": 1,\n            \"Unit Price\": 29.95,\n            \"Amount\": 29.95\n          }\n        ]\n      }\n    }\n  },\n  {\n    \"event\": \"document.exported\",\n    \"data\": {\n      \"id\": \"demo_doc_002\",\n      \"extracted_data\": {\n        \"Customer Name\": \"Demo Buyer Ltd\",\n        \"PO Number\": \"DEMO-PO-002\",\n        \"PO Date\": \"2026-10-05\",\n        \"Currency\": \"USD\",\n        \"Order Total\": 1,\n        \"Line Items\": [\n          {\n            \"SKU\": \"DEMO-A\",\n            \"Description\": \"Demo component\",\n            \"Quantity\": 3,\n            \"Unit Price\": 25.1,\n            \"Amount\": 75.3\n          },\n          {\n            \"SKU\": \"DEMO-B\",\n            \"Description\": \"Demo accessory\",\n            \"Quantity\": 1,\n            \"Unit Price\": 29.95,\n            \"Amount\": 29.95\n          }\n        ]\n      }\n    }\n  },\n  {\n    \"event\": \"document.exported\",\n    \"data\": {\n      \"id\": \"demo_doc_001\",\n      \"extracted_data\": {\n        \"Customer Name\": \"Demo Buyer Ltd\",\n        \"PO Number\": \"DEMO-PO-001\",\n        \"PO Date\": \"2026-10-05\",\n        \"Currency\": \"USD\",\n        \"Order Total\": 105.25,\n        \"Line Items\": [\n          {\n            \"SKU\": \"DEMO-A\",\n            \"Description\": \"Demo component\",\n            \"Quantity\": 3,\n            \"Unit Price\": 25.1,\n            \"Amount\": 75.3\n          },\n          {\n            \"SKU\": \"DEMO-B\",\n            \"Description\": \"Demo accessory\",\n            \"Quantity\": 1,\n            \"Unit Price\": 29.95,\n            \"Amount\": 29.95\n          }\n        ]\n      }\n    }\n  }\n].map(json => ({ json }));"},"typeVersion":2},{"id":"validate","name":"Validate customer orders","type":"n8n-nodes-base.code","position":[450,0],"parameters":{"jsCode":"// n8n Code node: Run Once for All Items.\n// Input: DigiParser document.exported envelopes, direct or under webhook body.\nconst seen = new Set();\nconst text = value => typeof value === 'string' ? value.trim() : '';\nconst money = value => {\n  if (typeof value !== 'number' && typeof value !== 'string') return null;\n  if (!/^\\d+(?:\\.\\d{1,2})?$/.test(String(value))) return null;\n  const cents = Math.round(Number(value) * 100);\n  return Number.isSafeInteger(cents) ? cents : null;\n};\nreturn $input.all().map((item, index) => {\n  const envelope = item.json.body ?? item.json;\n  const data = envelope?.data;\n  const fields = data?.extracted_data;\n  const errors = [];\n  if (envelope?.event !== 'document.exported') errors.push('Unsupported event');\n  if (!text(data?.id)) errors.push('Missing document ID');\n  if (!fields || typeof fields !== 'object' || Array.isArray(fields)) errors.push('Missing extracted fields');\n  const f = fields && typeof fields === 'object' ? fields : {};\n  const buyer = text(f['Customer Name']);\n  const po = text(f['PO Number']);\n  const currency = text(f['Currency']);\n  const date = text(f['PO Date']);\n  if (!buyer) errors.push('Missing customer name');\n  if (!po) errors.push('Missing PO number');\n  if (!/^[A-Z]{3}$/.test(currency)) errors.push('Currency must be a three-letter code');\n  // Format and calendar check, including impossible dates such as February 30.\n  const parsed = new Date(date + 'T00:00:00Z');\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || !Number.isFinite(parsed.getTime()) || parsed.toISOString().slice(0, 10) !== date) errors.push('PO date must be a valid YYYY-MM-DD date');\n  const total = money(f['Order Total']);\n  if (total === null) errors.push('Order total must be a non-negative number with at most two decimal places');\n  const lines = f['Line Items'];\n  let sum = 0;\n  if (!Array.isArray(lines) || !lines.length) errors.push('Missing line items');\n  else lines.forEach((line, lineIndex) => {\n    if (!line || typeof line !== 'object') { errors.push(`Line ${lineIndex + 1}: invalid row`); return; }\n    if (!text(line['SKU']) && !text(line['Description'])) errors.push(`Line ${lineIndex + 1}: missing SKU or description`);\n    const quantity = line['Quantity'];\n    if ((typeof quantity !== 'number' && typeof quantity !== 'string') || !/^\\d+(?:\\.\\d+)?$/.test(String(quantity)) || !Number.isFinite(Number(quantity)) || Number(quantity) <= 0) errors.push(`Line ${lineIndex + 1}: quantity must be positive`);\n    const price = money(line['Unit Price']);\n    const amount = money(line['Amount']);\n    if (price === null || amount === null) errors.push(`Line ${lineIndex + 1}: invalid price or amount`);\n    else {\n      if (Number.isFinite(Number(quantity)) && Math.round(Number(quantity) * price) !== amount) errors.push(`Line ${lineIndex + 1}: quantity times unit price does not match amount`);\n      sum += amount;\n    }\n  });\n  if (!Number.isSafeInteger(sum)) errors.push('Line total exceeds supported range');\n  if (total !== null && sum !== total) errors.push('Line amounts do not match order total');\n  // Detect duplicate customer+PO pairs in this input batch only.\n  const key = JSON.stringify([buyer.toLowerCase(), po.toLowerCase()]);\n  if (buyer && po && seen.has(key)) errors.push('Duplicate customer and PO number in this batch');\n  if (!errors.length) seen.add(key);\n  return { json: { document_id: text(data?.id), customer_name: buyer, po_number: po, po_date: date, currency, order_total: total === null ? null : total / 100, line_items: Array.isArray(lines) ? lines : [], validation_status: errors.length ? 'needs_review' : 'ready_for_staging', valid: errors.length === 0, review_reasons: errors }, pairedItem: { item: index } };\n});\n"},"typeVersion":2},{"id":"route","name":"Order passes checks?","type":"n8n-nodes-base.if","position":[680,0],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"valid-check","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.valid }}","rightValue":""}]}},"typeVersion":2.2},{"id":"ready","name":"Prepare ready order rows","type":"n8n-nodes-base.code","position":[930,-100],"parameters":{"jsCode":"const rows=[]; for (const [i,item] of $input.all().entries()) { for (const [lineIndex,line] of item.json.line_items.entries()) { rows.push({json:{document_id:item.json.document_id,customer_name:item.json.customer_name,po_number:item.json.po_number,po_date:item.json.po_date,currency:item.json.currency,order_total:item.json.order_total,line_number:lineIndex+1,sku:line.SKU||'',description:line.Description||'',quantity:Number(line.Quantity),unit_price:Number(line['Unit Price']),amount:Number(line.Amount)},pairedItem:{item:i}}); } } return rows;"},"typeVersion":2},{"id":"review","name":"Prepare review rows","type":"n8n-nodes-base.code","position":[930,120],"parameters":{"jsCode":"return $input.all().map((item,i)=>({json:{document_id:item.json.document_id,customer_name:item.json.customer_name,po_number:item.json.po_number,po_date:item.json.po_date,currency:item.json.currency,review_reasons:item.json.review_reasons.join('; ')},pairedItem:{item:i}}));"},"typeVersion":2},{"id":"notes","name":"Demo setup and scope","type":"n8n-nodes-base.stickyNote","position":[-40,-650],"parameters":{"width":1050,"height":580,"content":"# Validate customer purchase orders and export staging CSV files\n\n## Who is this for?\nSeller-side order-entry teams processing customer purchase orders with DigiParser. Founder affiliation: contributed by DigiParser.\n\n## Run the demo\nImport and run **Run demo**. Three synthetic document.exported events demonstrate a correct order, a total mismatch and a duplicate. The correct order produces two line-item CSV rows; the review file contains two cases. No account connection is needed for this demo.\n\n## Use your extracted data\nReplace **Load synthetic DigiParser events** with a trusted data source. Each input item must contain `event: document.exported` and `data.id` plus `data.extracted_data`. For REST API output, map `documentId` to `data.id`, combine `fields` with `tables` into `data.extracted_data`, and preserve the line-item field names shown in the demo. Use an authenticated API request or a signature-verified webhook; never expose an unsigned public order-entry endpoint. Configure your credentials in n8n, not in this JSON.\n\n## What it does\nChecks required fields, dates, positive quantities, decimal money, line arithmetic and order total. Detects repeated customer+PO pairs within one batch. Routes exceptions to review and writes CSV files for inspection. Does not write an ERP order.\n\n## Assumptions\nTwo-decimal currency; total equals line totals without tax, freight or discounts. Add those components for other order formats. Duplicate checks do not cover retries across runs.\n\nSetup context: https://www.digiparser.com/solutions/purchase-order-parser\nAPI and webhook docs: https://www.digiparser.com/docs/api/webhooks"},"typeVersion":1},{"id":"orders-csv","name":"Download staging CSV","type":"n8n-nodes-base.convertToFile","position":[1170,-100],"parameters":{"options":{"fileName":"ready-orders.csv","headerRow":true},"operation":"csv"},"typeVersion":1.1},{"id":"review-csv","name":"Download review CSV","type":"n8n-nodes-base.convertToFile","position":[1170,120],"parameters":{"options":{"fileName":"review-orders.csv","headerRow":true},"operation":"csv"},"typeVersion":1.1},{"id":"source-note","name":"Demo data source","type":"n8n-nodes-base.stickyNote","position":[-40,200],"parameters":{"color":2,"width":340,"height":190,"content":"## Demo source\nThree synthetic export events: a valid order, a total mismatch and a same-batch duplicate. Replace this Code node with a trusted, mapped source for real use."},"typeVersion":1},{"id":"validate-note","name":"Validation checks","type":"n8n-nodes-base.stickyNote","position":[370,220],"parameters":{"color":2,"width":340,"height":190,"content":"## Check order data\nRequired fields, calendar date, two-decimal money, positive quantities, line arithmetic and total reconciliation. Duplicate detection is limited to this batch."},"typeVersion":1},{"id":"output-note","name":"CSV outputs","type":"n8n-nodes-base.stickyNote","position":[880,350],"parameters":{"color":2,"width":340,"height":190,"content":"## Inspect both files\nValid orders become line-level staging rows. Exceptions include reasons in the review file. Download the binary output from each final node. No ERP writes occur."},"typeVersion":1}],"active":false,"pinData":{},"settings":{"executionOrder":"v1"},"connections":{"Run demo":{"main":[[{"node":"Load synthetic DigiParser events","type":"main","index":0}]]},"Prepare review rows":{"main":[[{"node":"Download review CSV","type":"main","index":0}]]},"Order passes checks?":{"main":[[{"node":"Prepare ready order rows","type":"main","index":0}],[{"node":"Prepare review rows","type":"main","index":0}]]},"Prepare ready order rows":{"main":[[{"node":"Download staging CSV","type":"main","index":0}]]},"Validate customer orders":{"main":[[{"node":"Order passes checks?","type":"main","index":0}]]},"Load synthetic DigiParser events":{"main":[[{"node":"Validate customer orders","type":"main","index":0}]]}}}