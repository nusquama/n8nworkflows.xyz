{"name":"Queue negative Famulor call reviews in Google Sheets","tags":[],"nodes":[{"id":"84c9c07a-945c-45d8-a683-1d5296bb4fdf","name":"Overview and setup","type":"n8n-nodes-base.stickyNote","position":[-700,-150],"parameters":{"color":1,"width":640,"height":790,"content":"## Who is this for?\nSupport and customer success teams using Famulor voice assistants who want a review queue for dissatisfied callers.\n\n### How it works\nEvery hour, the workflow reads completed calls with negative sentiment that were created in the last 48 hours. It checks all response pages before writing, deduplicates call IDs and prepares a short review row. Google Sheets appends or updates by Call ID, so overlapping windows update existing rows. Operator columns such as Owner, Follow-up status and Notes are left untouched. Missing success analysis is labelled accurately. Summaries are limited to 1,500 characters; transcripts and recordings are excluded.\n\n### Setup\n1. In Famulor, enable sentiment analysis for the assistants you want to monitor.\n2. Create an n8n Header Auth credential with name Authorization and value Bearer followed by your workspace API key. Grant calls:read and select it in Read Famulor pages. Verify the selected credential before testing; imports may preselect an existing connection.\n3. Create these sheet headers: Call ID, Created at, Ended at, Direction, Caller, Recipient, Duration minutes, Sentiment, Summary, Success, Review reason. Connect Google Sheets and set its ID and tab in Configure workflow.\n4. Execute with Preview only enabled. After checking the rows, set it to false and activate the schedule.\n\n### Customization\nAdjust the creation window and polling interval. Increase throughput by narrowing the window; an incomplete scan fails before any write. API errors stop the workflow and appear in n8n Executions. This template reads Famulor data and never initiates calls. [API setup](https://docs.famulor.io/automations/n8n)."},"typeVersion":1},{"id":"e2a0aa03-dd56-4f5a-91dc-6d6974433bcf","name":"Read section","type":"n8n-nodes-base.stickyNote","position":[0,180],"parameters":{"color":7,"width":950,"height":470,"content":"## 1. Read the configured window\nSelect your Header Auth credential. Requests stay on the Famulor API origin."},"typeVersion":1},{"id":"52681a43-fa8b-4432-ad47-6bdbeb133ce4","name":"Prepare section","type":"n8n-nodes-base.stickyNote","position":[960,180],"parameters":{"color":7,"width":530,"height":470,"content":"## 2. Validate and prepare\nIncomplete scans stop here. No full transcripts or recordings are forwarded."},"typeVersion":1},{"id":"4e55abd8-2839-4a8a-a968-6bc8ffc2d1b9","name":"Deliver section","type":"n8n-nodes-base.stickyNote","position":[1500,180],"parameters":{"color":7,"width":610,"height":470,"content":"## 3. Preview, then deliver\nPreview only starts enabled. Connect the destination before switching it off."},"typeVersion":1},{"id":"21d41b2f-4d23-4476-8116-ffdbd537a07a","name":"Every hour","type":"n8n-nodes-base.scheduleTrigger","position":[60,300],"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":1}]}},"typeVersion":1.2},{"id":"bea20c87-c7ff-4007-b6fb-535e815276e1","name":"Run a manual preview","type":"n8n-nodes-base.manualTrigger","position":[60,460],"parameters":{},"typeVersion":1},{"id":"11be810a-89ec-47ad-bfb5-555cd62cfc11","name":"Configure workflow","type":"n8n-nodes-base.set","position":[260,380],"parameters":{"options":{},"assignments":{"assignments":[{"id":"eab88f60-aaa7-4e1d-b70a-815649574ac8","name":"businessTimezone","type":"string","value":"UTC"},{"id":"9501b017-42c7-4ef6-bb42-b3212ae35f8f","name":"lookbackHours","type":"number","value":48},{"id":"4fb188af-9f1d-46c4-af3e-9c9a3549e61b","name":"previewOnly","type":"boolean","value":true},{"id":"44987ba5-bfd7-4fbe-992c-ab548da5c2d7","name":"sheetDocumentId","type":"string","value":"REPLACE_WITH_YOUR_SHEET_ID"},{"id":"2cf00971-39f9-4824-bd6a-cc0eb4bf51c6","name":"sheetTab","type":"string","value":"Call review"}]}},"typeVersion":3.4},{"id":"0e112bbf-0d6c-4262-ab35-3addccf7fd34","name":"Build date window","type":"n8n-nodes-base.set","position":[480,380],"parameters":{"options":{},"assignments":{"assignments":[{"id":"fc579bf1-26ea-4834-b0f4-944335a1aff0","name":"windowStart","type":"string","value":"={{ $now.setZone($json.businessTimezone).minus({hours:$json.lookbackHours}).toUTC().toISO() }}"},{"id":"9c640174-bcd5-4ff7-8f2b-f20753cd5a7f","name":"windowEnd","type":"string","value":"={{ $now.toUTC().toISO() }}"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"88ac0935-912c-4829-867b-25fb42c3357d","name":"Read Famulor pages","type":"n8n-nodes-base.httpRequest","position":[690,380],"parameters":{"url":"https://app.famulor.io/api/v1/calls","method":"GET","options":{"timeout":30000,"redirect":{"redirect":{"followRedirects":false}},"response":{"response":{"responseFormat":"json"}},"pagination":{"pagination":{"parameters":{"parameters":[{"name":"offset","type":"qs","value":"={{ $pageCount * 200 }}"}]},"maxRequests":10,"paginationMode":"updateAParameterInEachRequest","requestInterval":300,"limitPagesFetched":true,"completeExpression":"={{ Array.isArray($response.body.data) && ($response.body.data.length < 200 || (Number.isInteger($response.body.meta?.pagination?.total) && $response.body.meta.pagination.offset + $response.body.data.length >= $response.body.meta.pagination.total)) }}","paginationCompleteWhen":"other"}}},"sendQuery":true,"authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","queryParameters":{"parameters":[{"name":"limit","value":"200"},{"name":"from","value":"={{ $json.windowStart }}"},{"name":"to","value":"={{ $json.windowEnd }}"},{"name":"status","value":"completed"},{"name":"sentiment","value":"negative"},{"name":"sort","value":"updated_at"}]}},"typeVersion":4.2},{"id":"2b5883b8-5c0a-4884-ace3-54a65cd9d8fc","name":"Validate and prepare","type":"n8n-nodes-base.code","position":[980,380],"parameters":{"mode":"runOnceForAllItems","jsCode":"function flattenPages(pages) {\n  if (!pages.length || pages.length>10) throw new Error('Expected 1–10 Famulor response pages.');\n  const rows=[];\n  let expectedOffset=0;\n  for (const page of pages) {\n    if (page.error || !Array.isArray(page.data)) throw new Error('Famulor returned an invalid response. Check the credential and required read scope.');\n    const p=page.meta?.pagination;\n    if (!p || p.limit!==200 || p.offset!==expectedOffset || page.data.length>200) throw new Error('Unexpected pagination. No destination data was written.');\n    if (page.result_cap_reached || page.meta?.result_cap_reached) throw new Error('Famulor capped this result. Narrow the date window before retrying.');\n    if (p.total!==undefined && (!Number.isInteger(p.total)||p.total<0)) throw new Error('Invalid result count.');\n    rows.push(...page.data);\n    expectedOffset+=200;\n  }\n  const last=pages.at(-1), p=last.meta.pagination;\n  if (last.data.length===200 && (p.total===undefined || p.offset+last.data.length<p.total)) throw new Error('More than 2,000 records or an incomplete page sequence. Narrow the date window before retrying.');\n  if (p.total!==undefined && p.offset+last.data.length<p.total) throw new Error('Incomplete result set. No destination data was written.');\n  const unique=new Map();\n  for (const row of rows) {\n    if (!row || typeof row.id!=='string'||!row.id.trim()) throw new Error('A Famulor record has no stable ID.');\n    unique.set(row.id,row);\n  }\n  return [...unique.values()];\n}\nconst rows=flattenPages($input.all().map(i=>i.json));\n\nconst cfg=$('Build date window').first().json;\nconst start=Date.parse(cfg.windowStart),end=Date.parse(cfg.windowEnd);\nif (!Number.isFinite(start)||!Number.isFinite(end)||end<=start) throw new Error('Invalid configured date range.');\n\nconst result=rows.filter(r=>r.status==='completed'&&(r.sentiment??r.analysis?.sentiment)==='negative'&&Date.parse(r.created_at)>=start&&Date.parse(r.created_at)<=end).map(r=>({json:{\n  'Call ID':r.id,'Created at':r.created_at,'Ended at':r.ended_at??'',Direction:r.direction??'',\n  Caller:r.from_number??'',Recipient:r.to_number??'',\n  'Duration minutes':Number.isFinite(r.duration_sec)?Number((r.duration_sec/60).toFixed(2)):0,\n  Sentiment:'negative',Summary:String(r.summary??'').slice(0,1500),\n  Success:r.success===true?'yes':r.success===false?'no':'not analyzed',\n  'Review reason':'Negative sentiment; human follow-up review',\n}}));\nreturn result.length?result:[{json:{noData:true,message:'No completed negative calls in the configured creation window.'}}];"},"typeVersion":2},{"id":"810d21a6-1247-4cfc-aa8e-c6b74b51c1bb","name":"Preview only?","type":"n8n-nodes-base.if","position":[1510,380],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"df1bc178-447c-41e3-b0d8-338604df6098","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $(\"Configure workflow\").first().json.previewOnly }}","rightValue":true}]}},"typeVersion":2.2},{"id":"2c135caf-9a50-4e09-8ce1-9d0d2a9fadbe","name":"Preview prepared output","type":"n8n-nodes-base.code","position":[1760,290],"parameters":{"mode":"runOnceForAllItems","jsCode":"return $input.all();"},"typeVersion":2},{"id":"d9a169fc-e5e0-4c78-a8fa-f22fb93b6259","name":"Upsert the review queue","type":"n8n-nodes-base.googleSheets","position":[1760,500],"parameters":{"columns":{"value":{"Caller":"={{ $json[\"Caller\"] }}","Call ID":"={{ $json[\"Call ID\"] }}","Success":"={{ $json[\"Success\"] }}","Summary":"={{ $json[\"Summary\"] }}","Ended at":"={{ $json[\"Ended at\"] }}","Direction":"={{ $json[\"Direction\"] }}","Recipient":"={{ $json[\"Recipient\"] }}","Sentiment":"={{ $json[\"Sentiment\"] }}","Created at":"={{ $json[\"Created at\"] }}","Review reason":"={{ $json[\"Review reason\"] }}","Duration minutes":"={{ $json[\"Duration minutes\"] }}"},"schema":[{"id":"Call ID","type":"string","display":true,"required":false,"displayName":"Call ID","defaultMatch":true,"canBeUsedToMatch":true},{"id":"Created at","type":"string","display":true,"required":false,"displayName":"Created at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Ended at","type":"string","display":true,"required":false,"displayName":"Ended at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Direction","type":"string","display":true,"required":false,"displayName":"Direction","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Caller","type":"string","display":true,"required":false,"displayName":"Caller","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Recipient","type":"string","display":true,"required":false,"displayName":"Recipient","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Duration minutes","type":"number","display":true,"required":false,"displayName":"Duration minutes","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Sentiment","type":"string","display":true,"required":false,"displayName":"Sentiment","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Summary","type":"string","display":true,"required":false,"displayName":"Summary","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Success","type":"string","display":true,"required":false,"displayName":"Success","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Review reason","type":"string","display":true,"required":false,"displayName":"Review reason","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["Call ID"],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{"cellFormat":"RAW"},"operation":"appendOrUpdate","sheetName":{"__rl":true,"mode":"name","value":"={{ $(\"Configure workflow\").first().json.sheetTab }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $(\"Configure workflow\").first().json.sheetDocumentId }}"}},"typeVersion":4.6},{"id":"93fd6139-3313-4cfd-a7df-1eca19c9c45e","name":"Has review rows?","type":"n8n-nodes-base.if","position":[1220,380],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"d72e39ff-e8a7-47eb-b10c-08902e3ab1f8","operator":{"type":"boolean","operation":"false","singleValue":true},"leftValue":"={{ $json.noData === true }}"}]}},"typeVersion":2.2}],"active":false,"pinData":{},"settings":{"timezone":"UTC","executionOrder":"v1"},"connections":{"Every hour":{"main":[[{"node":"Configure workflow","type":"main","index":0}]]},"Preview only?":{"main":[[{"node":"Preview prepared output","type":"main","index":0}],[{"node":"Upsert the review queue","type":"main","index":0}]]},"Has review rows?":{"main":[[{"node":"Preview only?","type":"main","index":0}],[{"node":"Preview prepared output","type":"main","index":0}]]},"Build date window":{"main":[[{"node":"Read Famulor pages","type":"main","index":0}]]},"Configure workflow":{"main":[[{"node":"Build date window","type":"main","index":0}]]},"Read Famulor pages":{"main":[[{"node":"Validate and prepare","type":"main","index":0}]]},"Run a manual preview":{"main":[[{"node":"Configure workflow","type":"main","index":0}]]},"Validate and prepare":{"main":[[{"node":"Has review rows?","type":"main","index":0}]]}}}