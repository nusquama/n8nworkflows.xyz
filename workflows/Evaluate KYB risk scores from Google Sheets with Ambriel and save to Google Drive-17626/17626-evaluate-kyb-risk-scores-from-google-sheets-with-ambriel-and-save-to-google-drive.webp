{"id":"OysfCCEeCJF4aaK1","meta":{"instanceId":"1c287d9efc773bb947c7e38c2ec3bab83d94576292be0bb795c2f6ab87b4f3e1","templateCredsSetupCompleted":true},"name":"Google Sheets KYB Evaluation + Reports on Drive","tags":[],"nodes":[{"id":"bb73b86f-547e-44bc-8b71-189b1a933913","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-384,96],"parameters":{"width":480,"height":816,"content":"## Google Sheets KYB Evaluation + Reports on Drive\n\n### How it works\n\nThis workflow runs on a schedule, reads company records from Google Sheets, and processes each row through Ambriel for KYB evaluation. It updates the source sheet with evaluation results, checks whether a report file is available, then downloads and uploads the report to Google Drive.\n\n### Setup steps\n\n- Configure the Schedule Trigger with the desired run frequency.\n- Connect Google Sheets credentials and select the spreadsheet, sheet, and row range containing the companies to evaluate.\n- Configure Ambriel credentials and map the required company fields from the sheet into the evaluation and report-file nodes.\n- Connect Google Drive credentials and choose the destination folder for uploaded reports.\n- Verify the If condition matches the expected Ambriel response field that indicates a report file is available.\n\n### Customization\n\nAdjust the Google Sheets column mappings, Ambriel evaluation inputs, report availability condition, and Google Drive destination folder to match your KYB process."},"typeVersion":1},{"id":"8d1e4ca9-462a-4e94-907e-721f342aaf99","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[176,160],"parameters":{"color":7,"width":400,"height":304,"content":"## Schedule sheet intake\n\nStarts the workflow on a schedule and reads the rows to be evaluated from Google Sheets."},"typeVersion":1},{"id":"cd38e355-df94-43d5-ba2e-9ec61ff56c80","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[624,96],"parameters":{"color":7,"width":688,"height":416,"content":"## Evaluate and update rows\n\nLoops through each sheet row, runs the Ambriel company KYB evaluation, feeds the loop for the next item, and writes evaluation results back to Google Sheets."},"typeVersion":1},{"id":"4400c405-dfe6-4768-8d04-76fcc91d86d0","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[1344,320],"parameters":{"color":7,"width":416,"height":336,"content":"## Check report availability\n\nRequests the Ambriel report file details for the evaluated company and uses a conditional branch to continue only when a report file is available."},"typeVersion":1},{"id":"6040336e-0e6d-466f-9bd0-3467349047f3","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[1792,240],"parameters":{"color":7,"width":400,"height":320,"content":"## Download and store report\n\nDownloads the available report file by HTTP request and uploads the resulting file to Google Drive."},"typeVersion":1},{"id":"47249081-0010-41b4-94ec-3ebcaab7f0df","name":"Read from Google Sheet","type":"n8n-nodes-base.googleSheets","position":[432,288],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"list","value":"gid=0","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14U1aL0rX8w9BZbVfFD-w9GwPlpSMPQ1J0odYBr7glyI/edit#gid=0","cachedResultName":"Sheet1"},"documentId":{"__rl":true,"mode":"url","value":"https://docs.google.com/spreadsheets/d/14U1aL0rX8w9BZbVfFD-w9GwPlpSMPQ1J0odYBr7glyI/edit?gid=0#gid=0"}},"credentials":{"googleSheetsOAuth2Api":{"id":"6A0nx77RElzEqnF1","name":"Google Sheets account"}},"typeVersion":4.7},{"id":"269b6dde-4183-44bb-9fc4-73e396287135","name":"Batch Process Items","type":"n8n-nodes-base.splitInBatches","position":[672,288],"parameters":{"options":{}},"typeVersion":3},{"id":"281ee211-fc2d-4d0a-8a67-79f6ed936878","name":"Update Google Sheet Row","type":"n8n-nodes-base.googleSheets","position":[1168,256],"parameters":{"columns":{"value":{"cui":"={{ $('Batch Process Items').item.json.cui }}","name":"={{ $('Batch Process Items').item.json.name }}","risk":"={{ $json.level }}","score":"={{ $json.score }}","regcom":"={{ $('Batch Process Items').item.json.regcom }}","row_number":"={{ $('Batch Process Items').item.json.row_number }}"},"schema":[{"id":"name","type":"string","display":true,"required":false,"displayName":"name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"cui","type":"string","display":true,"required":false,"displayName":"cui","defaultMatch":false,"canBeUsedToMatch":true},{"id":"regcom","type":"string","display":true,"required":false,"displayName":"regcom","defaultMatch":false,"canBeUsedToMatch":true},{"id":"score","type":"string","display":true,"required":false,"displayName":"score","defaultMatch":false,"canBeUsedToMatch":true},{"id":"risk","type":"string","display":true,"required":false,"displayName":"risk","defaultMatch":false,"canBeUsedToMatch":true},{"id":"row_number","type":"number","display":true,"removed":false,"readOnly":true,"required":false,"displayName":"row_number","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["row_number"],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{"cellFormat":"USER_ENTERED"},"operation":"update","sheetName":{"__rl":true,"mode":"list","value":"gid=0","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14U1aL0rX8w9BZbVfFD-w9GwPlpSMPQ1J0odYBr7glyI/edit#gid=0","cachedResultName":"Sheet1"},"documentId":{"__rl":true,"mode":"list","value":"14U1aL0rX8w9BZbVfFD-w9GwPlpSMPQ1J0odYBr7glyI","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14U1aL0rX8w9BZbVfFD-w9GwPlpSMPQ1J0odYBr7glyI/edit?usp=drivesdk","cachedResultName":"companies-list-v1"}},"credentials":{"googleSheetsOAuth2Api":{"id":"6A0nx77RElzEqnF1","name":"Google Sheets account"}},"typeVersion":4.7},{"id":"fd09ecc2-1327-485e-9bc0-8cccf692f2e0","name":"Fetch Ambriel Report File","type":"CUSTOM.ambrielCompany","position":[1392,496],"parameters":{"operation":"getReport","assessmentId":"={{ $json.id }}"},"cre