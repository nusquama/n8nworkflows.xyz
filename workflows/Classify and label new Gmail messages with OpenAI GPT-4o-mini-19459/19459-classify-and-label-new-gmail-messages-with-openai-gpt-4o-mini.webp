{"meta":{"templateCredsSetupCompleted":false},"name":"Inbox Triage Lite | classify and label every new Gmail message","tags":[],"nodes":[{"id":"fdf989af-eaa9-4ae1-8285-1ba70b38c743","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-1856,-96],"parameters":{"width":480,"height":752,"content":"## Inbox Triage Lite | classify and label every new Gmail message\n\n### How it works\n\nThis workflow monitors Gmail for every new incoming message, prepares classification settings, and sends the email content to OpenAI for triage. It parses the AI response into a usable label decision, then applies the matching Gmail label to the original message.\n\n### Setup steps\n\n- Connect and authorize the Gmail trigger and Gmail action credentials in n8n.\n- Configure the OpenAI API key or authorization header used by the HTTP Request node.\n- Review the Settings node values for the model, system prompt, and labelMap so they match the Gmail labels available in the target mailbox.\n- Ensure the Apply label node references the correct message ID from the trigger and the label ID produced by the classification step.\n\n### Customization\n\nAdjust the system prompt, model, and labelMap in the Settings node to change the triage categories or labeling rules."},"typeVersion":1},{"id":"caf86d6c-6587-424e-b066-6c32e96a167f","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-1296,-96],"parameters":{"color":7,"width":416,"height":320,"content":"## Detect and configure\n\nStarts the workflow when a new Gmail message arrives and sets the model, prompt, and label mapping used for triage."},"typeVersion":1},{"id":"7afe60fd-ed1c-4f12-bd13-2a3d43f031cb","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[-848,-96],"parameters":{"color":7,"width":416,"height":320,"content":"## Classify email content\n\nSends the prepared email data to the OpenAI chat completions API and reads the returned classification result."},"typeVersion":1},{"id":"f41efc47-7cf1-404c-8dd3-41dc91c35b39","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[-384,-96],"parameters":{"color":7,"width":240,"height":320,"content":"## Apply Gmail label\n\nUses the parsed classification to label the original Gmail message."},"typeVersion":1},{"id":"22bfb9aa-9bf9-4700-a1a0-13e5f458d929","name":"When New Email Received","type":"n8n-nodes-base.gmailTrigger","position":[-1248,64],"parameters":{"simple":false,"filters":{},"options":{},"pollTimes":{"item":[{"mode":"everyMinute"}]}},"typeVersion":1},{"id":"61e1fa49-c602-4642-9aec-e9a1078f48de","name":"Set Model and Labels","type":"n8n-nodes-base.set","position":[-1024,64],"parameters":{"options":{},"assignments":{"assignments":[{"id":"a1","name":"model","type":"string","value":"gpt-4o-mini"},{"id":"a2","name":"systemPrompt","type":"string","value":"You are an email triage assistant for a small business. Classify the email into exactly one category: new_enquiry, invoice, supplier, urgent, noise. Reply with JSON only, using the keys: category (string), urgent (boolean), summary (string, max 20 words)."},{"id":"a5","name":"labelMap","type":"object","value":"={{ ({ new_enquiry: 'PASTE_NEW_ENQUIRY_LABEL_ID', invoice: 'PASTE_INVOICE_LABEL_ID', supplier: 'PASTE_SUPPLIER_LABEL_ID', urgent: 'PASTE_URGENT_LABEL_ID', noise: 'PASTE_NOISE_LABEL_ID' }) }}"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"a21e2c18-8d90-446b-a8ed-8ddd1847ef21","name":"Post to OpenAI API","type":"n8n-nodes-base.httpRequest","position":[-800,64],"parameters":{"url":"https://api.openai.com/v1/chat/completions","method":"POST","options":{},"jsonBody":"={{ JSON.stringify({ model: $('Set Model and Labels').item.json.model, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: $('Set Model and Labels').item.json.systemPrompt }, { role: 'user', content: 'Subject: ' + ($json.subject || '') + ' | From: ' + ($json.From || '') + ' | Body: ' + String($json.snippet || $json.textPlain || '').slice(0, 1500) } ] }) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"typeVersion":4.2},{"id":"fe448d36-72cf-461b-bf11-e7b070dd4b8b","name":"Parse Classification Result","type":"n8n-nodes-base.code","position":[-576,64],"parameters":{"jsCode":"const raw = $json.choices[0].message.content;\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch (e) { parsed = { category: 'noise', urgent: false, summary: 'Could not parse model output' }; }\nconst email = $('Set Model and Labels').item.json;\nreturn [{ json: { category: parsed.category, urgent: parsed.urgent === true, summary: parsed.summary || '', subject: email.subject || '', id: email.id } }];"},"typeVersion":2},{"id":"66fa14c4-8766-4bcf-9a8e-1d533848e465","name":"Add Labels via Gmail","type":"n8n-nodes-base.gmail","position":[-336,64],"parameters":{"labelIds":"={{ [ $('Set Model and Labels').item.json.labelMap[$json.category] ] }}","messageId":"={{ $json.id }}","operation":"addLabels"},"typeVersion":2.1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"nodeGroups":[],"connections":{"Post to OpenAI API":{"main":[[{"node":"Parse Classification Result","type":"main","index":0}]]},"Set Model and Labels":{"main":[[{"node":"Post to OpenAI API","type":"main","index":0}]]},"When New Email Received":{"main":[[{"node":"Set Model and Labels","type":"main","index":0}]]},"Parse Classification Result":{"main":[[{"node":"Add Labels via Gmail","type":"main","index":0}]]}}}