{"id":"a7ldLty8xYKwUCqw","meta":{"instanceId":"dd69efaf8212c74ad206700d104739d3329588a6f3f8381a46a481f34c9cc281","templateCredsSetupCompleted":true},"name":"Universal API-to-Database Ingestion Engine (Pagination + Retries)","tags":[],"nodes":[{"id":"69acd1e0-9e7e-4bc4-9806-e18882283e3e","name":"Sticky Note - Overview","type":"n8n-nodes-base.stickyNote","position":[-1232,-16],"parameters":{"width":780,"height":980,"content":"## Universal API → Database Ingestion\n\nFetches any paginated API, normalizes records, upserts them into Postgres, and automatically continues until no more pages remain (with retries + rate-limit waits).\n\n### All nodes (1-line each)\n1. Manual Trigger – Starts the ingestion job on demand.\n2. Code - Initialize Config – Loads API URL, headers, pagination type, retry policy and field mapping.\n3. HTTP Request - Fetch Page – Calls the API with current page/cursor and built-in retries.\n4. Code - Parse & Normalize – Extracts records from the response and calculates the next page token/page.\n5. IF - Has Records? – Continues only when the current page actually returned data.\n6. Postgres - Upsert Records – Inserts or updates the batch into the target table with conflict handling.\n7. Code - Prepare Next Page – Updates cursor/page counter and checks against max-pages limit.\n8. IF - More Pages? – Decides whether another page should be fetched.\n9. Wait - Rate Limit Delay – Pauses between pages to respect API rate limits.\n10. Code - Finalize Job – Builds the final summary (total records, pages, status).\n11. NoOp - End – Terminates the workflow cleanly after the last page."},"typeVersion":1},{"id":"3af390cc-45f2-439f-a161-f236c51867b6","name":"Sticky Note - Config & Fetch","type":"n8n-nodes-base.stickyNote","position":[-400,-16],"parameters":{"color":5,"width":828,"height":600,"content":"## 1. Config & First Fetch\n\nManual Trigger – Starts the ingestion job on demand.\nCode - Initialize Config – Loads API URL, headers, pagination type, retry policy and field mapping.\nHTTP Request - Fetch Page – Calls the API with current page/cursor and built-in retries."},"typeVersion":1},{"id":"08ab731f-7bc4-4b61-821e-93a4b4231c65","name":"Sticky Note - Process & Store","type":"n8n-nodes-base.stickyNote","position":[528,32],"parameters":{"color":4,"width":812,"height":520,"content":"## 2. Process & Store\n\nCode - Parse & Normalize – Extracts records from the response and calculates the next page token/page.\nIF - Has Records? – Continues only when the current page actually returned data.\nPostgres - Upsert Records – Inserts or updates the batch into the target table with conflict handling."},"typeVersion":1},{"id":"5c9ce428-aadc-459e-bf7a-617373178d24","name":"Sticky Note - Pagination Control","type":"n8n-nodes-base.stickyNote","position":[1392,-16],"parameters":{"color":5,"width":1372,"height":724,"content":"## 3. Pagination & Finish\n\nCode - Prepare Next Page – Updates cursor/page counter and checks against max-pages limit.\nIF - More Pages? – Decides whether another page should be fetched.\nWait - Rate Limit Delay – Pauses between pages to respect API rate limits.\nCode - Finalize Job – Builds the final summary (total records, pages, status).\nNoOp - End – Terminates the workflow cleanly after the last page."},"typeVersion":1},{"id":"52cff96c-51b8-41d5-986d-a1782a1e683e","name":"Manual Trigger","type":"n8n-nodes-base.manualTrigger","notes":"Starts the ingestion job on demand.","position":[-352,368],"parameters":{},"notesInFlow":true,"typeVersion":1},{"id":"af1bd6aa-f1ae-4e58-9a9d-5fa7e6e322ae","name":"Code - Initialize Config","type":"n8n-nodes-base.code","notes":"Loads API URL, headers, pagination type, retry policy and field mapping.","position":[-80,368],"parameters":{"jsCode":"// ---- EDIT THIS CONFIG ----\nconst CONFIG = {\n  // API\n  baseUrl: 'https://api.example.com/v1/items',\n  method: 'GET',\n  headers: {\n    'Authorization': 'Bearer YOUR_TOKEN_HERE',\n    'Accept': 'application/json'\n  },\n  query: {},                    // static query params\n\n  // Pagination strategy: 'page' | 'offset' | 'cursor' | 'link'\n  paginationType: 'page',\n  pageParam: 'page',            // used when type = page\n  offsetParam: 'offset',        // used when type = offset\n  limitParam: 'limit',\n  limit: 100,\n  cursorParam: 'cursor',        // used when type = cursor\n  cursorPath: 'meta.next_cursor', // JSON path to next cursor in response\n  dataPath: 'data',             // JSON path to the array of records\n  linkHeaderRel: 'next',        // used when type = link\n\n  // Safety\n  maxPages: 50,\n  maxRetries: 3,\n  retryWaitMs: 2000,\n\n  // Database\n  tableName: 'ingested_records',\n  uniqueKey: 'external_id',     // column used for ON CONFLICT\n  fieldMap: {                   // source → target column\n    id: 'external_id',\n    name: 'name',\n    email: 'email',\n    created_at: 'created_at'\n  }\n};\n\nreturn [{\n  json: {\n    config: CONFIG,\n    state: {\n      page: 1,\n      offset: 0,\n      cursor: null,\n      nextUrl: null,\n      pagesDone: 0,\n      totalRecords: 0,\n      hasMore: true\n    },\n    request: {\n      url: CONFIG.baseUrl,\n      qs: { ...CONFIG.query, [CONFIG.limitParam]: CONFIG.limit, [CONFIG.pageParam]: 1 }\n    }\n  }\n}];"},"notesInFlow":true,"typeVersion":2},{"id":"9ba3961b-f7e1-4740-bdff-799a581119af","name":"HTTP Request - Fetch Page","type":"n8n-nodes-base.httpRequest","notes":"Calls the API with current page/cursor and built-in retries.","maxTries":3,"position":[256,368],"parameters":{"url":"={{ $json.request.url || $json.config.baseUrl }}","method":"={{ $json.config.method || 'GET' }}","options":{"timeout":30000,"response":{"response":{"neverError":true,"fullResponse":true}}},"sendQuery":true,"sendHeaders":true,"queryParameters":{"parameters":[{"name":"={{ $json.config.limitParam }}","value":"={{ $json.config.limit }}"},{"name":"={{ $json.config.pageParam }}","value":"={{ $json.state.page }}"}]},"headerParameters":{"parameters":[{"name":"Authorization","value":"={{ $json.config.headers.Authorization }}"},{"name":"Accept","value":"application/json"}]}},"notesInFlow":true,"retryOnFail":true,"typeVersion":4.2,"continueOnFail":true,"waitBetweenTries":2000},{"id":"660a37cd-6f67-4434-8375-c01bd608b438","name":"Code - Parse & Normalize","type":"n8n-nodes-base.code","notes":"Extracts records from the response and calculates the next page token/page.","position":[576,368],"parameters":{"jsCode":"function ref(name) {\n  try { return $(name).item.json; } catch (e) { return $(name).first().json; }\n}\nconst prev = ref('Code - Initialize Config');\nconst cfg = prev.config;\nconst state = { ...prev.state };\nconst res = $input.first().json;\n\nconst status = Number(res.statusCode) || 0;\nlet body = res.body;\nif (typeof body === 'string') {\n  try { body = JSON.parse(body); } catch (e) { body = {}; }\n}\n\n// Helper: get nested path\nfunction getPath(obj, path) {\n  if (!path) return obj;\n  return path.split('.').reduce((o, k) => (o && o[k] !== undefined ? o[k] : null), obj);\n}\n\nlet records = getPath(body, cfg.dataPath) || [];\nif (!Array.isArray(records)) records = [];\n\n// Normalize records according to fieldMap\nconst normalized = records.map(r => {\n  const row = {};\n  for (const [src, dest] of Object.entries(cfg.fieldMap)) {\n    row[dest] = r[src] !== undefined ? r[src] : null;\n  }\n  row._raw = r;\n  return row;\n});\n\n// Decide next page\nlet hasMore = false;\nlet nextCursor = null;\nlet nextUrl = null;\n\nif (cfg.paginationType === 'page') {\n  hasMore = records.length >= cfg.limit && state.pagesDone + 1 < cfg.maxPages;\n  state.page = state.page + 1;\n} else if (cfg.paginationType === 'offset') {\n  hasMore = records.length >= cfg.limit && state.pagesDone + 1 < cfg.maxPages;\n  state.offset = state.offset + cfg.limit;\n} else if (cfg.paginationType === 'cursor') {\n  nextCursor = getPath(body, cfg.cursorPath);\n  hasMore = !!nextCursor && state.pagesDone + 1 < cfg.maxPages;\n  state.cursor = nextCursor;\n} else if (cfg.paginationType === 'link') {\n  // simplistic link header support\n  const link = (res.headers && res.headers.link) || '';\n  const match = link.match(/<([^>]+)>;\\s*rel=\"next\"/i);\n  nextUrl = match ? match[1] : null;\n  hasMore = !!nextUrl && state.pagesDone + 1 < cfg.maxPages;\n  state.nextUrl = nextUrl;\n}\n\nstate.pagesDone += 1;\nstate.totalRecords += normalized.length;\nstate.hasMore = hasMore;\n\nreturn [{\n  json: {\n    config: cfg,\n    state,\n    records: normalized,\n    httpStatus: status,\n    success: status >= 200 && status < 300,\n    request: {\n      url: nextUrl || cfg.baseUrl,\n      qs: cfg.paginationType === 'page'\n        ? { ...cfg.query, [cfg.limitParam]: cfg.limit, [cfg.pageParam]: state.page }\n        : cfg.paginationType === 'offset'\n          ? { ...cfg.query, [cfg.limitParam]: cfg.limit, [cfg.offsetParam]: state.offset }\n          : cfg.paginationType === 'cursor'\n            ? { ...cfg.query, [cfg.limitParam]: cfg.limit, [cfg.cursorParam]: state.cursor }\n            : cfg.query\n    }\n  }\n}];"},"notesInFlow":true,"typeVersion":2},{"id":"bb6b2061-1673-483d-a51c-9aba14760a07","name":"IF - Has Records?","type":"n8n-nodes-base.if","notes":"Continues only when the current page actually returned data.","position":[896,368],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"cond-has-records","operator":{"type":"number","operation":"gt"},"leftValue":"={{ $json.records.length }}","rightValue":0}]}},"notesInFlow":true,"typeVersion":2.2},{"id":"60679cab-28af-4ac4-896d-48d3a035c6cb","name":"Postgres - Upsert Records","type":"n8n-nodes-base.postgres","notes":"Inserts or updates the batch into the target table with conflict handling.","position":[1216,256],"parameters":{"query":"{{ (() => {\n  const cfg = $json.config;\n  const rows = $json.records;\n  if (!rows.length) return 'SELECT 1';\n  const cols = Object.values(cfg.fieldMap);\n  const unique = cfg.uniqueKey;\n  const values = rows.map((r, i) => {\n    const vals = cols.map(c => {\n      const v = r[c];\n      if (v === null || v === undefined) return 'NULL';\n      if (typeof v === 'number') return v;\n      return \"'\" + String(v).replace(/'/g, \"''\") + \"'\";\n    });\n    return '(' + vals.join(',') + ')';\n  }).join(',\\n');\n  const updateSet = cols.filter(c => c !== unique).map(c => c + ' = EXCLUDED.' + c).join(', ');\n  return `INSERT INTO ${cfg.tableName} (${cols.join(',')})\\nVALUES\\n${values}\\nON CONFLICT (${unique}) DO UPDATE SET ${updateSet};`;\n})() }}","options":{},"operation":"executeQuery"},"notesInFlow":true,"typeVersion":2.5,"continueOnFail":true},{"id":"2fd914a5-8c19-43c5-93b2-1858b3dc7586","name":"Code - Prepare Next Page","type":"n8n-nodes-base.code","notes":"Updates cursor/page counter and checks against max-pages limit.","position":[1536,368],"parameters":{"jsCode":"function ref(name) {\n  try { return $(name).item.json; } catch (e) { return $(name).first().json; }\n}\n// Prefer the latest parsed state (comes from either branch)\nconst parsed = ref('Code - Parse & Normalize');\nconst cfg = parsed.config;\nconst state = parsed.state;\n\nreturn [{\n  json: {\n    config: cfg,\n    state,\n    request: parsed.request,\n    shouldContinue: state.hasMore === true\n  }\n}];"},"notesInFlow":true,"typeVersion":2},{"id":"8e3c0da3-8f42-4e9f-a77a-1c9465ac3122","name":"IF - More Pages?","type":"n8n-nodes-base.if","notes":"Decides whether another page should be fetched.","position":[1856,368],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"cond-more","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.shouldContinue }}","rightValue":""}]}},"notesInFlow":true,"typeVersion":2.2},{"id":"d8ebd140-758e-4a82-8a77-4f0a6cb05538","name":"Wait - Rate Limit Delay","type":"n8n-nodes-base.wait","notes":"Pauses between pages to respect API rate limits.","position":[2176,256],"webhookId":"4f9be2ee-7a9c-4a6a-b95a-fe8c0d43e138","parameters":{"amount":1},"typeVersion":1.1},{"id":"2035bdf6-6e4b-497c-b67a-e5a862f53de3","name":"Code - Finalize Job","type":"n8n-nodes-base.code","notes":"Builds the final summary (total records, pages, status).","position":[2176,496],"parameters":{"jsCode":"function ref(name) {\n  try { return $(name).item.json; } catch (e) { return $(name).first().json; }\n}\nconst data = ref('Code - Prepare Next Page');\nconst state = data.state || {};\n\nreturn [{\n  json: {\n    status: 'completed',\n    pagesProcessed: state.pagesDone || 0,\n    totalRecordsIngested: state.totalRecords || 0,\n    finishedAt: new Date().toISOString(),\n    message: `Ingestion finished. ${state.totalRecords || 0} records across ${state.pagesDone || 0} pages.`\n  }\n}];"},"notesInFlow":true,"typeVersion":2},{"id":"f26ac2c8-d348-4045-8adc-de87cd431cf9","name":"NoOp - End","type":"n8n-nodes-base.noOp","notes":"Terminates the workflow cleanly after the last page.","position":[2496,496],"parameters":{},"notesInFlow":true,"typeVersion":1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":false,"executionOrder":"v1"},"versionId":"6077228a-3da2-499c-8897-874c7cc91f96","nodeGroups":[],"connections":{"Manual Trigger":{"main":[[{"node":"Code - Initialize Config","type":"main","index":0}]]},"IF - More Pages?":{"main":[[{"node":"Wait - Rate Limit Delay","type":"main","index":0}],[{"node":"Code - Finalize Job","type":"main","index":0}]]},"IF - Has Records?":{"main":[[{"node":"Postgres - Upsert Records","type":"main","index":0}],[{"node":"Code - Prepare Next Page","type":"main","index":0}]]},"Code - Finalize Job":{"main":[[{"node":"NoOp - End","type":"main","index":0}]]},"Wait - Rate Limit Delay":{"main":[[{"node":"HTTP Request - Fetch Page","type":"main","index":0}]]},"Code - Initialize Config":{"main":[[{"node":"HTTP Request - Fetch Page","type":"main","index":0}]]},"Code - Parse & Normalize":{"main":[[{"node":"IF - Has Records?","type":"main","index":0}]]},"Code - Prepare Next Page":{"main":[[{"node":"IF - More Pages?","type":"main","index":0}]]},"HTTP Request - Fetch Page":{"main":[[{"node":"Code - Parse & Normalize","type":"main","index":0}]]},"Postgres - Upsert Records":{"main":[[{"node":"Code - Prepare Next Page","type":"main","index":0}]]}}}