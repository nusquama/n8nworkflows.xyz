{"id":"WyOJfuiblAjqdaVW","meta":{"instanceId":"93f396852104089b8670e7494b0f3668b420464668ae4a8c1d6b4b5799f8e3ef","templateCredsSetupCompleted":true},"name":"Roofing Contractor Leads Production Pipeline","tags":[],"nodes":[{"id":"6225ca51-a253-4a2e-b731-6cfd4ddd8aae","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-1296,320],"parameters":{"width":480,"height":896,"content":"## Roofing Contractor Leads Production Pipeline\n\n### How it works\n\nThis workflow runs on a schedule to pull roofing contractor leads from an Apify Angi scrape, normalize them, and compare them against existing Google Sheets records. It filters out duplicates, searches for each new lead’s website domain, enriches valid domains with Hunter contact data, and falls back to phone-only records when no valid domain is found. New leads are saved to Google Sheets and Slack notifications are sent for both saved leads and skipped duplicates.\n\n### Setup steps\n\n- Configure the Schedule Trigger with the desired run frequency.\n- Add the Apify API token and confirm the Angi scrape actor or dataset endpoint used by the Fetch Angi Scrape HTTP request.\n- Connect Google Sheets credentials and set the spreadsheet, sheet/tab, and column mappings for reading existing leads and saving new ones.\n- Add SerpAPI credentials for the domain search request and Hunter.io credentials for contact enrichment.\n- Configure Slack credentials and select the channels or users for new-lead and duplicate-skipped notifications.\n- Review the code nodes to ensure field names match the Apify output and Google Sheets schema.\n\n### Customization\n\nAdjust the dedupe keys, lead normalization rules, domain validation logic, Hunter contact ranking criteria, fallback phone-only fields, and Slack message formats to match the preferred lead qualification process."},"typeVersion":1},{"id":"2cd45f1f-5ade-42a2-bc2b-8bad83b5209d","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-688,320],"parameters":{"color":7,"width":416,"height":320,"content":"## Scheduled Angi scrape\n\nStarts the pipeline on a recurring schedule and fetches the latest roofing contractor lead data from the Apify Angi scrape endpoint."},"typeVersion":1},{"id":"67a735ec-9f98-47fc-9045-b2d560bce9a4","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[-256,320],"parameters":{"color":7,"width":416,"height":320,"content":"## Normalize and load records\n\nCleans and batches scraped lead data, then loads existing Google Sheets records so incoming leads can be compared against the database."},"typeVersion":1},{"id":"e2d196e0-ac34-472b-8f72-0763d815a4af","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[176,320],"parameters":{"color":7,"width":640,"height":400,"content":"## Dedupe and skip duplicates\n\nPerforms multi-key deduplication, decides whether each lead is new, and sends a Slack notification when a duplicate is skipped."},"typeVersion":1},{"id":"31980c88-496c-4e48-810b-4f48459b6407","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[832,320],"parameters":{"color":7,"width":416,"height":400,"content":"## Find valid domain\n\nSearches the web for a new lead’s website and extracts or validates the best matching domain for enrichment."},"typeVersion":1},{"id":"24ab71a3-4b49-4926-8878-b22461d98393","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[1264,320],"parameters":{"color":7,"width":640,"height":512,"content":"## Enrich contact details\n\nBranches based on domain validity, enriches valid domains through Hunter, ranks contact results, or prepares a phone-only lead when no valid domain is available."},"typeVersion":1},{"id":"31dab139-7d74-4a58-a612-f0994f713c87","name":"Sticky Note6","type":"n8n-nodes-base.stickyNote","position":[1968,384],"parameters":{"color":7,"width":416,"height":320,"content":"## Save and notify lead\n\nWrites the completed new lead record to Google Sheets and sends a Slack notification for the newly saved lead."},"typeVersion":1},{"id":"32b40a78-6577-49d5-b62b-78841f44e03c","name":"When Schedule Reaches 6am","type":"n8n-nodes-base.scheduleTrigger","position":[-640,480],"parameters":{"rule":{"interval":[{"triggerAtHour":6}]}},"typeVersion":1.2},{"id":"45108e93-40e0-418f-abe7-5c00a7c2e569","name":"Fetch Angi Data","type":"n8n-nodes-base.httpRequest","position":[-416,480],"parameters":{"url":"https://api.apify.com/v2/acts/R01HadmgmJV93ycd5/run-sync-get-dataset-items","options":{},"jsonBody":"{\n  \"searchTerms\": [\"roofing\"],\n  \"location\": \"Austin, TX\",\n  \"maxResults\": 100,\n  \"detailLevel\": \"full\",\n  \"keepPartialProfiles\": false,\n  \"includeReviews\": false\n}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"credentials":{"httpHeaderAuth":{"id":"vV1YAdUT6uLRLiwq","name":"Apify"}},"typeVersion":4.5},{"id":"a51f60d9-7bfd-4862-bb5d-d578ca87c613","name":"Normalize and Deduplicate","type":"n8n-nodes-base.code","position":[-208,480],"parameters":{"jsCode":"const items = $input.all();\nconst seenProIds = new Set();\nconst seenPhones = new Set();\nconst seenFallbackKeys = new Set();\nconst unique = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const rawName = (data.name || '').trim();\n  const cleanName = rawName\n    .replace(/(,\\s*inc\\.?|inc\\.?|llc|l\\.l\\.c\\.|co\\.?|corp\\.?|group|services)/gi, '')\n    .replace(/[^a-zA-Z0-9 ]/g, '')\n    .trim()\n    .toLowerCase();\n\n  const rawPhone = (data.phone || '').replace(/\\D/g, '');\n  let formattedPhone = null;\n  if (rawPhone.length === 10) {\n    formattedPhone = `+1${rawPhone}`;\n  } else if (rawPhone.length === 11 && rawPhone.startsWith('1')) {\n    formattedPhone = `+${rawPhone}`;\n  }\n\n  const city = (data.city || '').toLowerCase().trim();\n  const state = (data.state || '').toLowerCase().trim();\n  const proId = data.proId ? String(data.proId).trim() : null;\n  const fallbackKey = cleanName && city ? `${cleanName}_${city}_${state}` : null;\n\n  // Check intra-batch duplicate status\n  const isDuplicate =\n    (proId && seenProIds.has(proId)) ||\n    (formattedPhone && seenPhones.has(formattedPhone)) ||\n    (fallbackKey && seenFallbackKeys.has(fallbackKey));\n\n  if (isDuplicate) continue;\n\n  if (proId) seenProIds.add(proId);\n  if (formattedPhone) seenPhones.add(formattedPhone);\n  if (fallbackKey) seenFallbackKeys.add(fallbackKey);\n\n  unique.push({\n    json: {\n      proId,\n      rawName: data.name,\n      companyName: data.name ? data.name.trim() : 'Unknown',\n      cleanName,\n      phone: formattedPhone,\n      fallbackKey,\n      city: data.city || '',\n      state: data.state || '',\n      zip: data.zip || '',\n      fullAddress: `${data.address || ''}, ${data.city || ''}, ${data.state || ''} ${data.zip || ''}`.trim(),\n      description: data.description || '',\n      angiUrl: data.url || '',\n      scrapedAt: data.scrapedAt || new Date().toISOString()\n    }\n  });\n}\n\nreturn unique;"},"typeVersion":2},{"id":"91dd8d07-015b-4de7-b776-e99aac0924f3","name":"Read Leads from Sheets","type":"n8n-nodes-base.googleSheets","position":[16,480],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Leads"},"documentId":{"__rl":true,"mode":"id","value":"REPLACE_WITH_SHEET_ID"}},"credentials":{"googleSheetsOAuth2Api":{"id":"7z3TovKsHCGxfW82","name":"Google Sheets AS"}},"typeVersion":4.5},{"id":"eac2229b-74cb-4f0a-9be4-e56dbce63e42","name":"Check Existing Lead Duplicates","type":"n8n-nodes-base.code","position":[224,448],"parameters":{"jsCode":"const existing = $('Read Leads from Sheets').all().map(i => i.json);\nconst existingProIds = new Set();\nconst existingPhones = new Set();\nconst existingFallbackKeys = new Set();\n\nfor (const row of existing) {\n  if (row.proId) existingProIds.add(String(row.proId).trim());\n  if (row.phone) existingPhones.add(String(row.phone).trim());\n  if (row.fallbackKey) existingFallbackKeys.add(String(row.fallbackKey).trim().toLowerCase());\n}\n\nreturn $('Normalize and Deduplicate').all().map(item => {\n  const d = item.json;\n  const isMatch =\n    (d.proId && existingProIds.has(d.proId)) ||\n    (d.phone && existingPhones.has(d.phone)) ||\n    (d.fallbackKey && existingFallbackKeys.has(d.fallbackKey));\n\n  return {\n    json: {\n      ...d,\n      isDuplicate: Boolean(isMatch)\n    }\n  };\n});"},"typeVersion":2},{"id":"ebb00256-0cb3-4622-9130-2d261cb07252","name":"If Lead is New","type":"n8n-nodes-base.if","position":[448,448],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"cond-new-lead","operator":{"type":"boolean","operation":"equals"},"leftValue":"={{ $json.isDuplicate }}","rightValue":false}]}},"typeVersion":2.2},{"id":"75827533-47f3-4d07-9ea9-6b61e7273628","name":"Fetch Domain Search Results","type":"n8n-nodes-base.httpRequest","position":[880,448],"parameters":{"url":"https://serpapi.com/search.json","options":{"response":{"response":{"neverError":true}}},"sendQuery":true,"authentication":"genericCredentialType","genericAuthType":"httpQueryAuth","queryParameters":{"parameters":[{"name":"engine","value":"google"},{"name":"q","value":"={{ $json.companyName }} roofing {{ $json.city }} {{ $json.state }}"},{"name":"num","value":"5"}]}},"credentials":{"httpQueryAuth":{"id":"3hSvbsic5tcNJPOX","name":"YOUTUBE API"}},"typeVersion":4.5},{"id":"6952d9e5-37b8-4925-b5aa-246e86244b50","name":"Validate and Extract Domains","type":"n8n-nodes-base.code","position":[1088,448],"parameters":{"jsCode":"const BLOCKLIST = [\n  'yelp.com', 'bbb.org', 'angi.com', 'yellowpages.com', 'facebook.com',\n  'houzz.com', 'thumbtack.com', 'mapquest.com', 'nextdoor.com', 'instagram.com',\n  'linkedin.com', 'twitter.com', 'x.com', 'youtube.com', 'zoominfo.com', 'porch.com'\n];\n\nconst lead = $('If Lead is New').item.json;\nconst results = $json.organic_results || [];\nlet bestDomain = null;\n\n// Tokenize company name for domain match validation\nconst tokens = (lead.cleanName || '')\n  .split(' ')\n  .filter(t => t.length > 2 && !['roofing', 'contractor', 'austin', 'repair', 'group', 'services'].includes(t));\n\nfor (const r of results) {\n  if (!r.link) continue;\n  try {\n    const host = new URL(r.link).hostname.replace(/^www\\./i, '').toLowerCase();\n    if (BLOCKLIST.some(b => host.includes(b))) continue;\n\n    // Verify domain contains at least one representative company token\n    const matchesName = tokens.length === 0 || tokens.some(tok => host.includes(tok));\n    if (matchesName) {\n      bestDomain = host;\n      break;\n    }\n  } catch (e) {}\n}\n\nreturn {\n  json: {\n    ...lead,\n    discoveredDomain: bestDomain\n  }\n};"},"typeVersion":2},{"id":"137c555e-9582-4ac6-9a54-060ed2b5bc7f","name":"If Domain is Valid","type":"n8n-nodes-base.if","position":[1328,448],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"has-domain","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $json.discoveredDomain }}","rightValue":""}]}},"typeVersion":2.2},{"id":"f2019ac8-a500-4ab0-98d5-a5b0a7468def","name":"Fetch Hunter Domain Data","type":"n8n-nodes-base.httpRequest","position":[1552,432],"parameters":{"url":"https://api.hunter.io/v2/domain-search","options":{"response":{"response":{"neverError":true}}},"sendQuery":true,"authentication":"genericCredentialType","genericAuthType":"httpQueryAuth","queryParameters":{"parameters":[{"name":"domain","value":"={{ $json.discoveredDomain }}"}]}},"credentials":{"httpQueryAuth":{"id":"3hSvbsic5tcNJPOX","name":"YOUTUBE API"}},"typeVersion":4.5},{"id":"85269cd6-22b6-4683-a1b4-a9ac563ba8a2","name":"Rank and Enrich Contacts","type":"n8n-nodes-base.code","position":[1744,432],"parameters":{"jsCode":"const lead = $('Validate and Extract Domains').item.json;\nconst hunterData = $json.data || {};\nconst emails = hunterData.emails || [];\n\nfunction rankContact(c) {\n  const pos = (c.position || '').toLowerCase();\n  const sen = (c.seniority || '').toLowerCase();\n  if (/owner|founder|co-founder|proprietor/i.test(pos)) return 100;\n  if (/president|ceo|principal/i.test(pos)) return 90;\n  if (/partner|director|vp|vice president/i.test(pos)) return 80;\n  if (sen === 'executive' || sen === 'senior') return 70;\n  if (/manager|estimator|sales|operations/i.test(pos)) return 50;\n  return 10;\n}\n\nemails.sort((a, b) => rankContact(b) - rankContact(a));\nconst topContact = emails[0];\n\nlet enrichmentStatus = 'website_no_email';\nlet contactEmail = '';\nlet contactName = '';\nlet contactTitle = '';\n\nif (topContact && topContact.value) {\n  contactEmail = topContact.value;\n  contactName = `${topContact.first_name || ''} ${topContact.last_name || ''}`.trim();\n  contactTitle = topContact.position || '';\n  enrichmentStatus = rankContact(topContact) >= 80 ? 'enriched_owner' : 'enriched_contact';\n}\n\nreturn {\n  json: {\n    ...lead,\n    website: lead.discoveredDomain,\n    email: contactEmail,\n    contactName,\n    contactTitle,\n    enrichmentStatus\n  }\n};"},"typeVersion":2},{"id":"ad264385-8de5-4c08-a772-93b55a6187cb","name":"Set Contact Details","type":"n8n-nodes-base.set","position":[1680,672],"parameters":{"options":{},"assignments":{"assignments":[{"id":"f1","name":"website","type":"string","value":""},{"id":"f2","name":"email","type":"string","value":""},{"id":"f3","name":"contactName","type":"string","value":""},{"id":"f4","name":"contactTitle","type":"string","value":""},{"id":"f5","name":"enrichmentStatus","type":"string","value":"phone_only"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"64bfc7a7-60f7-4ae5-a88c-6165d148f147","name":"Append Lead to Sheets","type":"n8n-nodes-base.googleSheets","position":[2016,544],"parameters":{"columns":{"value":{"zip":"={{ $json.zip }}","city":"={{ $json.city }}","email":"={{ $json.email }}","phone":"={{ $json.phone }}","proId":"={{ $json.proId }}","state":"={{ $json.state }}","angiUrl":"={{ $json.angiUrl }}","website":"={{ $json.website }}","scrapedAt":"={{ $json.scrapedAt }}","companyName":"={{ $json.companyName }}","contactName":"={{ $json.contactName }}","description":"={{ $json.description }}","fallbackKey":"={{ $json.fallbackKey }}","fullAddress":"={{ $json.fullAddress }}","contactTitle":"={{ $json.contactTitle }}","enrichmentStatus":"={{ $json.enrichmentStatus }}"},"mappingMode":"defineBelow"},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Leads"},"documentId":{"__rl":true,"mode":"id","value":"REPLACE_WITH_SHEET_ID"}},"credentials":{"googleSheetsOAuth2Api":{"id":"7z3TovKsHCGxfW82","name":"Google Sheets AS"}},"typeVersion":4.5},{"id":"00cce6f7-0bb8-4029-8377-23c248b520c8","name":"Notify Slack New Lead Posted","type":"n8n-nodes-base.slack","position":[2240,544],"webhookId":"27f30ef4-09aa-4156-ab60-1cb6721e0a7b","parameters":{"text":"=New lead saved: *{{ $json.companyName }}* ({{ $json.city }}, {{ $json.state }}) — Status: `{{ $json.enrichmentStatus }}`{{ $json.email ? ' — ' + $json.email + ' (' + $json.contactTitle + ')' : '' }}","select":"channel","channelId":{"__rl":true,"mode":"list","value":"C0B8VH1M5PX","cachedResultName":"general"},"otherOptions":{}},"credentials":{"slackApi":{"id":"uBs2LjzTiloElvwT","name":"Slack account 2"}},"typeVersion":2.3},{"id":"ddb9cc1f-7898-444c-82da-d77f32a01942","name":"Notify Slack Duplicate Skipped","type":"n8n-nodes-base.slack","position":[624,528],"webhookId":"5f637416-8ede-4045-b7b6-8695684be93b","parameters":{"text":"=Skipped duplicate lead: *{{ $json.companyName }}* ({{ $json.phone || 'No phone' }}) — already exists.","select":"channel","channelId":{"__rl":true,"mode":"list","value":"C0B8VH1M5PX","cachedResultName":"general"},"otherOptions":{}},"credentials":{"slackApi":{"id":"uBs2LjzTiloElvwT","name":"Slack account 2"}},"typeVersion":2.3}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"65b567a7-5435-44f8-8109-c866e1b1a98a","nodeGroups":[],"connections":{"If Lead is New":{"main":[[{"node":"Fetch Domain Search Results","type":"main","index":0}],[{"node":"Notify Slack Duplicate Skipped","type":"main","index":0}]]},"Fetch Angi Data":{"main":[[{"node":"Normalize and Deduplicate","type":"main","index":0}]]},"If Domain is Valid":{"main":[[{"node":"Fetch Hunter Domain Data","type":"main","index":0}],[{"node":"Set Contact Details","type":"main","index":0}]]},"Set Contact Details":{"main":[[{"node":"Append Lead to Sheets","type":"main","index":0}]]},"Append Lead to Sheets":{"main":[[{"node":"Notify Slack New Lead Posted","type":"main","index":0}]]},"Read Leads from Sheets":{"main":[[{"node":"Check Existing Lead Duplicates","type":"main","index":0}]]},"Fetch Hunter Domain Data":{"main":[[{"node":"Rank and Enrich Contacts","type":"main","index":0}]]},"Rank and Enrich Contacts":{"main":[[{"node":"Append Lead to Sheets","type":"main","index":0}]]},"Normalize and Deduplicate":{"main":[[{"node":"Read Leads from Sheets","type":"main","index":0}]]},"When Schedule Reaches 6am":{"main":[[{"node":"Fetch Angi Data","type":"main","index":0}]]},"Fetch Domain Search Results":{"main":[[{"node":"Validate and Extract Domains","type":"main","index":0}]]},"Validate and Extract Domains":{"main":[[{"node":"If Domain is Valid","type":"main","index":0}]]},"Check Existing Lead Duplicates":{"main":[[{"node":"If Lead is New","type":"main","index":0}]]}}}