{"id":"a7ldLty8xYKwUCqw","meta":{"instanceId":"dd69efaf8212c74ad206700d104739d3329588a6f3f8381a46a481f34c9cc281","templateCredsSetupCompleted":true},"name":"Reverse ETL - Warehouse to SaaS Applications Sync","tags":[],"nodes":[{"id":"b89cff05-92e1-4589-87b2-4f1cac1a14c6","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-3488,-64],"parameters":{"width":680,"height":1200,"content":"## Reverse ETL: Warehouse to SaaS Applications\n\n### How it works\n\nContinuously pushes data from your warehouse (PostgreSQL) into SaaS tools so sales, marketing and support work with the same numbers as analytics.\n\n1. **Detect changes:** every row is hashed. Only rows whose hash differs from the last successful sync are sent, so unchanged data never costs an API call.\n2. **Map & deliver:** warehouse columns are mapped to each destination's fields (configurable JSON). HubSpot gets a batch upsert of contacts, Segment gets an identify batch (and forwards to your other tools).\n3. **Track state:** each row is saved as synced, failed (exponential backoff) or dead (attempts exhausted, or invalid email until the data changes).\n4. **Stay safe:** a run lock prevents overlapping runs, batches loop until the warehouse is drained, and Slack is told only when something needs attention.\n\nUpserts are idempotent, so retries never create duplicates.\n\n### Setup steps\n\n- Add Postgres credentials to all Postgres nodes, then run the manual setup once.\n- Add credentials: HubSpot via Header Auth (`Authorization: Bearer <token>`), Segment via Basic Auth (write key as username, empty password).\n- Create the custom HubSpot properties used in the mapping (for example lifetime_value, churn_risk).\n- Edit **Set Sync Config**: warehouse table, key and email columns, enabled destinations, the two field mappings, batch size, retries, Slack webhook. Defaults sync the demo table.\n- Activate the workflow. Run it any time with `POST /retl-sync-now`.\n\n### Layout\n\n1 Setup\n2-4 Config, lock, detect and deliver\n5-6 State, loop, alert"},"typeVersion":1},{"id":"37fbd3be-fd41-49c3-8485-8cd78cd16838","name":"Note: 1. One-time setup","type":"n8n-nodes-base.stickyNote","position":[-2720,-64],"parameters":{"color":7,"width":500,"height":552,"content":"## 1. One-time setup\n\nRun manually once. Creates the sync state, run log and lock tables, plus a small demo warehouse table (dw_customers_demo) so you can test the whole sync immediately."},"typeVersion":1},{"id":"101726d0-558d-4c9b-b551-956a8f267cfc","name":"Note: 2. Triggers, config & run lock","type":"n8n-nodes-base.stickyNote","position":[-2720,640],"parameters":{"color":7,"width":1580,"height":952,"content":"## 2. Triggers, config & run lock\n\nRuns every 10 minutes or on demand via `POST /retl-sync-now`. The config is validated, then a lock stops overlapping runs from sending the same rows twice."},"typeVersion":1},{"id":"56d7d7e0-8070-4347-967b-ab29e105c46d","name":"Note: 3. Detect changed records","type":"n8n-nodes-base.stickyNote","position":[-1104,640],"parameters":{"color":7,"width":770,"height":968,"content":"## 3. Detect changed records\n\nHashes every warehouse row and compares it with the last synced hash, so only new or changed rows are pushed. Failed rows wait for their retry time. No changes means the lock is released and the run ends."},"typeVersion":1},{"id":"3a4aa175-bf7a-4a3c-91c3-32f2c244df3f","name":"Note: 4. Deliver to SaaS destinations","type":"n8n-nodes-base.stickyNote","position":[-288,640],"parameters":{"color":7,"width":1040,"height":952,"content":"## 4. Deliver to SaaS destinations\n\nMaps warehouse columns to each destination's fields and sends one batch per destination: HubSpot (batch upsert contacts) and Segment (identify batch). Per-record errors are captured."},"typeVersion":1},{"id":"cad5f3d9-38d5-4ffa-aa58-792527185dd4","name":"Note: 5. Record state & loop","type":"n8n-nodes-base.stickyNote","position":[-288,1744],"parameters":{"color":7,"width":992,"height":744,"content":"## 5. Record state & loop\n\nMarks each row synced, failed (exponential backoff) or dead (attempts exhausted or invalid), logs the run, then loops back for the next batch until the warehouse is drained."},"typeVersion":1},{"id":"b5c7d5ae-09e3-4ba0-bdc2-8e4d5de551b3","name":"Note: 6. Release lock & alert","type":"n8n-nodes-base.stickyNote","position":[752,1744],"parameters":{"color":7,"width":548,"height":920,"content":"## 6. Release lock & alert\n\nReleases the run lock when finished and sends a Slack alert only when rows failed or died."},"typeVersion":1},{"id":"65815a2c-723b-4a1e-998e-566f9bc14b89","name":"Manual Trigger - Run Setup Once","type":"n8n-nodes-base.manualTrigger","position":[-2688,288],"parameters":{},"typeVersion":1},{"id":"d376844d-e458-418c-a914-6f5758be6a21","name":"Postgres - Create Reverse ETL Tables","type":"n8n-nodes-base.postgres","position":[-2416,288],"parameters":{"query":"CREATE TABLE IF NOT EXISTS retl_sync_state (\n  sync_name      TEXT        NOT NULL,\n  record_key     TEXT        NOT NULL,\n  row_hash       TEXT,\n  pending_hash   TEXT,\n  status         TEXT        NOT NULL DEFAULT 'synced',\n  attempts       INT         NOT NULL DEFAULT 0,\n  last_error     TEXT,\n  next_attempt_at TIMESTAMPTZ,\n  last_synced_at TIMESTAMPTZ,\n  PRIMARY KEY (sync_name, record_key)\n);\nCREATE TABLE IF NOT EXISTS retl_sync_runs (\n  id        BIGSERIAL PRIMARY KEY,\n  sync_name TEXT NOT NULL,\n  run_at    TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n  picked    INT, synced INT, failed INT, dead INT\n);\nCREATE TABLE IF NOT EXISTS retl_sync_locks (\n  sync_name    TEXT PRIMARY KEY,\n  locked_until TIMESTAMPTZ\n);\n\n-- Optional demo \"warehouse\" table to try the sync end to end\nCREATE TABLE IF NOT EXISTS dw_customers_demo (\n  id             INT PRIMARY KEY,\n  email          TEXT,\n  first_name     TEXT,\n  last_name      TEXT,\n  company        TEXT,\n  lifetime_value NUMERIC,\n  churn_risk     TEXT,\n  updated_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()\n);\nINSERT INTO dw_customers_demo (id, email, first_name, last_name, company, lifetime_value, churn_risk)\nSELECT g, 'customer' || g || '@example.com', 'First' || g, 'Last' || g, 'Company ' || (g % 5),\n       round((random() * 5000)::numeric, 2), (ARRAY['low', 'medium', 'high'])[1 + (g % 3)]\nFROM generate_series(1, 25) g\nWHERE NOT EXISTS (SELECT 1 FROM dw_customers_demo);\nSELECT 'retl_ready' AS status;","options":{},"operation":"executeQuery"},"typeVersion":2.5,"alwaysOutputData":true},{"id":"0f5029ca-e0d5-44e9-8356-efc6de5c796c","name":"Schedule Trigger - Every 10 Minutes","type":"n8n-nodes-base.scheduleTrigger","position":[-2688,976],"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":10}]}},"typeVersion":1.2},{"id":"3fce9937-82e9-43cb-9007-5a230afb025e","name":"Webhook - Sync Now","type":"n8n-nodes-base.webhook","position":[-2688,1184],"webhookId":"2bb71010-8289-5310-977c-c6b3db3d2431","parameters":{"path":"retl-sync-now","options":{},"httpMethod":"POST"},"typeVersion":2},{"id":"7139b501-9378-4293-bd6a-1b466628a9b0","name":"Set Sync Config","type":"n8n-nodes-base.set","position":[-2416,1088],"parameters":{"options":{},"assignments":{"assignments":[{"id":"6e2f2807-7445-54ca-98ba-9bee66bdeaa6","name":"syncName","type":"string","value":"customers_to_saas"},{"id":"ef7a3de5-d36e-5971-b61b-b9c029e675a7","name":"warehouseRelation","type":"string","value":"dw_customers_demo"},{"id":"ec2477c3-7db8-5983-9bd9-cb57af8623de","name":"pkColumn","type":"string","value":"id"},{"id":"42e89249-34c5-5d16-af18-9d917e57a008","name":"emailColumn","type":"string","value":"email"},{"id":"818e679f-+1234567890-b455-4faf2310e0e7","name":"ignoreColumns","type":"string","value":"updated_at"},{"id":"a0b671a2-d811-5cec-b006-14bfecd57be4","name":"enabledDestinations","type":"string","value":"hubspot,segment"},{"id":"fa925fc7-c707-5993-bd6f-f1bccd4af3fb","name":"hubspotMapping","type":"string","value":"{\"firstname\":\"first_name\",\"lastname\":\"last_name\",\"company\":\"company\",\"lifetime_value\":\"lifetime_value\",\"churn_risk\":\"churn_risk\"}"},{"id":"b85f2046-002d-5edf-a98c-53124d199abd","name":"segmentTraits","type":"string","value":"{\"firstName\":\"first_name\",\"lastName\":\"last_name\",\"company\":\"company\",\"lifetimeValue\":\"lifetime_value\",\"churnRisk\":\"churn_risk\"}"},{"id":"341ddcc9-c7bd-5e46-b0cd-1f63cf863c0a","name":"batchSize","type":"number","value":100},{"id":"1effd672-b592-59fc-864c-477bb37a0f82","name":"maxBatchesPerRun","type":"number","value":20},{"id":"f0ed2447-0819-5807-a2e7-124e147f5b5d","name":"maxAttempts","type":"number","value":5},{"id":"f7000faa-b71d-5b0a-a1f8-aa5c4c0ebd49","name":"backoffBaseSeconds","type":"number","value":60},{"id":"fc00c361-f7eb-58ae-ac32-7a9734694a5f","name":"backoffMaxSeconds","type":"number","value":3600},{"id":"b07e51c3-0df5-5b71-8619-33e0e4ce9274","name":"slackWebhookUrl","type":"string","value":"https://hooks.slack.com/services/REPLACE/ME/NOW"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"87052bd7-5370-4895-8a45-35b850c96f72","name":"Code - Validate Config & Build Queries","type":"n8n-nodes-base.code","position":[-2144,1088],"parameters":{"jsCode":"const cfg = $('Set Sync Config').first().json;\nconst ID = /^[a-z_][a-z0-9_]{0,62}$/;\nconst list = s => String(s || '').split(',').map(x => x.trim()).filter(Boolean);\nconst errors = [];\n\nconst parts = String(cfg.warehouseRelation).split('.');\nif (parts.length > 2 || !parts.every(p => ID.test(p))) errors.push('warehouseRelation must be \"table\" or \"schema.table\"');\nfor (const [k, v] of [['pkColumn', cfg.pkColumn], ['emailColumn', cfg.emailColumn]]) if (!ID.test(String(v))) errors.push('invalid ' + k);\nconst ignore = list(cfg.ignoreColumns);\nignore.forEach(c => { if (!ID.test(c)) errors.push('invalid ignore column: ' + c); });\n\n// Destination mappings: { destinationField: warehouseColumn }\nconst parseMap = (name, s) => {\n  let o; try { o = JSON.parse(s); } catch (e) { errors.push(name + ' is not valid JSON'); return {}; }\n  if (!o || typeof o !== 'object' || Array.isArray(o)) { errors.push(name + ' must be a JSON object'); return {}; }\n  for (const [k, c] of Object.entries(o)) if (!/^[A-Za-z0-9_]{1,64}$/.test(k) || !ID.test(String(c))) errors.push(name + ' has an invalid entry: ' + k);\n  return o;\n};\nconst hubspotMapping = parseMap('hubspotMapping', cfg.hubspotMapping);\nconst segmentTraits = parseMap('segmentTraits', cfg.segmentTraits);\nconst destinations = list(cfg.enabledDestinations).map(d => d.toLowerCase());\nif (!destinations.length || !destinations.every(d => ['hubspot', 'segment'].includes(d))) errors.push('enabledDestinations must be a list of: hubspot, segment');\nif (errors.length) return [{ json: { valid: false, alertText: ':x: Reverse ETL ' + cfg.syncName + ': invalid configuration: ' + errors.join('; ') } }];\n\nconst q = id => '\"' + id + '\"';\nconst rel = parts.map(q).join('.');\nconst ign = ignore.length ? 'ARRAY[' + ignore.map(c => \"'\" + c + \"'\").join(',') + ']::text[]' : \"'{}'::text[]\";\n// Rows whose content hash differs from the last successfully synced hash. A failed hash waits for its backoff, a dead one is skipped until the data changes.\nconst detectSql = 'SELECT h.record_key, h.record, h.row_hash, COALESCE(s.attempts, 0)::int AS attempts, s.pending_hash FROM ' +\n  '(SELECT m.' + q(cfg.pkColumn) + '::text AS record_key, to_jsonb(m) AS record, md5((to_jsonb(m) - ' + ign + ')::text) AS row_hash FROM ' + rel + ' m) h ' +\n  'LEFT JOIN retl_sync_state s ON s.sync_name = $1::text AND s.record_key = h.record_key ' +\n  'WHERE h.row_hash IS DISTINCT FROM s.row_hash AND (s.record_key IS NULL OR s.pending_hash IS DISTINCT FROM h.row_hash OR (s.status = \\'failed\\' AND s.next_attempt_at <= NOW())) ' +\n  'ORDER BY h.record_key LIMIT $2::int';\nconst clamp = (x, lo, hi, d) => Math.min(hi, Math.max(lo, Math.floor(Number(x) || d)));\nreturn [{ json: { valid: true, syncName: String(cfg.syncName), destinations, emailColumn: String(cfg.emailColumn), hubspotMapping, segmentTraits, detectSql,\n  batchSize: clamp(cfg.batchSize, 1, 100, 100), maxBatches: clamp(cfg.maxBatchesPerRun, 1, 100, 20), maxAttempts: clamp(cfg.maxAttempts, 1, 20, 5),\n  backoffBase: clamp(cfg.backoffBaseSeconds, 1, 86400, 60), backoffMax: clamp(cfg.backoffMaxSeconds, 1, 604800, 3600) } }];"},"typeVersion":2},{"id":"c6934943-a874-47f8-95d0-1152939542e1","name":"Config Valid?","type":"n8n-nodes-base.if","position":[-1872,1088],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true"},"leftValue":"={{ $json.valid }}","rightValue":""}]}},"typeVersion":2.2},{"id":"de393e37-0111-4e79-953e-6870d4d40f9e","name":"HTTP - Slack Config Error Alert","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[-1872,1280],"parameters":{"url":"={{ $('Set Sync Config').first().json.slackWebhookUrl }}","method":"POST","options":{"timeout":15000},"jsonBody":"={{ JSON.stringify({ text: $json.alertText }) }}","sendBody":true,"specifyBody":"json"},"typeVersion":4.2},{"id":"6f889e8d-2511-48d6-a49b-0f85f1c765d5","name":"Postgres - Acquire Sync Lock","type":"n8n-nodes-base.postgres","position":[-1616,1088],"parameters":{"query":"INSERT INTO retl_sync_locks (sync_name, locked_until) VALUES ($1::text, NOW() + INTERVAL '15 minutes')\nON CONFLICT (sync_name) DO UPDATE SET locked_until = EXCLUDED.locked_until\nWHERE retl_sync_locks.locked_until IS NULL OR retl_sync_locks.locked_until < NOW()\nRETURNING sync_name;","options":{"queryReplacement":"={{ [ $('Code - Validate Config & Build Queries').first().json.syncName ] }}"},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"alwaysOutputData":true},{"id":"6d0fe2ba-1a6c-499c-9d5b-7d21ccbd3b3d","name":"Lock Acquired?","type":"n8n-nodes-base.if","position":[-1344,1088],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true"},"leftValue":"={{ $json.sync_name !== undefined }}","rightValue":""}]}},"typeVersion":2.2},{"id":"9752246a-82b9-4ef6-8934-ac0a48cad9e4","name":"Postgres - Detect Changed Records","type":"n8n-nodes-base.postgres","position":[-1072,1088],"parameters":{"query":"{{ $('Code - Validate Config & Build Queries').first().json.detectSql }}","options":{"queryReplacement":"={{ [ $('Code - Validate Config & Build Queries').first().json.syncName, $('Code - Validate Config & Build Queries').first().json.batchSize ] }}"},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"alwaysOutputData":true},{"id":"7560b290-66b4-4812-91d9-a4591dbd307f","name":"Changes To Push?","type":"n8n-nodes-base.if","position":[-800,1088],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true"},"leftValue":"={{ $json.record_key !== undefined }}","rightValue":""}]}},"typeVersion":2.2},{"id":"dc3f0772-6a7b-42f3-8262-728f8298f172","name":"Code - Plan Destination Requests","type":"n8n-nodes-base.code","position":[-528,1088],"parameters":{"jsCode":"const v = $('Code - Validate Config & Build Queries').first().json;\nconst parse = x => (typeof x === 'string' ? JSON.parse(x) : x) || {};\nconst rows = $input.all().map(i => i.json).map(r => {\n  const rec = parse(r.record);\n  const email = String(rec[v.emailColumn] == null ? '' : rec[v.emailColumn]).trim().toLowerCase();\n  return { record_key: String(r.record_key), row_hash: r.row_hash, attempts: Number(r.attempts) || 0, pending_hash: r.pending_hash || null, email, valid: /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email), rec };\n});\nconst meta = rows.map(({ rec, ...m }) => m);\nconst ok = rows.filter(r => r.valid);\nconst props = (map, rec) => {\n  const o = {};\n  for (const [field, col] of Object.entries(map)) {\n    const val = rec[col];\n    if (val !== null && val !== undefined) o[field] = typeof val === 'object' ? JSON.stringify(val) : val;\n  }\n  return o;\n};\nconst emails = {};\nok.forEach(r => { (emails[r.email] = emails[r.email] || []).push(r.record_key); });\nconst keys = ok.map(r => r.record_key);\nconst tasks = [];\n\nif (ok.length && v.destinations.includes('hubspot')) {\n  tasks.push({ destination: 'hubspot', keys, emails, records: meta, request: { url: 'https://api.hubapi.com/crm/v3/objects/contacts/batch/upsert',\n    body: { inputs: ok.map(r => ({ idProperty: 'email', id: r.email, properties: { email: r.email, ...props(v.hubspotMapping, r.rec) } })) } } });\n}\nif (ok.length && v.destinations.includes('segment')) {\n  const ts = new Date().toISOString();\n  tasks.push({ destination: 'segment', keys, emails, records: meta, request: { url: 'https://api.segment.io/v1/batch',\n    body: { batch: ok.map(r => ({ type: 'identify', userId: r.record_key, timestamp: ts, traits: { email: r.email, ...props(v.segmentTraits, r.rec) } })) } } });\n}\n// No deliverable record (for example all emails missing): still finalize the batch\nif (!tasks.length) tasks.push({ destination: 'none', keys: [], emails: {}, records: meta, request: null });\nreturn tasks.map(t => ({ json: t }));"},"typeVersion":2},{"id":"9e017363-5578-458b-896c-08622a5e91e5","name":"Postgres - Release Lock (No Changes)","type":"n8n-nodes-base.postgres","position":[-800,1376],"parameters":{"query":"UPDATE retl_sync_locks SET locked_until = NULL WHERE sync_name = $1::text RETURNING sync_name;","options":{"queryReplacement":"={{ [ $('Code - Validate Config & Build Queries').first().json.syncName ] }}"},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"alwaysOutputData":true},{"id":"b410b59b-fa99-460c-bcd4-15fa2cb99272","name":"Loop Over Destinations","type":"n8n-nodes-base.splitInBatches","position":[-256,1088],"parameters":{"options":{}},"typeVersion":3},{"id":"67c38368-a9f4-4975-842e-26b28fdf4bc5","name":"Switch - Route By Destination","type":"n8n-nodes-base.switch","position":[16,1184],"parameters":{"rules":{"values":[{"outputKey":"hubspot","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"8953ee81-8fd5-554e-97c9-ff3567deaaab","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.destination }}","rightValue":"hubspot"}]},"renameOutput":true},{"outputKey":"segment","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"fcfdf57c-7ebc-58c7-b474-ab9294c55740","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.destination }}","rightValue":"segment"}]},"renameOutput":true}]},"options":{"fallbackOutput":"extra","renameFallbackOutput":"none"}},"typeVersion":3.2},{"id":"663d307a-f490-4829-a6e9-4a7921789788","name":"HTTP - HubSpot Batch Upsert Contacts","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[288,976],"parameters":{"url":"={{ $json.request.url }}","method":"POST","options":{"timeout":60000,"response":{"response":{"neverError":true,"fullResponse":true}}},"jsonBody":"={{ JSON.stringify($json.request.body) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"typeVersion":4.2},{"id":"bc06d974-f9fe-4d5e-9c0b-f0ccb5b5aff3","name":"HTTP - Segment Identify Batch","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[288,1184],"parameters":{"url":"={{ $json.request.url }}","method":"POST","options":{"timeout":60000,"response":{"response":{"neverError":true,"fullResponse":true}}},"jsonBody":"={{ JSON.stringify($json.request.body) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpBasicAuth"},"typeVersion":4.2},{"id":"5d61f35f-af44-4dfc-9ba6-cc65b1d386e1","name":"NoOp - No Deliverable Records","type":"n8n-nodes-base.noOp","position":[288,1376],"parameters":{},"typeVersion":1},{"id":"47c18c60-48e8-48ae-a0eb-9e9c0968fafc","name":"Code - Record Destination Result","type":"n8n-nodes-base.code","position":[560,1184],"parameters":{"jsCode":"const t = $('Loop Over Destinations').first().json;\nconst r = $input.first().json || {};\nif (t.destination === 'none') return [{ json: { destination: 'none', results: [] } }];\n\nconst sc = Number(r.statusCode) || 0;\nlet body = r.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = {}; } }\nbody = body || {};\nconst failed = new Map();\nconst failAll = msg => t.keys.forEach(k => failed.set(k, msg));\n\nif (sc < 200 || sc >= 300) {\n  failAll(t.destination + ': ' + (sc ? 'HTTP ' + sc : String((r.error && r.error.message) || 'request failed')).slice(0, 150));\n} else if (t.destination === 'hubspot') {\n  // HubSpot answers 207 with an errors list when only some records were rejected\n  const errs = Array.isArray(body.errors) ? body.errors : [];\n  if (sc === 207 || errs.length) {\n    const ids = errs.flatMap(e => (e && e.context && e.context.ids) || []).map(x => String(x).toLowerCase());\n    const msg = 'hubspot: ' + String((errs[0] && errs[0].message) || 'record rejected').slice(0, 150);\n    if (ids.length) ids.forEach(id => (t.emails[id] || []).forEach(k => failed.set(k, msg)));\n    else failAll('hubspot: partial failure (HTTP ' + sc + ')');\n  }\n} else if (t.destination === 'segment' && body.success === false) {\n  failAll('segment: request rejected');\n}\nreturn [{ json: { destination: t.destination, results: t.keys.map(k => ({ record_key: k, ok: !failed.has(k), error: failed.get(k) || null })) } }];"},"typeVersion":2},{"id":"ec398ce6-8254-421e-b205-f37583ea3d91","name":"Code - Build State Updates","type":"n8n-nodes-base.code","position":[-256,2080],"parameters":{"jsCode":"const v = $('Code - Validate Config & Build Queries').first().json;\nconst records = $('Code - Plan Destination Requests').first().json.records;\nconst failedBy = new Map();\nfor (const d of $input.all().map(i => i.json)) for (const r of d.results || []) if (!r.ok && !failedBy.has(r.record_key)) failedBy.set(r.record_key, r.error);\n\nconst updates = records.map(rec => {\n  const base = { record_key: rec.record_key, row_hash: rec.row_hash };\n  if (!rec.valid) return { ...base, status: 'dead', attempts: rec.attempts + 1, error: 'missing or invalid email', delay: 0 };   // fixed only when the data changes\n  if (!failedBy.has(rec.record_key)) return { ...base, status: 'synced', attempts: 0, error: '', delay: 0 };\n  // Same failing data as last time: keep counting. Changed data: start over.\n  const attempts = (rec.pending_hash === rec.row_hash ? rec.attempts : 0) + 1;\n  const dead = attempts >= v.maxAttempts;\n  const delay = dead ? 0 : Math.round(Math.min(v.backoffMax, v.backoffBase * Math.pow(2, attempts - 1)) * (1 + Math.random() * 0.2));\n  return { ...base, status: dead ? 'dead' : 'failed', attempts, error: failedBy.get(rec.record_key), delay };\n});\nconst n = s => updates.filter(u => u.status === s).length;\nreturn [{ json: { updatesJson: JSON.stringify(updates), picked: updates.length, synced: n('synced'), failed: n('failed'), dead: n('dead'),\n  errorSample: [...new Set(updates.filter(u => u.error).map(u => u.error))].slice(0, 3) } }];"},"typeVersion":2},{"id":"e2ccaa48-5621-4eb6-b3b8-73d20a46d6b0","name":"Postgres - Save Sync State","type":"n8n-nodes-base.postgres","position":[16,2080],"parameters":{"query":"WITH up AS (\n  INSERT INTO retl_sync_state (sync_name, record_key, row_hash, pending_hash, status, attempts, last_error, next_attempt_at, last_synced_at)\n  SELECT $1::text, x.record_key,\n         CASE WHEN x.status = 'synced' THEN x.row_hash END,\n         CASE WHEN x.status = 'synced' THEN NULL ELSE x.row_hash END,\n         x.status, x.attempts, NULLIF(x.error, ''), NOW() + (x.delay * INTERVAL '1 second'),\n         CASE WHEN x.status = 'synced' THEN NOW() END\n  FROM jsonb_to_recordset($2::jsonb) AS x(record_key text, row_hash text, status text, attempts int, error text, delay int)\n  ON CONFLICT (sync_name, record_key) DO UPDATE SET\n    row_hash = CASE WHEN EXCLUDED.status = 'synced' THEN EXCLUDED.row_hash ELSE retl_sync_state.row_hash END,\n    pending_hash = EXCLUDED.pending_hash,\n    status = EXCLUDED.status,\n    attempts = EXCLUDED.attempts,\n    last_error = EXCLUDED.last_error,\n    next_attempt_at = EXCLUDED.next_attempt_at,\n    last_synced_at = CASE WHEN EXCLUDED.status = 'synced' THEN NOW() ELSE retl_sync_state.last_synced_at END\n  RETURNING status\n), run AS (\n  INSERT INTO retl_sync_runs (sync_name, picked, synced, failed, dead)\n  SELECT $1::text, COUNT(*)::int, (COUNT(*) FILTER (WHERE status = 'synced'))::int,\n         (COUNT(*) FILTER (WHERE status = 'failed'))::int, (COUNT(*) FILTER (WHERE status = 'dead'))::int FROM up\n  RETURNING id\n)\nSELECT (SELECT COUNT(*) FROM up WHERE status = 'synced')::int AS synced, (SELECT COUNT(*) FROM up WHERE status = 'failed')::int AS failed,\n       (SELECT COUNT(*) FROM up WHERE status = 'dead')::int AS dead;","options":{"queryReplacement":"={{ [ $('Code - Validate Config & Build Queries').first().json.syncName, $json.updatesJson ] }}"},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"alwaysOutputData":true},{"id":"ce02b6f4-a25a-405c-bcd3-39a6f02b6ec2","name":"Code - Page Summary","type":"n8n-nodes-base.code","position":[288,2080],"parameters":{"jsCode":"const v = $('Code - Validate Config & Build Queries').first().json;\nconst b = $('Code - Build State Updates').first().json;\nconst page = $runIndex + 1;\n// Another page only when this one was full and the per-run cap is not reached (failed rows wait for their backoff, so this always ends)\nconst more = b.picked >= v.batchSize && page < v.maxBatches;\nconst bad = b.failed + b.dead;\nconst alertText = ':warning: Reverse ETL ' + v.syncName + ' page ' + page + ': ' + b.synced + ' synced, ' + b.failed + ' will retry, ' + b.dead + ' dead (need a data fix or a manual look).' +\n  (b.errorSample.length ? '\\nErrors: ' + b.errorSample.join(' | ') : '');\nreturn [{ json: { more, page, picked: b.picked, synced: b.synced, failed: b.failed, dead: b.dead, alertNeeded: bad > 0, alertText } }];"},"typeVersion":2},{"id":"425c8639-7daf-4c65-aee8-879b7e133724","name":"More Changes To Push?","type":"n8n-nodes-base.if","position":[560,2080],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true"},"leftValue":"={{ $json.more }}","rightValue":""}]}},"typeVersion":2.2},{"id":"af42513e-113b-4566-baf4-a0de71880db0","name":"Alert Needed?","type":"n8n-nodes-base.if","position":[560,2288],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true"},"leftValue":"={{ $json.alertNeeded }}","rightValue":""}]}},"typeVersion":2.2},{"id":"ad8f512c-9d49-47fd-83d2-bca27da26729","name":"Postgres - Release Lock (Run Complete)","type":"n8n-nodes-base.postgres","position":[832,2080],"parameters":{"query":"UPDATE retl_sync_locks SET locked_until = NULL WHERE sync_name = $1::text RETURNING sync_name;","options":{"queryReplacement":"={{ [ $('Code - Validate Config & Build Queries').first().json.syncName ] }}"},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"alwaysOutputData":true},{"id":"f3dd818e-6611-4f4e-a8b6-8766abcebe5d","name":"HTTP - Slack Sync Alert","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[1104,2288],"parameters":{"url":"={{ $('Set Sync Config').first().json.slackWebhookUrl }}","method":"POST","options":{"timeout":15000},"jsonBody":"={{ JSON.stringify({ text: $json.alertText }) }}","sendBody":true,"specifyBody":"json"},"typeVersion":4.2},{"id":"ef17cca5-6309-4bab-99f9-e7b90b69dbba","name":"Wait For Data","type":"n8n-nodes-base.wait","position":[768,2288],"webhookId":"d2e97088-3b21-4929-9d05-90a4e00d154f","parameters":{},"typeVersion":1.1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":false,"executionOrder":"v1"},"versionId":"b5456fbe-95d0-4363-a8ee-a3729c29c988","nodeGroups":[],"connections":{"Alert Needed?":{"main":[[{"node":"Wait For Data","type":"main","index":0}]]},"Config Valid?":{"main":[[{"node":"Postgres - Acquire Sync Lock","type":"main","index":0}],[{"node":"HTTP - Slack Config Error Alert","type":"main","index":0}]]},"Wait For Data":{"main":[[{"node":"HTTP - Slack Sync Alert","type":"main","index":0}]]},"Lock Acquired?":{"main":[[{"node":"Postgres - Detect Changed Records","type":"main","index":0}]]},"Set Sync Config":{"main":[[{"node":"Code - Validate Config & Build Queries","type":"main","index":0}]]},"Changes To Push?":{"main":[[{"node":"Code - Plan Destination Requests","type":"main","index":0}],[{"node":"Postgres - Release Lock (No Changes)","type":"main","index":0}]]},"Webhook - Sync Now":{"main":[[{"node":"Set Sync Config","type":"main","index":0}]]},"Code - Page Summary":{"main":[[{"node":"More Changes To Push?","type":"main","index":0},{"node":"Alert Needed?","type":"main","index":0}]]},"More Changes To Push?":{"main":[[{"node":"Postgres - Detect Changed Records","type":"main","index":0}],[{"node":"Postgres - Release Lock (Run Complete)","type":"main","index":0}]]},"Loop Over Destinations":{"main":[[{"node":"Code - Build State Updates","type":"main","index":0}],[{"node":"Switch - Route By Destination","type":"main","index":0}]]},"Code - Build State Updates":{"main":[[{"node":"Postgres - Save Sync State","type":"main","index":0}]]},"Postgres - Save Sync State":{"main":[[{"node":"Code - Page Summary","type":"main","index":0}]]},"Postgres - Acquire Sync Lock":{"main":[[{"node":"Lock Acquired?","type":"main","index":0}]]},"HTTP - Segment Identify Batch":{"main":[[{"node":"Code - Record Destination Result","type":"main","index":0}]]},"NoOp - No Deliverable Records":{"main":[[{"node":"Code - Record Destination Result","type":"main","index":0}]]},"Switch - Route By Destination":{"main":[[{"node":"HTTP - HubSpot Batch Upsert Contacts","type":"main","index":0}],[{"node":"HTTP - Segment Identify Batch","type":"main","index":0}],[{"node":"NoOp - No Deliverable Records","type":"main","index":0}]]},"Manual Trigger - Run Setup Once":{"main":[[{"node":"Postgres - Create Reverse ETL Tables","type":"main","index":0}]]},"Code - Plan Destination Requests":{"main":[[{"node":"Loop Over Destinations","type":"main","index":0}]]},"Code - Record Destination Result":{"main":[[{"node":"Loop Over Destinations","type":"main","index":0}]]},"Postgres - Detect Changed Records":{"main":[[{"node":"Changes To Push?","type":"main","index":0}]]},"Schedule Trigger - Every 10 Minutes":{"main":[[{"node":"Set Sync Config","type":"main","index":0}]]},"HTTP - HubSpot Batch Upsert Contacts":{"main":[[{"node":"Code - Record Destination Result","type":"main","index":0}]]},"Code - Validate Config & Build Queries":{"main":[[{"node":"Config Valid?","type":"main","index":0}]]}}}