{"id":"jMwNKTVYNrRA8SJ7","meta":{"instanceId":"4ae85c0604cda80665a39ba5ac0cbd2a1a356e696900939a855fc13e7cb32e9f","templateCredsSetupCompleted":true},"name":"Analyze contracts from Google Drive with AI, log to Google Sheets and alert via Gmail","tags":[],"nodes":[{"id":"e5639f9f-40fc-41e8-b971-e0e43be54fd2","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-2848,-1440],"parameters":{"width":480,"height":896,"content":"## Analyze contracts from Google Drive with AI, log to Google Sheets and alert via Gmail\n\n### How it works\n\nThis workflow watches a Google Drive contracts folder for new PDF files, filters out non-PDFs, downloads each contract, and extracts its text. It prepares the contract content, routes it to the configured AI provider for structured analysis, normalizes the result, logs the findings to Google Sheets, and sends a Gmail alert when the contract is classified as high risk.\n\n### Setup steps\n\n- Connect Google Drive credentials and configure the trigger to watch the correct contracts folder.\n- Connect Google Sheets credentials and set the target spreadsheet ID and sheet tab name in the Configuration node.\n- Connect Gmail credentials and set the recipient address in the Configuration node's alertEmail field.\n- Configure the desired aiProvider value and add credentials for the selected AI service: OpenAI, Anthropic Claude, or Google Gemini.\n- Review the PDF text extraction and AI analysis prompts/schema to ensure they match the contract fields and risk criteria you need.\n\n### Customization\n\nYou can change the aiProvider setting to switch between OpenAI, Claude, and Gemini, adjust the extraction schema or risk scoring logic, and modify the Google Sheets columns or Gmail alert content."},"typeVersion":1},{"id":"37b485ec-d326-4f51-984f-5165a498fa74","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-2288,-1104],"parameters":{"color":7,"width":640,"height":320,"content":"## Watch and configure input\n\nStarts when files appear in the Google Drive contracts folder, keeps only PDF documents, and sets workflow configuration values such as AI provider, spreadsheet destination, tab name, and alert email."},"typeVersion":1},{"id":"0a029aae-ef1d-4232-9745-48e060b19176","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[-1520,-1104],"parameters":{"color":7,"width":640,"height":320,"content":"## Download and prepare PDF\n\nDownloads the contract PDF from Google Drive, extracts the document text, and formats or cleans the contract content so it can be sent to the AI analysis step."},"typeVersion":1},{"id":"a8d588b2-298f-40d9-a122-e2f3e5e2106d","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[-832,-1152],"parameters":{"color":7,"height":400,"content":"## Route AI provider\n\nUses the configured provider value to route the prepared contract text to one of the available AI analysis branches."},"typeVersion":1},{"id":"dc23ae0b-3ec9-4bfb-a2e2-43d729f1f492","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[-560,-1440],"parameters":{"color":7,"width":352,"height":496,"content":"## OpenAI contract analysis\n\nAnalyzes the contract with an OpenAI-backed information extractor when the OpenAI route is selected."},"typeVersion":1},{"id":"babe4588-d848-42f4-bf70-0f0d0b231d2b","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[-560,-912],"parameters":{"color":7,"width":352,"height":496,"content":"## Claude contract analysis\n\nAnalyzes the contract with an Anthropic Claude-backed information extractor when the Claude route is selected."},"typeVersion":1},{"id":"730ac0d8-e5c3-4d37-8fc5-639bf0a7811c","name":"Sticky Note6","type":"n8n-nodes-base.stickyNote","position":[-592,-384],"parameters":{"color":7,"width":352,"height":496,"content":"## Gemini contract analysis\n\nAnalyzes the contract with a Google Gemini-backed information extractor when the Gemini route is selected."},"typeVersion":1},{"id":"d0a55298-e01b-414f-9e4e-233997187fe5","name":"Sticky Note7","type":"n8n-nodes-base.stickyNote","position":[-160,-1184],"parameters":{"color":7,"width":912,"height":400,"content":"## Normalize log and alert\n\nCombines AI outputs into a consistent structure, appends the analysis to Google Sheets, checks whether the contract is high risk, and sends a Gmail alert when needed."},"typeVersion":1},{"id":"8306dcbd-b398-469f-9a34-5fd03931cba5","name":"When Contract Added to Drive","type":"n8n-nodes-base.googleDriveTrigger","position":[-2240,-944],"parameters":{"event":"fileCreated","options":{},"pollTimes":{"item":[{"mode":"everyMinute"}]},"triggerOn":"specificFolder","folderToWatch":{"__rl":true,"mode":"list","value":""}},"typeVersion":1},{"id":"ceab7abf-f684-4dd4-a6f2-c8a77c345fc3","name":"Filter PDF Contracts","type":"n8n-nodes-base.filter","position":[-2016,-944],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"9c277cf4-7e8b-4f36-86a4-27f622f55e24","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.mimeType }}","rightValue":"application/pdf"}]}},"typeVersion":2.2},{"id":"61d42d5b-ca46-4fe7-9912-0ae0a9626701","name":"Set Processing Parameters","type":"n8n-nodes-base.set","position":[-1792,-944],"parameters":{"options":{},"assignments":{"assignments":[{"id":"57bbd50b-0e07-4339-8bcd-43652d9be30e","name":"aiProvider","type":"string","value":"openai"},{"id":"8cac1738-a5a7-45e4-a351-facbbad5825f","name":"googleSheetId","type":"string","value":"YOUR_GOOGLE_SHEET_ID"},{"id":"fd382600-42f7-4388-a4ae-8728ca0dba3c","name":"sheetTabName","type":"string","value":"Contracts"},{"id":"3366920c-dd02-4324-88eb-dec64dc9bda5","name":"alertEmail","type":"string","value":"user@example.com"},{"id":"919ad356-3619-45ad-94d9-e6a8b456cb0b","name":"riskAlertThreshold","type":"number","value":70},{"id":"6e4ef89c-0730-45a7-8837-e219c7eb0110","name":"maxCharacters","type":"number","value":60000}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"5ef94352-0b51-43ae-9da2-f03e2378e122","name":"Download PDF from Drive","type":"n8n-nodes-base.googleDrive","position":[-1472,-944],"parameters":{"fileId":{"__rl":true,"mode":"id","value":"={{ $json.id }}"},"options":{},"operation":"download"},"typeVersion":3},{"id":"fa8fdb5c-e195-46ed-a307-5ffdc3a6a3d7","name":"Extract PDF Text","type":"n8n-nodes-base.extractFromFile","position":[-1248,-944],"parameters":{"options":{},"operation":"pdf"},"typeVersion":1},{"id":"a7acdc11-f5c9-407b-a5c1-5a360b905442","name":"Prepare Text for Analysis","type":"n8n-nodes-base.code","position":[-1040,-944],"parameters":{"mode":"runOnceForEachItem","jsCode":"const cfg = $('Set Processing Parameters').item.json;\nconst raw = String($json.text || '')\n  .replace(/[ \\t]{2,}/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nif (!raw) {\n  throw new Error(`No text found in \"${cfg.name}\". Scanned PDFs need OCR before analysis.`);\n}\n\nconst maxChars = Number(cfg.maxCharacters) || 60000;\n\nreturn {\n  json: {\n    fileId: cfg.id,\n    fileName: cfg.name,\n    fileUrl: cfg.webViewLink || '',\n    aiProvider: String(cfg.aiProvider || 'openai').toLowerCase().trim(),\n    contractText: raw.slice(0, maxChars),\n    truncated: raw.length > maxChars,\n    characterCount: raw.length,\n  },\n};"},"typeVersion":2},{"id":"7730880d-5543-46cc-b8ae-7128f496e330","name":"Route by AI Provider","type":"n8n-nodes-base.switch","position":[-768,-944],"parameters":{"mode":"expression","output":"={{ { openai: 0, anthropic: 1, gemini: 2 }[$json.aiProvider] ?? 0 }}","numberOutputs":3},"typeVersion":3.2},{"id":"4423eb64-c31b-46c0-b3a3-e21f25869fdd","name":"Normalize AI Analysis","type":"n8n-nodes-base.code","position":[-112,-944],"parameters":{"mode":"runOnceForEachItem","jsCode":"const src = $('Prepare Text for Analysis').item.json;\nconst cfg = $('Set Processing Parameters').item.json;\nconst a = $json.output || {};\nconst list = (v) => (Array.isArray(v) ? v : v ? [v] : []);\n\nconst score = Math.max(0, Math.min(100, Math.round(Number(a.riskScore) || 0)));\nconst level = score >= 70 ? 'High' : score >= 40 ? 'Medium' : 'Low';\nconst threshold = Number(cfg.riskAlertThreshold ?? 70);\n\nreturn {\n  json: {\n    analyzedAt: new Date().toISOString(),\n    fileName: src.fileName,\n    fileUrl: src.fileUrl,\n    contractTitle: a.contractTitle || src.fileName,\n    contractType: a.contractType || '',\n    parties: list(a.parties)\n      .map((p) => (typeof p === 'string' ? p : p.role ? `${p.name} (${p.role})` : p.name))\n      .join('; '),\n    effectiveDate: a.effectiveDate || '',\n    expirationDate: a.expirationDate || '',\n    autoRenewal: a.autoRenewal ? 'Yes' : 'No',\n    noticePeriodDays: Number(a.noticePeriodDays) || 0,\n    contractValue: a.totalValue ? `${a.currency || ''} ${a.totalValue}`.trim() : '',\n    paymentTerms: a.paymentTerms || '',\n    governingLaw: a.governingLaw || '',\n    liabilityCap: a.liabilityCap || '',\n    terminationClause: a.terminationClause || '',\n    keyObligations: list(a.keyObligations).map((o) => `- ${o}`).join('\\n'),\n    riskFlags: list(a.riskFlags)\n      .map((r) => `[${r.severity || 'n/a'}] ${r.clause || 'General'}: ${r.issue || ''}`)\n      .join('\\n'),\n    riskScore: score,\n    riskLevel: level,\n    summary: a.summary || '',\n    recommendedActions: list(a.recommendedActions).map((x) => `- ${x}`).join('\\n'),\n    aiProvider: src.aiProvider,\n    textTruncated: src.truncated ? 'Yes' : 'No',\n    sendAlert: score >= threshold,\n  },\n};"},"typeVersion":2},{"id":"f016a376-f264-4cf1-bb81-43c7dd9ea926","name":"OpenAI Contract Analysis","type":"@n8n/n8n-nodes-langchain.informationExtractor","position":[-512,-1280],"parameters":{"text":"=Contract file: {{ $json.fileName }}\n\n{{ $json.contractText }}","options":{"systemPromptTemplate":"You are an experienced contract analyst. Review the contract text and extract the requested fields. Only use information present in the text; leave a field empty when it is not stated and never invent dates, amounts or parties. Flag one-sided indemnities, unlimited or missing liability caps, auto-renewal with long notice periods, unilateral termination or price-change rights, broad IP assignment, missing data protection terms, exclusivity and non-compete clauses. Score overall risk from 0 to 100 for the party receiving this contract for review. This is not legal advice."},"schemaType":"manual","inputSchema":"{\n  \"type\": \"object\",\n  \"properties\": {\n    \"contractTitle\": {\n      \"type\": \"string\",\n      \"description\": \"Title or name of the agreement\"\n    },\n    \"contractType\": {\n      \"type\": \"string\",\n      \"description\": \"e.g. NDA, MSA, SOW, Lease, Employment, Vendor, Sales\"\n    },\n    \"parties\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"role\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"effectiveDate\": {\n      \"type\": \"string\",\n      \"description\": \"YYYY-MM-DD or empty if not stated\"\n    },\n    \"expirationDate\": {\n      \"type\": \"string\",\n      \"description\": \"YYYY-MM-DD or empty if not stated\"\n    },\n    \"autoRenewal\": {\n      \"type\": \"boolean\"\n    },\n    \"noticePeriodDays\": {\n      \"type\": \"number\",\n      \"description\": \"Days of notice needed to terminate or prevent renewal, 0 if not stated\"\n    },\n    \"totalValue\": {\n      \"type\": \"string\"\n    },\n    \"currency\": {\n      \"type\": \"string\"\n    },\n    \"paymentTerms\": {\n      \"type\": \"string\"\n    },\n    \"governingLaw\": {\n      \"type\": \"string\"\n    },\n    \"liabilityCap\": {\n      \"type\": \"string\"\n    },\n    \"terminationClause\": {\n      \"type\": \"string\",\n      \"description\": \"One-sentence summary\"\n    },\n    \"keyObligations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"riskFlags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"clause\": {\n            \"type\": \"string\"\n          },\n          \"issue\": {\n            \"type\": \"string\"\n          },\n          \"severity\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Low\",\n              \"Medium\",\n              \"High\"\n            ]\n          }\n        }\n      }\n    },\n    \"riskScore\": {\n      \"type\": \"number\",\n      \"description\": \"0 (no risk) to 100 (severe risk)\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"3-5 sentence plain-English summary\"\n    },\n    \"recommendedActions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"contractTitle\",\n    \"contractType\",\n    \"parties\",\n    \"riskFlags\",\n    \"riskScore\",\n    \"summary\"\n  ]\n}"},"typeVersion":1},{"id":"fb4913a1-2581-4b85-83c7-7fbfa26b6af5","name":"OpenAI GPT-4 Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[-448,-1088],"parameters":{"model":{"__rl":true,"mode":"list","value":"gpt-4o-mini","cachedResultName":"gpt-4o-mini"},"options":{"temperature":0.1}},"typeVersion":1.2},{"id":"56dda801-69b0-4fc9-9fa0-e99675c0d3a6","name":"Claude Contract Analysis","type":"@n8n/n8n-nodes-langchain.informationExtractor","position":[-512,-752],"parameters":{"text":"=Contract file: {{ $json.fileName }}\n\n{{ $json.contractText }}","options":{"systemPromptTemplate":"You are an experienced contract analyst. Review the contract text and extract the requested fields. Only use information present in the text; leave a field empty when it is not stated and never invent dates, amounts or parties. Flag one-sided indemnities, unlimited or missing liability caps, auto-renewal with long notice periods, unilateral termination or price-change rights, broad IP assignment, missing data protection terms, exclusivity and non-compete clauses. Score overall risk from 0 to 100 for the party receiving this contract for review. This is not legal advice."},"schemaType":"manual","inputSchema":"{\n  \"type\": \"object\",\n  \"properties\": {\n    \"contractTitle\": {\n      \"type\": \"string\",\n      \"description\": \"Title or name of the agreement\"\n    },\n    \"contractType\": {\n      \"type\": \"string\",\n      \"description\": \"e.g. NDA, MSA, SOW, Lease, Employment, Vendor, Sales\"\n    },\n    \"parties\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"role\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"effectiveDate\": {\n      \"type\": \"string\",\n      \"description\": \"YYYY-MM-DD or empty if not stated\"\n    },\n    \"expirationDate\": {\n      \"type\": \"string\",\n      \"description\": \"YYYY-MM-DD or empty if not stated\"\n    },\n    \"autoRenewal\": {\n      \"type\": \"boolean\"\n    },\n    \"noticePeriodDays\": {\n      \"type\": \"number\",\n      \"description\": \"Days of notice needed to terminate or prevent renewal, 0 if not stated\"\n    },\n    \"totalValue\": {\n      \"type\": \"string\"\n    },\n    \"currency\": {\n      \"type\": \"string\"\n    },\n    \"paymentTerms\": {\n      \"type\": \"string\"\n    },\n    \"governingLaw\": {\n      \"type\": \"string\"\n    },\n    \"liabilityCap\": {\n      \"type\": \"string\"\n    },\n    \"terminationClause\": {\n      \"type\": \"string\",\n      \"description\": \"One-sentence summary\"\n    },\n    \"keyObligations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"riskFlags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"clause\": {\n            \"type\": \"string\"\n          },\n          \"issue\": {\n            \"type\": \"string\"\n          },\n          \"severity\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Low\",\n              \"Medium\",\n              \"High\"\n            ]\n          }\n        }\n      }\n    },\n    \"riskScore\": {\n      \"type\": \"number\",\n      \"description\": \"0 (no risk) to 100 (severe risk)\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"3-5 sentence plain-English summary\"\n    },\n    \"recommendedActions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"contractTitle\",\n    \"contractType\",\n    \"parties\",\n    \"riskFlags\",\n    \"riskScore\",\n    \"summary\"\n  ]\n}"},"typeVersion":1},{"id":"d89f1a9f-c370-46b9-be7d-8e4396e57558","name":"Claude Sonnet Model","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","position":[-448,-368],"parameters":{"model":{"__rl":true,"mode":"id","value":"claude-sonnet-4-5"},"options":{"temperature":0.1}},"typeVersion":1.3},{"id":"9de3e44e-b4ce-44f2-ac71-e34697f3baa0","name":"Gemini Contract Analysis","type":"@n8n/n8n-nodes-langchain.informationExtractor","position":[-544,-224],"parameters":{"text":"=Contract file: {{ $json.fileName }}\n\n{{ $json.contractText }}","options":{"systemPromptTemplate":"You are an experienced contract analyst. Review the contract text and extract the requested fields. Only use information present in the text; leave a field empty when it is not stated and never invent dates, amounts or parties. Flag one-sided indemnities, unlimited or missing liability caps, auto-renewal with long notice periods, unilateral termination or price-change rights, broad IP assignment, missing data protection terms, exclusivity and non-compete clauses. Score overall risk from 0 to 100 for the party receiving this contract for review. This is not legal advice."},"schemaType":"manual","inputSchema":"{\n  \"type\": \"object\",\n  \"properties\": {\n    \"contractTitle\": {\n      \"type\": \"string\",\n      \"description\": \"Title or name of the agreement\"\n    },\n    \"contractType\": {\n      \"type\": \"string\",\n      \"description\": \"e.g. NDA, MSA, SOW, Lease, Employment, Vendor, Sales\"\n    },\n    \"parties\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"role\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"effectiveDate\": {\n      \"type\": \"string\",\n      \"description\": \"YYYY-MM-DD or empty if not stated\"\n    },\n    \"expirationDate\": {\n      \"type\": \"string\",\n      \"description\": \"YYYY-MM-DD or empty if not stated\"\n    },\n    \"autoRenewal\": {\n      \"type\": \"boolean\"\n    },\n    \"noticePeriodDays\": {\n      \"type\": \"number\",\n      \"description\": \"Days of notice needed to terminate or prevent renewal, 0 if not stated\"\n    },\n    \"totalValue\": {\n      \"type\": \"string\"\n    },\n    \"currency\": {\n      \"type\": \"string\"\n    },\n    \"paymentTerms\": {\n      \"type\": \"string\"\n    },\n    \"governingLaw\": {\n      \"type\": \"string\"\n    },\n    \"liabilityCap\": {\n      \"type\": \"string\"\n    },\n    \"terminationClause\": {\n      \"type\": \"string\",\n      \"description\": \"One-sentence summary\"\n    },\n    \"keyObligations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"riskFlags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"clause\": {\n            \"type\": \"string\"\n          },\n          \"issue\": {\n            \"type\": \"string\"\n          },\n          \"severity\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Low\",\n              \"Medium\",\n              \"High\"\n            ]\n          }\n        }\n      }\n    },\n    \"riskScore\": {\n      \"type\": \"number\",\n      \"description\": \"0 (no risk) to 100 (severe risk)\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"3-5 sentence plain-English summary\"\n    },\n    \"recommendedActions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"contractTitle\",\n    \"contractType\",\n    \"parties\",\n    \"riskFlags\",\n    \"riskScore\",\n    \"summary\"\n  ]\n}"},"typeVersion":1},{"id":"0ab20666-287b-4449-9f69-d045c257b058","name":"Gemini Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatGoogleGemini","position":[-512,320],"parameters":{"options":{"temperature":0.1}},"typeVersion":1},{"id":"de9da926-7869-458a-b66d-d95333aced30","name":"Append Analysis to Sheets","type":"n8n-nodes-base.googleSheets","position":[144,-944],"parameters":{"columns":{"value":{},"schema":[],"mappingMode":"autoMapInputData","matchingColumns":[]},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Set Processing Parameters').item.json.sheetTabName }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Set Processing Parameters').item.json.googleSheetId }}"}},"typeVersion":4.5},{"id":"f798cd1a-d7ec-4010-9d81-e1335886401b","name":"Check Risk Level","type":"n8n-nodes-base.if","position":[384,-944],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"c04bbc9b-e72e-486f-902f-8c8bdc414c41","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $('Normalize AI Analysis').item.json.sendAlert }}","rightValue":""}]}},"typeVersion":2.2},{"id":"a2b33841-f053-4220-a61b-45a3ddb4e112","name":"Send Risk Alert via Email","type":"n8n-nodes-base.gmail","position":[624,-1040],"webhookId":"4e1df900-bcb9-4b77-8339-98865b0b5fe2","parameters":{"sendTo":"={{ $('Set Processing Parameters').item.json.alertEmail }}","message":"=<h2>High-risk contract detected</h2>\n<p><b>{{ $('Normalize AI Analysis').item.json.contractTitle }}</b> ({{ $('Normalize AI Analysis').item.json.contractType }})<br>\nRisk score: <b>{{ $('Normalize AI Analysis').item.json.riskScore }}/100 ({{ $('Normalize AI Analysis').item.json.riskLevel }})</b></p>\n<p><b>Parties:</b> {{ $('Normalize AI Analysis').item.json.parties }}<br>\n<b>Term:</b> {{ $('Normalize AI Analysis').item.json.effectiveDate || 'n/a' }} to {{ $('Normalize AI Analysis').item.json.expirationDate || 'n/a' }} | Auto-renewal: {{ $('Normalize AI Analysis').item.json.autoRenewal }} | Notice: {{ $('Normalize AI Analysis').item.json.noticePeriodDays }} days</p>\n<h3>Summary</h3><p>{{ $('Normalize AI Analysis').item.json.summary }}</p>\n<h3>Risk flags</h3><p>{{ $('Normalize AI Analysis').item.json.riskFlags.replace(/\\n/g, '<br>') }}</p>\n<h3>Recommended actions</h3><p>{{ $('Normalize AI Analysis').item.json.recommendedActions.replace(/\\n/g, '<br>') }}</p>\n<p><a href=\"{{ $('Normalize AI Analysis').item.json.fileUrl }}\">Open contract in Google Drive</a></p>\n<p><i>AI-generated first-pass review. Not legal advice.</i></p>","options":{"appendAttribution":false},"subject":"=Contract risk alert: {{ $('Normalize AI Analysis').item.json.contractTitle }} ({{ $('Normalize AI Analysis').item.json.riskScore }}/100)"},"typeVersion":2.1}],"active":false,"pinData":{},"settings":{"executionOrder":"v1"},"versionId":"2e61f1c5-1db6-4b8a-bd74-96262b22d503","connections":{"Check Risk Level":{"main":[[{"node":"Send Risk Alert via Email","type":"main","index":0}]]},"Extract PDF Text":{"main":[[{"node":"Prepare Text for Analysis","type":"main","index":0}]]},"Gemini Chat Model":{"ai_languageModel":[[{"node":"Gemini Contract Analysis","type":"ai_languageModel","index":0}]]},"OpenAI GPT-4 Model":{"ai_languageModel":[[{"node":"OpenAI Contract Analysis","type":"ai_languageModel","index":0}]]},"Claude Sonnet Model":{"ai_languageModel":[[{"node":"Claude Contract Analysis","type":"ai_languageModel","index":0}]]},"Filter PDF Contracts":{"main":[[{"node":"Set Processing Parameters","type":"main","index":0}]]},"Route by AI Provider":{"main":[[{"node":"OpenAI Contract Analysis","type":"main","index":0}],[{"node":"Claude Contract Analysis","type":"main","index":0}],[{"node":"Gemini Contract Analysis","type":"main","index":0}]]},"Normalize AI Analysis":{"main":[[{"node":"Append Analysis to Sheets","type":"main","index":0}]]},"Download PDF from Drive":{"main":[[{"node":"Extract PDF Text","type":"main","index":0}]]},"Claude Contract Analysis":{"main":[[{"node":"Normalize AI Analysis","type":"main","index":0}]]},"Gemini Contract Analysis":{"main":[[{"node":"Normalize AI Analysis","type":"main","index":0}]]},"OpenAI Contract Analysis":{"main":[[{"node":"Normalize AI Analysis","type":"main","index":0}]]},"Append Analysis to Sheets":{"main":[[{"node":"Check Risk Level","type":"main","index":0}]]},"Prepare Text for Analysis":{"main":[[{"node":"Route by AI Provider","type":"main","index":0}]]},"Set Processing Parameters":{"main":[[{"node":"Download PDF from Drive","type":"main","index":0}]]},"When Contract Added to Drive":{"main":[[{"node":"Filter PDF Contracts","type":"main","index":0}]]}}}