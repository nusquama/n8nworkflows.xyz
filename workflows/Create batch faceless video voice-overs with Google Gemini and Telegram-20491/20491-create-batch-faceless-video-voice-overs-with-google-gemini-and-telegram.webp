appingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":true}},"typeVersion":1.2},{"id":"990d81c6-b32d-4661-91e3-2c7d88d80b0c","name":"Add Topics Form","type":"n8n-nodes-base.formTrigger","position":[0,1920],"webhookId":"5aeb467e-536e-42a8-af2a-113283f5cb5f","parameters":{"options":{"appendAttribution":false},"formTitle":"Add topics to your voice-over queue","formFields":{"values":[{"fieldType":"textarea","fieldLabel":"Topics (one per line)","requiredField":true},{"fieldType":"dropdown","fieldLabel":"Niche","fieldOptions":{"values":[{"option":"History stories"},{"option":"Science & how it works"},{"option":"Space & astronomy"},{"option":"Tech & AI explained"}]},"requiredField":true},{"fieldType":"dropdown","fieldLabel":"Format","fieldOptions":{"values":[{"option":"Short · 45–60 s, vertical"},{"option":"Explainer · 2–3 min"},{"option":"Story · 4–6 min"}]},"requiredField":true},{"fieldType":"dropdown","fieldLabel":"Language","fieldOptions":{"values":[{"option":"English"},{"option":"Spanish"}]},"requiredField":true},{"fieldType":"date","fieldLabel":"First publish date"},{"fieldType":"text","fieldLabel":"Notes for the writer (optional)"}]},"formDescription":"One topic per line. Each one becomes a row in your queue, one day apart, and the next run writes and voices it."},"typeVersion":2.3},{"id":"94f5377b-d478-4259-adf3-85de72687961","name":"Create Queue Table for Form","type":"n8n-nodes-base.dataTable","position":[320,1920],"parameters":{"columns":{"column":[{"name":"topic","type":"string"},{"name":"niche","type":"string"},{"name":"format","type":"string"},{"name":"language","type":"string"},{"name":"voice","type":"string"},{"name":"notes","type":"string"},{"name":"publish_date","type":"date"},{"name":"status","type":"string"},{"name":"title","type":"string"},{"name":"words","type":"number"},{"name":"duration_s","type":"number"},{"name":"engine","type":"string"},{"name":"checks","type":"string"},{"name":"listen_back","type":"number"},{"name":"facts_to_verify","type":"string"},{"name":"suno_prompt","type":"string"},{"name":"package_json","type":"string"},{"name":"audio_file_id","type":"string"},{"name":"updated","type":"date"}]},"options":{"createIfNotExists":true},"resource":"table","operation":"create","tableName":"vs_queue"},"executeOnce":true,"typeVersion":1},{"id":"4772d3d1-c952-41f7-84fe-7e661814ef32","name":"Split Topics into Rows","type":"n8n-nodes-base.code","position":[640,1920],"parameters":{"jsCode":"const K = {\"topics\":\"Topics (one per line)\",\"niche\":\"Niche\",\"format\":\"Format\",\"language\":\"Language\",\"date\":\"First publish date\",\"notes\":\"Notes for the writer (optional)\"};\nconst NICHES = {\"History stories\":\"history\",\"Science & how it works\":\"science\",\"Space & astronomy\":\"space\",\"Tech & AI explained\":\"tech\"};\nconst FORMATS = {\"Short · 45–60 s, vertical\":\"short\",\"Explainer · 2–3 min\":\"explainer\",\"Story · 4–6 min\":\"story\"};\nconst LANGS = {\"English\":\"en\",\"Spanish\":\"es\"};\nconst f = $('Add Topics Form').first().json;\nconst topics = [...new Set(String(f[K.topics] || '').split(/\\r?\\n/).map(x => x.replace(/^\\s*(?:[-*\\u2022]|\\d+[.)])\\s+/, '').trim()).filter(Boolean))].slice(0, 60);\nconst start = f[K.date] ? new Date(f[K.date]) : new Date();\nreturn topics.map((topic, i) => ({ json: { topic, niche: NICHES[f[K.niche]] || 'history', format: FORMATS[f[K.format]] || 'short', language: LANGS[f[K.language]] || 'en',\n  notes: String(f[K.notes] || '').trim(), publish_date: new Date(start.getTime() + i * 86400000).toISOString(), status: 'queued' } }));"},"typeVersion":2},{"id":"f8e5a6c2-2e85-4d6a-98c9-8132360c7680","name":"Insert Topics into Queue","type":"n8n-nodes-base.dataTable","position":[960,1920],"parameters":{"columns":{"value":{"niche":"={{ $json.niche }}","notes":"={{ $json.notes }}","topic":"={{ $json.topic }}","format":"={{ $json.format }}","status":"={{ $json.status }}","updated":"={{ $now.toISO() }}","language":"={{ $json.language }}","publish_date":"={{ $json.publish_date }}"},"schema":[{"id":"topic","type":"string","display":true,"required":false,"displayName":"topic","defaultMatch":false,"canBeUsedToMatch":true},{"id":"niche","type":"string","display":true,"required":false,"displayName":"niche","defaultMatch":false,"canBeUsedToMatch":true},{"id":"format","type":"string","display":true,"required":false,"displayName":"format","defaultMatch":false,"canBeUsedToMatch":true},{"id":"language","type":"string","display":true,"required":false,"displayName":"language","defaultMatch":false,"canBeUsedToMatch":true},{"id":"voice","type":"string","display":true,"required":false,"displayName":"voice","defaultMatch":false,"canBeUsedToMatch":true},{"id":"notes","type":"string","display":true,"required":false,"displayName":"notes","defaultMatch":false,"canBeUsedToMatch":true},{"id":"publish_date","type":"dateTime","display":true,"required":false,"displayName":"publish_date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"title","type":"string","display":true,"required":false,"displayName":"title","defaultMatch":false,"canBeUsedToMatch":true},{"id":"words","type":"number","display":true,"required":false,"displayName":"words","defaultMatch":false,"canBeUsedToMatch":true},{"id":"duration_s","type":"number","display":true,"required":false,"displayName":"duration_s","defaultMatch":false,"canBeUsedToMatch":true},{"id":"engine","type":"string","display":true,"required":false,"displayName":"engine","defaultMatch":false,"canBeUsedToMatch":true},{"id":"checks","type":"string","display":true,"required":false,"displayName":"checks","defaultMatch":false,"canBeUsedToMatch":true},{"id":"listen_back","type":"number","display":true,"required":false,"displayName":"listen_back","defaultMatch":false,"canBeUsedToMatch":true},{"id":"facts_to_verify","type":"string","display":true,"required":false,"displayName":"facts_to_verify","defaultMatch":false,"canBeUsedToMatch":true},{"id":"suno_prompt","type":"string","display":true,"required":false,"displayName":"suno_prompt","defaultMatch":false,"canBeUsedToMatch":true},{"id":"package_json","type":"string","display":true,"required":false,"displayName":"package_json","defaultMatch":false,"canBeUsedToMatch":true},{"id":"audio_file_id","type":"string","display":true,"required":false,"displayName":"audio_file_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"updated","type":"dateTime","display":true,"required":false,"displayName":"updated","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":true,"convertFieldsToString":false},"options":{},"resource":"row","operation":"insert","dataTableId":{"__rl":true,"mode":"name","value":"vs_queue"}},"typeVersion":1},{"id":"751e00ab-aecc-4794-ab61-ba8967ae4cbf","name":"When Called for Review","type":"n8n-nodes-base.executeWorkflowTrigger","position":[6400,480],"parameters":{"inputSource":"passthrough"},"typeVersion":1.1},{"id":"dece7d97-efb0-4b98-992e-355da9346f35","name":"Compose Review Message","type":"n8n-nodes-base.code","position":[6720,480],"parameters":{"mode":"runOnceForEachItem","jsCode":"const M = {\"head\":\"🎙️ {title}\",\"meta\":\"{format} · {niche} · voice {voice} · {seconds} s · {words} words\",\"checksOk\":\"✅ Script checks passed\",\"checksWarn\":\"⚠️ Check: {x}\",\"lbOk\":\"👂 Listen-back: {acc}% of the words match\",\"lbWarn\":\"👂 Listen-back: {acc}% match. Listen for: {missing}\",\"lbFailed\":\"👂 The listen-back check could not run this time.\",\"facts\":\"🔎 {n} facts to verify before you publish (in the script file)\",\"noVoice\":\"⚠️ No AI voice this time (Gemini TTS did not answer: {err}). The script and the Suno Speech block are in the file: ✅ keeps the script, 🔁 tries the voice again in the next run.\",\"question\":\"Use this voice-over? “{title}”\",\"approve\":\"✅ Use it\",\"decline\":\"🔁 Redo\",\"scriptCaption\":\"📝 Script with scene times, facts to verify and the Suno Speech block\",\"scriptH\":\"SCRIPT (scene · start-end · footage searches)\",\"factsH\":\"FACTS TO VERIFY BEFORE YOU PUBLISH\",\"pronH\":\"PRONUNCIATIONS\",\"descH\":\"DESCRIPTION\",\"thumbH\":\"THUMBNAIL TEXT\",\"sunoH\":\"SUNO SPEECH (advanced mode, ready to paste)\",\"redo\":\"redo requested on Telegram\"};\nconst NICHES = {\"history\":\"History stories\",\"science\":\"Science & how it works\",\"space\":\"Space & astronomy\",\"tech\":\"Tech & AI explained\"};\nconst FORMATS = {\"short\":\"Short\",\"explainer\":\"Explainer\",\"story\":\"Story\"};\nconst d = $json;\nconst p = d.package || {};\nconst lb = d.listen_back || p.listen_back || {};\nconst title = p.title || p.topic || '';\nconst facts = p.facts_to_verify || [];\nconst lbLine = lb.status === 'done' ? (lb.accuracy >= 95 ? M.lbOk : M.lbWarn).replace('{acc}', String(lb.accuracy).replace('.', M.decimal || '.')).replace('{missing}', (lb.missing || []).join(', ') || '-') : lb.status === 'failed' ? M.lbFailed : '';\nconst checks = p.checks?.passed ? M.checksOk : M.checksWarn.replace('{x}', (p.checks?.problems || []).join('; '));\nconst head = [M.head.replace('{title}', title), M.meta.replace('{format}', FORMATS[p.format] || p.format).replace('{niche}', NICHES[p.niche] || p.niche).replace('{voice}', p.voice)\n  .replace('{seconds}', p.audio ? Math.round(p.audio.seconds) : 0).replace('{words}', p.words)];\nconst caption = [...head, checks, lbLine, facts.length ? M.facts.replace('{n}', facts.length) : '', d.has_audio ? '' : M.noVoice.replace('{err}', p.voice_error || '-')].filter(Boolean).join('\\n').slice(0, 1000);\nconst mmss = s => Math.floor(s / 60) + ':' + String(Math.round(s % 60)).padStart(2, '0');\nconst scenes = (p.scenes || []).map(s => s.n + (s.start !== undefined ? ' · ' + mmss(s.start) + '-' + mmss(s.end) : '') + ' · ' + ((s.shots || []).join(' / ') || '-') + '\\n' + s.text + (s.on_screen ? '\\n[' + s.on_screen + ']' : ''));\nconst txt = [title, '', M.scriptH, '', ...scenes.flatMap(s => [s, '']), M.factsH, ...facts.map(f => '- ' + f), '', M.pronH, ...(p.pronunciations || []).map(x => '- ' + x.word + ': ' + x.say), '',\n  M.thumbH, p.thumbnail_text || '', '', M.descH, p.description || '', '', M.sunoH, '', p.suno_speech || ''].join('\\n');\nconst binary = { ...($input.item.binary || {}), script: { data: Buffer.from(txt).toString('base64'), mimeType: 'text/plain', fileName: (d.slug || 'voice-over') + '.txt', fileExtension: 'txt' } };\nreturn { json: { row_id: d.row_id, slug: d.slug, has_audio: !!d.has_audio, caption, question: M.question.replace('{title}', title) }, binary };"},"typeVersion":2},{"id":"4e375bc6-b53c-438a-b338-41a972d14bac","name":"Check Audio Exists","type":"n8n-nodes-base.if","position":[7040,480],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"9833cf46-2670-4f11-b997-960c852d940d","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.has_audio }}","rightValue":""}]}},"typeVersion":2.2},{"id":"1cb3e6e4-a42c-4064-ac7e-fac6fd201f90","name":"Send Voice-over to Telegram","type":"n8n-nodes-base.telegram","onError":"continueRegularOutput","position":[7360,360],"parameters":{"chatId":"={{ $('When Called for Review').first().json.review.telegram_chat_id }}","operation":"sendDocument","binaryData":true,"additionalFields":{"caption":"={{ $json.caption }}","appendAttribution":false},"binaryPropertyName":"data"},"typeVersion":1.2},{"id":"97806973-f135-4c3b-be85-00786758ee7e","name":"Notify Missing Voice","type":"n8n-nodes-base.telegram","onError":"continueRegularOutput","position":[7360,620],"parameters":{"text":"={{ $json.caption }}","chatId":"={{ $('When Called for Review').first().json.review.telegram_chat_id }}","additionalFields":{"appendAttribution":false,"disable_web_page_preview":true}},"typeVersio