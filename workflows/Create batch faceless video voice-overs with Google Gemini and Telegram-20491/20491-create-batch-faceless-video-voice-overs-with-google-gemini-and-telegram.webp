s].sort((p, q) => q.length - p.length)[0] || '';\r\n  }\r\n  if (!scenes.length) return { has_script: false, problems: [L.M.empty], cleaned };\r\n  // No tag inside the hook (first sentence) and at most one tag every 40 words.\r\n  const firstEnd = scenes[0].text.search(/[.!?](\\s|$)/);\r\n  const hookRaw = firstEnd > 0 ? scenes[0].text.slice(0, firstEnd + 1) : scenes[0].text;\r\n  if (/<[^>]+>/.test(hookRaw)) { scenes[0].text = scenes[0].text.replace(hookRaw, hookRaw.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim()); cleaned.push('tag in hook'); }\r\n  const total = scenes.reduce((n, x) => n + words(x.text), 0);\r\n  let allowed = Math.max(1, Math.floor(total / 40));\r\n  for (const x of scenes) x.text = x.text.replace(/<[^>]+>/g, m => (allowed-- > 0 ? m : (cleaned.push('extra tag'), ''))).replace(/\\s+/g, ' ').trim();\r\n  // A long hook is split at its last comma, semicolon or dash that leaves 4 to hookMax words in front: same words, a full stop\r\n  // instead of the comma (a stronger beat for the voice). Only punctuation changes.\r\n  let hook = (scenes[0].text.match(/^[^.!?]*[.!?]?/) || [''])[0].trim();\r\n  if (words(hook) > d.hookMax) {\r\n    const cuts = [...hook.matchAll(/(,|;| —| –| -)\\s+/g)].filter(m => { const n = words(hook.slice(0, m.index)); return n >= 4 && n <= d.hookMax && words(hook.slice(m.index)) >= 3; });\r\n    const cut = cuts[cuts.length - 1];\r\n    if (cut) {\r\n      const rest = hook.slice(cut.index + cut[0].length);\r\n      const fixed = hook.slice(0, cut.index) + '. ' + rest.charAt(0).toUpperCase() + rest.slice(1);\r\n      scenes[0].text = scenes[0].text.replace(hook, fixed);\r\n      cleaned.push('hook split');\r\n      hook = fixed.slice(0, cut.index + 1);\r\n    }\r\n  }\r\n  const narration = scenes.map(x => x.text).join('\\n\\n');\r\n  const plain = narration.replace(/<[^>]+>/g, ' ').replace(/[ \\t]+/g, ' ').replace(/ +\\n/g, '\\n').trim();\r\n  const lower = ' ' + plain.toLowerCase() + ' ';\r\n  const problems = [];\r\n  const [wMin, wMax] = d.words;\r\n  if (total < Math.round(wMin * 0.9) || total > Math.round(wMax * 1.1)) {\r\n    const goal = Math.round((wMin + wMax) / 2), dir = total < goal ? L.M.add : L.M.cut;\r\n    // Per scene, so the fix keeps the structure and adds (or trims) a sentence in each scene.\r\n    problems.push(L.M.words.replace('{n}', total).replace('{min}', wMin).replace('{max}', wMax).replace('{dir}', dir).replace('{d}', Math.abs(goal - total))\r\n      .replace('{ds}', Math.ceil(Math.abs(goal - total) / scenes.length)));\r\n  }\r\n  if (words(hook) > d.hookMax) problems.push(L.M.hook.replace('{n}', words(hook)).replace('{max}', d.hookMax));\r\n  if (scenes.length < d.scenes[0] || scenes.length > d.scenes[1]) problems.push(L.M.scenes.replace('{n}', scenes.length).replace('{min}', d.scenes[0]).replace('{max}', d.scenes[1]));\r\n  const cliches = L.cliches.filter(c => lower.includes(c.toLowerCase()));\r\n  if (cliches.length) problems.push(L.M.cliche.replace('{x}', cliches.join(', ')));\r\n  const facts = (Array.isArray(a.facts_to_verify) ? a.facts_to_verify : []).map(x => String(x).trim()).filter(Boolean);\r\n  if (!facts.length && d.niche !== 'calm') problems.push(L.M.facts);\r\n  if (scenes.some(x => !x.shots.length)) problems.push(L.M.visuals);\r\n  if (!String(a.title ?? '').trim()) problems.push(L.M.title);\r\n  if (!String(a.hook_payoff ?? '').trim()) problems.push(L.M.payoff);\r\n  const script = { title: String(a.title ?? '').trim(), thumbnail_text: String(a.thumbnail_text ?? '').trim(), scenes, hook_payoff: String(a.hook_payoff ?? '').trim(),\r\n    facts_to_verify: facts, pronunciations: (Array.isArray(a.pronunciations) ? a.pronunciations : []).filter(p => p && p.word).map(p => ({ word: String(p.word), say: String(p.say ?? '') })),\r\n    description: String(a.description ?? '').trim() };\r\n  return { has_script: true, script, narration, plain, word_count: total, hook, problems, cleaned };\r\n}\nfunction ttsBody(text, voice, style, model) {\r\n  return { model, input: [{ type: 'user_input', content: [{ type: 'text', text, annotations: [{ type: 'speech_metadata', style }] }] }],\r\n    response_format: { type: 'audio', mime_type: 'audio/wav', sample_rate: 24000 }, generation_config: { speech_config: [{ voice }] } };\r\n}\nfunction sunoBlock(c, d, S) {\r\n  const text = c.script.scenes.map(x => x.text.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim()).join('\\n\\n');\r\n  return [S.head, S.voice + ': ' + (d.gender === 'female' ? S.female : S.male) + ' · ' + S.style + ': ' + d.suno.voice + ' · ' + S.variation + ': ' + d.suno.variation,\r\n    S.music + ': ' + (d.music ? S.on + ' — ' + d.suno.music : S.off), '', S.script + ':', text].join('\\n');\r\n}\nfunction afterCheck(r, d, C, L) {\n  const base = { row_id: d.row_id, topic: d.topic, niche: d.niche, format: d.format, lang: d.lang, voice: d.voice, style: d.style, words_target: d.words };\n  if (!r.has_script) return { ...base, ...r };\n  const fix_prompt = L.fix.replace('{topic}', d.topic).replace('{script}', JSON.stringify(r.script)).replace('{problems}', r.problems.map(p => '- ' + p).join('\\n'));\n  return { ...base, ...r, fix_prompt, tts: ttsBody(r.narration, d.voice, d.style, C.tts_model || 'gemini-3.8-flash-tts'), suno_block: sunoBlock(r, d, L.S) };\n}\nconst L = {\"speaker\":\"narrator|voice ?over|vo\",\"direction\":\"pause|music|sfx|beat|sound\",\"M\":{\"empty\":\"the AI returned no script\",\"words\":\"{n} words, the format needs {min}-{max}: {dir} about {d} words, about {ds} in every scene (keep the same scenes)\",\"add\":\"add\",\"cut\":\"cut\",\"hook\":\"the hook (first sentence) has {n} words, max {max}\",\"scenes\":\"{n} scenes, the format needs {min}-{max}\",\"cliche\":\"remove these filler phrases: {x}\",\"facts\":\"list the checkable facts in facts_to_verify\",\"visuals\":\"every scene needs \\\"shots\\\": 2 stock-footage searches in English\",\"title\":\"add a title\",\"payoff\":\"add hook_payoff: the sentence that pays off the hook\"},\"fix\":\"Topic: {topic}\\n\\nYour previous script (JSON):\\n{script}\\n\\nFix ONLY these problems and return the full JSON again, same schema:\\n{problems}\\n\\nTo add words, add concrete details (names, places, causes, consequences, what it looked or sounded like), never filler. To shorten the hook, cut words or end the first sentence earlier.\",\"S\":{\"head\":\"Suno Speech · Advanced mode\",\"voice\":\"Voice\",\"female\":\"female\",\"male\":\"male\",\"style\":\"Speaking style\",\"variation\":\"Variation\",\"music\":\"Background music\",\"on\":\"on\",\"off\":\"off\",\"script\":\"Script\"},\"cliches\":[\"in this video\",\"in today's video\",\"let's dive in\",\"dive into\",\"buckle up\",\"without further ado\",\"smash that like\",\"you won't believe\",\"stay tuned\",\"hey guys\",\"welcome back\",\"let's get started\",\"mind-blowing\",\"game-changer\",\"delve\"],\"tags\":[\"<short pause>\",\"<long pause>\",\"<breath>\",\"<sigh>\",\"<chuckle>\",\"<gasp>\"]};\nconst C = $('Set Channel Settings').first().json;\nconst d = $('Build Voice Direction Prompt').item.json;\nconst prev = $('Check Script Quality').item.json;\n// Straight from the check (nothing to fix): it goes on as it is.\nif ($json.has_script !== undefined) return { json: { ...$json, first_try_ok: true } };\n// After the fix: keep whichever version has fewer problems (if the AI did not answer, the first one).\nconst r = checkScript(readGeminiJson($json), d, L);\nconst better = r.has_script && r.problems.length < prev.problems.length;\nconst out = better ? afterCheck(r, d, C, L) : prev;\nreturn { json: { ...out, first_try_ok: false, fix_tried: true, fixed: better && !r.problems.length, problems_before: prev.problems } };"},"typeVersion":2},{"id":"083f65ab-6698-4d85-997e-1e2c48e0c18b","name":"Generate Voice with Gemini TTS","type":"n8n-nodes-base.httpRequest","onError":"continueErrorOutput","maxTries":2,"position":[4000,480],"parameters":{"url":"https://generativelanguage.googleapis.com/v1beta/interactions","method":"POST","options":{"timeout":600000},"jsonBody":"={{ JSON.stringify($json.tts) }}","sendBody":true,"specifyBody":"json","authentication":"predefinedCredentialType","nodeCredentialType":"googlePalmApi"},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"id":"c062ce33-d5dc-4f96-b755-b3e2c117d6f5","name":"Generate Voice with Backup TTS","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":2,"position":[4000,710],"parameters":{"url":"https://generativelanguage.googleapis.com/v1beta/interactions","method":"POST","options":{"timeout":600000},"jsonBody":"={{ JSON.stringify({ ...$('Pick Best Script Version').item.json.tts, model: $('Set Channel Settings').first().json.tts_backup_model }) }}","sendBody":true,"specifyBody":"json","authentication":"predefinedCredentialType","nodeCredentialType":"googlePalmApi"},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"id":"41b5d9e0-48bf-45f8-aeb4-8d79f82f9213","name":"Build Voice-over Package","type":"n8n-nodes-base.code","position":[4420,480],"parameters":{"mode":"runOnceForEachItem","jsCode":"function audioFrom(r) {\r\n  // tokens = audio tokens billed on the paid tier (the free tier costs nothing).\r\n  const step = (r?.steps || []).flatMap(s => s.content || []).find(c => c.type === 'audio' && c.data);\r\n  if (step) return { b64: step.data, model: r.model || '', tokens: r.usage?.total_output_tokens ?? null };\r\n  const part = (r?.candidates?.[0]?.content?.parts || []).find(p => p.inlineData?.data);\r\n  return part ? { b64: part.inlineData.data, model: r.modelVersion || '', tokens: r.usageMetadata?.candidatesTokenCount ?? null } : { b64: '', model: '', tokens: null };\r\n}\nfunction analyseWav(buf) {\r\n  if (buf.length < 44 || buf.toString('ascii', 0, 4) !== 'RIFF') return null;\r\n  let pos = 12, rate = 24000, channels = 1, bits = 16, start = -1, size = 0;\r\n  while (pos + 8 <= buf.length) {\r\n    const id = buf.toString('ascii', pos, pos + 4), len = buf.readUInt32LE(pos + 4);\r\n    if (id === 'fmt ') { channels = buf.readUInt16LE(pos + 10); rate = buf.readUInt32LE(pos + 12); bits = buf.readUInt16LE(pos + 22); }\r\n    if (id === 'data') { start = pos + 8; size = Math.min(len, buf.length - start); break; }\r\n    pos += 8 + len + (len % 2);\r\n  }\r\n  if (start < 0 || bits !== 16) return null;\r\n  const frame = channels * 2, samples = Math.floor(size / frame), seconds = samples / rate;\r\n  const win = Math.round(rate * 0.02), rms = [];\r\n  for (let i = 0; i + win <= samples; i += win) {\r\n    let sum = 0;\r\n    for (let j = i; j < i + win; j++) { const v = buf.readInt16LE(start + j * frame); sum += v * v; }\r\n    rms.push(Math.sqrt(sum / win));\r\n  }\r\n  const sorted = [...rms].sort((x, y) => x - y);\r\n  const loud = sorted[Math.floor(sorted.length * 0.9)] || 1;\r\n  const quiet = Math.max(150, loud * 0.06);\r\n  const pauses = [];\r\n  let run = -1;\r\n  for (let k = 0; k <= rms.length; k++) {\r\n    if (k < rms.length && rms[k] < quiet) { if (run < 0) run = k; continue; }\r\n    if (run >= 0 && (k - run) * 0.02 >= 0.18) pauses.push({ start: run * 0.02, end: k * 0.02 });\r\n    run = -1;\r\n  }\r\n  const lead = pauses.length && pauses[0].start === 0 ? pauses[0].end : 0;\r\n  const last = pauses[pauses.length - 1];\r\n  const tail = last && last.end >= seconds - 0.03 ? last.start : seconds;\r\n  return { seconds: Math.round(seconds * 100) / 100, rate, speech_start: lead, speech_end: tail, pauses: pauses.filter(p => p.start > 0 && p.end < tail) };\r\n}\nfunction timeScenes(scenes, a) {\r\n  const len = s => s.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().length + 1;\r\n  const total = scenes.reduce((n, x) => n + len(x.text), 0) || 1;\r\n  const span = a.speech_end - a.speech_start;\r\n  let acc = 0, prev = a.speech_start, snapped = 0;\r\n  const cuts = [];\r\n  for (let i = 0; i < scenes.length - 1; i++) {\r\n    acc += len(scenes[i].text);\r\n    const guess = a.speech_start + span * acc / total;\r\n    const near = a.pauses.filter(p => (p.start + p.end) / 2 > prev + 0.5 && Math.abs((p.start + p.end) / 2 - guess) <= 1.5)\r\n      .sort((p, q) => (Math.abs((p.start + p.end) / 2 - guess) - (p.end - p.start)) - (Math.abs((q.start + q.end) / 2 - guess) - (q.end - q.start)))[0];\r\n    const cut = near ? (near.start + near.end) / 2 : guess;\r\n    if (near) snapped++;\r\n    cuts.push(cut); prev = cut;\r\n  }\r\n  const r2 = x => Math.round(x * 100) / 100;\r\n  const bounds = [0, ...cuts, a.seconds];\r\n  return { scenes: scenes.map((x, i) => ({ n: i + 1, start: r2(bounds[i]), end: r2(bounds[i + 1]), ...x, say: x.text.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim() })),\r\n    boundaries: cuts.length, snapped };\r\n}\nfunction srt(timed) {\r\n  const t = s => { const ms = Math.round(s * 1000); const p = (n, w = 2) => String(n).padStart(w, '0');\r\n    return `${p(Math.floor(ms / 3600000))}:${p(Math.floor(ms / 60000) % 60)}:${p(Math.floor(ms / 1000) % 60)},${p(ms % 1000, 3)}`; };\r\n  const out = [];\r\n  for (const sc of timed) {\r\n    const words = sc.text.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().split(' ');\r\n    const lines = [];\r\n    for (const w of words) { const l = lines[lines.length - 1]; if (l && (l + ' ' + w).length <= 42) lines[lines.length - 1] = l + ' ' + w; else lines.push(w); }\r\n    const chars = lines.reduce((n, l) => n + l.length, 0) || 1;\r\n    let at = sc.start;\r\n    for (const l of lines) { const end = at + (sc.end - sc.start) * l.length / chars; out.push(`${out.length + 1}\\n${t(at)} --> ${t(end)}\\n${l}\\n`); at = end; }\r\n  }\r\n  return out.join('\\n');\r\n}\nconst s = $('Pick Best Script Version').item.json;\nconst { b64, model, tokens } = audioFrom($json);\nconst slug = (new Date().toISOString().slice(0, 10) + '-' + (s.script.title || s.topic)).toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 70);\nconst base = { ...s, tts: undefined, slug, engine: model || 'none' };\n// No audio (both TTS models failed): the script still goes to the desk, with the reason.\nif (!b64) return { json: { ...base, has_audio: false, voice_error: String($json.error?.message ?? $json.error ?? $json.message ?? 'no audio').slice(0, 200) } };\nconst a = analyseWav(Buffer.from(b64, 'base64'));\nif (!a) return { json: { ...base, has_audio: false, voice_error: 'unreadable audio' } };\nconst t = timeScenes(s.script.scenes, a);\nreturn { json: { ...base, has_audio: true, seconds: a.seconds, tokens, wpm: Math.round(s.word_count / Math.max(0.1, (a.speech_end - a.speech_start) / 60)), timed: t.scenes,\n  boundaries: t.boundaries, snapped: t.snapped, captions: srt(t.scenes) },\n  binary: { data: { data: b64, mimeType: 'audio/wav', fileName: slug + '.wav', fileExtension: 'wav' } } };"},"typeVersion":2},{"id":"235c306c-16b9-405c-b504-9caa536f199d","name":"Check Listen-back Enabled","type":"n8n-nodes-base.if","position":[4740,480],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"57abbb63-26c8-43cd-a00a-b38e871e3f06","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.has_audio }}","rightValue":""},{"id":"11c9a972-2c5b-4d3b-a29c-d54fe6445241","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $('Set Channel Settings').first().json.listen_back_check }}","rightValue":""}]}},"typeVersion":2.2},{"id":"1a8b4036-ec77-429b-89ae-2fd0d35a3f48","name":"Transcribe Voice with Gemini","type":"@n8n/n8n-nodes-langchain.googleGemini","onError":"continueRegularOutput","maxTries":3,"position":[5060,480],"parameters":{"text":"Transcribe this voice-over word for word, exactly as it is spoken. Write every number in words, the way it is said (for example: fifteen eighteen, two thousand). Return only the transcript.","modelId":{"__rl":true,"mode":"id","value":"models/gemini-3.1-flash-lite"},"options":{"maxOutputTokens":4096},"resource":"audio","simplify":true,"inputType":"binary","operation":"analyze","binaryPropertyName":"data"},"retryOnFail":true,"typeVersion":1,"waitBetweenTries":3000},{"id":"227f27ae-18ec-475b-b712-3175088d658f","name":"Compare Transcript with Script","type":"n8n-nodes-base.code","position":[5620,480],"parameters":{"mode":"runOnceForEachItem","jsCode":"function compareWords(script, heard) {\r\n  const norm = s => String(s).toLowerCase().replace(/<[^>]+>/g, ' ').normalize('NFD').replace(/[̀-ͯ]/g, '')\r\n    .replace(/[^a-z0-9' ]+/g, ' ').replace(/'/g, '').split(/\\s+/).filter(Boolean);\r\n  const a = norm(script), b = norm(heard);\r\n  if (!a.length || !b.length) return { accuracy: 0, missing: [], extra: [], words: a.length };\r\n  // Word-level edit distance with backtracking for the words that were skipped or added.\r\n  const n = a.length, m = b.length, D = Array.from({ length: n + 1 }, (_, i) => { const r = new Uint32Array(m + 1); r[0] = i; return r; });\r\n  for (let j = 0; j <= m; j++) D[0][j] = j;\r\n  for (let i = 1; i <= n; i++) for (let j = 1; j <= m; j++) D[i][j] = Math.min(D[i - 1][j] + 1, D[i][j - 1] + 1, D[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));\r\n  const missing = [], extra = [];\r\n  let i = n, j = m;\r\n  while (i > 0 || j > 0) {\r\n    if (i > 0 && j > 0 && D[i][j] === D[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1)) { if (a[i - 1] !== b[j - 1]) { missing.push(a[i - 1]); extra.push(b[j - 1]); } i--; j--; }\r\n    else if (i > 0 && D[i][j] === D[i - 1][j] + 1) { missing.push(a[i - 1]); i--; }\r\n    else { extra.push(b[j - 1]); j--; }\r\n  }\r\n  return { accuracy: Math.round(Math.max(0, 1 - D[n][m] / n) * 1000) / 10, missing: missing.reverse().slice(0, 12), extra: extra.reverse().slice(0, 12), words: n };\r\n}\nconst p = $('Build Voice-over Package').item;\nconst s = p.json;\n// Straight from «Listen back?» (no audio or check off) or from the transcription.\nconst direct = $json.slug !== undefined;\nconst heard = direct ? '' : String($json.content?.parts?.[0]?.text ?? $json.text ?? '');\nconst lb = !s.has_audio ? { status: 'no_audio' } : direct ? { status: 'off' } : !heard.trim() ? { status: 'failed' } : { status: 'done', ...compareWords(s.plain, heard) };\nconst sc = s.script;\nconst pkg = { id: s.row_id, title: sc.title, topic: s.topic, language: s.lang, niche: s.niche, format: s.format, voice: s.voice, style: s.style, engine: s.engine,\n  audio: s.has_audio ? { file: s.slug + '.wav', seconds: s.seconds, sample_rate: 24000, wpm: s.wpm, tokens: s.tokens } : null, voice_error: s.voice_error || null, words: s.word_count,\n  scenes: s.timed || sc.scenes.map((x, i) => ({ n: i + 1, ...x })), captions_srt: s.captions || '', thumbnail_text: sc.thumbnail_text, description: sc.description,\n  hook_payoff: sc.hook_payoff, facts_to_verify: sc.facts_to_verify, pronunciations: sc.pronunciations,\n  checks: { passed: !s.problems.length, problems: s.problems, fixed: !!s.fixed }, listen_back: lb, suno_speech: s.suno_block, created: new Date().toISOString() };\nconst package_json = JSON.stringify(pkg, null, 2);\nconst binary = { ...(p.binary || {}), package: { data: Buffer.from(package_json).toString('base64'), mimeType: 'application/json', fileName: s.slug + '.json', fileExtension: 'json' } };\nconst cfg = $('Set Channel Settings').first().json;\n// The review runs in its own execution (one per voice-over), where the settings node has not run: what it needs travels with the item.\nconst review = { telegram_chat_id: cfg.telegram_chat_id, approver_user_id: cfg.approver_user_id, wait_hours: cfg.wait_hours };\nreturn { json: { review, row_id: s.row_id, slug: s.slug, has_audio: s.has_audio, listen_back: lb, package: pkg, package_json }, binary };"},"typeVersion":2},{"id":"3ca1119d-a1e5-4c38-93a0-fb8c624920d4","name":"Save Results to Queue","type":"n8n-nodes-base.dataTable","onError":"continueRegularOutput","position":[5940,120],"parameters":{"columns":{"value":{"title":"={{ $json.package.title }}","voice":"={{ $json.package.voice }}","words":"={{ $json.package.words }}","checks":"={{ $json.package.checks.passed ? 'passed' : $json.package.checks.problems.join('; ') }}","engine":"={{ $json.package.engine }}","status":"={{ $json.has_audio ? 'review' : 'no_voice' }}","updated":"={{ $now.toISO() }}","duration_s":"={{ $json.package.audio ? $json.package.audio.seconds : 0 }}","listen_back":"={{ $json.listen_back.status === 'done' ? $json.listen_back.accuracy : null }}","suno_prompt":"={{ $json.package.suno_speech }}","package_json":"={{ $json.package_json }}","facts_to_verify":"={{ $json.package.facts_to_verify.join(' | ') }}"},"schema":[{"id":"topic","type":"string","display":true,"required":false,"displayName":"topic","defaultMatch":false,"canBeUsedToMatch":true},{"id":"niche","type":"string","display":true,"required":false,"displayName":"niche","defaultMatch":false,"canBeUsedToMatch":true},{"id":"format","type":"string","display":true,"required":false,"displayName":"format","defaultMatch":false,"canBeUsedToMatch":true},{"id":"language","type":"string","display":true,"required":false,"displayName":"language","defaultMatch":false,"canBeUsedToMatch":true},{"id":"voice","type":"string","display":true,"required":false,"displayName":"voice","defaultMatch":false,"canBeUsedToMatch":true},{"id":"notes","type":"string","display":true,"required":false,"displayName":"notes","defaultMatch":false,"canBeUsedToMatch":true},{"id":"publish_date","type":"dateTime","display":true,"required":false,"displayName":"publish_date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"title","type":"string","display":true,"required":false,"displayName":"title","defaultMatch":false,"canBeUsedToMatch":true},{"id":"words","type":"number","display":true,"required":false,"displayName":"words","defaultMatch":false,"canBeUsedToMatch":true},{"id":