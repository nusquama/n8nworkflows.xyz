{"id":"crm-lead-import-quali","meta":{},"name":"Validate and reconcile CRM lead CSV imports","tags":[],"nodes":[{"id":"crm-lead-import-quality-gate-upload-source-csv","name":"Upload source CSV","type":"n8n-nodes-base.formTrigger","position":[-720,0],"parameters":{"path":"crm-lead-import-quality-gate","options":{},"formTitle":"CRM lead import quality gate","formFields":{"values":[{"fieldType":"file","fieldLabel":"Lead CSV","requiredField":true}]},"responseMode":"lastNode"},"typeVersion":2.6},{"id":"crm-lead-import-quality-gate-extract-csv-records","name":"Extract CSV records","type":"n8n-nodes-base.extractFromFile","position":[-460,0],"parameters":{"options":{},"operation":"csv","binaryPropertyName":"data"},"typeVersion":1.1},{"id":"crm-lead-import-quality-gate-configure-lead-quality-rules","name":"Configure lead quality rules","type":"n8n-nodes-base.set","position":[-200,0],"parameters":{"mode":"raw","options":{},"jsonOutput":"{\n  \"requiredFields\": [\n    \"name\",\n    \"email\"\n  ],\n  \"emailField\": \"email\",\n  \"phoneField\": \"phone\",\n  \"duplicateKeys\": [\n    \"email\",\n    \"phone\"\n  ]\n}","includeOtherFields":true},"typeVersion":3.4},{"id":"crm-lead-import-quality-gate-normalize-lead-identity-fields","name":"Normalize lead identity fields","type":"n8n-nodes-base.code","position":[60,0],"parameters":{"jsCode":"const inputItems = $input.all();\nconst first = inputItems[0]?.json ?? {};\nconst sourceRecords = Array.isArray(first.records)\n  ? first.records\n  : inputItems.map((item) => item.json);\nconst records = sourceRecords.map((record, sourceIndex) => {\n  const rawPhone = String(record.phone ?? \"\").trim();\n  const digits = rawPhone.replace(/\\D/g, \"\");\n  const phone = rawPhone.startsWith(\"+\") && digits ? \"+\" + digits : digits;\n  return {\n    sourceIndex,\n    name: String(record.name ?? \"\").trim(),\n    email: String(record.email ?? \"\").trim().toLowerCase(),\n    phone,\n    company: String(record.company ?? \"\").trim(),\n  };\n});\nreturn [{ json: { ...first, records } }];"},"typeVersion":2},{"id":"crm-lead-import-quality-gate-validate-lead-contactability","name":"Validate lead contactability","type":"n8n-nodes-base.code","position":[320,0],"parameters":{"jsCode":"const item = $input.all()[0]?.json ?? {};\nconst requiredFields = Array.isArray(item.requiredFields) ? item.requiredFields : [\"name\", \"email\"];\nconst valid = [];\nconst rejected = [];\nfor (const record of item.records ?? []) {\n  const reasonCodes = [];\n  if (requiredFields.some((field) => !String(record[field] ?? \"\").trim())) {\n    reasonCodes.push(\"missing_required_field\");\n  }\n  if (record.email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(record.email)) {\n    reasonCodes.push(\"invalid_email\");\n  }\n  if (reasonCodes.length > 0) rejected.push({ ...record, reasonCodes });\n  else valid.push(record);\n}\nreturn [{ json: { ...item, records: valid, rejected } }];"},"typeVersion":2},{"id":"crm-lead-import-quality-gate-reconcile-duplicate-leads","name":"Reconcile duplicate leads","type":"n8n-nodes-base.code","position":[580,0],"parameters":{"jsCode":"const item = $input.all()[0]?.json ?? {};\nconst accepted = [];\nconst conflicts = [];\nconst groups = new Map();\nlet duplicates = 0;\nfor (const record of item.records ?? []) {\n  const key = record.email || record.phone || \"source:\" + record.sourceIndex;\n  if (!groups.has(key)) {\n    const canonical = { ...record };\n    groups.set(key, canonical);\n    accepted.push(canonical);\n    continue;\n  }\n  duplicates += 1;\n  const canonical = groups.get(key);\n  for (const field of [\"name\", \"email\", \"phone\", \"company\"]) {\n    const kept = String(canonical[field] ?? \"\");\n    const incoming = String(record[field] ?? \"\");\n    if (!kept && incoming) canonical[field] = record[field];\n    else if (kept && incoming && kept !== incoming) {\n      conflicts.push({\n        reason: \"field_conflict\",\n        key,\n        field,\n        kept,\n        discarded: incoming,\n        keptSourceIndex: canonical.sourceIndex,\n        discardedSourceIndex: record.sourceIndex,\n      });\n    }\n  }\n}\nconst rejected = item.rejected ?? [];\nconst summary = {\n  total: accepted.length + duplicates + rejected.length,\n  accepted: accepted.length,\n  rejected: rejected.length,\n  duplicates,\n  conflicts: conflicts.length,\n};\nconst status = rejected.length === 0 && conflicts.length === 0 ? \"ready\" : \"review_required\";\nreturn [{ json: { accepted, rejected, conflicts, summary, status } }];"},"typeVersion":2},{"id":"crm-lead-import-quality-gate-check-result-status","name":"Check result status","type":"n8n-nodes-base.if","position":[840,0],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"crm-lead-import-quality-gate-result-condition","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.status === 'ready' }}","rightValue":""}]}},"typeVersion":2.3},{"id":"crm-lead-import-quality-gate-package-import-ready-lead-batch","name":"Package import-ready lead batch","type":"n8n-nodes-base.code","position":[1100,0],"parameters":{"jsCode":"return $input.all().map((item) => ({ json: { ...item.json, outcome: 'ready' } }));"},"typeVersion":2},{"id":"crm-lead-import-quality-gate-package-lead-review-report","name":"Package lead review report","type":"n8n-nodes-base.code","position":[1360,0],"parameters":{"jsCode":"return $input.all().map((item) => ({ json: { ...item.json, outcome: 'review_required' } }));"},"typeVersion":2},{"id":"crm-lead-import-quality-gate-merge-result-route","name":"Merge result route","type":"n8n-nodes-base.merge","position":[1620,0],"parameters":{"mode":"append","options":{},"numberInputs":2},"typeVersion":3.2},{"id":"crm-lead-import-quality-gate-return-crm-lead-audit","name":"Return CRM lead audit","type":"n8n-nodes-base.code","position":[1880,0],"parameters":{"jsCode":"return $input.all();"},"typeVersion":2},{"id":"crm-lead-import-quality-gate-workflow-overview","name":"Workflow overview","type":"n8n-nodes-base.stickyNote","position":[-920,-700],"parameters":{"color":4,"width":620,"height":420,"content":"Use this workflow when event, partner, or legacy-system lead exports must be checked before anyone imports them into a CRM. It turns a raw CSV into one audit package containing accepted rows, rejected rows, duplicate counts, and source-attributed field conflicts.\n\n### How it works\n\nThe form accepts a CSV, the visible configuration declares required and identity fields, and three processing stages normalize contact data, validate contactability, and reconcile duplicates. Complementary empty fields are filled, but competing non-empty values are never silently overwritten.\n\n### Setup\n\nOpen Configure lead quality rules and match the field names to your export. Upload a representative file, review the rejected reason codes and conflicts, then use only the accepted collection for a downstream CRM import.\n\nThe workflow uses built-in credential-free nodes. Email checks validate format only, and phone cleanup does not verify carrier reachability."},"typeVersion":1},{"id":"crm-lead-import-quality-gate-prepare-and-validate-leads-section","name":"Prepare and validate leads section","type":"n8n-nodes-base.stickyNote","position":[-720,-230],"parameters":{"color":7,"width":1520,"height":180,"content":"## Prepare and validate leads\n\nUpload the CSV, configure field policy, normalize identity fields, and reject rows that cannot be contacted."},"typeVersion":1},{"id":"crm-lead-import-quality-gate-reconcile-and-review-section","name":"Reconcile and review section","type":"n8n-nodes-base.stickyNote","position":[840,-230],"parameters":{"color":7,"width":1520,"height":180,"content":"## Reconcile and review\n\nMerge complementary duplicates, preserve disagreements as conflicts, and return one explicit import decision."},"typeVersion":1}],"active":false,"pinData":{},"settings":{"executionOrder":"v1"},"versionId":"c05e9ee8-8b79-4a06-88b4-f84476a955dc","connections":{"Upload source CSV":{"main":[[{"node":"Extract CSV records","type":"main","index":0}]]},"Merge result route":{"main":[[{"node":"Return CRM lead audit","type":"main","index":0}]]},"Check result status":{"main":[[{"node":"Package import-ready lead batch","type":"main","index":0}],[{"node":"Package lead review report","type":"main","index":0}]]},"Extract CSV records":{"main":[[{"node":"Configure lead quality rules","type":"main","index":0}]]},"Reconcile duplicate leads":{"main":[[{"node":"Check result status","type":"main","index":0}]]},"Package lead review report":{"main":[[{"node":"Merge result route","type":"main","index":0}]]},"Configure lead quality rules":{"main":[[{"node":"Normalize lead identity fields","type":"main","index":0}]]},"Validate lead contactability":{"main":[[{"node":"Reconcile duplicate leads","type":"main","index":0}]]},"Normalize lead identity fields":{"main":[[{"node":"Validate lead contactability","type":"main","index":0}]]},"Package import-ready lead batch":{"main":[[{"node":"Merge result route","type":"main","index":0}]]}}}