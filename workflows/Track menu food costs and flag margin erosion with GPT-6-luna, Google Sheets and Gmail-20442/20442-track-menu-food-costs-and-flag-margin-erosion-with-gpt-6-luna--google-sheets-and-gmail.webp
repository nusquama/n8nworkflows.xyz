{"id":"1ICHwZEJqUJ1sVcu","meta":{"instanceId":"c2650793f644091dc80fb900fe63448ad1f4b774008de9608064d67294f8307c"},"name":"track menu food costs and flag margin erosion with AI","tags":[],"nodes":[{"id":"c09e05fa-ab13-46bf-818c-8b4bf221668a","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-880,-560],"parameters":{"width":480,"height":832,"content":"## track menu food costs and flag margin erosion with AI\n\n### How it works\n\nSmall restaurants run on thin margins and supplier prices change quietly. This workflow keeps every menu item's cost fresh so a price hike shows up as a warning, not a surprise at month end.\n\n1. A supplier price change is posted to the intake webhook, or the Prices sheet is updated directly.\n2. The daily sweep recomputes what each recipe costs to make, using the latest price for every ingredient.\n3. Any item above its target food cost triggers an alert email with the recipe, the cost, and the percentage.\n4. Every Monday an AI assistant reviews the week and emails one digest naming the biggest margin problems and suggesting menu price fixes.\n\n### Setup steps\n\n- Connect Google Sheets and Gmail.\n- Open the Menu Cost Tracker spreadsheet and replace the sample data in Prices, Recipes and Menu.\n- Point the intake webhook at your ordering form or price sheet.\n- Set the manager email on the email nodes and activate.\n\n### Customization\n\n- Change the target cost per menu item in the Menu tab.\n- Adjust sweep and digest times in the schedule triggers."},"typeVersion":1},{"id":"9f7616e2-5697-49a5-8c1a-bc6f8471da55","name":"Price updates","type":"n8n-nodes-base.stickyNote","position":[-16,-176],"parameters":{"color":7,"width":1332,"height":418,"content":"## 1. Price updates\n\nSupplier price changes arrive by webhook. Missing fields are rejected by email. Valid changes are logged to the Prices sheet and confirmed."},"typeVersion":1},{"id":"80c149da-8be3-4b41-8b84-c2fe46ce3b90","name":"Daily margin sweep","type":"n8n-nodes-base.stickyNote","position":[-16,304],"parameters":{"color":7,"width":2436,"height":386,"content":"## 2. Daily margin sweep\n\nEach morning the workflow reads prices, recipes and menu prices, recomputes every recipe cost, and emails the owner when an item passes its target food cost."},"typeVersion":1},{"id":"185c487b-a4e6-4f3e-8e42-3ed29c4b3de7","name":"Weekly menu digest","type":"n8n-nodes-base.stickyNote","position":[-16,768],"parameters":{"color":7,"width":2072,"height":514,"content":"## 3. Weekly menu digest\n\nEvery Monday an AI assistant reviews the week's costs and emails a practical digest with price recommendations."},"typeVersion":1},{"id":"ed205cc3-aa10-4739-b839-3e5c60ce8e47","name":"When Price Update Received","type":"n8n-nodes-base.webhook","position":[32,0],"webhookId":"dfd12d66-8d0e-4901-bb02-87a62b93a857","parameters":{"path":"menu-cost-intake-0926","options":{},"httpMethod":"POST"},"typeVersion":2},{"id":"49f70734-963e-4849-a81c-3dd3d1bedcd1","name":"Normalize Price Update","type":"n8n-nodes-base.set","position":[240,0],"parameters":{"options":{},"assignments":{"assignments":[{"id":"a0","name":"update_id","type":"string","value":"={{ 'PRC-' + $now.toFormat('yyyyLLdd-HHmmss') + '-' + String(Math.floor(Math.random() * 9000) + 1000) }}"},{"id":"a1","name":"update_received_at","type":"string","value":"={{ $now.toISO() }}"},{"id":"a2","name":"ingredient","type":"string","value":"={{ String(($json.body || {}).ingredient || '').trim() }}"},{"id":"a3","name":"unit_price","type":"string","value":"={{ String(($json.body || {}).unit_price || '').trim() }}"},{"id":"a4","name":"unit","type":"string","value":"={{ String(($json.body || {}).unit || 'kg').trim() }}"},{"id":"a5","name":"supplier","type":"string","value":"={{ String(($json.body || {}).supplier || '').trim() }}"},{"id":"a6","name":"submitted_by","type":"string","value":"={{ String(($json.body || {}).submitted_by || 'kitchen staff').trim() }}"},{"id":"a7","name":"owner_email","type":"string","value":"={{ String(($json.body || {}).owner_email || '').trim() }}"}]}},"typeVersion":3.4},{"id":"f6b3e0e9-fd92-4bce-aedb-3019052609af","name":"Validate Price Update","type":"n8n-nodes-base.if","position":[464,0],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"c1","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $json.ingredient }}","rightValue":""},{"id":"c2","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $json.unit_price }}","rightValue":""}]}},"typeVersion":2.3},{"id":"f8ffbfac-5144-4ab6-929c-dff6210270f6","name":"Log New Price","type":"n8n-nodes-base.googleSheets","position":[688,-32],"parameters":{"columns":{"value":{"unit":"={{ $json.unit }}","supplier":"={{ $json.supplier }}","update_id":"={{ $json.update_id }}","ingredient":"={{ $json.ingredient }}","price_date":"={{ $json.update_received_at }}","unit_price":"={{ $json.unit_price }}","submitted_by":"={{ $json.submitted_by }}"},"schema":[{"id":"ingredient","type":"string","display":true,"removed":false,"required":false,"displayName":"ingredient","defaultMatch":false,"canBeUsedToMatch":true},{"id":"unit_price","type":"string","display":true,"removed":false,"required":false,"displayName":"unit_price","defaultMatch":false,"canBeUsedToMatch":true},{"id":"unit","type":"string","display":true,"removed":false,"required":false,"displayName":"unit","defaultMatch":false,"canBeUsedToMatch":true},{"id":"price_date","type":"string","display":true,"removed":false,"required":false,"displayName":"price_date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"supplier","type":"string","display":true,"removed":false,"required":false,"displayName":"supplier","defaultMatch":false,"canBeUsedToMatch":true},{"id":"submitted_by","type":"string","display":true,"removed":false,"required":false,"displayName":"submitted_by","defaultMatch":false,"canBeUsedToMatch":true},{"id":"update_id","type":"string","display":true,"removed":false,"required":false,"displayName":"update_id","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[]},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Prices","cachedResultName":"Prices"},"documentId":{"__rl":true,"mode":"id","value":"1Q02KMyBo4_YNB3Zc4sjHgvXN8cDNwbSYn3LIVX4eLdc","cachedResultName":"Menu Cost Tracker 0926"}},"credentials":{"googleSheetsOAuth2Api":{"id":"CUYeeMWogKG05aan","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"42b30eb0-6489-499c-9ba5-3f9ec4011058","name":"Email Confirmation","type":"n8n-nodes-base.gmail","position":[912,-32],"webhookId":"9f5bc97e-16cd-4378-be7f-b214c52c830e","parameters":{"sendTo":"={{ $json.owner_email || 'user@example.com' }}","message":"={{ ['Price update recorded.', '', 'Ingredient: ' + $json.ingredient, 'New price: ' + $json.unit_price + ' per ' + $json.unit, 'Supplier: ' + ($json.supplier || 'not stated'), 'Updated by: ' + $json.submitted_by, 'Reference: ' + $json.update_id, '', 'The next margin sweep will use this price.'].join(String.fromCharCode(10)) }}","options":{},"subject":"={{ 'Price logged: ' + $json.ingredient + ' (' + $json.unit_price + ' per ' + $json.unit + ')' }}","emailType":"text"},"credentials":{"gmailOAuth2":{"id":"tzaBsDIL2rKaZdlq","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"db75221f-9a15-46b2-9376-ea408020b2db","name":"Email Reject Notice","type":"n8n-nodes-base.gmail","position":[1120,16],"webhookId":"c46a6d93-b6bd-4ff2-a6c8-113c885f6270","parameters":{"sendTo":"={{ $json.owner_email || 'user@example.com' }}","message":"={{ ['A price update was rejected because fields are missing.', '', 'Required fields: ingredient, unit_price.', 'Received: ' + JSON.stringify(($json.body || {}))].join(String.fromCharCode(10)) }}","options":{},"subject":"={{ 'Price update rejected: ' + ($json.ingredient || '(no ingredient)') }}","emailType":"text"},"credentials":{"gmailOAuth2":{"id":"tzaBsDIL2rKaZdlq","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"5b175662-a9fb-4c7d-b69b-88a0484797b0","name":"Daily Margin Sweep","type":"n8n-nodes-base.scheduleTrigger","position":[32,464],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 6 * * *"}]}},"typeVersion":1.2},{"id":"6daee3e2-31aa-474e-8797-5adc29eac625","name":"Read Prices","type":"n8n-nodes-base.googleSheets","position":[240,464],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Prices","cachedResultName":"Prices"},"documentId":{"__rl":true,"mode":"id","value":"1Q02KMyBo4_YNB3Zc4sjHgvXN8cDNwbSYn3LIVX4eLdc","cachedResultName":"Menu Cost Tracker 0926"}},"credentials":{"googleSheetsOAuth2Api":{"id":"CUYeeMWogKG05aan","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"d663d36d-91a6-4a75-a72c-e3dbd1650e91","name":"Collapse For Recipe Lookup","type":"n8n-nodes-base.code","position":[464,464],"parameters":{"jsCode":"return [{ json: { _collapsed: true } }];\n"},"typeVersion":2},{"id":"876b5b18-a41b-45d0-8500-be5f36fd23c9","name":"Read Recipes","type":"n8n-nodes-base.googleSheets","position":[688,464],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Recipes","cachedResultName":"Recipes"},"documentId":{"__rl":true,"mode":"id","value":"1Q02KMyBo4_YNB3Zc4sjHgvXN8cDNwbSYn3LIVX4eLdc","cachedResultName":"Menu Cost Tracker 0926"}},"credentials":{"googleSheetsOAuth2Api":{"id":"CUYeeMWogKG05aan","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"fe9e05e3-dcad-4d30-8529-733a8ff22da4","name":"Collapse For Menu Lookup","type":"n8n-nodes-base.code","position":[912,464],"parameters":{"jsCode":"return [{ json: { _collapsed: true } }];\n"},"typeVersion":2},{"id":"e6d99b5d-46f1-4d67-b74a-2d8249b618ed","name":"Read Menu","type":"n8n-nodes-base.googleSheets","position":[1120,464],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Menu","cachedResultName":"Menu"},"documentId":{"__rl":true,"mode":"id","value":"1Q02KMyBo4_YNB3Zc4sjHgvXN8cDNwbSYn3LIVX4eLdc","cachedResultName":"Menu Cost Tracker 0926"}},"credentials":{"googleSheetsOAuth2Api":{"id":"CUYeeMWogKG05aan","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"f403da16-bf71-4290-b315-01f13374e825","name":"Compute Recipe Costs","type":"n8n-nodes-base.code","position":[1344,464],"parameters":{"jsCode":"const prices = (() => { try { return $('Read Prices').all().map(r => r.json || {}); } catch (e) { return []; } })();\nconst recipes = (() => { try { return $('Read Recipes').all().map(r => r.json || {}); } catch (e) { return []; } })();\nconst menu = (() => { try { return $('Read Menu').all().map(r => r.json || {}); } catch (e) { return []; } })();\nconst priceMap = {};\nfor (const p of prices) {\n  const ing = String(p.ingredient || '').trim();\n  if (!ing) continue;\n  const d = String(p.price_date || '');\n  const t = d ? new Date(d).getTime() : 0;\n  const cur = priceMap[ing];\n  const val = parseFloat(p.unit_price);\n  if (!cur || (t >= cur.t && !isNaN(val))) {\n    priceMap[ing] = { t: cur ? Math.max(t, cur.t) : t, price: isNaN(val) ? (cur ? cur.price : 0) : val, unit: String(p.unit || 'kg') };\n  }\n}\nconst out = [];\nfor (const m of menu) {\n  const recipe = String(m.recipe || '').trim();\n  const sale = parseFloat(m.sale_price);\n  const target = parseFloat(m.target_cost_pct);\n  if (!recipe || isNaN(sale) || isNaN(target)) continue;\n  const items = recipes.filter(r => String(r.recipe || '').trim() === recipe);\n  if (items.length === 0) continue;\n  let cost = 0;\n  const missing = [];\n  for (const it of items) {\n    const ing = String(it.ingredient || '').trim();\n    const qty = parseFloat(it.qty_per_portion);\n    const pm = priceMap[ing];\n    if (!pm || isNaN(qty)) { missing.push(ing); continue; }\n    cost += qty * pm.price;\n  }\n  const pct = sale > 0 ? cost / sale : 0;\n  out.push({\n    recipe,\n    sale_price: sale,\n    cost_per_portion: Math.round(cost * 100) / 100,\n    cost_pct: Math.round(pct * 1000) / 1000,\n    target_cost_pct: target,\n    flag: pct > target,\n    missing_ingredients: missing.join('; '),\n    checked_at: $now.toISO()\n  });\n}\nreturn out.map(o => ({ json: o }));"},"typeVersion":2},{"id":"503c4c65-10b5-435a-b969-59f8c113170b","name":"If Margin Eroded","type":"n8n-nodes-base.if","position":[1568,464],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"c1","operator":{"type":"string","operation":"equals"},"leftValue":"={{ String($json.flag) }}","rightValue":"true"}]}},"typeVersion":2.3},{"id":"3b520734-aa9f-4ed2-b831-4207192e71e2","name":"Log Cost Alerts","type":"n8n-nodes-base.googleSheets","position":[1792,464],"parameters":{"columns":{"value":{"recipe":"={{ $json.recipe }}","status":"flagged","cost_pct":"={{ $json.cost_pct }}","alert_date":"={{ $json.checked_at }}","target_cost_pct":"={{ $json.target_cost_pct }}","cost_per_portion":"={{ $json.cost_per_portion }}"},"schema":[{"id":"alert_date","type":"string","display":true,"removed":false,"required":false,"displayName":"alert_date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"recipe","type":"string","display":true,"removed":false,"required":false,"displayName":"recipe","defaultMatch":false,"canBeUsedToMatch":true},{"id":"cost_per_portion","type":"string","display":true,"removed":false,"required":false,"displayName":"cost_per_portion","defaultMatch":false,"canBeUsedToMatch":true},{"id":"cost_pct","type":"string","display":true,"removed":false,"required":false,"displayName":"cost_pct","defaultMatch":false,"canBeUsedToMatch":true},{"id":"target_cost_pct","type":"string","display":true,"removed":false,"required":false,"displayName":"target_cost_pct","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"removed":false,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[]},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"CostAlerts","cachedResultName":"CostAlerts"},"documentId":{"__rl":true,"mode":"id","value":"1Q02KMyBo4_YNB3Zc4sjHgvXN8cDNwbSYn3LIVX4eLdc","cachedResultName":"Menu Cost Tracker 0926"}},"credentials":{"googleSheetsOAuth2Api":{"id":"CUYeeMWogKG05aan","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"7cafdb25-c522-4971-90f5-0756d78c4d1a","name":"Build Margin Alert","type":"n8n-nodes-base.code","position":[2000,464],"parameters":{"jsCode":"const flagged = (() => { try { return $('Compute Recipe Costs').all().map(r => r.json || {}).filter(r => r.flag === true); } catch (e) { return []; } })();\nconst pct = (x) => Math.round((x || 0) * 100) + '%';\nconst lines = ['Daily margin sweep: ' + flagged.length + ' menu item(s) over target food cost.', ''];\nfor (const f of flagged) {\n  lines.push('- ' + f.recipe + ': portion cost ' + f.cost_per_portion + ', food cost ' + pct(f.cost_pct) + ' vs target ' + pct(f.target_cost_pct) + (f.missing_ingredients ? ' (no price for: ' + f.missing_ingredients + ')' : ''));\n}\nlines.push('', 'Check the Prices tab, raise the menu price, or renegotiate with the supplier before these items eat the margin.', '', 'Logged to the CostAlerts sheet.');\nreturn [{ json: { alert_subject: 'Menu margin alert: ' + flagged.length + ' item(s) over target', alert_body: lines.join('\\n'), flagged_count: flagged.length } }];"},"typeVersion":2},{"id":"330a817b-4fe2-4eec-9a3a-5d2d4c21d363","name":"Email Margin Alert","type":"n8n-nodes-base.gmail","position":[2224,464],"webhookId":"36a2d768-66cf-4e7a-bd6a-6b88a39fcf82","parameters":{"sendTo":"user@example.com","message":"={{ $json.alert_body }}","options":{},"subject":"={{ $json.alert_subject }}","emailType":"text"},"credentials":{"gmailOAuth2":{"id":"tzaBsDIL2rKaZdlq","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"cb86e64c-efd9-4dd1-923c-fee169581c3e","name":"Weekly Menu Digest","type":"n8n-nodes-base.scheduleTrigger","position":[32,928],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 7 * * 1"}]}},"typeVersion":1.2},{"id":"fc2cca43-fb99-41c7-a6b4-b29e242d2ed2","name":"Read Prices Weekly","type":"n8n-nodes-base.googleSheets","position":[240,928],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Prices","cachedResultName":"Prices"},"documentId":{"__rl":true,"mode":"id","value":"1Q02KMyBo4_YNB3Zc4sjHgvXN8cDNwbSYn3LIVX4eLdc","cachedResultName":"Menu Cost Tracker 0926"}},"credentials":{"googleSheetsOAuth2Api":{"id":"CUYeeMWogKG05aan","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"44bae147-efd5-4f47-bf8b-c78f72c5fd11","name":"Collapse For Recipe Lookup Weekly","type":"n8n-nodes-base.code","position":[464,928],"parameters":{"jsCode":"return [{ json: { _collapsed: true } }];\n"},"typeVersion":2},{"id":"2798fcc4-34d3-45ad-a7a8-03d0eaac1e2c","name":"Read Recipes Weekly","type":"n8n-nodes-base.googleSheets","position":[688,928],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Recipes","cachedResultName":"Recipes"},"documentId":{"__rl":true,"mode":"id","value":"1Q02KMyBo4_YNB3Zc4sjHgvXN8cDNwbSYn3LIVX4eLdc","cachedResultName":"Menu Cost Tracker 0926"}},"credentials":{"googleSheetsOAuth2Api":{"id":"CUYeeMWogKG05aan","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"d01561b4-5ae6-4d7a-a4b4-634cb1e4368e","name":"Collapse For Menu Lookup Weekly","type":"n8n-nodes-base.code","position":[912,928],"parameters":{"jsCode":"return [{ json: { _collapsed: true } }];\n"},"typeVersion":2},{"id":"15077fb2-919f-4d68-8f79-b53b7efc9cb6","name":"Read Menu Weekly","type":"n8n-nodes-base.googleSheets","position":[1120,928],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Menu","cachedResultName":"Menu"},"documentId":{"__rl":true,"mode":"id","value":"1Q02KMyBo4_YNB3Zc4sjHgvXN8cDNwbSYn3LIVX4eLdc","cachedResultName":"Menu Cost Tracker 0926"}},"credentials":{"googleSheetsOAuth2Api":{"id":"CUYeeMWogKG05aan","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"2939191b-d8b1-494a-9c56-a4ad63ae3ab8","name":"Compute Week Stats","type":"n8n-nodes-base.code","position":[1344,928],"parameters":{"jsCode":"const prices = (() => { try { return $('Read Prices Weekly').all().map(r => r.json || {}); } catch (e) { return []; } })();\nconst recipes = (() => { try { return $('Read Recipes Weekly').all().map(r => r.json || {}); } catch (e) { return []; } })();\nconst menu = (() => { try { return $('Read Menu Weekly').all().map(r => r.json || {}); } catch (e) { return []; } })();\nconst priceMap = {};\nfor (const p of prices) {\n  const ing = String(p.ingredient || '').trim();\n  if (!ing) continue;\n  const d = String(p.price_date || '');\n  const t = d ? new Date(d).getTime() : 0;\n  const cur = priceMap[ing];\n  const val = parseFloat(p.unit_price);\n  if (!cur || (t >= cur.t && !isNaN(val))) {\n    priceMap[ing] = { t: cur ? Math.max(t, cur.t) : t, price: isNaN(val) ? (cur ? cur.price : 0) : val, unit: String(p.unit || 'kg') };\n  }\n}\nconst computed = [];\nfor (const m of menu) {\n  const recipe = String(m.recipe || '').trim();\n  const sale = parseFloat(m.sale_price);\n  const target = parseFloat(m.target_cost_pct);\n  if (!recipe || isNaN(sale) || isNaN(target)) continue;\n  const items = recipes.filter(r => String(r.recipe || '').trim() === recipe);\n  if (items.length === 0) continue;\n  let cost = 0;\n  const missing = [];\n  for (const it of items) {\n    const ing = String(it.ingredient || '').trim();\n    const qty = parseFloat(it.qty_per_portion);\n    const pm = priceMap[ing];\n    if (!pm || isNaN(qty)) { missing.push(ing); continue; }\n    cost += qty * pm.price;\n  }\n  const pct = sale > 0 ? cost / sale : 0;\n  computed.push({ recipe, sale_price: sale, cost_per_portion: Math.round(cost * 100) / 100, cost_pct: Math.round(pct * 1000) / 1000, target_cost_pct: target, flag: pct > target, missing_ingredients: missing.join('; ') });\n}\nconst roundPct = (x) => Math.round((x || 0) * 100) + '%';\nconst flagged = computed.filter(o => o.flag);\nconst flagged_recipes = flagged.map(o => o.recipe + ' (portion cost ' + o.cost_per_portion + ', food cost ' + roundPct(o.cost_pct) + ' vs target ' + roundPct(o.target_cost_pct) + ')');\nconst worst = flagged.slice().sort((a, b) => b.cost_pct - a.cost_pct).slice(0, 3).map(o => o.recipe);\nlet best = null;\nif (computed.length) {\n  computed.slice().sort((a, b) => a.cost_pct - b.cost_pct);\n  best = computed[0].recipe;\n}\nconst stats = {\n  week_ending: $now.toFormat('yyyy-MM-dd'),\n  menu_items: computed.length,\n  flagged_count: flagged_recipes.length,\n  flagged_recipes,\n  worst,\n  avg_cost_pct: computed.length ? Math.round(computed.reduce((s, o) => s + o.cost_pct, 0) / computed.length * 1000) / 10 : 0,\n  best_margin_item: best,\n  target_note: 'A menu price around portion cost divided by target cost brings the item back in line.'\n};\nreturn [{ json: { stats_json: JSON.stringify(stats) } }];"},"typeVersion":2},{"id":"f9fe711f-90c0-4ad3-bab4-8002c54c7a31","name":"AI Write Digest","type":"@n8n/n8n-nodes-langchain.agent","position":[1568,928],"parameters":{"text":"={{ 'Here are the menu cost stats for the week:\\n\\n' + $json.stats_json }}","options":{"systemMessage":"You are the general manager assistant for a small restaurant. The kitchen manager needs a short practical weekly email about menu food costs. Read the JSON stats: week_ending, menu_items, flagged_count, flagged_recipes, worst, avg_cost_pct, best_margin_item. Write a plain-text email body (no markdown, no code fences, no subject line) under 180 words that: explains in two or three lines how many menu items are over target and the average food cost; names the biggest problem items (cheapest to fix first) and for each one suggests a menu price roughly equal to portion cost divided by target cost; tells the owner what to check with suppliers. If nothing is flagged, say the menu is in good shape and name the item with the best margin."},"promptType":"define"},"typeVersion":3.1},{"id":"92d1aa0f-5263-4724-985e-3d26b1f9767e","name":"Weekly Digest Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[1568,1104],"parameters":{"model":{"__rl":true,"mode":"list","value":"gpt-6-luna","cachedResultName":"gpt-6-luna"},"options":{},"builtInTools":{}},"credentials":{"openAiApi":{"id":"JpMsLwC6dr7iGBJZ","name":"jonathan"}},"typeVersion":1.3},{"id":"97e5fa6d-1d32-4798-870b-c66efa9a1616","name":"Email Weekly Digest","type":"n8n-nodes-base.gmail","position":[1856,928],"webhookId":"3a50345e-0406-4ac3-968b-cf30c5840dbd","parameters":{"sendTo":"user@example.com","message":"={{ $json.output }}","options":{},"subject":"Weekly menu cost digest","emailType":"text"},"credentials":{"gmailOAuth2":{"id":"tzaBsDIL2rKaZdlq","name":"Gmail Fresh Sep05"}},"typeVersion":2.2}],"active":false,"pinData":{},"settings":{"timezone":"Asia/Pontianak","binaryMode":"separate","executionOrder":"v1"},"versionId":"25565470-319f-4dd5-bf1a-864110077793","nodeGroups":[],"connections":{"Read Menu":{"main":[[{"node":"Compute Recipe Costs","type":"main","index":0}],null]},"Read Prices":{"main":[[{"node":"Collapse For Recipe Lookup","type":"main","index":0}],null]},"Read Recipes":{"main":[[{"node":"Collapse For Menu Lookup","type":"main","index":0}],null]},"Log New Price":{"main":[[{"node":"Email Confirmation","type":"main","index":0}],null]},"AI Write Digest":{"main":[[{"node":"Email Weekly Digest","type":"main","index":0}],null]},"Log Cost Alerts":{"main":[[{"node":"Build Margin Alert","type":"main","index":0}],null]},"If Margin Eroded":{"main":[[{"node":"Log Cost Alerts","type":"main","index":0}],null]},"Read Menu Weekly":{"main":[[{"node":"Compute Week Stats","type":"main","index":0}],null]},"Build Margin Alert":{"main":[[{"node":"Email Margin Alert","type":"main","index":0}],null]},"Compute Week Stats":{"main":[[{"node":"AI Write Digest","type":"main","index":0}],null]},"Daily Margin Sweep":{"main":[[{"node":"Read Prices","type":"main","index":0}],null]},"Read Prices Weekly":{"main":[[{"node":"Collapse For Recipe Lookup Weekly","type":"main","index":0}],null]},"Weekly Menu Digest":{"main":[[{"node":"Read Prices Weekly","type":"main","index":0}],null]},"Read Recipes Weekly":{"main":[[{"node":"Collapse For Menu Lookup Weekly","type":"main","index":0}],null]},"Weekly Digest Model":{"ai_languageModel":[[{"node":"AI Write Digest","type":"ai_languageModel","index":0}]]},"Compute Recipe Costs":{"main":[[{"node":"If Margin Eroded","type":"main","index":0}],null]},"Validate Price Update":{"main":[[{"node":"Log New Price","type":"main","index":0}],[{"node":"Email Reject Notice","type":"main","index":0}]]},"Normalize Price Update":{"main":[[{"node":"Validate Price Update","type":"main","index":0}],null]},"Collapse For Menu Lookup":{"main":[[{"node":"Read Menu","type":"main","index":0}],null]},"Collapse For Recipe Lookup":{"main":[[{"node":"Read Recipes","type":"main","index":0}],null]},"When Price Update Received":{"main":[[{"node":"Normalize Price Update","type":"main","index":0}],null]},"Collapse For Menu Lookup Weekly":{"main":[[{"node":"Read Menu Weekly","type":"main","index":0}],null]},"Collapse For Recipe Lookup Weekly":{"main":[[{"node":"Read Recipes Weekly","type":"main","index":0}],null]}}}