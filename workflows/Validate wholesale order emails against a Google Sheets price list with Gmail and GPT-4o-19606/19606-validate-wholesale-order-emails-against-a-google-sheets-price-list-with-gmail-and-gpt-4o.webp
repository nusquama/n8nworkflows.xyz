{"id":"PN4e4czEMvZRrNwx","meta":{"instanceId":"c2650793f644091dc80fb900fe63448ad1f4b774008de9608064d67294f8307c"},"name":"validate wholesale order emails against a price list with AI","tags":[],"nodes":[{"id":"53a2b801-ed1c-473e-90dd-ebd6ea539886","name":"When Wholesale Order Email Arrives","type":"n8n-nodes-base.gmailTrigger","position":[-256,16],"parameters":{"simple":false,"filters":{"q":"is:unread subject:(wholesale order)"},"options":{},"pollTimes":{"item":[{"mode":"everyMinute"}]}},"credentials":{"gmailOAuth2":{"id":"credential-id","name":"Gmail Fresh Sep05"}},"typeVersion":1.4},{"id":"53c29b7d-da53-4c85-a53e-59cc77b3d595","name":"Normalize Order Email","type":"n8n-nodes-base.set","position":[-16,16],"parameters":{"options":{},"assignments":{"assignments":[{"id":"a0","name":"email_id","type":"string","value":"={{ $json.id }}"},{"id":"a1","name":"thread_id","type":"string","value":"={{ $json.threadId }}"},{"id":"a2","name":"from_email","type":"string","value":"={{ ($json.from && $json.from.value && $json.from.value[0] && $json.from.value[0].address) || '' }}"},{"id":"a3","name":"customer_name","type":"string","value":"={{ ($json.from && $json.from.value && $json.from.value[0] && ($json.from.value[0].name || $json.from.value[0].address)) || 'Customer' }}"},{"id":"a4","name":"subject","type":"string","value":"={{ $json.subject || '' }}"},{"id":"a5","name":"received_at","type":"string","value":"={{ $now.toISO() }}"},{"id":"a6","name":"raw_text","type":"string","value":"={{ String($json.text || $json.snippet || '').slice(0, 8000) }}"}]}},"typeVersion":3.4},{"id":"ce622480-deda-40d2-9bfb-be8a4af72110","name":"Has Order Details","type":"n8n-nodes-base.if","position":[224,16],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"c1","operator":{"type":"number","operation":"gt"},"leftValue":"={{ String($json.raw_text || '').length }}","rightValue":20}]}},"typeVersion":2.3},{"id":"f0928cfb-fe50-43ed-bc25-c1d7ef7a39be","name":"AI Extract Order Lines","type":"@n8n/n8n-nodes-langchain.agent","position":[544,0],"parameters":{"text":"={{ 'Wholesale order email. Subject: ' + $json.subject + ' | Sent by: ' + $json.from_email + ' | Body text: ' + $json.raw_text }}","options":{"systemMessage":"You read wholesale order emails for a food and beverage distributor and turn them into clean order data. Return ONLY valid JSON, no markdown, no code fences, with these keys: customer (business name), customer_email (the ordering contact email written anywhere in the body, otherwise the sender address), po_number (their reference if present, else empty string), delivery_date (YYYY-MM-DD if stated, else empty string), notes (one short line of special instructions, else empty string), and lines (array of objects with sku, qty, unit_price_quoted). Pull sku exactly as written, qty as a number, and unit_price_quoted as a number when the buyer wrote a price, else 0. If no business name is written anywhere, use the part of the sender address before the @ sign. Never invent products, quantities or prices. If the email holds no line items, return lines as an empty array."},"promptType":"define"},"typeVersion":3.1},{"id":"3f753126-ad37-41f6-9346-c015b897b53a","name":"Order Extraction Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[544,128],"parameters":{"model":{"__rl":true,"mode":"list","value":"gpt-4o-mini","cachedResultName":"gpt-4o-mini"},"options":{},"builtInTools":{}},"credentials":{"openAiApi":{"id":"credential-id","name":"jonathan"}},"typeVersion":1.3},{"id":"66be7a37-9fd7-481c-b419-fee86837e0ab","name":"Parse Extracted Order","type":"n8n-nodes-base.code","position":[848,0],"parameters":{"jsCode":"\nconst src = $('Normalize Order Email').first().json;\nconst raw = String($json.output || '');\nconst i = raw.indexOf('{');\nconst j = raw.lastIndexOf('}');\nlet p = {};\nlet parse_ok = false;\nlet parse_error = '';\ntry {\n  p = JSON.parse(raw.slice(i, j + 1));\n  parse_ok = !!(p && Array.isArray(p.lines) && p.lines.length > 0);\n  if (!parse_ok) parse_error = 'no line items were found in this email';\n} catch (e) {\n  parse_error = 'the email text could not be read as an order';\n}\nconst lines = parse_ok ? p.lines.map(function (l) {\n  return {\n    sku: String((l && l.sku) || '').trim().toUpperCase(),\n    qty: Number((l && l.qty) || 0),\n    quoted_price: Number((l && l.unit_price_quoted) || 0)\n  };\n}) : [];\nreturn [{ json: {\n  email_id: src.email_id,\n  thread_id: src.thread_id,\n  from_email: src.from_email,\n  customer_name: src.customer_name,\n  customer_email: String((p && p.customer_email) || src.from_email || '').trim(),\n  subject: src.subject,\n  received_at: src.received_at,\n  po_number: String((p && p.po_number) || '').trim(),\n  delivery_date: String((p && p.delivery_date) || '').trim(),\n  notes: String((p && p.notes) || '').trim(),\n  parse_ok: parse_ok,\n  parse_error: parse_error,\n  lines: lines\n} }];\n"},"typeVersion":2},{"id":"8b5b97db-6a5e-418e-a39f-e45f993013ec","name":"Fetch Price List","type":"n8n-nodes-base.googleSheets","position":[1056,0],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"PriceList"},"documentId":{"__rl":true,"mode":"id","value":"1P6Rx0AjH_jpSG4MAa9h6BMkisksO0l0pj_Uyfa0rHK4"}},"credentials":{"googleSheetsOAuth2Api":{"id":"credential-id","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"fe8082cf-8e97-4e05-9c08-8552f541c2fe","name":"Match Lines To Price List","type":"n8n-nodes-base.code","position":[1264,0],"parameters":{"jsCode":"\nconst price = $input.all().map(function (i) { return i.json; });\nconst o = $('Parse Extracted Order').first().json;\nconst norm = function (s) { return String(s || '').trim().toUpperCase(); };\nconst bySku = {};\nprice.forEach(function (r) { const k = norm(r.sku); if (k) bySku[k] = r; });\nconst issues = [];\nconst ok = [];\nlet units = 0;\nlet total = 0;\n(o.lines || []).forEach(function (l) {\n  const sku = norm(l.sku);\n  if (!sku) { issues.push('one line arrived without a SKU code'); return; }\n  const row = bySku[sku] || null;\n  if (!row) { issues.push(sku + ': this code is not in our price list'); return; }\n  const list = Number(row.unit_price || 0);\n  const pack = Number(row.case_pack || 0);\n  const qty = Number(l.qty || 0);\n  const quoted = Number(l.quoted_price || 0);\n  const lineIssues = [];\n  if (!(qty > 0)) lineIssues.push('no quantity was given');\n  else if (pack > 0 && qty % pack !== 0) lineIssues.push('quantity ' + qty + ' is not a multiple of the case pack of ' + pack);\n  if (quoted > 0 && Math.abs(quoted - list) > 0.01) lineIssues.push('quoted unit price ' + quoted.toFixed(2) + ' but our list price is ' + list.toFixed(2));\n  if (String(row.status || 'active').toLowerCase().trim() !== 'active') lineIssues.push('this product is marked inactive');\n  if (lineIssues.length) {\n    issues.push(sku + ' (' + row.product + '): ' + lineIssues.join('; '));\n    return;\n  }\n  ok.push({ sku: sku, product: row.product, qty: qty, unit_price: list, line_total: Math.round(qty * list * 100) / 100 });\n  units += qty;\n  total += qty * list;\n});\nif (!o.parse_ok) issues.unshift('The email could not be read as an order: ' + o.parse_error);\nconst nl = String.fromCharCode(10);\nreturn [{ json: Object.assign({}, o, {\n  matched_lines: ok,\n  line_count: (o.lines || []).length,\n  issue_count: issues.length,\n  issues: issues,\n  issues_text: issues.length ? issues.join(nl) : 'no issues found',\n  total_units: units,\n  order_total: Math.round(total * 100) / 100,\n  status: issues.length ? 'needs_review' : 'ready_for_fulfilment',\n  linked_code: (o.notes || '').length > 0 ? 'notes present' : 'no notes'\n}) }];\n"},"typeVersion":2},{"id":"7d4b3111-a986-47da-93f3-ff68ee7d6bae","name":"If Price Or Pack Issue","type":"n8n-nodes-base.if","position":[1504,0],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"c1","operator":{"type":"number","operation":"gt"},"leftValue":"={{ $json.issue_count }}","rightValue":0}]}},"typeVersion":2.3},{"id":"0a36fae2-b3d6-4112-a04a-d43157f3a2cc","name":"Build Revision Request","type":"n8n-nodes-base.set","position":[1920,-64],"parameters":{"options":{},"assignments":{"assignments":[{"id":"a0","name":"order_id","type":"string","value":"={{ 'WO-' + $now.toFormat('yyyyLLdd-HHmmss') }}"},{"id":"a1","name":"received_at","type":"string","value":"={{ $json.received_at }}"},{"id":"a2","name":"customer","type":"string","value":"={{ $json.customer_name }}"},{"id":"a3","name":"customer_email","type":"string","value":"={{ $json.customer_email }}"},{"id":"a4","name":"po_number","type":"string","value":"={{ $json.po_number }}"},{"id":"a5","name":"line_count","type":"number","value":"={{ $json.line_count }}"},{"id":"a6","name":"total_units","type":"number","value":"={{ $json.total_units }}"},{"id":"a7","name":"order_total","type":"number","value":"={{ $json.order_total }}"},{"id":"a8","name":"status","type":"string","value":"={{ $json.status }}"},{"id":"a9","name":"issues","type":"string","value":"={{ $json.issues_text }}"},{"id":"a10","name":"thread_id","type":"string","value":"={{ $json.thread_id }}"},{"id":"a11","name":"logged_at","type":"string","value":"={{ $now.toISO() }}"},{"id":"a12","name":"email_subject","type":"string","value":"={{ 'Order ' + ($json.po_number || $json.customer_name) + ' needs a small fix before we confirm' }}"},{"id":"a13","name":"email_body","type":"string","value":"={{ 'Hi ' + ($json.customer_name || 'there') + ',<br><br>Thanks for sending order ' + ($json.po_number || '') + '. Before we pick and pack it we need these lines sorted out:<br><br>' + $json.issues.join('<br>') + '<br><br>Reply with the corrected lines and we will confirm the order right away.<br><br>Wholesale order desk' }}"},{"id":"a14","name":"tg_text","type":"string","value":"={{ 'Order needs a fix: ' + ($json.customer_name || 'unknown customer') + ' | ' + ($json.po_number || 'no reference') + ' | ' + $json.issue_count + ' issue(s): ' + $json.issues.join(' ;; ') }}"}]}},"typeVersion":3.4},{"id":"24d66550-7bea-4bb5-abdd-132829fd1ec5","name":"Build Order Confirmation","type":"n8n-nodes-base.set","position":[1920,112],"parameters":{"options":{},"assignments":{"assignments":[{"id":"a0","name":"order_id","type":"string","value":"={{ 'WO-' + $now.toFormat('yyyyLLdd-HHmmss') }}"},{"id":"a1","name":"received_at","type":"string","value":"={{ $json.received_at }}"},{"id":"a2","name":"customer","type":"string","value":"={{ $json.customer_name }}"},{"id":"a3","name":"customer_email","type":"string","value":"={{ $json.customer_email }}"},{"id":"a4","name":"po_number","type":"string","value":"={{ $json.po_number }}"},{"id":"a5","name":"line_count","type":"number","value":"={{ $json.line_count }}"},{"id":"a6","name":"total_units","type":"number","value":"={{ $json.total_units }}"},{"id":"a7","name":"order_total","type":"number","value":"={{ $json.order_total }}"},{"id":"a8","name":"status","type":"string","value":"={{ $json.status }}"},{"id":"a9","name":"issues","type":"string","value":"={{ $json.issues_text }}"},{"id":"a10","name":"thread_id","type":"string","value":"={{ $json.thread_id }}"},{"id":"a11","name":"logged_at","type":"string","value":"={{ $now.toISO() }}"},{"id":"a12","name":"email_subject","type":"string","value":"={{ 'Order confirmed: ' + ($json.po_number || ('WO-' + $json.line_count + ' lines')) + ' at ' + $json.order_total + ' USD' }}"},{"id":"a13","name":"email_body","type":"string","value":"={{ 'Hi ' + ($json.customer_name || 'there') + ',<br><br>Your order is confirmed and queued for the next dispatch.<br><br>' + $json.matched_lines.map(function (l) { return l.qty + ' x ' + l.sku + ' (' + l.product + ') at ' + l.unit_price.toFixed(2) + ' = ' + l.line_total.toFixed(2); }).join('<br>') + '<br><br>Units: ' + $json.total_units + '<br>Order value: ' + $json.order_total + ' USD<br>Delivery: ' + ($json.delivery_date || 'next available run') + '<br><br>Wholesale order desk' }}"},{"id":"a14","name":"tg_text","type":"string","value":"={{ 'Order confirmed: ' + ($json.customer_name || 'unknown customer') + ' | ' + ($json.po_number || 'no reference') + ' | ' + $json.total_units + ' units | ' + $json.order_total + ' USD | every line matched the price list' }}"}]}},"typeVersion":3.4},{"id":"24624d7b-8c66-497a-97fd-a2dc6dbf1bba","name":"Email Customer For Revision","type":"n8n-nodes-base.gmail","position":[2912,-192],"webhookId":"01d163b7-a9df-4dee-b452-bb22b7684da6","parameters":{"sendTo":"={{ $json.customer_email }}","message":"={{ $json.email_body }}","options":{},"subject":"={{ $json.email_subject }}"},"credentials":{"gmailOAuth2":{"id":"credential-id","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"15931d5a-3a67-4995-b83a-ea03d6d8e501","name":"Email Order Confirmation","type":"n8n-nodes-base.gmail","position":[2256,208],"webhookId":"7e7c496a-c9a6-4c42-8b0b-d7fa00cadc95","parameters":{"sendTo":"={{ $json.customer_email }}","message":"={{ $json.email_body }}","options":{},"subject":"={{ $json.email_subject }}"},"credentials":{"gmailOAuth2":{"id":"credential-id","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"5b4faaa8-62b2-479c-abc0-6ad577e8e5ad","name":"Alert Order Desk On Telegram","type":"n8n-nodes-base.telegram","position":[2912,224],"webhookId":"62dcf912-8285-48a7-a5d6-7810d383ffd4","parameters":{"text":"={{ $json.tg_text }}","chatId":"123456789","additionalFields":{}},"credentials":{"telegramApi":{"id":"credential-id","name":"CF Openai Bot"}},"typeVersion":1.2},{"id":"e59f80e7-7d30-478a-b854-c8d714a0ec84","name":"Log Order To Fulfilment Queue","type":"n8n-nodes-base.googleSheets","position":[2432,48],"parameters":{"columns":{"value":{"issues":"={{ $json.issues }}","status":"={{ $json.status }}","customer":"={{ $json.customer }}","order_id":"={{ $json.order_id }}","logged_at":"={{ $json.logged_at }}","po_number":"={{ $json.po_number }}","thread_id":"={{ $json.thread_id }}","line_count":"={{ $json.line_count }}","order_total":"={{ $json.order_total }}","received_at":"={{ $json.received_at }}","total_units":"={{ $json.total_units }}","customer_email":"={{ $json.customer_email }}"},"schema":[{"id":"order_id","type":"string","display":true,"removed":false,"required":false,"displayName":"order_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"received_at","type":"string","display":true,"removed":false,"required":false,"displayName":"received_at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"customer","type":"string","display":true,"removed":false,"required":false,"displayName":"customer","defaultMatch":false,"canBeUsedToMatch":true},{"id":"customer_email","type":"string","display":true,"removed":false,"required":false,"displayName":"customer_email","defaultMatch":false,"canBeUsedToMatch":true},{"id":"po_number","type":"string","display":true,"removed":false,"required":false,"displayName":"po_number","defaultMatch":false,"canBeUsedToMatch":true},{"id":"line_count","type":"string","display":true,"removed":false,"required":false,"displayName":"line_count","defaultMatch":false,"canBeUsedToMatch":true},{"id":"total_units","type":"string","display":true,"removed":false,"required":false,"displayName":"total_units","defaultMatch":false,"canBeUsedToMatch":true},{"id":"order_total","type":"string","display":true,"removed":false,"required":false,"displayName":"order_total","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"removed":false,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"issues","type":"string","display":true,"removed":false,"required":false,"displayName":"issues","defaultMatch":false,"canBeUsedToMatch":true},{"id":"thread_id","type":"string","display":true,"removed":false,"required":false,"displayName":"thread_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"logged_at","type":"string","display":true,"removed":false,"required":false,"displayName":"logged_at","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[]},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Orders"},"documentId":{"__rl":true,"mode":"id","value":"1P6Rx0AjH_jpSG4MAa9h6BMkisksO0l0pj_Uyfa0rHK4"}},"credentials":{"googleSheetsOAuth2Api":{"id":"credential-id","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"dc8494ef-fb17-4e2d-b15a-c035d389c9d0","name":"Mark Order Email As Read","type":"n8n-nodes-base.gmail","position":[2672,48],"webhookId":"fe857a83-5291-47e8-a6f9-8269f65072f5","parameters":{"messageId":"={{ $('Normalize Order Email').first().json.email_id }}","operation":"markAsRead"},"credentials":{"gmailOAuth2":{"id":"credential-id","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"37ae41f4-3330-4fb8-96f2-683cc5e29c20","name":"Log Unparsable Order Email","type":"n8n-nodes-base.googleSheets","position":[-16,256],"parameters":{"columns":{"value":{"detail":"={{ 'From ' + $json.from_email + ' | subject ' + $json.subject + ' | text length ' + String($json.raw_text || '').length }}","reason":"the email was too short to hold an order","source":"gmail order intake","error_id":"={{ 'ERR-' + $now.toFormat('yyyyLLdd-HHmmss') }}","logged_at":"={{ $now.toISO() }}"},"schema":[{"id":"error_id","type":"string","display":true,"removed":false,"required":false,"displayName":"error_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"source","type":"string","display":true,"removed":false,"required":false,"displayName":"source","defaultMatch":false,"canBeUsedToMatch":true},{"id":"reason","type":"string","display":true,"removed":false,"required":false,"displayName":"reason","defaultMatch":false,"canBeUsedToMatch":true},{"id":"detail","type":"string","display":true,"removed":false,"required":false,"displayName":"detail","defaultMatch":false,"canBeUsedToMatch":true},{"id":"logged_at","type":"string","display":true,"removed":false,"required":false,"displayName":"logged_at","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[]},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Errors"},"documentId":{"__rl":true,"mode":"id","value":"1P6Rx0AjH_jpSG4MAa9h6BMkisksO0l0pj_Uyfa0rHK4"}},"credentials":{"googleSheetsOAuth2Api":{"id":"credential-id","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"151a1678-e08f-498d-bbca-3ed9765116bf","name":"Alert Desk About Unparsable Email","type":"n8n-nodes-base.telegram","position":[224,256],"webhookId":"0b51f741-eb30-40e0-9ab3-f62a12bbcf30","parameters":{"text":"={{ 'A wholesale order email could not be read: from ' + $json.from_email + ' | subject ' + $json.subject + '. Please open it and handle it by hand.' }}","chatId":"123456789","additionalFields":{}},"credentials":{"telegramApi":{"id":"credential-id","name":"CF Openai Bot"}},"typeVersion":1.2},{"id":"4518d0ab-78b9-4457-bc2c-9665a77647b8","name":"Weekly Order Desk Digest","type":"n8n-nodes-base.scheduleTrigger","position":[0,-448],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 8 * * 1"}]}},"typeVersion":1.2},{"id":"89cf21fa-4a24-4443-8cc9-1579f6f2571b","name":"Read Orders This Week","type":"n8n-nodes-base.googleSheets","position":[240,-448],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Orders"},"documentId":{"__rl":true,"mode":"id","value":"1P6Rx0AjH_jpSG4MAa9h6BMkisksO0l0pj_Uyfa0rHK4"}},"credentials":{"googleSheetsOAuth2Api":{"id":"credential-id","name":"Feedback Analyzer Sheets"}},"typeVersion":4.6},{"id":"dc6ee0fc-c607-406f-8372-14ba440d0ee8","name":"Summarise Order Week","type":"n8n-nodes-base.code","position":[480,-448],"parameters":{"jsCode":"\nconst rows = $input.all().map(function (i) { return i.json; });\nconst cutoff = Date.now() - 7 * 24 * 3600 * 1000;\nconst week = rows.filter(function (r) {\n  const t = Date.parse(String(r.logged_at || ''));\n  return !isNaN(t) && t >= cutoff;\n});\nlet value = 0;\nlet units = 0;\nweek.forEach(function (r) { value += Number(r.order_total || 0); units += Number(r.total_units || 0); });\nconst needs = week.filter(function (r) { return String(r.status || '') === 'needs_review'; });\nconst lines = week.map(function (r) {\n  return String(r.order_id || '') + ' | ' + String(r.customer || '') + ' | PO ' + String(r.po_number || '') +\n    ' | ' + String(r.status || '') + ' | ' + String(r.total_units || 0) + ' units | ' + String(r.order_total || 0) + ' USD';\n});\nreturn [{ json: {\n  week_start: new Date(cutoff).toISOString().slice(0, 10),\n  orders: week.length,\n  confirmed: week.length - needs.length,\n  needs_revision: needs.length,\n  units: units,\n  value: Math.round(value * 100) / 100,\n  revision_rate: week.length ? Math.round(needs.length / week.length * 1000) / 10 : 0,\n  order_lines: lines,\n  revision_lines: needs.map(function (r) {\n    return String(r.order_id || '') + ' | ' + String(r.customer || '') + ' | ' + String(r.issues || '');\n  })\n} }];\n"},"typeVersion":2},{"id":"562b7960-6112-497b-a542-a258fd29e9c0","name":"AI Write Digest Summary","type":"@n8n/n8n-nodes-langchain.agent","position":[720,-448],"parameters":{"text":"={{ 'Weekly wholesale order data. Week starting ' + $json.week_start + '. Orders received: ' + $json.orders + '. Confirmed without changes: ' + $json.confirmed + '. Needed a correction: ' + $json.needs_revision + ' (' + $json.revision_rate + ' percent). Units picked: ' + $json.units + '. Order value: ' + $json.value + ' USD. Orders: ' + $json.order_lines.join(' ;; ') + '. Orders needing correction: ' + ($json.revision_lines.length ? $json.revision_lines.join(' ;; ') : 'none') }}","options":{"systemMessage":"You write the Monday morning order desk digest for a wholesale distributor. Return ONLY valid JSON with the keys digest_subject (short email subject line that starts with 'Weekly order desk digest'), digest_body (HTML email body, under 150 words, a short summary paragraph, then a bullet list of the orders, then one line on what to chase this week) and tg_text (plain text under 300 characters for a Telegram alert). Be specific with numbers. If no orders came in, say so plainly and suggest checking the intake filter. No emojis, no markdown, JSON only."},"promptType":"define"},"typeVersion":3.1},{"id":"0ea9f700-5fbe-4291-9c7d-411404082b9e","name":"Digest Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[720,-304],"parameters":{"model":{"__rl":true,"mode":"list","value":"gpt-4o-mini","cachedResultName":"gpt-4o-mini"},"options":{},"builtInTools":{}},"credentials":{"openAiApi":{"id":"credential-id","name":"jonathan"}},"typeVersion":1.3},{"id":"51443f2f-4d4f-4c77-a684-db1c8e8ec3cf","name":"Format Digest Email","type":"n8n-nodes-base.code","position":[1040,-448],"parameters":{"jsCode":"\nconst raw = String($json.output || '');\nconst i = raw.indexOf('{');\nconst j = raw.lastIndexOf('}');\nlet p = {};\ntry { p = JSON.parse(raw.slice(i, j + 1)); } catch (e) { p = {}; }\nconst s = $('Summarise Order Week').first().json;\nreturn [{ json: Object.assign({}, s, {\n  digest_subject: String(p.digest_subject || ('Weekly order desk digest, week of ' + s.week_start)),\n  digest_body: String(p.digest_body || ('Orders this week: ' + s.orders + '. Value: ' + s.value + ' USD. Needs correction: ' + s.needs_revision + '.')),\n  tg_text: String(p.tg_text || ('Weekly order digest: ' + s.orders + ' orders, ' + s.value + ' USD, ' + s.needs_revision + ' need a fix.'))\n}) }];\n"},"typeVersion":2},{"id":"591bec36-ba20-4410-a191-9604e4cac0e4","name":"Email Weekly Digest","type":"n8n-nodes-base.gmail","position":[1280,-448],"webhookId":"33a23239-f24d-4704-8f81-672511b6f9fc","parameters":{"sendTo":"user@example.com","message":"={{ $json.digest_body }}","options":{},"subject":"={{ $json.digest_subject }}"},"credentials":{"gmailOAuth2":{"id":"credential-id","name":"Gmail Fresh Sep05"}},"typeVersion":2.2},{"id":"a8f2566b-4dab-4582-ac80-8e511d100561","name":"Alert Digest On Telegram","type":"n8n-nodes-base.telegram","position":[1520,-448],"webhookId":"1987f272-b975-4ebe-8547-e1916e586f6a","parameters":{"text":"={{ $json.tg_text }}","chatId":"123456789","additionalFields":{}},"credentials":{"telegramApi":{"id":"credential-id","name":"CF Openai Bot"}},"typeVersion":1.2},{"id":"8d8743f4-66e5-4e4f-ac50-635a8a532b3c","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-544,-1008],"parameters":{"width":480,"height":832,"content":"## 09-15-01 validate wholesale order emails against a price list with AI\n\n### How it works\n\nWholesale orders arrive as free text email. This workflow reads each one, extracts the line items with an AI agent, then checks every line against your price list: unknown SKU, wrong unit price, or a quantity that is not a whole case pack. Clean orders get an automatic confirmation and drop into the fulfilment queue. Problem orders get a revision request listing exactly what to fix, before anything ships. Every order is logged to Google Sheets, the desk gets a Telegram alert, and a Monday morning digest reports the week.\n\n### Setup steps\n\n- Connect Gmail and set the trigger search filter so it matches your order emails.\n- Create a Google Sheet with three tabs: PriceList, Orders and Errors, then point the Google Sheets nodes at it.\n- Fill PriceList with sku, product, unit_price, case_pack and status.\n- Set the digest address, connect Telegram, then send one test order email.\n\n### Customization\n\nSwap Sheets for Airtable or Postgres, Telegram for Slack, or skip the customer reply and just alert the desk."},"typeVersion":1},{"id":"84664806-ee4a-41ec-a875-6201663e9992","name":"Order intake note","type":"n8n-nodes-base.stickyNote","position":[-336,-112],"parameters":{"color":7,"width":758,"height":558,"content":"## 1. Order intake\n\nNew wholesale order emails land here. Anything too short to be an order goes straight to the error lane."},"typeVersion":1},{"id":"f2b8bb09-1388-4cbf-96d2-4dba2fd8a374","name":"Price check note","type":"n8n-nodes-base.stickyNote","position":[448,-112],"parameters":{"color":7,"width":1256,"height":414,"content":"## 2. AI reads the order and checks the price list\n\nLine items are extracted, then every line is checked for unknown SKUs, wrong unit prices and quantities that are not a full case pack."},"typeVersion":1},{"id":"77d2a79c-8f9c-4a85-940c-353a1d7911ec","name":"Reply note","type":"n8n-nodes-base.stickyNote","position":[1728,-272],"parameters":{"color":7,"width":1398,"height":718,"content":"## 3. Reply, alert and log\n\nClean orders get a confirmation. Problem orders get a revision request. Every order is logged and the desk hears about it on Telegram."},"typeVersion":1},{"id":"15e2c55f-02b1-486d-896a-b4d301e0784c","name":"Digest note","type":"n8n-nodes-base.stickyNote","position":[-32,-608],"parameters":{"color":7,"width":1748,"height":462,"content":"## 4. Weekly order desk digest\n\nEvery Monday morning the week of orders is summarised into one email and a short Telegram message."},"typeVersion":1},{"id":"f2da7bec-2074-4d3b-a398-10d41c7e177e","name":"Alert Order Desk On Telegram1","type":"n8n-nodes-base.telegram","position":[2272,-160],"webhookId":"62dcf912-8285-48a7-a5d6-7810d383ffd4","parameters":{"text":"={{ $json.tg_text }}","chatId":"123456789","additionalFields":{}},"credentials":{"telegramApi":{"id":"credential-id","name":"CF Openai Bot"}},"typeVersion":1.2}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"fe61df74-439d-41de-8ae8-f77d3c68a74a","nodeGroups":[],"connections":{"Digest Model":{"ai_languageModel":[[{"node":"AI Write Digest Summary","type":"ai_languageModel","index":0}]]},"Fetch Price List":{"main":[[{"node":"Match Lines To Price List","type":"main","index":0}]]},"Has Order Details":{"main":[[{"node":"AI Extract Order Lines","type":"main","index":0}],[{"node":"Log Unparsable Order Email","type":"main","index":0}]]},"Email Weekly Digest":{"main":[[{"node":"Alert Digest On Telegram","type":"main","index":0}]]},"Format Digest Email":{"main":[[{"node":"Email Weekly Digest","type":"main","index":0}]]},"Summarise Order Week":{"main":[[{"node":"AI Write Digest Summary","type":"main","index":0}]]},"Normalize Order Email":{"main":[[{"node":"Has Order Details","type":"main","index":0}]]},"Parse Extracted Order":{"main":[[{"node":"Fetch Price List","type":"main","index":0}]]},"Read Orders This Week":{"main":[[{"node":"Summarise Order Week","type":"main","index":0}]]},"AI Extract Order Lines":{"main":[[{"node":"Parse Extracted Order","type":"main","index":0}]]},"Build Revision Request":{"main":[[{"node":"Email Customer For Revision","type":"main","index":0},{"node":"Log Order To Fulfilment Queue","type":"main","index":0},{"node":"Alert Order Desk On Telegram1","type":"main","index":0}]]},"If Price Or Pack Issue":{"main":[[{"node":"Build Revision Request","type":"main","index":0}],[{"node":"Build Order Confirmation","type":"main","index":0}]]},"Order Extraction Model":{"ai_languageModel":[[{"node":"AI Extract Order Lines","type":"ai_languageModel","index":0}]]},"AI Write Digest Summary":{"main":[[{"node":"Format Digest Email","type":"main","index":0}]]},"Build Order Confirmation":{"main":[[{"node":"Email Order Confirmation","type":"main","index":0},{"node":"Alert Order Desk On Telegram","type":"main","index":0},{"node":"Log Order To Fulfilment Queue","type":"main","index":0}]]},"Weekly Order Desk Digest":{"main":[[{"node":"Read Orders This Week","type":"main","index":0}]]},"Match Lines To Price List":{"main":[[{"node":"If Price Or Pack Issue","type":"main","index":0}]]},"Log Unparsable Order Email":{"main":[[{"node":"Alert Desk About Unparsable Email","type":"main","index":0}]]},"Log Order To Fulfilment Queue":{"main":[[{"node":"Mark Order Email As Read","type":"main","index":0}]]},"When Wholesale Order Email Arrives":{"main":[[{"node":"Normalize Order Email","type":"main","index":0}]]}}}