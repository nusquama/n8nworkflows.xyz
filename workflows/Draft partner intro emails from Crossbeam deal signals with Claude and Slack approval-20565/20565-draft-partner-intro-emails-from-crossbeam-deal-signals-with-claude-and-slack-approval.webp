{"id":"ooKgfjUi0qVpLZKB","meta":{"instanceId":"e88437830669233a386dc3c9687a111c9ae52599bebf24abdc714f8cabeca78d","builderVariant":"mcp","aiBuilderAssisted":true},"name":"Draft partner intro emails from Crossbeam deal signals with Claude and Slack approval","tags":[],"nodes":[{"id":"07a31183-ec1f-43c5-88ac-2a4afb9b8313","name":"Configure me","type":"n8n-nodes-base.set","position":[240,0],"parameters":{"options":{},"assignments":{"assignments":[{"id":"cfg-org","name":"crossbeam_org_uuid","type":"string","value":"YOUR_CROSSBEAM_ORG_UUID"},{"id":"cfg-api","name":"crossbeam_api_base_url","type":"string","value":"https://api.crossbeam.com"},{"id":"cfg-lookback","name":"signal_lookback_days","type":"number","value":7},{"id":"cfg-types","name":"event_types","type":"string","value":"partner_deal_opened,partner_deal_closed_won"},{"id":"cfg-partners","name":"partner_filter","type":"string","value":""},{"id":"cfg-mode","name":"match_mode","type":"string","value":"closed_lost"},{"id":"cfg-months","name":"closed_lost_lookback_months","type":"number","value":12},{"id":"cfg-reason","name":"loss_reason_field","type":"string","value":""},{"id":"cfg-sfdc","name":"salesforce_base_url","type":"string","value":"https://YOUR_DOMAIN.my.salesforce.com"},{"id":"cfg-company","name":"your_company_name","type":"string","value":"YOUR_COMPANY_NAME"},{"id":"cfg-max","name":"max_items_per_run","type":"number","value":5},{"id":"cfg-conf","name":"min_confidence","type":"string","value":"medium"},{"id":"cfg-channel","name":"slack_channel","type":"string","value":"YOUR_SLACK_CHANNEL_ID"},{"id":"cfg-wait","name":"approval_wait_hours","type":"number","value":8},{"id":"cfg-send","name":"send_mode","type":"string","value":"draft"},{"id":"cfg-task","name":"create_sfdc_task","type":"boolean","value":true},{"id":"cfg-dry","name":"dry_run","type":"boolean","value":true},{"id":"cfg-secret","name":"webhook_signing_secret","type":"string","value":"YOUR_SIGNING_SECRET"},{"id":"cfg-age","name":"max_timestamp_age_seconds","type":"number","value":300},{"id":"cfg-unsigned","name":"allow_unsigned_test_requests","type":"boolean","value":false}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"f24b95fc-10f6-4753-988c-a25b3643d9be","name":"Every weekday at 08:45","type":"n8n-nodes-base.scheduleTrigger","position":[16,96],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"45 8 * * 1-5"}]}},"typeVersion":1.2},{"id":"dce1c49d-37b7-4eaa-933c-422bc5303d25","name":"Webhook or schedule?","type":"n8n-nodes-base.switch","position":[464,0],"parameters":{"rules":{"values":[{"outputKey":"Webhook","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"rt-wh","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.headers !== undefined }}","rightValue":""}]},"renameOutput":true},{"outputKey":"Schedule","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"rt-sc","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.headers === undefined }}","rightValue":""}]},"renameOutput":true}]},"options":{}},"typeVersion":3.2},{"id":"992327b7-5aa5-45fd-992a-2b09701d806b","name":"Verify webhook signature","type":"n8n-nodes-base.code","position":[704,96],"parameters":{"jsCode":"// Checks the HMAC-SHA256 signature (X-Crossbeam-Signature-256) and timestamp (X-Crossbeam-Timestamp) of a Crossbeam webhook,\n// then returns one item per signal event. Events have the same shape as GET /v1/signals/accounts items.\nconst cfg = $('Configure me').first().json;\nconst first = $input.first();\nconst headers = first.json.headers || {};\nconst sig = String(headers['x-crossbeam-signature-256'] || '').replace(/^sha256=/i, '').trim();\nconst ts = String(headers['x-crossbeam-timestamp'] || '').trim();\nlet raw = '';\ntry { if (first.binary && first.binary.data) raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8'); } catch (e) {}\nif (!raw) raw = typeof first.json.body === 'string' ? first.json.body : JSON.stringify(first.json.body || {});\nlet body = first.json.body;\nif (typeof body === 'string' || !body || !Object.keys(body).length) { try { body = JSON.parse(raw); } catch (e) { body = {}; } }\n\nlet valid = false;\nlet reason = '';\nconst secret = String(cfg.webhook_signing_secret || '');\nconst age = Math.abs(Date.now() / 1000 - Number(ts));\nif (cfg.allow_unsigned_test_requests === true) { valid = true; }\nelse if (!secret || secret.indexOf('YOUR_') === 0) reason = 'No signing secret in Configure me';\nelse if (!sig || !ts) reason = 'Missing signature or timestamp header';\nelse if (!(age <= Number(cfg.max_timestamp_age_seconds || 300))) reason = 'Stale or unreadable timestamp';\nelse {\n  const crypto = require('crypto');\n  // The signed string is tried in the common layouts (body+timestamp first), hex or base64.\n  for (const payload of [raw + ts, ts + raw, ts + '.' + raw]) {\n    const d = crypto.createHmac('sha256', secret).update(payload, 'utf8').digest();\n    if ([d.toString('hex'), d.toString('base64')].includes(sig)) { valid = true; break; }\n  }\n  if (!valid) reason = 'Signature mismatch';\n}\nconst events = Array.isArray(body) ? body : Array.isArray(body.data) ? body.data : Array.isArray(body.events) ? body.events : [body];\nreturn events.map(e => ({ json: Object.assign({}, e, { valid, reason, source: 'webhook' }) }));"},"typeVersion":2},{"id":"799544f0-e961-4b73-860f-20f913a73ffa","name":"Signature valid?","type":"n8n-nodes-base.if","position":[928,96],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"sig-ok","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.valid }}","rightValue":""}]}},"typeVersion":2.2},{"id":"cbe16231-1cfa-41b5-b927-e1f05518aec0","name":"Acknowledge webhook (200)","type":"n8n-nodes-base.respondToWebhook","position":[1152,0],"parameters":{"options":{"responseCode":200},"respondWith":"json","responseBody":"{\"received\": true}"},"typeVersion":1.5},{"id":"9c9b4f5b-f3c4-4158-a1c5-14e8069be641","name":"Shape signal fields","type":"n8n-nodes-base.set","position":[1408,0],"parameters":{"options":{},"assignments":{"assignments":[{"id":"sg-key","name":"event_key","type":"string","value":"={{ String($json.event_id || [$json.event_type, $json.partner_id, $json.record_id, $json.triggered_at].join('|')) }}"},{"id":"sg-type","name":"event_type","type":"string","value":"={{ $json.event_type }}"},{"id":"sg-at","name":"triggered_at","type":"string","value":"={{ $json.triggered_at || '' }}"},{"id":"sg-src","name":"source","type":"string","value":"={{ $json.source || 'poll' }}"},{"id":"sg-partner","name":"partner_name","type":"string","value":"={{ $json.partner_name || 'A partner' }}"},{"id":"sg-acct","name":"account_name","type":"string","value":"={{ $json.record_name || $json.partner_account_name || '' }}"},{"id":"sg-domain","name":"account_domain","type":"string","value":"={{ String($json.record_domain || $json.partner_account_domain || '').toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split('/')[0] }}"},{"id":"sg-id","name":"sfdc_account_id","type":"string","value":"={{ $json.record_type === 'account' && /^001[A-Za-z0-9]{12}([A-Za-z0-9]{3})?$/.test(String($json.record_id || '')) ? String($json.record_id) : '' }}"},{"id":"sg-id15","name":"sfdc_id15","type":"string","value":"={{ String($json.record_id || '').slice(0, 15) }}"},{"id":"sg-deal","name":"partner_deal_name","type":"string","value":"={{ $json.partner_data?.deal?.name || '' }}"},{"id":"sg-stage","name":"partner_deal_stage","type":"string","value":"={{ $json.partner_data?.deal?.stage || '' }}"},{"id":"sg-status","name":"partner_deal_status","type":"string","value":"={{ $json.partner_data?.deal?.is_closed ? ($json.partner_data.deal.is_won ? 'closed won' : 'closed lost') : 'open' }}"},{"id":"sg-contacts","name":"partner_deal_contacts","type":"string","value":"={{ ($json.partner_data?.deal?.contacts || []).filter(c => c && c.name && c.name.trim() !== '.').slice(0, 5).map(c => c.name + (c.role_name ? ' (' + c.role_name + ')' : '') + (c.email ? ' <' + c.email + '>' : '')).join('; ') }}"}]}},"typeVersion":3.4},{"id":"b8ad7ca4-7f71-4acf-a7ec-ae7e127162dd","name":"Reject webhook (401)","type":"n8n-nodes-base.respondToWebhook","position":[1152,192],"parameters":{"options":{"responseCode":401},"respondWith":"json","responseBody":"={{ JSON.stringify({ error: $json.reason }) }}"},"typeVersion":1.5},{"id":"b6aca5f6-4788-48aa-907d-31e7b7821fd0","name":"Fetch partner deal signals","type":"n8n-nodes-base.httpRequest","maxTries":3,"position":[816,768],"parameters":{"url":"={{ $('Configure me').first().json.crossbeam_api_base_url }}/v1/signals/accounts?limit=1000","options":{"timeout":30000,"pagination":{"pagination":{"nextURL":"={{ $response.body.pagination && $response.body.pagination.next_href ? $response.body.pagination.next_href : '' }}","maxRequests":60,"paginationMode":"responseContainsNextURL","requestInterval":300,"limitPagesFetched":true,"completeExpression":"={{ !($response.body.pagination && $response.body.pagination.has_more && $response.body.pagination.next_href) }}","paginationCompleteWhen":"other"}}},"sendHeaders":true,"authentication":"genericCredentialType","genericAuthType":"oAuth2Api","headerParameters":{"parameters":[{"name":"Xbeam-Organization","value":"={{ $('Configure me').first().json.crossbeam_org_uuid }}"},{"name":"Accept","value":"application/json"}]}},"executeOnce":true,"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":3000},{"id":"41475123-3450-4742-bc62-7a8b8f17c97c","name":"One item per signal","type":"n8n-nodes-base.splitOut","position":[1040,768],"parameters":{"options":{},"fieldToSplitOut":"data"},"typeVersion":1},{"id":"b45d15cf-2145-47d6-9484-5100836be18c","name":"Keep fresh, in-scope signals","type":"n8n-nodes-base.filter","position":[1632,0],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"f-crm","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $json.sfdc_account_id }}","rightValue":""},{"id":"f-fresh","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.source === 'webhook' || !$json.triggered_at || DateTime.fromISO($json.triggered_at).toMillis() >= $now.minus({ days: Number($('Configure me').first().json.signal_lookback_days) || 7 }).toMillis() }}","rightValue":""},{"id":"f-type","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ String($('Configure me').first().json.event_types || '').split(',').map(s => s.trim()).includes($json.event_type) }}","rightValue":""},{"id":"f-partner","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ (() => { const f = String($('Configure me').first().json.partner_filter || '').toLowerCase().split(',').map(s => s.trim()).filter(Boolean); return !f.length || f.some(p => $json.partner_name.toLowerCase().includes(p)); })() }}","rightValue":""},{"id":"f-lost","operator":{"type":"string","operation":"notEquals"},"leftValue":"={{ $json.partner_deal_status }}","rightValue":"closed lost"}]}},"typeVersion":2.2},{"id":"b07c636f-bdfd-485c-b239-f57b3fbb1932","name":"Remove duplicate events","type":"n8n-nodes-base.removeDuplicates","position":[1856,0],"parameters":{"compare":"selectedFields","options":{},"fieldsToCompare":"event_key"},"typeVersion":2},{"id":"2d57c744-589f-4eb9-96a8-7b58710aa6d5","name":"Skip events already handled","type":"n8n-nodes-base.dataTable","position":[2080,0],"parameters":{"filters":{"conditions":[{"keyName":"event_key","keyValue":"={{ $json.event_key }}"},{"keyName":"status","keyValue":"dry_run"}]},"matchType":"allConditions","operation":"rowNotExists","dataTableId":{"__rl":true,"mode":"list","value":""}},"typeVersion":1.1},{"id":"767778d5-6b8b-4eba-bc60-98a6c3642487","name":"Join signals to accounts","type":"n8n-nodes-base.merge","position":[3264,0],"parameters":{"mode":"combine","options":{},"fieldsToMatchString":"sfdc_id15"},"typeVersion":3.2},{"id":"a45e2e33-76a6-49a0-abf6-6e8098d44dc7","name":"Keep accounts found","type":"n8n-nodes-base.filter","position":[2560,0],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"kf-id","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $json.Id }}","rightValue":""}]}},"typeVersion":2.2},{"id":"c3c68c62-47a3-4d6b-835c-0551c52a7dd5","name":"Shape Salesforce account","type":"n8n-nodes-base.set","position":[2784,0],"parameters":{"options":{},"assignments":{"assignments":[{"id":"sa-id15","name":"sfdc_id15","type":"string","value":"={{ $json.Id.slice(0, 15) }}"},{"id":"sa-name","name":"our_account_name","type":"string","value":"={{ $json.Name }}"},{"id":"sa-oid","name":"owner_id","type":"string","value":"={{ $json.OwnerId || '' }}"},{"id":"sa-oname","name":"owner_name","type":"string","value":"={{ $json.Owner?.Name || 'Unassigned' }}"},{"id":"sa-oemail","name":"owner_email","type":"string","value":"={{ $json.Owner?.Email || '' }}"},{"id":"sa-lost","name":"lost_opp_name","type":"string","value":"={{ $json.Opportunities?.records?.[0]?.Name || '' }}"},{"id":"sa-lostdate","name":"lost_opp_close_date","type":"string","value":"={{ $json.Opportunities?.records?.[0]?.CloseDate || '' }}"},{"id":"sa-lostamt","name":"lost_opp_amount","type":"string","value":"={{ $json.Opportunities?.records?.[0]?.Amount != null ? Number($json.Opportunities.records[0].Amount).toLocaleString('en-US') : '' }}"},{"id":"sa-reason","name":"loss_reason","type":"string","value":"={{ (() => { const f = String($('Configure me').first().json.loss_reason_field || '').trim(); const o = $json.Opportunities?.records?.[0] || {}; return f && o[f] ? String(o[f]) : 'not recorded'; })() }}"},{"id":"sa-url","name":"account_url","type":"string","value":"={{ (() => { const b = String($('Configure me').first().json.salesforce_base_url || '').replace(/\\/$/, ''); return b && !b.includes('YOUR_') ? b + '/' + $json.Id : ''; })() }}"}]}},"typeVersion":3.4},{"id":"90483ec9-d38a-4c6b-9ce5-a6f051d38dce","name":"Collect Account Ids","type":"n8n-nodes-base.aggregate","position":[2560,240],"parameters":{"options":{},"fieldsToAggregate":{"fieldToAggregate":[{"fieldToAggregate":"sfdc_account_id"}]}},"typeVersion":1},{"id":"738cca7b-037d-46eb-930a-7705f1d62bcd","name":"Build SOQL query","type":"n8n-nodes-base.set","position":[2784,240],"parameters":{"options":{},"assignments":{"assignments":[{"id":"q-soql","name":"soql","type":"string","value":"={{ (() => { const c = $('Configure me').first().json; const ids = $json.sfdc_account_id.map(i => \"'\" + String(i).replace(/[^A-Za-z0-9]/g, '') + \"'\").join(', '); const since = $now.minus({ months: Number(c.closed_lost_lookback_months) || 12 }).toISODate(); const rf = String(c.loss_reason_field || '').trim(); const oppFields = ['Id', 'Name', 'CloseDate', 'Amount', 'StageName'].concat(rf ? [rf] : []).join(', '); const base = 'SELECT Id, Name, Website, OwnerId, Owner.Name, Owner.Email, (SELECT ' + oppFields + ' FROM Opportunities WHERE IsClosed = true AND IsWon = false ORDER BY CloseDate DESC LIMIT 1) FROM Account WHERE Id IN (' + ids + ')'; return c.match_mode === 'owned_accounts' ? base + ' AND Owner.IsActive = true' : base + ' AND Id IN (SELECT AccountId FROM Opportunity WHERE IsClosed = true AND IsWon = false AND CloseDate >= ' + since + ') AND Id NOT IN (SELECT AccountId FROM Opportunity WHERE IsClosed = false AND AccountId != null)'; })() }}"}]}},"typeVersion":3.4},{"id":"1a25227d-5df0-4884-b6a8-835857a98613","name":"Find matching Salesforce accounts","type":"n8n-nodes-base.salesforce","maxTries":3,"position":[3008,240],"parameters":{"query":"={{ $json.soql }}","resource":"search"},"credentials":{"salesforceOAuth2Api":{"id":"credential-id","name":"Salesforce account - Margaux"}},"retryOnFail":true,"typeVersion":1.1,"alwaysOutputData":true,"waitBetweenTries":3000},{"id":"c17768ca-359a-47c1-a5aa-8d5c894db0b8","name":"Batches of 40 accounts","type":"n8n-nodes-base.splitInBatches","position":[2336,128],"parameters":{"options":{},"batchSize":40},"typeVersion":3},{"id":"b7c0e08f-a519-4fe9-955b-27e3517a9c0a","name":"Newest signals first","type":"n8n-nodes-base.sort","position":[3488,0],"parameters":{"options":{},"sortFieldsUi":{"sortField":[{"order":"descending","fieldName":"triggered_at"}]}},"typeVersion":1},{"id":"2fc4477c-952d-4da9-825f-f17c78ba60ca","name":"One request per account and partner","type":"n8n-nodes-base.removeDuplicates","position":[3712,0],"parameters":{"compare":"selectedFields","options":{},"fieldsToCompare":"sfdc_id15,partner_name"},"typeVersion":2},{"id":"8699d22d-7b00-4e37-b356-4310971da34d","name":"Cap requests per run","type":"n8n-nodes-base.limit","position":[3936,0],"parameters":{"maxItems":"={{ Number($('Configure me').first().json.max_items_per_run) || 5 }}"},"typeVersion":1},{"id":"013e50ed-c932-4d46-95bb-bf53f83a38ca","name":"Research and draft intro request","type":"@n8n/n8n-nodes-langchain.agent","position":[4304,0],"parameters":{"text":"=Partner signal on one of our accounts.\n\nOur company: {{ $('Configure me').first().json.your_company_name }}\nAccount: {{ $json.our_account_name }} ({{ $json.account_domain }}), Salesforce Account Id {{ $json.sfdc_account_id }}\nOur account owner: {{ $json.owner_name }} {{ $json.owner_email }}\nOur last closed-lost opportunity: {{ $json.lost_opp_name || 'none in the window' }}, closed {{ $json.lost_opp_close_date || 'n/a' }}, amount {{ $json.lost_opp_amount || 'n/a' }}, loss reason: {{ $json.loss_reason }}\nPartner: {{ $json.partner_name }}\nPartner event: {{ $json.event_type === 'partner_deal_closed_won' ? 'closed-won a deal' : 'opened a deal' }} on {{ ($json.triggered_at || '').slice(0, 10) }}\nPartner deal: {{ $json.partner_deal_name }}, stage {{ $json.partner_deal_stage || 'unknown' }}, now {{ $json.partner_deal_status }}\nContacts the partner shared on its deal: {{ $json.partner_deal_contacts || 'none' }}","options":{"maxIterations":6,"systemMessage":"You help a B2B sales team ask a partner for a warm introduction. You get one Crossbeam partner deal signal on an account we lost (or one we own) plus our Salesforce context.\n\nResearch with the Crossbeam MCP tools, at most 3 tool calls in total:\n1. find_overlapping_partners with account_id set to the Salesforce Account Id, partner_name set to the partner, limit 5. Read partner_record.owner (name, email, title): this is the PARTNER's account owner for this account.\n2. find_partner_shared_contacts with the same account_id and partner_name, limit 5, to see which people the partner shares at the account.\n3. get_account_context only if you still miss key facts.\n\nThen write:\n- brief: at most 60 words for Slack. Why this is worth an intro now (timing of the partner deal vs our loss, the loss reason if known, any shared contact who overlaps with our lost deal).\n- partner_owner_name and partner_owner_email: only values returned by the tools. Never guess or build an email address. Use an empty string when the tools return none.\n- email_subject: short, specific, no hype.\n- email_body: plain text, at most 140 words, addressed to the partner's account owner and signed by our account owner. Reference their deal stage, say what we sell in one line if you know it, explain why a joint conversation helps the customer, and ask for a 15 minute call or a warm intro. No em-dashes, no bullet lists, no placeholders in square brackets.\n- confidence: high when the owner email came from the tools and the timing is strong, medium when the owner is known but the angle is weaker, low when the owner email is missing.\n\nOnly use facts from the input and the tools. Do not mention Crossbeam data you did not receive."},"promptType":"define","hasOutputParser":true},"typeVersion":3.1},{"id":"0562d55a-9ebf-42b7-a608-3feb49eecf7e","name":"Claude Sonnet","type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","position":[4208,224],"parameters":{"model":{"__rl":true,"mode":"list","value":"claude-sonnet-5","cachedResultName":"Claude Sonnet 5"},"options":{"maxTokensToSample":2048}},"typeVersion":1.6},{"id":"d951100a-9a6f-4cb9-b5e7-eb158aceef8b","name":"Crossbeam MCP (read only)","type":"@n8n/n8n-nodes-langchain.mcpClientTool","position":[4368,224],"parameters":{"include":"selected","options":{"timeout":120000},"endpointUrl":"https://mcp.crossbeam.com/mcp","includeTools":["find_overlapping_partners","find_partner_shared_contacts","get_account_context"],"authentication":"mcpOAuth2Api"},"credentials":{"mcpOAuth2Api":{"id":"credential-id","name":"Crossbeam MCP - PROD"}},"typeVersion":1.4},{"id":"7e3de630-1a20-4469-bd2f-2936fe03666e","name":"Intro request JSON","type":"@n8n/n8n-nodes-langchain.outputParserStructured","position":[4528,224],"parameters":{"jsonSchemaExample":"{ \"brief\": \"Globex opened a deal at Initech 3 weeks after we lost it on budget. Their AE Jane Doe owns the account and 2 shared contacts overlap with our lost champion.\", \"partner_owner_name\": \"Jane Doe\", \"partner_owner_email\": \"user@example.com\", \"email_subject\": \"Intro request: Initech\", \"email_body\": \"Hi Jane, ...\", \"confidence\": \"high\" }"},"typeVersion":1.3},{"id":"4b227648-e533-4683-872d-f8eb918748bf","name":"Combine context and draft","type":"n8n-nodes-base.set","position":[4656,0],"parameters":{"mode":"raw","options":{},"jsonOutput":"={{ JSON.stringify(Object.assign({}, $('Cap requests per run').item.json, $json.output || {})) }}"},"typeVersion":3.4},{"id":"db4f6d02-aa70-4b46-a546-23aa038206c5","name":"Keep drafts above confidence bar","type":"n8n-nodes-base.filter","position":[4880,0],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"kc-rank","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ ({ high: 3, medium: 2, low: 1 })[String($json.confidence || 'low').toLowerCase()] >= (({ high: 3, medium: 2, low: 1 })[String($('Configure me').first().json.min_confidence || 'low').toLowerCase()] || 1) }}","rightValue":""}]}},"typeVersion":2.2},{"id":"b7e8d861-23a8-4d5e-982a-4fb7f07f0eda","name":"Post brief to Slack","type":"n8n-nodes-base.slack","maxTries":3,"position":[5360,96],"webhookId":"13c11fd4-3d60-4abe-a9a8-7bb8129f39a4","parameters":{"text":"=:handshake: *Partner intro request ready for review*\n*Account:* {{ $json.account_url ? '<' + $json.account_url + '|' + $json.our_account_name.replace(/[|<>]/g, ' ') + '>' : $json.our_account_name }}{{ $json.account_domain ? ' (' + $json.account_domain + ')' : '' }}\n*Partner signal:* {{ $json.partner_name }} {{ $json.event_type === 'partner_deal_closed_won' ? 'closed-won a deal' : 'opened a deal' }}{{ $json.triggered_at ? ' on ' + $json.triggered_at.slice(0, 10) : '' }}{{ $json.partner_deal_stage ? ' (stage: ' + $json.partner_deal_stage + ')' : '' }}\n*Our last loss:* {{ $json.lost_opp_name ? $json.lost_opp_name + ', closed ' + $json.lost_opp_close_date + (($json.lost_opp_amount) ? ', amount ' + $json.lost_opp_amount : '') + ', reason: ' + $json.loss_reason : 'no closed-lost opportunity in the window' }}\n*Our owner:* {{ $json.owner_name }}\n*Partner account owner:* {{ $json.partner_owner_name || 'not found' }}{{ $json.partner_owner_email ? ' (' + $json.partner_owner_email + ')' : '' }}  |  *Confidence:* {{ $json.confidence }}\n\n{{ $json.brief }}","select":"channel","channelId":{"__rl":true,"mode":"id","value":"={{ $('Configure me').first().json.slack_channel }}"},"otherOptions":{"mrkdwn":true,"unfurl_links":false,"includeLinkToWorkflow":false},"authentication":"oAuth2"},"credentials":{"slackOAuth2Api":{"id":"credential-id","name":"Slack account - Margaux"}},"retryOnFail":true,"typeVersion":2.7,"waitBetweenTries":2000},{"id":"601ba397-798a-42dd-bb96-c58ea7910a58","name":"Ask for approval in thread","type":"n8n-nodes-base.slack","position":[5584,96],"webhookId":"d2e1754d-35c5-4f47-8301-d87e84f28fb2","parameters":{"select":"channel","message":"=*Draft intro email* to {{ $('Review one draft at a time').first().json.partner_owner_name || 'the partner account owner' }} {{ $('Review one draft at a time').first().json.partner_owner_email ? '<' + $('Review one draft at a time').first().json.partner_owner_email + '>' : '(no email found, add one in the form)' }}\n*Subject:* {{ $('Review one draft at a time').first().json.email_subject }}\n\n{{ $('Review one draft at a time').first().json.email_body }}\n\n_Open the form to approve, edit or skip. {{ $('Configure me').first().json.dry_run ? 'Dry run is on: nothing will be sent or written.' : ($('Configure me').first().json.send_mode === 'send' ? 'Approve sends the email from the connected Gmail account.' : 'Approve saves a Gmail draft.') }}_","options":{"thread_ts":{"replyValues":{"thread_ts":"={{ $json.message_timestamp || $json.ts }}"}},"limitWaitTime":{"values":{"resumeAmount":"={{ Number($('Configure me').first().json.approval_wait_hours) || 8 }}"}},"appendAttribution":false,"responseFormTitle":"Partner intro request","messageButtonLabel":"Review draft","responseFormButtonLabel":"Submit","responseFormDescription":"Edit the email if needed, then approve or skip."},"channelId":{"__rl":true,"mode":"id","value":"={{ $('Configure me').first().json.slack_channel }}"},"operation":"sendAndWait","formFields":{"values":[{"fieldName":"decision","fieldType":"dropdown","fieldLabel":"Decision","fieldOptions":{"values":[{"option":"Approve"},{"option":"Skip"}]},"requiredField":true},{"fieldName":"send_to","fieldType":"email","fieldLabel":"Send to","defaultValue":"={{ $('Review one draft at a time').first().json.partner_owner_email }}"},{"fieldName":"email_subject","fieldLabel":"Subject","defaultValue":"={{ $('Review one draft at a time').first().json.email_subject }}"},{"fieldName":"email_body","fieldType":"textarea","fieldLabel":"Email body","defaultValue":"={{ $('Review one draft at a time').first().json.email_body }}"}]},"responseType":"customForm","authentication":"oAuth2"},"credentials":{"slackOAuth2Api":{"id":"credential-id","name":"Slack account - Margaux"}},"typeVersion":2.7},{"id":"702649bc-7646-41d7-ae6f-24ee6cd99181","name":"Read reviewer decision","type":"n8n-nodes-base.set","position":[5808,96],"parameters":{"options":{},"assignments":{"assignments":[{"id":"rd-dec","name":"decision","type":"string","value":"={{ String($json.data?.decision ?? $json.data?.Decision ?? 'No response') }}"},{"id":"rd-to","name":"send_to","type":"string","value":"={{ String($json.data?.send_to ?? $json.data?.['Send to'] ?? $('Review one draft at a time').first().json.partner_owner_email ?? '').trim() }}"},{"id":"rd-subj","name":"email_subject","type":"string","value":"={{ $json.data?.email_subject || $json.data?.Subject || $('Review one draft at a time').first().json.email_subject }}"},{"id":"rd-body","name":"email_body","type":"string","value":"={{ $json.data?.email_body || $json.data?.['Email body'] || $('Review one draft at a time').first().json.email_body }}"},{"id":"rd-dry","name":"dry_run","type":"boolean","value":"={{ $('Configure me').first().json.dry_run !== false }}"}]}},"typeVersion":3.4},{"id":"689100b4-7dff-4ed5-a3d3-9f406ad5db51","name":"Route reviewer decision","type":"n8n-nodes-base.switch","position":[6112,240],"parameters":{"rules":{"values":[{"outputKey":"Skipped","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"rd-skip","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.decision }}","rightValue":"Skip"}]},"renameOutput":true},{"outputKey":"Approved, dry run","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"rd-a1","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.decision }}","rightValue":"Approve"},{"id":"rd-a2","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.dry_run }}","rightValue":""}]},"renameOutput":true},{"outputKey":"Approved, live","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"rd-l1","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.decision }}","rightValue":"Approve"},{"id":"rd-l2","operator":{"type":"boolean","operation":"false","singleValue":true},"leftValue":"={{ $json.dry_run }}","rightValue":""},{"id":"rd-l3","operator":{"type":"string","operation":"notEmpty","singleValue":true},"leftValue":"={{ $json.send_to }}","rightValue":""}]},"renameOutput":true}]},"options":{"fallbackOutput":"extra","renameFallbackOutput":"No response or no recipient"}},"typeVersion":3.2},{"id":"920809fc-c779-4bbf-be56-2e1ab198c593","name":"Status: skipped","type":"n8n-nodes-base.set","position":[6368,0],"parameters":{"options":{},"assignments":{"assignments":[{"id":"st-sk","name":"status","type":"string","value":"skipped"}]}},"typeVersion":3.4},{"id":"37492066-d56f-4493-9c33-c01c1ffd3405","name":"Record outcome","type":"n8n-nodes-base.dataTable","position":[7520,240],"parameters":{"columns":{"value":{"status":"={{ $json.status }}","event_key":"={{ $('Review one draft at a time').first().json.event_key }}","decided_at":"={{ $now.toISO() }}","account_name":"={{ $('Review one draft at a time').first().json.our_account_name }}","partner_name":"={{ $('Review one draft at a time').first().json.partner_name }}","sfdc_account_id":"={{ $('Review one draft at a time').first().json.sfdc_account_id }}","partner_owner_email":"={{ $('Read reviewer decision').first().json.send_to }}"},"schema":[{"id":"event_key","type":"string","display":true,"required":false,"displayName":"event_key","defaultMatch":false,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"required":false,"displayName":"status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"partner_name","type":"string","display":true,"required":false,"displayName":"partner_name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"account_name","type":"string","display":true,"required":false,"displayName":"account_name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"sfdc_account_id","type":"string","display":true,"required":false,"displayName":"sfdc_account_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"partner_owner_email","type":"string","display":true,"required":false,"displayName":"partner_owner_email","defaultMatch":false,"canBeUsedToMatch":true},{"id":"decided_at","type":"string","display":true,"required":false,"displayName":"decided_at","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[]},"options":{},"dataTableId":{"__rl":true,"mode":"list","value":""}},"typeVersion":1.1},{"id":"4505c5b6-fb57-4ad3-a402-51d38e408539","name":"Status: dry run","type":"n8n-nodes-base.set","position":[6368,160],"parameters":{"options":{},"assignments":{"assignments":[{"id":"st-dr","name":"status","type":"string","value":"dry_run"}]}},"typeVersion":3.4},{"id":"7f477b06-dd1a-4f37-9ddb-9f8520e5b07e","name":"Send now or save draft?","type":"n8n-nodes-base.if","position":[6368,352],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"sd-mode","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $('Configure me').first().json.send_mode }}","rightValue":"send"}]}},"typeVersion":2.2},{"id":"1c8f4b64-f3a4-44c6-b8dc-6759aef70a7b","name":"Send intro email (Gmail)","type":"n8n-nodes-base.gmail","position":[6592,272],"webhookId":"8905458b-1d77-46c8-ad0c-694045e86c6b","parameters":{"sendTo":"={{ $json.send_to }}","message":"={{ $json.email_body }}","options":{"appendAttribution":false},"subject":"={{ $json.email_subject }}","emailType":"text"},"typeVersion":2.1},{"id":"7a8c9cfc-e205-4f25-9075-fb9e46f18a31","name":"Log a Salesforce task?","type":"n8n-nodes-base.if","position":[6816,352],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"te-on","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $('Configure me').first().json.create_sfdc_task }}","rightValue":""}]}},"typeVersion":2.2},{"id":"e95d73f7-6a49-44b8-8f3c-64922ddb17d4","name":"Log task for our account owner","type":"n8n-nodes-base.salesforce","maxTries":3,"position":[7040,272],"parameters":{"status":"Not Started","resource":"task","additionalFields":{"owner":{"__rl":true,"mode":"id","value":"={{ $('Review one draft at a time').first().json.owner_id }}"},"whatId":"={{ $('Review one draft at a time').first().json.sfdc_account_id }}","subject":"=Follow up on partner intro: {{ $('Review one draft at a time').first().json.partner_name }} at {{ $('Review one draft at a time').first().json.our_account_name }}","priority":"Normal","description":"=Partner intro request {{ $('Configure me').first().json.send_mode === 'send' ? 'sent' : 'drafted in Gmail' }} to {{ $('Read reviewer decision').first().json.send_to }} ({{ $('Review one draft at a time').first().json.partner_name }}).\n\nSubject: {{ $('Read reviewer decision').first().json.email_subject }}\n\n{{ $('Read reviewer decision').first().json.email_body }}","activityDate":"={{ $today.plus({ days: 3 }).toISODate() }}"}},"credentials":{"salesforceOAuth2Api":{"id":"credential-id","name":"Salesforce account - Margaux"}},"retryOnFail":true,"typeVersion":1.1,"waitBetweenTries":3000},{"id":"53030d48-1899-41af-a74d-e8bfd8b95bfd","name":"Status: sent or drafted","type":"n8n-nodes-base.set","position":[7264,352],"parameters":{"options":{},"assignments":{"assignments":[{"id":"st-ap","name":"status","type":"string","value":"={{ $('Configure me').first().json.send_mode === 'send' ? 'sent' : 'drafted' }}"}]}},"typeVersion":3.4},{"id":"c6bb308e-0322-4cdb-8260-fd9170438b80","name":"Save intro email as Gmail draft","type":"n8n-nodes-base.gmail","position":[6592,432],"webhookId":"1a45169c-6342-4322-9e98-e0392a9fa9b6","parameters":{"message":"={{ $json.email_body }}","options":{"sendTo":"={{ $json.send_to }}"},"subject":"={{ $json.email_subject }}","resource":"draft"},"typeVersion":2.1},{"id":"22e848cf-9f8b-4e63-8de4-73a7dedb9b4b","name":"Status: no response","type":"n8n-nodes-base.set","position":[6368,672],"parameters":{"options":{},"assignments":{"assignments":[{"id":"st-nr","name":"status","type":"string","value":"no_response"}]}},"typeVersion":3.4},{"id":"3da6db31-f4e5-4a92-85ce-79d944115d7e","name":"Review one draft at a time","type":"n8n-nodes-base.splitInBatches","position":[5136,0],"parameters":{"options":{}},"typeVersion":3},{"id":"05edd519-8091-473f-9053-aaea67f77c6d","name":"Reply in thread with outcome","type":"n8n-nodes-base.slack","maxTries":3,"position":[7744,240],"webhookId":"e8fb58cc-c53b-4fd5-a232-337555b24d05","parameters":{"text":"={{ (() => { const d = $('Read reviewer decision').first().json; const task = $('Configure me').first().json.create_sfdc_task ? ' A Salesforce task was logged for ' + $('Review one draft at a time').first().json.owner_name + '.' : ''; return ({ sent: ':white_check_mark: Approved. Intro email sent to ' + d.send_to + '.' + task, drafted: ':white_check_mark: Approved. Gmail draft saved for ' + d.send_to + ', review it and hit send.' + task, dry_run: ':test_tube: Approved in dry run: nothing was sent or written. Set dry_run to false in Configure me to go live.', skipped: ':no_entry_sign: Skipped. This signal will not be suggested again.', no_response: ':hourglass_flowing_sand: No decision in time, or no partner owner email. Nothing was sent.' })[$json.status] || 'Done.'; })() }}","select":"channel","channelId":{"__rl":true,"mode":"id","value":"={{ $('Configure me').first().json.slack_channel }}"},"otherOptions":{"mrkdwn":true,"thread_ts":{"replyValues":{"thread_ts":"={{ $('Post brief to Slack').first().json.message_timestamp || $('Post brief to Slack').first().json.ts }}"}},"includeLinkToWorkflow":false},"authentication":"oAuth2"},"credentials":{"slackOAuth2Api":{"id":"credential-id","name":"Slack account - Margaux"}},"retryOnFail":true,"typeVersion":2.7,"waitBetweenTries":2000},{"id":"35345487-7618-4684-8d52-664f9ed8121a","name":"Overview","type":"n8n-nodes-base.stickyNote","position":[-1008,-400],"parameters":{"width":860,"height":940,"content":"## Draft partner intro emails from Crossbeam deal signals with Claude and Slack approval\n\n### Quick overview\nWhen a partner opens or wins a deal at an account you lost in Salesforce, Claude finds the partner's account owner with the Crossbeam MCP and drafts an intro request. A rep approves, edits or skips it in Slack before any email is sent.\n\n### How it works\n1. Every weekday, reads partner deal signals from the Crossbeam API (or a Crossbeam webhook on Enterprise).\n2. Native nodes keep new signals on Salesforce accounts you lost recently and have no open opportunity on.\n3. A Claude agent looks up the partner's account owner and shared contacts in Crossbeam, then writes a short brief and an intro email.\n4. Slack shows the draft in a form: approve, edit or skip.\n5. Only after approval, Gmail sends or drafts the email and a Salesforce task is logged. Every outcome is saved and replied in the thread.\n\n### Setup\n1. Create the credentials listed in the red note.\n2. Fill in every YOUR_ value in **Configure me** and invite the Slack app to your channel.\n3. Create the Data Table described in the gray note and select it in the two Data Table nodes.\n4. Keep dry_run true, run once and approve a draft in Slack.\n5. Set dry_run to false and activate. Enterprise only: register the webhook URL in Crossbeam.\n\n### Requirements\n- Crossbeam Supernode plan or above (Signals API) with MCP access\n- Salesforce, Anthropic (Claude), Slack with interactivity, Gmail\n\n### Customization\n- Filter by event type, partner, lookback and loss window in **Configure me**.\n- Use match_mode owned_accounts to cover every owned account.\n- Change the email tone in the agent's system message, or swap Gmail for Outlook.\n\n### Additional info\nCrossbeam surfaces partner deal signals natively. This template connects them to your own lost deals, drafts the partner intro and keeps a human approval before anything is sent.\n\nNext steps: add Claude to the channel (Claude in Slack) for follow-up questions, or enrich shared contacts with Clay."},"typeVersion":1},{"id":"f933e80d-1309-4372-8544-94450b79ecce","name":"Credentials setup","type":"n8n-nodes-base.stickyNote","position":[-1008,640],"parameters":{"color":3,"width":860,"height":1280,"content":"## Credentials setup\n\n**1. Crossbeam REST API (OAuth2 API)**\n1. In Crossbeam open Data > Integrations > Create Integration (Custom) and copy the Client ID and Client Secret.\n2. In n8n create an OAuth2 API credential: Grant Type Authorization Code, Authorization URL https://auth.crossbeam.com/authorize, Access Token URL https://auth.crossbeam.com/oauth/token, Scope openid offline_access read:partnerships, Auth URI Query Parameters audience=https://api.getcrossbeam.com (only the OAuth audience, API calls go to https://api.crossbeam.com).\n3. Paste n8n's OAuth Redirect URL as the callback URL of the Crossbeam integration, then click Connect.\n4. Get your organization UUID from GET https://api.crossbeam.com/v0.1/users/me and paste it into Configure me. Select the credential in **Fetch partner deal signals**.\n\n**2. Crossbeam MCP (MCP OAuth2 API)**\nCreate an MCP OAuth2 API credential with server URL https://mcp.crossbeam.com/mcp, click Connect and sign in to Crossbeam. Select it in **Crossbeam MCP (read only)**. Calls are credit metered.\n\n**3. Salesforce (Salesforce OAuth2 API)**\nConnect a user who can read Account and Opportunity and create Task. Select it in **Find matching Salesforce accounts** and **Log task for our account owner**.\n\n**4. Anthropic (Anthropic API)**\nPaste an API key from the Anthropic Console. Select it in **Claude Sonnet**.\n\n**5. Slack (Slack OAuth2 API)**\nUse a Slack app with chat:write and Interactivity turned on (the approval form needs it, see the n8n docs for Slack send and wait). Invite the app to your channel and select the credential in the three Slack nodes.\n\n**6. Gmail (Gmail OAuth2 API)**\nConnect the mailbox that sends or drafts the intro emails, usually a shared partnerships inbox or the rep's own. Select it in both Gmail nodes.\n\n**Crossbeam setup guides**\n- Create a Crossbeam custom integration (client ID, secret, callback URL): https://help.crossbeam.com/en/articles/4677142-rest-api\n- Crossbeam API reference (OAuth, endpoints, scopes): https://developers.crossbeam.com/\n- Signals API and webhooks (plan access, webhook setup): https://help.crossbeam.com/en/articles/12732223-getting-started-with-signals-how-to-access-real-time-partner-data-via-api-and-webhooks\n- Connect the Crossbeam MCP server (server URL, OAuth, plan access): https://help.crossbeam.com/en/articles/12601327-crossbeam-mcp-server-limited-availability"},"typeVersion":1},{"id":"65732109-abcf-46d8-ae3e-f799593e883b","name":"Note: start","type":"n8n-nodes-base.stickyNote","position":[176,-384],"parameters":{"color":7,"width":440,"height":220,"content":"### 1. Start and settings\nRuns every weekday morning, or instantly when Crossbeam calls the webhook (Enterprise plan). Every setting lives in **Configure me**. Leave dry_run on until you have reviewed a few drafts."},"typeVersion":1},{"id":"166cb6d7-79e8-41c8-b31a-a598dda31215","name":"Note: webhook","type":"n8n-nodes-base.stickyNote","position":[656,-368],"parameters":{"color":7,"width":640,"height":200,"content":"### 2a. Webhook check (Enterprise)\nChecks the HMAC signature and timestamp, answers 200 or 401. If you are not on Enterprise, disable the webhook node."},"typeVersion":1},{"id":"815455a2-3edf-40eb-9fa1-147760e8a6a9","name":"Note: poll","type":"n8n-nodes-base.stickyNote","position":[768,480],"parameters":{"color":7,"width":424,"height":120,"content":"### 2b. Poll partner deal signals\nGET /v1/signals/accounts, 1,000 events per page, following pagination.next_href. Events are not in time order, so every page is read and filtered next."},"typeVersion":1},{"id":"0742edbe-4b22-45c9-a735-d0600f8f2e34","name":"Note: filter","type":"n8n-nodes-base.stickyNote","position":[1360,-368],"parameters":{"color":7,"width":880,"height":204,"content":"### 3. Filter and dedupe\nKeeps signals inside the lookback window, of the chosen event types and partners, on a Salesforce account, where the partner deal is not lost. Drops events already handled in the Data Table (dry runs are ignored there, so you can re-test).\n\n**Data Table:** create a table with text columns event_key, status, partner_name, account_name, sfdc_account_id, partner_owner_email, decided_at and select it in **Skip events already handled** and **Record outcome**."},"typeVersion":1},{"id":"eaccd11c-7bd6-42e5-93c6-304f785bad83","name":"Note: salesforce","type":"n8n-nodes-base.stickyNote","position":[2288,-368],"parameters":{"color":7,"width":868,"height":200,"content":"### 4. Match in Salesforce (read only)\nOne SOQL query per 40 accounts. match_mode closed_lost (default) keeps accounts with a Closed Lost opportunity in the last N months and no open opportunity. match_mode owned_accounts keeps every account with an active owner."},"typeVersion":1},{"id":"6e37adc4-1e2c-4483-9ca7-ecc23e191c71","name":"Note: pick","type":"n8n-nodes-base.stickyNote","position":[3216,-352],"parameters":{"color":7,"width":884,"height":180,"content":"### 5. Pick what to review\nJoins each signal to its account, newest first, one request per account and partner, capped by max_items_per_run so Slack and MCP credits stay bounded."},"typeVersion":1},{"id":"3002c687-0e1f-4754-90bd-6053684339b4","name":"Note: AI","type":"n8n-nodes-base.stickyNote","position":[4160,-336],"parameters":{"color":7,"width":844,"height":156,"content":"### 6. Claude researches and drafts\nThe agent calls the Crossbeam MCP (max 3 read-only calls) to find the partner's account owner and shared contacts, then writes a Slack brief and an intro email as JSON. Drafts below min_confidence are dropped."},"typeVersion":1},{"id":"6bbdbdc2-2fcc-4f07-8f40-081ebab99c99","name":"Note: review","type":"n8n-nodes-base.stickyNote","position":[5088,-336],"parameters":{"color":7,"width":884,"height":168,"content":"### 7. Human review in Slack\nPosts the brief, then a thread message with a form: approve, edit the recipient, subject or body, or skip. The run waits up to approval_wait_hours per draft."},"typeVersion":1},{"id":"d49a6642-a623-45a4-8847-5c9e62b3e637","name":"Note: act","type":"n8n-nodes-base.stickyNote","position":[6064,-336],"parameters":{"color":7,"width":1560,"height":152,"content":"### 8. Act and log\nApproved and dry_run false: Gmail send (send_mode send) or Gmail draft (send_mode draft, default), then an optional Salesforce task for our owner. Dry run, skip and no response write nothing outside n8n. Every outcome is stored and replied in the thread."},"typeVersion":1},{"id":"bbd6a6fd-c369-4ac3-a9b1-8c522d2a5e32","name":"Receive Crossbeam webhook","type":"n8n-nodes-base.webhook","position":[16,-112],"webhookId":"17a2c54d-9450-4b39-bbf1-8ed71ea5ea28","parameters":{"path":"crossbeam-partner-intro-requests","options":{"rawBody":true},"httpMethod":"POST","responseMode":"responseNode"},"typeVersion":2.1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":true,"executionOrder":"v1"},"versionId":"62344621-6af5-46c8-a761-f161a999fc14","nodeGroups":[{"id":"8ba39df0-7312-4309-b669-2c0d21bea9e4","name":"1. Start and settings","nodeIds":["07a31183-ec1f-43c5-88ac-2a4afb9b8313","dce1c49d-37b7-4eaa-933c-422bc5303d25"],"description":"Holds every user setting and routes webhook calls and scheduled runs"},{"id":"c0b884c1-9f83-4227-9314-b4f00f6d8299","name":"2a. Webhook check (Enterprise)","nodeIds":["992327b7-5aa5-45fd-992a-2b09701d806b","799544f0-e961-4b73-860f-20f913a73ffa","cbe16231-1cfa-41b5-b927-e1f05518aec0","b8ad7ca4-7f71-4acf-a7ec-ae7e127162dd"],"description":"Verifies the HMAC signature and timestamp, answers 200 or 401"},{"id":"c3ec5a7b-d58e-40c9-b481-00d02ac63834","name":"2b. Poll partner deal signals","nodeIds":["b6aca5f6-4788-48aa-907d-31e7b7821fd0","41475123-3450-4742-bc62-7a8b8f17c97c"],"description":"Pages through GET /v1/signals/accounts and splits events into items"},{"id":"87653442-b4d7-4f9b-9037-42860683d155","name":"3. Filter and dedupe","nodeIds":["9c9b4f5b-f3c4-4158-a1c5-14e8069be641","b45d15cf-2145-47d6-9484-5100836be18c","b07c636f-bdfd-485c-b239-f57b3fbb1932","2d57c744-589f-4eb9-96a8-7b58710aa6d5"],"description":"Lookback, event type, partner and CRM filters, then drops events already handled"},{"id":"78c9441a-e6a5-4565-b8d3-cda6dd870c30","name":"4. Match in Salesforce","nodeIds":["c17768ca-359a-47c1-a5aa-8d5c894db0b8","90483ec9-d38a-4c6b-9ce5-a6f051d38dce","738cca7b-037d-46eb-930a-7705f1d62bcd","1a25227d-5df0-4884-b6a8-835857a98613","a45e2e33-76a6-49a0-abf6-6e8098d44dc7","c3c68c62-47a3-4d6b-835c-0551c52a7dd5"],"description":"Read-only SOQL per 40 accounts: closed lost with no open opp, or any owned account"},{"id":"0ea17589-c4a2-45b6-ba23-ecea90d1e4aa","name":"5. Pick what to review","nodeIds":["767778d5-6b8b-4eba-bc60-98a6c3642487","b7c0e08f-a519-4fe9-955b-27e3517a9c0a","2fc4477c-952d-4da9-825f-f17c78ba60ca","8699d22d-7b00-4e37-b356-4310971da34d"],"description":"Joins signals to accounts, newest first, one per account and partner, capped per run"},{"id":"6893eb4b-e840-4da9-a024-df684c9f3ffc","name":"6. Claude drafts the intro","nodeIds":["013e50ed-c932-4d46-95bb-bf53f83a38ca","0562d55a-9ebf-42b7-a608-3feb49eecf7e","d951100a-9a6f-4cb9-b5e7-eb158aceef8b","7e3de630-1a20-4469-bd2f-2936fe03666e","4b227648-e533-4683-872d-f8eb918748bf","db4f6d02-aa70-4b46-a546-23aa038206c5"],"description":"Claude uses the Crossbeam MCP to find the partner owner, writes a brief and an email"},{"id":"49b453a9-1057-4335-9afe-5b72cfb3fb36","name":"7. Human review in Slack","nodeIds":["3da6db31-f4e5-4a92-85ce-79d944115d7e","b7e8d861-23a8-4d5e-982a-4fb7f07f0eda","601ba397-798a-42dd-bb96-c58ea7910a58","702649bc-7646-41d7-ae6f-24ee6cd99181"],"description":"Posts the brief and waits for approve, edit or skip in the thread"},{"id":"0122d225-1f7b-47d9-b4ab-24daa3433469","name":"8. Act and log","nodeIds":["689100b4-7dff-4ed5-a3d3-9f406ad5db51","920809fc-c779-4bbf-be56-2e1ab198c593","4505c5b6-fb57-4ad3-a402-51d38e408539","22e848cf-9f8b-4e63-8de4-73a7dedb9b4b","7f477b06-dd1a-4f37-9ddb-9f8520e5b07e","1c8f4b64-f3a4-44c6-b8dc-6759aef70a7b","c6bb308e-0322-4cdb-8260-fd9170438b80","7a8c9cfc-e205-4f25-9075-fb9e46f18a31","e95d73f7-6a49-44b8-8f3c-64922ddb17d4","53030d48-1899-41af-a74d-e8bfd8b95bfd","37492066-d56f-4493-9c33-c01c1ffd3405","05edd519-8091-473f-9053-aaea67f77c6d"],"description":"Gmail send or draft and Salesforce task only after approval, then logs and replies"}],"connections":{"Configure me":{"main":[[{"node":"Webhook or schedule?","type":"main","index":0}]]},"Claude Sonnet":{"ai_languageModel":[[{"node":"Research and draft intro request","type":"ai_languageModel","index":0}]]},"Record outcome":{"main":[[{"node":"Reply in thread with outcome","type":"main","index":0}]]},"Status: dry run":{"main":[[{"node":"Record outcome","type":"main","index":0}]]},"Status: skipped":{"main":[[{"node":"Record outcome","type":"main","index":0}]]},"Build SOQL query":{"main":[[{"node":"Find matching Salesforce accounts","type":"main","index":0}]]},"Signature valid?":{"main":[[{"node":"Acknowledge webhook (200)","type":"main","index":0}],[{"node":"Reject webhook (401)","type":"main","index":0}]]},"Intro request JSON":{"ai_outputParser":[[{"node":"Research and draft intro request","type":"ai_outputParser","index":0}]]},"Collect Account Ids":{"main":[[{"node":"Build SOQL query","type":"main","index":0}]]},"Keep accounts found":{"main":[[{"node":"Shape Salesforce account","type":"main","index":0}]]},"One item per signal":{"main":[[{"node":"Shape signal fields","type":"main","index":0}]]},"Post brief to Slack":{"main":[[{"node":"Ask for approval in thread","type":"main","index":0}]]},"Shape signal fields":{"main":[[{"node":"Keep fresh, in-scope signals","type":"main","index":0}]]},"Status: no response":{"main":[[{"node":"Record outcome","type":"main","index":0}]]},"Cap requests per run":{"main":[[{"node":"Research and draft intro request","type":"main","index":0}]]},"Newest signals first":{"main":[[{"node":"One request per account and partner","type":"main","index":0}]]},"Webhook or schedule?":{"main":[[{"node":"Verify webhook signature","type":"main","index":0}],[{"node":"Fetch partner deal signals","type":"main","index":0}]]},"Batches of 40 accounts":{"main":[[{"node":"Keep accounts found","type":"main","index":0}],[{"node":"Collect Account Ids","type":"main","index":0}]]},"Every weekday at 08:45":{"main":[[{"node":"Configure me","type":"main","index":0}]]},"Log a Salesforce task?":{"main":[[{"node":"Log task for our account owner","type":"main","index":0}],[{"node":"Status: sent or drafted","type":"main","index":0}]]},"Read reviewer decision":{"main":[[{"node":"Route reviewer decision","type":"main","index":0}]]},"Remove duplicate events":{"main":[[{"node":"Skip events already handled","type":"main","index":0}]]},"Route reviewer decision":{"main":[[{"node":"Status: skipped","type":"main","index":0}],[{"node":"Status: dry run","type":"main","index":0}],[{"node":"Send now or save draft?","type":"main","index":0}],[{"node":"Status: no response","type":"main","index":0}]]},"Send now or save draft?":{"main":[[{"node":"Send intro email (Gmail)","type":"main","index":0}],[{"node":"Save intro email as Gmail draft","type":"main","index":0}]]},"Status: sent or drafted":{"main":[[{"node":"Record outcome","type":"main","index":0}]]},"Join signals to accounts":{"main":[[{"node":"Newest signals first","type":"main","index":0}]]},"Send intro email (Gmail)":{"main":[[{"node":"Log a Salesforce task?","type":"main","index":0}]]},"Shape Salesforce account":{"main":[[{"node":"Join signals to accounts","type":"main","index":1}]]},"Verify webhook signature":{"main":[[{"node":"Signature valid?","type":"main","index":0}]]},"Acknowledge webhook (200)":{"main":[[{"node":"Shape signal fields","type":"main","index":0}]]},"Combine context and draft":{"main":[[{"node":"Keep drafts above confidence bar","type":"main","index":0}]]},"Crossbeam MCP (read only)":{"ai_tool":[[{"node":"Research and draft intro request","type":"ai_tool","index":0}]]},"Receive Crossbeam webhook":{"main":[[{"node":"Configure me","type":"main","index":0}]]},"Ask for approval in thread":{"main":[[{"node":"Read reviewer decision","type":"main","index":0}]]},"Fetch partner deal signals":{"main":[[{"node":"One item per signal","type":"main","index":0}]]},"Review one draft at a time":{"main":[[],[{"node":"Post brief to Slack","type":"main","index":0}]]},"Skip events already handled":{"main":[[{"node":"Join signals to accounts","type":"main","index":0},{"node":"Batches of 40 accounts","type":"main","index":0}]]},"Keep fresh, in-scope signals":{"main":[[{"node":"Remove duplicate events","type":"main","index":0}]]},"Reply in thread with outcome":{"main":[[{"node":"Review one draft at a time","type":"main","index":0}]]},"Log task for our account owner":{"main":[[{"node":"Status: sent or drafted","type":"main","index":0}]]},"Save intro email as Gmail draft":{"main":[[{"node":"Log a Salesforce task?","type":"main","index":0}]]