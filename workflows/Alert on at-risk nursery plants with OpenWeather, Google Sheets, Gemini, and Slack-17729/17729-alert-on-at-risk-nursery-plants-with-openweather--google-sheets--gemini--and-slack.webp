{"id":"UxxOOBxqz9Rj41k3","meta":{"instanceId":"93f396852104089b8670e7494b0f3668b420464668ae4a8c1d6b4b5799f8e3ef","templateCredsSetupCompleted":true},"name":"Automated Plant Nursery Monitoring Project","tags":[],"nodes":[{"id":"3d1a9db2-510a-44b6-a6d3-a0ee6ff67fd5","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-1616,-352],"parameters":{"width":480,"height":672,"content":"## Untitled workflow\n\n### How it works\n\n1. The workflow triggers daily at 7 PM IST to check the upcoming weather.\n2. It retrieves local weather data and current plant inventory from Google Sheets.\n3. An AI agent analyzes the weather forecast against plant needs to identify risks.\n4. If any plants are at risk, the workflow constructs and sends a Slack alert.\n\n### Setup steps\n\n- - [ ] Configure the Schedule Trigger for your preferred time zone.\n- - [ ] Set your OpenWeatherMap API key and coordinates in the Config node.\n- - [ ] Connect your Google Sheet containing the plant inventory data.\n- - [ ] Add your Google Gemini API key to the AI Agent credentials.\n- - [ ] Choose a valid Slack channel."},"typeVersion":1},{"id":"dd3753a4-7f5e-4921-bcf9-d7494026009f","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-1056,-352],"parameters":{"color":7,"width":864,"height":272,"content":"## Fetch and process weather data\n\nTrigger the daily weather check and retrieve the forecast."},"typeVersion":1},{"id":"e52b0eb9-7f24-43df-a343-99aa7f4da352","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[-160,-352],"parameters":{"color":7,"width":640,"height":272,"content":"## Retrieve inventory and build prompt\n\nFetch plant data and prepare the AI prompt."},"typeVersion":1},{"id":"2c85f6a5-e916-4f50-a953-45147d59cad6","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[512,-352],"parameters":{"color":7,"width":544,"height":496,"content":"## Analyze data with Gemini AI\n\nAnalyze plant risk using the AI agent."},"typeVersion":1},{"id":"4f06717f-5f4a-4667-b54d-c1710466422b","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[1088,-352],"parameters":{"color":7,"width":640,"height":272,"content":"## Conditional alert and notification delivery\n\nEvaluate risk and notify via Slack."},"typeVersion":1},{"id":"8db1fc3a-de48-4a43-aa82-e8622135990c","name":"Every Day at 7pm IST","type":"n8n-nodes-base.scheduleTrigger","position":[-1008,-240],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"30 13 * * *"}]}},"typeVersion":1.2},{"id":"cc880343-50ca-4a66-bacd-056745af493b","name":"Set Weather Parameters","type":"n8n-nodes-base.set","position":[-784,-240],"parameters":{"options":{},"assignments":{"assignments":[{"id":"cfg-lat","name":"lat","type":"string","value":"17.3850"},{"id":"cfg-lon","name":"lon","type":"string","value":"78.4867"},{"id":"cfg-units","name":"units","type":"string","value":"imperial"}]}},"typeVersion":3.4},{"id":"f136650f-5461-46d3-8fae-4dbdc1fd02bc","name":"Fetch Weather Forecast","type":"n8n-nodes-base.httpRequest","position":[-560,-240],"parameters":{"url":"https://api.openweathermap.org/data/2.5/forecast","options":{},"sendQuery":true,"authentication":"genericCredentialType","genericAuthType":"httpQueryAuth","queryParameters":{"parameters":[{"name":"lat","value":"={{ $json.lat }}"},{"name":"lon","value":"={{ $json.lon }}"},{"name":"units","value":"={{ $json.units }}"}]}},"credentials":{"httpQueryAuth":{"id":"mzuHSivaRonvwVLB","name":"weatherapi"}},"typeVersion":4.2},{"id":"96e6dbf8-ddc5-4672-9e3d-bf129de929d6","name":"Summarize Overnight Weather","type":"n8n-nodes-base.set","position":[-336,-240],"parameters":{"options":{},"assignments":{"assignments":[{"id":"sum-low","name":"overnight_low_f","type":"number","value":"={{ Math.min(...$json.list.slice(0,8).map(i => i.main.temp_min)) }}"},{"id":"sum-high","name":"overnight_high_f","type":"number","value":"={{ Math.max(...$json.list.slice(0,8).map(i => i.main.temp_max)) }}"},{"id":"sum-cond","name":"conditions","type":"string","value":"={{ $json.list[0].weather[0].description }}"},{"id":"sum-window","name":"forecast_window","type":"string","value":"={{ $json.list[0].dt_txt }} to {{ $json.list[7].dt_txt }}"}]}},"typeVersion":3.4},{"id":"85aae180-9b4a-4f01-a38a-597b7d2f6976","name":"Read Plants from Sheets","type":"n8n-nodes-base.googleSheets","position":[-112,-240],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"list","value":"gid=0","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1IaS6CTDF3zjndUy_fqKfx4AsoQjdvmUsawVRFqowI8g/edit#gid=0","cachedResultName":"Sheet1"},"documentId":{"__rl":true,"mode":"list","value":"1IaS6CTDF3zjndUy_fqKfx4AsoQjdvmUsawVRFqowI8g","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1IaS6CTDF3zjndUy_fqKfx4AsoQjdvmUsawVRFqowI8g/edit?usp=drivesdk","cachedResultName":"Plants Records"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"mYRmmCMyWcLawmcE","name":"Google Service Account account"}},"typeVersion":4.5},{"id":"ec4f72f5-2d7f-4398-8fc9-3d3cb74f2853","name":"Aggregate Plants List","type":"n8n-nodes-base.aggregate","position":[112,-240],"parameters":{"options":{},"aggregate":"aggregateAllItemData","destinationFieldName":"plants"},"typeVersion":1},{"id":"946d723e-9172-4e2d-a644-c6c9b61ba863","name":"Parse AI Response","type":"n8n-nodes-base.set","position":[912,-240],"parameters":{"options":{},"assignments":{"assignments":[{"id":"parse-alerts","name":"alerts","type":"array","value":"={{ $json.output.alerts }}"}]}},"typeVersion":3.4},{"id":"2109a5a8-893f-4f7e-bb80-ed93aced3753","name":"If Plants at Risk","type":"n8n-nodes-base.if","position":[1136,-240],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"if-risk-cond","operator":{"type":"number","operation":"gt"},"leftValue":"={{ $json.alerts.length }}","rightValue":0}]}},"typeVersion":2.2},{"id":"88da0c47-3504-48ab-9709-dc62ba3fad9d","name":"Build Plant Risk Prompt","type":"n8n-nodes-base.set","position":[336,-240],"parameters":{"options":{},"assignments":{"assignments":[{"id":"prompt-build","name":"prompt","type":"string","value":"=You are a horticultural risk analyst. Cross-reference tonight's forecast against each plant's temperature tolerance and flag anything at risk.\n\nFORECAST:\nWindow: {{ $('Summarize Overnight Weather').item.json.forecast_window }}\nOvernight low: {{ $('Summarize Overnight Weather').item.json.overnight_low_f }}°F\nDaytime high: {{ $('Summarize Overnight Weather').item.json.overnight_high_f }}°F\nConditions: {{ $('Summarize Overnight Weather').item.json.conditions }}\n\nINVENTORY:\n{{ JSON.stringify($json.plants) }}\n\nFlag any plant whose tolerance range does not cover the forecast low/high. Be specific and urgent in the message."}]}},"typeVersion":3.4},{"id":"7cacaf37-0411-454c-a398-5558e63851c6","name":"Prepare Alert Message","type":"n8n-nodes-base.set","position":[1360,-256],"parameters":{"options":{},"assignments":{"assignments":[{"id":"d9fcff10-0f07-4ea3-b579-34c8873bc1e4","name":"message","type":"string","value":"={{ \"⚠️ **CRITICAL PLANT ALERTS** ⚠️\\n\\n\" + $json.alerts.map(alert => `🌱 Plant: ${alert.plant_name} (Batch: ${alert.batch_id})\\n🚨 ${alert.message}`).join('\\n\\n') }}"}]}},"typeVersion":3.5},{"id":"9fb81fb4-3b6c-4aeb-88d2-0bbd59dd9952","name":"Parse AI Output Structure","type":"@n8n/n8n-nodes-langchain.outputParserStructured","position":[768,0],"parameters":{"schemaType":"manual","inputSchema":"={\n  \"alerts\": [\n    {\n      \"plant_name\": \"Monstera Albo\",\n      \"batch_id\": \"B-102\",\n      \"risk_type\": \"frost\",\n      \"message\": \"Move the Monstera Albo indoors tonight—temps dropping to 40°F, well below its 50°F minimum tolerance.\"\n    },\n    {\n      \"plant_name\": \"Anthurium Crystallinum\",\n      \"batch_id\": \"B-105\",\n      \"risk_type\": \"frost\",\n      \"message\": \"Bring Anthurium Crystallinum inside now—forecast low of 40°F is 18°F under its 58°F minimum, high risk of leaf damage.\"\n    }\n  ]\n}"},"typeVersion":1.3},{"id":"fb877bb4-ac5e-431b-9c8f-44e8bb7f5dc3","name":"Google Gemini Model","type":"@n8n/n8n-nodes-langchain.lmChatGoogleGemini","position":[560,0],"parameters":{"options":{},"modelName":"models/gemini-3.1-flash-lite"},"credentials":{"googlePalmApi":{"id":"x2sCC1GX3iizemFd","name":"vaar@blankarray"}},"typeVersion":1.1},{"id":"1553f155-4add-443c-8692-24a66e0ef4e3","name":"Plant Risk Analyzer Agent","type":"@n8n/n8n-nodes-langchain.agent","position":[560,-240],"parameters":{"text":"={{ $json.prompt }}","options":{"systemMessage":"You are a horticultural risk analyst for a specialty plant nursery. You only output structured alert data — never conversational text. If no plants are at risk, return an empty alerts array."},"promptType":"define","hasOutputParser":true},"typeVersion":3.1},{"id":"7d2b0de5-e41a-482e-a05a-b209da53260a","name":"Send a message","type":"n8n-nodes-base.slack","position":[1536,-256],"webhookId":"f385c560-3077-4bf2-96a9-824ef98854dd","parameters":{"text":"={{ $json.message }}","select":"channel","channelId":{"__rl":true,"mode":"list","value":"C0B8VH1M5PX","cachedResultName":"general"},"otherOptions":{}},"credentials":{"slackApi":{"id":"uBs2LjzTiloElvwT","name":"Slack account 2"}},"typeVersion":2.5}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","callerPolicy":"workflowsFromSameOwner","timeSavedMode":"fixed","availableInMCP":true,"executionOrder":"v1"},"versionId":"0600a860-9833-48ad-bb2a-686b6a5ac4a2","nodeGroups":[],"connections":{"If Plants at Risk":{"main":[[{"node":"Prepare Alert Message","type":"main","index":0}]]},"Parse AI Response":{"main":[[{"node":"If Plants at Risk","type":"main","index":0}]]},"Google Gemini Model":{"ai_languageModel":[[{"node":"Plant Risk Analyzer Agent","type":"ai_languageModel","index":0}]]},"Every Day at 7pm IST":{"main":[[{"node":"Set Weather Parameters","type":"main","index":0}]]},"Aggregate Plants List":{"main":[[{"node":"Build Plant Risk Prompt","type":"main","index":0}]]},"Prepare Alert Message":{"main":[[{"node":"Send a message","type":"main","index":0}]]},"Fetch Weather Forecast":{"main":[[{"node":"Summarize Overnight Weather","type":"main","index":0}]]},"Set Weather Parameters":{"main":[[{"node":"Fetch Weather Forecast","type":"main","index":0}]]},"Build Plant Risk Prompt":{"main":[[{"node":"Plant Risk Analyzer Agent","type":"main","index":0}]]},"Read Plants from Sheets":{"main":[[{"node":"Aggregate Plants List","type":"main","index":0}]]},"Parse AI Output Structure":{"ai_outputParser":[[{"node":"Plant Risk Analyzer Agent","type":"ai_outputParser","index":0}]]},"Plant Risk Analyzer Agent":{"main":[[{"node":"Parse AI Response","type":"main","index":0}]]},"Summarize Overnight Weather":{"main":[[{"node":"Read Plants from Sheets","type":"main","index":0}]]}}}