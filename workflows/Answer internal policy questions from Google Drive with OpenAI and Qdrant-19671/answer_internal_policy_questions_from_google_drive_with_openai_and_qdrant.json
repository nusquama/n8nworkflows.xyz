{"id":"U7bv30qFbS8j4urb","meta":{"instanceId":"a5925672c1c1d5613a7bfd347269edc98458b5a7e08f0bf7445ee5349c8e0d91"},"name":"Answer internal policy questions from Google Drive docs with OpenAI and Qdrant","tags":[],"nodes":[{"id":"f7434c41-94f5-436b-b0e5-e80636901a8f","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-80,16],"parameters":{"width":480,"height":896,"content":"## Self-Updating Internal Document Support Bot\n\n### How it works\n\nThis workflow keeps an internal support knowledge base updated from Google Drive and answers user questions from chat or Slack. New or updated Drive files are downloaded, routed by file type, converted or extracted to text, then re-indexed into Qdrant with OpenAI embeddings. Incoming chat and Slack questions are normalized, answered by an AI agent using Qdrant retrieval, and Slack-originated requests are posted back to Slack with formatted citations.\n\n### Setup steps\n\n- Configure Google Drive OAuth credentials and set the Drive trigger folders/events for created and updated files.\n- Configure the HTTP request nodes that call Google Drive APIs for DOCX conversion/export/deletion, including OAuth scopes for Drive file copy, export, and delete operations.\n- Configure Qdrant credentials, collection name, and the delete-by-file_id endpoint so old vectors are removed before re-inserting updated content.\n- Configure OpenAI credentials for both ingestion embeddings, query embeddings, and the chat model used by the AI Agent.\n- Configure Slack trigger and Slack post-message credentials, channels, bot permissions, and filtering rules to ignore irrelevant events or bot messages.\n\n### Customization\n\nAdjust supported MIME-type routes, text splitter chunk size/overlap, Qdrant metadata fields, retrieval settings, Slack citation formatting, and the AI Agent prompt to match internal documentation and response style."},"typeVersion":1},{"id":"1ff757b0-fe35-40eb-aef5-86eba107eac2","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[480,176],"parameters":{"color":7,"width":416,"height":320,"content":"## Created file intake\n\nWatches Google Drive for newly created files and downloads the new file content for ingestion."},"typeVersion":1},{"id":"615ba526-766c-4b70-a4d2-abcc72d6dfd1","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[480,528],"parameters":{"color":7,"width":416,"height":320,"content":"## Updated file intake\n\nWatches Google Drive for file updates and downloads the modified file content so existing knowledge can be refreshed."},"typeVersion":1},{"id":"6e8b6610-51bf-4f8e-9bf2-3011559bda82","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[928,240],"parameters":{"color":7,"width":416,"height":384,"content":"## Merge and route files\n\nCombines created and updated file streams, then branches processing based on each file's MIME type."},"typeVersion":1},{"id":"a9cdb8a8-ce31-4c48-82f0-367aa081ad08","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[1600,16],"parameters":{"color":7,"width":416,"height":720,"content":"## Direct text extraction\n\nExtracts text directly from supported PDF, Google Doc, and TXT inputs, then funnels the results through a shared extracted-text pass-through node."},"typeVersion":1},{"id":"f3e10941-7813-44ae-aacd-51c16a64e7fc","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[1376,768],"parameters":{"color":7,"width":640,"height":368,"content":"## DOCX conversion path\n\nHandles DOCX-like files by copying them to a temporary Google Doc, exporting that document as text, and deleting the temporary document afterward."},"typeVersion":1},{"id":"7af1a508-67fd-4607-b74b-e056737daab3","name":"Sticky Note6","type":"n8n-nodes-base.stickyNote","position":[2048,272],"parameters":{"color":7,"height":368,"content":"## Remove stale vectors\n\nDeletes previously stored Qdrant vectors for the current file_id before inserting the refreshed document content."},"typeVersion":1},{"id":"ad9ec7b5-43a8-4834-b80b-e874255810b2","name":"Sticky Note7","type":"n8n-nodes-base.stickyNote","position":[2320,320],"parameters":{"color":7,"width":400,"height":768,"content":"## Insert document vectors\n\nChunks extracted documents, creates OpenAI embeddings, loads document data, and inserts the new vectors into Qdrant."},"typeVersion":1},{"id":"3bca0e76-14bb-40b7-9458-9d1c398935b5","name":"Sticky Note8","type":"n8n-nodes-base.stickyNote","position":[480,992],"parameters":{"color":7,"width":416,"height":320,"content":"## Slack question intake\n\nReceives Slack events and filters them before passing valid user messages into the shared question pipeline."},"typeVersion":1},{"id":"5c1f7b91-3aeb-4a6f-8e46-9604e4e946bd","name":"Sticky Note9","type":"n8n-nodes-base.stickyNote","position":[656,1344],"parameters":{"color":7,"height":336,"content":"## Chat question intake\n\nReceives direct chat messages from the built-in chat interface as a second user-input channel."},"typeVersion":1},{"id":"0101958a-8fad-4bbf-92d8-de5e324e0380","name":"Sticky Note10","type":"n8n-nodes-base.stickyNote","position":[928,1072],"parameters":{"color":7,"width":416,"height":336,"content":"## Normalize incoming questions\n\nStandardizes chat and Slack inputs into common fields such as userInput, sessionId, channel, and threadTs, then merges the input streams for the AI agent."},"typeVersion":1},{"id":"ec6204f2-5c3a-4cdd-8736-1a80b299e824","name":"Sticky Note11","type":"n8n-nodes-base.stickyNote","position":[1376,1168],"parameters":{"color":7,"width":528,"height":768,"content":"## Generate grounded answer\n\nUses an AI Agent with an OpenAI chat model, window memory, Qdrant retrieval tool, and query embeddings to answer questions from the indexed internal documents."},"typeVersion":1},{"id":"2aa80549-7e3d-4856-8b1d-35fe35d626dc","name":"Sticky Note12","type":"n8n-nodes-base.stickyNote","position":[2048,1120],"parameters":{"color":7,"width":640,"height":320,"content":"## Format and reply\n\nFormats the agent response with citations, checks whether the request originated in Slack, and posts the final answer back to Slack when appropriate."},"typeVersion":1},{"id":"54261f1e-baa4-4ab0-aaac-2491633c69f1","name":"When File Created in Drive","type":"n8n-nodes-base.googleDriveTrigger","position":[528,336],"parameters":{"event":"fileCreated","options":{},"pollTimes":{"item":[{"mode":"everyMinute"}]},"triggerOn":"specificFolder","folderToWatch":{"__rl":true,"mode":"list","value":"1OMm12f0vxmfuLjM0D0Fq2bFzR20qP37m","cachedResultUrl":"https://drive.google.com/drive/folders/1OMm12f0vxmfuLjM0D0Fq2bFzR20qP37m","cachedResultName":"RAG"}},"typeVersion":1},{"id":"44604a3a-6089-4d82-84d1-286a5941909a","name":"Download Created File","type":"n8n-nodes-base.googleDrive","position":[752,336],"parameters":{"fileId":{"__rl":true,"mode":"id","value":"={{ $json.id }}"},"options":{"binaryPropertyName":"data","googleFileConversion":{"conversion":{"docsToFormat":"text/plain"}}},"operation":"download"},"typeVersion":3},{"id":"6645bfec-51bb-469e-bd68-6e5fa45f8299","name":"When File Updated in Drive","type":"n8n-nodes-base.googleDriveTrigger","position":[528,688],"parameters":{"event":"fileUpdated","options":{},"pollTimes":{"item":[{"mode":"everyMinute"}]},"triggerOn":"specificFolder","folderToWatch":{"__rl":true,"mode":"list","value":"1OMm12f0vxmfuLjM0D0Fq2bFzR20qP37m","cachedResultUrl":"https://drive.google.com/drive/folders/1OMm12f0vxmfuLjM0D0Fq2bFzR20qP37m","cachedResultName":"RAG"}},"typeVersion":1},{"id":"67c528e9-a188-4c3c-abb7-e12bdbfbc73e","name":"Download Updated File","type":"n8n-nodes-base.googleDrive","position":[752,688],"parameters":{"fileId":{"__rl":true,"mode":"id","value":"={{ $json.id }}"},"options":{"googleFileConversion":{"conversion":{"docsToFormat":"text/plain"}}},"operation":"download"},"typeVersion":3},{"id":"822042a9-9249-466d-a64f-9e5804649f5f","name":"Merge Files for Processing","type":"n8n-nodes-base.merge","position":[976,432],"parameters":{},"typeVersion":3},{"id":"4dc43640-88f1-4cab-b3e5-8eeadb1ea7f3","name":"Route by File Type","type":"n8n-nodes-base.switch","position":[1200,400],"parameters":{"rules":{"values":[{"outputKey":"PDF","conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $binary.data.mimeType }}","rightValue":"application/pdf"}]},"renameOutput":true},{"outputKey":"GoogleDoc","conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.mimeType }}","rightValue":"application/vnd.google-apps.document"}]},"renameOutput":true},{"outputKey":"DOCX","conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $binary.data.mimeType }}","rightValue":"application/vnd.openxmlformats-officedocument.wordprocessingml.document"}]},"renameOutput":true},{"outputKey":"TXT","conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $binary.data.mimeType }}","rightValue":"text/plain"}]},"renameOutput":true}]},"options":{}},"typeVersion":3},{"id":"bea380a9-6b88-48a0-a011-01f68aee34c1","name":"Extract Text from PDF","type":"n8n-nodes-base.extractFromFile","position":[1648,192],"parameters":{"options":{},"operation":"pdf"},"typeVersion":1},{"id":"63e64784-8c2a-4538-b796-0dd3216d60ff","name":"Text Extraction Output","type":"n8n-nodes-base.noOp","position":[1872,480],"parameters":{},"typeVersion":1},{"id":"5f5c922e-387a-4855-ba21-43a921192eaa","name":"Delete Vectors by File ID","type":"n8n-nodes-base.httpRequest","position":[2096,480],"parameters":{"url":"https://99330883-72b4-4e17-821a-b9b1a7f5b89f.us-west-2-0.aws.cloud.qdrant.io:6333/collections/company_docs/points/delete?wait=true","method":"POST","options":{},"jsonBody":"={{ JSON.stringify({ filter: { must: [{ key: \"metadata.file_id\", match: { value: $('When File Created in Drive').isExecuted ? $('When File Created in Drive').item.json.id : $('When File Updated in Drive').item.json.id } }] } }) }}","sendBody":true,"specifyBody":"json","authentication":"predefinedCredentialType","nodeCredentialType":"qdrantRestApi"},"typeVersion":4.5},{"id":"a59b1a64-cfde-4f29-8af7-e8f6dfdbab6c","name":"Insert into Qdrant Vector Store","type":"@n8n/n8n-nodes-langchain.vectorStoreQdrant","position":[2400,480],"parameters":{"mode":"insert","options":{},"qdrantCollection":{"__rl":true,"mode":"list","value":"company_docs"}},"typeVersion":1},{"id":"9a19ec81-e820-49b4-903e-5aad64b3ac1f","name":"Generate OpenAI Embeddings","type":"@n8n/n8n-nodes-langchain.embeddingsOpenAi","position":[2368,720],"parameters":{"model":"text-embedding-3-small","options":{}},"typeVersion":1},{"id":"b80fce6f-8b3c-4bca-993d-7e25e9950bc0","name":"Load Default Data","type":"@n8n/n8n-nodes-langchain.documentDefaultDataLoader","position":[2496,720],"parameters":{"options":{"metadata":{"metadataValues":[{"name":"file_id","value":"={{ $('When File Created in Drive').isExecuted ? $('When File Created in Drive').item.json.id : $('When File Updated in Drive').item.json.id }}"},{"name":"file_name","value":"={{ $('When File Created in Drive').isExecuted ? $('When File Created in Drive').item.json.name : $('When File Updated in Drive').item.json.name }}"},{"name":"drive_url","value":"={{ $('When File Created in Drive').isExecuted ? $('When File Created in Drive').item.json.webViewLink : $('When File Updated in Drive').item.json.webViewLink }}"},{"name":"last_modified","value":"={{ $('When File Created in Drive').isExecuted ? $('When File Created in Drive').item.json.modifiedTime : $('When File Updated in Drive').item.json.modifiedTime }}"}]}},"jsonData":"={{ $('Text Extraction Output').item.json.text }}","jsonMode":"expressionData"},"typeVersion":1},{"id":"d8f19e63-8d91-4caa-a84f-7d2b0ae11ab5","name":"Split Text Recursively","type":"@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter","position":[2576,928],"parameters":{"options":{},"chunkOverlap":200},"typeVersion":1},{"id":"01f7391e-5970-476e-b2fa-60b71948e0cb","name":"Extract Text from Google Doc","type":"n8n-nodes-base.extractFromFile","position":[1648,384],"parameters":{"options":{},"operation":"text"},"typeVersion":1},{"id":"a17a07ee-e11d-44f6-95b0-a526072c57b1","name":"Extract Text from TXT","type":"n8n-nodes-base.extractFromFile","position":[1648,576],"parameters":{"options":{},"operation":"text"},"typeVersion":1},{"id":"3257ddb7-b914-40d1-a5b9-d7ea2cf33d5f","name":"Chat Message Trigger","type":"@n8n/n8n-nodes-langchain.chatTrigger","position":[704,1520],"webhookId":"chat-trigger-webhook","parameters":{"public":true,"options":{},"initialMessages":"Hi there! 👋 I'm IntuzBot, your internal knowledge base assistant. Ask me anything about our company docs, policies, or procedures!"},"typeVersion":1.1},{"id":"f061d361-206b-49e1-b38e-12e7956a47a0","name":"Merge Chat and Slack Data","type":"n8n-nodes-base.merge","position":[1200,1248],"parameters":{},"typeVersion":3},{"id":"7888732a-7a99-47dc-a1a1-41b066f02267","name":"Support AI Agent","type":"@n8n/n8n-nodes-langchain.agent","position":[1488,1328],"parameters":{"text":"={{ $json.userInput }}","options":{"systemMessage":"You are IntuzBot, the internal support assistant for Intuz.\n\nYour job is to help employees understand company policies and internal documents in a clear, friendly, human way.\n\n## Identity and greetings\n\nIf the user asks who you are, what your name is, or what you do, answer directly without using the knowledge-base tool:\n\n\"Hi! I'm IntuzBot 👋 I’m Intuz’s internal support assistant. I can help you understand company policies, procedures, and other information from our internal knowledge base.\"\n\nIf the user says hello, hi, hey, good morning, or similar, greet them naturally and ask how you can help.\n\nIf the user says thank you, that's all, or goodbye, respond with a short, friendly closing.\n\nDo not use the knowledge-base tool for greetings, identity questions, small talk, thanks, or goodbyes.\n\n## Knowledge-base questions\n\nFor questions about company policies, procedures, employment rules, benefits, support processes, or internal documentation, use the company_knowledge_base tool before answering.\n\nUse only the information returned by the tool. Do not use general knowledge or invent information.\n\n## Answering style\n\nDo not copy or repeat the retrieved document word-for-word unless the user explicitly asks for the exact wording or a quotation.\n\nInstead:\n\n1. Understand the user's question.\n2. Find the relevant rule in the retrieved context.\n3. Explain it in simple, natural language.\n4. Preserve the exact meaning and important conditions.\n5. Mention any uncertainty or missing details.\n6. Cite the source document at the end of the relevant explanation.\n\nFor example, if the document says:\n\n\"If you will leave the company without giving notice period, Company can adjust your notice pay amount with full and final settlement.\"\n\nDo not simply repeat that sentence.\n\nAnswer in a clearer form, such as:\n\n\"If an employee leaves without serving the required notice period, the company may recover or adjust the applicable notice-period pay from the employee’s full and final settlement. The exact amount and process may depend on the employee’s notice-period terms and applicable company policy. [Source: Employee Policy Document](DRIVE_URL)\"\n\nDo not add a specific notice-period duration, amount, exception, or legal interpretation unless it appears in the retrieved context.\n\n## Missing information\n\nIf the knowledge-base tool does not return relevant information, say:\n\n\"I couldn’t find a clear answer to that in the knowledge base. You may want to check with HR or rephrase the question.\"\n\nDo not guess.\n\n## Citations\n\nFor factual answers, cite the source document using this format:\n\n[Source: {file_name}]({drive_url})\n\nUse the document name and Drive link from the retrieved metadata. Do not invent a filename or URL.\n\n## Human support style\n\nBe warm, respectful, concise, and helpful.\n\nUse simple language and explain policy meaning rather than dumping document text.\n\nWhen a policy could affect an employee’s salary, notice pay, leave, employment status, or full and final settlement, avoid presenting the response as legal advice. Clearly distinguish between what the document says and what is not specified.\n\nIf the document does not contain enough detail, recommend contacting HR instead of making assumptions."},"promptType":"define"},"typeVersion":1.7},{"id":"b1543948-7cea-4bec-b366-ce0eecf80592","name":"Buffer Memory Storage","type":"@n8n/n8n-nodes-langchain.memoryBufferWindow","position":[1552,1648],"parameters":{"sessionKey":"={{ $json.sessionId }}","sessionIdType":"customKey","contextWindowLength":12},"typeVersion":1.3},{"id":"8a57a8f1-cabe-4491-a15e-117805b8ee0a","name":"OpenAI GPT-4 Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[1424,1648],"parameters":{"model":"gpt-4o-mini","options":{}},"typeVersion":1},{"id":"fbf6e574-e6fb-49a5-82ce-0b0c2f27e36e","name":"Retrieve from Qdrant Vector Store","type":"@n8n/n8n-nodes-langchain.vectorStoreQdrant","position":[1680,1648],"parameters":{"mode":"retrieve-as-tool","topK":5,"options":{},"toolName":"company_knowledge_base","toolDescription":"Searches internal company documents (policies, guides, manifests) synced from Google Drive. Use this ONLY for factual questions about company procedures, policies, or documentation — never for greetings, identity questions, or small talk.","qdrantCollection":{"__rl":true,"mode":"list","value":"company_docs"}},"typeVersion":1},{"id":"159a2a20-6e54-4835-952d-c2d8766661ad","name":"Query OpenAI Embeddings","type":"@n8n/n8n-nodes-langchain.embeddingsOpenAi","position":[1760,1776],"parameters":{"model":"text-embedding-3-small","options":{}},"typeVersion":1},{"id":"fe04ebac-8ee3-401c-a446-2d46b1897455","name":"Format Citations for Messaging","type":"n8n-nodes-base.code","position":[2096,1280],"parameters":{"jsCode":"const origin = $('Normalize Message Data').item.json.origin || '';\nconst text = $json.output || $json.text || '';\nconst formatted = text.replace(/\\[Source:\\s*(.+?)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g, (_, name, url) => `<${url}|${name}>`);\nreturn [{ json: { ...$json, origin, formatted } }];"},"typeVersion":2},{"id":"2aedfa40-68d1-49fd-ad5a-e95ba95d8379","name":"Check If Origin Is Slack","type":"n8n-nodes-base.if","position":[2320,1280],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.origin }}","rightValue":"slack"}]}},"typeVersion":2},{"id":"eb11c32e-7ce9-4b8b-b83f-423b7915f70b","name":"Post Message to Slack","type":"n8n-nodes-base.slack","position":[2544,1280],"webhookId":"e67d78c0-b624-4b8a-b2cc-646b0451bb62","parameters":{"text":"={{ $json.formatted }}","select":"channel","channelId":{"__rl":true,"mode":"id","value":"={{ $('When Slack Event Occurs').item.json.channel }}"},"otherOptions":{"thread_ts":{"replyValues":{"thread_ts":"={{ $('When Slack Event Occurs').item.json.event_ts }}"}}}},"typeVersion":2.2},{"id":"47111caf-65de-4996-8aa2-9863a66b9493","name":"Normalize Message Data","type":"n8n-nodes-base.set","position":[976,1248],"parameters":{"options":{},"assignments":{"assignments":[{"id":"7ab873a2-47a8-4b95-9486-389ad37581e5","name":"userInput","type":"string","value":"={{ $json.chatInput || $json.text }}"},{"id":"a6b8a51a-5b31-4b34-99e6-dcc0f121554e","name":"sessionId","type":"string","v