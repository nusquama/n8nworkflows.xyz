{"id":"FhLa1FCJLYS0ki6i","meta":{"instanceId":"9f24379abd1ca05a3f590fdaa874ca82fbc5e1188798d609d51d2a8f6bacb662"},"name":"Invoice Exception Root Cause Analysis Workflow (Procurement & Finance Industry)","tags":[],"nodes":[{"id":"8a206347-a80e-400d-80d1-382353e87251","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[128,1136],"parameters":{"color":2,"width":752,"height":544,"content":"## Data Ingestion & Prep\nTriggers weekly to fetch raw invoice exception data from Google Sheets and groups it by exception reason for efficient analysis."},"typeVersion":1},{"id":"bbea1171-8130-45da-b91c-ff7053bc05ec","name":"Trigger: Weekly Schedule","type":"n8n-nodes-base.scheduleTrigger","position":[176,1328],"parameters":{"rule":{"interval":[{"field":"weeks","triggerAtDay":[1],"triggerAtHour":9}]}},"typeVersion":1.3},{"id":"62f13e0c-823f-496b-b11e-49a2c9dcd687","name":"Fetch: Invoice Exceptions","type":"n8n-nodes-base.googleSheets","position":[464,1328],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"list","value":"gid=0","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1lzCKhzXrxjrbtZ_OHAbH_4xi9EIAjF70yweuJ9U-IPY/edit#gid=0","cachedResultName":"Sheet1"},"documentId":{"__rl":true,"mode":"list","value":"1lzCKhzXrxjrbtZ_OHAbH_4xi9EIAjF70yweuJ9U-IPY","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1lzCKhzXrxjrbtZ_OHAbH_4xi9EIAjF70yweuJ9U-IPY/edit?usp=drivesdk","cachedResultName":"N - 170 Invoices"}},"typeVersion":4.7},{"id":"03ebb841-6840-4f65-83dd-401ff5710cdc","name":"Group Exceptions","type":"n8n-nodes-base.code","position":[720,1328],"parameters":{"jsCode":"const exceptions = $input.all().map(item => item.json);\nconst grouped = {};\n\nexceptions.forEach(ex => {\n  const reason = ex.Exception_Reason;\n  \n  if (!grouped[reason]) {\n    grouped[reason] = {\n      count: 0,\n      total_amount: 0,\n      invoices: []\n    };\n  }\n  \n  // Increment counts and amounts\n  grouped[reason].count += 1;\n  grouped[reason].total_amount += ex.Amount;\n  \n  // Add specific invoice details for the AI's context\n  grouped[reason].invoices.push({\n    invoice_id: ex.Invoice_ID,\n    vendor: ex.Vendor_Name,\n    notes: ex.Notes\n  });\n});\n\n// n8n expects an array of objects, so we wrap our grouped object\nreturn [{ json: { exception_summary: grouped } }];"},"typeVersion":2},{"id":"b3591f8e-6ed2-4f20-90f4-5ce834c192b4","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[944,1136],"parameters":{"color":2,"width":720,"height":544,"content":"## Root Cause Analysis (AI)\nLeverages an LLM to analyze grouped exceptions, identify patterns, and generate a structured root cause hypothesis for each specific category."},"typeVersion":1},{"id":"07dde2a6-bc5e-4ac4-b4d1-791bb407b59d","name":"AI: Root Cause Analysis","type":"@n8n/n8n-nodes-langchain.chainLlm","position":[1056,1328],"parameters":{"text":"=Here is this week's grouped exception data. Please analyze the root causes:\n\n{{ JSON.stringify($json.exception_summary, null, 2) }}","batching":{},"messages":{"messageValues":[{"message":"You are a senior Procurement and Finance Operations Analyst. Your job is to analyze weekly invoice exception summaries and identify the likely root causes behind these delays. Look for patterns in vendors, dollar amounts, and exception types. Provide a concise, analytical root cause analysis for each category."}]},"promptType":"define","hasOutputParser":true},"typeVersion":1.9},{"id":"414fa6de-c7fb-4ca9-a990-214382a2c55d","name":"LLM: Groq RCA","type":"@n8n/n8n-nodes-langchain.lmChatGroq","position":[1040,1536],"parameters":{"model":"openai/gpt-oss-120b","options":{}},"credentials":{"groqApi":{"id":"AnindwaoyRCy8KlP","name":"Groq (Mihir-Gmail)"}},"typeVersion":1},{"id":"b78dc828-9484-45f0-b535-09fa306ccf22","name":"Parser: RCA Output","type":"@n8n/n8n-nodes-langchain.outputParserStructured","position":[1216,1536],"parameters":{"schemaType":"manual","inputSchema":"{\n  \"name\": \"root_cause_analysis\",\n  \"description\": \"Analyzes invoice exceptions and provides structured root cause hypotheses.\",\n  \"strict\": true,\n  \"schema\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"overall_summary\": {\n        \"type\": \"string\",\n        \"description\": \"A high-level overview of the week's exception patterns and financial impact.\"\n      },\n      \"categories\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"exception_type\": {\n              \"type\": \"string\",\n              \"description\": \"The name of the exception category, e.g., 'Missing Receipt'.\"\n            },\n            \"financial_impact\": {\n              \"type\": \"number\",\n              \"description\": \"The total dollar amount tied up in this exception category.\"\n            },\n            \"root_cause_hypothesis\": {\n              \"type\": \"string\",\n              \"description\": \"The analytical hypothesis of why this is happening based on vendors and notes.\"\n            },\n            \"priority_level\": {\n              \"type\": \"string\",\n              \"enum\": [\"High\", \"Medium\", \"Low\"],\n              \"description\": \"Priority based on the financial amount and volume.\"\n            }\n          },\n          \"required\": [\n            \"exception_type\",\n            \"financial_impact\",\n            \"root_cause_hypothesis\",\n            \"priority_level\"\n          ],\n          \"additionalProperties\": false\n        }\n      }\n    },\n    \"required\": [\n      \"overall_summary\",\n      \"categories\"\n    ],\n    \"additionalProperties\": false\n  }\n}"},"typeVersion":1.3},{"id":"de81e1d2-8621-4000-87d0-9fdf965ef556","name":"Extract: RCA Data","type":"n8n-nodes-base.set","position":[1456,1328],"parameters":{"options":{},"assignments":{"assignments":[{"id":"fd30e94f-773c-4621-b12d-3dcf4f3d1171","name":"root_cause_analysis","type":"string","value":"={{ $json.output }}"}]}},"typeVersion":3.5},{"id":"55e77616-1e1a-4434-af64-94e8e11ba681","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[1728,1136],"parameters":{"color":2,"width":672,"height":544,"content":"## Process Improvement (AI)\nPrompts a second AI model to recommend strategic, upstream process fixes based on the root cause analysis, outputting structured arrays."},"typeVersion":1},{"id":"b892811b-2142-4d33-8bd9-2c2dd45e796e","name":"AI: Recommend Fixes","type":"@n8n/n8n-nodes-langchain.chainLlm","position":[1856,1328],"parameters":{"text":"=Based on this root cause analysis, please provide strategic upstream fixes for each category:\n{{ $json.root_cause_analysis }}\n","batching":{},"messages":{"messageValues":[{"message":"You are a Process Improvement Consultant for Procurement and Finance. Given a root cause analysis of invoice exceptions, your task is to recommend proactive, upstream process fixes to prevent these exceptions from occurring in the future. Focus on automation, vendor communication, and systemic controls rather than manual retroactive fixes.\nFor each exception category, explicitly list the affected Invoice IDs before providing the process fixes.\nNOTE: \noutput should be strictly in structured json format."}]},"promptType":"define","hasOutputParser":true},"typeVersion":1.9},{"id":"6a7fb22c-7ad5-49c7-8c81-e3d9a9f623d1","name":"LLM: Groq Fixes","type":"@n8n/n8n-nodes-langchain.lmChatGroq","position":[1840,1536],"parameters":{"model":"qwen/qwen3.8-27b","options":{}},"credentials":{"groqApi":{"id":"AnindwaoyRCy8KlP","name":"Groq (Mihir-Gmail)"}},"typeVersion":1},{"id":"ba380419-b179-4d36-875f-c146e88f9e73","name":"Parser: Fixes Output","type":"@n8n/n8n-nodes-langchain.outputParserStructured","position":[2016,1536],"parameters":{"schemaType":"manual","inputSchema":"{\n  \"type\": \"object\",\n  \"properties\": {\n    \"exceptions\": {\n      \"type\": \"array\",\n      \"description\": \"List of exception categories and their corresponding upstream fixes.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"exception_type\": {\n            \"type\": \"string\",\n            \"description\": \"The category of the exception, e.g., 'Missing Receipt'.\"\n          },\n          \"upstream_fixes\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"description\": \"List of actionable recommendations to prevent this exception.\"\n          }\n        },\n        \"required\": [\n          \"exception_type\",\n          \"upstream_fixes\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"exceptions\"\n  ]\n}"},"typeVersion":1.3},{"id":"4d775a1d-e51f-459c-b137-3f2b41a31e9b","name":"Extract: Fixes Data","type":"n8n-nodes-base.set","position":[2224,1328],"parameters":{"options":{"ignoreConversionErrors":true},"assignments":{"assignments":[{"id":"3b432dfd-a537-4d2d-a04e-b9e2f31842a9","name":"Missing Receipt","type":"object","value":"={{ $json.output.exceptions.find(e => e.exception_type === \"Missing Receipt\")?.upstream_fixes ?? [] }}"},{"id":"0633c48b-7a6c-41f4-bec0-2c8ef884a1d3","name":"Price Variance","type":"object","value":"={{ $json.output.exceptions.find(e => e.exception_type === \"Price Variance\")?.upstream_fixes ?? [] }}"},{"id":"a8d4f1a4-f39e-475a-81e1-72e5943d7d0d","name":"Tax Mismatch","type":"object","value":"={{ $json.output.exceptions.find(e => e.exception_type === \"Tax Mismatch\")?.upstream_fixes ?? [] }}"},{"id":"ca3ccc85-8c2b-4605-8d9d-237520dfff04","name":"Missing PO","type":"object","value":"={{ $json.output.exceptions.find(e => e.exception_type === \"Missing PO\")?.upstream_fixes ?? [] }}"}]}},"typeVersion":3.5},{"id":"0cf8841c-f5e3-4397-95bb-49b7b739326c","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[2464,1136],"parameters":{"color":2,"width":640,"height":544,"content":"## Report Generation & Formatting\nConverts the structured AI recommendations into a clean Markdown string, then meticulously translates it line-by-line into native Notion JSON blocks."},"typeVersion":1},{"id":"5942a034-14f3-4751-bd1b-e39458e94475","name":"Generate Markdown Report","type":"n8n-nodes-base.code","position":[2624,1328],"parameters":{"jsCode":"const data = $input.first().json;\nconst date = new Date().toISOString().split('T')[0];\n\nlet markdown = `# Invoice Exception Root Cause Analysis\\n**Date:** ${date}\\n\\n`;\nmarkdown += `## Strategic Upstream Process Fixes\\n\\n`;\n\n// Loop through each dynamic key (Missing Receipt, Price Variance, etc.)\nfor (const [exceptionType, fixesArray] of Object.entries(data)) {\n  // Ignore n8n hidden properties if they exist\n  if (exceptionType === \"pairedItem\") continue; \n\n  markdown += `### ${exceptionType}\\n`;\n  \n  // Iterate through the array of fixes\n  if (Array.isArray(fixesArray)) {\n    fixesArray.forEach(fix => {\n      markdown += `- ${fix}\\n`;\n    });\n  }\n  \n  markdown += `\\n`;\n}\n\nmarkdown += `---\\n*Generated automatically by n8n Procurement & Finance Automation*`;\n\nreturn [{ json: { notion_report: markdown } }];"},"typeVersion":2},{"id":"ec06e89a-194b-4cf4-aea6-fb0e9cfcd82c","name":"Convert Markdown to Blocks","type":"n8n-nodes-base.code","position":[2896,1328],"parameters":{"jsCode":"// 1. Get the Markdown string from the previous node\nconst markdown = $input.first().json.notion_report;\n\n// 2. Split it into individual lines\nconst lines = markdown.split('\\n');\nconst blocks = [];\n\n// 3. Loop through each line and convert it to a native Notion block\nlines.forEach(line => {\n  const text = line.trim();\n  \n  // Skip empty lines (Notion adds its own padding natively)\n  if (!text) return; \n\n  if (text.startsWith('# ')) {\n    blocks.push({\n      \"object\": \"block\", \"type\": \"heading_1\",\n      \"heading_1\": { \"rich_text\": [{\"type\": \"text\", \"text\": {\"content\": text.substring(2)}}] }\n    });\n  } else if (text.startsWith('## ')) {\n    blocks.push({\n      \"object\": \"block\", \"type\": \"heading_2\",\n      \"heading_2\": { \"rich_text\": [{\"type\": \"text\", \"text\": {\"content\": text.substring(3)}}] }\n    });\n  } else if (text.startsWith('### ')) {\n    blocks.push({\n      \"object\": \"block\", \"type\": \"heading_3\",\n      \"heading_3\": { \"rich_text\": [{\"type\": \"text\", \"text\": {\"content\": text.substring(4)}}] }\n    });\n  } else if (text.startsWith('- ')) {\n    // Converts \"- Item\" into a proper bullet point\n    blocks.push({\n      \"object\": \"block\", \"type\": \"bulleted_list_item\",\n      \"bulleted_list_item\": { \"rich_text\": [{\"type\": \"text\", \"text\": {\"content\": text.substring(2)}}] }\n    });\n  } else if (text === '---') {\n    blocks.push({\n      \"object\": \"block\", \"type\": \"divider\",\n      \"divider\": {}\n    });\n  } else if (text.includes('**Date:**')) {\n    // Handles the bold date text\n    blocks.push({\n      \"object\": \"block\", \"type\": \"paragraph\",\n      \"paragraph\": {\n        \"rich_text\": [\n          {\"type\": \"text\", \"text\": {\"content\": \"Date: \"}, \"annotations\": {\"bold\": true}},\n          {\"type\": \"text\", \"text\": {\"content\": text.replace('**Date:** ', '')}}\n        ]\n      }\n    });\n  } else if (text.startsWith('*') && text.endsWith('*')) {\n    // Handles the italicized footer\n    blocks.push({\n      \"object\": \"block\", \"type\": \"paragraph\",\n      \"paragraph\": {\n        \"rich_text\": [{\"type\": \"text\", \"text\": {\"content\": text.replace(/\\*/g, '')}, \"annotations\": {\"italic\": true}}]\n      }\n    });\n  } else {\n    // Fallback for standard paragraph text\n    blocks.push({\n      \"object\": \"block\", \"type\": \"paragraph\",\n      \"paragraph\": { \"rich_text\": [{\"type\": \"text\", \"text\": {\"content\": text}}] }\n    });\n  }\n});\n\n// 4. Output the finalized Notion blocks\nreturn [{ json: { blocks: blocks } }];"},"typeVersion":2},{"id":"86132e85-5a27-4126-b117-2f14395412c8","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[3168,1136],"parameters":{"color":2,"width":768,"height":544,"content":"## Publishing & Notification\nCreates a new Notion page shell, injects the formatted native blocks via API, and sends a final Slack alert automatically."},"typeVersion":1},{"id":"82272be8-11cf-4ce1-ba98-341f75f717bd","name":"Notion: Create Page","type":"n8n-nodes-base.notion","position":[3264,1328],"parameters":{"title":"=Invoice Exception Report - {{$today.toFormat('yyyy-MM-dd')}}","blockUi":{"blockValues":[]},"options":{},"resource":"databasePage","dataSourceId":{"__rl":true,"mode":"list","value":"3dc31eba-a729-8031-b1a3-000b75662fb8","cachedResultUrl":"https://app.notion.com/p/3dc31ebaa7298012a6c8d237c3c2dcab","cachedResultName":"N-170 Invoice Reports"}},"typeVersion":3},{"id":"11b33c27-3b34-4b3f-8bcc-a6ed138d4547","name":"Notion: Inject Blocks API","type":"n8n-nodes-base.httpRequest","position":[3504,1328],"parameters":{"url":"=https://api.notion.com/v1/blocks/{{ $json.id }}/children","method":"PATCH","options":{},"jsonBody":"={\"children\": {{ JSON.stringify($('Convert Markdown to Blocks').item.json.blocks) }}}","sendBody":true,"sendHeaders":true,"specifyBody":"json","authentication":"predefinedCredentialType","headerParameters":{"parameters":[{"name":"Notion-Version","value":"2026-09-15"}]},"nodeCredentialType":"notionApi"},"typeVersion":4.5},{"id":"31ab66a9-8895-47fa-8157-e4f678674a4c","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[-768,1040],"parameters":{"width":832,"height":640,"content":"## Workflow Overview: Invoice Exception Root Cause Analysis\n\nThis workflow functions as an automated **Process Improvement Engine** for procurement and finance operations. It aggregates weekly invoice exceptions from Google Sheets, leverages AI to identify systemic patterns causing these delays, and recommends proactive, upstream process fixes. By automating the analysis of recurring issues—such as missing receipts or tax mismatches—it helps leadership shift from manual retroactive fixes to long-term systemic controls, ultimately publishing a formatted report in Notion.\n\n## Setup Steps\n\n**Trigger: Weekly Schedule** — Start the workflow automatically every week.\n**Fetch: Invoice Exceptions** — Pull the latest raw invoice exception data from Google Sheets.\n**Group Exceptions** — Consolidate the invoices by exception reason and calculate the financial impact.\n**AI: Root Cause Analysis** — Analyze patterns to determine the systemic cause behind each category.\n**Extract: RCA Data** — Isolate the structured root cause hypotheses from the AI output.\n**AI: Recommend Fixes** — Generate actionable, upstream process improvements for each identified issue.\n**Extract: Fixes Data** — Map the recommended fixes reliably using exact exception type matching.\n**Generate Markdown Report** — Compile the AI analysis into a structured Markdown document.\n**Convert Markdown to Blocks** — Translate the Markdown line-by-line into native Notion JSON blocks.\n**Notion: Create Page** — Generate a blank report page in the Notion database.\n**Notion: Inject Blocks API** — Push the native Notion blocks into the newly created page.\n**Slack: Notify Teams** — Alert the procurement and finance channels that the weekly report is ready."},"typeVersion":1},{"id":"056d2b2e-c8e3-4ac1-b8cf-778a40ae6c18","name":"Send a message","type":"n8n-nodes-base.slack","position":[3728,1328],"webhookId":"e9116d4e-0217-49c2-9e96-9793daf88a4d","parameters":{"otherOptions":{}},"typeVersion":2.6}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":false,"executionOrder":"v1"},"versionId":"caa3c93a-74e4-4b44-acea-dd615b384ed0","nodeGroups":[],"connections":{"LLM: Groq RCA":{"ai_languageModel":[[{"node":"AI: Root Cause Analysis","type":"ai_languageModel","index":0}]]},"LLM: Groq Fixes":{"ai_languageModel":[[{"node":"AI: Recommend Fixes","type":"ai_languageModel","index":0}]]},"Group Exceptions":{"main":[[{"node":"AI: Root Cause Analysis","type":"main","index":0}]]},"Extract: RCA Data":{"main":[[{"node":"AI: Recommend Fixes","type":"main","index":0}]]},"Parser: RCA Output":{"ai_outputParser":[[{"node":"AI: Root Cause Analysis","type":"ai_outputParser","index":0}]]},"AI: Recommend Fixes":{"main":[[{"node":"Extract: Fixes Data","type":"main","index":0}]]},"Extract: Fixes Data":{"main":[[{"node":"Generate Markdown Report","type":"main","index":0}]]},"Notion: Create Page":{"main":[[{"node":"Notion: Inject Blocks API","type":"main","index":0}]]},"Parser: Fixes Output":{"ai_outputParser":[[{"node":"AI: Recommend Fixes","type":"ai_outputParser","index":0}]]},"AI: Root Cause Analysis":{"main":[[{"node":"Extract: RCA Data","type":"main","index":0}]]},"Generate Markdown Report":{"main":[[{"node":"Convert Markdown to Blocks","type":"main","index":0}]]},"Trigger: Weekly Schedule":{"main":[[{"node":"Fetch: Invoice Exceptions","type":"main","index":0}]]},"Fetch: Invoice Exceptions":{"main":[[{"node":"Group Exceptions","type":"main","index":0}]]},"Notion: Inject Blocks API":{"main":[[{"node":"Send a message","type":"main","index":0}]]},"Convert Markdown to Blocks":{"main":[[{"node":"Notion: Create Page","type":"main","index":0}]]}}}