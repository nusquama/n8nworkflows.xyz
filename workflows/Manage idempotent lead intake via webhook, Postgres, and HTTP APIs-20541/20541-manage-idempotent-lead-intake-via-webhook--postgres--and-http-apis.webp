{"id":"a7ldLty8xYKwUCqw","meta":{"instanceId":"dd69efaf8212c74ad206700d104739d3329588a6f3f8381a46a481f34c9cc281","templateCredsSetupCompleted":true},"name":"Idempotent Lead Management - Duplicate Prevention","tags":[],"nodes":[{"id":"bdbd656c-f650-45ff-9595-d0a735403487","name":"Sticky Note - Overview","type":"n8n-nodes-base.stickyNote","position":[-1856,-528],"parameters":{"width":720,"height":1100,"content":"## Idempotent Lead Management\n\n### How it works\nA single POST with a client-supplied Idempotency-Key is guaranteed to process the lead at most once, even under retries, timeouts or concurrent duplicates.\n\n1. Webhook validates + fingerprints the payload, then atomically claims the key in Postgres.\n2. **New key** → continues to enrichment → score → CRM → notify.\n3. **Completed key** → stored response is replayed as-is.\n4. **Key in flight** → returns 409 so the client retries shortly.\n5. **Key reused with different payload** → rejected with 422.\n\nOnly a freshly claimed key reaches the external APIs. The same Idempotency-Key is forwarded where useful.\n\n### Node budget\n- 4 Code nodes\n- 3 HTTP Request (API) nodes\n- 2 Wait nodes\n\n### Setup\n- Add Postgres credentials to the three Postgres nodes.\n- Replace the three provider URLs in CONFIG (Code - Validate & Fingerprint).\n- Review leaseSeconds, timeouts, allowedSources, maxScoreThreshold.\n- Test with curl: two identical POSTs with the same Idempotency-Key must return the same body (second has Idempotent-Replayed: true).\n- Set allowSimulation=false in production."},"typeVersion":1},{"id":"9bb9dc9a-6474-4c55-8edb-1bba4d4b21c1","name":"Sticky Note - Intake","type":"n8n-nodes-base.stickyNote","position":[-1088,-528],"parameters":{"color":5,"width":630,"height":520,"content":"## 1. Intake & store setup\nReceives the lead and ensures the idempotency_keys table + unique indexes exist (self-provisioning)."},"typeVersion":1},{"id":"bb6bd514-2853-4a48-b579-9830455c3b50","name":"Sticky Note - Validate & claim","type":"n8n-nodes-base.stickyNote","position":[-432,-528],"parameters":{"color":4,"width":630,"height":560,"content":"## 2. Validate & claim the key\nValidates headers/payload, scopes Idempotency-Key per client, fingerprints the canonical body, then claims the key in one atomic SQL statement."},"typeVersion":1},{"id":"a7cab326-3129-4b7f-9aae-cfcf7af58367","name":"Sticky Note - Route","type":"n8n-nodes-base.stickyNote","position":[224,-528],"parameters":{"color":5,"width":630,"height":560,"content":"## 3. Route the request\nInterprets claim result → execute / replay / in_progress / mismatch / duplicate / invalid / store_unavailable.\nOnly \"execute\" continues to the APIs."},"typeVersion":1},{"id":"b5b36679-bbe5-42bc-902b-d2f9186f6f9d","name":"Sticky Note - Process & respond","type":"n8n-nodes-base.stickyNote","position":[896,-528],"parameters":{"color":4,"width":3008,"height":1100,"content":"## 4. Process \n\nProcesses a claimed lead through enrichment, scoring, CRM update, notification, and final storage before responding."},"typeVersion":1},{"id":"ba2906f2-2be6-4584-9c47-e19fcdc12889","name":"Webhook - Lead Submission","type":"n8n-nodes-base.webhook","notes":"Entry: POST /idempotent-lead with Idempotency-Key (optional X-Client-Id) + JSON lead body.","position":[-1056,-176],"webhookId":"lead-idempotent-webhook-01","parameters":{"path":"idempotent-lead","options":{},"httpMethod":"POST","responseMode":"responseNode"},"notesInFlow":true,"typeVersion":2},{"id":"e78a7478-c73c-4f3c-af2e-56de10c132ff","name":"Postgres - Ensure Idempotency Store","type":"n8n-nodes-base.postgres","notes":"Creates idempotency_keys table + indexes if missing.","position":[-720,-176],"parameters":{"query":"CREATE TABLE IF NOT EXISTS idempotency_keys (\n  idem_key        TEXT PRIMARY KEY,\n  business_key    TEXT,\n  fingerprint     TEXT        NOT NULL,\n  status          TEXT        NOT NULL,\n  response_code   INT,\n  response_body   JSONB,\n  provider_ref    TEXT,\n  provider_status INT,\n  attempts        INT         NOT NULL DEFAULT 1,\n  locked_until    TIMESTAMPTZ,\n  created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n  updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n  completed_at    TIMESTAMPTZ\n);\nCREATE INDEX IF NOT EXISTS idx_idem_status ON idempotency_keys (status, locked_until);\nCREATE UNIQUE INDEX IF NOT EXISTS uq_idem_business_active ON idempotency_keys (business_key)\n  WHERE business_key IS NOT NULL AND status IN ('in_progress', 'completed');\nSELECT 1 AS store_ready;","options":{},"operation":"executeQuery"},"notesInFlow":true,"typeVersion":2.5,"continueOnFail":true},{"id":"4343bbfb-fbf0-40f9-8526-393b593798ec","name":"Code - Validate & Fingerprint","type":"n8n-nodes-base.code","notes":"Validates lead payload, scopes key per client, computes SHA-256 fingerprint of canonical body.","position":[-384,-176],"parameters":{"jsCode":"function ref(name) { try { return $(name).item.json; } catch (e) { return $(name).first().json; } }\n\n// ---- edit policy here ----\nconst CONFIG = {\n  leaseSeconds: 90,\n  enrichTimeoutMs: 15000,\n  crmTimeoutMs: 20000,\n  notifyTimeoutMs: 10000,\n  allowedSources: ['website', 'linkedin', 'referral', 'ads', 'event'],\n  maxScoreThreshold: 100,\n  enrichUrl: 'https://httpbin.org/post',          // replace with real enrichment API\n  crmUrl: 'https://httpbin.org/post',             // replace with real CRM API\n  notifyUrl: 'https://httpbin.org/post',          // replace with Slack / email / webhook\n  allowSimulation: true\n};\n\n// Pure JS SHA-256\nconst primes = [];\nfor (let n = 2; primes.length < 64; n++) if (primes.every(p => n % p)) primes.push(n);\nconst frac = x => Math.floor((x - Math.floor(x)) * 4294967296);\nconst K = primes.map(p => frac(Math.cbrt(p)));\nconst H0 = primes.slice(0, 8).map(p => frac(Math.sqrt(p)));\nfunction sha256(str) {\n  const bytes = unescape(encodeURIComponent(str)).split('').map(c => c.charCodeAt(0));\n  const l = bytes.length;\n  bytes.push(0x80);\n  while (bytes.length % 64 !== 56) bytes.push(0);\n  const hi = Math.floor(l * 8 / 4294967296), lo = (l * 8) >>> 0;\n  for (let i = 3; i >= 0; i--) bytes.push((hi >>> (i * 8)) & 255);\n  for (let i = 3; i >= 0; i--) bytes.push((lo >>> (i * 8)) & 255);\n  const H = H0.slice();\n  const rotr = (x, n) => (x >>> n) | (x << (32 - n));\n  for (let off = 0; off < bytes.length; off += 64) {\n    const w = new Array(64);\n    for (let i = 0; i < 16; i++) w[i] = ((bytes[off + 4 * i] << 24) | (bytes[off + 4 * i + 1] << 16) | (bytes[off + 4 * i + 2] << 8) | bytes[off + 4 * i + 3]) >>> 0;\n    for (let i = 16; i < 64; i++) {\n      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);\n      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);\n      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;\n    }\n    let [a, b, c, d, e, f, g, h] = H;\n    for (let i = 0; i < 64; i++) {\n      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);\n      const ch = (e & f) ^ (~e & g);\n      const t1 = (h + S1 + ch + K[i] + w[i]) >>> 0;\n      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);\n      const maj = (a & b) ^ (a & c) ^ (b & c);\n      const t2 = (S0 + maj) >>> 0;\n      h = g; g = f; f = e; e = (d + t1) >>> 0; d = c; c = b; b = a; a = (t1 + t2) >>> 0;\n    }\n    [a, b, c, d, e, f, g, h].forEach((v, i) => { H[i] = (H[i] + v) >>> 0; });\n  }\n  return H.map(x => x.toString(16).padStart(8, '0')).join('');\n}\n\nconst hook = ref('Webhook - Lead Submission');\nconst headers = hook.headers || {};\nconst body = (hook.body && typeof hook.body === 'object') ? hook.body : {};\nconst errors = [];\n\nconst rawKey = String(headers['idempotency-key'] || body.idempotencyKey || '').trim();\nconst clientId = String(headers['x-client-id'] || body.clientId || 'default').trim();\nif (!rawKey) errors.push('Missing Idempotency-Key header');\nelse if (!/^[A-Za-z0-9_\\-:.]{8,128}$/.test(rawKey)) errors.push('Idempotency-Key must be 8-128 characters of A-Z a-z 0-9 _ - : .');\nif (!/^[A-Za-z0-9_\\-:.]{1,64}$/.test(clientId)) errors.push('X-Client-Id must be 1-64 characters of A-Z a-z 0-9 _ - : .');\n\nconst email = String(body.email || '').trim().toLowerCase();\nif (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('Valid email is required');\n\nconst firstName = String(body.firstName || body.name || '').trim();\nif (!firstName) errors.push('firstName (or name) is required');\n\nconst lastName = String(body.lastName || '').trim();\nconst company = String(body.company || '').trim();\nconst source = String(body.source || 'website').toLowerCase();\nif (!CONFIG.allowedSources.includes(source)) errors.push('source must be one of ' + CONFIG.allowedSources.join(', '));\nconst phone = body.phone ? String(body.phone).trim() : '';\nconst notes = body.notes ? String(body.notes).slice(0, 500) : '';\nconst externalId = body.externalId ? String(body.externalId).trim() : '';\n\nconst valid = errors.length === 0;\n\n// Canonical payload for fingerprint\nconst canon = JSON.stringify({\n  email,\n  firstName,\n  lastName: lastName || null,\n  company: company || null,\n  source,\n  phone: phone || null,\n  externalId: externalId || null\n});\nconst fingerprint = valid ? sha256(canon) : null;\n\nlet enrichUrl = CONFIG.enrichUrl;\nlet crmUrl = CONFIG.crmUrl;\nlet notifyUrl = CONFIG.notifyUrl;\nconst sim = Number(body.simulateStatus);\nif (CONFIG.allowSimulation && Number.isInteger(sim) && sim >= 200 && sim <= 599) {\n  enrichUrl = 'https://httpbin.org/status/' + sim;\n}\n\nreturn [{\n  json: {\n    valid,\n    errors,\n    idemKey: valid ? clientId + ':' + rawKey : null,\n    businessKey: valid ? clientId + ':' + email : null,\n    fingerprint,\n    request: {\n      email, firstName, lastName: lastName || null,\n      company: company || null, source,\n      phone: phone || null, notes: notes || null,\n      externalId: externalId || null\n    },\n    provider: {\n      enrichUrl,\n      crmUrl,\n      notifyUrl,\n      enrichBody: { email, company, firstName, lastName },\n      crmBody: { email, firstName, lastName, company, source, phone, notes },\n      notifyBody: null\n    },\n    config: CONFIG\n  }\n}];"},"notesInFlow":true,"typeVersion":2},{"id":"b5712e05-1d74-4431-b5e6-f8a26b24f56c","name":"Postgres - Claim Idempotency Key","type":"n8n-nodes-base.postgres","notes":"Atomic claim with lease. Returns existing row if already present.","position":[-64,-176],"parameters":{"query":"WITH claim AS (\n  INSERT INTO idempotency_keys (idem_key, business_key, fingerprint, status, attempts, locked_until, created_at, updated_at)\n  SELECT $1::text, $2::text, $3::text, 'in_progress', 1, NOW() + ($4::int * INTERVAL '1 second'), NOW(), NOW()\n  WHERE $5::boolean\n  ON CONFLICT (idem_key) DO UPDATE SET\n    status = 'in_progress',\n    attempts = idempotency_keys.attempts + 1,\n    locked_until = NOW() + ($4::int * INTERVAL '1 second'),\n    updated_at = NOW()\n  WHERE idempotency_keys.fingerprint = EXCLUDED.fingerprint\n    AND (idempotency_keys.status = 'failed'\n         OR (idempotency_keys.status = 'in_progress' AND idempotency_keys.locked_until < NOW()))\n  RETURNING idem_key, fingerprint, status, attempts\n)\nSELECT TRUE AS claimed, c.idem_key, c.fingerprint, c.status, NULL::int AS response_code, NULL::jsonb AS response_body, c.attempts\nFROM claim c\nUNION ALL\nSELECT FALSE, k.idem_key, k.fingerprint, k.status, k.response_code, k.response_body, k.attempts\nFROM idempotency_keys k\nWHERE k.idem_key = $1::text AND $5::boolean AND NOT EXISTS (SELECT 1 FROM claim);","options":{"queryReplacement":"={{ [ $json.idemKey, $json.businessKey, $json.fingerprint, $json.config.leaseSeconds, $json.valid ] }}"},"operation":"executeQuery"},"notesInFlow":true,"typeVersion":2.5,"continueOnFail":true,"alwaysOutputData":true},{"id":"a1a646b6-1c99-4761-925b-00951c02d62f","name":"Code - Route Request","type":"n8n-nodes-base.code","notes":"Decides execute / replay / in_progress / mismatch / duplicate / invalid / store_unavailable.","position":[272,-176],"parameters":{"jsCode":"function ref(name) { try { return $(name).item.json; } catch (e) { return $(name).first().json; } }\nconst v = ref('Code - Validate & Fingerprint');\nconst row = $input.first().json || {};\nconst out = (route, httpStatus, body, extra = {}) => [{ json: { route, httpStatus, body, idemKey: v.idemKey || '', replayed: false, ...extra } }];\n\nif (!v.valid) return out('invalid', 400, { error: 'invalid_request', details: v.errors });\n\nif (row.error) {\n  const em = typeof row.error === 'string' ? row.error : (row.error.message || JSON.stringify(row.error));\n  if (/uq_idem_business_active|duplicate key/i.test(em)) {\n    return out('duplicate', 409, {\n      error: 'duplicate_lead',\n      message: 'A lead for this email is already in progress or completed under a different Idempotency-Key.',\n      email: v.request.email\n    });\n  }\n  return out('store_unavailable', 503, {\n    error: 'idempotency_store_unavailable',\n    message: 'Idempotency could not be verified, so no lead processing was attempted. Retry later with the same Idempotency-Key.'\n  });\n}\n\nif (row.idem_key && row.claimed === true) {\n  return [{ json: {\n    route: 'execute',\n    idemKey: v.idemKey,\n    attempt: Number(row.attempts),\n    fingerprint: v.fingerprint,\n    request: v.request,\n    provider: v.provider,\n    config: v.config\n  }}];\n}\n\nif (row.idem_key) {\n  if (row.fingerprint !== v.fingerprint) {\n    return out('mismatch', 422, {\n      error: 'idempotency_key_reuse',\n      message: 'This Idempotency-Key was already used with a different request payload.'\n    });\n  }\n  if (row.status === 'completed') {\n    let rb = row.response_body;\n    if (typeof rb === 'string') { try { rb = JSON.parse(rb); } catch (e) { rb = { raw: rb }; } }\n    return [{ json: {\n      route: 'replay',\n      httpStatus: Number(row.response_code) || 200,\n      body: rb,\n      idemKey: v.idemKey,\n      replayed: true\n    }}];\n  }\n}\n\nreturn out('in_progress', 409, {\n  error: 'request_in_progress',\n  message: 'A request with this Idempotency-Key is still being processed. Retry shortly with the same key.',\n  retryAfterSeconds: 5\n});"},"notesInFlow":true,"typeVersion":2},{"id":"115891f3-d4ed-4f46-934f-897da38b4a00","name":"IF - Execute Processing?","type":"n8n-nodes-base.if","notes":"True only for a freshly claimed key.","position":[608,-176],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"cond-execute","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.route === 'execute' }}","rightValue":""}]}},"notesInFlow":true,"typeVersion":2.2},{"id":"6131f5f3-da44-4e5f-a9cb-1f0e2b036206","name":"HTTP Request - Enrichment API","type":"n8n-nodes-base.httpRequest","notes":"First external call – enrich lead data (company, social, etc.).","position":[928,144],"parameters":{"url":"={{ $json.provider.enrichUrl }}","method":"POST","options":{"timeout":"={{ $json.config.enrichTimeoutMs }}","response":{"response":{"neverError":true,"fullResponse":true}}},"jsonBody":"={{ JSON.stringify($json.provider.enrichBody) }}","sendBody":true,"sendHeaders":true,"specifyBody":"json","headerParameters":{"parameters":[{"name":"Idempotency-Key","value":"={{ $json.idemKey }}"},{"name":"content-type","value":"application/json"}]}},"notesInFlow":true,"typeVersion":4.2,"continueOnFail":true},{"id":"76648559-e885-462a-b4c0-710d49901706","name":"Wait - After Enrichment","type":"n8n-nodes-base.wait","notes":"Short pause after enrichment (rate-limit / sequencing).","position":[1264,144],"webhookId":"105b4da6-2dc3-4aa4-8934-4919ba7ffdf7","parameters":{"amount":2},"typeVersion":1.1},{"id":"f433ec77-b016-427f-94b6-bb2c1ccef041","name":"Code - Score Lead","type":"n8n-nodes-base.code","notes":"Combines original request + enrichment result into a lead score and prepares CRM payload.","position":[1600,144],"parameters":{"jsCode":"function ref(name) { try { return $(name).item.json; } catch (e) { return $(name).first().json; } }\nconst ctx = ref('Code - Route Request');\nconst enrich = $input.first().json || {};\nconst statusCode = Number(enrich.statusCode) || 0;\n\nlet enrichData = enrich.body;\nif (typeof enrichData === 'string') {\n  try { enrichData = JSON.parse(enrichData); } catch (e) { enrichData = { raw: String(enrichData).slice(0, 300) }; }\n}\nif (!enrichData || typeof enrichData !== 'object') enrichData = {};\n\n// Simple deterministic scoring\nlet score = 40;\nif (ctx.request.company) score += 15;\nif (ctx.request.phone) score += 10;\nif (ctx.request.source === 'referral') score += 20;\nelse if (ctx.request.source === 'linkedin') score += 15;\nelse if (ctx.request.source === 'ads') score += 5;\nif (statusCode >= 200 && statusCode < 300) score += 10;\nscore = Math.min(score, ctx.config.maxScoreThreshold || 100);\n\nconst tier = score >= 80 ? 'hot' : score >= 55 ? 'warm' : 'cold';\n\nconst crmBody = {\n  ...ctx.provider.crmBody,\n  enrichment: enrichData,\n  leadScore: score,\n  leadTier: tier,\n  processedAt: new Date().toISOString()\n};\n\nreturn [{\n  json: {\n    idemKey: ctx.idemKey,\n    attempt: ctx.attempt,\n    request: ctx.request,\n    config: ctx.config,\n    provider: {\n      ...ctx.provider,\n      crmBody,\n      notifyBody: {\n        text: `New ${tier.toUpperCase()} lead: ${ctx.request.firstName} (${ctx.request.email}) – score ${score}`,\n        lead: crmBody\n      }\n    },\n    score,\n    tier,\n    enrichStatus: statusCode,\n    enrichOk: statusCode >= 200 && statusCode < 300\n  }\n}];"},"notesInFlow":true,"typeVersion":2},{"id":"d332ea87-f6f4-45a3-ac98-1b3db415853b","name":"HTTP Request - CRM API","type":"n8n-nodes-base.httpRequest","notes":"Second external call – create / update lead in CRM.","position":[1936,144],"parameters":{"url":"={{ $json.provider.crmUrl }}","method":"POST","options":{"timeout":"={{ $json.config.crmTimeoutMs }}","response":{"response":{"neverError":true,"fullResponse":true}}},"jsonBody":"={{ JSON.stringify($json.provider.crmBody) }}","sendBody":true,"sendHeaders":true,"specifyBody":"json","headerParameters":{"parameters":[{"name":"Idempotency-Key","value":"={{ $json.idemKey }}"},{"name":"content-type","value":"application/json"}]}},"notesInFlow":true,"typeVersion":4.2,"continueOnFail":true},{"id":"ee609435-66f5-44be-9357-058230f0cc2d","name":"Wait - After CRM","type":"n8n-nodes-base.wait","notes":"Short pause after CRM write before notification.","position":[2272,144],"webhookId":"c2c44c39-b906-4945-aa23-617a16c73bea","parameters":{"amount":1},"typeVersion":1.1},{"id":"6d0a1081-d4ec-45cb-afb8-4f8dc50b9d7f","name":"HTTP Request - Notification API","type":"n8n-nodes-base.httpRequest","notes":"Third external call – Slack / email / internal webhook.","position":[2608,144],"parameters":{"url":"={{ $json.provider.notifyUrl }}","method":"POST","options":{"timeout":"={{ $json.config.notifyTimeoutMs }}","response":{"response":{"neverError":true,"fullResponse":true}}},"jsonBody":"={{ JSON.stringify($json.provider.notifyBody) }}","sendBody":true,"sendHeaders":true,"specifyBody":"json","headerParameters":{"parameters":[{"name":"content-type","value":"application/json"}]}},"notesInFlow":true,"typeVersion":4.2,"continueOnFail":true},{"id":"e0d28076-af9d-4512-9cd9-bb937c92ad16","name":"Code - Classify & Finalize","type":"n8n-nodes-base.code","notes":"Maps enrichment + CRM + notify outcomes into final status (completed / failed) for storage.","position":[2944,144],"parameters":{"jsCode":"function ref(name) { try { return $(name).item.json; } catch (e) { return $(name).first().json; } }\nconst scored = ref('Code - Score Lead');\nconst crm = ref('HTTP Request - CRM API');\nconst notify = $input.first().json || {};\n\nconst crmCode = Number(crm.statusCode) || 0;\nconst notifyCode = Number(notify.statusCode) || 0;\n\nlet finalStatus, httpStatus, body, providerRef = null;\n\nif (crmCode >= 200 && crmCode < 300) {\n  finalStatus = 'completed';\n  httpStatus = 201;\n  let crmBody = crm.body;\n  if (typeof crmBody === 'string') {\n    try { crmBody = JSON.parse(crmBody); } catch (e) { crmBody = {}; }\n  }\n  providerRef = (crmBody && (crmBody.id || crmBody.leadId)) || ('LEAD-' + String(scored.fingerprint || scored.idemKey).slice(0, 12).toUpperCase());\n  body = {\n    status: 'succeeded',\n    leadId: providerRef,\n    email: scored.request.email,\n    firstName: scored.request.firstName,\n    leadScore: scored.score,\n    leadTier: scored.tier,\n    source: scored.request.source,\n    enrichOk: scored.enrichOk,\n    notifyOk: notifyCode >= 200 && notifyCode < 300,\n    processedAt: new Date().toISOString(),\n    attempts: scored.attempt\n  };\n} else if (crmCode >= 400 && crmCode < 500 && crmCode !== 408 && crmCode !== 429) {\n  finalStatus = 'completed';\n  httpStatus = 422;\n  body = {\n    status: 'declined',\n    message: 'CRM rejected the lead',\n    providerStatus: crmCode,\n    email: scored.request.email,\n    leadScore: scored.score\n  };\n} else {\n  finalStatus = 'failed';\n  httpStatus = crmCode === 429 ? 429 : (crmCode ? 502 : 504);\n  body = {\n    status: 'failed',\n    retryable: true,\n    message: 'Lead processing did not complete. Retry with the same Idempotency-Key.',\n    providerStatus: crmCode || null,\n    email: scored.request.email\n  };\n}\n\nreturn [{\n  json: {\n    finalStatus,\n    httpStatus,\n    body,\n    providerRef,\n    providerStatus: crmCode || null,\n    idemKey: scored.idemKey,\n    attempt: scored.attempt,\n    replayed: false\n  }\n}];"},"notesInFlow":true,"typeVersion":2},{"id":"853809a8-d079-40a4-a4e3-4f6c0e2fff06","name":"Postgres - Store Result","type":"n8n-nodes-base.postgres","notes":"Fencing write – only the current owner (matching attempts + in_progress) can store the outcome.","position":[3280,144],"parameters":{"query":"UPDATE idempotency_keys SET\n  status = $3::text,\n  response_code = $4::int,\n  response_body = $5::jsonb,\n  provider_ref = $6::text,\n  provider_status = $7::int,\n  locked_until = NULL,\n  completed_at = CASE WHEN $3::text = 'completed' THEN NOW() ELSE NULL END,\n  updated_at = NOW()\nWHERE idem_key = $1::text AND attempts = $2::int AND status = 'in_progress'\nRETURNING response_code AS \"httpStatus\", response_body AS \"body\", idem_key AS \"idemKey\", FALSE AS \"replayed\";","options":{"queryReplacement":"={{ [ $json.idemKey, $json.attempt, $json.finalStatus, $json.httpStatus, JSON.stringify($json.body), $json.providerRef, $json.providerStatus ] }}"},"operation":"executeQuery"},"notesInFlow":true,"typeVersion":2.5,"continueOnFail":true,"alwaysOutputData":true},{"id":"6ce39b73-178d-46c5-bb82-2d551b29ad19","name":"Respond to Webhook - Result","type":"n8n-nodes-base.respondToWebhook","notes":"Returns fresh, replayed or error response with Idempotency-Key + Idempotent-Replayed headers.","position":[3616,-176],"parameters":{"options":{"responseCode":"={{ $json.httpStatus || $('Code - Classify & Finalize').first().json.httpStatus }}","responseHeaders":{"entries":[{"name":"Idempotency-Key","value":"={{ $json.idemKey || $('Code - Classify & Finalize').first().json.idemKey }}"},{"name":"Idempotent-Replayed","value":"={{ String($json.replayed === true) }}"}]}},"respondWith":"json","responseBody":"={{ $json.body || $('Code - Classify & Finalize').first().json.body }}"},"notesInFlow":true,"typeVersion":1.1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":false,"executionOrder":"v1"},"versionId":"476cc413-a763-46b2-904b-b7f4d4f18d11","nodeGroups":[],"connections":{"Wait - After CRM":{"main":[[{"node":"HTTP Request - Notification API","type":"main","index":0}]]},"Code - Score Lead":{"main":[[{"node":"HTTP Request - CRM API","type":"main","index":0}]]},"Code - Route Request":{"main":[[{"node":"IF - Execute Processing?","type":"main","index":0}]]},"HTTP Request - CRM API":{"main":[[{"node":"Wait - After CRM","type":