{"name":"Create Arabic daily news audio briefings with Gemini, ElevenLabs, and Telegram","nodes":[{"id":"node-trigger","name":"Run Every Morning at 7 AM","type":"n8n-nodes-base.scheduleTrigger","position":[0,140],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 7 * * *"}]}},"typeVersion":1.2},{"id":"node-rss","name":"Fetch Latest Headlines","type":"n8n-nodes-base.rssFeedRead","position":[240,20],"parameters":{"url":"https://www.aljazeera.net/aljazeerarss/a7c186be-1a50-4673-baea-1588d8f9a584","options":{"limit":20}},"typeVersion":1.2},{"id":"node-history","name":"Load Previously Sent Headlines","type":"n8n-nodes-base.googleSheets","position":[240,300],"parameters":{"options":{"returnAll":true,"dataLocationOnSheet":{"values":{"headerRow":1,"firstDataRow":2}}},"resource":"sheetWithinDocument","operation":"read","sheetName":{"__rl":true,"mode":"name","value":"Briefings"},"documentId":{"__rl":true,"mode":"id","value":"YOUR_GOOGLE_SHEET_ID"}},"typeVersion":4.5},{"id":"node-merge","name":"Combine News and History","type":"n8n-nodes-base.merge","position":[480,140],"parameters":{"mode":"combineByPosition","options":{"clashHandling":"preferInput1"}},"typeVersion":3},{"id":"node-gemini","name":"Rank and Rewrite 5 Fresh Stories","type":"n8n-nodes-base.googleGemini","position":[720,140],"parameters":{"prompt":"=You are an Arabic news editor. Below is a JSON array of today's fresh news items (title, content snippet, link).\n\nYour job:\n1. Select the 5 most important stories, but SKIP any story whose topic already appears in the list of previously sent headlines below — readers must never receive the same story twice.\n2. Rewrite each selected story as a very short Modern Standard Arabic briefing: a catchy headline (max 12 words) and a 2-3 sentence summary.\n3. Return ONLY a raw JSON array, no markdown fences, shaped like:\n[{\"headline\": \"...\", \"summary\": \"...\", \"url\": \"...\"}]\n\nOrder from most to least important. Today's date: {{ $now.format('yyyy-MM-dd') }}.\n\nFresh news items:\n{{ JSON.stringify($('Fetch Latest Headlines').all().map(i => ({ title: i.json.title, content: (i.json.content||'').slice(0,400), link: i.json.link }))) }}\n\nPreviously sent headlines (DO NOT repeat these topics):\n{{ JSON.stringify($('Load Previously Sent Headlines').all().map(i => i.json.Headline)) }}","modelName":"models/gemini-2.5-flash","temperature":0.4,"maxOutputTokens":2048},"typeVersion":1},{"id":"node-code","name":"Validate and Detect Breaking News","type":"n8n-nodes-base.code","position":[960,140],"parameters":{"jsCode":"// Validate Gemini output, detect breaking topics, build the briefing.\nconst raw = ($input.first().json.text || $input.first().json.output || '').replace(/```json|```/g, '').trim();\n\nlet stories = [];\ntry { stories = JSON.parse(raw); } catch (e) {}\n\nif (!Array.isArray(stories) || stories.length === 0) {\n  // Signal the self-healing repair loop.\n  return [{ json: { valid: false, raw } }];\n}\n\nconst today = new Date().toISOString().slice(0, 10);\n\n// Breaking-news detection: topics repeated across multiple stories.\nconst STOP = new Set(['التي','الذي','على','إلى','من','في','عن','هذا','ذلك','بعد','قبل','أن','إن','قد','كان','هي','هو','تم','وقد','بشكل']);\nconst freq = {};\nfor (const s of stories) {\n  (s.headline + ' ' + s.summary).split(/\\s+/).forEach(w => {\n    w = w.replace(/[^\\u0621-\\u064a0-9a-zA-Z]/g, '');\n    if (w.length > 4 && !STOP.has(w)) freq[w] = (freq[w] || 0) + 1;\n  });\n}\nconst hotTopics = Object.keys(freq).filter(w => freq[w] >= 3);\n\nconst briefing = stories.map((s, i) => {\n  const isHot = hotTopics.some(w => (s.headline + ' ' + s.summary).includes(w));\n  const h = isHot ? '🔥 BREAKING: ' + s.headline : s.headline;\n  return `🔹 *${i + 1}. ${h}*\\n${s.summary}\\n${s.url}`;\n}).join('\\n\\n');\n\nreturn [{ json: {\n  valid: true,\n  date: today,\n  stories: stories,\n  storyCount: stories.length,\n  hotTopics: hotTopics,\n  headline: stories[0].headline,\n  summary: stories[0].summary,\n  briefing: `📰 *أبرز الأخبار — ${today}*\\n\\n${briefing}`\n}}];"},"typeVersion":2},{"id":"node-if","name":"Is Briefing Valid?","type":"n8n-nodes-base.if","position":[1200,140],"parameters":{"options":{},"conditions":{"options":{"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"cond-valid","operator":{"name":"filter.operator.true","type":"boolean","operation":true},"leftValue":"={{ $json.valid }}","rightValue":true}]}},"typeVersion":2},{"id":"node-repair","name":"Repair Malformed JSON Output","type":"n8n-nodes-base.googleGemini","position":[1200,460],"parameters":{"prompt":"=The text below was supposed to be a raw JSON array of Arabic news stories shaped like [{\"headline\": \"...\", \"summary\": \"...\", \"url\": \"...\"}], but it is malformed or empty.\n\nReturn ONLY the corrected, valid raw JSON array. Keep the Arabic text unchanged where possible. If a field is missing, reconstruct it sensibly.\n\nBroken output:\n{{ $json.raw }}","modelName":"models/gemini-2.5-flash","temperature":0.1,"maxOutputTokens":2048},"typeVersion":1},{"id":"node-tg-text","name":"Send Telegram Text Briefing","type":"n8n-nodes-base.telegram","position":[1440,-40],"parameters":{"text":"={{ $json.briefing }}","chatId":"123456789","additionalFields":{"parse_mode":"Markdown","disable_web_page_preview":true}},"typeVersion":1.2},{"id":"node-sheets","name":"Log Briefing to Tracking Sheet","type":"n8n-nodes-base.googleSheets","position":[1440,140],"parameters":{"columns":{"value":{"Date":"={{ $json.date }}","Status":"Delivered","Summary":"={{ $json.summary }}","Headline":"={{ $json.headline }}","Audio Sent":"Yes","Story Count":"={{ $json.storyCount }}"},"schema":[],"mappingMode":"defineBelow","matchingColumns":[]},"options":{},"resource":"sheetWithinDocument","operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Briefings"},"documentId":{"__rl":true,"mode":"id","value":"YOUR_GOOGLE_SHEET_ID"}},"typeVersion":4.5},{"id":"node-tts","name":"Generate Arabic Voiceover","type":"n8n-nodes-base.httpRequest","position":[1440,320],"parameters":{"url":"=https://api.elevenlabs.io/v1/text-to-speech/pNInz6obpgDQGcFmaJgB","body":"= { \"text\": {{ JSON.stringify($json.briefing.replace(/\\*\\*/g, '').replace(/[🔹📰]/g, '')) }}, \"model_id\": \"eleven_multilingual_v2\", \"voice_settings\": { \"stability\": 0.5, \"similarity_boost\": 0.75 } }","options":{"responseFormat":"file"},"sendBody":true,"contentType":"json","requestMethod":"POST"},"typeVersion":4.2},{"id":"node-tg-audio","name":"Send Telegram Audio Briefing","type":"n8n-nodes-base.telegram","position":[1680,320],"parameters":{"chatId":"123456789","additionalFields":{"caption":"={{ 'Audio briefing for ' + $json.date }}"}},"typeVersion":1.2},{"id":"note-overview","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-780,-420],"parameters":{"width":480,"height":1080,"content":"## Create Arabic daily news audio briefings with Gemini, ElevenLabs, and Telegram\n\n### How it works\n\nThis workflow runs every morning, reads fresh headlines from an RSS feed, and loads previously sent headlines from Google Sheets so the AI never repeats old stories. Gemini ranks and rewrites the top 5 fresh stories in Arabic, a validation step parses the model output, and malformed JSON is automatically repaired in a self-healing loop. A breaking-news detector flags topics that appear across multiple stories. The final briefing is delivered as a Telegram text message and as an ElevenLabs Arabic voiceover, with every run logged to Google Sheets.\n\n### Setup steps\n\n- Configure the schedule trigger for the desired daily run time and timezone.\n- Set the RSS Feed Read node to the preferred news source feed URL.\n- Add Google Gemini credentials (API key) for both Gemini nodes.\n- Connect Google Sheets credentials and replace `YOUR_GOOGLE_SHEET_ID`; the `Briefings` sheet needs the columns: Date, Headline, Summary, Story Count, Audio Sent, Status.\n- Configure Telegram bot credentials and target chat/channel IDs for both text and audio messages.\n- Add the ElevenLabs API key, voice ID, and text-to-speech endpoint details in the HTTP Request node.\n\n### Customization\n\nYou can change the run time, RSS source, number of ranked stories, Gemini prompt style, Arabic voice, Telegram destination, breaking-news threshold, and the fields logged to the tracking sheet."},"typeVersion":1},{"id":"note-a","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-120,-320],"parameters":{"color":7,"width":432,"height":340,"content":"## Schedule, fetch, and deduplicate\n\nStarts on the daily schedule, retrieves the latest headlines from the RSS feed, and reads previously sent headlines from Google Sheets so stories are never repeated."},"typeVersion":1},{"id":"note-b","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[560,-320],"parameters":{"color":7,"width":432,"height":360,"content":"## AI ranking and self-healing JSON\n\nGemini selects and rewrites 5 fresh stories while excluding previously sent topics. The Code node validates the JSON; malformed output is repaired by a second Gemini call in a feedback loop before delivery."},"typeVersion":1},{"id":"note-c","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[1420,-320],"parameters":{"color":7,"width":432,"height":340,"content":"## Deliver text, audio, and log\n\nDetects breaking topics, sends the text briefing to Telegram, converts it to Arabic speech with ElevenLabs, sends the audio file, and appends a delivery log to Google Sheets."},"typeVersion":1}],"pinData":{},"settings":{"executionOrder":"v1"},"connections":{"Is Briefing Valid?":{"main":[[{"node":"Send Telegram Text Briefing","type":"main","index":0},{"node":"Log Briefing to Tracking Sheet","type":"main","index":0},{"node":"Generate Arabic Voiceover","type":"main","index":0}],[{"node":"Repair Malformed JSON Output","type":"main","index":0}]]},"Fetch Latest Headlines":{"main":[[{"node":"Combine News and History","type":"main","index":0}]]},"Combine News and History":{"main":[[{"node":"Rank and Rewrite 5 Fresh Stories","type":"main","index":0}]]},"Generate Arabic Voiceover":{"main":[[{"node":"Send Telegram Audio Briefing","type":"main","index":0}]]},"Run Every Morning at 7 AM":{"main":[[{"node":"Fetch Latest Headlines","type":"main","index":0},{"node":"Load Previously Sent Headlines","type":"main","index":0}]]},"Repair Malformed JSON Output":{"main":[[{"node":"Validate and Detect Breaking News","type":"main","index":0}]]},"Load Previously Sent Headlines":{"main":[[{"node":"Combine News and History","type":"main","index":1}]]},"Rank and Rewrite 5 Fresh Stories":{"main":[[{"node":"Validate and Detect Breaking News","type":"main","index":0}]]},"Validate and Detect Breaking News":{"main":[[{"node":"Is Briefing Valid?","type":"main","index":0}]]}}}