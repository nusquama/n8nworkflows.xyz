{"id":"metaHealthScore25","meta":{"instanceId":"634103db1d8d34bb0c9bef638db9b8384decbea7550401b2a024f37db42e8f29"},"name":"Score Meta ad account health weekly with Claude AI and rank the top 3 fixes","tags":[],"nodes":[{"id":"n2","name":"Set config: health score","type":"n8n-nodes-base.code","position":[-176,0],"parameters":{"jsCode":"// Meta ads weekly health score - tune here.\nreturn [{ json: {\n  DATE_PRESET: 'last_7d',           // this-week window (Meta excludes today)\n\n  // Which conversion events count as a \"result\" for this account.\n  RESULT_ACTIONS: ['omni_purchase','purchase','offsite_conversion.fb_pixel_purchase','offsite_complete_registration_add_meta_leads','lead','leadgen_grouped','onsite_conversion.lead_grouped','omni_complete_registration','complete_registration'],\n\n  // Efficiency-trend thresholds (percent, week over week)\n  KPI_FLAG_PCT: 15,                 // primary KPI worse by this much = flag\n  KPI_CRIT_PCT: 30,                 // ...= critical\n  SPEND_UP_PCT: 10,                 // spend up this much while KPI worsens = flag\n  SPEND_UP_CRIT_PCT: 20,            // ...= critical (scaling into weakness)\n  CPM_FLAG_PCT: 25,\n  CPM_CRIT_PCT: 60,\n  VOLUME_DROP_PCT: 25,              // impressions down this much while spend held/rose\n\n  // Fatigue (kept summary-level on purpose, see sticky)\n  FREQ_FLAG: 3.5,\n  FREQ_CRIT: 4.5,\n\n  // Waste\n  ZERO_RESULT_MIN_SPEND: 50,        // an ad must spend at least this to make the kill list\n\n  // Structure\n  CONCENTRATION_PCT: 60,            // one ad set carrying more than this share of spend\n  AD_DENSITY_MAX: 6,                // active ads per ad set before budget dilution\n\n  // Scoring weights (must total 100)\n  WEIGHTS: { efficiency: 30, waste: 20, fatigue: 15, delivery: 15, structure: 10, momentum: 10 },\n} }];"},"typeVersion":2},{"id":"n3","name":"Build comparison windows","type":"n8n-nodes-base.code","position":[48,0],"parameters":{"jsCode":"// Build the two comparison windows. Meta's last_7d ends yesterday, so the prior\n// window is the 7 days immediately before that. No API calls here, date math only.\nconst cfg = $('Set config: health score').first().json;\nconst day = 86400000;\nconst iso = (d) => d.toISOString().slice(0, 10);\nconst now = new Date();\nconst yesterday = new Date(now.getTime() - day);\n\nconst thisEnd = yesterday;\nconst thisStart = new Date(yesterday.getTime() - 6 * day);\nconst priorEnd = new Date(thisStart.getTime() - day);\nconst priorStart = new Date(priorEnd.getTime() - 6 * day);\n\nreturn [{ json: {\n  this_window: { since: iso(thisStart), until: iso(thisEnd) },\n  prior_window: { since: iso(priorStart), until: iso(priorEnd) },\n  this_range: JSON.stringify({ since: iso(thisStart), until: iso(thisEnd) }),\n  prior_range: JSON.stringify({ since: iso(priorStart), until: iso(priorEnd) }),\n  date_preset: cfg.DATE_PRESET,\n} }];"},"typeVersion":2},{"id":"n4","name":"Fetch account this week (Meta)","type":"n8n-nodes-base.httpRequest","position":[272,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/insights","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"level","value":"account"},{"name":"time_range","value":"={{ $('Build comparison windows').first().json.this_range }}"},{"name":"fields","value":"spend,impressions,reach,frequency,clicks,ctr,cpm,cpc,actions,purchase_roas"}]}},"typeVersion":4.2},{"id":"n5","name":"Fetch account prior week (Meta)","type":"n8n-nodes-base.httpRequest","position":[480,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/insights","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"level","value":"account"},{"name":"time_range","value":"={{ $('Build comparison windows').first().json.prior_range }}"},{"name":"fields","value":"spend,impressions,reach,frequency,clicks,ctr,cpm,cpc,actions,purchase_roas"}]}},"typeVersion":4.2},{"id":"n6","name":"Fetch ad set insights (Meta)","type":"n8n-nodes-base.httpRequest","position":[704,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/insights","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"level","value":"adset"},{"name":"time_range","value":"={{ $('Build comparison windows').first().json.this_range }}"},{"name":"fields","value":"adset_id,adset_name,spend,impressions,frequency,ctr,cpc,actions,purchase_roas"},{"name":"limit","value":"500"}]}},"typeVersion":4.2},{"id":"n7","name":"Fetch ad set entities (Meta)","type":"n8n-nodes-base.httpRequest","position":[928,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/adsets","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"fields","value":"id,name,status,effective_status,daily_budget,lifetime_budget"},{"name":"limit","value":"500"}]}},"typeVersion":4.2},{"id":"n8","name":"Fetch ad insights (Meta)","type":"n8n-nodes-base.httpRequest","position":[1152,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/insights","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"level","value":"ad"},{"name":"time_range","value":"={{ $('Build comparison windows').first().json.this_range }}"},{"name":"fields","value":"ad_id,ad_name,adset_id,adset_name,spend,impressions,ctr,actions,purchase_roas"},{"name":"limit","value":"500"}]}},"typeVersion":4.2},{"id":"n9","name":"Run checks and score","type":"n8n-nodes-base.code","position":[1360,0],"parameters":{"jsCode":"// Run the check battery and score the account. Pure transforms, no API calls.\nconst cfg = $('Set config: health score').first().json;\nconst win = $('Build comparison windows').first().json;\n\nconst pick = (nodeName) => {\n  const r = $(nodeName).first().json;\n  return (r && r.data) ? r.data : [];\n};\nconst num = (v) => { const n = parseFloat(v); return isNaN(n) ? 0 : n; };\nconst pct = (a, b) => (b === 0 ? null : ((a - b) / b) * 100);\nconst round = (v, d) => (v === null || v === undefined ? null : Math.round(v * Math.pow(10, d)) / Math.pow(10, d));\n\nconst acctThis = pick('Fetch account this week (Meta)')[0] || {};\nconst acctPrior = pick('Fetch account prior week (Meta)')[0] || {};\nconst adsetRows = pick('Fetch ad set insights (Meta)');\nconst adsetEnts = pick('Fetch ad set entities (Meta)');\nconst adRows = pick('Fetch ad insights (Meta)');\n\n// --- results helper -------------------------------------------------------\nconst resultsOf = (row) => {\n  const acts = row.actions || [];\n  let total = 0;\n  for (const a of acts) {\n    if (cfg.RESULT_ACTIONS.indexOf(a.action_type) !== -1) total += num(a.value);\n  }\n  return total;\n};\nconst roasOf = (row) => {\n  const r = row.purchase_roas || [];\n  return r.length ? num(r[0].value) : null;\n};\n\n// --- 1. objective detection ----------------------------------------------\nconst roasThis = roasOf(acctThis);\nconst roasPrior = roasOf(acctPrior);\nconst MODE = (roasThis !== null && roasThis > 0) ? 'SALES' : 'LEADS';\n\nconst spendThis = num(acctThis.spend);\nconst spendPrior = num(acctPrior.spend);\nconst resThis = resultsOf(acctThis);\nconst resPrior = resultsOf(acctPrior);\n\n// No spend means no audit. Scoring an empty or unreachable account would return\n// a healthy-looking number off zero evidence, which is worse than saying nothing.\nif (spendThis <= 0) {\n  return [{ json: {\n    mode: MODE, no_data: true, score: null, band: 'no data',\n    windows: { this: win.this_window, prior: win.prior_window },\n    counts: { passed: 0, flags: 0, critical: 0 },\n    checks: [], breakdown: {}, wasted_spend: 0, zero_result_ads: [],\n    account: { spend_this: 0, spend_prior: round(spendPrior,2) },\n    message: 'No spend returned for ' + win.this_window.since + ' to ' + win.this_window.until + '. Check META_AD_ACCOUNT_ID (it needs the act_ prefix), the token scope, and that the account was actually running.',\n  } }];\n}\n\n// Primary KPI. SALES = ROAS (higher better). LEADS = cost per result (lower better).\nlet kpiName, kpiThis, kpiPrior, higherIsBetter;\nif (MODE === 'SALES') {\n  kpiName = 'ROAS';\n  kpiThis = roasThis; kpiPrior = roasPrior; higherIsBetter = true;\n} else {\n  kpiName = 'Cost per result';\n  kpiThis = resThis > 0 ? spendThis / resThis : null;\n  kpiPrior = resPrior > 0 ? spendPrior / resPrior : null;\n  higherIsBetter = false;\n}\n// Signed \"worse by X percent\" regardless of direction.\nlet kpiWorsePct = null;\nif (kpiThis !== null && kpiPrior !== null && kpiPrior !== 0) {\n  const change = pct(kpiThis, kpiPrior);\n  kpiWorsePct = higherIsBetter ? -change : change;\n}\nconst spendChangePct = pct(spendThis, spendPrior);\n\nconst checks = [];\nconst add = (cat, id, label, status, detail, move) =>\n  checks.push({ category: cat, id: id, label: label, status: status, detail: detail, move: move || '' });\n\n// --- A. efficiency trend --------------------------------------------------\nif (kpiWorsePct === null || spendChangePct === null) {\n  add('efficiency', 'A1', 'Scaling into weakness', 'unknown', 'Not enough two-window data to compare.', '');\n} else if (spendChangePct > cfg.SPEND_UP_CRIT_PCT && kpiWorsePct > 10) {\n  add('efficiency', 'A1', 'Scaling into weakness', 'critical',\n    'Spend up ' + round(spendChangePct,1) + '% while ' + kpiName + ' worsened ' + round(kpiWorsePct,1) + '%.',\n    'Hold budget flat until ' + kpiName + ' recovers. Do not add spend to a declining account.');\n} else if (spendChangePct > cfg.SPEND_UP_PCT && kpiWorsePct > 0) {\n  add('efficiency', 'A1', 'Scaling into weakness', 'flag',\n    'Spend up ' + round(spendChangePct,1) + '% while ' + kpiName + ' worsened ' + round(kpiWorsePct,1) + '%.',\n    'Pause further budget increases this week and find the drag first.');\n} else {\n  add('efficiency', 'A1', 'Scaling into weakness', 'pass',\n    'Spend ' + round(spendChangePct,1) + '% vs ' + kpiName + ' ' + (kpiWorsePct === null ? 'n/a' : round(-kpiWorsePct,1) + '%') + '.', '');\n}\n\nif (kpiWorsePct === null) {\n  add('efficiency', 'A2', kpiName + ' trend', 'unknown', 'No comparable prior-week value.', '');\n} else if (kpiWorsePct > cfg.KPI_CRIT_PCT) {\n  add('efficiency', 'A2', kpiName + ' trend', 'critical',\n    kpiName + ' ' + round(kpiPrior,2) + ' to ' + round(kpiThis,2) + ' (' + round(kpiWorsePct,1) + '% worse).',\n    'Treat as the headline problem. Work the fatigue and waste findings below before touching budgets.');\n} else if (kpiWorsePct > cfg.KPI_FLAG_PCT) {\n  add('efficiency', 'A2', kpiName + ' trend', 'flag',\n    kpiName + ' ' + round(kpiPrior,2) + ' to ' + round(kpiThis,2) + ' (' + round(kpiWorsePct,1) + '% worse).', 'Watch daily, not weekly, until it stabilises.');\n} else {\n  add('efficiency', 'A2', kpiName + ' trend', 'pass', kpiName + ' ' + round(kpiPrior,2) + ' to ' + round(kpiThis,2) + '.', '');\n}\n\nconst cpmThis = num(acctThis.cpm), cpmPrior = num(acctPrior.cpm);\nconst cpmPct = pct(cpmThis, cpmPrior);\nif (cpmPct === null) {\n  add('efficiency', 'A3', 'CPM trend', 'unknown', 'No prior-week CPM.', '');\n} else if (cpmPct > cfg.CPM_CRIT_PCT) {\n  add('efficiency', 'A3', 'CPM trend', 'critical', 'CPM up ' + round(cpmPct,1) + '% ($' + round(cpmPrior,2) + ' to $' + round(cpmThis,2) + ').',\n    'Auction got expensive. Check audience saturation, new competition, or a bid or budget change you made.');\n} else if (cpmPct > cfg.CPM_FLAG_PCT) {\n  add('efficiency', 'A3', 'CPM trend', 'flag', 'CPM up ' + round(cpmPct,1) + '%.', 'Widen the audience or refresh creative before CPM compounds.');\n} else {\n  add('efficiency', 'A3', 'CPM trend', 'pass', 'CPM ' + round(cpmPct,1) + '% vs last week.', '');\n}\n\nconst imprThis = num(acctThis.impressions), imprPrior = num(acctPrior.impressions);\nconst imprPct = pct(imprThis, imprPrior);\nif (imprPct !== null && imprPct < -cfg.VOLUME_DROP_PCT && spendChangePct !== null && spendChangePct > -5) {\n  add('efficiency', 'A4', 'Volume trend', 'flag',\n    'Impressions down ' + round(Math.abs(imprPct),1) + '% while spend held or rose. You are paying more for less.',\n    'Check delivery limits, disapprovals, and audience size.');\n} else {\n  add('efficiency', 'A4', 'Volume trend', 'pass', 'Impressions ' + (imprPct === null ? 'n/a' : round(imprPct,1) + '%') + ' vs last week.', '');\n}\n\n// CTR is used to attribute the above: falling CTR points at creative, flat CTR at the auction.\nconst ctrThis = num(acctThis.ctr), ctrPrior = num(acctPrior.ctr);\nconst ctrPct = pct(ctrThis, ctrPrior);\nconst attribution = (ctrPct !== null && ctrPct < -10)\n  ? 'CTR fell ' + round(Math.abs(ctrPct),1) + '%, so the cost move is creative-led.'\n  : 'CTR held (' + (ctrPct === null ? 'n/a' : round(ctrPct,1) + '%') + '), so the cost move is auction-led, not creative.';\n\n// --- B. fatigue (summary level only) --------------------------------------\nconst fatigued = adsetRows\n  .map((r) => ({ name: r.adset_name, freq: num(r.frequency), spend: num(r.spend) }))\n  .filter((r) => r.freq >= cfg.FREQ_FLAG)\n  .sort((a, b) => b.freq - a.freq);\nconst fatiguedCrit = fatigued.filter((r) => r.freq >= cfg.FREQ_CRIT);\nif (fatiguedCrit.length) {\n  add('fatigue', 'B1', 'Frequency ceiling', 'critical',\n    fatiguedCrit.length + ' ad set(s) above frequency ' + cfg.FREQ_CRIT + ', worst ' + round(fatiguedCrit[0].freq,1) + ' (' + fatiguedCrit[0].name + ').',\n    'Refresh creative or expand the audience on these before spending another week.');\n} else if (fatigued.length) {\n  add('fatigue', 'B1', 'Frequency ceiling', 'flag',\n    fatigued.length + ' ad set(s) above frequency ' + cfg.FREQ_FLAG + ', worst ' + round(fatigued[0].freq,1) + ' (' + fatigued[0].name + ').',\n    'Queue creative refreshes now so you are not forced into one mid-decay.');\n} else {\n  add('fatigue', 'B1', 'Frequency ceiling', 'pass', 'No ad set above frequency ' + cfg.FREQ_FLAG + '.', '');\n}\n\n// --- C. waste (summary level only) ----------------------------------------\nconst zeroResult = adRows\n  .map((r) => ({ name: r.ad_name, spend: num(r.spend), results: resultsOf(r) }))\n  .filter((r) => r.results === 0 && r.spend >= cfg.ZERO_RESULT_MIN_SPEND)\n  .sort((a, b) => b.spend - a.spend);\nconst wasted = zeroResult.reduce((s, r) => s + r.spend, 0);\nif (zeroResult.length && wasted > spendThis * 0.1) {\n  add('waste', 'C1', 'Zero-result spenders', 'critical',\n    '$' + round(wasted,0) + ' across ' + zeroResult.length + ' ad(s) with zero results, ' + round((wasted/spendThis)*100,1) + '% of spend. Worst: ' + zeroResult[0].name + ' ($' + round(zeroResult[0].spend,0) + ').',\n    'Kill list. Pause them and redeploy into the scale candidate.');\n} else if (zeroResult.length) {\n  add('waste', 'C1', 'Zero-result spenders', 'flag',\n    '$' + round(wasted,0) + ' across ' + zeroResult.length + ' zero-result ad(s).', 'Pause anything past 1x target CPA with nothing to show.');\n} else {\n  add('waste', 'C1', 'Zero-result spenders', 'pass', 'No ad spending above $' + cfg.ZERO_RESULT_MIN_SPEND + ' with zero results.', '');\n}\n\n// --- E. delivery hygiene ---------------------------------------------------\nconst spendByAdset = {};\nadsetRows.forEach((r) => { spendByAdset[r.adset_id] = num(r.spend); });\nconst activeEnts = adsetEnts.filter((e) => e.effective_status === 'ACTIVE');\nconst notDelivering = activeEnts.filter((e) => (spendByAdset[e.id] || 0) < 1);\nif (notDelivering.length) {\n  add('delivery', 'E1', 'Not delivering', 'flag',\n    notDelivering.length + ' active ad set(s) spent under $1 this week: ' + notDelivering.slice(0,3).map((e) => e.name).join(', ') + '.',\n    'Check for rejected ads, zero-size audiences, or a bid cap strangling delivery.');\n} else {\n  add('delivery', 'E1', 'Not delivering', 'pass', 'Every active ad set delivered.', '');\n}\n\nconst clicksThis = num(acctThis.clicks);\nif (spendThis > 0 && clicksThis === 0) {\n  add('delivery', 'E2', 'Traffic sanity', 'critical', 'Spend recorded with zero clicks this week.', 'Something is broken. Check ad status and destination URLs before anything else.');\n} else {\n  add('delivery', 'E2', 'Traffic sanity', 'pass', round(clicksThis,0) + ' clicks on $' + round(spendThis,0) + ' spend.', '');\n}\n\n// --- F. structure ----------------------------------------------------------\nconst sortedAdsets = adsetRows.map((r) => ({ name: r.adset_name, spend: num(r.spend) })).sort((a, b) => b.spend - a.spend);\nconst topShare = (sortedAdsets.length && spendThis > 0) ? (sortedAdsets[0].spend / spendThis) * 100 : 0;\nif (topShare > cfg.CONCENTRATION_PCT) {\n  add('structure', 'F1', 'Concentration risk', 'flag',\n    'One ad set (' + sortedAdsets[0].name + ') carries ' + round(topShare,1) + '% of spend.',\n    'Build a second proven ad set. The account fails the week this one fatigues.');\n} else {\n  add('structure', 'F1', 'Concentration risk', 'pass', 'Top ad set is ' + round(topShare,1) + '% of spend.', '');\n}\n\nconst adsPerSet = {};\nadRows.forEach((r) => { adsPerSet[r.adset_id] = (adsPerSet[r.adset_id] || 0) + 1; });\nconst dense = Object.keys(adsPerSet).filter((k) => adsPerSet[k] > cfg.AD_DENSITY_MAX).length;\nconst single = Object.keys(adsPerSet).filter((k) => adsPerSet[k] === 1).length;\nif (dense || single) {\n  const parts = [];\n  if (dense) parts.push(dense + ' ad set(s) running more than ' + cfg.AD_DENSITY_MAX + ' ads');\n  if (single) parts.push(single + ' ad set(s) running a single ad');\n  const moves = [];\n  if (dense) moves.push('trim the dense ones so budget concentrates');\n  if (single) moves.push('add a second ad where there is only one');\n  add('structure', 'F2', 'Ad density', 'flag', parts.join(' and ') + '.',\n    moves.join(', ').replace(/^./, (c) => c.toUpperCase()) + '.');\n} else {\n  add('structure', 'F2', 'Ad density', 'pass', 'Ad counts per ad set look sane.', '');\n}\n\n// --- scoring ---------------------------------------------------------------\n// Category-weighted, not a flat penalty pool: each category starts at its full\n// weight and loses 70% for a critical, 35% for a flag, floored at zero. Momentum\n// is scored directly off the week-over-week KPI move so a recovering account\n// reads differently from a declining one at the same snapshot.\nconst W = cfg.WEIGHTS;\nconst catScore = (cat) => {\n  const rows = checks.filter((c) => c.category === cat && c.status !== 'unknown');\n  if (!rows.length) return { earned: W[cat], max: W[cat] };\n  let frac = 1;\n  rows.forEach((c) => {\n    if (c.status === 'critical') frac -= 0.70;\n    else if (c.status === 'flag') frac -= 0.35;\n  });\n  if (frac < 0) frac = 0;\n  return { earned: W[cat] * frac, max: W[cat] };\n};\n\nlet momentum;\nif (kpiWorsePct === null) momentum = W.momentum * 0.5;\nelse if (kpiWorsePct <= -10) momentum = W.momentum;            // improved 10%+\nelse if (kpiWorsePct <= 0) momentum = W.momentum * 0.8;\nelse if (kpiWorsePct <= cfg.KPI_FLAG_PCT) momentum = W.momentum * 0.5;\nelse if (kpiWorsePct <= cfg.KPI_CRIT_PCT) momentum = W.momentum * 0.25;\nelse momentum = 0;\n\nconst breakdown = {\n  efficiency: catScore('efficiency'),\n  waste: catScore('waste'),\n  fatigue: catScore('fatigue'),\n  delivery: catScore('delivery'),\n  structure: catScore('structure'),\n  momentum: { earned: momentum, max: W.momentum },\n};\nlet score = 0;\nObject.keys(breakdown).forEach((k) => { score += breakdown[k].earned; });\nscore = Math.max(0, Math.min(100, Math.round(score)));\n\nconst band = score >= 85 ? 'healthy' : score >= 70 ? 'minor fixes' : score >= 50 ? 'needs attention' : 'at risk';\n\nconst criticals = checks.filter((c) => c.status === 'critical');\nconst flags = checks.filter((c) => c.status === 'flag');\nconst passes = checks.filter((c) => c.status === 'pass');\n\nreturn [{ json: {\n  mode: MODE,\n  windows: { this: win.this_window, prior: win.prior_window },\n  account: {\n    spend_this: round(spendThis,2), spend_prior: round(spendPrior,2), spend_change_pct: round(spendChangePct,1),\n    kpi_name: kpiName, kpi_this: round(kpiThis,2), kpi_prior: round(kpiPrior,2), kpi_worse_pct: round(kpiWorsePct,1),\n    cpm_this: round(cpmThis,2), cpm_change_pct: round(cpmPct,1),\n    ctr_this: round(ctrThis,2), ctr_change_pct: round(ctrPct,1),\n    results_this: resThis, results_prior: resPrior,\n  },\n  attribution: attribution,\n  score: score, band: band, breakdown: breakdown,\n  counts: { passed: passes.length, flags: flags.length, critical: criticals.length },\n  checks: checks,\n  wasted_spend: round(wasted,0),\n  zero_result_ads: zeroResult.slice(0, 10),\n} }];"},"typeVersion":2},{"id":"n10","name":"Build AI triage prompt","type":"n8n-nodes-base.code","position":[1584,0],"parameters":{"jsCode":"// Turn the scored checks into an AI triage prompt. No API call here.\nconst d = $json;\n\n// Nothing to triage if the account returned no spend. Send a one-token request\n// so the chain stays intact and let the report node explain what happened.\nif (d.no_data) {\n  return [{ json: { body: { model: 'claude-haiku-4-5', max_tokens: 1, messages: [{ role: 'user', content: 'ok' }] }, _ctx: d } }];\n}\n\nconst notable = d.checks.filter((c) => c.status === 'critical' || c.status === 'flag');\n\nconst system = 'You are a senior Meta media buyer writing the Monday morning read for a busy operator. Plain, direct, numbers first, no hedging and no filler. Every claim carries its number. Never write an em dash, use a comma or a full stop. Only use figures that appear verbatim in the input, never derive or invent one. Return ONLY valid JSON matching the requested shape, no prose outside it.';\n\nconst user = [\n  'Account objective mode: ' + d.mode + ' (primary KPI: ' + d.account.kpi_name + ').',\n  'This week ' + d.windows.this.since + ' to ' + d.windows.this.until + ', prior week ' + d.windows.prior.since + ' to ' + d.windows.prior.until + '.',\n  '',\n  'Account level:',\n  '- Spend $' + d.account.spend_this + ' vs $' + d.account.spend_prior + ' (' + d.account.spend_change_pct + '%)',\n  '- ' + d.account.kpi_name + ': ' + d.account.kpi_this + ' vs ' + d.account.kpi_prior,\n  '- CPM $' + d.account.cpm_this + ' (' + d.account.cpm_change_pct + '%), CTR ' + d.account.ctr_this + '% (' + d.account.ctr_change_pct + '%)',\n  '- Results ' + d.account.results_this + ' vs ' + d.account.results_prior,\n  '- Attribution note: ' + d.attribution,\n  '',\n  'Health score ' + d.score + '/100 (' + d.band + '). ' + d.counts.critical + ' critical, ' + d.counts.flags + ' flags, ' + d.counts.passed + ' passed.',\n  '',\n  'Findings that are not passing:',\n  notable.map((c) => '- [' + c.status.toUpperCase() + '] ' + c.label + ': ' + c.detail + (c.move ? ' Suggested move: ' + c.move : '')).join('\\n'),\n  '',\n  'Rank the three fixes that matter most this week. A composite \"scaling into weakness\" finding almost always outranks the rest. Each fix must name the number behind it and the exact move, in one sentence. Do not invent numbers that are not above.',\n  '',\n  'Return JSON: {\"headline\":\"one sentence on the state of the account\",\"fixes\":[{\"rank\":1,\"finding\":\"\",\"number\":\"\",\"move\":\"\"}],\"watch\":\"one thing to watch that is not yet a problem\"}',\n].join('\\n');\n\nconst body = { model: 'claude-haiku-4-5', max_tokens: 1400, system: system, messages: [{ role: 'user', content: user }] };\nreturn [{ json: { body: body, _ctx: d } }];"},"typeVersion":2},{"id":"n11","name":"Rank fixes with Claude AI","type":"n8n-nodes-base.httpRequest","position":[1808,0],"parameters":{"url":"https://api.anthropic.com/v1/messages","method":"POST","options":{},"jsonBody":"={{ $json.body }}","sendBody":true,"sendHeaders":true,"specifyBody":"json","headerParameters":{"parameters":[{"name":"x-api-key","value":"={{ $env.ANTHROPIC_API_KEY }}"},{"name":"anthropic-version","value":"2023-06-01"},{"name":"content-type","value":"application/json"}]}},"typeVersion":4.2},{"id":"n12","name":"Print health scorecard","type":"n8n-nodes-base.code","position":[2032,0],"parameters":{"jsCode":"// Assemble the scorecard. Returns the report so it shows in the node output\n// and can be chained into Slack, Gmail, or a Sheets row.\nconst ctx = $('Build AI triage prompt').first().json._ctx;\n\nif (ctx.no_data) {\n  const msg = 'META ADS HEALTH SCORE  ' + ctx.windows.this.since + ' to ' + ctx.windows.this.until + '\\n' +\n    '-----------------------------------------------------------------------\\n' +\n    'No score produced.\\n\\n' + ctx.message;\n  return [{ json: { report: msg, score: null, band: 'no data', no_data: true, mode: ctx.mode, counts: ctx.counts } }];\n}\n\nlet ai = {};\ntry {\n  const txt = ($json.content && $json.content[0] && $json.content[0].text) || '{}';\n  ai = JSON.parse(txt.replace(/^[^{]*/, '').replace(/[^}]*$/, ''));\n} catch (e) {\n  ai = { headline: '', fixes: [], watch: '' };\n}\n\nconst pad = (s, n) => (s + '                                        ').slice(0, n);\nconst L = [];\nL.push('META ADS HEALTH SCORE  ' + ctx.windows.this.since + ' to ' + ctx.windows.this.until + '   [objective: ' + ctx.mode + ']');\nL.push('-----------------------------------------------------------------------');\nL.push('HEALTH SCORE   ' + ctx.score + ' / 100   (' + ctx.band + ')');\nL.push('');\nif (ai.headline) { L.push(ai.headline); L.push(''); }\n\nL.push('FIX THIS WEEK');\nif ((ai.fixes || []).length) {\n  ai.fixes.forEach((f) => L.push('  ' + f.rank + '. ' + f.finding + (f.number ? ' (' + f.number + ')' : '') + ' -> ' + f.move));\n} else {\n  L.push('  Nothing critical. See the check list below.');\n}\nL.push('');\n\nL.push('SCORE BREAKDOWN');\nObject.keys(ctx.breakdown).forEach((k) => {\n  const b = ctx.breakdown[k];\n  L.push('  ' + pad(k, 12) + Math.round(b.earned) + ' / ' + b.max);\n});\nL.push('');\nL.push('  ' + ctx.counts.passed + ' passed   ' + ctx.counts.flags + ' flags   ' + ctx.counts.critical + ' critical');\nif (ai.watch) L.push('  Watch: ' + ai.watch);\nL.push('');\nL.push('ALL CHECKS');\nctx.checks.forEach((c) => L.push('  [' + c.status + '] ' + c.label + ': ' + c.detail));\n\nreturn [{ json: { report: L.join('\\n'), score: ctx.score, band: ctx.band, mode: ctx.mode, counts: ctx.counts, breakdown: ctx.breakdown, checks: ctx.checks, ai: ai, account: ctx.account } }];"},"typeVersion":2},{"id":"s0","name":"Sticky Note - Overview","type":"n8n-nodes-base.stickyNote","position":[-1648,-320],"parameters":{"width":1012,"height":668,"content":"## Meta Ads Weekly Health Score\n\nGrades a Meta ad account 0 to 100 every week, compares it against the prior week, and hands back the three things to fix. It detects the account objective first, so a lead-gen account is graded on cost per result and CTR instead of a ROAS it never targeted.\n\n### How it works\n- Pulls this week and the 7 days before it at account, ad set, and ad level from the Meta Marketing API.\n- Runs checks across efficiency trend, fatigue, wasted spend, delivery hygiene, and structure. The headline check is spend rising while the primary KPI falls.\n- Scores each category on its own weight, so the number reconciles to the flags shown.\n- Claude ranks the top three fixes, each with the number behind it and the exact move.\n\n### Setup\n1. Add to your environment: META_ACCESS_TOKEN, META_AD_ACCOUNT_ID, META_API_VERSION, ANTHROPIC_API_KEY.\n2. Run with the manual trigger, or attach a Schedule trigger for Monday mornings.\n\n### Customization\nEvery threshold and the six scoring weights live in the Config node. Set RESULT_ACTIONS to the events you optimize for. Swap the final node for Slack or Gmail.\n\nBuilt by **nocode.expert** - done-for-you automation & tracking.\n\nFull walkthrough, including every threshold: https://nocode.expert/resources/how-to-check-facebook-ad-account-health"},"typeVersion":1},{"id":"s1","name":"Sticky Note - Section 1","type":"n8n-nodes-base.stickyNote","position":[-304,160],"parameters":{"color":7,"width":484,"height":380,"content":"### 1. Config and windows\n\nEverything tunable sits in the Config node: thresholds, the RESULT_ACTIONS list, and the six scoring weights.\n\nThe windows node does date math only. Meta's last_7d ends yesterday, so the prior window is the 7 days immediately before that. Two windows means every metric carries a trend instead of a bare value."},"typeVersion":1},{"id":"s2","name":"Sticky Note - Section 2","type":"n8n-nodes-base.stickyNote","position":[240,176],"parameters":{"color":7,"width":1080,"height":380,"content":"### 2. Pull both windows at three levels\n\nAccount level twice (this week and prior) gives the trend. Ad set level gives frequency and spend concentration. The ad set entity call gives status and budget, which is how active-but-not-delivering ad sets are caught. Ad level gives the zero-result spenders.\n\nRead only. Nothing here pauses an ad or changes a budget.\n\nFatigue and wasted spend are deliberately summary level here, since this template is the scorecard. For the per-placement, per-region, per-hour breakdown use the dedicated wasted-spend and creative-fatigue templates."},"typeVersion":1},{"id":"s3","name":"Sticky Note - Section 3","type":"n8n-nodes-base.stickyNote","position":[1344,176],"parameters":{"color":7,"width":900,"height":380,"content":"### 3. Score, rank, report\n\nScoring is category weighted rather than a flat penalty pool. Each category starts at its full weight and loses 70 percent for a critical and 35 percent for a flag, floored at zero. Momentum is scored straight off the week-over-week KPI move, so a 74 climbing from 60 reads differently from a 74 that fell from 88.\n\nClaude only ranks and phrases. Every number in the report comes from the checks node, so nothing is invented.\n\nThe final node returns the report plus the full structured result, so you can chain Slack, Gmail, or a Sheets row after it."},"typeVersion":1},{"id":"65d8c7b9-1f63-4c2c-950e-a49e4fb6a42e","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","position":[-416,0],"parameters":{"rule":{"interval":[{"field":"weeks","triggerAtDay":[1]}]}},"typeVersion":1.3}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"b5e7d48e-075c-48f1-9eb5-756ddfcbd8b1","nodeGroups":[],"connections":{"Schedule Trigger":{"main":[[{"node":"Set config: health score","type":"main","index":0}]]},"Run checks and score":{"main":[[{"node":"Build AI triage prompt","type":"main","index":0}]]},"Build AI triage prompt":{"main":[[{"node":"Rank fixes with Claude AI","type":"main","index":0}]]},"Build comparison windows":{"main":[[{"node":"Fetch account this week (Meta)","type":"main","index":0}]]},"Fetch ad insights (Meta)":{"main":[[{"node":"Run checks and score","type":"main","index":0}]]},"Set config: health score":{"main":[[{"node":"Build comparison windows","type":"main","index":0}]]},"Rank fixes with Claude AI":{"main":[[{"node":"Print health scorecard","type":"main","index":0}]]},"Fetch ad set entities (Meta)":{"main":[[{"node":"Fetch ad insights (Meta)","type":"main","index":0}]]},"Fetch ad set insights (Meta)":{"main":[[{"node":"Fetch ad set entities (Meta)","type":"main","index":0}]]},"Fetch account this week (Meta)":{"main":[[{"node":"Fetch account prior week (Meta)","type":"main","index":0}]]},"Fetch account prior week (Meta)":{"main":[[{"node":"Fetch ad set insights (Meta)","type":"main","index":0}]]}}}