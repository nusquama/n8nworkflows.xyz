{"id":"megcge2UEMFN4g3N","meta":{"instanceId":"28ca37d3368f4c0632c04a2232b273aed63f3b9214206087d3d1b91be5ec5c1f","templateCredsSetupCompleted":true},"name":"Real-Time Inventory & Auto-Reorder Pipeline","tags":[],"nodes":[{"id":"642a0ab3-bb88-4dde-9689-c641d29a7e4d","name":"OpenAI Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[-1680,2928],"parameters":{"model":"gpt-4-turbo-preview","options":{"temperature":0,"responseFormat":"json_object"}},"typeVersion":1},{"id":"30d49465-0f34-4f98-8907-09ae8dacd9c3","name":"Convert education to HTML","type":"n8n-nodes-base.code","position":[-672,2784],"parameters":{"mode":"runOnceForEachItem","jsCode":"function convertToHTML(list) {\n let html = '';\n\n list.forEach((education, index) => {\n if (index > 0) {\n html += '<br /><br />'; // Add a new line if it's not the first item\n }\n html += `<b>Institution:</b> ${education.institution}<br />\n<b>Start year:</b> ${education.start_year}<br />\n<b>Degree:</b> ${education.degree}`;\n });\n\n return html;\n}\n\n// Assuming payload is already defined\nconst payload = $input.item.json.education;\n\nconst htmlOutput = convertToHTML(payload);\nreturn {\n htmlOutput\n};"},"typeVersion":2},{"id":"857b14b8-7530-4c0c-9181-33f25a34d0bc","name":"Auto-fixing Output Parser","type":"@n8n/n8n-nodes-langchain.outputParserAutofixing","position":[-1440,2928],"parameters":{"options":{}},"typeVersion":1},{"id":"ba4e0e79-c478-48d1-8e88-5f372360d770","name":"OpenAI Chat Model1","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[-1520,3120],"parameters":{"options":{"temperature":0}},"typeVersion":1},{"id":"3edaab0e-a2b7-4397-b887-e4a0aacbe7fc","name":"Structured Output Parser","type":"@n8n/n8n-nodes-langchain.outputParserStructured","position":[-1296,3120],"parameters":{"jsonSchema":"{\n \"type\": \"object\",\n \"properties\": {\n \"personal_info\": {\n \"type\": \"object\",\n \"properties\": {\n \"name\": { \"type\": \"string\" },\n \"address\": { \"type\": \"string\" },\n \"email\": { \"type\": \"string\", \"format\": \"email\" },\n \"github\": { \"type\": \"string\"},\n \"linkedin\": { \"type\": \"string\" }\n }\n },\n \"employment_history\": {\n \"type\": \"array\",\n \"items\": {\n \"type\": \"object\",\n \"properties\": {\n \"position\": { \"type\": \"string\" },\n \"company\": { \"type\": \"string\" },\n \"duration\": { \"type\": \"string\" },\n \"responsibilities\": {\n \"type\": \"array\",\n \"items\": { \"type\": \"string\" }\n }\n }\n }\n },\n \"education\": {\n \"type\": \"array\",\n \"items\": {\n \"type\": \"object\",\n \"properties\": {\n \"institution\": { \"type\": \"string\" },\n \"start_year\": { \"type\": \"integer\" },\n \"degree\": { \"type\": \"string\" }\n }\n }\n },\n \"projects\": {\n \"type\": \"array\",\n \"items\": {\n \"type\": \"object\",\n \"properties\": {\n \"name\": { \"type\": \"string\" },\n \"year\": { \"type\": \"integer\" },\n \"description\": { \"type\": \"string\" },\n \"technologies\": {\n \"type\": \"array\",\n \"items\": { \"type\": \"string\" }\n }\n }\n }\n },\n \"volunteering\": {\n \"type\": \"array\",\n \"items\": {\n \"type\": \"object\",\n \"properties\": {\n \"activity\": { \"type\": \"string\" },\n \"location\": { \"type\": \"string\" },\n \"date\": { \"type\": \"string\" },\n \"description\": { \"type\": \"string\" }\n }\n }\n },\n \"programming_languages\": {\n \"type\": \"object\",\n \"properties\": {\n \"languages\": {\n \"type\": \"array\",\n \"items\": { \"type\": \"string\" }\n },\n \"tools\": {\n \"type\": \"array\",\n \"items\": { \"type\": \"string\" }\n },\n \"methodologies\": {\n \"type\": \"array\",\n \"items\": { \"type\": \"string\" }\n }\n }\n },\n \"foreign_languages\": {\n \"type\": \"array\",\n \"items\": {\n \"type\": \"object\",\n \"properties\": {\n \"language\": { \"type\": \"string\" },\n \"level\": { \"type\": \"string\" }\n }\n }\n }\n }\n}\n"},"typeVersion":1},{"id":"fbd6b2f2-7f75-4c90-b259-72e847257162","name":"Convert employment history to HTML","type":"n8n-nodes-base.code","position":[-672,2592],"parameters":{"mode":"runOnceForEachItem","jsCode":"function convertToHTML(list) {\n let html = '';\n\n list.forEach((item, index) => {\n if (index > 0) {\n html += '<br />'; // Add a new line if it's not the first item\n }\n html += `<b>Position:</b> ${item.position}\n<b>Company:</b> ${item.company}\n<br />\n<b>Duration:</b> ${item.duration}\n<br />\n<b>Responsibilities:</b>\n`;\n\n item.responsibilities.forEach((responsibility, i) => {\n html += `- ${responsibility}`;\n if (i < item.responsibilities.length - 1 || index < list.length - 1) {\n html += '<br />'; // Add new line if it's not the last responsibility in the last item\n }\n });\n });\n\n return html;\n}\n\n// Assuming payload is already defined\nconst payload = $input.item.json.employment_history;\n\nconst htmlOutput = convertToHTML(payload);\nreturn {\n htmlOutput\n};"},"typeVersion":2},{"id":"d7dfd7dd-7082-4174-ac80-a1844df04b8f","name":"Convert projects to HTML","type":"n8n-nodes-base.code","position":[-672,2992],"parameters":{"mode":"runOnceForEachItem","jsCode":"function convertToHTML(list) {\n let html = '';\n\n list.forEach((project, index) => {\n if (index > 0) {\n html += '<br />'; // Add a new line if it's not the first project\n }\n html += `<b>Name:</b> ${project.name}<br />\n<b>Year:</b> ${project.year}<br />\n<b>Description:</b> ${project.description}<br /><br />\n<b>Technologies:</b>\n<br />`;\n\n project.technologies.forEach((technology, i) => {\n html += `- ${technology}`;\n if (i < project.technologies.length - 1 || index < list.length - 1) {\n html += '<br />'; // Add new line if it's not the last technology in the last project\n }\n });\n });\n\n return html;\n}\n\n// Assuming payload is already defined\nconst payload = $input.item.json.projects;\n\nconst htmlOutput = convertToHTML(payload);\nreturn {\n htmlOutput\n};\n"},"typeVersion":2},{"id":"561187f9-f8b6-497b-b6bd-cb193299d3cf","name":"Convert volunteering to HTML","type":"n8n-nodes-base.code","position":[-672,3184],"parameters":{"mode":"runOnceForEachItem","jsCode":"function convertToHTML(list) {\n let html = '';\n\n list.forEach((event, index) => {\n if (index > 0) {\n html += '<br />'; // Add a new line if it's not the first volunteering event\n }\n html += `<b>Activity:</b> ${event.activity}<br />\n<b>Location:</b> ${event.location}<br />\n<b>Date:</b> ${event.date}<br />\n<b>Description:</b> ${event.description}<br />`;\n });\n\n return html;\n}\n\n// Assuming payload is already defined\nconst payload = $input.item.json.volunteering;\n\nconst htmlOutput = convertToHTML(payload);\nreturn {\n htmlOutput\n};\n"},"typeVersion":2},{"id":"239d00a2-538b-4ce8-afd4-719328884f71","name":"Telegram trigger","type":"n8n-nodes-base.telegramTrigger","position":[-3072,2928],"webhookId":"d6829a55-a01b-44ac-bad3-2349324c8515","parameters":{"updates":["message"],"additionalFields":{}},"typeVersion":1.1},{"id":"09f78c21-8edd-4b04-b84e-8e1883c26c1e","name":"Auth","type":"n8n-nodes-base.if","position":[-2832,2928],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"7ca4b4c3-e23b-4896-a823-efc85c419467","operator":{"type":"number","operation":"equals"},"leftValue":"={{ $json.message.chat.id }}","rightValue":0}]}},"typeVersion":2},{"id":"bd5828c7-51a5-4883-9d5d-5429b288ceab","name":"No operation (unauthorized)","type":"n8n-nodes-base.noOp","position":[-2576,3120],"parameters":{},"typeVersion":1},{"id":"acc0d1fc-fac9-4173-95a8-7ab1c179e38d","name":"Check if start message","type":"n8n-nodes-base.if","position":[-2576,2816],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"1031f14f-9793-488d-bb6b-a021f943a399","operator":{"type":"string","operation":"notEquals"},"leftValue":"={{ $json.message.text }}","rightValue":"/start"}]}},"typeVersion":2},{"id":"3525d674-b830-4db4-afe0-6fe9346b9be6","name":"No operation (start message)","type":"n8n-nodes-base.noOp","position":[-2320,2960],"parameters":{},"typeVersion":1},{"id":"f5b0d6e2-e3a3-4aab-ab17-e40887777e09","name":"Get file","type":"n8n-nodes-base.telegram","position":[-2320,2720],"webhookId":"59eaae5c-b0bc-4766-98e0-2ed46e9e6f7f","parameters":{"fileId":"={{ $json.message.document.file_id }}","resource":"file","additionalFields":{}},"typeVersion":1.1},{"id":"6b7e5634-a7de-4705-8225-b7568f33017a","name":"Extract text from PDF","type":"n8n-nodes-base.extractFromFile","position":[-1872,2720],"parameters":{"options":{},"operation":"pdf"},"typeVersion":1},{"id":"61f36938-2cbf-443e-9947-e07c9bd46983","name":"Set parsed fileds","type":"n8n-nodes-base.set","position":[-1216,2720],"parameters":{"options":{}},"typeVersion":3.2},{"id":"7f4ea160-c321-428e-a8dd-5ef8703af490","name":"Personal info","type":"n8n-nodes-base.set","position":[-672,2224],"parameters":{"fields":{"values":[{"name":"personal_info","stringValue":"=<b><u>Personal info</u></b>\n<br /><br />\n<b>Name:</b> {{ $json.personal_info.name }}\n<br />\n<b>Address:</b> {{ $json.personal_info.address }}\n<br />\n<b>Email:</b> {{ $json.personal_info.email }}\n<br />\n<b>GitHub:</b> {{ $json.personal_info.github }}\n<br />"}]},"include":"none","options":{}},"typeVersion":3.2},{"id":"08efc5c6-be8a-4589-ae1b-5cf039c14189","name":"Technologies","type":"n8n-nodes-base.set","position":[-672,2416],"parameters":{"fields":{"values":[{"name":"technologies","stringValue":"=<b><u>Technologies</u></b>\n<br /><br />\n<b>Programming languages:</b> {{ $json.programming_languages.languages.join(', ') }}\n<br />\n<b>Tools:</b> {{ $json.programming_languages.tools.join(', ') }}\n<br />\n<b>Methodologies:</b> {{ $json.programming_languages.methodologies.join(', ') }}\n<br />"}]},"include":"none","options":{}},"typeVersion":3.2},{"id":"3231dfe4-29d9-4057-a5e2-cd43e70ff7cd","name":"Employment history","type":"n8n-nodes-base.set","position":[-464,2592],"parameters":{"fields":{"values":[{"name":"employment_history","stringValue":"=<b><u>Employment history</u></b>\n<br /><br />\n{{ $json[\"htmlOutput\"] }}"}]},"include":"none","options":{}},"typeVersion":3.2},{"id":"2105d0cf-4823-4223-a1d4-f3eba342b0c0","name":"Education","type":"n8n-nodes-base.set","position":[-464,2784],"parameters":{"fields":{"values":[{"name":"education","stringValue":"=<b><u>Education</u></b>\n<br /><br />\n{{ $json[\"htmlOutput\"] }}"}]},"include":"none","options":{}},"typeVersion":3.2},{"id":"d70931ad-20cf-42a4-a1ea-88bb988b4a9a","name":"Projects","type":"n8n-nodes-base.set","position":[-464,2992],"parameters":{"fields":{"values":[{"name":"projects","stringValue":"=<b><u>Projects</u></b>\n<br /><br />\n{{ $json[\"htmlOutput\"] }}"}]},"include":"none","options":{}},"typeVersion":3.2},{"id":"c214fdd4-4d2a-4b43-8f03-1d4075084b57","name":"Volunteering","type":"n8n-nodes-base.set","position":[-464,3184],"parameters":{"fields":{"values":[{"name":"volunteering","stringValue":"=<b><u>Volunteering</u></b>\n<br /><br />\n{{ $json[\"htmlOutput\"] }}"}]},"include":"none","options":{}},"typeVersion":3.2},{"id":"8581f261-44b5-4bf1-835e-0050c3dec069","name":"Merge education and employment history","type":"n8n-nodes-base.merge","position":[-224,2704],"parameters":{"mode":"combine","options":{},"combinationMode":"multiplex"},"typeVersion":2.1},{"id":"c73293bc-30a8-4cde-a9ad-0efb21e59296","name":"Merge projects and volunteering","type":"n8n-nodes-base.merge","position":[-224,3104],"parameters":{"mode":"combine","options":{},"combinationMode":"multiplex"},"typeVersion":2.1},{"id":"dceff72a-7789-474c-9095-b6384fa6fadd","name":"Merge personal info and technologies","type":"n8n-nodes-base.merge","position":[48,2448],"parameters":{"mode":"combine","options":{},"combinationMode":"multiplex"},"typeVersion":2.1},{"id":"f739b12d-7ce0-4ea3-ac97-9479b5513ec5","name":"Merge all","type":"n8n-nodes-base.merge","position":[304,2816],"parameters":{"mode":"combine","options":{},"combinationMode":"multiplex"},"typeVersion":2.1},{"id":"5c5f08c1-7f3f-4e95-9c4f-36680d5932d8","name":"Set final data","type":"n8n-nodes-base.set","position":[528,2816],"parameters":{"fields":{"values":[{"name":"output","stringValue":"={{ $json.personal_info }}\n<br /><br />\n{{ $json.employment_history }}\n<br /><br />\n{{ $json.education }}\n<br /><br />\n{{ $json.projects }}\n<br /><br />\n{{ $json.volunteering }}\n<br /><br />\n{{ $json.technologies }}"}]},"include":"none","options":{}},"typeVersion":3.2},{"id":"93a08554-56fa-49ba-accf-9ba4e8a62e1c","name":"Convert raw to base64","type":"n8n-nodes-base.code","position":[960,2800],"parameters":{"mode":"runOnceForEachItem","jsCode":"const encoded = Buffer.from($json.output).toString('base64');\n\nreturn { encoded };"},"typeVersion":2},{"id":"ab8b4ace-a8cd-41e8-ba49-0b9cc74fe9ea","name":"Convert to HTML","type":"n8n-nodes-base.convertToFile","position":[1184,2800],"parameters":{"options":{"fileName":"index.html","mimeType":"text/html"},"operation":"toBinary","sourceProperty":"encoded"},"typeVersion":1.1},{"id":"16616f76-15df-4b75-b2c6-9654a1f20b6f","name":"Generate plain PDF doc","type":"n8n-nodes-base.httpRequest","position":[1456,2800],"parameters":{"url":"http://gotenberg:3000/forms/chromium/convert/html","method":"POST","options":{"response":{"response":{"responseFormat":"file"}}},"sendBody":true,"contentType":"multipart-form-data","bodyParameters":{"parameters":[{"name":"files","parameterType":"formBinaryData","inputDataFieldName":"data"}]}},"typeVersion":4.1},{"id":"718c983a-f53e-4bf2-9a43-449acc370da9","name":"Send PDF to the user","type":"n8n-nodes-base.telegram","position":[1760,2800],"webhookId":"6ab87c03-c794-408f-af16-aeee7ad4abd3","parameters":{"chatId":"={{ $('Telegram trigger').item.json[\"message\"][\"chat\"][\"id\"] }}","operation":"sendDocument","binaryData":true,"additionalFields":{"fileName":"={{ $('Set parsed fileds').item.json[\"personal_info\"][\"name\"].toLowerCase().replace(' ', '-') }}.pdf"}},"typeVersion":1.1},{"id":"140ee0af-8e02-4d62-a6e9-8bf369592062","name":"Parse resume data","type":"@n8n/n8n-nodes-langchain.chainLlm","position":[-1600,2720],"parameters":{"prompt":"={{ $json.text }}","messages":{"messageValues":[{"message":"Your task is to extract all necessary data such as first name, last name, experience, known technologies etc. from the provided resume text and return in well-unified JSON format. Do not make things up."}]}},"typeVersion":1.3},{"id":"cb30effe-703c-4753-968d-a74734de9010","name":"Merge other data","type":"n8n-nodes-base.merge","position":[48,2944],"parameters":{"mode":"combine","options":{},"combinationMode":"multiplex"},"typeVersion":2.1},{"id":"092bca69-d163-4077-b044-319a86eb8cb3","name":"Overview","type":"n8n-nodes-base.stickyNote","position":[-3776,2352],"parameters":{"color":7,"width":520,"height":1924,"content":"## 📄 Resume Data Extraction with Telegram and Gotenberg\n\nTurns any resume PDF sent to a Telegram bot into a clean, reformatted PDF. The content is extracted with AI, structured into a strict schema, rebuilt as HTML, and rendered back to PDF by a Gotenberg service running in your own infrastructure.\n\n**Perfect for:** Recruiters and staffing teams who want resumes normalized into a consistent format the moment a candidate submits one.\n\n---\n\n## How it works\n\n1. **Telegram trigger**: Fires whenever a message arrives in the bot's chat.\n2. **Auth**: Checks the sender's chat id against an authorized id and drops any message that doesn't match.\n3. **No operation (unauthorized)**: Silently discards messages from unauthorized senders.\n4. **Check if start message**: Filters out the /start command from actual resume submissions.\n5. **No operation (start message)**: Ends the run quietly when the message was just /start.\n6. **Get file**: Downloads the attached document from Telegram using its file id.\n7. **Extract text from PDF**: Pulls the raw text out of the uploaded resume PDF.\n8. **Parse resume data**: Extracts structured resume data as JSON, reasoning with the *OpenAI Chat Model* and validating the output against the *Structured Output Parser* schema through the *Auto-fixing Output Parser* (backed by *OpenAI Chat Model1*), which automatically repairs any malformed JSON.\n9. **Set parsed fileds**: Holds the validated resume JSON and fans it out to every formatting branch.\n10. **Personal info**: Formats name, address, email, and GitHub into an HTML block.\n11. **Technologies**: Formats programming languages, tools, and methodologies into an HTML block.\n12. **Convert employment history to HTML**: Turns the employment history array into formatted HTML.\n13. **Convert education to HTML**: Turns the education array into formatted HTML.\n14. **Convert projects to HTML**: Turns the projects array into formatted HTML.\n15. **Convert volunteering to HTML**: Turns the volunteering array into formatted HTML.\n16. **Employment history, Education, Projects, Volunteering**: Each wraps its section's HTML with a heading.\n17. **Merge education and employment history, Merge projects and volunteering, Merge personal info and technologies**: Combine matching section pairs into single items.\n18. **Merge other data**: Combines the education and employment merge with the projects and volunteering merge.\n19. **Merge all**: Brings every section together into one final item.\n20. **Set final data**: Concatenates all six sections into one complete HTML document string.\n21. **Convert raw to base64**: Base64 encodes the final HTML string.\n22. **Convert to HTML**: Converts the encoded string into a binary index.html file.\n23. **Generate plain PDF doc**: Sends the HTML file to a Gotenberg service, which renders it to PDF.\n24. **Send PDF to the user**: Sends the finished PDF back to the candidate's Telegram chat, named after them.\n\n---\n\n## Setup (~15 minutes)\n\n1. **Telegram**: Connect your bot account in *Telegram trigger*, *Get file*, and *Send PDF to the user*.\n2. **Auth**: Replace the placeholder chat id (0) in the *Auth* node with your own authorized Telegram chat id.\n3. **OpenAI**: Add your API key in *OpenAI Chat Model* and *OpenAI Chat Model1*.\n4. **Gotenberg**: Run a Gotenberg instance reachable at the URL used in *Generate plain PDF doc* (defaults to http://gotenberg:3000); update the URL if it's hosted elsewhere.\n> This workflow assumes every submitted document is a resume PDF containing selectable text; scanned PDFs that are only images will extract little to no text."},"typeVersion":1},{"id":"5e8f573f-3fbf-4b84-aada-e14fff118e94","name":"Section 1 - Telegram Intake & Auth","type":"n8n-nodes-base.stickyNote","position":[-3168,2560],"parameters":{"color":5,"width":1120,"height":760,"content":"## 1️⃣ Telegram Intake & Auth\n\n**Telegram trigger** fires on every incoming message, and **Auth** checks the sender's chat id, sending anything unauthorized to **No operation (unauthorized)** to be silently dropped. **Check if start message** filters out the /start command, routing it to **No operation (start message)**, while real submissions continue to **Get file**, which downloads the attached document."},"typeVersion":1},{"id":"623d7266-d542-45a7-88d3-84e1cfb6d21d","name":"Section 2 - AI Resume Parsing","type":"n8n-nodes-base.stickyNote","position":[-2000,2496],"parameters":{"color":3,"width":1180,"height":816,"content":"## 2️⃣ AI Resume Parsing\n\n**Extract text from PDF** pulls the raw text out of the resume, and **Parse resume data** turns it into structured JSON using the **OpenAI Chat Model**. The **Structured Output Parser** defines the target schema, and the **Auto-fixing Output Parser** (backed by **OpenAI Chat Model1**) repairs any output that doesn't match it before **Set parsed fileds** holds the clean result and fans it out to every formatting branch."},"typeVersion":1},{"id":"36af227f-c0db-4114-98bb-b4312f4ebe4b","name":"Section 3 - HTML Section Building","type":"n8n-nodes-base.stickyNote","position":[-768,2048],"parameters":{"color":6,"width":1564,"height":1320,"content":"## 3️⃣ HTML Section Building\n\nSix parallel branches format each section of the resume. **Personal info** and **Technologies** build their blocks directly, while **Convert employment history to HTML**, **Convert education to HTML**, **Convert projects to HTML**, and **Convert volunteering to HTML** turn their respective arrays into HTML before **Employment history**, **Education**, **Projects**, and **Volunteering** add headings. **Merge education and employment history**, **Merge projects and volunteering**, **Merge personal info and technologies**, **Merge other data**, and **Merge all** progressively combine every branch back into a single item."},"typeVersion":1},{"id":"cdc32494-2576-480d-90ae-6e76c00b19c4","name":"Section 4 - PDF Generation & Delivery","type":"n8n-nodes-base.stickyNote","position":[864,2640],"parameters":{"color":4,"width":1428,"height":360,"content":"## 4️⃣ PDF Generation & Delivery\n\n**Set final data** concatenates every formatted section into one HTML document, and **Convert raw to base64** and **Convert to HTML** package it as a binary file. **Generate plain PDF doc** sends that file to a Gotenberg service to render the PDF, and **Send PDF to the user** delivers the finished document back to the candidate on Telegram."},"typeVersion":1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":false,"executionOrder":"v1"},"versionId":"b825f7dc-da13-4910-b824-a3ec99b05ae5","nodeGroups":[],"connections":{"Auth":{"main":[[{"node":"Check if start message","type":"main","index":0}],[{"node":"No operation (unauthorized)","type":"main","index":0}]]},"Get file":{"main":[[{"node":"Extract text from PDF","type":"main","index":0}]]},"Projects":{"main":[[{"node":"Merge projects and volunteering","type":"main","index":0}]]},"Education":{"main":[[{"node":"Merge education and employment history","type":"main","index":1}]]},"Merge all":{"main":[[{"node":"Set final data","type":"main","index":0}]]},"Technologies":{"main":[[{"node":"Merge personal info and technologies","type":"main","index":1}]]},"Volunteering":{"main":[[{"node":"Merge projects and volunteering","type":"main","index":1}]]},"Personal info":{"main":[[{"node":"Merge personal info and technologies","type":"main","index":0}]]},"Set final data":{"main":[[{"node":"Convert raw to base64","type":"main","index":0}]]},"Convert to HTML":{"main":[[{"node":"Generate plain PDF doc","type":"main","index":0}]]},"Merge other data":{"main":[[{"node":"Merge all","type":"main","index":1}]]},"Telegram trigger":{"main":[[{"node":"Auth","type":"main","index":0}]]},"OpenAI Chat Model":{"ai_languageModel":[[{"node":"Parse resume data","type":"ai_languageModel","index":0}]]},"Parse resume data":{"main":[[{"node":"Set parsed fileds","type":"main","index":0}]]},"Set parsed fileds":{"main":[[{"node":"Convert employment history to HTML","type":"main","index":0},{"node":"Convert education to HTML","type":"main","index":0},{"node":"Convert projects to HTML","type":"main","index":0},{"node":"Personal info","type":"main","index":0},{"node":"Convert volunteering to HTML","type":"main","index":0},{"node":"Technologies","type":"main","index":0}]]},"Employment history":{"main":[[{"node":"Merge education and employment history","type":"main","index":0}]]},"OpenAI Chat Model1":{"ai_languageModel":[[{"node":"Auto-fixing Output Parser","type":"ai_languageModel","index":0}]]},"Convert raw to base64":{"main":[[{"node":"Convert to HTML","type":"main","index":0}]]},"Extract text from PDF":{"main":[[{"node":"Parse resume data","type":"main","index":0}]]},"Check if start message":{"main":[[{"node":"Get file","type":"main","index":0}],[{"node":"No operation (start message)","type":"main","index":0}]]},"Generate plain PDF doc":{"main":[[{"node":"Send PDF to the user","type":"main","index":0}]]},"Convert projects to HTML":{"main":[[{"node":"Projects","type":"main","index":0}]]},"Structured Output Parser":{"ai_outputParser":[[{"node":"Auto-fixing Output Parser","type":"ai_outputParser","index":0}]]},"Auto-fixing Output Parser":{"ai_outputParser":[[{"node":"Parse resume data","type":"ai_outputParser","index":0}]]},"Convert education to HTML":{"main":[[{"node":"Education","type":"main","index":0}]]},"Convert volunteering to HTML":{"main":[[{"node":"Volunteering","type":"main","index":0}]]},"Merge projects and volunteering":{"main":[[{"node":"Merge other data","type":"main","index":1}]]},"Convert employment history to HTML":{"main":[[{"node":"Employment history","type":"main","index":0}]]},"Merge personal info and technologies":{"main":[[{"node":"Merge all","type":"main","index":0}]]},"Merge education and employment history":{"main":[[{"node":"Merge other data","type":"main","index":0}]]}}}