{"id":"metaWinnersScale26","meta":{"instanceId":"634103db1d8d34bb0c9bef638db9b8384decbea7550401b2a024f37db42e8f29"},"name":"Find Meta ads worth scaling with Claude AI and size the budget increase","tags":[],"nodes":[{"id":"n1","name":"Run manually","type":"n8n-nodes-base.manualTrigger","position":[-400,0],"parameters":{},"typeVersion":1},{"id":"n2","name":"Set config: winners","type":"n8n-nodes-base.code","position":[-176,0],"parameters":{"jsCode":"// Meta winners to scale - tune here.\nreturn [{ json: {\n  DATE_PRESET: 'last_7d',\n\n  // Which conversion events count as a \"result\" for this account.\n  RESULT_ACTIONS: ['omni_purchase','purchase','offsite_conversion.fb_pixel_purchase','offsite_complete_registration_add_meta_leads','lead','leadgen_grouped','onsite_conversion.lead_grouped','omni_complete_registration','complete_registration'],\n\n  MIN_AD_SPEND: 100,            // an ad must have spent this much to be a credible winner\n  MIN_AD_RESULTS: 3,            // ...and produced at least this many results\n  BEAT_PCT: 20,                 // must beat the account average KPI by this percent\n  FREQ_HEADROOM: 2.0,           // parent ad set below this frequency has room to spend more\n  CAP_UTILISATION_PCT: 85,      // ad set spending this share of its daily budget is capped\n  SUGGESTED_LIFT_PCT: 30,       // how much to raise a capped winner by, per step\n} }];"},"typeVersion":2},{"id":"n3","name":"Fetch account benchmark (Meta)","type":"n8n-nodes-base.httpRequest","position":[48,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/insights","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"level","value":"account"},{"name":"date_preset","value":"={{ $('Set config: winners').first().json.DATE_PRESET }}"},{"name":"fields","value":"spend,impressions,clicks,ctr,actions,purchase_roas"}]}},"typeVersion":4.2},{"id":"n4","name":"Fetch ad insights (Meta)","type":"n8n-nodes-base.httpRequest","position":[272,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/insights","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"level","value":"ad"},{"name":"date_preset","value":"={{ $('Set config: winners').first().json.DATE_PRESET }}"},{"name":"fields","value":"ad_id,ad_name,adset_id,adset_name,campaign_id,campaign_name,spend,impressions,ctr,actions,purchase_roas"},{"name":"limit","value":"500"}]}},"typeVersion":4.2},{"id":"n5","name":"Fetch ad set insights (Meta)","type":"n8n-nodes-base.httpRequest","position":[480,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/insights","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"level","value":"adset"},{"name":"date_preset","value":"={{ $('Set config: winners').first().json.DATE_PRESET }}"},{"name":"fields","value":"adset_id,adset_name,spend,impressions,frequency,ctr"},{"name":"limit","value":"500"}]}},"typeVersion":4.2},{"id":"n6","name":"Fetch ad set entities (Meta)","type":"n8n-nodes-base.httpRequest","position":[704,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/adsets","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"fields","value":"id,name,status,effective_status,daily_budget,lifetime_budget,start_time,stop_time"},{"name":"limit","value":"500"}]}},"typeVersion":4.2},{"id":"n7","name":"Fetch campaign insights (Meta)","type":"n8n-nodes-base.httpRequest","position":[928,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/insights","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"level","value":"campaign"},{"name":"date_preset","value":"={{ $('Set config: winners').first().json.DATE_PRESET }}"},{"name":"fields","value":"campaign_id,campaign_name,spend,impressions,frequency"},{"name":"limit","value":"500"}]}},"typeVersion":4.2},{"id":"n8","name":"Fetch campaign entities (Meta)","type":"n8n-nodes-base.httpRequest","position":[1152,0],"parameters":{"url":"=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v21.0' }}/{{ $env.META_AD_ACCOUNT_ID }}/campaigns","options":{},"sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $env.META_ACCESS_TOKEN }}"},{"name":"fields","value":"id,name,status,effective_status,daily_budget,lifetime_budget,start_time,stop_time"},{"name":"limit","value":"500"}]}},"typeVersion":4.2},{"id":"n9","name":"Rank winners and size the lift","type":"n8n-nodes-base.code","position":[1360,0],"parameters":{"jsCode":"// Rank the winners and size the increase. Pure transforms, no API calls.\nconst cfg = $('Set config: winners').first().json;\nconst rows = (n) => { const r = $(n).first().json; return (r && r.data) ? r.data : []; };\nconst num = (v) => { const n = parseFloat(v); return isNaN(n) ? 0 : n; };\nconst round = (v, d) => (v === null || v === undefined ? null : Math.round(v * Math.pow(10, d)) / Math.pow(10, d));\n\nconst acct = rows('Fetch account benchmark (Meta)')[0] || {};\nconst adRows = rows('Fetch ad insights (Meta)');\nconst adsetRows = rows('Fetch ad set insights (Meta)');\nconst adsetEnts = rows('Fetch ad set entities (Meta)');\nconst campRows = rows('Fetch campaign insights (Meta)');\nconst campEnts = rows('Fetch campaign entities (Meta)');\n\nconst resultsOf = (row) => {\n  const acts = row.actions || [];\n  let total = 0;\n  for (const a of acts) {\n    if (cfg.RESULT_ACTIONS.indexOf(a.action_type) !== -1) total += num(a.value);\n  }\n  return total;\n};\nconst roasOf = (row) => { const r = row.purchase_roas || []; return r.length ? num(r[0].value) : null; };\n\n// --- objective + account benchmark ----------------------------------------\nconst acctRoas = roasOf(acct);\nconst MODE = (acctRoas !== null && acctRoas > 0) ? 'SALES' : 'LEADS';\nconst acctSpend = num(acct.spend);\nconst acctResults = resultsOf(acct);\n\nlet kpiName, acctKpi, higherIsBetter;\nif (MODE === 'SALES') {\n  kpiName = 'ROAS'; acctKpi = acctRoas; higherIsBetter = true;\n} else {\n  kpiName = 'Cost per result'; acctKpi = acctResults > 0 ? acctSpend / acctResults : null; higherIsBetter = false;\n}\n\n// --- budget resolution -----------------------------------------------------\n// Meta returns budgets in the currency's minor unit, so divide by 100.\n// Three shapes exist in the wild and all three have to be handled:\n//   1. daily_budget on the ad set   (ABO)\n//   2. daily_budget on the campaign (CBO / Advantage+)\n//   3. lifetime_budget on either    (very common, and it carries no daily figure)\n// For a lifetime budget the comparable daily cap is the planned pace, the budget\n// spread across the campaign's own schedule. Without start and stop times there\n// is no pace to compare against, so it is reported as no cap rather than guessed.\nconst capOf = (e) => {\n  if (!e) return null;\n  if (e.daily_budget) return { cap: num(e.daily_budget) / 100, type: 'daily', raw: num(e.daily_budget) / 100 };\n  if (e.lifetime_budget && e.start_time && e.stop_time) {\n    const startMs = Date.parse(e.start_time), stopMs = Date.parse(e.stop_time);\n    if (!isNaN(startMs) && !isNaN(stopMs) && stopMs > startMs) {\n      const days = (stopMs - startMs) / 86400000;\n      if (days >= 1) {\n        const lifetime = num(e.lifetime_budget) / 100;\n        return { cap: lifetime / days, type: 'lifetime', raw: lifetime, days: Math.round(days) };\n      }\n    }\n  }\n  return null;\n};\n\nconst entById = {};\nadsetEnts.forEach((e) => { entById[e.id] = { name: e.name, status: e.effective_status, budget: capOf(e) }; });\nconst insByAdset = {};\nadsetRows.forEach((r) => {\n  insByAdset[r.adset_id] = { spend: num(r.spend), frequency: num(r.frequency) };\n});\n\n// Campaign budget optimisation (CBO) and Advantage+ campaigns hold the budget on\n// the CAMPAIGN, so the ad set daily_budget comes back empty. Without this fallback\n// the cap check never fires on those accounts and every winner reads as uncapped.\nconst campById = {};\ncampEnts.forEach((e) => { campById[e.id] = { name: e.name, budget: capOf(e) }; });\nconst insByCamp = {};\ncampRows.forEach((r) => { insByCamp[r.campaign_id] = { spend: num(r.spend) }; });\n\n// --- score every ad --------------------------------------------------------\nconst candidates = [];\nadRows.forEach((r) => {\n  const spend = num(r.spend);\n  const results = resultsOf(r);\n  const roas = roasOf(r);\n  if (spend < cfg.MIN_AD_SPEND) return;\n\n  let kpi;\n  if (MODE === 'SALES') { kpi = roas; }\n  else { kpi = results > 0 ? spend / results : null; }\n  if (kpi === null || acctKpi === null) return;\n  if (MODE === 'LEADS' && results < cfg.MIN_AD_RESULTS) return;\n\n  // Percent better than the account average, direction aware.\n  const betterPct = higherIsBetter\n    ? ((kpi - acctKpi) / acctKpi) * 100\n    : ((acctKpi - kpi) / acctKpi) * 100;\n  if (betterPct < cfg.BEAT_PCT) return;\n\n  const ent = entById[r.adset_id] || {};\n  const ins = insByAdset[r.adset_id] || {};\n\n  // Budget lives on the ad set for ABO, on the campaign for CBO / Advantage+.\n  // Use whichever level actually carries it, and say which one in the output.\n  let budgetLevel = null, budget = null, levelDailySpend = null, budgetOwner = '';\n  if (ent.budget) {\n    budgetLevel = 'ad set';\n    budget = ent.budget;\n    levelDailySpend = ins.spend ? ins.spend / 7 : null;\n    budgetOwner = r.adset_name || ent.name || '';\n  } else {\n    const camp = campById[r.campaign_id] || {};\n    const campIns = insByCamp[r.campaign_id] || {};\n    if (camp.budget) {\n      budgetLevel = 'campaign';\n      budget = camp.budget;\n      levelDailySpend = campIns.spend ? campIns.spend / 7 : null;\n      budgetOwner = r.campaign_name || camp.name || '';\n    }\n  }\n  const dailyCap = budget ? budget.cap : null;\n  const utilisation = (dailyCap && levelDailySpend) ? (levelDailySpend / dailyCap) * 100 : null;\n\n  const isThrottled = utilisation !== null && utilisation >= cfg.CAP_UTILISATION_PCT;\n  const hasHeadroom = ins.frequency !== undefined && ins.frequency > 0 && ins.frequency < cfg.FREQ_HEADROOM;\n\n  let reason, priority;\n  if (isThrottled && hasHeadroom) { reason = 'capped and unfatigued'; priority = 1; }\n  else if (isThrottled) { reason = 'budget capped'; priority = 2; }\n  else if (hasHeadroom) { reason = 'frequency headroom, no cap hit'; priority = 3; }\n  else if (dailyCap) { reason = 'beating average, budget not the constraint'; priority = 4; }\n  else { reason = 'beating average, no budget or schedule found to pace against'; priority = 5; }\n\n  // Size the move only where the budget is actually the constraint. Raising a\n  // budget an ad set is not hitting changes nothing, so those get no number.\n  // Size the step in the unit the user actually edits in Ads Manager: a daily\n  // budget is raised as a daily figure, a lifetime budget as a lifetime figure.\n  let suggestedBudget = null, extraDailySpend = null, extraResultsPerWeek = null, editField = '';\n  if (budget && isThrottled) {\n    const lift = 1 + cfg.SUGGESTED_LIFT_PCT / 100;\n    suggestedBudget = round(budget.raw * lift, 2);\n    extraDailySpend = round(dailyCap * lift - dailyCap, 2);\n    editField = budget.type === 'lifetime'\n      ? 'lifetime budget (' + budget.days + ' day schedule, pacing $' + round(dailyCap, 2) + '/day)'\n      : 'daily budget';\n    if (MODE === 'LEADS' && kpi > 0) extraResultsPerWeek = round((extraDailySpend * 7) / kpi, 1);\n    if (MODE === 'SALES' && kpi > 0) extraResultsPerWeek = round(extraDailySpend * 7 * kpi, 0);\n  }\n\n  candidates.push({\n    ad_name: r.ad_name, ad_id: r.ad_id,\n    adset_name: r.adset_name || ent.name || '', adset_id: r.adset_id,\n    spend: round(spend, 2), results: results,\n    campaign_name: r.campaign_name || '', campaign_id: r.campaign_id,\n    kpi: round(kpi, 2), kpi_name: kpiName,\n    better_than_account_pct: round(betterPct, 1),\n    frequency: round(ins.frequency, 2),\n    daily_budget: round(dailyCap, 2), budget_type: budget ? budget.type : null,\n    current_budget: budget ? budget.raw : null, edit_field: editField,\n    budget_level: budgetLevel, budget_owner: budgetOwner,\n    budget_utilisation_pct: round(utilisation, 1),\n    reason: reason, priority: priority,\n    suggested_daily_budget: suggestedBudget,\n    extra_daily_spend: extraDailySpend,\n    estimated_extra_per_week: extraResultsPerWeek,\n    estimate_unit: MODE === 'SALES' ? 'revenue' : 'results',\n  });\n});\n\ncandidates.sort((a, b) => (a.priority - b.priority) || (b.better_than_account_pct - a.better_than_account_pct));\nconst winners = candidates.slice(0, 10);\n\n// Total upside, counting only the throttled winners. Anything without a cap is\n// excluded on purpose so the headline number is not inflated by moves that\n// would not actually release more spend.\nconst throttled = winners.filter((w) => w.suggested_daily_budget !== null);\nlet totalExtraDaily = 0, totalExtraWeekly = 0;\nthrottled.forEach((w) => {\n  if (w.extra_daily_spend) totalExtraDaily += w.extra_daily_spend;\n  if (w.estimated_extra_per_week) totalExtraWeekly += w.estimated_extra_per_week;\n});\n\nreturn [{ json: {\n  mode: MODE,\n  date_preset: cfg.DATE_PRESET,\n  account: { spend: round(acctSpend, 2), results: acctResults, kpi_name: kpiName, kpi: round(acctKpi, 2) },\n  thresholds: { min_ad_spend: cfg.MIN_AD_SPEND, beat_pct: cfg.BEAT_PCT, freq_headroom: cfg.FREQ_HEADROOM, cap_utilisation_pct: cfg.CAP_UTILISATION_PCT, lift_pct: cfg.SUGGESTED_LIFT_PCT },\n  winner_count: winners.length,\n  throttled_count: throttled.length,\n  winners: winners,\n  upside: { extra_daily_spend: round(totalExtraDaily, 2), estimated_extra_per_week: round(totalExtraWeekly, 1), unit: MODE === 'SALES' ? 'revenue' : 'results' },\n} }];"},"typeVersion":2},{"id":"n10","name":"Build AI scale prompt","type":"n8n-nodes-base.code","position":[1584,0],"parameters":{"jsCode":"// Build the scale-plan prompt. No API call here.\nconst d = $json;\n\nconst system = 'You are a senior Meta media buyer. You are writing the scale plan, not a waste report. Plain, direct, numbers first, no hedging and no filler. Never write an em dash, use a comma or a full stop. HARD RULE: you may only state a budget figure that appears verbatim in the input. If an ad has no supplied budget step, you must not name any dollar amount for it. Return ONLY valid JSON matching the requested shape, no prose outside it.';\n\n// Split by whether a budget move is actually available. The model gets numbers\n// only for the capped group, so it cannot invent a raise for the rest.\nconst scalable = d.winners.filter((w) => w.suggested_daily_budget !== null);\nconst blocked = d.winners.filter((w) => w.suggested_daily_budget === null);\n\nconst fmt = (w) => '- ' + w.ad_name + ' (ad set: ' + w.adset_name + '): ' + w.kpi_name + ' ' + w.kpi +\n  ', ' + w.better_than_account_pct + '% better than account average, spent $' + w.spend +\n  ' for ' + w.results + ' results, frequency ' + w.frequency;\n\nconst scalableLines = scalable.map((w) => fmt(w) +\n  '. Budget sits at ' + w.budget_level + ' level on \"' + w.budget_owner + '\" as a ' + w.budget_type +\n  ' budget, pacing $' + w.daily_budget + '/day at ' + w.budget_utilisation_pct +\n  '% utilisation. APPROVED STEP: raise the ' + w.edit_field + ' from $' + w.current_budget +\n  ' to $' + w.suggested_daily_budget + ', about ' + w.estimated_extra_per_week +\n  ' extra ' + w.estimate_unit + ' per week at current efficiency.').join('\\n');\n\nconst blockedLines = blocked.map((w) => fmt(w) + '. ' + w.reason +\n  '. NO BUDGET MOVE AVAILABLE, do not name a dollar figure for this one.').join('\\n');\n\nconst user = [\n  'Account objective mode: ' + d.mode + '. Account average ' + d.account.kpi_name + ' is ' + d.account.kpi + ' on $' + d.account.spend + ' spend and ' + d.account.results + ' results over ' + d.date_preset + '.',\n  '',\n  scalable.length\n    ? 'SCALABLE, these are hitting their budget cap so more budget releases more delivery:\\n' + scalableLines\n    : 'SCALABLE: none. No winner is hitting its budget cap this week, so there is no budget move to recommend.',\n  '',\n  blocked.length\n    ? 'BEATING AVERAGE BUT NOT BUDGET CONSTRAINED, these need audience or structure work, not money:\\n' + blockedLines\n    : '',\n  '',\n  'Write the scale plan.',\n  scalable.length\n    ? 'Pick the best SCALABLE one to raise first and say why it beats the others, quoting its approved step verbatim. List the remaining scalable ones in order.'\n    : 'There is nothing to raise. Say so plainly in the headline, set scale_first to null, and leave \"then\" empty.',\n  'For the not-budget-constrained group, the move is to widen the audience or duplicate into a fresh ad set. Never attach a dollar figure to them.',\n  '',\n  'Return JSON: {\"headline\":\"one sentence\",\"scale_first\":{\"ad\":\"\",\"move\":\"\",\"why\":\"\"} or null,\"then\":[{\"ad\":\"\",\"move\":\"\"}],\"caution\":\"one sentence on what would make you stop scaling\"}',\n].join('\\n');\n\nconst body = { model: 'claude-haiku-4-5', max_tokens: 1400, system: system, messages: [{ role: 'user', content: user }] };\nreturn [{ json: { body: body, _ctx: d } }];"},"typeVersion":2},{"id":"n11","name":"Write scale plan with Claude AI","type":"n8n-nodes-base.httpRequest","position":[1808,0],"parameters":{"url":"https://api.anthropic.com/v1/messages","method":"POST","options":{},"jsonBody":"={{ $json.body }}","sendBody":true,"sendHeaders":true,"specifyBody":"json","headerParameters":{"parameters":[{"name":"x-api-key","value":"={{ $env.ANTHROPIC_API_KEY }}"},{"name":"anthropic-version","value":"2023-06-01"},{"name":"content-type","value":"application/json"}]}},"typeVersion":4.2},{"id":"n12","name":"Print scale plan","type":"n8n-nodes-base.code","position":[2032,0],"parameters":{"jsCode":"// Assemble the scale plan. Returns the report so it shows in the node output\n// and can be chained into Slack, Gmail, or a Sheets row.\nconst ctx = $('Build AI scale prompt').first().json._ctx;\nlet ai = {};\ntry {\n  const txt = ($json.content && $json.content[0] && $json.content[0].text) || '{}';\n  ai = JSON.parse(txt.replace(/^[^{]*/, '').replace(/[^}]*$/, ''));\n} catch (e) {\n  ai = { headline: '', scale_first: null, then: [], caution: '' };\n}\n\nconst L = [];\nL.push('META WINNERS TO SCALE  (' + ctx.date_preset + ')   [objective: ' + ctx.mode + ']');\nL.push('-----------------------------------------------------------------------');\nL.push('Account average ' + ctx.account.kpi_name + ': ' + ctx.account.kpi + '  on $' + ctx.account.spend + ' spend');\nL.push('Winners found: ' + ctx.winner_count);\nL.push('');\nif (ai.headline) { L.push(ai.headline); L.push(''); }\n\nif (ai.scale_first && ai.scale_first.ad) {\n  L.push('SCALE THIS FIRST');\n  L.push('  ' + ai.scale_first.ad);\n  L.push('  Move: ' + ai.scale_first.move);\n  L.push('  Why: ' + ai.scale_first.why);\n  L.push('');\n}\nif ((ai.then || []).length) {\n  L.push('THEN, IN ORDER');\n  ai.then.forEach((t, i) => L.push('  ' + (i + 2) + '. ' + t.ad + ' -> ' + t.move));\n  L.push('');\n}\n\nL.push('ALL WINNERS');\nif (!ctx.winners.length) {\n  L.push('  None cleared the thresholds. Lower MIN_AD_SPEND or BEAT_PCT in the Config node to widen the net.');\n} else {\n  ctx.winners.forEach((w) => {\n    L.push('  ' + w.ad_name);\n    L.push('    ' + w.kpi_name + ' ' + w.kpi + ' (' + w.better_than_account_pct + '% better)  freq ' + w.frequency + '  spent $' + w.spend + '  ' + w.reason);\n    if (w.suggested_daily_budget) {\n      L.push('    Raise the ' + w.budget_level + ' ' + w.edit_field + ' on \"' + w.budget_owner + '\"');\n      L.push('      $' + w.current_budget + ' -> $' + w.suggested_daily_budget + '   (+' + w.estimated_extra_per_week + ' ' + w.estimate_unit + '/wk at current efficiency)');\n    } else if (w.daily_budget) {\n      L.push('    Pacing at ' + w.budget_utilisation_pct + '% of its ' + w.budget_type + ' budget, so the budget is not the constraint. Widen the audience or duplicate into a fresh ad set.');\n    } else {\n      L.push('    No budget or schedule found to pace against. Check whether this sits under a lifetime budget with no stop date.');\n    }\n  });\n}\nL.push('');\nL.push('TOTAL UPSIDE from the ' + ctx.throttled_count + ' budget-capped winner(s) taking one step:');\nif (ctx.throttled_count) {\n  L.push('  +$' + ctx.upside.extra_daily_spend + '/day  ->  about ' + ctx.upside.estimated_extra_per_week + ' extra ' + ctx.upside.unit + ' per week');\n} else {\n  L.push('  None of the winners are budget capped, so there is no budget move to make this week.');\n}\nif (ai.caution) { L.push(''); L.push('Caution: ' + ai.caution); }\n\nreturn [{ json: { report: L.join('\\n'), mode: ctx.mode, winner_count: ctx.winner_count, winners: ctx.winners, upside: ctx.upside, account: ctx.account, ai: ai } }];"},"typeVersion":2},{"id":"s0","name":"Sticky Note - Overview","type":"n8n-nodes-base.stickyNote","position":[-1424,-320],"parameters":{"width":900,"height":684,"content":"## Meta Winners to Scale\n\nMost ad audits only find waste. This one finds upside: the ads already beating your account average that are being held back, either by a budget cap or by an ad set that still has frequency headroom. It sizes the increase and estimates what the extra spend buys.\n\n### How it works\n- Detects the account objective, so a lead-gen account is judged on cost per result instead of a ROAS it never targeted.\n- Pulls account, ad, and ad set performance plus the ad set budgets from the Meta Marketing API.\n- Keeps only ads that cleared a real spend and result floor, then beat the account average by your threshold.\n- Marks each one capped, unfatigued, or both, sizes the next budget step, and estimates the extra results or revenue per week at current efficiency.\n- Claude writes the order to scale in, and what would make you stop.\n\n### Setup\n1. Add to your environment: META_ACCESS_TOKEN, META_AD_ACCOUNT_ID, META_API_VERSION, ANTHROPIC_API_KEY.\n2. Run with the manual trigger, or attach a Schedule trigger for a weekly review.\n\n### Customization\nConfig node holds the spend floor, the beat-the-average threshold, the frequency headroom line, and the size of each budget step.\n\nBuilt by **nocode.expert** - done-for-you automation & tracking. https://nocode.expert"},"typeVersion":1},{"id":"s1","name":"Sticky Note - Section 1","type":"n8n-nodes-base.stickyNote","position":[-416,176],"parameters":{"color":7,"width":580,"height":460,"content":"### 1. Config\n\nMIN_AD_SPEND and MIN_AD_RESULTS stop a lucky two-conversion ad reading as a winner.\n\nBEAT_PCT is how far past the account average an ad has to be before it counts.\n\nCAP_UTILISATION_PCT is what \"throttled\" means: an ad set spending that share of its daily budget is being held back by the cap, not by the auction."},"typeVersion":1},{"id":"s2","name":"Sticky Note - Section 2","type":"n8n-nodes-base.stickyNote","position":[240,160],"parameters":{"color":7,"width":640,"height":508,"content":"### 2. Pull the account, the ads, and the budgets\n\nThe account call sets the benchmark every ad is measured against. The ad call finds performance. The ad set insight call gives frequency, which is how headroom is detected.\n\nThe ad set entity call is the one most people miss: budgets live on the entity, not on insights. Without it you cannot tell a winner that is capped from a winner that simply is not scaling.\n\nBudget can live at either level. Advantage+ and CBO campaigns hold it on the campaign, so the ad set budget comes back empty. The campaign calls are the fallback, without them every winner on a CBO account reads as uncapped and the template has nothing to recommend.\n\nMeta returns budgets in the currency's minor unit, so the code divides by 100."},"typeVersion":1},{"id":"s3","name":"Sticky Note - Section 3","type":"n8n-nodes-base.stickyNote","position":[1344,176],"parameters":{"color":7,"width":900,"height":492,"content":"### 3. Rank, size, report\n\nWinners are ranked by why they are held back, not just by performance. Capped and unfatigued comes first, because that is the one where more budget converts straight into more results. An ad beating average with no cap detected ranks last, since raising a budget that is not the constraint does nothing.\n\nEach step is sized off your own lift percentage and the estimate uses current efficiency, so it is a projection, not a promise.\n\nClaude only orders and phrases. Every number comes from the ranking node. The final node returns the plan plus the structured winners, so you can chain Slack, Gmail, or a Sheets row after it."},"typeVersion":1},{"id":"e6f9a637-e901-4b7f-b00f-8b0c66f6b1e7","name":"Send a message","type":"n8n-nodes-base.gmail","position":[2320,0],"webhookId":"8e647cee-0dda-4b91-a42c-032a4ecf26e0","parameters":{"message":"={{ $json.report }}","options":{}},"typeVersion":2.2}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"d12d6ca3-77c5-4fe7-9674-1e3d65e9d2da","nodeGroups":[],"connections":{"Run manually":{"main":[[{"node":"Set config: winners","type":"main","index":0}]]},"Print scale plan":{"main":[[{"node":"Send a message","type":"main","index":0}]]},"Set config: winners":{"main":[[{"node":"Fetch account benchmark (Meta)","type":"main","index":0}]]},"Build AI scale prompt":{"main":[[{"node":"Write scale plan with Claude AI","type":"main","index":0}]]},"Fetch ad insights (Meta)":{"main":[[{"node":"Fetch ad set insights (Meta)","type":"main","index":0}]]},"Fetch ad set entities (Meta)":{"main":[[{"node":"Fetch campaign insights (Meta)","type":"main","index":0}]]},"Fetch ad set insights (Meta)":{"main":[[{"node":"Fetch ad set entities (Meta)","type":"main","index":0}]]},"Fetch account benchmark (Meta)":{"main":[[{"node":"Fetch ad insights (Meta)","type":"main","index":0}]]},"Fetch campaign entities (Meta)":{"main":[[{"node":"Rank winners and size the lift","type":"main","index":0}]]},"Fetch campaign insights (Meta)":{"main":[[{"node":"Fetch campaign entities (Meta)","type":"main","index":0}]]},"Rank winners and size the lift":{"main":[[{"node":"Build AI scale prompt","type":"main","index":0}]]},"Write scale plan with Claude AI":{"main":[[{"node":"Print scale plan","type":"main","index":0}]]}}}