{"id":"template-rss-newsletter","meta":{"instanceId":"PLACEHOLDER_INSTANCE_ID"},"name":"RSS-to-Email Newsletter Automation","tags":[],"nodes":[{"id":"9094ef6e-8022-4bb8-934c-6bf237b6e028","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-1216,96],"parameters":{"width":480,"height":816,"content":"## RSS-to-Email Newsletter Automation\n\n### How it works\n\nThis workflow runs every morning to read new posts from an RSS feed and compare them against a Google Sheets log of articles that were already sent. If new articles exist, it loads the subscriber list, prepares recipients, sends newsletter emails for each new article, and records sent articles back to Google Sheets.\n\n### Setup steps\n\n- Configure the schedule trigger for the desired newsletter send time and timezone.\n- Set the RSS feed URL in the RSS Feed Read node.\n- Connect Google Sheets credentials and select the spreadsheets/ranges for the already-sent article log and subscriber list.\n- Configure the email sending credentials, sender address, subject/body template, and recipient mapping.\n- Verify that the sent-article tracking sheet stores a unique article identifier such as URL or GUID so duplicates can be filtered reliably.\n\n### Customization\n\nAdjust the RSS source, send frequency, filtering rules, email template, and subscriber sheet columns to match the newsletter format and audience."},"typeVersion":1},{"id":"66425ff1-9bde-428c-82d7-7401bf62907f","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-656,288],"parameters":{"color":7,"width":640,"height":320,"content":"## Fetch feed and history\n\nStarts the daily workflow, reads the site RSS feed, and retrieves the Google Sheets record of articles that have already been emailed. These nodes form the left-side intake cluster."},"typeVersion":1},{"id":"56e2441a-5538-4bee-ac59-e4ac6211371c","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[32,288],"parameters":{"color":7,"width":416,"height":320,"content":"## Filter new articles\n\nCompares feed items with the sent-article history and checks whether any unsent articles remain before continuing."},"typeVersion":1},{"id":"7aacf2c9-ea41-44a3-9069-d11a7b4ff6d3","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[480,160],"parameters":{"color":7,"width":416,"height":464,"content":"## Prepare subscribers\n\nReads the subscriber list and branches into nearby preparation steps for article iteration and contact aggregation."},"typeVersion":1},{"id":"02803088-1889-4b45-8d73-43010022c1cf","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[928,128],"parameters":{"color":7,"width":240,"height":336,"content":"## Send newsletter email\n\nSends the email for each new article using the prepared article and subscriber data."},"typeVersion":1},{"id":"7774cc43-fc6c-446d-8334-bc8d92eeeac2","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[1200,96],"parameters":{"color":7,"width":240,"height":368,"content":"## Record sent article\n\nUpdates Google Sheets after a successful email send so the article is not included in future newsletter runs."},"typeVersion":1},{"id":"a5c471cd-aa74-4ec7-becc-8b5fcbe8201a","name":"When Every Morning at 9am","type":"n8n-nodes-base.scheduleTrigger","position":[-608,448],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 9 * * *"}]}},"typeVersion":1.1},{"id":"36d4fc73-878d-44aa-86d8-e3580e479485","name":"Fetch Site RSS Feed","type":"n8n-nodes-base.rssFeedRead","position":[-384,448],"parameters":{"url":"https://YOUR-WEBSITE.com/feed/","options":{}},"typeVersion":1},{"id":"316ee9d8-6c5c-48c7-a44d-b7258ee1e877","name":"Read Sent Articles from Sheets","type":"n8n-nodes-base.googleSheets","position":[-160,448],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Sent"},"documentId":{"__rl":true,"mode":"id","value":"YOUR_GOOGLE_SHEET_ID"}},"typeVersion":4},{"id":"e3284e2f-e18c-4857-aeb2-45326c09c669","name":"Merge Articles to Find New","type":"n8n-nodes-base.merge","position":[80,448],"parameters":{"mode":"combine","options":{},"joinMode":"keepNonMatches","mergeByFields":{"values":[{"field1":"link","field2":"article_url"}]},"outputDataFrom":"input1"},"typeVersion":2.1},{"id":"d8520796-5354-4781-9e9d-906a6c04dee0","name":"If New Articles Exist","type":"n8n-nodes-base.if","position":[304,448],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"check-new","operator":{"type":"number","operation":"gt"},"leftValue":"={{ $input.all().length }}","rightValue":0}]}},"typeVersion":2},{"id":"3cf61601-f536-48ec-9693-4f9755d2d7a2","name":"Read Subscribers from Sheets","type":"n8n-nodes-base.googleSheets","position":[528,320],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"Contacts"},"documentId":{"__rl":true,"mode":"id","value":"YOUR_GOOGLE_SHEET_ID"}},"typeVersion":4},{"id":"5e47d352-4b0c-43ee-9f90-e6d2fd70707e","name":"Loop Over New Articles","type":"n8n-nodes-base.splitInBatches","position":[752,320],"parameters":{"options":{}},"typeVersion":3},{"id":"2060a013-2907-4ad1-b54c-26c8862723bc","name":"Compile Contact List","type":"n8n-nodes-base.itemLists","position":[752,464],"parameters":{"operation":"aggregate"},"typeVersion":3.1},{"id":"7e26c1a5-4699-4982-840d-e4903fc79d8c","name":"Send Newsletter Email","type":"n8n-nodes-base.emailSend","position":[976,304],"webhookId":"2d41e309-63dd-4d11-90dd-67c6d75be818","parameters":{"options":{},"subject":"=New article: {{ $node[\"Loop Over New Articles\"].json.title }}","toEmail":"={{ $json.email }}","fromEmail":"YOUR@EMAIL.COM"},"typeVersion":2.1},{"id":"6bdde26e-4daa-4cd9-b2dd-1115f329a88f","name":"Append Sent Articles to Sheets","type":"n8n-nodes-base.googleSheets","position":[1248,304],"parameters":{"columns":{"value":{"title":"={{ $node[\"Loop Over New Articles\"].json.title }}","sent_date":"={{ $now.toISO() }}","article_url":"={{ $node[\"Loop Over New Articles\"].json.link }}"},"mappingMode":"defineBelow"},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Sent"},"documentId":{"__rl":true,"mode":"id","value":"YOUR_GOOGLE_SHEET_ID"}},"typeVersion":4}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"nodeGroups":[],"connections":{"Fetch Site RSS Feed":{"main":[[{"node":"Read Sent Articles from Sheets","type":"main","index":0}]]},"If New Articles Exist":{"main":[[{"node":"Read Subscribers from Sheets","type":"main","index":0}]]},"Send Newsletter Email":{"main":[[{"node":"Append Sent Articles to Sheets","type":"main","index":0}]]},"Loop Over New Articles":{"main":[[{"node":"Send Newsletter Email","type":"main","index":0}]]},"When Every Morning at 9am":{"main":[[{"node":"Fetch Site RSS Feed","type":"main","index":0}]]},"Merge Articles to Find New":{"main":[[{"node":"If New Articles Exist","type":"main","index":0}]]},"Read Subscribers from Sheets":{"main":[[{"node":"Loop Over New Articles","type":"main","index":0},{"node":"Compile Contact List","type":"main","index":0}]]},"Read Sent Articles from Sheets":{"main":[[{"node":"Merge Articles to Find New","type":"main","index":0}]]}}}