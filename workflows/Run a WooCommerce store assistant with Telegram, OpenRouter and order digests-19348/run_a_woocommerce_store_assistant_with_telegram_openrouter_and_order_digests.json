{"id":"3eMyI0wZjN10Y4NT","meta":{"instanceId":"c2650793f644091dc80fb900fe63448ad1f4b774008de9608064d67294f8307c","templateCredsSetupCompleted":true},"name":"woocommerce store assistant with order alerts","tags":[],"nodes":[{"id":"e98ebc7f-8d94-482d-833b-ede12c7e5fcf","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[448,672],"parameters":{"width":480,"height":896,"content":"## woocommerce store assistant with order alerts\n\n### How it works\n\nThis workflow lets a WooCommerce store owner interact with a Telegram-based AI assistant after the chat is verified against a Google Sheets allowlist. Authorized messages are handled by an AI agent with OpenRouter, conversation memory, WooCommerce tools, Gmail, and Google Sheets access; unauthorized users receive a polite refusal. A separate scheduled path fetches recent WooCommerce orders, builds a daily digest, sends it by Telegram and email, logs the run, and alerts an admin when needed.\n\n### Setup steps\n\n- Configure Telegram credentials for the trigger and message-sending nodes, including the owner/admin chat IDs used in replies and alerts.\n- Set up Google Sheets credentials and point the allowlist, orders database, and digest log nodes/tools to the correct spreadsheets and ranges.\n- Add WooCommerce API credentials for both the standard WooCommerce node and the WooCommerce agent tools.\n- Configure the OpenRouter credential/model for the AI agent and review the agent prompt/tool permissions.\n- Configure Gmail or SMTP/email credentials for customer emails and daily digest delivery.\n- Set the daily digest schedule and verify the recipient email addresses and Telegram destinations.\n\n### Customization\n\nYou can adjust the allowlist rules, the AI assistant prompt and available tools, the order lookback window for the digest, and the wording of Telegram/email notifications."},"typeVersion":1},{"id":"ddb76ca9-06d3-4bde-b50e-42a38f3d918f","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[1008,912],"parameters":{"color":7,"width":416,"height":336,"content":"## Owner message intake\n\nReceives incoming Telegram messages from the store owner and normalizes key fields such as chat ID, message text, and first name for later authorization and processing."},"typeVersion":1},{"id":"9945341f-05c2-4730-831f-551b1aa30ca5","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[1456,928],"parameters":{"color":7,"width":640,"height":320,"content":"## Allowlist authorization\n\nLooks up the sender in Google Sheets, collapses the lookup into a reliable access decision, and branches the workflow based on whether the chat is allowed."},"typeVersion":1},{"id":"515ccd7f-06d1-42b7-8005-b79aa82e1c63","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[2144,672],"parameters":{"color":7,"width":944,"height":528,"content":"## AI store assistant\n\nProcesses authorized owner requests with an AI agent backed by OpenRouter and conversation memory. The agent can fetch orders, browse or adjust WooCommerce products, consult the orders database, and send customer email through its connected tools."},"typeVersion":1},{"id":"4aa32205-9853-49e0-b3d8-28437a42f2c4","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[2512,1232],"parameters":{"color":7,"width":784,"height":304,"content":"## Unauthorized chat response\n\nHandles the denied-access branch by sending a polite Telegram refusal and ending that path with a no-op node."},"typeVersion":1},{"id":"32e94311-3045-47ab-9a30-70ac0f733371","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[3328,688],"parameters":{"color":7,"width":416,"height":752,"content":"## Assistant response handling\n\nChecks whether the AI agent produced a usable response, sends successful replies back to the owner in Telegram, and uses the nearby admin alert node for failure or exception notifications shared with the digest flow."},"typeVersion":1},{"id":"6ce1ade5-4ca5-4821-86e3-3bac5a2773e0","name":"Sticky Note6","type":"n8n-nodes-base.stickyNote","position":[1680,1296],"parameters":{"color":7,"width":416,"height":320,"content":"## Digest order fetch\n\nStarts the scheduled daily digest path and retrieves WooCommerce orders to be evaluated for the report."},"typeVersion":1},{"id":"1d213df7-2044-4158-b596-1178154fd6a4","name":"Sticky Note7","type":"n8n-nodes-base.stickyNote","position":[2512,1568],"parameters":{"color":7,"width":784,"height":352,"content":"## Fresh order filtering\n\nFilters the fetched orders to those created in the last 24 hours, builds a single digest payload, and routes the result through a switch for either digest delivery or admin alerting."},"typeVersion":1},{"id":"85bc79ef-b1ff-46d2-a702-6b9dc1175baa","name":"Sticky Note8","type":"n8n-nodes-base.stickyNote","position":[3328,1472],"parameters":{"color":7,"width":640,"height":304,"content":"## Digest delivery logging\n\nSends the daily order digest through Telegram and email, then records the completed digest run in Google Sheets."},"typeVersion":1},{"id":"5f1d14a1-8253-4fc5-8e27-17778f57e48c","name":"Telegram Message Trigger","type":"n8n-nodes-base.telegramTrigger","position":[1056,1088],"webhookId":"00160886-7ed5-4b1b-bdf0-63a8c28284e6","parameters":{"updates":["message"],"additionalFields":{}},"credentials":{"telegramApi":{"id":"wlH3um2hoPAGI8XX","name":"DEMO Khaisa Studio Bot"}},"typeVersion":1.2},{"id":"4a87d41d-86db-4da8-bfe2-43b574a3fede","name":"Set Message Fields","type":"n8n-nodes-base.set","position":[1280,1088],"parameters":{"options":{},"assignments":{"assignments":[{"id":"c9509c62-6241-43b7-a7dc-172f7fad0138","name":"chatId","type":"string","value":"={{ $json.message.chat.id }}"},{"id":"c6a6c364-2d7a-4138-8ac1-3a69b8cb8de0","name":"text","type":"string","value":"={{ $json.message.text }}"},{"id":"df3f7bf6-8774-4100-b4f7-ebedfe6c0d4e","name":"firstName","type":"string","value":"={{ $json.message.from.first_name }}"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"bb810fca-5d16-4870-8c55-79c08d535e01","name":"Read Allowlist from Sheets","type":"n8n-nodes-base.googleSheets","position":[1504,1088],"parameters":{"options":{},"filtersUI":{"values":[{"lookupValue":"={{ $json.chatId }}","lookupColumn":"chat_id"}]},"sheetName":{"mode":"list","value":"Allowed Users"},"documentId":{"mode":"url","value":"={{ $env.WOOCOMMERCE_SHEET_URL }}"}},"typeVersion":4.6},{"id":"96729336-512b-4557-9ffe-546eb56a66b1","name":"Evaluate Access Decision","type":"n8n-nodes-base.code","position":[1728,1088],"parameters":{"jsCode":"// Collapse the allowlist lookup into one decision item so unknown chats still get a reply.\nconst incoming = $('Set Message Fields').first().json;\nconst matched = $input.all();\nreturn [{\n  json: {\n    chatId: incoming.chatId,\n    text: incoming.text || '',\n    firstName: incoming.firstName || 'Owner',\n    allowed: matched.length > 0,\n  },\n}];"},"typeVersion":2},{"id":"83081ffa-d1ab-458f-8d16-d929d44d1c02","name":"If Allowed Chat","type":"n8n-nodes-base.if","position":[1952,1088],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"a926f7ae-010a-4f25-8be2-878f602ee67f","operator":{"type":"boolean","operation":"true"},"leftValue":"={{ $json.allowed }}","rightValue":true}]}},"typeVersion":2.3},{"id":"7743dcec-db1b-4f48-b3d9-5a207adc8fce","name":"Send Refusal Message","type":"n8n-nodes-base.telegram","position":[2560,1360],"webhookId":"0c0ed28b-c892-4a3d-805a-919dd8c0a4eb","parameters":{"text":"Sorry, this store assistant only serves approved chats. Ask the store owner to add your chat id to the Allowed Users sheet.","chatId":"={{ $json.chatId }}","additionalFields":{"appendAttribution":false}},"credentials":{"telegramApi":{"id":"wlH3um2hoPAGI8XX","name":"DEMO Khaisa Studio Bot"}},"typeVersion":1.2},{"id":"e541c329-6601-48fa-a17a-4e452ed7d348","name":"No Operation","type":"n8n-nodes-base.noOp","position":[3152,1360],"parameters":{},"typeVersion":1},{"id":"57eff82a-52ca-4dbc-b912-d2a30d9a7a00","name":"Store Assistant Agent","type":"@n8n/n8n-nodes-langchain.agent","position":[2496,832],"parameters":{"text":"={{ $json.text }}","options":{"systemMessage":"=You are the digital store manager for a WooCommerce shop that sells ebooks.\nYou run inside an n8n automation and can inspect orders, search and adjust products,\nkeep an order archive in Google Sheets, and send customer emails through Gmail.\n\nRules:\n- Answer in the same language the store owner uses (English, Arabic, or French).\n- Keep chat replies short and friendly. Use bullet points for lists.\n- When asked for a report, summarize counts and totals instead of dumping raw data.\n- Confirm before changing prices or stock, then state what changed.\n- Current date and time: {{ $now }}."},"promptType":"define"},"typeVersion":3.1},{"id":"ebca7518-3615-4119-bb36-c857a8b78803","name":"AI Chat Router","type":"@n8n/n8n-nodes-langchain.lmChatOpenRouter","position":[2192,1072],"parameters":{"model":{"__rl":true,"mode":"list","value":"deepseek/deepseek-chat"},"options":{}},"credentials":{"openRouterApi":{"id":"DPrHlBN0s5WFDxi9","name":"Adam - Highlane"}},"typeVersion":1},{"id":"a44e50dd-30b1-4635-9686-647129c7f9c0","name":"Store Conversation Memory","type":"@n8n/n8n-nodes-langchain.memoryBufferWindow","position":[2320,1072],"parameters":{"sessionIdType":"customKey","contextWindowLength":20},"typeVersion":1.3},{"id":"70dba48c-bda8-4a1d-9fd7-3df55e90d3be","name":"Retrieve Orders","type":"n8n-nodes-base.wooCommerceTool","position":[2448,1072],"parameters":{"options":{},"resource":"order","operation":"getAll","returnAll":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Return_All', ``, 'boolean') }}"},"typeVersion":1},{"id":"840fd037-94ca-4da8-8ba2-cffa8a7d8844","name":"Search Products","type":"n8n-nodes-base.wooCommerceTool","position":[2576,1072],"parameters":{"options":{},"operation":"getAll","returnAll":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Return_All', ``, 'boolean') }}"},"typeVersion":1},{"id":"f3d48c18-9de0-4f52-96e5-ba0ac439bc35","name":"Update Product Info","type":"n8n-nodes-base.wooCommerceTool","position":[2704,1072],"parameters":{"imagesUi":{},"resource":"product","operation":"update","productId":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Product_ID', ``, 'string') }}","metadataUi":{},"dimensionsUi":{},"updateFields":{"name":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Name', ``, 'string') }}","salePrice":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Sale_Price', ``, 'string') }}","description":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Description', ``, 'string') }}","manageStock":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Manage_Stock', ``, 'boolean') }}","regularPrice":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Regular_Price', ``, 'string') }}","stockQuantity":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Stock_Quantity', ``, 'number') }}","shortDescription":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Short_Description', ``, 'string') }}"},"descriptionType":"auto"},"typeVersion":1},{"id":"ee5bdfe3-784d-4378-b80f-aa93a56ea5a0","name":"Order Database Sync","type":"n8n-nodes-base.googleSheetsTool","position":[2960,1072],"parameters":{"columns":{"value":{"Status":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Status', ``, 'string') }}","Country":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Country', ``, 'string') }}","Order ID":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Order_ID__using_to_match_', ``, 'string') }}","Quantity":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Quantity', ``, 'string') }}","Date Paid":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Date_Paid', ``, 'string') }}","Last Name":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Last_Name', ``, 'string') }}","First Name":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('First_Name', ``, 'string') }}","Items Name":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Items_Name', ``, 'string') }}","Order Date":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Order_Date', ``, 'string') }}","Customer Note":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Customer_Note', ``, 'string') }}","Customer Email":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Customer_Email', ``, 'string') }}","Payment Method":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Payment_Method', ``, 'string') }}"},"schema":[{"id":"Order ID","type":"string","display":true,"removed":false,"required":false,"displayName":"Order ID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Items Name","type":"string","display":true,"required":false,"displayName":"Items Name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Quantity","type":"string","display":true,"required":false,"displayName":"Quantity","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Order Date","type":"string","display":true,"required":false,"displayName":"Order Date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Customer Email","type":"string","display":true,"required":false,"displayName":"Customer Email","defaultMatch":false,"canBeUsedToMatch":true},{"id":"First Name","type":"string","display":true,"required":false,"displayName":"First Name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Last Name","type":"string","display":true,"required":false,"displayName":"Last Name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Country","type":"string","display":true,"required":false,"displayName":"Country","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Payment Method","type":"string","display":true,"required":false,"displayName":"Payment Method","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Customer Note","type":"string","display":true,"required":false,"displayName":"Customer Note","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Date Paid","type":"string","display":true,"required":false,"displayName":"Date Paid","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Status","type":"string","display":true,"required":false,"displayName":"Status","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["Order ID"],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{},"operation":"appendOrUpdate","sheetName":{"__rl":true,"mode":"list","value":"gid=0","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1_zPBSN4sD4Tz-jlaY-B2yMI83_6AzRx-NCHrSHrgV5I/edit#gid=0","cachedResultName":"Sheet1"},"documentId":{"__rl":true,"mode":"list","value":"1_zPBSN4sD4Tz-jlaY-B2yMI83_6AzRx-NCHrSHrgV5I","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1_zPBSN4sD4Tz-jlaY-B2yMI83_6AzRx-NCHrSHrgV5I/edit?usp=drivesdk","cachedResultName":"woocoomerce database"}},"typeVersion":4.7},{"id":"87b68672-dc53-4b0c-88a0-5e2ad32bd84a","name":"Dispatch Customer Email","type":"n8n-nodes-base.gmailTool","position":[2832,1072],"webhookId":"3d710e6b-e312-47ca-a69a-22eceffe47cb","parameters":{"sendTo":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('To', ``, 'string') }}","message":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Message', ``, 'string') }}","options":{"senderName":"Store Assistant","appendAttribution":false},"subject":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Subject', ``, 'string') }}"},"typeVersion":2.2},{"id":"2800f8bf-2af1-4e59-b3a8-41c966724949","name":"If Agent Response","type":"n8n-nodes-base.if","position":[3376,944],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"67a838a9-64ae-4863-b6ea-7bb50b97fbf1","operator":{"type":"string","operation":"notEmpty"},"leftValue":"={{ $json.output }}","rightValue":""}]}},"typeVersion":2.3},{"id":"9b6c97c0-073e-4aea-bdc7-614fa2b04af8","name":"Send Bot Reply to Owner","type":"n8n-nodes-base.telegram","position":[3600,1280],"webhookId":"b23cf012-916a-4638-89a5-ee95c543dccb","parameters":{"text":"={{ $json.output }}","chatId":"={{ $('Set Message Fields').first().json.chatId }}","additionalFields":{"appendAttribution":false}},"credentials":{"telegramApi":{"id":"wlH3um2hoPAGI8XX","name":"DEMO Khaisa Studio Bot"}},"typeVersion":1.2},{"id":"86a92cee-1fc8-48a3-b85b-4b68f84542ed","name":"Trigger Daily Digest","type":"n8n-nodes-base.scheduleTrigger","position":[1728,1456],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 9 * * *"}]}},"typeVersion":1.3},{"id":"176451a9-92bc-4b38-953c-df534f0a7d44","name":"Filter Recent Orders","type":"n8n-nodes-base.code","position":[2560,1728],"parameters":{"jsCode":"// Keep orders created in the last 24 hours and build one digest payload per run.\nconst cutoff = Date.now() - 24 * 60 * 60 * 1000;\nlet orders;\ntry {\n  orders = $input.all();\n} catch (error) {\n  return [{ json: { orderCount: 0, totalRevenue: 0, digestText: '', status: 'failed' } }];\n}\nconst fresh = orders.filter((item) => {\n  const created = new Date(item.json.date_created).getTime();\n  return !isNaN(created) && created >= cutoff;\n});\nconst revenue = fresh.reduce((sum, item) => sum + Number(item.json.total || 0), 0);\nconst details = fresh.slice(0, 5).map((item) => {\n  const billing = item.json.billing || {};\n  const who = (billing.first_name || '') + ' ' + (billing.last_name || '');\n  return '- Order #' + item.json.number + ' ' + (who.trim() || 'Customer') + ' $' + item.json.total;\n}).join('\\n');\nconst digestText = [\n  'Daily WooCommerce digest',\n  'Date: ' + new Date().toISOString().slice(0, 10),\n  'New orders: ' + fresh.length,\n  'Total value: $' + revenue.toFixed(2),\n  '',\n  'Latest orders:',\n  details || '- none',\n].join('\\n');\nreturn [{\n  json: {\n    orderCount: fresh.length,\n    totalRevenue: revenue.toFixed(2),\n    digestText: digestText,\n    status: fresh.length > 0 ? 'ok' : 'no_new_orders',\n    runDate: new Date().toISOString().slice(0, 19).replace('T', ' '),\n  },\n}];"},"typeVersion":2},{"id":"7ef2d613-ad53-4542-ba3a-562b85305c14","name":"Route by Digest Available","type":"n8n-nodes-base.switch","position":[3152,1728],"parameters":{"rules":{"values":[{"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"f61b1a00-6969-4ae4-8b5b-4aad8dd498e3","operator":{"type":"number","operation":"gte"},"leftValue":"={{ $json.orderCount }}","rightValue":1}]}},{"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"d5c45694-7e93-4780-bfd3-fe9ad397c513","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.status }}","rightValue":"failed"}]}}]},"options":{}},"typeVersion":3.2},{"id":"4a6a2cba-faf9-4c07-b276-9caf5593dd05","name":"Send Order Digest Message","type":"n8n-nodes-base.telegram","position":[3376,1600],"webhookId":"c1c6ad27-51b5-41ec-bd8f-16bfaf353c5b","parameters":{"text":"={{ $json.digestText }}","chatId":"={{ $env.ADMIN_TELEGRAM_CHAT_ID }}","additionalFields":{"appendAttribution":false}},"credentials":{"telegramApi":{"id":"wlH3um2hoPAGI8XX","name":"DEMO Khaisa Studio Bot"}},"typeVersion":1.2},{"id":"502532fc-1654-4889-8177-f7ce9fe58ce9","name":"Email Daily Digest","type":"n8n-nodes-base.emailSend","position":[3600,1600],"webhookId":"7eaeebda-cca8-42ab-b5d2-71393c26755d","parameters":{"options":{},"subject":"Daily WooCommerce order digest","toEmail":"={{ $env.ADMIN_EMAIL }}","fromEmail":"={{ $env.ADMIN_EMAIL }}"},"credentials":{"smtp":{"id":"NEFoBvnt1qqSHmdQ","name":"SMTP account"}},"typeVersion":2.1},{"id":"182d0fa6-608d-480d-bea6-6f99e44c091a","name":"Log Digest Activity","type":"n8n-nodes-base.googleSheets","position":[3824,1600],"parameters":{"columns":{"value":{"status":"={{ $json.status }}","revenue":"={{ $json.totalRevenue }}","run_date":"={{ $json.runDate }}","order_count":"={{ $json.orderCount }}"},"schema":[{"id":"run_date","type":"string","display":true,"removed":false,"required":false,"displayName":"run_date","defaultMatch":true,"canBeUsedToMatch":true},{"id":"order_count","type":"string","display":true,"removed":false,"required":false,"displayName":"order_count","defaultMatch":true,"canBeUsedToMatch":true},{"id":"revenue","type":"string","display":true,"removed":false,"required":false,"displayName":"revenue","defaultMatch":true,"canBeUsedToMatch":true},{"id":"status","type":"string","display":true,"removed":false,"required":false,"displayName":"status","defaultMatch":true,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["run_date"]},"options":{},"operation":"append","sheetName":{"mode":"list","value":"Digest Log"},"documentId":{"mode":"url","value":"={{ $env.WOOCOMMERCE_SHEET_URL }}"}},"typeVersion":4.6},{"id":"5cb4afd0-4b77-4f21-8c6d-2567c33a7dee","name":"Notify Admin Alert","type":"n8n-nodes-base.telegram","position":[3600,896],"webhookId":"eb87583d-3d38-4158-b5a9-f30b791cbc9a","parameters":{"text":"A store automation step failed. Open n8n and inspect the latest execution.","chatId":"={{ $env.ADMIN_TELEGRAM_CHAT_ID }}","additionalFields":{"appendAttribution":false}},"credentials":{"telegramApi":{"id":"wlH3um2hoPAGI8XX","name":"DEMO Khaisa Studio Bot"}},"typeVersion":1.2},{"id":"465eb43d-0c1d-4d2a-a495-f52a58182a49","name":"Fetch Latest Orders","type":"n8n-nodes-base.wooCommerce","position":[1952,1456],"parameters":{"resource":"order","operation":"get"},"typeVersion":1}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"221c918a-1844-4c40-960f-5c025dddce35","nodeGroups":[],"connections":{"AI Chat Router":{"ai_languageModel":[[{"node":"Store Assistant Agent","type":"ai_languageModel","index":0}]]},"If Allowed Chat":{"main":[[{"node":"Store Assistant Agent","type":"main","index":0}],[{"node":"Send Refusal Message","type":"main","index":0}]]},"Retrieve Orders":{"ai_tool":[[{"n