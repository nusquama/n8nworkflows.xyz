{"id":"yZdthL8yGgAYtk1g","meta":{"instanceId":"b80b2a014322fd5c63e21d62c556fb49c8c73565823e33903f692b121e4d8c6d","templateCredsSetupCompleted":true},"name":"Real-Time Parse-and-Respond","tags":[],"nodes":[{"id":"b5ea4268-529a-4f27-8175-651b6c56f50a","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-2688,448],"parameters":{"width":592,"height":688,"content":"## Real-Time Parse-and-Respond\n\n### How it works\n\nThis workflow receives a document through a webhook, uploads it to Parseur, then polls Parseur until parsing completes or the retry limit is reached. It returns a real-time webhook response with the parsed result, an upload/API error, or a timeout error if parsing does not finish in time.\n\n### Setup steps\n\n- Configure the webhook trigger URL and ensure incoming requests include the document payload expected by the Parseur upload node.\n- Connect valid Parseur credentials and select the correct mailbox/template settings for document upload and status checks.\n- Verify the HTTP status-check request uses the correct Parseur document endpoint and authentication headers/API token.\n- Review the wait durations, retry counter field, and maximum retry condition so the workflow fits the expected Parseur processing time.\n\n### Customization\n\nAdjust the initial wait, retry delay, and maximum retry count to balance response speed against Parseur processing latency. Customize the success, timeout, upload-error, and API-error webhook responses to match the calling application's expected schema."},"typeVersion":1},{"id":"b0b12e3a-95ac-48fb-8769-9dc52ec4cecd","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-1936,528],"parameters":{"color":7,"width":640,"height":496,"content":"## Receive and upload document\n\nHandles the incoming webhook request, uploads the received document to Parseur, and returns an immediate upload error response if the upload fails."},"typeVersion":1},{"id":"a28c7e26-7789-4726-93b0-ab22f7c4cf82","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[-1264,528],"parameters":{"color":7,"width":448,"height":384,"content":"## Prepare first status check\n\nWaits briefly after a successful upload and initializes the retry counter before polling Parseur for the first time."},"typeVersion":1},{"id":"61cf5fa6-41ab-4b20-91c2-e35090717293","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[-784,480],"parameters":{"color":7,"width":768,"height":560,"content":"## Poll and route status\n\nChecks the Parseur document status, routes successful parsing to the success response, and sends a dedicated response if the status API call fails."},"typeVersion":1},{"id":"41e9e9d6-384a-41fa-a740-32dc219fa910","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[-592,-112],"parameters":{"color":7,"width":592,"height":560,"content":"## Retry or timeout decision\n\nVerifies whether polling should continue, waits before the next retry when appropriate, or returns a timeout response when parsing has not completed within the allowed attempts."},"typeVersion":1},{"id":"796b2b86-3f04-4e11-8b37-7819d3e44945","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[16,608],"parameters":{"color":7,"width":368,"height":368,"content":"## Increment retry counter\n\nUpdates the retry count in an isolated loopback step before sending execution back to the Parseur status check."},"typeVersion":1},{"id":"483083b1-a9bc-479e-9034-128248390e2a","name":"Respond with API Error","type":"n8n-nodes-base.respondToWebhook","position":[-496,816],"parameters":{"options":{"responseCode":503},"respondWith":"json","responseBody":"{\n     \"error\": true,\n     \"message\": \"Unable to reach parsing service. Please try again in a few moments.\"\n   }"},"typeVersion":1.5},{"id":"41ab9a82-5bcc-4dc1-93cd-36ae159b6fc2","name":"Fetch Parsing Status","type":"n8n-nodes-base.httpRequest","onError":"continueErrorOutput","position":[-704,736],"parameters":{"url":"= https://api.parseur.com/document/{{ $('Upload to Parseur').item.json.response.attachments[0].DocumentID }}","options":{},"authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"typeVersion":4.4},{"id":"5f213d70-f78f-481b-9f06-e777638e98b1","name":"Respond with Upload Error","type":"n8n-nodes-base.respondToWebhook","position":[-1440,864],"parameters":{"options":{"responseCode":400},"respondWith":"json","responseBody":"{\n     \"error\": true,\n     \"message\": \"Could not process the uploaded file. Please check the file format and try again.\"\n   }"},"typeVersion":1.5},{"id":"adbff8cc-d9bb-45f9-8b68-0bb4ecc4c160","name":"When Document Requested","type":"n8n-nodes-base.webhook","position":[-1888,688],"webhookId":"68826384-337c-4a98-87f4-20e9304336a4","parameters":{"path":"parse-document","options":{"binaryPropertyName":"data"},"httpMethod":"POST","responseMode":"responseNode","authentication":"headerAuth"},"typeVersion":2.1},{"id":"3a62208d-1d72-4f75-a4a8-ddbaf3f5b5f7","name":"Prepare Retry Counter","type":"n8n-nodes-base.set","position":[-944,736],"parameters":{"options":{},"assignments":{"assignments":[{"id":"cca3daa4-6a75-4899-a83e-f3093a3d9093","name":"retryCount","type":"number","value":0},{"id":"d7378e4f-4aa2-4f32-93d3-dea28b28f234","name":"","type":"string","value":""}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"7676b8fa-0140-4a8d-b59a-70027b72397c","name":"Respond with Timeout Error","type":"n8n-nodes-base.respondToWebhook","position":[-224,288],"parameters":{"options":{"responseCode":408},"respondWith":"json","responseBody":"{\n  \"error\": true,\n  \"message\": \"Document parsing timed out after multiple attempts. Please check the file and try again.\"\n}"},"typeVersion":1.5},{"id":"b8d08ebf-1a40-499b-a9d3-deb0b4c853ed","name":"Respond with Success","type":"n8n-nodes-base.respondToWebhook","position":[-240,624],"parameters":{"options":{},"respondWith":"json","responseBody":"={{ JSON.parse($json.result) }}"},"typeVersion":1.5},{"id":"8a3e0f56-bb13-4b06-af9a-af06ffe64c39","name":"Upload to Parseur","type":"n8n-nodes-parseur.parseur","onError":"continueErrorOutput","position":[-1664,688],"parameters":{"parserId":202635},"credentials":{},"typeVersion":1},{"id":"f080185d-10b6-41dd-9ed3-170690d86c7a","name":"Wait 2 Seconds","type":"n8n-nodes-base.wait","position":[-1184,736],"webhookId":"d9fdf248-3188-4e54-82da-3643faa20d48","parameters":{"amount":2},"typeVersion":1.1},{"id":"f5c97c87-866e-430f-b7d7-995be0aa2789","name":"Check Parsing Complete","type":"n8n-nodes-base.if","position":[-512,608],"parameters":{"options":{},"conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"a9f89757-4916-4117-ac98-0eacfcface0a","operator":{"type":"string","operation":"notEquals"},"leftValue":"={{ $json.status }}","rightValue":"PARSEDOK"},{"id":"ac4655dc-8882-45de-b2e5-590897586354","operator":{"type":"number","operation":"lt"},"leftValue":"={{ $('Prepare Retry Counter').first().json.retryCount }}","rightValue":10}]},"looseTypeValidation":true},"typeVersion":2.3},{"id":"fbd07efe-8a00-448d-823d-62e2039016d3","name":"Wait for Retry","type":"n8n-nodes-base.wait","position":[-208,64],"webhookId":"b8a45c47-f750-4957-9750-6875840ae43b","parameters":{},"typeVersion":1.1},{"id":"10f6347e-82aa-4bd2-a126-3aec6c0dc5be","name":"Increment Retry Counter","type":"n8n-nodes-base.set","position":[160,816],"parameters":{"options":{},"assignments":{"assignments":[{"id":"1b8cf0ac-1444-4b99-a2e3-7f56f1db6a8d","name":"retryCount","type":"number","value":"=={{ $('Prepare Retry Counter').first().json.retryCount + 1 }}"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"26c30d82-3396-4412-b9bd-d7f398b4c947","name":"Check Parsing Success","type":"n8n-nodes-base.if","position":[-480,80],"parameters":{"options":{},"conditions":{"options":{"version":3,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"6747536d-d076-46e3-897c-fdb6c90244ce","operator":{"name":"filter.operator.equals","type":"string","operation":"equals"},"leftValue":"={{ $json.status }}","rightValue":"PARSEDOK"}]}},"typeVersion":2.3}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"6c4e7e7f-1337-45a1-9771-b7a1d453cc11","nodeGroups":[],"connections":{"Wait 2 Seconds":{"main":[[{"node":"Prepare Retry Counter","type":"main","index":0}]]},"Wait for Retry":{"main":[[{"node":"Increment Retry Counter","type":"main","index":0}]]},"Upload to Parseur":{"main":[[{"node":"Wait 2 Seconds","type":"main","index":0}],[{"node":"Respond with Upload Error","type":"main","index":0}]]},"Fetch Parsing Status":{"main":[[{"node":"Check Parsing Complete","type":"main","index":0}],[{"node":"Respond with API Error","type":"main","index":0}]]},"Check Parsing Success":{"main":[[{"node":"Wait for Retry","type":"main","index":0}],[{"node":"Respond with Timeout Error","type":"main","index":0}]]},"Prepare Retry Counter":{"main":[[{"node":"Fetch Parsing Status","type":"main","index":0}]]},"Check Parsing Complete":{"main":[[{"node":"Check Parsing Success","type":"main","index":0}],[{"node":"Respond with Success","type":"main","index":0}]]},"Increment Retry Counter":{"main":[[{"node":"Fetch Parsing Status","type":"main","index":0}]]},"When Document Requested":{"main":[[{"node":"Upload to Parseur","type":"main","index":0}]]}}}