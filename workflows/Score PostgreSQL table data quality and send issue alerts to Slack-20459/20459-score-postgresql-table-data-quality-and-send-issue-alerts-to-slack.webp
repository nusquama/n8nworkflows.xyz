{"id":"a7ldLty8xYKwUCqw","meta":{"instanceId":"dd69efaf8212c74ad206700d104739d3329588a6f3f8381a46a481f34c9cc281","templateCredsSetupCompleted":true},"name":"Data Quality Engine - Missing, Duplicate and Anomalous Records","tags":[],"nodes":[{"id":"8979aec8-8fed-401f-9a42-6bda20cec24b","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-1680,-1904],"parameters":{"width":680,"height":1100,"content":"## Data Quality Engine: Missing, Duplicate and Anomalous Records\n\n### How it works\n\nScans any PostgreSQL table on a schedule (or on demand) and scores its quality.\n\n1. **Missing:** required columns that are NULL or blank.\n2. **Duplicates:** records that share the same business key, compared after trimming, lower-casing and collapsing spaces (so `USER5@x.com ` matches `user5@x.com`).\n3. **Anomalies:** numeric outliers found with a robust z-score (median and MAD, so the outliers themselves do not distort the baseline). Above 2x the threshold is critical.\n4. **Table health:** freshness (is new data arriving?) and volume (is today's load far from the recent average?).\n\nEach run gets a 0-100 score from four dimensions (completeness, uniqueness, validity, timeliness), stored in `dq_runs`. Individual problems go to `dq_issues`, only once while they stay open, and are resolved automatically when fixed. Slack is notified only when something needs attention.\n\n### Setup steps\n\n- Add Postgres credentials to all Postgres nodes and run the manual setup once.\n- Edit **Set DQ Config**: table, primary key, timestamp column, required, duplicate-key and numeric columns, thresholds, Slack webhook. The defaults check the demo table.\n- Set `scopeHours` to e.g. 24 to check only recent rows (0 = whole table, which also enables auto-resolve).\n- Activate the workflow. Trigger it any time with `POST /dq-run`.\n\n### Layout\n\n1 Setup\n2 Triggers and configuration\n3 Checks\n4-5 Score, persist and alert"},"typeVersion":1},{"id":"c5d7a9d4-74b3-4d75-bd4c-3331f3c96241","name":"Note: 1. One-time setup","type":"n8n-nodes-base.stickyNote","position":[-912,-1904],"parameters":{"color":6,"width":500,"height":536,"content":"## 1. One-time setup\n\nRun manually once. Creates the run history and issue tables, plus a small demo table (dq_demo_orders) with a missing value, a duplicate and an outlier so you can see the engine work immediately."},"typeVersion":1},{"id":"65d156c7-c8e6-4626-ad70-7cc2db1c797e","name":"Note: 2. Triggers & configuration","type":"n8n-nodes-base.stickyNote","position":[-912,-1200],"parameters":{"color":4,"width":1040,"height":952,"content":"## 2. Triggers & configuration\n\nRuns every hour or on demand via `POST /dq-run`. Settings define the table, key columns, required columns, numeric columns and thresholds. The config is validated before any SQL is built."},"typeVersion":1},{"id":"d5d665f9-b764-4bf2-a618-8a1777205c73","name":"Note: 3. Detect missing, duplicate & anomalous records","type":"n8n-nodes-base.stickyNote","position":[176,-1200],"parameters":{"color":5,"width":1040,"height":872,"content":"## 3. Detect missing, duplicate & anomalous records\n\nFour SQL checks: missing (NULL or blank required columns), duplicates (normalized business key), anomalies (robust z-score on numeric columns) and table health (row counts, freshness, volume)."},"typeVersion":1},{"id":"90bc83ea-d511-4007-9f6b-c3618fc26773","name":"Note: 4. Score, persist & resolve","type":"n8n-nodes-base.stickyNote","position":[1264,-1200],"parameters":{"color":3,"width":770,"height":872,"content":"## 4. Score, persist & resolve\n\nAdds freshness and volume issues, scores four dimensions (completeness, uniqueness, validity, timeliness) and saves the run. Only new issues are inserted, and issues that disappeared are resolved automatically."},"typeVersion":1},{"id":"6cc99d1e-92ab-4371-a839-d279ab09928e","name":"Note: 5. Report & alert","type":"n8n-nodes-base.stickyNote","position":[2064,-1200],"parameters":{"color":6,"width":770,"height":904,"content":"## 5. Report & alert\n\nBuilds the quality report and sends a Slack alert on failures, critical issues or new warnings. Clean runs stay quiet."},"typeVersion":1},{"id":"d809e42a-81ce-475e-85c9-d34997e8f32b","name":"Manual Trigger - Run Setup Once","type":"n8n-nodes-base.manualTrigger","position":[-880,-1568],"parameters":{},"typeVersion":1},{"id":"f3f611ef-b29d-4010-9943-86d0994d5a37","name":"Postgres - Create DQ Tables","type":"n8n-nodes-base.postgres","position":[-608,-1568],"parameters":{"query":"CREATE TABLE IF NOT EXISTS dq_runs (\n  id               BIGSERIAL PRIMARY KEY,\n  table_name       TEXT        NOT NULL,\n  run_at           TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n  total_rows       INT,\n  scoped_rows      INT,\n  score            NUMERIC(5,1),\n  status           TEXT,\n  dimension_scores JSONB\n);\nCREATE TABLE IF NOT EXISTS dq_issues (\n  id          BIGSERIAL PRIMARY KEY,\n  run_id      BIGINT,\n  table_name  TEXT NOT NULL,\n  check_type  TEXT NOT NULL,\n  severity    TEXT NOT NULL,\n  record_key  TEXT,\n  column_name TEXT,\n  detail      TEXT,\n  status      TEXT NOT NULL DEFAULT 'open',\n  detected_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n  resolved_at TIMESTAMPTZ\n);\nCREATE INDEX IF NOT EXISTS idx_dq_issues_open ON dq_issues (table_name, status, check_type);\nCREATE INDEX IF NOT EXISTS idx_dq_runs_table ON dq_runs (table_name, id DESC);\n\n-- Optional demo table with built-in problems (a missing email, a duplicate email and an outlier amount)\nCREATE TABLE IF NOT EXISTS dq_demo_orders (\n  id             INT PRIMARY KEY,\n  customer_email TEXT,\n  amount         NUMERIC,\n  created_at     TIMESTAMPTZ\n);\nINSERT INTO dq_demo_orders (id, customer_email, amount, created_at)\nSELECT * FROM (\n  SELECT g, 'user' || g || '@example.com', 50 + (g % 20) * 5, NOW() - (g || ' hours')::interval FROM generate_series(1, 60) g\n  UNION ALL SELECT 1001, NULL, 80, NOW()\n  UNION ALL SELECT 1002, 'user@example.com ', 75, NOW()\n  UNION ALL SELECT 1003, 'user@example.com', 99999, NOW()\n) s\nWHERE NOT EXISTS (SELECT 1 FROM dq_demo_orders);\nSELECT 'dq_ready' AS status;","options":{},"operation":"executeQuery"},"typeVersion":2.5,"alwaysOutputData":true},{"id":"af58c882-8cbc-42ef-a9bd-3321cbe66ce0","name":"Schedule Trigger - Hourly","type":"n8n-nodes-base.scheduleTrigger","position":[-880,-864],"parameters":{"rule":{"interval":[{"field":"hours"}]}},"typeVersion":1.2},{"id":"6a904769-f2a2-4d1e-b25d-340ff6080a6b","name":"Webhook - Run Check On Demand","type":"n8n-nodes-base.webhook","position":[-880,-672],"webhookId":"ca5dc7dc-33e9-52e7-ac78-8582c30d6641","parameters":{"path":"dq-run","options":{},"httpMethod":"POST"},"typeVersion":2},{"id":"011e92a0-4cac-447d-8b23-f3ac36253078","name":"Set DQ Config","type":"n8n-nodes-base.set","position":[-608,-768],"parameters":{"options":{},"assignments":{"assignments":[{"id":"8a22dcb7-3036-5cae-ac9d-e945b7c9c0f9","name":"tableName","type":"string","value":"dq_demo_orders"},{"id":"e10aedd2-f407-58f9-a674-7653007ee76f","name":"pkColumn","type":"string","value":"id"},{"id":"beb004cb-ee77-59dc-b905-92ca1f0ef0de","name":"timestampColumn","type":"string","value":"created_at"},{"id":"53852a42-ec6f-5787-b02e-a2cb4ea700f4","name":"requiredColumns","type":"string","value":"customer_email,amount"},{"id":"2bfc4107-502c-59a3-9e97-ad2cc933d6d9","name":"duplicateKeyColumns","type":"string","value":"customer_email"},{"id":"3e6021e7-8afe-5032-9121-0957b1ff44a7","name":"numericColumns","type":"string","value":"amount"},{"id":"00cddcc9-3335-5724-aaae-63b9d7c92918","name":"normalizeDuplicateKeys","type":"boolean","value":true},{"id":"b10c589a-7a8d-5fb7-a692-db12c377e28a","name":"scopeHours","type":"number","value":0},{"id":"dec90dcb-849d-5f5f-a9bb-7114218c795c","name":"freshnessHours","type":"number","value":24},{"id":"84ed120e-5cbe-5de2-ba80-283955172807","name":"anomalyThreshold","type":"number","value":3.5},{"id":"29d7fe29-9c69-5471-9502-86f030ae3c43","name":"volumeLowRatio","type":"number","value":0.5},{"id":"07b545a1-6e8d-5d06-82bb-a50e5ef18dea","name":"volumeHighRatio","type":"number","value":2},{"id":"2b9acd73-6cab-5b2f-a964-e6050cffaf32","name":"maxIssuesPerCheck","type":"number","value":500},{"id":"f578b7cc-9d1d-5124-85ab-eeb6ca7c84b1","name":"warnScore","type":"number","value":95},{"id":"a0e42c08-2fc5-5d47-81c2-50f07dfd5319","name":"failScore","type":"number","value":80},{"id":"0495922a-cef5-556e-82e9-d4cc03b28f9d","name":"slackWebhookUrl","type":"string","value":"https://hooks.slack.com/services/REPLACE/ME/NOW"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"80bc72a7-ea5e-4a6b-b31f-edd90d02f2c9","name":"Code - Build Check Queries","type":"n8n-nodes-base.code","position":[-336,-768],"parameters":{"jsCode":"const cfg = $('Set DQ Config').first().json;\nconst ID = /^[a-z_][a-z0-9_]{0,62}$/;\nconst list = s => String(s || '').split(',').map(x => x.trim()).filter(Boolean);\nconst errors = [];\n\nconst parts = String(cfg.tableName).split('.');\nif (parts.length > 2 || !parts.every(p => ID.test(p))) errors.push('tableName must be \"table\" or \"schema.table\" (lowercase letters, digits, _)');\nconst pk = String(cfg.pkColumn), ts = String(cfg.timestampColumn || '');\nif (!ID.test(pk)) errors.push('invalid pkColumn');\nif (ts && !ID.test(ts)) errors.push('invalid timestampColumn');\nconst req = list(cfg.requiredColumns), dup = list(cfg.duplicateKeyColumns), num = list(cfg.numericColumns);\n[...req, ...dup, ...num].forEach(c => { if (!ID.test(c)) errors.push('invalid column name: ' + c); });\nif (errors.length) return [{ json: { valid: false, alertText: ':x: Data quality engine: invalid configuration: ' + errors.join('; ') } }];\n\nconst scopeHours = Math.max(0, Math.floor(Number(cfg.scopeHours) || 0));\nconst thr = Number(cfg.anomalyThreshold) || 3.5;\nconst limit = Math.min(5000, Math.max(1, Math.floor(Number(cfg.maxIssuesPerCheck) || 500)));\nconst q = id => '\"' + id + '\"';\nconst tbl = parts.map(q).join('.');\n// Only rows changed inside the window are checked when scopeHours > 0 (0 = whole table)\nconst scope = a => (scopeHours > 0 && ts) ? a + q(ts) + \" >= NOW() - INTERVAL '\" + scopeHours + \" hours'\" : 'TRUE';\nconst none = \"SELECT NULL::text AS check_type WHERE FALSE\";\n\n// 1) Missing: required columns that are NULL or blank\nconst missingSql = !req.length ? none :\n  \"SELECT 'missing'::text AS check_type, 'warning'::text AS severity, t.\" + q(pk) + \"::text AS record_key, v.col AS column_name, \" +\n  \"'required column is NULL or blank'::text AS detail, 1 AS affected FROM \" + tbl + \" t CROSS JOIN LATERAL (VALUES \" +\n  req.map(c => \"('\" + c + \"', t.\" + q(c) + \"::text)\").join(', ') + \") AS v(col, val) \" +\n  \"WHERE \" + scope('t.') + \" AND (v.val IS NULL OR btrim(v.val) = '') ORDER BY t.\" + q(pk) + \" LIMIT \" + limit;\n\n// 2) Duplicates: records sharing the same (optionally normalized) business key\nconst norm = c => cfg.normalizeDuplicateKeys ? \"lower(regexp_replace(btrim(COALESCE(t.\" + q(c) + \"::text, '')), '\\\\s+', ' ', 'g'))\" : \"t.\" + q(c) + \"::text\";\nconst ks = dup.map((c, i) => 'k' + (i + 1));\nconst duplicateSql = !dup.length ? none :\n  \"WITH k AS (SELECT t.\" + q(pk) + \"::text AS pk, \" + dup.map((c, i) => norm(c) + ' AS ' + ks[i]).join(', ') + \", (\" + scope('t.') + \") AS in_scope FROM \" + tbl + \" t) \" +\n  \"SELECT 'duplicate'::text AS check_type, 'warning'::text AS severity, array_to_string((array_agg(pk ORDER BY pk))[1:10], ',') AS record_key, '\" + dup.join(',') + \"'::text AS column_name, \" +\n  \"(COUNT(*) || ' records share the same key: ' || concat_ws(' | ', \" + ks.join(', ') + \"))::text AS detail, (COUNT(*) - 1)::int AS affected \" +\n  \"FROM k WHERE concat_ws('', \" + ks.join(', ') + \") <> '' GROUP BY \" + ks.join(', ') + \" HAVING COUNT(*) > 1 AND bool_or(in_scope) ORDER BY COUNT(*) DESC LIMIT \" + limit;\n\n// 3) Anomalies: robust z-score (median / MAD, falls back to mean absolute deviation) per numeric column\nconst anomalySql = !num.length ? none :\n  \"WITH vals AS (SELECT t.\" + q(pk) + \"::text AS record_key, v.col, v.val, (\" + scope('t.') + \") AS in_scope FROM \" + tbl + \" t CROSS JOIN LATERAL (VALUES \" +\n  num.map(c => \"('\" + c + \"', t.\" + q(c) + \"::numeric)\").join(', ') + \") AS v(col, val) WHERE v.val IS NOT NULL), \" +\n  \"med AS (SELECT col, percentile_cont(0.5) WITHIN GROUP (ORDER BY val) AS m FROM vals GROUP BY col), \" +\n  \"dev AS (SELECT v.col, med.m, percentile_cont(0.5) WITHIN GROUP (ORDER BY abs(v.val - med.m)) AS mad, AVG(abs(v.val - med.m)) AS meanad FROM vals v JOIN med ON med.col = v.col GROUP BY v.col, med.m), \" +\n  \"scored AS (SELECT v.record_key, v.col, v.val, dev.m, CASE WHEN dev.mad > 0 THEN 0.6745 * (v.val - dev.m) / dev.mad WHEN dev.meanad > 0 THEN (v.val - dev.m) / (1.253314 * dev.meanad) END AS z \" +\n  \"FROM vals v JOIN dev ON dev.col = v.col WHERE v.in_scope) \" +\n  \"SELECT 'anomaly'::text AS check_type, CASE WHEN abs(z) > \" + (2 * thr) + \" THEN 'critical' ELSE 'warning' END::text AS severity, record_key, col AS column_name, \" +\n  \"format('value %s vs median %s (robust z %s)', val, round(m, 2), round(z::numeric, 1)) AS detail, 1 AS affected FROM scored WHERE z IS NOT NULL AND abs(z) > \" + thr + \" ORDER BY abs(z) DESC LIMIT \" + limit;\n\n// 4) Table health: row counts, freshness and the recent average load size (for volume checks)\nconst healthSql = \"SELECT COUNT(*)::int AS total_rows, COUNT(*) FILTER (WHERE \" + scope('') + \")::int AS scoped_rows, \" +\n  (ts ? \"MAX(\" + q(ts) + \") AS latest_ts, (EXTRACT(EPOCH FROM (NOW() - MAX(\" + q(ts) + \"))) / 3600)::float AS hours_since\" : \"NULL::timestamptz AS latest_ts, NULL::float AS hours_since\") +\n  \", (SELECT AVG(scoped_rows) FROM (SELECT scoped_rows FROM dq_runs WHERE table_name = $1::text ORDER BY id DESC LIMIT 14) r)::float AS avg_scoped_rows FROM \" + tbl;\n\nreturn [{ json: { valid: true, tableLabel: cfg.tableName, scopeHours, limit, hasTimestamp: !!ts, missingSql, duplicateSql, anomalySql, healthSql } }];"},"typeVersion":2},{"id":"4e642249-629f-439d-8449-5a862ec1a2d1","name":"Config Valid?","type":"n8n-nodes-base.if","position":[-64,-768],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true"},"leftValue":"={{ $json.valid }}","rightValue":""}]}},"typeVersion":2.2},{"id":"b6894b99-78fa-4dc5-86e3-ff4489f564b8","name":"HTTP - Slack Config Error Alert","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[-64,-560],"parameters":{"url":"={{ $('Set DQ Config').first().json.slackWebhookUrl }}","method":"POST","options":{"timeout":15000},"jsonBody":"={{ JSON.stringify({ text: $json.alertText }) }}","sendBody":true,"specifyBody":"json"},"typeVersion":4.2},{"id":"630bf447-ca57-4e93-8f52-3196f030b7ab","name":"Postgres - Detect Missing Values","type":"n8n-nodes-base.postgres","position":[208,-768],"parameters":{"query":"{{ $('Code - Build Check Queries').first().json.missingSql }}","options":{},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"continueOnFail":true,"alwaysOutputData":true},{"id":"f013dd51-f81f-4fdc-b8a5-dd027747bb85","name":"Postgres - Detect Duplicate Records","type":"n8n-nodes-base.postgres","position":[480,-768],"parameters":{"query":"{{ $('Code - Build Check Queries').first().json.duplicateSql }}","options":{},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"continueOnFail":true,"alwaysOutputData":true},{"id":"deccb294-4733-46ac-8f33-0584fa9bfb4f","name":"Postgres - Detect Anomalous Values","type":"n8n-nodes-base.postgres","position":[752,-768],"parameters":{"query":"{{ $('Code - Build Check Queries').first().json.anomalySql }}","options":{},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"continueOnFail":true,"alwaysOutputData":true},{"id":"c191ca5f-24c3-47ff-9c31-7b1620402036","name":"Postgres - Table Health Stats","type":"n8n-nodes-base.postgres","position":[1024,-768],"parameters":{"query":"{{ $('Code - Build Check Queries').first().json.healthSql }}","options":{"queryReplacement":"={{ [ $('Code - Build Check Queries').first().json.tableLabel ] }}"},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"continueOnFail":true,"alwaysOutputData":true},{"id":"ca7e5f91-90c0-469c-8e92-0508aa9524cf","name":"Code - Score & Classify","type":"n8n-nodes-base.code","position":[1280,-768],"parameters":{"jsCode":"const cfg = $('Set DQ Config').first().json;\nconst q = $('Code - Build Check Queries').first().json;\nconst grab = n => $(n).all().map(i => i.json);\nconst raw = [...grab('Postgres - Detect Missing Values'), ...grab('Postgres - Detect Duplicate Records'), ...grab('Postgres - Detect Anomalous Values')];\nconst hs = grab('Postgres - Table Health Stats')[0] || {};\nconst errMsg = e => String(typeof e === 'string' ? e : (e && e.message) || JSON.stringify(e)).slice(0, 300);\nconst errors = [...raw, hs].filter(r => r.error !== undefined).map(r => errMsg(r.error));\n\nconst found = raw.filter(r => r.check_type);\nconst issues = found.map(r => ({ check_type: r.check_type, severity: r.severity, record_key: String(r.record_key), column_name: r.column_name || null, detail: String(r.detail).slice(0, 500), affected: Number(r.affected) || 1 }));\nconst truncated = ['missing', 'duplicate', 'anomaly'].some(t => found.filter(x => x.check_type === t).length >= q.limit);\n\nconst total = Number(hs.total_rows) || 0, scoped = Number(hs.scoped_rows) || 0;\nconst ds = (check_type, severity, record_key, column_name, detail) => issues.push({ check_type, severity, record_key, column_name, detail, affected: 1 });\n\n// Freshness: has new data arrived recently?\nconst freshH = Number(cfg.freshnessHours) || 24;\nlet timeliness = 100;\nif (q.hasTimestamp && hs.total_rows !== undefined) {\n  const h = hs.hours_since === null || hs.hours_since === undefined ? null : Number(hs.hours_since);\n  if (h === null && total > 0) { timeliness = 0; ds('freshness', 'critical', 'table', cfg.timestampColumn, 'no valid timestamps found'); }\n  else if (h !== null && h > freshH) {\n    const crit = h > freshH * 2; timeliness = crit ? 0 : 50;\n    ds('freshness', crit ? 'critical' : 'warning', 'table', cfg.timestampColumn, 'newest record is ' + h.toFixed(1) + 'h old (limit ' + freshH + 'h)');\n  }\n}\n// Volume: is this window much smaller or larger than the recent average?\nconst avg = Number(hs.avg_scoped_rows);\nif (q.scopeHours > 0 && avg > 0) {\n  const ratio = scoped / avg, lo = Number(cfg.volumeLowRatio) || 0.5, hi = Number(cfg.volumeHighRatio) || 2;\n  if (ratio < lo || ratio > hi) ds('volume', (ratio < lo / 2.5 || ratio > hi * 2) ? 'critical' : 'warning', 'table', null, scoped + ' rows in window vs recent average ' + Math.round(avg) + ' (' + ratio.toFixed(2) + 'x)');\n}\nfor (const e of errors) ds('check_failed', 'critical', 'engine', null, e);\n\n// Dimension scores (0-100)\nconst clamp = x => Math.max(0, Math.min(100, x));\nconst distinct = t => new Set(issues.filter(i => i.check_type === t).map(i => i.record_key)).size;\nconst dupExtra = issues.filter(i => i.check_type === 'duplicate').reduce((s, i) => s + i.affected, 0);\nconst dims = {\n  completeness: clamp(100 * (1 - distinct('missing') / Math.max(scoped, 1))),\n  uniqueness: clamp(100 * (1 - dupExtra / Math.max(total, 1))),\n  validity: clamp(100 * (1 - distinct('anomaly') / Math.max(scoped, 1))),\n  timeliness\n};\nconst r1 = x => Math.round(x * 10) / 10;\nconst score = r1(dims.completeness * 0.35 + dims.uniqueness * 0.25 + dims.validity * 0.25 + dims.timeliness * 0.15);\nlet status = errors.length ? 'error' : score >= Number(cfg.warnScore) ? 'pass' : score >= Number(cfg.failScore) ? 'warn' : 'fail';\nif (status === 'pass' && issues.some(i => i.severity === 'critical')) status = 'warn';\n\nconst rank = { critical: 0, warning: 1, info: 2 };\nconst top = [...issues].sort((a, b) => rank[a.severity] - rank[b.severity]).slice(0, 8);\nconst kept = issues.slice(0, 2000);\nfor (const k of Object.keys(dims)) dims[k] = r1(dims[k]);\nreturn [{ json: {\n  tableName: q.tableLabel, totalRows: total, scopedRows: scoped, score, status, dims, truncated,\n  counts: { missing: distinct('missing'), duplicate: issues.filter(i => i.check_type === 'duplicate').length, anomaly: distinct('anomaly'), freshness: issues.filter(i => i.check_type === 'freshness').length, volume: issues.filter(i => i.check_type === 'volume').length, failed: errors.length },\n  issuesJson: JSON.stringify(kept),\n  keysJson: JSON.stringify(kept.map(i => ({ check_type: i.check_type, record_key: i.record_key, column_name: i.column_name }))),\n  // Only auto-resolve record-level issues after a full, untruncated, error-free scan\n  resolveEnabled: q.scopeHours === 0 && !truncated && !errors.length,\n  topIssues: top\n} }];"},"typeVersion":2},{"id":"84b04c47-1b66-48e6-824c-fba5dcb9a85c","name":"Postgres - Save Run & Issues","type":"n8n-nodes-base.postgres","position":[1552,-768],"parameters":{"query":"WITH run AS (\n  INSERT INTO dq_runs (table_name, total_rows, scoped_rows, score, status, dimension_scores)\n  VALUES ($1::text, $2::int, $3::int, $4::numeric, $5::text, $6::jsonb)\n  RETURNING id\n), iss AS (\n  INSERT INTO dq_issues (run_id, table_name, check_type, severity, record_key, column_name, detail)\n  SELECT run.id, $1::text, x.check_type, x.severity, x.record_key, x.column_name, x.detail\n  FROM run, jsonb_to_recordset($7::jsonb) AS x(check_type text, severity text, record_key text, column_name text, detail text)\n  WHERE NOT EXISTS (\n    SELECT 1 FROM dq_issues d\n    WHERE d.table_name = $1::text AND d.status = 'open' AND d.check_type = x.check_type\n      AND d.record_key = x.record_key AND COALESCE(d.column_name, '') = COALESCE(x.column_name, ''))\n  RETURNING severity\n)\nSELECT (SELECT id FROM run) AS run_id, (SELECT COUNT(*) FROM iss)::int AS new_issues,\n       (SELECT COUNT(*) FROM iss WHERE severity = 'critical')::int AS new_critical;","options":{"queryReplacement":"={{ [ $json.tableName, $json.totalRows, $json.scopedRows, $json.score, $json.status, JSON.stringify($json.dims), $json.issuesJson ] }}"},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"alwaysOutputData":true},{"id":"702971bb-44f6-443f-9eea-de4ff96a939a","name":"Postgres - Auto-Resolve Cleared Issues","type":"n8n-nodes-base.postgres","position":[1824,-768],"parameters":{"query":"WITH r AS (\n  UPDATE dq_issues d SET status = 'resolved', resolved_at = NOW()\n  WHERE d.table_name = $1::text AND d.status = 'open'\n    AND (d.check_type IN ('freshness', 'volume', 'check_failed')\n         OR ($2::boolean AND d.check_type IN ('missing', 'duplicate', 'anomaly')))\n    AND NOT EXISTS (\n      SELECT 1 FROM jsonb_to_recordset($3::jsonb) AS k(check_type text, record_key text, column_name text)\n      WHERE k.check_type = d.check_type AND k.record_key = d.record_key AND COALESCE(k.column_name, '') = COALESCE(d.column_name, ''))\n  RETURNING 1\n)\nSELECT COUNT(*)::int AS resolved FROM r;","options":{"queryReplacement":"={{ [ $('Code - Score & Classify').first().json.tableName, $('Code - Score & Classify').first().json.resolveEnabled, $('Code - Score & Classify').first().json.keysJson ] }}"},"operation":"executeQuery"},"executeOnce":true,"typeVersion":2.5,"alwaysOutputData":true},{"id":"49747513-d275-4870-a6b9-02a3ff7cdf85","name":"Code - Build Quality Report","type":"n8n-nodes-base.code","position":[2096,-768],"parameters":{"jsCode":"const s = $('Code - Score & Classify').first().json;\nconst save = $('Postgres - Save Run & Issues').first().json;\nconst res = $('Postgres - Auto-Resolve Cleared Issues').first().json;\nconst newIssues = Number(save.new_issues) || 0, newCritical = Number(save.new_critical) || 0, resolved = Number(res.resolved) || 0;\nconst icon = { pass: ':white_check_mark:', warn: ':warning:', fail: ':rotating_light:', error: ':rotating_light:' }[s.status];\nconst lines = s.topIssues.map(i => '- [' + i.severity + '] ' + i.check_type + (i.column_name ? ' (' + i.column_name + ')' : '') + ' ' + i.record_key + ': ' + i.detail);\nconst text = icon + ' Data quality ' + s.status.toUpperCase() + ' for ' + s.tableName + ': score ' + s.score + '/100 (run #' + save.run_id + ')\\n' +\n  'completeness ' + s.dims.completeness + ' | uniqueness ' + s.dims.uniqueness + ' | validity ' + s.dims.validity + ' | timeliness ' + s.dims.timeliness + '\\n' +\n  'missing ' + s.counts.missing + ', duplicate groups ' + s.counts.duplicate + ', anomalies ' + s.counts.anomaly + ' | new issues ' + newIssues + ' (' + newCritical + ' critical), resolved ' + resolved +\n  (s.truncated ? '\\n:information_source: results were truncated at maxIssuesPerCheck' : '') + (lines.length ? '\\nTop issues:\\n' + lines.join('\\n') : '');\nconst alertNeeded = s.status === 'error' || s.status === 'fail' || newCritical > 0 || (s.status === 'warn' && newIssues > 0);\nreturn [{ json: { alertNeeded, alertText: text, status: s.status, score: s.score, runId: save.run_id, newIssues, resolved } }];"},"typeVersion":2},{"id":"61739e8b-0991-4a9c-9264-57d5e4e53f7f","name":"Alert Needed?","type":"n8n-nodes-base.if","position":[2368,-768],"parameters":{"options":{},"conditions":{"options":{"version":1,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true"},"leftValue":"={{ $json.alertNeeded }}","rightValue":""}]}},"typeVersion":2.2},{"id":"7687fa36-ff44-4cba-9486-cdacfdc9b7cf","name":"HTTP - Slack Quality Alert","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[2640,-768],"parameters":{"url":"={{ $('Set DQ Config').first().json.slackWebhookUrl }}","method":"POST","options":{"timeout":15000},"jsonBody":"={{ JSON.stringify({ text: $json.alertText }) }}","sendBody":true,"specifyBody":"json"},"typeVersion":4.2}],"active":false,"pinData":{},"settings":{"binaryMode":"separate","availableInMCP":false,"executionOrder":"v1"},"versionId":"3a4723a4-b8d5-4792-999d-5005821642bc","nodeGroups":[],"connections":{"Alert Needed?":{"main":[[{"node":"HTTP - Slack Quality Alert","type":"main","index":0}]]},"Config Valid?":{"main":[[{"node":"Postgres - Detect Missing Values","type":"main","index":0}],[{"node":"HTTP - Slack Config Error Alert","type":"main","index":0}]]},"Set DQ Config":{"main":[[{"node":"Code - Build Check Queries","type":"main","index":0}]]},"Code - Score & Classify":{"main":[[{"node":"Postgres - Save Run & Issues","type":"main","index":0}]]},"Schedule Trigger - Hourly":{"main":[[{"node":"Set DQ Config","type":"main","index":0}]]},"Code - Build Check Queries":{"main":[[{"node":"Config Valid?","type":"main","index":0}]]},"Code - Build Quality Report":{"main":[[{"node":"Alert Needed?","type":"main","index":0}]]},"Postgres - Save Run & Issues":{"main":[[{"node":"Postgres - Auto-Resolve Cleared Issues","type":"main","index":0}]]},"Postgres - Table Health Stats":{"main":[[{"node":"Code - Score & Classify","type":"main","index":0}]]},"Webhook - Run Check On Demand":{"main":[[{"node":"Set DQ Config","type":"main","index":0}]]},"Manual Trigger - Run Setup Once":{"main":[[{"node":"Postgres - Create DQ Tables","type":"main","index":0}]]},"Postgres - Detect Missing Values":{"main":[[{"node":"Postgres - Detect Duplicate Records","type":"main","index":0}]]},"Postgres - Detect Anomalous Values":{"main":[[{"node":"Postgres - Table Health Stats","type":"main","index":0}]]},"Postgres - Detect Duplicate Records":{"main":[[{"node":"Postgres - Detect Anomalous Values","type":"main","index":0}]]},"Postgres - Auto-Resolve Cleared Issues":{"main":[[{"node":"Code - Build Quality Report","type":"main","index":0}]]}}}