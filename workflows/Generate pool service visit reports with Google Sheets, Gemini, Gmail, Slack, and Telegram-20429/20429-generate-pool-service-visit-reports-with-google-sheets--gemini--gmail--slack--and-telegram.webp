ptions":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"355047c3-f284-43da-8b55-58cb8337f698","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $('Build Visit Record').first().json.needs_approval }}","rightValue":"Yes"}]}},"typeVersion":2.2},{"id":"16f26975-ee08-4afb-990a-797dfc8f4040","name":"Send Manager Approval Email","type":"n8n-nodes-base.gmail","position":[7968,1744],"webhookId":"2d934cb5-dd3b-4ab3-9659-71b240a3b87e","parameters":{"sendTo":"user@example.com","message":"={{ (() => {\n  const base = $execution.resumeUrl;\n  const sep = base.includes('?') ? '&' : '?';\n  return $('Build Visit Record').first().json.approval_html\n    .replace('__APPROVE__', base + sep + 'action=approve')\n    .replace('__REJECT__', base + sep + 'action=reject');\n})() }}","options":{"appendAttribution":false},"subject":"={{ '⚠️ Approval needed: ' + $('Build Visit Record').first().json.customer_name + ' (' + $('Build Visit Record').first().json.visit_id + ')' }}"},"credentials":{"gmailOAuth2":{"id":"credential-id","name":"Abhiram.bvb"}},"typeVersion":2.1},{"id":"1f01b24b-7715-4e5c-ad9e-4cae9fde49ee","name":"Wait for Manager Response","type":"n8n-nodes-base.wait","position":[8192,1744],"webhookId":"73e86999-97c5-498e-ae0c-8be1f845800d","parameters":{"resume":"webhook","options":{},"resumeAmount":24,"limitWaitTime":true},"typeVersion":1.1},{"id":"d7a4f1a1-ca8c-46fb-9173-b693a2589ba9","name":"If Manager Approved","type":"n8n-nodes-base.if","position":[8416,1744],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"db6d2f9a-836d-48f1-a38e-9a6ef75dcbc0","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.query ? $json.query.action : '' }}","rightValue":"approve"}]}},"typeVersion":2.2},{"id":"b88f6d55-39fb-42eb-9fe3-af2372c260e1","name":"Mark Report Held in Sheets","type":