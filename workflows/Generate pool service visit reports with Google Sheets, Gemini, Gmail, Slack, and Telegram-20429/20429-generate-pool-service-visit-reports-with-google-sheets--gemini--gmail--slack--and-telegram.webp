me":"Report Status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Report Sent At","type":"string","display":true,"required":false,"displayName":"Report Sent At","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["Visit ID"]},"options":{"cellFormat":"RAW"},"operation":"update","sheetName":{"__rl":true,"mode":"name","value":"Visits"},"documentId":{"__rl":true,"mode":"id","value":"1dx-1KrMuwi8POXiKNTix8induDZPPcycrBCchfx4kDM"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"credential-id","name":"Google Service Account account"}},"typeVersion":4.5},{"id":"9b1837f4-f546-432b-981f-2b40bc6828db","name":"Format Fallback Record","type":"n8n-nodes-base.code","position":[6176,2016],"parameters":{"jsCode":"const ctx = $('Prepare Agent Context').first().json;\nconst err = ($input.first().json.error && ($input.first().json.error.message || $input.first().json.error)) || 'AI step failed';\nconst KEYS = [\"visit_id\", \"logged_at\", \"visit_date\", \"customer_id\", \"customer_name\", \"customer_email\", \"property_address\", \"technician\", \"raw_notes\", \"readings_text\", \"pool_condition\", \"water_clarity\", \"chemical_issues\", \"equipment_issues\", \"actions_taken\", \"safety_concerns\", \"rule_flags\", \"recurring_flags\", \"follow_up_needed\", \"follow_up_type\", \"urgency\", \"priority\", \"next_visit_days\", \"next_visit_date\", \"confidence\", \"missing_info\", \"needs_approval\", \"work_order_id\", \"customer_summary\", \"report_status\", \"sent_at\"];\nconst out = {};\nfor (const k of KEYS) out[k] = '';\nconst stamp = String(ctx.visit_date).replace(/-/g, '');\nObject.assign(out, {\n  visit_id: `PV-${stamp}-${Math.random().toString(36).slice(2, 6).toUpperCase()}`,\n  logged_at: $now.toISO(), visit_date: ctx.visit_date, customer_id: ctx.customer_id, customer_name: ctx.customer_name,\n  customer_email: ctx.customer_email, property_address: ctx.property_address, technician: ctx.technician,\n  raw_notes: ctx.raw_notes, readings_text: ctx.readings_text, pool_condition: 'Unknown',\n  rule_flags: (ctx.rule_flags || []).map(f => `${f.parameter || f.equipment}: ${f.issue}`).join('; ') || 'None',\n  follow_up_needed: 'Yes', follow_up_type: 'Inspection', urgency: 'Soon', priority: 'P2 - High',\n  needs_approval: 'Yes', missing_info: 'AI structuring failed: ' + String(err).slice(0, 200),\n  report_status: 'AI FAILED - manual review needed'\n});\nreturn [{ json: out }];"},"typeVersion":2},{"id":"f32d4620-9362-4c8d-9b55-0293a375d865","name":"Append Failed Visit to Sheets","type":"n8n-nodes-base.googleSheets","position":[6400,2016],"parameters":{"columns":{"value":{"Address":"={{ $json.property_address }}","Urgency":"={{ $json.urgency }}","Customer":"={{ $json.customer_name }}","Priority":"={{ $json.priority }}","Readings":"={{ $json.readings_text }}","Visit ID":"={{ $json.visit_id }}","Logged At":"={{ $json.logged_at }}","Raw Notes":"={{ $json.raw_notes }}","Rule Flags":"={{ $json.rule_flags }}","Technician":"={{ $json.technician }}","Visit Date":"={{ $json.visit_date }}","Customer ID":"={{ $json.customer_id }}","Missing Info":"={{ $json.missing_info }}","AI Confidence":"={{ $json.confidence }}","Actions Taken":"={{ $json.actions_taken }}","Report Status":"={{ $json.report_status }}","Water Clarity":"={{ $json.water_clarity }}","Work Order ID":"={{ $json.work_order_id }}","Customer Email":"={{ $json.customer_email }}","Follow-Up Type":"={{ $json.follow_up_type }}","Needs Approval":"={{ $json.needs_approval }}","Pool Condition":"={{ $json.pool_condition }}","Report Sent At":"={{ $json.sent_at }}","Chemical Issues":"={{ $json.chemical_issues }}","Next Visit Date":"={{ $json.next_visit_date }}","Next Visit Days":"={{ $json.next_visit_days }}","Safety Concerns":"={{ $json.safety_concerns }}","Customer Summary":"={{ $json.customer_summary }}","Equipment Issues":"={{ $json.equipment_issues }}","Follow-Up Needed":"={{ $json.follow_up_needed }}","Recurring Issues":"={{ $json.recurring_flags }}"},"schema":[{"id":"Visit ID","type":"string","display":true,"required":false,"displayName":"Visit ID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Logged At","type":"string","display":true,"required":false,"displayName":"Logged At","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Visit Date","type":"string","display":true,"required":false,"displayName":"Visit Date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Customer ID","type":"string","display":true,"required":false,"displayName":"Customer ID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Customer","type":"string","display":true,"required":false,"displayName":"Customer","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Customer Email","type":"string","display":true,"required":false,"displayName":"Customer Email","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Address","type":"string","display":true,"required":false,"displayName":"Address","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Technician","type":"string","display":true,"required":false,"displayName":"Technician","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Raw Notes","type":"string","display":true,"required":false,"displayName":"Raw Notes","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Readings","type":"string","display":true,"required":false,"displayName":"Readings","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Pool Condition","type":"string","display":true,"required":false,"displayName":"Pool Condition","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Water Clarity","type":"string","display":true,"required":false,"displayName":"Water Clarity","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Chemical Issues","type":"string","display":true,"required":false,"displayName":"Chemical Issues","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Equipment Issues","type":"string","display":true,"required":false,"displayName":"Equipment Issues","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Actions Taken","type":"string","display":true,"required":false,"displayName":"Actions Taken","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Safety Concerns","type":"string","display":true,"required":false,"displayName":"Safety Concerns","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Rule Flags","type":"string","display":true,"required":false,"displayName":"Rule Flags","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Recurring Issues","type":"string","display":true,"required":false,"displayName":"Recurring Issues","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Follow-Up Needed","type":"string","display":true,"required":false,"displayName":"Follow-Up Needed","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Follow-Up Type","type":"string","display":true,"required":false,"displayName":"Follow-Up Type","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Urgency","type":"string","display":true,"required":false,"displayName":"Urgency","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Priority","type":"string","display":true,"required":false,"displayName":"Priority","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Next Visit Days","type":"string","display":true,"required":false,"displayName":"Next Visit Days","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Next Visit Date","type":"string","display":true,"required":false,"displayName":"Next Visit Date","defaultMatch":false,"canBeUsedToMatch":true},{"id":"AI Confidence","type":"string","display":true,"required":false,"displayName":"AI Confidence","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Missing Info","type":"string","display":true,"required":false,"displayName":"Missing Info","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Needs Approval","type":"string","display":true,"required":false,"displayName":"Needs Approval","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Work Order ID","type":"string","display":true,"required":false,"displayName":"Work Order ID","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Customer Summary","type":"string","display":true,"required":false,"displayName":"Customer Summary","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Report Status","type":"string","display":true,"required":false,"displayName":"Report Status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"Report Sent At","type":"string","display":true,"required":false,"displayName":"Report Sent At","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[]},"options":{"cellFormat":"RAW"},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Visits"},"documentId":{"__rl":true,"mode":"id","value":"1dx-1KrMuwi8POXiKNTix8induDZPPcycrBCchfx4kDM"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"credential-id","name":"Google Service Account account"}},"typeVersion":4.5},{"id":"5c4a48c9-1e7c-4aa2-bad5-cefc3d760f54","name":"Every Morning at 7-30 AM","type":"n8n-nodes-base.scheduleTrigger","position":[4688,2624],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"30 7 * * 1-6"}]}},"typeVersion":1.2},{"id":"fa4ba976-b4c7-471f-84a0-090cce92a7ee","name":"Fetch Open Work Orders","type":"n8n-nodes-base.googleSheets","position":[4912,2624],"parameters":{"options":{},"filtersUI":{"values":[{"lookupValue":"Open","lookupColumn":"Status"}]},"sheetName":{"__rl":true,"mode":"name","value":"Work Orders"},"documentId":{"__rl":true,"mode":"id","value":"1dx-1KrMuwi8POXiKNTix8induDZPPcycrBCchfx4kDM"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"credential-id","name":"Google Service Account account"}},"typeVersion":4.5,"alwaysOutputData":true},{"id":"3c1ed16b-dca3-4888-8e58-5f4a4b955920","name":"Compile Daily Digest","type":"n8n-nodes-base.code","position":[5136,2624],"parameters":{"jsCode":"const rows = $input.all().map(i => i.json).filter(r => r['Work Order ID']);\nif (!rows.length) return [];\nconst today = $now.toFormat('yyyy-LL-dd');\nconst pr = r => String(r['Priority'] || 'P3').slice(0, 2);\nrows.sort((a, b) => pr(a).localeCompare(pr(b)) || String(a['Due Date']).localeCompare(String(b['Due Date'])));\nconst overdue = rows.filter(r => String(r['Due Date']) < today);\nconst dueToday = rows.filter(r => String(r['Due Date']) === today);\nconst upcoming = rows.length - overdue.length - dueToday.length;\nconst line = r => `• [${pr(r)}] ${r['Customer']} - ${r['Task Type']} (due ${r['Due Date']}, ${r['Assigned Tech'] || 'unassigned'})`;\nlet msg = `🏊 Daily Ops Digest - ${today}\\nOpen work orders: ${rows.length}\\n`;\nif (overdue.length) msg += `\\n🔴 OVERDUE (${overdue.length})\\n` + overdue.slice(0, 10).map(line).join('\\n') + '\\n';\nif (dueToday.length) msg += `\\n🟡 DUE TODAY (${dueToday.length})\\n` + dueToday.slice(0, 10).map(line).join('\\n') + '\\n';\nif (upcoming > 0) msg += `\\n🟢 Upcoming: ${upcoming}`;\nreturn [{ json: { message: msg } }];"},"typeVersion":2},{"id":"ff2a42b1-cb94-48f6-a5d3-92e98b5b41fc","name":"Send Digest to Telegram","type":"n8n-nodes-base.telegram","position":[5360,2624],"webhookId":"928a2c57-905a-412c-857b-9bb0aa667ce2","parameters":{"text":"={{ $json.message }}","chatId":"YOUR_TELEGRAM_CHAT_ID","additionalFields":{"appendAttribution":false}},"credentials":{"telegramApi":{"id":"credential-id","name":"Telegram account 6"}},"typeVersion":1.2},{"id":"1c8b91be-ff78-42db-91c3-443fb4cafaef","name":"On Workflow Error","type":"n8n-nodes-base.errorTrigger","position":[4688,2944],"parameters":{},"typeVersion":1},{"id":"2de6957b-6071-418d-8692-7e52c5a2cd1d","name":"Send Error Alert to Telegram","type":"n8n-nodes-base.telegram","position":[4912,2944],"webhookId":"0764a2e8-970e-4be6-83b3-62a9a9047e52","parameters":{"text":"={{ '🚨 Pool workflow error\\nWorkflow: ' + $json.workflow.name + '\\nFailed node: ' + ($json.execution.lastNodeExecuted || 'n/a') + '\\n' + (($json.execution.error &&$json.execution.error.message) || '') }}","chatId":"YOUR_TELEGRAM_CHAT_ID","additionalFields":{"appendAttribution":false}},"credentials":{"telegramApi":{"id":"credential-id","name":"Telegram account 6"}},"typeVersion":1.2},{"id":"4472b344-21af-458e-bd2b-dbf3fd3520e7","name":"Post Urgent Alert to Slack","type":"n8n-nodes-base.slack","position":[7520,1744],"webhookId":"2c6f3cac-e60f-4992-b0b6-bfa60ed87a68","parameters":{"text":"={{ $('Build Visit Record').first().json.ops_alert }}","select":"channel","channelId":{"__rl":true,"mode":"list","value":"C0B8VH1M5PX","cachedResultName":"general"},"otherOptions":{}},"credentials":{"slackApi":{"id":"credential-id","name":"Slack account 2"}},"typeVersion":2.7},{"id":"8937d192-d1a3-4978-9b02-f2303013c7db","name":"Post AI Failure to Slack","type":"n8n-nodes-base.slack","position":[6624,2016],"webhookId":"2c6f3cac-e60f-4992-b0b6-bfa60ed87a68","parameters":{"text":"={{ '🛠️ AI structuring FAILED for ' + $json.customer_name + ' (' +$json.visit_id + '). Raw notes saved in Visits sheet, please review manually:\\n\\n' + $json.raw_notes }}","select":"channel","channelId":{"__rl":true,"mode":"list","value":"C0B8VH1M5PX","cachedResultName":"general"},"otherOptions":{}},"credentials":{"slackApi":{"id":"credential-id","name":"Slack account 2"}},"typeVersion":2.7}],"active":false,"pinData":{"When Technician Submits Form":[{"json":{"pH":0,"formMode":"production","Visit Date":"2026-10-01","Customer ID":"C-1001","submittedAt":"2026-10-01T17:09:19.007+05:30","Technician Name":"VAAR","Technician Notes":"LOW CHLORINE","Free Chlorine (ppm)":0,"Filter Pressure (psi)":0,"Total Alkalinity (ppm)":0}}]},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"b021c5fd-3103-48ff-9f94-aa86aa6eb3c9","nodeGroups":[],"connections":{"If Urgent Issue":{"main":[[{"node":"Post Urgent Alert to Slack","type":"main","index":0}],[{"node":"If Approval Required","type":"main","index":0}]]},"If Customer Found":{"main":[[{"node":"Fetch Visit History","type":"main","index":0}],[{"node":"Send Unknown Customer Alert","type":"main","index":0}]]},"