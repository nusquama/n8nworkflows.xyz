{"id":"98jhHfFXVvFiV2kH","meta":{"instanceId":"93f396852104089b8670e7494b0f3668b420464668ae4a8c1d6b4b5799f8e3ef","templateCredsSetupCompleted":true},"name":"Immoweb Bad-Deal Detector","tags":[],"nodes":[{"id":"a7b1b249-0435-43d0-b680-b28159ebd9fc","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-864,-112],"parameters":{"width":480,"height":896,"content":"## Untitled workflow\n\n### How it works\n\n1. Triggers daily or manually and initializes property search parameters and Slack settings.\n2. Triggers an Apify actor to scrape Immoweb listings, sending a Slack alert if the scrape fails.\n3. Retrieves historical listings from Google Sheets to filter out duplicates and limits new items to process.\n4. Generates a structured investment verdict for each property using Google Gemini.\n5. Appends the analyzed listings back to Google Sheets and posts deals meeting alert conditions to Slack.\n\n### Setup steps\n\n- - [ ] Set up Apify API credentials and configure the Immoweb scraper actor endpoint.\n- - [ ] Connect Google Sheets credentials and select the target spreadsheet for reading and writing listings.\n- - [ ] Connect Google Gemini API credentials for the LLM Chain model.\n- - [ ] Connect Slack API credentials and verify permissions for the destination notification channel.\n- - [ ] Configure target search parameters such as searchUrl and minDropPct in the Set Configuration Fields node.\n\n### Customization\n\nUpdate the search URL, minimum price drop percentage, and Slack channel in the Set Configuration Fields node, or tailor the Gemini prompt to match your investment criteria.\n\n@[youtube](FGzYp8k-ONY)"},"typeVersion":1},{"id":"1568268d-d809-4f79-98a9-493d439226a6","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-304,-96],"parameters":{"color":7,"width":416,"height":496,"content":"## Trigger and initialize parameters\n\nInitiates the workflow on schedule or manually and sets search parameters."},"typeVersion":1},{"id":"d6667d62-8351-4263-ae0c-6d6333afa816","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[144,0],"parameters":{"color":7,"width":416,"height":400,"content":"## Scrape real estate listings\n\nExecutes the Apify Immoweb scraper task and alerts Slack if the request fails."},"typeVersion":1},{"id":"11d5de33-0b7a-40f8-81c3-6cc42a20ffaa","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[592,-16],"parameters":{"color":7,"width":640,"height":304,"content":"## Filter and deduplicate properties\n\nFetches known listings from Google Sheets, filters out duplicates, and limits batch size."},"typeVersion":1},{"id":"7b538bec-8100-4be7-a071-677fd6ed27c3","name":"Sticky Note4","type":"n8n-nodes-base.stickyNote","position":[1264,-16],"parameters":{"color":7,"width":608,"height":528,"content":"## Evaluate deals with Gemini\n\nEvaluates property details using Google Gemini with structured outputs and merges the verdict."},"typeVersion":1},{"id":"5262bf06-87d9-4d4d-9914-5ae781d9851c","name":"Sticky Note5","type":"n8n-nodes-base.stickyNote","position":[1904,-32],"parameters":{"color":7,"width":640,"height":320,"content":"## Log results and send alerts\n\nRecords evaluated property data into Google Sheets and notifies Slack when criteria match."},"typeVersion":1},{"id":"25719892-7de1-479f-b5cf-f200505321ca","name":"Every Morning at 7 AM","type":"n8n-nodes-base.scheduleTrigger","position":[-256,32],"parameters":{"rule":{"interval":[{"triggerAtHour":7}]}},"typeVersion":1.2},{"id":"ccb10782-101c-4394-a50e-2b6ab0dd03ab","name":"When Manually Triggered","type":"n8n-nodes-base.manualTrigger","position":[-256,224],"parameters":{},"typeVersion":1},{"id":"f19e02fc-3a38-41c8-90b4-a4beb9196b77","name":"Set Workflow Configuration","type":"n8n-nodes-base.set","position":[-32,128],"parameters":{"options":{},"assignments":{"assignments":[{"id":"c1","name":"searchUrl","type":"string","value":"https://www.immoweb.be/en/search/house/for-sale?countries=BE"},{"id":"c2","name":"maxItems","type":"number","value":10},{"id":"c3","name":"minDropPct","type":"number","value":1},{"id":"c4","name":"slackChannelName","type":"string","value":"general"},{"id":"c5","name":"sheetId","type":"string","value":"1jX8_D0-l2LQyq15rFZQl4x8gtC4Y2YhjdfxHl6Gq4ak"},{"id":"c6","name":"sheetName","type":"string","value":"Listings"},{"id":"c7","name":"emailTo","type":"string","value":"user@example.com"}]}},"typeVersion":3.4},{"id":"fec4e28f-f364-47ba-93d9-d75fa4d800f2","name":"Send Scrape Error to Slack","type":"n8n-nodes-base.slack","position":[416,224],"webhookId":"1f6b2c42-900f-4986-8180-21005e0af54e","parameters":{"text":"=⚠️ Immoweb Deal Detector: Apify scrape failed. {{ JSON.stringify($json).slice(0, 400) }}","select":"channel","channelId":{"__rl":true,"mode":"id","value":"={{ $('Set Workflow Configuration').first().json.slackChannelId }}"},"otherOptions":{}},"credentials":{"slackApi":{"id":"credential-id","name":"Slack account 2"}},"typeVersion":2.3},{"id":"2ab9e2be-579e-42c4-a66a-0fa5addf0d3f","name":"Read Saved Listings in Sheets","type":"n8n-nodes-base.googleSheets","maxTries":3,"position":[640,112],"parameters":{"options":{},"filtersUI":{"values":[{"lookupValue":"={{ $json.id }}","lookupColumn":"id"}]},"sheetName":{"__rl":true,"mode":"name","value":"={{ $('Set Workflow Configuration').first().json.sheetName }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Set Workflow Configuration').first().json.sheetId }}"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"credential-id","name":"Google Service Account account"}},"executeOnce":true,"retryOnFail":true,"typeVersion":4.5,"alwaysOutputData":true,"waitBetweenTries":3000},{"id":"3f064210-1fdb-44fb-97a0-2e61c5f1440f","name":"Deduplicate and Prepare Listings","type":"n8n-nodes-base.code","position":[864,112],"parameters":{"jsCode":"// ===== Configuration & Helpers =====\nconst cfg = $('Set Workflow Configuration').first().json;\nconst MIN_DROP = Number(cfg.minDropPct ?? 1);\nconst NOW = Date.now(), NOW_ISO = new Date(NOW).toISOString(), DAY = 86400000;\nconst THIS_YEAR = new Date(NOW).getFullYear();\n\n// Helper functions MUST be defined before they are used\nconst clean = (s) => String(s ?? '').replace(/\\s+/g, ' ').trim();\nconst num = (v) => { \n  if (v === null || v === undefined || v === '') return null; \n  if (typeof v === 'number') return isFinite(v) ? v : null; \n  const m = String(v).replace(/\\s/g, '').replace(',', '.').match(/-?\\d+(\\.\\d+)?/); \n  return m ? parseFloat(m[0]) : null; \n};\nconst round = (n, d = 0) => (n == null || isNaN(n)) ? null : Math.round(n * 10 ** d) / 10 ** d;\nconst median = (a) => { \n  if (!a.length) return null; \n  const s = [...a].sort((x, y) => x - y); \n  const m = Math.floor(s.length / 2); \n  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; \n};\nconst compact = (o) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== null && v !== undefined && v !== '' && !(Array.isArray(v) && !v.length)));\n\nconst EPC_RANK = { 'A++': 0, 'A+': 0, 'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5, 'F': 6, 'G': 7 };\nconst NEG_RE = /\\b(aucuns?|sans|pas de|geen|zero|no|without)\\s+(gros\\s+)?(travaux|werken|renovation|work|works)\\b/gi;\nconst RENO_RE = /(à rénover|a renover|à rafraîchir|à moderniser|travaux|bricoleur|état d'origine|te renoveren|te moderniseren|werken nodig|doe-het-zelver|oorspronkelijke staat|renovation project|to renovate|to be renovated|to refresh|needs? (some )?(work|renovation|updating)|fixer[- ]upper|handyman|original state|in need of)/gi;\nconst FRESH_RE = /(entièrement rénové|totalement rénové|récemment rénové|gerenoveerd|volledig vernieuwd|newly renovated|fully renovated|recently renovated|nieuwbouw|new build)/gi;\nconst GENERIC_TITLE = /^(house|huis|maison|apartment|flat|appartement|building|land)$/i;\nconst NO_TRANSLATION = /^sorry,? (there is no english translation|er is geen nederlandse vertaling beschikbaar)\\.?\\s*/i;\n\n// ---- 0. History from Google Sheet (source of truth for dedup + price history) ----\nconst seen = new Map();\nfor (const { json: j } of $input.all()) {\n  const id = clean(j.id);\n  if (!id) continue;\n  seen.set(id, {\n    price: num(j.price), \n    initialPrice: num(j.initial_price),\n    firstSeen: clean(j.first_seen) || NOW_ISO,\n    priceDrops: num(j.price_drops) || 0,\n    lastPriceChange: clean(j.last_price_change),\n    postal: clean(j.postal), \n    bucket: clean(j.bucket), \n    priceM2: num(j.price_m2),\n  });\n}\n\n// ---- 1. Normalize Apify items (Supports both flattened & nested schemas) ----\nconst batch = new Map();\nfor (const { json: r } of $('Run Immoweb Scraper on Apify').all()) {\n  const id = clean(r.id);\n  if (!id || id === 'undefined' || batch.has(id)) continue;\n\n  const P = r.property || {};\n  const T = r.transaction || {};\n  const F = r.flagsAndStatistics?.flags || {};\n  const A = P.location?.address || {};\n  const epcObj = T.certificates?.epc || {};\n\n  const propType = clean(r.property_type || P.type);\n  const propSubtype = clean(r.property_subtype || P.subtype);\n  const typeAll = `${propType} ${propSubtype}`.toLowerCase();\n\n  const bucket = /building|mixed/.test(typeAll) ? 'building'\n    : /apart|flat|studio|duplex|penthouse|loft|ground.?floor/.test(typeAll) ? 'apartment'\n    : /house|villa|bungalow|chalet|mansion|cottage|farm|town|castle|manor/.test(typeAll) ? 'house'\n    : (propType.toLowerCase() || 'other');\n\n  let description = clean(r.property_description || P.description);\n  if (!description) {\n    description = clean(r.property_alternativeDescriptions_fr || P.alternativeDescriptions?.fr) \n               || clean(r.property_alternativeDescriptions_nl || P.alternativeDescriptions?.nl);\n  }\n  description = clean(description.replace(NO_TRANSLATION, ''));\n\n  const street = clean(`${r.property_location_address_street || A.street || ''} ${r.property_location_address_number || A.number || ''}`);\n  const city = clean(r.property_location_address_locality || A.locality);\n  const postal = clean(r.property_location_address_postalCode || A.postalCode) || null;\n  const province = clean(r.property_location_address_province || A.province);\n\n  let title = [\n    r.property_title, P.title,\n    r.property_alternativeTitles_fr, P.alternativeTitles?.fr,\n    r.property_alternativeTitles_nl, P.alternativeTitles?.nl\n  ].map(clean).find(t => t && !GENERIC_TITLE.test(t));\n\n  if (!title) title = clean(`${propSubtype || propType || 'Property'} - ${street}, ${postal || ''} ${city}`.replace(/\\s+,/g, ','));\n\n  const condition = clean(r.property_building_condition || P.building?.condition);\n  const blob = `${title} ${description} ${condition}`.replace(NEG_RE, ' ');\n  const renoHits = [...new Set((blob.match(RENO_RE) || []).map(s => s.toLowerCase()))];\n  const freshHits = [...new Set((blob.match(FRESH_RE) || []).map(s => s.toLowerCase()))];\n  if (/TO_RENOVATE|TO_RESTORE|TO_REFURBISH|TO_BE_DONE_UP/i.test(condition)) renoHits.push(condition.toLowerCase());\n  if (/JUST_RENOVATED|AS_NEW/i.test(condition)) freshHits.push(condition.toLowerCase());\n\n  const rawEpc = r.transaction_certificates_epc_score || epcObj.score;\n  let epc = clean(rawEpc).toUpperCase().replace('_PLUS', '+').replace('PLUS', '+');\n  if (!(epc in EPC_RANK)) epc = null;\n\n  const price = num(r.transaction_sale_price ?? T.sale?.price);\n  const surface = num(r.property_livingDescription_netHabitableSurface ?? P.livingDescription?.netHabitableSurface);\n  const startingPrice = Boolean(r.transaction_sale_hasStartingPrice ?? T.sale?.hasStartingPrice);\n  const publicSale = Boolean(r.flagsAndStatistics_flags_isAPublicSale ?? F.isAPublicSale);\n  const lifeAnnuity = Boolean(r.flagsAndStatistics_flags_isALifeAnnuitySale ?? F.isALifeAnnuitySale);\n  const underOption = Boolean(r.flagsAndStatistics_flags_isUnderOption ?? F.isUnderOption);\n  const special = startingPrice || publicSale || lifeAnnuity;\n\n  const rawCreationDate = r.publication_creationDate || r.publication?.creationDate;\n  const created = rawCreationDate ? new Date(rawCreationDate) : null;\n\n  const picItems = r.media_pictures_items || r.media?.pictures?.items || [];\n  const picBaseUrl = r.media_pictures_baseUrl || r.media?.pictures?.baseUrl || '';\n  const pic0 = picItems[0]?.relativeUrl?.large || picItems[0]?.relativeUrl?.medium;\n\n  const constructionYear = num(r.property_building_constructionYear ?? P.building?.constructionYear);\n  const renoObligationRaw = r.transaction_certificates_epc_renovationObligation ?? epcObj.renovationObligation;\n  const epcRenovationObligation = typeof renoObligationRaw === 'boolean' ? renoObligationRaw : null;\n\n  batch.set(id, {\n    id, \n    url: r.SEOUrl || r.url || `https://www.immoweb.be/en/classified/${id}`,\n    title, \n    type: propType, \n    subtype: propSubtype, \n    bucket,\n    price, \n    surface, \n    landSurface: num(r.property_land_surface ?? P.land?.surface), \n    gardenSurface: num(r.property_outdoor_garden_surface ?? P.outdoor?.garden?.surface),\n    bedrooms: num(r.property_bedroom_count ?? P.bedroom?.count), \n    postal, \n    city, \n    province,\n    constructionYear, \n    age: constructionYear ? THIS_YEAR - constructionYear : null,\n    condition: condition || null, \n    epc, \n    epcKwhM2: num(r.transaction_certificates_primaryEnergyConsumption_perSqm ?? T.certificates?.primaryEnergyConsumption?.perSqm),\n    epcRenovationObligation,\n    heating: clean(r.property_energy_heatingType ?? P.energy?.heatingType) || null, \n    solar: (r.property_energy_hasPhotovoltaicPanels ?? P.energy?.hasPhotovoltaicPanels) ?? null,\n    facades: num(r.property_building_facadeCount ?? P.building?.facadeCount), \n    parking: num(r.property_parking_parkingSpaceCount_total ?? P.parking?.parkingSpaceCount?.total),\n    floodZone: clean(r.property_constructionPermit_floodZoneType ?? P.constructionPermit?.floodZoneType) || null, \n    cadastralIncome: num(r.transaction_sale_cadastralIncome ?? T.sale?.cadastralIncome),\n    startingPrice, \n    publicSale, \n    lifeAnnuity, \n    underOption, \n    special,\n    agency: clean(r.customers?.[0]?.publicInfo?.name) || null,\n    daysOnline: created && !isNaN(created) ? Math.max(0, Math.floor((NOW - created.getTime()) / DAY)) : null,\n    renovationIndicators: renoHits, \n    recentRenovationIndicators: freshHits,\n    description: description.slice(0, 1200),\n    image: pic0 ? `${picBaseUrl}${pic0}` : null,\n  });\n}\nconst props = [...batch.values()];\n\n// ---- 2. Carry price from history if scrape lost it; compute EUR/m2 ----\nfor (const p of props) {\n  const prev = seen.get(p.id);\n  if (p.price == null && prev?.price != null) p.price = prev.price;\n  p.priceM2 = p.price && p.surface && p.surface > 0 ? round(p.price / p.surface) : null;\n  p.compEligible = !p.special && !!p.priceM2 && p.priceM2 >= 300 && p.priceM2 <= 20000 && p.bucket !== 'other';\n}\n\n// ---- 3. Comparables pool = sheet history + current batch ----\nconst pool = new Map();\nfor (const [id, h] of seen) {\n  if (h.priceM2 && h.postal && h.bucket) pool.set(id, { postal: h.postal, bucket: h.bucket, priceM2: h.priceM2 });\n}\nfor (const p of props) { \n  if (p.compEligible && p.postal) pool.set(p.id, { postal: p.postal, bucket: p.bucket, priceM2: p.priceM2 }); \n  else pool.delete(p.id); \n}\nconst poolArr = [...pool.entries()];\n\nconst TIERS = [\n  { name: 'same postcode', min: 5, f: (p, x) => x.postal === p.postal && x.bucket === p.bucket },\n  { name: 'same region (postcode prefix)', min: 8, f: (p, x) => x.postal.slice(0, 2) === p.postal.slice(0, 2) && x.bucket === p.bucket },\n  { name: 'whole search', min: 12, f: (p, x) => x.bucket === p.bucket },\n];\n\nconst comps = (p) => {\n  if (!p.postal) return { median: null, n: 0, scope: 'none' };\n  for (const t of TIERS) {\n    const g = poolArr.filter(([id, x]) => id !== p.id && t.f(p, x)).map(([, x]) => x.priceM2);\n    if (g.length >= t.min) return { median: round(median(g)), n: g.length, scope: t.name };\n  }\n  return { median: null, n: 0, scope: 'none' };\n};\n\n// ---- 4. Anomalies, price history, pre-score, dedup against sheet ----\nconst out = [];\nfor (const p of props) {\n  const c = comps(p);\n  p.compMedianM2 = c.median; \n  p.compCount = c.n; \n  p.compScope = c.scope;\n  p.discountVsMedianPct = c.median && p.compEligible ? round((c.median - p.priceM2) / c.median * 100, 1) : null;\n\n  const f = [];\n  if (!p.price) f.push('missing price');\n  if (!p.surface) f.push('missing living surface');\n  if (p.surface && p.surface < 15) f.push('tiny surface (<15 m²)');\n  if (p.surface && p.surface > 600) f.push('huge surface (>600 m²) - check data');\n  if (p.priceM2 && p.priceM2 < 300) f.push('suspiciously low €/m²');\n  if (p.discountVsMedianPct != null && p.discountVsMedianPct > 50) f.push('€/m² under 50% of comps (too good to be true?)');\n  if (p.discountVsMedianPct != null && p.discountVsMedianPct < -50) f.push('€/m² over 150% of comps');\n  if (p.bedrooms > 0 && p.surface && p.surface / p.bedrooms < 14) f.push('very small surface per bedroom');\n  if (p.bedrooms > 0 && p.surface && p.surface / p.bedrooms > 90) f.push('very large surface per bedroom');\n  if (p.startingPrice) f.push('starting/bid price - not a market price');\n  if (p.publicSale) f.push('public sale / auction');\n  if (p.lifeAnnuity) f.push('life annuity sale - price not comparable');\n  if (p.underOption) f.push('under option');\n  if (p.epcRenovationObligation) f.push('EPC renovation obligation');\n  if (p.floodZone && !/^NON_FLOOD/i.test(p.floodZone)) f.push(`flood zone: ${p.floodZone}`);\n  p.anomalies = f;\n\n  const prev = seen.get(p.id);\n  p.isNew = !prev;\n  p.previousPrice = prev ? prev.price : null;\n  p.changed = !!prev && p.price != null && prev.price != null && p.price !== prev.price;\n  p.priceDropPct = p.changed && p.price < prev.price ? round((prev.price - p.price) / prev.price * 100, 1) : 0;\n  p.priceRisePct = p.changed && p.price > prev.price ? round((p.price - prev.price) / prev.price * 100, 1) : 0;\n  p.initialPrice = prev ? (prev.initialPrice ?? prev.price ?? p.price) : p.price;\n  p.totalDropPct = p.initialPrice && p.price && p.price < p.initialPrice ? round((p.initialPrice - p.price) / p.initialPrice * 100, 1) : 0;\n  p.firstSeen = prev ? prev.firstSeen : NOW_ISO;\n  p.priceDrops = (prev ? prev.priceDrops : 0) + (p.priceDropPct > 0 ? 1 : 0);\n  p.lastPriceChange = p.changed ? NOW_ISO : (prev ? prev.lastPriceChange : '');\n  if (p.daysOnline == null) p.daysOnline = Math.floor((NOW - new Date(p.firstSeen).getTime()) / DAY);\n\n  // Heuristic score\n  let s = 50;\n  if (p.discountVsMedianPct != null) s += Math.max(-30, Math.min(30, p.discountVsMedianPct));\n  if (p.epc) s += ({ 0: 6, 1: 6, 2: 4, 3: 0, 4: -3, 5: -6, 6: -12, 7: -12 })[EPC_RANK[p.epc]];\n  if (p.age != null) s += p.age > 60 ? -5 : p.age < 15 ? 5 : 0;\n  if (p.renovationIndicators.length) s -= 6;\n  if (p.totalDropPct) s += Math.min(8, p.totalDropPct);\n  s -= f.length * 4;\n  p.preScore = Math.max(0, Math.min(100, Math.round(s)));\n\n  p.aiPayload = compact({\n    title: p.title, \n    type: p.subtype || p.type, \n    price: p.price,\n    startingOrBidPrice: p.startingPrice, \n    publicSale: p.publicSale, \n    lifeAnnuity: p.lifeAnnuity, \n    underOption: p.underOption,\n    livingSurfaceM2: p.surface, \n    landM2: p.landSurface, \n    gardenM2: p.gardenSurface, \n    eurPerM2: p.priceM2, \n    bedrooms: p.bedrooms,\n    postal: p.postal, \n    city: p.city, \n    province: p.province,\n    constructionYear: p.constructionYear, \n    ageYears: p.age, \n    buildingCondition: p.condition,\n    epc: p.epc, \n    epcKwhPerM2: p.epcKwhM2, \n    epcRenovationObligation: p.epcRenovationObligation,\n    heating: p.heating, \n    solarPanels: p.solar, \n    facades: p.facades, \n    parkingSpaces: p.parking, \n    floodZone: p.floodZone, \n    cadastralIncome: p.cadastralIncome,\n    compMedianEurPerM2: p.compMedianM2, \n    compCount: p.compCount, \n    compScope: p.compScope, \n    discountVsCompsPct: p.discountVsMedianPct,\n    daysOnline: p.daysOnline, \n    isNewListing: p.isNew, \n    priceDropPct: p.priceDropPct, \n    priceRisePct: p.priceRisePct, \n    totalDropPct: p.totalDropPct, \n    previousPrice: p.previousPrice,\n    renovationHints: p.renovationIndicators, \n    recentRenovationHints: p.recentRenovationIndicators,\n    dataAnomalies: p.anomalies, \n    heuristicScore: p.preScore, \n    description: p.description,\n  });\n\n  if (p.isNew || p.changed) out.push(p);\n}\n\nreturn out.map(p => ({ json: p }));"},"typeVersion":2},{"id":"031dee32-f107-45e0-b980-d59b816a1617","name":"Generate Property Deal Verdict","type":"@n8n/n8n-nodes-langchain.chainLlm","onError":"continueRegularOutput","maxTries":3,"position":[1376,112],"parameters":{"text":"=Evaluate this listing:\n{{ JSON.stringify($json, null, 1) }}","messages":{"messageValues":[{"message":"You are a skeptical Belgian real-estate analyst. You judge whether a listing is a good BUY for a private buyer / investor.\nYou get pre-computed metrics as JSON (null/empty fields were omitted because the source had no data). Trust the numbers; never invent facts that are not in the data.\n\nRubric:\n- BUY: clearly below comparable EUR/m2 (roughly >=8% cheaper) AND no serious red flag; OR a significant verified price reduction on an otherwise sound property. NEVER output BUY when compCount is 0 or missing.\n- MAYBE: fairly priced or cheaper but with trade-offs (poor EPC, renovation needed, thin comp data, missing fields) that a buyer could price in.\n- AVOID: overpriced vs comps, major red flags, suspicious/inconsistent data, or EPC F/G combined with a high price.\n\nConsider: EUR/m2 vs comps (and comp reliability: compCount/compScope), EPC (F/G = costly renovation obligations in Belgium; epcRenovationObligation=true is a hard cost), building age and condition, renovation hints in the text, days online (long = negotiation leverage OR hidden problem), price drops, data anomalies.\nSpecial cases: startingOrBidPrice / publicSale means the shown price is a floor or auction start, NOT a market price - do not compare it to comps as if final. lifeAnnuity prices are not comparable. A missing field is a data gap to flag, not proof of a bad property.\nBe concise. Reasons and red flags: max ~12 words each, max 4 each. Answer in English."}]},"promptType":"define","hasOutputParser":true},"retryOnFail":true,"typeVersion":1.5,"waitBetweenTries":3000},{"id":"0e11e649-b907-4891-b352-dcdefc4a5362","name":"Google Gemini Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatGoogleGemini","position":[1312,336],"parameters":{"options":{"temperature":0.2},"modelName":"models/gemini-3.1-flash-lite"},"credentials":{"googlePalmApi":{"id":"credential-id","name":"STRICTLY USE GEMINI-3.1-FLASH-LITE"}},"typeVersion":1},{"id":"980bcaaa-8640-44ec-9548-f9ff9d28f21d","name":"Parse Structured Verdict","type":"@n8n/n8n-nodes-langchain.outputParserStructured","position":[1536,352],"parameters":{"schemaType":"manual","inputSchema":"{\n  \"type\": \"object\",\n  \"properties\": {\n    \"verdict\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"BUY\",\n        \"MAYBE\",\n        \"AVOID\"\n      ]\n    },\n    \"score\": {\n      \"type\": \"number\",\n      \"description\": \"0-100 deal quality\"\n    },\n    \"one_liner\": {\n      \"type\": \"string\"\n    },\n    \"reasons\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"red_flags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"negotiation_tip\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"verdict\",\n    \"score\",\n    \"one_liner\",\n    \"reasons\",\n    \"red_flags\"\n  ]\n}"},"typeVersion":1.2},{"id":"1ced6fec-28d2-4af4-97b1-f436bb424ffb","name":"Attach Verdict to Property","type":"n8n-nodes-base.code","position":[1728,112],"parameters":{"jsCode":"// Merge Gemini verdict back onto the original property.\n// Build the Sheet row + Slack/Email messages.\n// Failed AI calls are dropped so they can be retried on the next run.\n\nconst cfg = $('Set Workflow Configuration').first().json;\nconst MIN_DROP = Number(cfg.minDropPct ?? 1);\n\nconst base = $('Deduplicate and Prepare Listings').all();\nconst NOW_ISO = new Date().toISOString();\n\nconst esc = (s) =>\n  String(s ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n\nconst eur = (n) =>\n  n == null || n === ''\n    ? 'n/a'\n    : '€' + Math.round(Number(n)).toLocaleString('en-US');\n\nconst VALID = ['BUY', 'MAYBE', 'AVOID'];\n\nconst out = [];\n\n$input.all().forEach((it, i) => {\n\n  // Recover the original property item.\n  const pi = Array.isArray(it.pairedItem)\n    ? it.pairedItem[0]\n    : it.pairedItem;\n\n  const idx =\n    typeof pi === 'number'\n      ? pi\n      : pi && typeof pi.item === 'number'\n        ? pi.item\n        : i;\n\n  const p = base[idx]?.json;\n\n  // Structured Output from Gemini.\n  const v = it.json.output;\n\n  if (!p || !v) return;\n\n  let verdict = String(v.verdict ?? '').toUpperCase();\n\n  if (!VALID.includes(verdict)) return;\n\n  // Never allow BUY when there are no comparable properties.\n  if (Number(p.compCount ?? 0) === 0 && verdict === 'BUY') {\n    verdict = 'MAYBE';\n  }\n\n  const score = Math.max(\n    0,\n    Math.min(\n      100,\n      Math.round(Number(v.score ?? p.preScore ?? 0))\n    )\n  );\n\n  const icon =\n    verdict === 'BUY'\n      ? '🟢'\n      : verdict === 'MAYBE'\n        ? '🟡'\n        : '🔴';\n\n  const tag =\n    p.isNew\n      ? '🆕 NEW'\n      : Number(p.priceDropPct ?? 0) > 0\n        ? `📉 PRICE DROP -${p.priceDropPct}% (was ${eur(p.previousPrice)})`\n        : Number(p.priceRisePct ?? 0) > 0\n          ? `📈 PRICE UP +${p.priceRisePct}%`\n          : '📊 MONITORED';\n\n  const alert =\n    verdict !== 'AVOID' &&\n    (\n      p.isNew === true ||\n      Number(p.priceDropPct ?? 0) >= MIN_DROP\n    );\n\n  const compLine =\n    p.compMedianM2 != null &&\n    p.discountVsMedianPct != null\n      ? `📊 Comps ${eur(p.compMedianM2)}/m² (${p.compScope || 'unknown'}, n=${p.compCount ?? 0}) → ` +\n        (\n          Number(p.discountVsMedianPct) > 0\n            ? `${p.discountVsMedianPct}% cheaper`\n            : `${Math.abs(Number(p.discountVsMedianPct))}% pricier`\n        )\n      : null;\n\n  const lines = [\n    `${icon} <b>${verdict}</b> (${score}/100) - ${tag}`,\n\n    `<b>${esc(p.title || 'Untitled property')}</b>`,\n\n    `📍 ${esc(p.postal || '')} ${esc(p.city || '')}` +\n      `${p.province ? ' (' + esc(p.province) + ')' : ''}`,\n\n    `💶 ${eur(p.price)}` +\n      `${p.startingPrice || p.publicSale ? ' (starting/bid price)' : ''}` +\n      ` | ${p.surface ?? '?'} m²` +\n      ` | ${p.priceM2 != null ? eur(p.priceM2) + '/m²' : 'n/a'}`,\n\n    compLine,\n\n    `🛏 ${p.bedrooms ?? '?'} bed` +\n      ` | ⚡ EPC ${p.epc || '?'}` +\n      ` | 🏗 ${p.constructionYear || '?'}` +\n      ` | ⏱ ${p.daysOnline ?? 0}d online`,\n\n    p.renovationIndicators?.length\n      ? `🔨 Reno hints: ${esc(p.renovationIndicators.join(', '))}`\n      : null,\n\n    p.epcRenovationObligation === true\n      ? '⚠️ EPC renovation obligation applies'\n      : null,\n\n    p.anomalies?.length\n      ? `⚠️ Data anomalies: ${esc(p.anomalies.join(', '))}`\n      : null,\n\n    '',\n\n    `💬 ${esc(v.one_liner || '')}`,\n\n    ...(Array.isArray(v.reasons)\n      ? v.reasons.slice(0, 4).map(x => '✅ ' + esc(x))\n      : []),\n\n    ...(Array.isArray(v.red_flags)\n      ? v.red_flags.slice(0, 4).map(x => '⚠️ ' + esc(x))\n      : []),\n\n    v.negotiation_tip\n      ? `🤝 ${esc(v.negotiation_tip)}`\n      : null,\n\n  ].filter(x => x !== null);\n\n  // Slack mrkdwn version.\n  const slackText =\n    lines\n      .map(l =>\n        l\n          .replace(/<b>/g, '*')\n          .replace(/<\\/b>/g, '*')\n      )\n      .join('\\n') +\n    `\\n<${p.url}|Open on Immoweb>`;\n\n  // Email HTML version.\n  const emailHtml =\n    '<div style=\"font-family:Arial,sans-serif;max-width:640px;line-height:1.5\">' +\n    lines\n      .map(l => l === '' ? '<br>' : `<div>${l}</div>`)\n      .join('') +\n    `<br><a href=\"${esc(p.url)}\">Open on Immoweb</a>` +\n    (\n      p.image\n        ? `<br><img src=\"${esc(p.image)}\" style=\"max-width:100%;border-radius:8px\">`\n        : ''\n    ) +\n    '</div>';\n\n  const sheet = {\n    id: p.id,\n    url: p.url,\n    title: p.title,\n    bucket: p.bucket,\n\n    postal: p.postal || '',\n    city: p.city || '',\n    province: p.province || '',\n\n    price: p.price ?? '',\n    initial_price: p.initialPrice ?? '',\n    surface: p.surface ?? '',\n\n    price_m2:\n      p.compEligible && p.priceM2 != null\n        ? p.priceM2\n        : '',\n\n    bedrooms: p.bedrooms ?? '',\n    epc: p.epc || '',\n\n    construction_year:\n      p.constructionYear ?? '',\n\n    first_seen:\n      p.firstSeen || NOW_ISO,\n\n    last_seen:\n      NOW_ISO,\n\n    last_price_change:\n      p.lastPriceChange || '',\n\n    price_drops:\n      p.priceDrops ?? 0,\n\n    verdict,\n    score,\n\n    one_liner:\n      String(v.one_liner || '').slice(0, 300),\n\n    alerted:\n      alert ? 'yes' : 'no',\n  };\n\n  out.push({\n    json: {\n      id: p.id,\n      verdict,\n      score,\n      alert,\n      slackText,\n      emailHtml,\n      emailSubject:\n        `${icon} ${verdict}: ${p.title || 'Property'} - ${eur(p.price)}`,\n      sheet,\n    },\n\n    // Keep pairing with the original item.\n    pairedItem: {\n      item: idx,\n    },\n  });\n});\n\nreturn out;"},"typeVersion":2},{"id":"69ea5814-6597-4122-9515-9d5576391ec0","name":"Upsert Properties in Sheets","type":"n8n-nodes-base.googleSheets","maxTries":3,"position":[1952,112],"parameters":{"columns":{"value":{"id":"={{ $json.sheet.id }}","epc":"={{ $json.sheet.epc }}","url":"={{ $json.sheet.url }}","city":"={{ $json.sheet.city }}","price":"={{ $json.sheet.price }}","score":"={{ $json.sheet.score }}","title":"={{ $json.sheet.title }}","bucket":"={{ $json.sheet.bucket }}","postal":"={{ $json.sheet.postal }}","alerted":"={{ $json.sheet.alerted }}","surface":"={{ $json.sheet.surface }}","verdict":"={{ $json.sheet.verdict }}","bedrooms":"={{ $json.sheet.bedrooms }}","price_m2":"={{ $json.sheet.price_m2 }}","province":"={{ $json.sheet.province }}","last_seen":"={{ $json.sheet.last_seen }}","one_liner":"={{ $json.sheet.one_liner }}","first_seen":"={{ $json.sheet.first_seen }}","price_drops":"={{ $json.sheet.price_drops }}","initial_price":"={{ $json.sheet.initial_price }}","construction_year":"={{ $json.sheet.construction_year }}","last_price_change":"={{ $json.sheet.last_price_change }}"},"schema":[{"id":"id","type":"string","display":true,"required":false,"displayName":"id","defaultMatch":true,"canBeUsedToMatch":true},{"id":"url","type":"string","display":true,"required":false,"displayName":"url","defaultMatch":false,"canBeUsedToMatch":true},{"id":"title","type":"string","display":true,"required":false,"displayName":"title","defaultMatch":false,"canBeUsedToMatch":true},{"id":"bucket","type":"string","display":true,"required":false,"displayName":"bucket","defaultMatch":false,"canBeUsedToMatch":true},{"id":"postal","type":"string","display":true,"required":false,"displayName":"postal","defaultMatch":false,"canBeUsedToMatch":true},{"id":"city","type":"string","display":true,"required":false,"displayName":"city","defaultMatch":false,"canBeUsedToMatch":true},{"id":"province","type":"string","display":true,"required":false,"displayName":"province","defaultMatch":false,"canBeUsedToMatch":true},{"id":"price","type":"string","display":true,"required":false,"displayName":"price","defaultMatch":false,"canBeUsedToMatch":true},{"id":"initial_price","type":"string","display":true,"required":false,"displayName":"initial_price","defaultMatch":false,"canBeUsedToMatch":true},{"id":"surface","type":"string","display":true,"required":false,"displayName":"surface","defaultMatch":false,"canBeUsedToMatch":true},{"id":"price_m2","type":"string","display":true,"required":false,"displayName":"price_m2","defaultMatch":false,"canBeUsedToMatch":true},{"id":"bedrooms","type":"string","display":true,"required":false,"displayName":"bedrooms","defaultMatch":false,"canBeUsedToMatch":true},{"id":"epc","type":"string","display":true,"required":false,"displayName":"epc","defaultMatch":false,"canBeUsedToMatch":true},{"id":"construction_year","type":"string","display":true,"required":false,"displayName":"construction_year","defaultMatch":false,"canBeUsedToMatch":true},{"id":"first_seen","type":"string","display":true,"required":false,"displayName":"first_seen","defaultMatch":false,"canBeUsedToMatch":true},{"id":"last_seen","type":"string","display":true,"required":false,"displayName":"last_seen","defaultMatch":false,"canBeUsedToMatch":true},{"id":"last_price_change","type":"string","display":true,"required":false,"displayName":"last_price_change","defaultMatch":false,"canBeUsedToMatch":true},{"id":"price_drops","type":"string","display":true,"required":false,"displayName":"price_drops","defaultMatch":false,"canBeUsedToMatch":true},{"id":"verdict","type":"string","display":true,"required":false,"displayName":"verdict","defaultMatch":false,"canBeUsedToMatch":true},{"id":"score","type":"string","display":true,"required":false,"displayName":"score","defaultMatch":false,"canBeUsedToMatch":true},{"id":"one_liner","type":"string","display":true,"required":false,"displayName":"one_liner","defaultMatch":false,"canBeUsedToMatch":true},{"id":"alerted","type":"string","display":true,"required":false,"displayName":"alerted","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":["id"],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{"cellFormat":"RAW"},"operation":"appendOrUpdate","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Set Workflow Configuration').first().json.sheetName }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Set Workflow Configuration').first().json.sheetId }}"},"authentication":"serviceAccount"},"credentials":{"googleApi":{"id":"credential-id","name":"Google Service Account account"}},"retryOnFail":true,"typeVersion":4.5,"waitBetweenTries":3000},{"id":"a1e65ed6-d35e-4729-a425-9ab3c82bba4c","name":"If Deal Alert Triggered","type":"n8n-nodes-base.if","position":[2176,112],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"if1","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $('Attach Verdict to Property').item.json.alert }}","rightValue":""}]}},"typeVersion":2.2},{"id":"50e5f600-bc5d-4ce0-a704-0f3b1703d26e","name":"Send Deal Alert to Slack","type":"n8n-nodes-base.slack","maxTries":3,"position":[2400,96],"webhookId":"63188c39-cc21-46ea-8a7c-27566e96dfd6","parameters":{"text":"={{ $('Attach Verdict to Property').item.json.slackText }}","select":"channel","channelId":{"__rl":true,"mode":"name","value":"={{ $('Set Workflow Configuration').item.json.slackChannelName }}"},"otherOptions":{"mrkdwn":true}},"credentials":{"slackApi":{"id":"credential-id","name":"Slack account 2"}},"retryOnFail":true,"typeVersion":2.3,"waitBetweenTries":2000},{"id":"35ea6a77-bb66-46aa-a575-7559d92b38be","name":"Take Top 10 Properties","type":"n8n-nodes-base.limit","position":[1088,112],"parameters":{},"typeVersion":1},{"id":"4398d124-4944-4530-8a1e-b7c0acc519ac","name":"Run Immoweb Scraper on Apify","type":"n8n-nodes-base.httpRequest","onError":"continueErrorOutput","maxTries":2,"position":[192,128],"parameters":{"url":"https://api.apify.com/v2/acts/7hrExNTiDRs0nPUXh/run-sync-get-dataset-items","method":"POST","options":{"timeout":330000},"jsonBody":"={{ JSON.stringify({ startUrl: $json.searchUrl, startUrls: [{ url: $json.searchUrl }], maxItems: $json.maxItems }) }}","sendBody":true,"sendQuery":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","queryParameters":{"parameters":[{"name":"timeout","value":"280"},{"name":"clean","value":"true"},{"name":"format","value":"json"}]}},"credentials":{"httpHeaderAuth":{"id":"credential-id","name":"Apify"}},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":10000}],"active":true,"pinData":{},"settings":{"binaryMode":"separate","executionOrder":"v1"},"versionId":"084e2eb5-0e7c-420e-a486-8281e4331781","nodeGroups":[],"connections":{"Every Morning at 7 AM":{"main":[[{"node":"Set Workflow Configuration","type":"main","index":0}]]},"Take Top 10 Properties":{"main":[[{"node":"Generate Property Deal Verdict","type":"main","index":0}]]},"If Deal Alert Triggered":{"main":[[{"node":"Send Deal Alert to Slack","type":"main","index":0}]]},"When Manually Triggered":{"main":[[{"node":"Set Workflow Configuration","type":"main","index":0}]]},"Google Gemini Chat Model":{"ai_languageModel":[[{"node":"Generate Property Deal Verdict","type":"ai_languageModel","index":0}]]},"Parse Structured Verdict":{"ai_outputParser":[[{"node":"Generate Property Deal Verdict","type":"ai_outputParser","index":0}]]},"Attach Verdict to Property":{"main":[[{"node":"Upsert Properties in Sheets","type":"main","index":0}]]},"Set Workflow Configuration":{"main":[[{"node":"Run Immoweb Scraper on Apify","type":"main","index":0}]]},"Upsert Properties in Sheets":{"main":[[{"node":"If Deal Alert Triggered","type":"main","index":0}]]},"Run Immoweb Scraper on Apify":{"main":[[{"node":"Read Saved Listings in Sheets","type":"main","index":0}],[{"node":"Send Scrape Error to Slack","type":"main","index":0}]]},"Read Saved Listings in Sheets":{"main":[[{"node":"Deduplicate and Prepare Listings","type":"main","index":0}]]},"Generate Property Deal Verdict":{"main":[[{"node":"Attach Verdict to Property","type":"main","index":0}]]},"Deduplicate and Prepare Listings":{"main":[[{"node":"Take Top 10 Properties","type":"main","index":0}]]}}}