{"id":"sKwJ55n2fDVCQVcB","meta":{"instanceId":"8443f10082278c46aa5cf3acf8ff0f70061a2c58bce76efac814b16290845177","templateCredsSetupCompleted":true},"name":"ONDC Seller Catalog Sync – Google Sheets to Seller App with AI Attribute Clean-up & Error Reporting","tags":[],"nodes":[{"id":"881aca99-4ea7-423c-83d5-902b5491d251","name":"Sticky Note – Overview","type":"n8n-nodes-base.stickyNote","position":[-2688,-1072],"parameters":{"color":2,"width":880,"height":820,"content":"## 🛒 ONDC Seller Catalog Sync – Google Sheets to Seller App\n\nFor small Indian sellers on ONDC who keep their catalog in a spreadsheet and lose hours to rejected listings, messy titles and prices that drift between the sheet and what buyers actually see.\n\n### How it works\nEvery 30 minutes (or on demand) the workflow compares your catalog sheet with the live catalog in your seller app and picks out only the SKUs that changed. GPT-4o-mini tidies titles, descriptions and attributes for new or edited rows, and image links are checked before upload. Each row is validated against ONDC retail rules, then valid items are pushed to the seller app in batches. Large price jumps are held until someone ticks `price_confirmed` in the sheet.\n\nResults are written back to the sheet, rejected SKUs are logged with the reason and an AI-suggested fix, and you get an email summary when something needs attention.\n\n### Setup steps\n1. Create a Google Sheet with **Catalog** and **Sync Errors** tabs.\n2. Connect Google Sheets, Gmail and OpenAI.\n3. Add your seller app API key as Header Auth on both seller app nodes.\n4. Fill in **Set Catalog Config**: sheet ID, API base URL and paths, provider and location IDs, consumer care details and report email.\n5. Set `ai_apply_mode` to `suggest` if you'd rather review AI clean-ups in the sheet before they go live. Run once manually, then activate."},"typeVersion":1},{"id":"28dcbdc6-8889-4005-b010-cdb04849c5bc","name":"Sticky Note – Change Detection & AI Clean-up","type":"n8n-nodes-base.stickyNote","position":[-576,-1056],"parameters":{"color":7,"width":1328,"height":848,"content":"## 🧹 Change Detection & AI Clean-up\nOnly SKUs that changed since the last sync move forward. Big price jumps are held until someone confirms them. New or edited content gets AI-cleaned titles, descriptions and attributes, so you only pay for rows that need it."},"typeVersion":1},{"id":"fcd493e6-1af7-48ad-b645-68b11f5b0af0","name":"Sticky Note – Image Check","type":"n8n-nodes-base.stickyNote","position":[800,-1056],"parameters":{"color":7,"width":992,"height":848,"content":"## 🖼️ Image Check\nSends a quick HEAD request to each new image URL to catch broken links, wrong file types and oversized files before the seller app rejects them."},"typeVersion":1},{"id":"4c5f1efb-bc6b-44ae-9f40-38e133c81aa7","name":"Sticky Note – Validate & Push","type":"n8n-nodes-base.stickyNote","position":[1824,-1056],"parameters":{"color":7,"width":1120,"height":848,"content":"## 🚀 Validate & Push\nChecks every row against ONDC retail rules such as unit, MRP, returns and veg/non-veg, then pushes valid items to the seller app in batches. Failures are kept for the report."},"typeVersion":1},{"id":"ea0f8fda-f0f1-4528-a5c4-329c9ce4c623","name":"Sticky Note – Write-back & Error Log","type":"n8n-nodes-base.stickyNote","position":[3040,-1296],"parameters":{"color":7,"width":784,"height":624,"content":"## 🗂️ Write-back & Error Log\nSync status and timestamps go back to the catalog sheet, and every rejected SKU is logged with the reason."},"typeVersion":1},{"id":"50e56c07-8a69-47ae-a4f3-3e9ad6746eec","name":"Sticky Note – Report & AI Fixes","type":"n8n-nodes-base.stickyNote","position":[3072,-560],"parameters":{"color":7,"width":976,"height":576,"content":"## 📬 Report & AI Fixes\nEmails a run summary when something needs attention. For failed rows, the AI suggests the exact fix so your catalog team isn't left guessing."},"typeVersion":1},{"id":"c4d93b43-444e-46f2-8451-028862f000e0","name":"Sticky Note – Credentials & Security","type":"n8n-nodes-base.stickyNote","position":[4160,-368],"parameters":{"color":3,"width":480,"height":320,"content":"## 🔐 Credentials & Security\nKeep the seller app API key in Header Auth, never in the URL or config. Connect Google Sheets and Gmail with OAuth2 and OpenAI with an API key. Keep the sync webhook URL private."},"typeVersion":1},{"id":"f9e8da18-03c6-4eb9-968b-2460d9528a46","name":"Sync Every 30 Minutes","type":"n8n-nodes-base.scheduleTrigger","position":[-1520,-784],"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":30}]}},"typeVersion":1.2},{"id":"d1c2cbaa-fdd3-44c4-a8cd-da0014219ae2","name":"Sync Now via Webhook","type":"n8n-nodes-base.webhook","position":[-1520,-560],"webhookId":"45586abd-e548-4740-948f-de2cecfa86cd","parameters":{"path":"ondc-catalog-sync","options":{},"httpMethod":"POST"},"typeVersion":2},{"id":"16f9c4b3-140d-41cd-940b-40400369df0b","name":"Set Catalog Config","type":"n8n-nodes-base.set","position":[-1280,-672],"parameters":{"options":{},"assignments":{"assignments":[{"id":"adb608c3-1f71-4cab-a569-50453b9780d2","name":"seller_name","type":"string","value":"Your Store"},{"id":"214cf350-c3c8-4d96-bc29-cec3b3edcf3e","name":"sheet_id","type":"string","value":"YOUR_GOOGLE_SHEET_ID"},{"id":"baad0cd3-5659-48d5-a2a2-4f40473c2f86","name":"catalog_sheet","type":"string","value":"Catalog"},{"id":"74bb606c-0890-47e8-a7de-c689d411142c","name":"errors_sheet","type":"string","value":"Sync Errors"},{"id":"2e45e504-0e36-40fd-bd64-48eff742b9f8","name":"seller_api_base","type":"string","value":"https://api.your-seller-app.com"},{"id":"7c31ef27-eb16-4c0c-9c06-4ab9fd28fcb2","name":"upsert_path","type":"string","value":"/v1/ondc/catalog/items"},{"id":"5cd33af6-5554-4471-bfea-a26cc8a23265","name":"inventory_path","type":"string","value":"/v1/ondc/catalog/inventory"},{"id":"11649fe6-97f2-4773-a011-fce8ac647dfc","name":"provider_id","type":"string","value":"YOUR_PROVIDER_ID"},{"id":"15a2ab0a-c3fa-4e3c-a233-eb36137bb292","name":"location_id","type":"string","value":"YOUR_LOCATION_ID"},{"id":"8ae9ea24-3bdd-4b2a-9999-b035b3279d90","name":"fulfillment_id","type":"string","value":"1"},{"id":"5f4dfc40-adf7-4e0c-925e-d749778cc9ca","name":"consumer_care","type":"string","value":"Your Store,support@example.com,9+1234567890"},{"id":"89c27dc5-89b2-4b67-867f-e7fa112c3777","name":"default_country","type":"string","value":"IND"},{"id":"93e61b45-bd6e-4d75-89a6-df84ff4d2b40","name":"default_time_to_ship_hours","type":"number","value":24},{"id":"0613bca0-b92e-44b9-af75-ef2ea11c2a45","name":"default_return_window_days","type":"number","value":7},{"id":"a12dfc8b-a21e-4ee9-8a42-bf6ab6961f60","name":"max_discount_pct","type":"number","value":90},{"id":"e42b716b-1694-48a2-a1e2-da9eb2bf5d60","name":"batch_size","type":"number","value":50},{"id":"b2bb465c-3d23-47b3-b68a-7abbeefe5037","name":"catalog_list_path","type":"string","value":"/v1/ondc/catalog/items?limit=1000"},{"id":"512418c1-f0bb-44c8-8acb-96f2ac117d2a","name":"reconcile_enabled","type":"string","value":"true"},{"id":"b726551f-94eb-4bbe-a0e4-767f71ee02be","name":"orphan_action","type":"string","value":"report"},{"id":"62ed6e75-4035-40f9-b7ed-65d96fd4e609","name":"price_guard_pct","type":"number","value":30},{"id":"fbff02d3-efc5-4925-9d5f-17b22a2de7a3","name":"low_stock_threshold","type":"number","value":5},{"id":"c1c65224-971c-4076-832f-2b023b56715b","name":"image_check_enabled","type":"string","value":"true"},{"id":"80887336-b8fa-4013-a150-20ee2c8311eb","name":"max_image_checks","type":"number","value":150},{"id":"10f66e58-ac4d-409f-9a70-6facec581f64","name":"max_image_mb","type":"number","value":5},{"id":"5c57ca0a-63df-44a3-9015-017a73bb3015","name":"ai_fix_limit","type":"number","value":20},{"id":"38d63574-e2e2-472f-ba4d-065b02654048","name":"ai_enabled","type":"string","value":"true"},{"id":"9af8b351-a800-4e08-b80a-406ebe2de6a7","name":"ai_apply_mode","type":"string","value":"auto"},{"id":"08f4c109-ff91-4c82-a687-9c3a344374a5","name":"report_email","type":"string","value":"user@example.com"},{"id":"8e190563-4f42-49e2-a9e2-ca7a0d7c368b","name":"report_on_success","type":"string","value":"false"}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"6c06ad99-e444-4312-83de-b70e5b6f880b","name":"Get Catalog Sheet","type":"n8n-nodes-base.googleSheets","position":[-1040,-672],"parameters":{"options":{},"sheetName":{"__rl":true,"mode":"name","value":"={{ $('Set Catalog Config').first().json.catalog_sheet }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Set Catalog Config').first().json.sheet_id }}"}},"executeOnce":true,"typeVersion":4.5,"alwaysOutputData":true},{"id":"42542e99-a951-46c6-866f-11a87925d1ee","name":"Fetch Live Catalog from Seller App","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":2,"position":[-800,-672],"parameters":{"url":"={{ $('Set Catalog Config').first().json.seller_api_base.replace(/\\/$/, '') + $('Set Catalog Config').first().json.catalog_list_path }}","options":{"timeout":60000,"response":{"response":{"neverError":true}}},"authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"executeOnce":true,"retryOnFail":true,"typeVersion":4.2,"alwaysOutputData":true,"waitBetweenTries":5000},{"id":"cc981a15-bef4-4263-8fed-a2306423380d","name":"Detect Changed Rows","type":"n8n-nodes-base.code","position":[-432,-672],"parameters":{"jsCode":"const str = v => String(v ?? '').trim();\nconst num = v => Number(String(v ?? '').replace(/[₹,\\s]/g, ''));\nconst bool = (v, d = false) => str(v) === '' ? d : /^(true|yes|y|1)$/i.test(str(v));\nconst hash = o => { const t = JSON.stringify(o); let h = 5381; for (let i = 0; i < t.length; i++) h = ((h << 5) + h + t.charCodeAt(i)) | 0; return (h >>> 0).toString(36); };\nconst CONTENT = [\"sku\", \"domain\", \"category\", \"product_name\", \"brand\", \"short_desc\", \"long_desc\", \"unit\", \"images\", \"veg_nonveg\", \"returnable\", \"return_window_days\", \"cancellable\", \"cod_available\", \"time_to_ship_hours\", \"hsn\", \"gst_rate\", \"manufacturer_name\", \"manufacturer_address\", \"country_of_origin\", \"mfg_month_year\", \"fssai_license\", \"ingredients\", \"attributes\"];\nconst STOCK = ['mrp', 'selling_price', 'stock_qty', 'max_order_qty', 'sync_enabled'];\nconst pickHash = (r, keys) => hash(keys.map(k => str(r[k])));\n\n// Works out what changed per SKU since the last sync, reconciles against the LIVE seller-app catalog and applies the price guard\nconst s = $('Set Catalog Config').first().json;\nconst body = (s.body && typeof s.body === 'object') ? s.body : {};\nconst only = Array.isArray(body.skus) ? new Set(body.skus.map(String)) : null;\nconst full = body.full_resync === true;\nconst aiOn = bool(s.ai_enabled, true), guard = Number(s.price_guard_pct) || 0;\nconst rows = $('Get Catalog Sheet').all().map(i => i.json).filter(r => str(r.sku));\n// ---- live catalog from the seller app (drift detection) ----\nlet live = null;\nif (bool(s.reconcile_enabled, true)) {\n  try {\n    const res = $('Fetch Live Catalog from Seller App').first().json;\n    const arr = res.items || res.data?.items || res.catalog || res.results || (Array.isArray(res.data) ? res.data : null);\n    if (Array.isArray(arr)) { live = {}; arr.forEach(x => { const id = str(x.id ?? x.sku ?? x.item_id ?? x.external_id); if (id) live[id] = {\n      name: x.descriptor?.name ?? x.name ?? '', price: num(x.price?.value ?? x.selling_price ?? x.price), mrp: num(x.price?.maximum_value ?? x.mrp),\n      stock: num(x.quantity?.available?.count ?? x.stock ?? x.inventory) }; }); }\n  } catch (e) { live = null; }\n}\nconst seen = {};\nrows.forEach(r => seen[str(r.sku)] = (seen[str(r.sku)] || 0) + 1);\nconst out = rows.filter(r => !only || only.has(str(r.sku))).map(r => {\n  const sku = str(r.sku), enabled = bool(r.sync_enabled, true);\n  const ch = pickHash(r, CONTENT), sh = pickHash(r, STOCK);\n  const synced = !!str(r.ondc_item_id), failedBefore = /fail|error/i.test(str(r.sync_status));\n  let change = 'skip', drift = '';\n  if (seen[sku] > 1) change = 'duplicate';\n  else if (!enabled) change = synced && str(r.sync_status) !== 'Disabled' ? 'disable' : 'skip';\n  else if (full || !synced || ch !== str(r.content_hash) || failedBefore) change = 'full';\n  else if (sh !== str(r.stock_hash)) change = 'inventory';\n  // drift: what the network shows vs what the sheet says\n  if (live && synced && enabled && change !== 'duplicate') {\n    const l = live[sku];\n    if (!l) { change = 'full'; drift = 'Missing on seller app - re-published'; }\n    else {\n      const d = [];\n      if (Math.abs(l.price - num(r.selling_price)) > 0.01) d.push(`price ${l.price}→${num(r.selling_price)}`);\n      if (l.mrp && Math.abs(l.mrp - num(r.mrp)) > 0.01) d.push(`MRP ${l.mrp}→${num(r.mrp)}`);\n      if (l.stock !== num(r.stock_qty)) d.push(`stock ${l.stock}→${num(r.stock_qty)}`);\n      if (d.length) { drift = `Drift fixed: ${d.join(', ')}`; if (change === 'skip') change = 'inventory'; }\n    }\n  }\n  // price guard: big price jumps need price_confirmed = TRUE\n  const lastP = num(r.last_synced_price), newP = num(r.selling_price);\n  const jump = lastP > 0 && newP > 0 ? Math.abs(newP - lastP) / lastP * 100 : 0;\n  const held = guard > 0 && ['full', 'inventory'].includes(change) && jump > guard && !bool(r.price_confirmed, false);\n  if (held) change = 'price_hold';\n  const needsAI = aiOn && change === 'full' && (full || ch !== str(r.content_hash) || !str(r.ai_title));\n  return { json: { sku, change, needs_ai: needsAI, content_hash: ch, stock_hash: sh, drift, price_jump_pct: Math.round(jump), row: r } };\n});\n// items live on ONDC that are not in the sheet\nif (live && !only) {\n  const known = new Set(rows.map(r => str(r.sku)));\n  Object.entries(live).filter(([id]) => !known.has(id)).forEach(([id, l]) => out.push({ json: {\n    sku: id, change: String(s.orphan_action) === 'disable' && l.stock > 0 ? 'orphan_disable' : 'orphan_report', needs_ai: false, orphan: true,\n    drift: `Live on ONDC but not in sheet (stock ${l.stock})`, row: { sku: id, product_name: l.name, selling_price: l.price, mrp: l.mrp || l.price, stock_qty: l.stock, ondc_item_id: id } } }));\n}\nreturn out;"},"typeVersion":2},{"id":"12ca2614-0d57-4977-8f26-a49e40a271fb","name":"Select Rows for AI Clean-up","type":"n8n-nodes-base.code","position":[-160,-672],"parameters":{"jsCode":"// Only new or changed content goes to the AI (saves cost); emits one marker item when nothing needs AI\nconst list = $input.all().filter(i => i.json.needs_ai).map(i => {\n  const r = i.json.row;\n  return { json: { skip_ai: false, sku: i.json.sku, prompt: JSON.stringify({\n    domain: r.domain, category: r.category, product_name: r.product_name, brand: r.brand, short_desc: r.short_desc, long_desc: r.long_desc,\n    unit: r.unit, attributes: r.attributes, ingredients: r.ingredients, veg_nonveg: r.veg_nonveg }) } };\n});\nreturn list.length ? list : [{ json: { skip_ai: true } }];"},"typeVersion":2},{"id":"c0324d12-8367-4a25-9e22-47ee3a075aa3","name":"Skip AI?","type":"n8n-nodes-base.if","position":[96,-672],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"ff2556cc-dcec-4781-89e7-7662875dc885","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.skip_ai }}","rightValue":""}]}},"typeVersion":2.2},{"id":"3e206a02-4ef1-461f-b915-4095ad0d6c3b","name":"AI Clean Product Attributes","type":"@n8n/n8n-nodes-langchain.openAi","onError":"continueRegularOutput","position":[224,-432],"parameters":{"modelId":{"__rl":true,"mode":"list","value":"gpt-4o-mini","cachedResultName":"GPT-4O-MINI"},"options":{"temperature":0.2},"messages":{"values":[{"role":"system","content":"You clean product catalog data for an Indian seller listing on ONDC (Open Network for Digital Commerce).\nInput is one product row in JSON. Return ONLY JSON:\n{\"title\": string, \"short_desc\": string, \"long_desc\": string, \"category\": string, \"attributes\": {key: value}, \"unit\": {\"value\": string, \"unit\": \"gram\"|\"kilogram\"|\"millilitre\"|\"litre\"|\"unit\"|\"dozen\"}, \"veg_nonveg\": \"veg\"|\"non-veg\"|\"egg\"|\"\", \"issues\": [string]}\nRules:\n- title: max 100 characters, Title Case, in the pattern \"Brand Product Variant Net-Quantity\" (e.g. \"Aashirvaad Whole Wheat Atta 5 kg\"). Remove ALL CAPS, emojis, prices, offers, SEO spam and repeated words.\n- short_desc: one factual sentence, max 160 characters. long_desc: 2–4 factual sentences built only from the given data. Never invent health claims, certifications, specs, or ingredients.\n- category: if the given category is empty or obviously wrong, suggest the closest ONDC retail category for the domain (RET10 Grocery, RET11 F&B, RET12 Fashion, RET13 BPC, RET14 Electronics, RET15 Appliances, RET16 Home & Kitchen, RET18 Health & Wellness). Otherwise return it unchanged.\n- attributes: extract structured attributes (brand, colour, size, material, flavour, pack_size, model, etc.) from the name, descriptions and attributes text. Use lower_snake_case keys.\n- unit: parse the net quantity from unit or name; leave value empty if unknown.\n- veg_nonveg: only for food and only if it is clear from the name or ingredients; otherwise \"\".\n- issues: short notes about problems a human should fix (e.g. \"name and unit disagree: 500 g vs 1 kg\", \"description mentions a different product\"). Empty array if none."},{"content":"={{ $json.prompt }}"}]},"jsonOutput":true},"typeVersion":1.8},{"id":"4655a574-3c67-4bf1-9b31-5b9f93fd6045","name":"Merge AI Output into Rows","type":"n8n-nodes-base.code","position":[560,-432],"parameters":{"jsCode":"// Pairs every AI answer with its SKU and normalises the JSON\nconst asked = $('Skip AI?').all(1);\nreturn $input.all().map((item, i) => {\n  let a = item.json.message?.content ?? item.json.content ?? {};\n  if (typeof a === 'string') { try { a = JSON.parse(a.replace(/```json|```/g, '').trim()); } catch (e) { a = {}; } }\n  const attrs = a.attributes && typeof a.attributes === 'object' ? a.attributes : {};\n  return { json: { sku: asked[i].json.sku, ok: !!a.title, title: String(a.title || '').slice(0, 120), short_desc: String(a.short_desc || '').slice(0, 200),\n    long_desc: String(a.long_desc || '').slice(0, 1500), category: String(a.category || ''), attributes: attrs,\n    unit: a.unit && a.unit.value ? a.unit : null, veg_nonveg: String(a.veg_nonveg || ''), issues: Array.isArray(a.issues) ? a.issues : [] } };\n});"},"typeVersion":2},{"id":"62f19922-815b-4821-a86b-28f6d0f068e3","name":"Collect Image URLs","type":"n8n-nodes-base.code","position":[880,-672],"parameters":{"jsCode":"const str = v => String(v ?? '').trim();\nconst num = v => Number(String(v ?? '').replace(/[₹,\\s]/g, ''));\nconst bool = (v, d = false) => str(v) === '' ? d : /^(true|yes|y|1)$/i.test(str(v));\nconst hash = o => { const t = JSON.stringify(o); let h = 5381; for (let i = 0; i < t.length; i++) h = ((h << 5) + h + t.charCodeAt(i)) | 0; return (h >>> 0).toString(36); };\nconst CONTENT = [\"sku\", \"domain\", \"category\", \"product_name\", \"brand\", \"short_desc\", \"long_desc\", \"unit\", \"images\", \"veg_nonveg\", \"returnable\", \"return_window_days\", \"cancellable\", \"cod_available\", \"time_to_ship_hours\", \"hsn\", \"gst_rate\", \"manufacturer_name\", \"manufacturer_address\", \"country_of_origin\", \"mfg_month_year\", \"fssai_license\", \"ingredients\", \"attributes\"];\nconst STOCK = ['mrp', 'selling_price', 'stock_qty', 'max_order_qty', 'sync_enabled'];\nconst pickHash = (r, keys) => hash(keys.map(k => str(r[k])));\n\n// Gathers unique image URLs of products going through the full path so they can be checked live\nconst s = $('Set Catalog Config').first().json;\nif (!bool(s.image_check_enabled, true)) return [{ json: { skip_img: true } }];\nconst urls = new Set();\n$('Detect Changed Rows').all().map(i => i.json).filter(c => c.change === 'full')\n  .forEach(c => str(c.row.images).split(/[\\s,]+/).filter(u => /^https:\\/\\//i.test(u)).forEach(u => urls.add(u)));\nconst list = [...urls].slice(0, Number(s.max_image_checks) || 150);\nreturn list.length ? list.map(url => ({ json: { skip_img: false, url } })) : [{ json: { skip_img: true } }];"},"typeVersion":2},{"id":"35d12d88-807e-43dd-ab77-a2646d52b880","name":"Skip Image Check?","type":"n8n-nodes-base.if","position":[1120,-672],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"dc68cf2e-58e1-47d6-bff5-1911acdac4a9","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.skip_img }}","rightValue":""}]}},"typeVersion":2.2},{"id":"2873dc10-62a4-408e-8895-e6f379daa088","name":"Check Image URLs","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","position":[1248,-432],"parameters":{"url":"={{ $json.url }}","method":"HEAD","options":{"timeout":15000,"batching":{"batch":{"batchSize":10,"batchInterval":300}},"response":{"response":{"neverError":true,"fullResponse":true}},"allowUnauthorizedCerts":false}},"typeVersion":4.2},{"id":"162b8789-349b-42ce-b894-652ae5829a06","name":"Summarize Image Check","type":"n8n-nodes-base.code","position":[1472,-432],"parameters":{"jsCode":"// Turns HEAD responses into a url -> verdict map (hard errors block the item, soft ones become warnings)\nconst s = $('Set Catalog Config').first().json;\nconst asked = $('Skip Image Check?').all(1);\nconst maxBytes = (Number(s.max_image_mb) || 5) * 1024 * 1024;\nconst results = {};\n$input.all().forEach((item, i) => {\n  const url = asked[i] ? asked[i].json.url : null; if (!url) return;\n  const r = item.json, code = Number(r.statusCode ?? r.status ?? 0), h = r.headers || {};\n  const type = String(h['content-type'] || h['Content-Type'] || ''), size = Number(h['content-length'] || h['Content-Length'] || 0);\n  if (!code || r.error) results[url] = { ok: false, hard: false, reason: 'could not reach host' };\n  else if ([404, 410, 403, 401].includes(code)) results[url] = { ok: false, hard: true, reason: `HTTP ${code}` };\n  else if (code === 405) results[url] = { ok: false, hard: false, reason: 'server blocks HEAD, not verified' };\n  else if (code >= 400) results[url] = { ok: false, hard: false, reason: `HTTP ${code}` };\n  else if (type && !/^image\\//i.test(type)) results[url] = { ok: false, hard: true, reason: `not an image (${type.split(';')[0]})` };\n  else if (size > maxBytes) results[url] = { ok: false, hard: false, reason: `${(size / 1048576).toFixed(1)} MB, above the ${s.max_image_mb} MB limit` };\n  else results[url] = { ok: true };\n});\nreturn [{ json: { checked: Object.keys(results).length, broken: Object.values(results).filter(x => !x.ok).length, results } }];"},"typeVersion":2},{"id":"61afcef1-71c0-434f-b392-2a4947df16ec","name":"Validate & Build ONDC Payloads","type":"n8n-nodes-base.code","position":[1904,-672],"parameters":{"jsCode":"const str = v => String(v ?? '').trim();\nconst num = v => Number(String(v ?? '').replace(/[₹,\\s]/g, ''));\nconst bool = (v, d = false) => str(v) === '' ? d : /^(true|yes|y|1)$/i.test(str(v));\nconst hash = o => { const t = JSON.stringify(o); let h = 5381; for (let i = 0; i < t.length; i++) h = ((h << 5) + h + t.charCodeAt(i)) | 0; return (h >>> 0).toString(36); };\nconst CONTENT = [\"sku\", \"domain\", \"category\", \"product_name\", \"brand\", \"short_desc\", \"long_desc\", \"unit\", \"images\", \"veg_nonveg\", \"returnable\", \"return_window_days\", \"cancellable\", \"cod_available\", \"time_to_ship_hours\", \"hsn\", \"gst_rate\", \"manufacturer_name\", \"manufacturer_address\", \"country_of_origin\", \"mfg_month_year\", \"fssai_license\", \"ingredients\", \"attributes\"];\nconst STOCK = ['mrp', 'selling_price', 'stock_qty', 'max_order_qty', 'sync_enabled'];\nconst pickHash = (r, keys) => hash(keys.map(k => str(r[k])));\n\n// Applies AI clean-up, validates against ONDC retail rules and builds batched API payloads\nconst s = $('Set Catalog Config').first().json;\nconst changes = $('Detect Changed Rows').all().map(i => i.json).filter(c => c.change !== 'skip');\nlet imgRes = {};\ntry { imgRes = $('Summarize Image Check').first().json.results || {}; } catch (e) { imgRes = {}; }\nlet ai = {};\ntry { $('Merge AI Output into Rows').all().forEach(i => { ai[i.json.sku] = i.json; }); } catch (e) { ai = {}; }\nconst autoApply = String(s.ai_apply_mode).toLowerCase() === 'auto';\nconst DOMAINS = { RET10: 'Grocery', RET11: 'F&B', RET12: 'Fashion', RET13: 'Beauty & Personal Care', RET14: 'Electronics', RET15: 'Appliances', RET16: 'Home & Kitchen', RET18: 'Health & Wellness' };\nconst FOOD = ['RET10', 'RET11'];\nconst UNITS = { g: 'gram', gm: 'gram', gms: 'gram', gram: 'gram', grams: 'gram', kg: 'kilogram', kgs: 'kilogram', kilo: 'kilogram', kilogram: 'kilogram', kilograms: 'kilogram', ml: 'millilitre', millilitre: 'millilitre', l: 'litre', ltr: 'litre', litre: 'litre',\n  pc: 'unit', pcs: 'unit', piece: 'unit', pieces: 'unit', unit: 'unit', units: 'unit', nos: 'unit', dozen: 'dozen', tonne: 'tonne' };\nconst parseUnit = t => { const m = str(t).toLowerCase().match(/^([\\d.]+)\\s*([a-z]+)/); return m && UNITS[m[2]] ? { value: m[1], unit: UNITS[m[2]] } : null; };\nconst parseAttrs = t => str(t).split(/[;\\n]/).map(x => x.split(':')).filter(p => p.length >= 2 && p[0].trim()).reduce((o, [k, ...v]) => (o[k.trim().toLowerCase().replace(/\\s+/g, '_')] = v.join(':').trim(), o), {});\nconst upserts = [], inventory = [], failures = [], orphans = [];\nfor (const c of changes) {\n  const r = c.row, a = ai[c.sku], useAI = a && a.ok && autoApply;\n  const errs = [], warns = [];\n  const E = m => errs.push(m), W = m => warns.push(m);\n  const aiCols = a && a.ok ? { ai_title: a.title, ai_short_desc: a.short_desc, ai_long_desc: a.long_desc, ai_category: a.category,\n    ai_attributes: Object.entries(a.attributes).map(([k, v]) => `${k}: ${v}`).join('; '), ai_notes: a.issues.join(' | ') } : {};\n  if (a && a.issues.length) a.issues.forEach(x => W(`AI: ${x}`));\n  if (c.change === 'orphan_report') { orphans.push({ sku: c.sku, name: r.product_name, note: c.drift }); continue; }\n  if (c.change === 'price_hold') { failures.push({ sku: c.sku, name: r.product_name, errors: [`Price changed ${c.price_jump_pct}% since last sync (${r.last_synced_price} → ${r.selling_price}). Set price_confirmed = TRUE to publish.`], warnings: [], cols: aiCols, prev: r.sync_errors, status: 'Price Check' }); continue; }\n  if (c.change === 'duplicate') { failures.push({ sku: c.sku, name: r.product_name, errors: ['Duplicate SKU in sheet'], warnings: [], cols: aiCols, prev: r.sync_errors }); continue; }\n  const mrp = num(r.mrp), sp = num(r.selling_price), stock = num(r.stock_qty), maxQ = num(r.max_order_qty) || Math.min(stock || 10, 10);\n  if (!(sp > 0)) E('selling_price must be > 0'); if (!(mrp > 0)) E('mrp must be > 0'); else if (sp > mrp) E(`selling_price ${sp} is above MRP ${mrp} (not allowed)`);\n  if (mrp > 0 && sp > 0 && (1 - sp / mrp) * 100 > Number(s.max_discount_pct)) W(`Discount above ${s.max_discount_pct}%: check the price`);\n  if (!Number.isInteger(stock) || stock < 0) E('stock_qty must be a whole number ≥ 0');\n  if (['inventory', 'disable', 'orphan_disable'].includes(c.change)) {\n    const off = c.change !== 'inventory';\n    if (!errs.length) inventory.push({ meta: { sku: c.sku, change: c.change, stock_hash: c.stock_hash, ondc_item_id: r.ondc_item_id, warnings: warns, name: r.product_name, prev: r.sync_errors,\n        price: sp, stock: off ? 0 : stock, drift: c.drift, orphan: !!c.orphan },\n      item: { id: c.sku, price: { currency: 'INR', value: sp.toFixed(2), maximum_value: mrp.toFixed(2) }, quantity: { available: { count: String(off ? 0 : stock) }, maximum: { count: String(maxQ) } } } });\n    else failures.push({ sku: c.sku, name: r.product_name, errors: errs, warnings: warns, cols: {}, prev: r.sync_errors });\n    continue;\n  }\n  // ---- full content validation ----\n  const domain = str(r.domain).toUpperCase();\n  const title = useAI && a.title ? a.title : str(r.product_name);\n  const shortD = useAI && a.short_desc ? a.short_desc : str(r.short_desc) || title;\n  const longD = useAI && a.long_desc ? a.long_desc : str(r.long_desc) || shortD;\n  const category = str(r.category) || (a ? a.category : '');\n  const unit = parseUnit(r.unit) || (a && a.unit && UNITS[String(a.unit.unit).toLowerCase()] ? { value: String(a.unit.value), unit: UNITS[String(a.unit.unit).toLowerCase()] } : null);\n  const imgs = str(r.images).split(/[\\s,]+/).filter(Boolean);\n  const veg = str(r.veg_nonveg).toLowerCase() || (a ? a.veg_nonveg.toLowerCase() : '');\n  const attrs = { ...(a ? a.attributes : {}), ...parseAttrs(r.attributes) };\n  if (!DOMAINS[domain]) E(`domain \"${r.domain}\" is not a supported ONDC retail code (${Object.keys(DOMAINS).join(', ')})`);\n  if (title.length < 3 || title.length > 120) E('product name must be 3–120 characters');\n  if (!category) E('category is missing');\n  if (!imgs.length) E('at least one image URL is required');\n  imgs.forEach(u => { if (!/^https:\\/\\/[^\\s]+\\.[a-z]{2,}/i.test(u)) E(`image URL must be public https: ${u.slice(0, 60)}`);\n    else if (imgRes[u] && !imgRes[u].ok) (imgRes[u].hard ? E : W)(`image ${imgRes[u].reason}: ${u.slice(0, 60)}`); });\n  if (!unit) E(`unit \"${r.unit}\" not understood (use e.g. \"500 g\", \"1 kg\", \"1 L\", \"2 pcs\")`);\n  if (!str(r.brand) && !attrs.brand) W('brand is missing');\n  if (str(r.hsn) && !/^\\d{4,8}$/.test(str(r.hsn))) W('HSN should be 4–8 digits');\n  if (str(r.gst_rate) && ![0, 0.25, 3, 5, 12, 18, 28].includes(num(r.gst_rate))) W(`unusual GST rate ${r.gst_rate}`);\n  const packaged = domain !== 'RET11';\n  if (packaged) {\n    if (!str(r.manufacturer_name)) E('manufacturer_name required (Legal Metrology)');\n    if (!str(r.manufacturer_address)) E('manufacturer_address required (Legal Metrology)');\n    if (!/^\\d{2}\\/\\d{4}$/.test(str(r.mfg_month_year))) E('mfg_month_year required as MM/YYYY (Legal Metrology)');\n  }\n  if (FOOD.includes(domain)) {\n    if (!['veg', 'non-veg', 'nonveg', 'egg'].includes(veg)) E('veg_nonveg must be veg / non-veg / egg for food items');\n    if (!/^\\d{14}$/.test(str(r.fssai_license))) E('fssai_license must be a 14-digit number for food items');\n    if (domain === 'RET10' && !str(r.ingredients)) W('ingredients missing');\n  }\n  const returnable = bool(r.returnable, false), rwd = num(r.return_window_days) || Number(s.default_return_window_days);\n  if (errs.length) { failures.push({ sku: c.sku, name: title, errors: errs, warnings: warns, cols: aiCols, prev: r.sync_errors }); continue; }\n  const vegTag = veg ? [{ code: 'veg_nonveg', list: [{ code: veg === 'veg' ? 'veg' : veg === 'egg' ? 'egg' : 'non_veg', value: 'yes' }] }] : [];\n  const item = {\n    id: c.sku,\n    descriptor: { name: title, symbol: imgs[0], short_desc: shortD, long_desc: longD, images: imgs },\n    quantity: { unitized: { measure: unit }, available: { count: String(stock) }, maximum: { count: String(maxQ) } },\n    price: { currency: 'INR', value: sp.toFixed(2), maximum_value: mrp.toFixed(2) },\n    category_id: category, location_id: s.location_id, fulfillment_id: s.fulfillment_id,\n    '@ondc/org/returnable': returnable, '@ondc/org/cancellable': bool(r.cancellable, true),\n    '@ondc/org/return_window': `P${returnable ? rwd : 0}D`, '@ondc/org/seller_pickup_return': false,\n    '@ondc/org/time_to_ship': `PT${num(r.time_to_ship_hours) || Number(s.default_time_to_ship_hours)}H`,\n    '@ondc/org/available_on_cod': bool(r.cod_available, false), '@ondc/org/contact_details_consumer_care': s.consumer_care,\n    tags: [{ code: 'origin', list: [{ code: 'country', value: str(r.country_of_origin) || s.default_country }] }, ...vegTag,\n      { code: 'attribute', list: Object.entries({ brand: str(r.brand) || attrs.brand, ...attrs }).filter(([, v]) => v).map(([k, v]) => ({ code: k, value: String(v) })) }],\n  };\n  if (packaged) item['@ondc/org/statutory_reqs_packaged_commodities'] = { manufacturer_or_packer_name: str(r.manufacturer_name), manufacturer_or_packer_address: str(r.manufacturer_address),\n    common_or_generic_name_of_commodity: category, net_quantity_or_measure_of_commodity_in_pkg: `${unit.value} ${unit.unit}`, month_year_of_manufacture_packing_import: str(r.mfg_month_year) };\n  if (FOOD.includes(domain)) item['@ondc/org/statutory_reqs_prepackaged_food'] = { brand_owner_FSSAI_license_no: str(r.fssai_license), ingredients_info: str(r.ingredients) };\n  upserts.push({ meta: { sku: c.sku, change: 'full', content_hash: c.content_hash, stock_hash: c.stock_hash, ondc_item_id: r.ondc_item_id, warnings: warns, cols: aiCols, name: title, prev: r.sync_errors,\n    price: sp, stock, drift: c.drift }, item });\n}\nconst size = Number(s.batch_size) || 50, base = String(s.seller_api_base).replace(/\\/$/, '');\nconst out = [];\nconst chunk = (list, kind, path) => { for (let i = 0; i < list.length; i += size) { const part = list.slice(i, i + size);\n  out.push({ type: 'api', kind, url: base + path, body: { provider_id: s.provider_id, location_id: s.location_id, items: part.map(p => p.item) }, metas: part.map(p => p.meta) }); } };\nchunk(upserts, 'upsert', s.upsert_path);\nchunk(inventory, 'inventory', s.inventory_path);\nif (!out.length) out.push({ type: 'none' });\nout[0].validation_failures = failures;\nout[0].orphans = orphans;\nout[0].ai_cleaned = Object.values(ai).filter(x => x.ok).length;\nout[0].images_broken = Object.values(imgRes).filter(x => !x.ok).length;\nreturn out.map(j => ({ json: j }));"},"typeVersion":2},{"id":"522cd662-5f36-4292-89fd-8fae13cecdf7","name":"Has API Batches?","type":"n8n-nodes-base.if","position":[2144,-672],"parameters":{"options":{},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"loose"},"combinator":"and","conditions":[{"id":"8efe1fd8-65a5-471a-ace7-e2a8d30b1401","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.type === 'api' }}","rightValue":""}]}},"typeVersion":2.2},{"id":"14ffa614-c634-4733-887b-139a05d5e578","name":"Push Items to Seller App","type":"n8n-nodes-base.httpRequest","onError":"continueRegularOutput","maxTries":2,"position":[2320,-880],"parameters":{"url":"={{ $json.url }}","method":"POST","options":{"timeout":60000,"batching":{"batch":{"batchSize":1}},"response":{"response":{"neverError":true}}},"jsonBody":"={{ JSON.stringify($json.body) }}","sendBody":true,"specifyBody":"json","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"retryOnFail":true,"typeVersion":4.2,"waitBetweenTries":5000},{"id":"bef73e74-7d6e-4fd6-9205-510b0d67c7e9","name":"Compile Sync Results","type":"n8n-nodes-base.code","position":[2496,-672],"parameters":{"jsCode":"// Merges API responses + validation failures into sheet write-backs, an error log and a report\nconst s = $('Set Catalog Config').first().json;\nconst v = $('Validate & Build ONDC Payloads').all().map(i => i.json);\nconst batches = v.filter(x => x.type === 'api');\nconst responses = batches.length ? $input.all().map(i => i.json) : [];\nconst now = new Date().toISOString(), out = [], report = { full: 0, inventory: 0, disabled: 0, warnings: 0, failedValidation: 0, failedApi: 0, drift: 0, orphansDisabled: 0, lowStock: [], rows: [] };\nconst orphans = v[0].orphans || [];\norphans.forEach(o => report.rows.push({ sku: o.sku, name: o.name, stage: 'Orphan', severity: 'warning', message: o.note + ' - add it to the sheet or set orphan_action = disable' }));\nconst errText = e => Array.isArray(e) ? e.map(x => typeof x === 'string' ? x : (x.message || x.description || JSON.stringify(x))).join('; ') : (typeof e === 'string' ? e : e ? (e.message || JSON.stringify(e)) : '');\nconst rowsBySku = {}; $('Detect Changed Rows').all().forEach(i => { rowsBySku[i.json.sku] = i.json.row; });\nconst fixLimit = Number(s.ai_fix_limit) || 0; let fixes = 0;\nconst log = (sku, name, stage, severity, message, prev) => { report.rows.push({ sku, name, stage, severity, message });\n  if (String(prev || '').split(' | ')[0] !== message) {\n    out.push({ json: { type: 'error_log', log: { timestamp: now, sku, product_name: name, stage, severity, message } } });\n    const r = rowsBySku[sku];\n    if (r && fixes < fixLimit && severity === 'error') { fixes++; out.push({ json: { type: 'ai_fix', sku, prompt: JSON.stringify({ stage, errors: message,\n      row: Object.fromEntries(Object.entries(r).filter(([k, v]) => v !== '' && !/hash|^ai_|sync_|last_|drift/.test(k))) }) } }); }\n  } };\nfor (const f of (v[0].validation_failures || [])) {\n  const msg = f.errors.join('; ');\n  report.failedValidation++;\n  out.push({ json: { type: 'writeback', update: { sku: f.sku, ...f.cols, sync_status: f.status || 'Validation Failed', sync_errors: [msg, ...f.warnings].join(' | '), last_synced_at: now } } });\n  log(f.sku, f.name, f.status === 'Price Check' ? 'Price guard' : 'Validation', f.status === 'Price Check' ? 'hold' : 'error', msg, f.prev);\n}\nbatches.forEach((b, i) => {\n  const res = responses[i] || {};\n  const allFail = !!(res.error || res.errors && !Array.isArray(res.results) || Number(res.statusCode || res.status_code) >= 400 || res.success === false);\n  const list = res.results || res.items || res.data?.results || res.data?.items || (Array.isArray(res.data) ? res.data : []);\n  for (const m of b.metas) {\n    const e = (Array.isArray(list) ? list : []).find(x => String(x.sku ?? x.id ?? x.item_id ?? x.external_id) === m.sku);\n    const bad = e ? (e.success === false || /fail|error|reject/i.test(String(e.status || '')) || (e.errors && e.errors.length) || !!e.error) : allFail;\n    if (bad) {\n      const msg = errText(e ? (e.errors || e.error || e.message) : (res.errors || res.error || res.message)) || 'API rejected the item';\n      report.failedApi++;\n      if (m.orphan) { log(m.sku, m.name, 'Orphan disable', 'error', msg.slice(0, 500), ''); continue; }\n      out.push({ json: { type: 'writeback', update: { sku: m.sku, ...(m.cols || {}), sync_status: 'API Error', sync_errors: msg.slice(0, 500), last_synced_at: now } } });\n      log(m.sku, m.name, `API ${b.kind}`, 'error', msg.slice(0, 500), m.prev);\n    } else {\n      if (m.orphan) { report.orphansDisabled++; report.rows.push({ sku: m.sku, name: m.name, stage: 'Orphan', severity: 'info', message: 'Not in sheet - stock set to 0 on ONDC' }); continue; }\n      if (m.change === 'disable') report.disabled++; else if (b.kind === 'upsert') report.full++; else report.inventory++;\n      if (m.drift) { report.drift++; report.rows.push({ sku: m.sku, name: m.name, stage: 'Reconcile', severity: 'info', message: m.drift }); }\n      if (m.change !== 'disable' && m.stock <= Number(s.low_stock_threshold || 0)) report.lowStock.push(`${m.name || m.sku} (${m.stock})`);\n      if (m.warnings.length) { report.warnings++; report.rows.push({ sku: m.sku, name: m.name, stage: 'Synced', severity: 'warning', message: m.warnings.join('; ') }); }\n      const u = { sku: m.sku, sync_status: m.change === 'disable' ? 'Disabled' : m.warnings.length ? 'Synced (warnings)' : 'Synced', sync_errors: m.warnings.join(' | '),\n        last_synced_at: now, stock_hash: m.stock_hash, ondc_item_id: String(e?.ondc_item_id || e?.item_id || m.ondc_item_id || m.sku),\n        last_synced_price: m.price, price_confirmed: '', drift_note: m.drift || '' };\n      if (m.content_hash) Object.assign(u, { content_hash: m.content_hash, ...(m.cols || {}) });\n      out.push({ json: { type: 'writeback', update: u } });\n    }\n  }\n});\nconst anyErr = report.failedValidation + report.failedApi + orphans.length > 0 || report.drift > 0, anyWork = report.full + report.inventory + report.disabled > 0;\nif (anyErr || (anyWork && /^true$/i.test(String(s.report_on_success)))) {\n  const esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;');\n  const td = 'style=\"padding:6px 8px;border-bottom:1px solid #e5e7eb;vertical-align:top\"';\n  const rows = report.rows.slice(0, 60).map(r => `<tr><td ${td}><b>${esc(r.sku)}</b><br><small>${esc(r.name)}</small></td><td ${td}>${esc(r.stage)}</td><td ${td} style=\"color:${r.severity === 'error' ? '#b91c1c' : '#a16207'}\">${esc(r.severity)}</td><td ${td}>${esc(r.message)}</td></tr>`).join('');\n  out.push({ json: { type: 'report', subject: `ONDC catalog sync: ${anyWork ? `${report.full + report.inventory + report.disabled} synced` : 'nothing synced'}${anyErr ? `, ${report.failedValidation + report.failedApi} need fixing` : ''}`,\n    html: `<div style=\"font-family:Arial,sans-serif;max-width:820px\"><h2>🛒 ${esc(s.seller_name)}: ONDC catalog sync</h2>\n<p>✅ Full updates <b>${report.full}</b> · 💲 Price/stock updates <b>${report.inventory}</b> · ⛔ Disabled <b>${report.disabled}</b> · ✨ AI-cleaned <b>${v[0].ai_cleaned || 0}</b><br>\n❌ Validation / price-guard holds <b>${report.failedValidation}</b> · ❌ Seller-app API errors <b>${report.failedApi}</b> · ⚠️ Synced with warnings <b>${report.warnings}</b><br>\n🔄 Drift corrected <b>${report.drift}</b> · 👻 Orphans on ONDC <b>${orphans.length + report.orphansDisabled}</b>${report.lowStock.length ? `<br>📉 Low stock (≤ ${s.low_stock_threshold}): ${esc(report.lowStock.slice(0, 15).join(', '))}` : ''}</p>\n${rows ? `<table style=\"border-collapse:collapse;width:100%;font-size:13px\"><tr style=\"background:#111827;color:#fff\"><th ${td}>SKU</th><th ${td}>Stage</th><th ${td}>Severity</th><th ${td}>Message</th></tr>${rows}</table>` : ''}\n<p style=\"color:#6b7280;font-size:12px\">${fixes ? `✨ AI fix suggestions written to the <b>ai_fix_suggestion</b> column for ${fixes} row(s). ` : ''}${v[0].images_broken ? `🖼️ ${v[0].images_broken} broken image link(s) found. ` : ''}Fix the rows in the <b>${esc(s.catalog_sheet)}</b> tab (see the sync_errors column). Edited rows are picked up automatically on the next run.</p></div>` } });\n}\nreturn out;"},"typeVersion":2},{"id":"4409a0aa-03b8-41a1-872e-037013606bb4","name":"Route by Result Type","type":"n8n-nodes-base.switch","position":[2736,-672],"parameters":{"rules":{"values":[{"outputKey":"Write Back","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"543a0c6b-b850-4cd9-b901-7cc8fcb577dd","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.type }}","rightValue":"writeback"}]},"renameOutput":true},{"outputKey":"Error Log","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"ff20c58a-4360-4419-811b-c75d8f086eef","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.type }}","rightValue":"error_log"}]},"renameOutput":true},{"outputKey":"Report","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"aea54d47-1e1d-49c6-b92c-3ca705a3a2bc","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.type }}","rightValue":"report"}]},"renameOutput":true},{"outputKey":"AI Fix","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"cd9992e6-56db-42f7-a4ef-c2729e357b1a","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.type }}","rightValue":"ai_fix"}]},"renameOutput":true}]},"options":{}},"typeVersion":3.2},{"id":"24d6e540-d543-453c-bcc0-067fe0458cf3","name":"Prepare Catalog Row Update","type":"n8n-nodes-base.code","position":[3168,-1120],"parameters":{"mode":"runOnceForEachItem","jsCode":"return { json: $json.update };"},"typeVersion":2},{"id":"d3abb32f-a1d9-4000-87c4-52d6cf9661f0","name":"Log Sync Errors to Sheet","type":"n8n-nodes-base.googleSheets","position":[3264,-880],"parameters":{"columns":{"value":{"sku":"={{ $json.log.sku }}","stage":"={{ $json.log.stage }}","message":"={{ $json.log.message }}","severity":"={{ $json.log.severity }}","timestamp":"={{ $json.log.timestamp }}","product_name":"={{ $json.log.product_name }}"},"schema":[{"id":"timestamp","type":"string","display":true,"removed":false,"required":false,"displayName":"timestamp","defaultMatch":false,"canBeUsedToMatch":true},{"id":"sku","type":"string","display":true,"removed":false,"required":false,"displayName":"sku","defaultMatch":false,"canBeUsedToMatch":true},{"id":"product_name","type":"string","display":true,"removed":false,"required":false,"displayName":"product_name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"stage","type":"string","display":true,"removed":false,"required":false,"displayName":"stage","defaultMatch":false,"canBeUsedToMatch":true},{"id":"severity","type":"string","display":true,"removed":false,"required":false,"displayName":"severity","defaultMatch":false,"canBeUsedToMatch":true},{"id":"message","type":"string","display":true,"removed":false,"required":false,"displayName":"message","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[]},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Set Catalog Config').first().json.errors_sheet }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Set Catalog Config').first().json.sheet_id }}"}},"typeVersion":4.5},{"id":"1f8fe50d-8cf3-4886-aa48-bf3280b01df3","name":"Email Sync Report","type":"n8n-nodes-base.gmail","onError":"continueRegularOutput","position":[3312,-384],"webhookId":"74371ef7-cfac-48e1-959b-47edd27822e2","parameters":{"sendTo":"={{ $('Set Catalog Config').first().json.report_email }}","message":"={{ $json.html }}","options":{"appendAttribution":false},"subject":"={{ $json.subject }}"},"typeVersion":2.1},{"id":"0db327a7-d8fb-485c-986b-c4cea9028f4d","name":"AI Suggest Fixes for Errors","type":"@n8n/n8n-nodes-langchain.openAi","onError":"continueRegularOutput","position":[3200,-176],"parameters":{"modelId":{"__rl":true,"mode":"list","value":"gpt-4o-mini","cachedResultName":"GPT-4O-MINI"},"options":{"temperature":0.2},"messages":{"values":[{"role":"system","content":"You are an ONDC catalog support specialist helping an Indian seller fix a product that failed to publish.\nYou get the failing stage, the error messages (from our validator or the seller-app API) and the product row.\nReturn ONLY JSON: {\"summary\": string (one plain-language sentence on what is wrong), \"steps\": [1-4 short, concrete fixes naming the exact sheet column and an example value]}\nRules: be specific (e.g. \"Set mfg_month_year to 08/2026\", \"Replace image 2 with a public https JPG/PNG under 5 MB\"). For FSSAI, use the 14-digit licence number printed on the product label. Never invent licence numbers, prices or manufacturer details; tell the seller where to find them. If the error is about the seller-app API itself (auth, timeout, server), say so and suggest checking credentials or retrying."},{"content":"={{ $json.prompt }}"}]},"jsonOutput":true},"typeVersion":1.8},{"id":"8a64e940-3860-4f00-ab14-a42c46d19a4c","name":"Update Catalog Rows in Sheet","type":"n8n-nodes-base.googleSheets","position":[3392,-1120],"parameters":{"columns":{"value":{},"schema":[{"id":"sku","type":"string","display":true,"removed":false,"required":false,"displayName":"sku","defaultMatch":false,"canBeUsedToMatch":true},{"id":"sync_enabled","type":"string","display":true,"removed":false,"required":false,"displayName":"sync_enabled","defaultMatch":false,"canBeUsedToMatch":true},{"id":"domain","type":"string","display":true,"removed":false,"required":false,"displayName":"domain","defaultMatch":false,"canBeUsedToMatch":true},{"id":"category","type":"string","display":true,"removed":false,"required":false,"displayName":"category","defaultMatch":false,"canBeUsedToMatch":true},{"id":"product_name","type":"string","display":true,"removed":false,"required":false,"displayName":"product_name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"brand","type":"string","display":true,"removed":false,"required":false,"displayName":"brand","defaultMatch":false,"canBeUsedToMatch":true},{"id":"short_desc","type":"string","display":true,"removed":false,"required":false,"displayName":"short_desc","defaultMatch":false,"canBeUsedToMatch":true},{"id":"long_desc","type":"string","display":true,"removed":false,"required":false,"displayName":"long_desc","defaultMatch":false,"canBeUsedToMatch":true},{"id":"mrp","type":"string","display":true,"removed":false,"required":false,"displayName":"mrp","defaultMatch":false,"canBeUsedToMatch":true},{"id":"selling_price","type":"string","display":true,"removed":false,"required":false,"displayName":"selling_price","defaultMatch":false,"canBeUsedToMatch":true},{"id":"stock_qty","type":"string","display":true,"removed":false,"required":false,"displayName":"stock_qty","defaultMatch":false,"canBeUsedToMatch":true},{"id":"max_order_qty","type":"string","display":true,"removed":false,"required":false,"displayName":"max_order_qty","defaultMatch":false,"canBeUsedToMatch":true},{"id":"unit","type":"string","display":true,"removed":false,"required":false,"displayName":"unit","defaultMatch":false,"canBeUsedToMatch":true},{"id":"images","type":"string","display":true,"removed":false,"required":false,"displayName":"images","defaultMatch":false,"canBeUsedToMatch":true},{"id":"veg_nonveg","type":"string","display":true,"removed":false,"required":false,"displayName":"veg_nonveg","defaultMatch":false,"canBeUsedToMatch":true},{"id":"returnable","type":"string","display":true,"removed":false,"required":false,"displayName":"returnable","defaultMatch":false,"canBeUsedToMatch":true},{"id":"return_window_days","type":"string","display":true,"removed":false,"required":false,"displayName":"return_window_days","defaultMatch":false,"canBeUsedToMatch":true},{"id":"cancellable","type":"string","display":true,"removed":false,"required":false,"displayName":"cancellable","defaultMatch":false,"canBeUsedToMatch":true},{"id":"cod_available","type":"string","display":true,"removed":false,"required":false,"displayName":"cod_available","defaultMatch":false,"canBeUsedToMatch":true},{"id":"time_to_ship_hours","type":"string","display":true,"removed":false,"required":false,"displayName":"time_to_ship_hours","defaultMatch":false,"canBeUsedToMatch":true},{"id":"hsn","type":"string","display":true,"removed":false,"required":false,"displayName":"hsn","defaultMatch":false,"canBeUsedToMatch":true},{"id":"gst_rate","type":"string","display":true,"removed":false,"required":false,"displayName":"gst_rate","defaultMatch":false,"canBeUsedToMatch":true},{"id":"manufacturer_name","type":"string","display":true,"removed":false,"required":false,"displayName":"manufacturer_name","defaultMatch":false,"canBeUsedToMatch":true},{"id":"manufacturer_address","type":"string","display":true,"removed":false,"required":false,"displayName":"manufacturer_address","defaultMatch":false,"canBeUsedToMatch":true},{"id":"country_of_origin","type":"string","display":true,"removed":false,"required":false,"displayName":"country_of_origin","defaultMatch":false,"canBeUsedToMatch":true},{"id":"mfg_month_year","type":"string","display":true,"removed":false,"required":false,"displayName":"mfg_month_year","defaultMatch":false,"canBeUsedToMatch":true},{"id":"fssai_license","type":"string","display":true,"removed":false,"required":false,"displayName":"fssai_license","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ingredients","type":"string","display":true,"removed":false,"required":false,"displayName":"ingredients","defaultMatch":false,"canBeUsedToMatch":true},{"id":"attributes","type":"string","display":true,"removed":false,"required":false,"displayName":"attributes","defaultMatch":false,"canBeUsedToMatch":true},{"id":"price_confirmed","type":"string","display":true,"removed":false,"required":false,"displayName":"price_confirmed","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ondc_item_id","type":"string","display":true,"removed":false,"required":false,"displayName":"ondc_item_id","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ai_title","type":"string","display":true,"removed":false,"required":false,"displayName":"ai_title","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ai_short_desc","type":"string","display":true,"removed":false,"required":false,"displayName":"ai_short_desc","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ai_long_desc","type":"string","display":true,"removed":false,"required":false,"displayName":"ai_long_desc","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ai_category","type":"string","display":true,"removed":false,"required":false,"displayName":"ai_category","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ai_attributes","type":"string","display":true,"removed":false,"required":false,"displayName":"ai_attributes","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ai_notes","type":"string","display":true,"removed":false,"required":false,"displayName":"ai_notes","defaultMatch":false,"canBeUsedToMatch":true},{"id":"content_hash","type":"string","display":true,"removed":false,"required":false,"displayName":"content_hash","defaultMatch":false,"canBeUsedToMatch":true},{"id":"stock_hash","type":"string","display":true,"removed":false,"required":false,"displayName":"stock_hash","defaultMatch":false,"canBeUsedToMatch":true},{"id":"sync_status","type":"string","display":true,"removed":false,"required":false,"displayName":"sync_status","defaultMatch":false,"canBeUsedToMatch":true},{"id":"sync_errors","type":"string","display":true,"removed":false,"required":false,"displayName":"sync_errors","defaultMatch":false,"canBeUsedToMatch":true},{"id":"last_synced_at","type":"string","display":true,"removed":false,"required":false,"displayName":"last_synced_at","defaultMatch":false,"canBeUsedToMatch":true},{"id":"last_synced_price","type":"string","display":true,"removed":false,"required":false,"displayName":"last_synced_price","defaultMatch":false,"canBeUsedToMatch":true},{"id":"drift_note","type":"string","display":true,"removed":false,"required":false,"displayName":"drift_note","defaultMatch":false,"canBeUsedToMatch":true},{"id":"ai_fix_suggestion","type":"string","display":true,"removed":false,"required":false,"displayName":"ai_fix_suggestion","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"autoMapInputData","matchingColumns":["sku"]},"options":{},"operation":"update","sheetName":{"__rl":true,"mode":"name","value":"={{ $('Set Catalog Config').first().json.catalog_sheet }}"},"documentId":{"__rl":true,"mode":"id","value":"={{ $('Set Catalog Config').first().json.sheet_id }}"}},"typeVersion":4.5},{"id":"bc87dbd9-838f-4063-92a5-bcf8bcd509b9","name":"Format Fix Suggestions","type":"n8n-nodes-base.code","position":[3568,-176],"parameters":{"jsCode":"// Pairs each AI fix suggestion with its SKU for write-back\nconst asked = $('Route by Result Type').all(3);\nreturn $input.all().map((item, i) => {\n  let a = item.json.message?.content ?? item.json.content ?? {};\n  if (typeof a === 'string') { try { a = JSON.parse(a.replace(/```json|```/g, '').trim()); } catch (e) { a = { fix: String(a).slice(0, 400) }; } }\n  const steps = Array.isArray(a.steps) ? a.steps.map((x, k) => `${k + 1}) ${x}`).join(' ') : '';\n  return { json: { sku: asked[i].json.sku, ai_fix_suggestion: `${a.summary || a.fix || ''}${steps ? ' | ' + steps : ''}`.slice(0, 600) } };\n}).filter(x => x.json.sku && x.json.ai_fix_suggestion);"},"typeVersion":2},{"id":"c7e92082-b5a3-4c9c-b08d-1616789510c6","name":"Save Fix Suggestions to Sheet","type":"n8n-nodes-base.googleSheets","position":[3824,-176],"parameters":{"columns":{"value":{},"schema":[{"id":"sku","type":"string","display":true,"removed":false,"required":false,"displayName":"sku","defaultMatch":false,"canBeUsedToMatch":true},{"id":"sync_enabled","type":"string","display":true,"removed":false,"required":false,"displayName":"sync_enabled