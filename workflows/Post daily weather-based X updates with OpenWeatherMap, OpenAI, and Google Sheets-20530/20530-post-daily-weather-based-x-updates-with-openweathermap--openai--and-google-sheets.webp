{"meta":{"templateCredsSetupCompleted":true},"name":"Weather-Adaptive Social Media Promoter — Auto-Match Your Daily Post To The Sky (OpenWeatherMap → AI → X)","nodes":[{"id":"wsp-sticky-00","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[-1020,-420],"parameters":{"width":480,"height":640,"content":"## 🌦️ Weather-Adaptive Social Media Promoter\n\nEvery morning this workflow checks the **local weather** and publishes a social post whose product angle matches it. A café would push iced drinks on hot days, delivery on rainy days and terrace seats on pleasant days — automatically.\n\n### 🔧 Setup\n1. Connect **OpenWeatherMap** (free API key), **OpenAI**, **X (Twitter)** and **Google Sheets** credentials.\n2. Set your city in **Check Today's Weather**.\n3. Edit the four **campaign angle** nodes (☔ 🥵 🥶 😊) — replace the sample café products with your own offers.\n4. Point **Log Published Post** at a sheet with headers: `date, weather, temp, bucket, post`.\n5. Activate — it posts daily at **07:00**.\n\n### 💡 Why it's useful\nWeather is the cheapest personalization signal there is. Same product, different pitch every day — with zero manual work."},"typeVersion":1},{"id":"wsp-sticky-01","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[-480,-260],"parameters":{"color":4,"width":640,"height":420,"content":"### 1️⃣ Read the sky\nFetch current weather and classify it into one of four marketing buckets: `rain / hot / cold / pleasant`."},"typeVersion":1},{"id":"wsp-sticky-02","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[220,-260],"parameters":{"color":5,"width":460,"height":900,"content":"### 2️⃣ Pick the campaign angle\nOne branch per weather bucket. **Edit these four nodes** — this is where your products and promos live."},"typeVersion":1},{"id":"wsp-sticky-03","name":"Sticky Note3","type":"n8n-nodes-base.stickyNote","position":[740,-260],"parameters":{"color":6,"width":760,"height":460,"content":"### 3️⃣ Write, publish & log\nThe LLM writes a short post in your brand voice, it goes out on X, and everything is logged to Sheets so you can compare engagement per weather type later."},"typeVersion":1},{"id":"wsp-node-01","name":"Every Day 07:00","type":"n8n-nodes-base.scheduleTrigger","position":[-920,60],"parameters":{"rule":{"interval":[{"field":"days","triggerAtHour":7}]}},"typeVersion":1.2},{"id":"wsp-node-02","name":"Check Today's Weather","type":"n8n-nodes-base.openWeatherMap","position":[-420,60],"parameters":{"cityName":"Tokyo","language":"en"},"typeVersion":1},{"id":"wsp-node-03","name":"Classify Weather Bucket","type":"n8n-nodes-base.code","position":[-180,60],"parameters":{"jsCode":"// Classify the weather into a marketing bucket\nconst w = $input.first().json;\nconst tempC = Math.round((w.main?.temp ?? 293) - 273.15);\nconst condition = (w.weather?.[0]?.main || '').toLowerCase();\nconst description = w.weather?.[0]?.description || '';\n\nlet bucket = 'pleasant';\nif (['rain', 'drizzle', 'thunderstorm', 'snow'].includes(condition)) {\n  bucket = 'rain';\n} else if (tempC >= 28) {\n  bucket = 'hot';\n} else if (tempC <= 8) {\n  bucket = 'cold';\n}\n\nreturn [{\n  json: {\n    city: w.name,\n    tempC,\n    condition,\n    description,\n    bucket,\n    date: new Date().toISOString().slice(0, 10)\n  }\n}];"},"typeVersion":2},{"id":"wsp-node-04","name":"Route By Weather","type":"n8n-nodes-base.switch","position":[60,60],"parameters":{"rules":{"values":[{"outputKey":"Rain","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"sw-1","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.bucket }}","rightValue":"rain"}]},"renameOutput":true},{"outputKey":"Hot","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"sw-2","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.bucket }}","rightValue":"hot"}]},"renameOutput":true},{"outputKey":"Cold","conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"id":"sw-3","operator":{"type":"string","operation":"equals"},"leftValue":"={{ $json.bucket }}","rightValue":"cold"}]},"renameOutput":true}]},"options":{"fallbackOutput":"extra","renameFallbackOutput":"Pleasant"}},"typeVersion":3.2},{"id":"wsp-node-05","name":"☔ Rainy Day Angle","type":"n8n-nodes-base.set","position":[320,-140],"parameters":{"options":{},"assignments":{"assignments":[{"id":"rain-1","name":"angle","type":"string","value":"Rainy-day comfort: free delivery on all orders today, plus our hot soup + sandwich set. Perfect excuse to stay dry inside."}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"wsp-node-06","name":"🥵 Hot Day Angle","type":"n8n-nodes-base.set","position":[320,60],"parameters":{"options":{},"assignments":{"assignments":[{"id":"hot-1","name":"angle","type":"string","value":"Heat relief: iced cold-brew and fruit smoothies, 20% off between 12:00 and 15:00. The AC is set to arctic."}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"wsp-node-07","name":"🥶 Cold Day Angle","type":"n8n-nodes-base.set","position":[320,260],"parameters":{"options":{},"assignments":{"assignments":[{"id":"cold-1","name":"angle","type":"string","value":"Warm-up special: hot chocolate with marshmallows and our winter stew. Free size-up on any hot drink today."}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"wsp-node-08","name":"😊 Pleasant Day Angle","type":"n8n-nodes-base.set","position":[320,460],"parameters":{"options":{},"assignments":{"assignments":[{"id":"nice-1","name":"angle","type":"string","value":"Beautiful day: the terrace is open! Grab a takeaway picnic box and enjoy the park across the street."}]},"includeOtherFields":true},"typeVersion":3.4},{"id":"wsp-node-09","name":"Write Today's Post","type":"@n8n/n8n-nodes-langchain.chainLlm","position":[800,60],"parameters":{"text":"=Today's weather in {{ $json.city }}: {{ $json.description }}, {{ $json.tempC }}°C.\n\nCampaign angle for today:\n{{ $json.angle }}\n\nWrite ONE social media post (max 260 characters) that connects today's weather to this offer. Rules:\n- Friendly, local, human tone — no corporate speak\n- Mention the weather naturally in the first sentence\n- Exactly one emoji and at most two hashtags\n- End with a light call to action","messages":{"messageValues":[{"message":"You are the social media voice of a beloved neighborhood café. You write short, warm, weather-aware posts that make people smile."}]},"promptType":"define"},"typeVersion":1.5},{"id":"wsp-node-10","name":"OpenAI Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[840,300],"parameters":{"model":{"__rl":true,"mode":"list","value":"gpt-4o-mini"},"options":{}},"typeVersion":1.2},{"id":"wsp-node-11","name":"Publish On X","type":"n8n-nodes-base.twitter","position":[1120,60],"parameters":{"text":"={{ $json.text }}","additionalFields":{}},"typeVersion":2},{"id":"wsp-node-12","name":"Log Published Post","type":"n8n-nodes-base.googleSheets","position":[1320,60],"parameters":{"columns":{"value":{"date":"={{ $('Classify Weather Bucket').first().json.date }}","post":"={{ $('Write Today\\'s Post').first().json.text }}","temp":"={{ $('Classify Weather Bucket').first().json.tempC }}","bucket":"={{ $('Classify Weather Bucket').first().json.bucket }}","weather":"={{ $('Classify Weather Bucket').first().json.description }}"},"schema":[],"mappingMode":"defineBelow","matchingColumns":[]},"options":{},"operation":"append","sheetName":{"__rl":true,"mode":"list","value":""},"documentId":{"__rl":true,"mode":"list","value":""}},"typeVersion":4.5}],"pinData":{},"settings":{"executionOrder":"v1"},"connections":{"Publish On X":{"main":[[{"node":"Log Published Post","type":"main","index":0}]]},"Every Day 07:00":{"main":[[{"node":"Check Today's Weather","type":"main","index":0}]]},"Route By Weather":{"main":[[{"node":"☔ Rainy Day Angle","type":"main","index":0}],[{"node":"🥵 Hot Day Angle","type":"main","index":0}],[{"node":"🥶 Cold Day Angle","type":"main","index":0}],[{"node":"😊 Pleasant Day Angle","type":"main","index":0}]]},"OpenAI Chat Model":{"ai_languageModel":[[{"node":"Write Today's Post","type":"ai_languageModel","index":0}]]},"Write Today's Post":{"main":[[{"node":"Publish On X","type":"main","index":0}]]},"🥵 Hot Day Angle":{"main":[[{"node":"Write Today's Post","type":"main","index":0}]]},"☔ Rainy Day Angle":{"main":[[{"node":"Write Today's Post","type":"main","index":0}]]},"🥶 Cold Day Angle":{"main":[[{"node":"Write Today's Post","type":"main","index":0}]]},"Check Today's Weather":{"main":[[{"node":"Classify Weather Bucket","type":"main","index":0}]]},"Classify Weather Bucket":{"main":[[{"node":"Route By Weather","type":"main","index":0}]]},"😊 Pleasant Day Angle":{"main":[[{"node":"Write Today's Post","type":"main","index":0}]]}}}